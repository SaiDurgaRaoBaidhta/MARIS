# Rendered by the nginx image at start-up: ${MIDDLEWARE_UPSTREAM} comes from the container environment.
server {
    listen 80;
    root /usr/share/nginx/html;

    # the middleware (UI -> middleware -> MARIS_Server -> Oracle); the /api prefix is passed on, as in the Vite dev proxy
    location /api/ {
        proxy_pass ${MIDDLEWARE_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # hashed build assets never change; screen layouts and data change with each release
    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
    location ~ ^/(screens|data|fonts)/ { expires 1h; }

    location / { try_files $uri /index.html; }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
