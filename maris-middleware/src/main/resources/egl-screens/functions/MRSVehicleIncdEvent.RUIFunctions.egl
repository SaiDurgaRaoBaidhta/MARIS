end 

Function VHIE03IS-SYMP-DESC ()
   
    VHIE03IW.SYMP-CD-INDEX-2 = 0;
    if (VHIE03IW.SYMP-CD-OBJECT != "    ")
        if (VHIE03IW.SYMP-CD-OBJECT in VHIE04D_DATA.SYMP-CD)
            VHIE03IW.SYMP-CD-INDEX-2 = sysVar.arrayIndex;
        end
        if (VHIE03IW.SYMP-CD-INDEX-2 > 0)
            VHIE03IW.SYMP-CD-DESC = VHIE04D_DATA.SYMP-CD-NARR[SYMP-CD-INDEX-2];
        else
            VHIE03IW.SYMP-CD-DESC = "Not a Valid Symptom Code";
        end
    end
end 

Function VHIE03IS-TIME ()
  
   
    if (VHIE04A_DATA.TIME-EVENT-OCCR != VHIE04IW2.DISP-TIME-INCD-OCCR)
        VHIE03IS-MESSAGE.MESSAGE = " ";
        VHIE03IW.DISP-INVALID-TIMES = "N";
  
  

  
  
        VHIE03IW-TIME.HOURS1 = VHIE03IW-TIME.POS8;
        VHIE03IW-TIME.HOURS2 = VHIE03IW-TIME.POS7;
        VHIE03IW-TIME.COLON = ":";
        VHIE03IW-TIME.MINUTES1 = VHIE03IW-TIME.POS6;
        VHIE03IW-TIME.MINUTES2 = VHIE03IW-TIME.POS5;
        VHIE03IW-TIME.COLON2 = ":";
        VHIE03IW-TIME.SEC1 = VHIE03IW-TIME.POS2;
        VHIE03IW-TIME.SEC2 = VHIE03IW-TIME.POS1;

  
        if (VHIE03IW-TIME.SEC1 == " ")
            VHIE03IW-TIME.SEC1 = "0";
        end
        if (VHIE03IW-TIME.SEC2 == " ")
            VHIE03IW-TIME.SEC2 = "0";
        end

  
        if (VHIE03IW-TIME.HOURS1 == " ")
            VHIE03IW-TIME.HOURS1 = "0";
        end

  
        VHIE03IW-TIME.TIME-CHECK = VHIE03IW-TIME.TIME-OUT; 
        if (VHIE04IW2.DISP-TIME-INCD-OCCR != " ")
            if (VHIE03IW-TIME.TIME-CHECK-HR > 24 ||
             (VHIE03IW-TIME.TIME-CHECK-HR == 24 && VHIE03IW-TIME.TIME-CHECK-MIN > 0) ||
             (VHIE03IW-TIME.TIME-CHECK-HR == 0 && VHIE03IW-TIME.TIME-CHECK-MIN == 0) ||
             (VHIE03IW-TIME.TIME-CHECK-MIN > 59))
  
                VHIE03IW.DISP-INVALID-TIMES = "Y";
                VHIE03IS-MESSAGE.MESSAGE = "You Have Entered An Invalid Time";
                VHIE04IW-TRIGGERS.FOCUS-TIME = "Y";
            end
        end
        if (VHIE03IW.DISP-INVALID-TIMES == "N")
            VHIE04A_DATA.TIME-EVENT-OCCR = VHIE03IW-TIME.TIME-OUT;
        end
    end
end 

Function VHIE03IS-UPDATE ()
  
  
  
  
  
  
  
  
   
    set VHIE03IS-MESSAGE empty;
    set VHIE03IS-HOLDMSG empty;
    set VHIE03IS-MESSAGE5 empty;
    MSGCNT = 1;

  
    VHIE03IW.ADD-ERROR = "N";

  
    if (VHIE04A_DATA.CON-DIRECTION == "N" || VHIE04A_DATA.CON-DIRECTION == "S" || VHIE04A_DATA.CON-DIRECTION == "E" || VHIE04A_DATA.CON-DIRECTION == "W" || VHIE04A_DATA.CON-DIRECTION == " ")

    else
        VHIE03IS-MESSAGE5.MESSAGE[MSGCNT] = " INVALID Direction ";
        VHIE03IW.ADD-ERROR = "Y";
        MSGCNT = MSGCNT + 1;
    end

  
    if (VHIE04A_DATA.TRACKING-CD in VHIE03C_DATA.TRACKING-CD || VHIE04A_DATA.TRACKING-CD == " ")

    else
        VHIE03IS-MESSAGE5.MESSAGE[MSGCNT] = " INVALID Tracking Code ";
        VHIE03IW.ADD-ERROR = "Y";
        MSGCNT = MSGCNT + 1;
    end

  
    if (VHIE04A_DATA.ACTION-CD in VHIE03D_DATA.ACTION-CD || VHIE04A_DATA.ACTION-CD == " ")

    else
        VHIE03IS-MESSAGE5.MESSAGE[MSGCNT] = " INVALID Action Code ";
        VHIE03IW.ADD-ERROR = "Y";
        MSGCNT = MSGCNT + 1;
    end

  
    if (VHIE04A_DATA.VEH-TECH-ID in VHIE03B_DATA.VEH-TECH-ID || VHIE04A_DATA.VEH-TECH-ID == " ")

    else
        VHIE03IS-MESSAGE5.MESSAGE[MSGCNT] = " INVALID Tech ID ";
        VHIE03IW.ADD-ERROR = "Y";
        MSGCNT = MSGCNT + 1;
    end
    if (VHIE03IW.ADD-ERROR == "Y")
        MCT = 1;
        if (VHIE03IS-MESSAGE5.MESSAGE[1] != " ")
            VHIE03IS-HOLDMSG.MSG[MCT] = VHIE03IS-MESSAGE5.MESSAGE[1];
            MCT = MCT + 1;
        end
        if (VHIE03IS-MESSAGE5.MESSAGE[2] != " ")
            VHIE03IS-HOLDMSG.MSG[MCT] = VHIE03IS-MESSAGE5.MESSAGE[2];
            MCT = MCT + 1;
        end
        if (VHIE03IS-MESSAGE5.MESSAGE[3] != " ")
            VHIE03IS-HOLDMSG.MSG[MCT] = VHIE03IS-MESSAGE5.MESSAGE[3];
            MCT = MCT + 1;
        end
        if (VHIE03IS-MESSAGE5.MESSAGE[4] != " ")
            VHIE03IS-HOLDMSG.MSG[MCT] = VHIE03IS-MESSAGE5.MESSAGE[4];
            MCT = MCT + 1;
        end
        if (VHIE03IS-MESSAGE5.MESSAGE[5] != " ")
            VHIE03IS-HOLDMSG.MSG[MCT] = VHIE03IS-MESSAGE5.MESSAGE[5];
            MCT = MCT + 1;
        end
        VHIE03IS-MESSAGE.MESSAGE = VHIE03IS-HOLDMSG.MESSAGE;
    end


  
    if (VHIE03IW.ADD-ERROR == "N")
  
        VHIE04B_DATA.DELETE-IND = "N";
        set VHIE03IS-MESSAGE empty;
        if (VHIE04IW.DELETE-IND == "Y") 
            VHIE04B_DATA.DELETE-IND = "Y";
        end

  
        VHIE04B_CRIT.DATE-REVENUE = VHIE03A_CRIT.DATE-EVENT-OCCR;
        VHIE04B_CRIT.CNT-EVENTS = VHIE04A_DATA.CNT-EVENTS;

  
        VHIE04B_CRIT.HAS-CA-NARR = VHIE04C_CRIT.HAS-CA-NARR;


  
        VHIE04B_DATA.CA-NARR = VHIE04A_DATA.CA-NARR;
        VHIE04B_DATA.CAR-NO = VHIE04A_DATA.CAR-NO;
        VHIE04B_DATA.CON-NO = VHIE04A_DATA.CON-NO;
        VHIE04B_DATA.CON-DIRECTION = VHIE04A_DATA.CON-DIRECTION;
        VHIE04B_DATA.EVENT-LOC = VHIE04A_DATA.EVENT-LOC;

  
        if (VHIE04A_DATA.TIME-EVENT-REST == "  ")
            VHIE04A_DATA.TIME-EVENT-REST = ".00";
        end
        VHIE04B_DATA.TIME-EVENT-OCCR = VHIE04A_DATA.TIME-EVENT-OCCR;
        VHIE04B_DATA.SYMP-CD = VHIE04A_DATA.SYMP-CD;
        VHIE04B_DATA.NARR = VHIE04A_DATA.NARRATIVE;
        VHIE04B_DATA.NARR-NO = 1; 
        VHIE04B_DATA.ACTION-CD = VHIE04A_DATA.ACTION-CD;
        VHIE04B_DATA.VEH-TECH-ID = VHIE04A_DATA.VEH-TECH-ID;
        VHIE04B_DATA.TRACKING-CD = VHIE04A_DATA.TRACKING-CD;
        VHIE04B_DATA.CA-NARR = VHIE04A_DATA.CA-NARR;
        VHIE04B_DATA.CA-NARR-NO = 1;
        VHIE04B_DATA.SPEED = VHIE04A_DATA.SPEED;
        if (VHIE04A_DATA.DATE-INSRV-REV == " " && VHIE04A_DATA.TIME-INSRV == " ") 
  
            VHIE04B_DATA.BIN-DASH-NO = VHIE03G_DATA.BIN-DASH-NO[1];
            VHIE04B_DATA.TIME-INSRV = VHIE03G_DATA.TIME-INSRV[1];
            VHIE04B_DATA.DATE-INSRV-REV = VHIE03G_DATA.DATE-INSRV-REV[1];
            VHIE04B_DATA.DATE-INSRV = VHIE03G_DATA.DATE-INSRV[1];
        else 
            VHIE04B_DATA.BIN-DASH-NO = VHIE04A_DATA.BIN-DASH-NO;
            VHIE04B_DATA.TIME-INSRV = VHIE04A_DATA.TIME-INSRV;
  
            XXDATEW.VAGen_FUNCTION = "YMD";
            XXDATEW.DATE-MM-DD-YYYY = VHIE04A_DATA.DATE-INSRV-REV;
            MRSCommonCode.XXDATES-CONVERT();
            VHIE04B_DATA.DATE-INSRV-REV = XXDATEW.DATE-YYYY-MM-DD;
            XXDATEW.DATE-MM-DD-YYYY = VHIE04A_DATA.DATE-INSRV;
            MRSCommonCode.XXDATES-CONVERT();
            VHIE04B_DATA.DATE-INSRV = XXDATEW.DATE-YYYY-MM-DD;
            

  
  
        end


  
        if (VHIE04A_DATA.INCD-NO != "         ") 
   
            VHIE04B_DATA.INCD-NO = VHIE04A_DATA.INCD-NO;
        else
  
            VHIE04B_DATA.INCD-NO = " ";
        end

  
        VHIE04B_DATA.TERM-LAST-UPD = VHIE04A_DATA.TERM-LAST-UPD;
        VHIE04B_DATA.USER-GRP = VHIE04A_DATA.USER-GRP;

  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHIE04B";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE04I";

    
        try
            call "VHIE04B"(XDCONTROL, VHIE04B_CRIT, VHIE04B_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
                if (VHIE04IW.DELETE-IND == "Y") 
                    VHIE03IS-MESSAGE.MESSAGE = "Data was Successfully Deleted ";
                end
  
                if (VHIE04IW2.SUCCESS-MESSAGE != " ")
                    VHIE03IS-MESSAGE.MESSAGE = VHIE04IW2.SUCCESS-MESSAGE;
                     
                else
                    VHIE03IS-MESSAGE.MESSAGE = "Data was Updated  Successfully ";
                     
                end
                VHIE03IW-TRIGGERS.RUN-RETRIEVE = "Y";
  
                VHIE03IW-TRIGGERS.DISABLE-TIME = "Y";
                VHIE03IW-TRIGGERS.DISABLE-UPDATE = "Y";
                VHIE03IW-TRIGGERS.ENABLE-ADD = "Y";
                VHIE03IW-TRIGGERS.DESELECT = "Y";
                set VHIE04A_DATA empty;
                set VHIE03W-CARS empty;
                set VHIE04IW2 empty;
                SELECTION-IDX = 0;
            else

  
        
        
  
                if (XDCONTROL.URC == 100)

                else
                    VHIE03IS-MESSAGE.MESSAGE = "There Was A Problem Adding Data From Your Input";
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end 

  
        end
        VHIE04IW.DELETE-IND = "N";
         
  
    end
end 

Function VHIE03IS-VHSTO1I ()
   
    VHIE03W-PASSVALUE.CON-NO = VHIE04A_DATA.CON-NO;
    VHIE03W-PASSVALUE.SYMP-CD = VHIE04A_DATA.SYMP-CD;
    VHIE03W-PASSVALUE.WHICH-GUI = "VHIE03";
end 

Function VHIE03IS-WHICH-ONE ()
  

  
  
  

   
    if (VHIE04A_DATA.CAR-NO == "    " && VHIE04A_DATA.CON-NO != "    ")
        VHIE04IW-TRIGGERS.RUN-TRAIN-INCD = "Y";
    end

  
    if (VHIE04A_DATA.CAR-NO != " ")
        set VHEVLX_DATA empty;
        set VHEVLX_CRIT empty;
        set VHINC6A_DATA empty;
  
        VHINC6A_CRIT.CAR-NO = VHIE04A_DATA.CAR-NO;
        try
            call "VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        
            if (XDCONTROL.UROWCNT == 0 ||
             (VHINC6A_DATA.CAR-TYPE-OCCR[1] != "A" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "B" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "C" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "D" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "E" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "L" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "M" && 
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "K"
              ))
                VHIE03IS-MESSAGE.MESSAGE = "You Have Entered an INVALID Car No, and NO Consist Number";
            else

  
                if (VHINC6A_DATA.WHERE-IS-CAR == "CON") 
                    VHIE04IW-TRIGGERS.RUN-IVR = "Y";
                else
  
                    VHIE04IW-TRIGGERS.RUN-INCD-FIX = "Y";
                end

   
            end
        else
            VHIE03IS-MESSAGE.MESSAGE = "You Have Entered an INVALID Car No, ";
        end
         
    else
        if (XDCONTROL.URC == 100)
            VHIE03IS-MESSAGE.MESSAGE = "You Have Entered an INVALID Car No, and NO Consist Number";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHIE04I-INCIDENT () 
    if (VHIE04W_PASSEDTO.INCD-NO == "       ")
        VHIE04IW-TRIGGERS.ENABLE-INCIDENT = "Y";
    else
        VHIE04IW-TRIGGERS.DISABLE-INCIDENT = "Y";
    end
end 

Function VHIE04IS-ACT-DESC ()
   
    if (VHIE04IW.ACTION-CD-OBJECT in VHIE03D_DATA.ACTION-CD)
        VHIE04IW.ACTION-CD-INDEX-2 = sysVar.arrayIndex;
    end
    if (VHIE04IW.ACTION-CD-INDEX-2 > 0)
        VHIE04IW.ACTION-CD-DESC = VHIE03D_DATA.ACTION-CD-DESC[ACTION-CD-INDEX-2];
    else
        VHIE04IW.SYMP-CD-DESC = "Not a Valid Symptom Code";
    end
end 

Function VHIE04IS-BLD-MSG ()
   
    ERROR-INDEX = 0;
    ERROR-MESSAGE = " ";
    if (VHIE04IW2.CAR-NO == "0000")
        if (INVALID-CAR-NO == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid car no.";
            VHIE04IW2.CAR-NO = " ";
        end
    else
        if (DISPLAY-INVALID-CAR-NO == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid car no.";
            VHIE04IW2.CAR-NO = " ";
        end
        if (DISPLAY-NOT-IN-SVC == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            if (VHIE04IW2.CAR-NO == "    " && VHIE04IW2.CON-NO != "   ")
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = " Consist is NOT in use.";
            else
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Car not in use.";
            end
        end
    end
    if (VHIE04IW2.SYMP-CD == " ")
        if (INVALID-SYMP-CD == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid symp cd.";
        end
    else
        if (INVALID-SYMPCD-VAL == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Symp cd does not exist.";
        end
    end
    if (INVALID-DATE-INCD == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date of incident.";
    else
        if (DAYS-GR-05 == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Date cannot be older than 5 days.";
        else
            if (DISP-ERR-MSG == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future date not allowed.";
            end
        end
    end
    if (INVALID-TIME-INCD == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid time of incident.";
    else
        if (DISP-INVALID-TIME == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid time.";
        else
            if (DISP-TIME-ERRMSG == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future time not allowed.";
            end
        end
    end
    if (VHIE04IW2.SPEED == " ")
        if (INVALID-SPEED == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid speed.";
        end
    else
        if (INVALID-SPEED-VAL == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Speed does not have a valid value.";
        end
    end
    if (INVALID-DIRECTION == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid direction.";
    end
    if (ERROR-INDEX == 6)
        VHIE04IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-LOC == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid location.";
    end
    if (ERROR-INDEX == 6)
        VHIE04IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-NARR == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid incident narr.";
    end
    if (ERROR-INDEX == 6)
        VHIE04IS-MOVE-MSG();
        return;
    end
    if (INVALID-DATE == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date.";
    end

  
    if (INVALID-DATE-TIME == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date or time.";
    else
        if (DAYS-GR-45 == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
   
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Date too old (over 1095 days).";
        else
            if (DAYS-GR-7 == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
   
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Date too old (over 1095 days).";
            else
                if (FUTURE-DATE == "Y") 
                    ERROR-INDEX = ERROR-INDEX + 1;
                    ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future date not allowed.";
                else
                    if (FUTURE-TIME == "Y") 
                        ERROR-INDEX = ERROR-INDEX + 1;
                        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future time not allowed.";
                    end
                end
            end
        end
    end
    VHIE04IS-MOVE-MSG();
end 



Function VHIE04IS-CA-CICS ()
  
  
  
  
  
  
  
  
  
  


   
    VHINC3A_CRIT.USER-GRP = VHIE04A_DATA.USER-GRP;
    VHINC3A_CRIT.TERM-ID = VHIE04A_DATA.TERM-LAST-UPD;
    VHINC3A_CRIT.REPT-ID = "VHINC06I";
    if (VHINC6A_DATA.WHERE-IS-CAR == "CON")
        VHINC3A_CRIT.INCD-NO = VHEVLX_DATA.INCD-NO;
    else
        VHINC3A_CRIT.INCD-NO = VHEVLY_DATA.INCD-NO;
    end
    VHINC3A_CRIT.CON-CAR-1 = VHIE04A_DATA.CAR-NO;
    VHINC3A_CRIT.REPT-TYPE = "IVR";
    if (VHEVLY_CRIT.TYPE-IND == "REV")
        VHINC3A_CRIT.REPT-TYPE = "IVH";
    end


    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHINC03I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHINC3A";

    
    try
        call "VHINC3A"(XDCONTROL, VHINC3A_CRIT, VHINC3A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        

        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHIE04IS-CK-DATA ()
   
    COMPLETED-OK = "N"; 
    VHIE04IW2.SUCCESS-MESSAGE = " "; 
    VHIE03IS-MESSAGE.MESSAGE = " ";
    ERROR-INDEX = 0;
    ERROR-COUNT = 0;
    INVALID-CAR-NO = "N"; 
    INVALID-INCD-NARR = "N"; 
    INVALID-SYMP-CD = "N"; 
    INVALID-DATE-INCD = "N"; 
    INVALID-TIME-INCD = "N"; 
    INVALID-SPEED = "N"; 
    INVALID-SPEED-VAL = "N"; 
    INVALID-DIRECTION = "N"; 
    INVALID-INCD-LOC = "N"; 
    INVALID-DATE = "N"; 
    DAYS-GR-05 = "N"; 
    DISP-ERR-MSG = "N"; 
    DISP-INVALID-TIME = "N"; 
    DISP-TIME-ERRMSG = "N"; 
    INVALID-SYMPCD-VAL = "N"; 
    DISPLAY-INVALID-CAR-NO = "N"; 
    DISPLAY-NOT-IN-SVC = "N"; 
    set VHINC3A_CRIT empty;
    VHINC3A_CRIT.SEND-RESET-MSG = "N"; 
    if (VHIE04IW2.DISP-TIME-INCD-OCCR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-TIME-INCD = "Y";
    end
    if (VHIE04IW2.SPEED == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-SPEED = "Y";
    end
    if (VHIE04IW2.CON-DIRECTION == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-DIRECTION = "Y";
    else
        if (VHIE04IW2.CON-DIRECTION == "E" ||
         VHIE04IW2.CON-DIRECTION == "W" ||
         VHIE04IW2.CON-DIRECTION == "N" ||
         VHIE04IW2.CON-DIRECTION == "S" ||
         VHIE04IW2.CON-DIRECTION == "A")

        else
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-DIRECTION = "Y";
        end
    end
    if (VHIE04IW2.INCD-LOC == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-LOC = "Y";
    end
    if (VHIE04IW2.INCD-NARR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-NARR = "Y";
    end
    if (VHIE04IW2.SPEED != " ")
        if (VHIE04IW2.SPEED != "ALL")
            LOOP-INDEX = 1;
            VHIE04IW2.TEMP-SPEED-CHAR = VHIE04IW2.SPEED;
            while ((LOOP-INDEX <= 3))
                TEMP-SPEED-CHK-CHAR = TEMP-SPEED-OCCR-CHAR[LOOP-INDEX];
                if (TEMP-SPEED-CHK-CHAR != " ")
                    if (TEMP-SPEED-CHK-CHAR != "0" &&
                     TEMP-SPEED-CHK-CHAR != "1" &&
                     TEMP-SPEED-CHK-CHAR != "2" &&
                     TEMP-SPEED-CHK-CHAR != "3" &&
                     TEMP-SPEED-CHK-CHAR != "4" &&
                     TEMP-SPEED-CHK-CHAR != "5" &&
                     TEMP-SPEED-CHK-CHAR != "6" &&
                     TEMP-SPEED-CHK-CHAR != "7" &&
                     TEMP-SPEED-CHK-CHAR != "8" &&
                     TEMP-SPEED-CHK-CHAR != "9")
                        ERROR-COUNT = ERROR-COUNT + 1;
                        INVALID-SPEED-VAL = "Y"; 
                        LOOP-INDEX = 4;
                    else

                    end
                end
                LOOP-INDEX = LOOP-INDEX + 1;
            end
        end
    end
    if (VHIE04IW2.DISP-TIME-INCD-OCCR != " ")
        if (DISP-TIME-INCD-OCCR-HR > 24 ||
         (DISP-TIME-INCD-OCCR-HR == 24 && DISP-TIME-INCD-OCCR-MIN > 0) ||
         (DISP-TIME-INCD-OCCR-HR == 0 && DISP-TIME-INCD-OCCR-MIN == 0) ||
         (DISP-TIME-INCD-OCCR-MIN > 59))
            ERROR-COUNT = ERROR-COUNT + 1;
            DISP-INVALID-TIME = "Y";
        end
    end
    if (VHIE04IW2.SYMP-CD == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-SYMPCD-VAL = "Y";
    end
    if (VHIE04IW2.CAR-NO != " ")
        if (VHIE04IW2.CON-NO != " ")
            VHIE03IW-PASSVALUE.CONSIST-IN-USE = "N";
        end
  
        VHINC6A_CRIT.CAR-NO = VHIE04IW2.CAR-NO;
        try
            call "VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        
            if (XDCONTROL.UROWCNT == 0 ||
             (VHINC6A_DATA.CAR-TYPE-OCCR[1] != "A" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "B" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "C" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "D" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "E" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "L" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "M"&& 
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "K"
             ))
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                if (VHINC6A_DATA.WHERE-IS-CAR != "CON")
   
   

                end
            end
        else
            if (XDCONTROL.URC == 100)
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end

  
    if (VHINC6A_DATA.WHERE-IS-CAR == "CON" && VHIE04A_DATA.CON-NO != VHINC6A_DATA.CON-NO)
        VHIE03IS-MESSAGE.MESSAGE = "Problem with Train Number entered, Database shows car in different consist";
    end
    if (ERROR-COUNT > 0)
        VHIE03IS-BLD-MSG(); 
    end
    if (ERROR-COUNT == 0)
  

  
        if (VHIE03G_DATA.CON-STAT[1] == "OUT" || VHIE03G_DATA.CON-STAT[1] == "SWP")
            VHIE03IS-CK-DATA-Y();
        else
            if (VHIE04IW2.CAR-NO != " " && VHINC6A_DATA.WHERE-IS-CAR == "CON")
                VHIE04IW-TRIGGERS.RUN-IVR-STOR-DB = "Y";
            end
        end
    end
end 

Function VHIE04IS-CK-DATA-F ()
  
  
   
    ERROR-MESSAGE = " ";
    ERROR-INDEX = 0;
    ERROR-COUNT = 0;
    INVALID-CAR-NO = "N"; 
    INVALID-INCD-NARR = "N"; 
    INVALID-SYMP-CD = "N"; 
    INVALID-DISCV-DUR = "N"; 
    INVALID-INCD-LOC = "N"; 
    INVALID-DATE-TIME = "N"; 
    DAYS-GR-45 = "N"; 
    DAYS-GR-7 = "N"; 
    FUTURE-DATE = "N"; 
    FUTURE-TIME = "N"; 
    INVALID-SYMPCD-VAL = "N"; 
    DISPLAY-INVALID-CAR-NO = "N"; 
    DISPLAY-IN-USE = "N"; 
    DISCV-DUR-FOUND = "N"; 
    set VHINC3A_CRIT empty; 
    VHINC3A_CRIT.SEND-RESET-MSG = "N"; 
    VHEVLY_CRIT.TYPE-IND = "REV"; 
    if (VHIE04IW2.CAR-NO == "0000")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-CAR-NO = "Y";
    end
    if (VHIE04IW2.SYMP-CD == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-SYMP-CD = "Y";
    end
    if (VHIE04IW2.INCD-LOC == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-LOC = "Y";
    end
    if (VHIE04IW2.INCD-NARR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-NARR = "Y";
    end
    VHIE04IW2.DISCV-DUR = "1";
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  

  
  
   
  
  
  
  
  
    if (VHIE04IW2.DISP-TIME-INCD-OCCR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-TIME-INCD = "Y";
    end

  


  

  
  
    VHIE04IW2.TIME-W-H = VHIE04IW2.DISP-TIME-INCD-OCCR-HR; 
    VHIE04IW2.TIME-W-M = VHIE04IW2.DISP-TIME-INCD-OCCR-MIN; 
    VHIE04IW2.TIME-W-COLON = ":"; 
    VHIE04IW2.TIME-W-S = ":00"; 
    if (VHIE04IW2.TIME-W-H1 == " ")
        VHIE04IW2.TIME-W-H1 = "0";
    end
    if (VHIE04IW2.TIME-W-M1 == " ")
        VHIE04IW2.TIME-W-M1 = "0";
    end
    VHIE04IW2.DISP-TIME-INCD-OCCR = TIME-WORKINGSTORAGE;
  
    if (VHIE04IW2.DISP-TIME-INCD-OCCR != " ")
        if (DISP-TIME-INCD-OCCR-HR > 24 ||
         (DISP-TIME-INCD-OCCR-HR == 24 && DISP-TIME-INCD-OCCR-MIN > 0) ||
         (DISP-TIME-INCD-OCCR-HR == 0 && DISP-TIME-INCD-OCCR-MIN == 0) ||
         (DISP-TIME-INCD-OCCR-MIN > 59))
            ERROR-COUNT = ERROR-COUNT + 1;
            DISP-INVALID-TIME = "Y";
        end
    else
        VHINC8E_CRIT.TIME-WORK = VHIE04A_DATA.TIME-EVENT-OCCR;
    end

  
  
  
  
  
  
  
  
  
  
  
  
    VHINC8E_CRIT.TIME-WORK = VHIE04A_DATA.TIME-EVENT-OCCR;
    VHINC8E_CRIT.DATE-WORK = VHIE03IW.REV-DATE;
    VHIE04IW2.WS-DATE = VHIE03IW.REV-DATE;
    try
        call "VHINC8E"(XDCONTROL, VHINC8E_CRIT, VHINC8E_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHIE04IW2.DAYS-DIFF = VHINC8E_DATA.DAYS-DIFF;
        VHIE04IW2.TIME-DIFF = VHINC8E_DATA.TIME-DIFF;
        VHIE04IW2.INVALID-DATE-TIME = "N";
    else
        ERROR-COUNT = ERROR-COUNT + 1;
        VHIE04IW2.INVALID-DATE-TIME = "Y";
    end
    if (VHIE04IW2.INVALID-DATE-TIME == "N")
        if (VHIE04IW2.DAYS-DIFF < 0)
            ERROR-COUNT = ERROR-COUNT + 1;
            VHIE04IW2.FUTURE-DATE = "Y";
             
        else
            if (VHIE04IW2.DAYS-DIFF == 0)
                if (VHIE04IW2.TIME-DIFF < 0)
                    ERROR-COUNT = ERROR-COUNT + 1;
                    VHIE04IW2.FUTURE-TIME = "Y";
                     
                end
            end
        end

  
        if (VHIE04IW2.FUTURE-TIME == "N" && VHIE04IW2.FUTURE-DATE == "N")
            if (VHEVLY_CRIT.TYPE-IND == "REV") 
                if ((VHIE04IW2.DAYS-DIFF > 1095))
                    ERROR-COUNT = ERROR-COUNT + 1;
                    DAYS-GR-7 = "Y";
                end
            else
          
                if ((VHIE04IW2.DAYS-DIFF > 1095)) 
                    ERROR-COUNT = ERROR-COUNT + 1;
                    DAYS-GR-45 = "Y";
                end
            end
        end
    end
    if (VHIE04IW2.SYMP-CD != " ")
        VHINC1A_CRIT.VAGen_COUNT = 0;
        VHINC1A_CRIT.SYMP-CD = VHIE04IW2.SYMP-CD;
        try
            call "VHINC1A"(XDCONTROL, VHINC1A_CRIT);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHINC1A_CRIT.VAGen_COUNT == 0)
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-SYMPCD-VAL = "Y";
            end
        end
    end
    if (VHIE04IW2.CAR-NO != " ")
  
        VHINC6A_CRIT.CAR-NO = VHIE04IW2.CAR-NO;
        try
            call "VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        
            if (XDCONTROL.UROWCNT == 0 ||
             (VHINC6A_DATA.CAR-TYPE-OCCR[1] != "A" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "B" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "C" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "D" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "E" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "L" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "M" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "K"
              ))
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                if (VHEVLY_CRIT.TYPE-IND == "YRD" ||
                 VHEVLY_CRIT.TYPE-IND == "SHP" ||
                 VHEVLY_CRIT.TYPE-IND == "REV")
                    if (VHINC6A_DATA.WHERE-IS-CAR == "CON")
                        ERROR-COUNT = ERROR-COUNT + 1;
                        DISPLAY-IN-USE = "Y";
                    end
                end
            end
        else
            if (XDCONTROL.URC == 100)
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
    if (ERROR-COUNT > 0)
  
        VHIE03IS-BLD-MSG();
    end
    if (ERROR-COUNT == 0) 
        VHIE04IS-PSEUDO(); 
        VHIE04IW-TRIGGERS.RUN-FX-STOR-DB = "Y";
    end
end 

Function VHIE04IS-CK-DATA-T ()
  
  

   
    COMPLETED-OK = "N"; 
    VHIE04IW2.SUCCESS-MESSAGE = " "; 
    VHIE03IS-MESSAGE.MESSAGE = " ";
    ERROR-INDEX = 0;
    ERROR-COUNT = 0;
    INVALID-CAR-NO = "N"; 
    INVALID-INCD-NARR = "N"; 
    INVALID-SYMP-CD = "N"; 
    INVALID-DATE-INCD = "N"; 
    INVALID-TIME-INCD = "N"; 
    INVALID-SPEED = "N"; 
    INVALID-SPEED-VAL = "N"; 
    INVALID-DIRECTION = "N"; 
    INVALID-INCD-LOC = "N"; 
    INVALID-DATE = "N"; 
    DAYS-GR-05 = "N"; 
    DISP-ERR-MSG = "N"; 
    DISP-INVALID-TIME = "N"; 
    DISP-TIME-ERRMSG = "N"; 
    INVALID-SYMPCD-VAL = "N"; 
    DISPLAY-INVALID-CAR-NO = "N"; 
    DISPLAY-NOT-IN-SVC = "N"; 
    NO-CAR-IN-CON = "N"; 
    if (VHIE04IW2.DISP-TIME-INCD-OCCR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-TIME-INCD = "Y";
    end
    if (VHIE04IW2.SPEED == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-SPEED = "Y";
    end
    if (VHIE04IW2.CON-DIRECTION == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-DIRECTION = "Y";
    else
        if (VHIE04IW2.CON-DIRECTION == "E" ||
         VHIE04IW2.CON-DIRECTION == "W" ||
         VHIE04IW2.CON-DIRECTION == "N" ||
         VHIE04IW2.CON-DIRECTION == "S" ||
         VHIE04IW2.CON-DIRECTION == "A")

        else
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-DIRECTION = "Y";
        end
    end
    if (VHIE04IW2.INCD-LOC == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-LOC = "Y";
    end
    if (VHIE04IW2.INCD-NARR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-NARR = "Y";
    end
    if (VHIE04IW2.SPEED != " ")
        if (VHIE04IW2.SPEED != "ALL")
            LOOP-INDEX = 1;
            VHIE04IW2.TEMP-SPEED-CHAR = VHIE04IW2.SPEED;
            while ((LOOP-INDEX <= 3))
                TEMP-SPEED-CHK-CHAR = TEMP-SPEED-OCCR-CHAR[LOOP-INDEX];
                if (TEMP-SPEED-CHK-CHAR != " ")
                    if (TEMP-SPEED-CHK-CHAR != "0" &&
                     TEMP-SPEED-CHK-CHAR != "1" &&
                     TEMP-SPEED-CHK-CHAR != "2" &&
                     TEMP-SPEED-CHK-CHAR != "3" &&
                     TEMP-SPEED-CHK-CHAR != "4" &&
                     TEMP-SPEED-CHK-CHAR != "5" &&
                     TEMP-SPEED-CHK-CHAR != "6" &&
                     TEMP-SPEED-CHK-CHAR != "7" &&
                     TEMP-SPEED-CHK-CHAR != "8" &&
                     TEMP-SPEED-CHK-CHAR != "9")
                        ERROR-COUNT = ERROR-COUNT + 1;
                        INVALID-SPEED-VAL = "Y"; 
                        LOOP-INDEX = 4;
                    else

                    end
                end
                LOOP-INDEX = LOOP-INDEX + 1;
            end
        end
    end
    if (VHIE04IW2.DISP-TIME-INCD-OCCR != " ")
        if (DISP-TIME-INCD-OCCR-HR > 24 ||
         (DISP-TIME-INCD-OCCR-HR == 24 && DISP-TIME-INCD-OCCR-MIN > 0) ||
         (DISP-TIME-INCD-OCCR-HR == 0 && DISP-TIME-INCD-OCCR-MIN == 0) ||
         (DISP-TIME-INCD-OCCR-MIN > 59))
            ERROR-COUNT = ERROR-COUNT + 1;
            DISP-INVALID-TIME = "Y";
        end
    end
    if (VHIE04IW2.SYMP-CD == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-SYMPCD-VAL = "Y";
    end
    if (VHIE04IW2.CON-NO != " ")
        VHIE03IW-PASSVALUE.CONSIST-IN-USE = "N";
  
        VHINC1B_DATA.CON-NO = VHIE04A_DATA.CON-NO;
        try
            call "VHINC1B"(XDCONTROL, VHINC1B_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (XDCONTROL.UROWCNT == 0)
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CON-NO = "Y";
            else
                if (VHINC1B_DATA.IN-USE-IND != "Y")
  
  
                    VHIE03IW-PASSVALUE.CONSIST-IN-USE = "Y";
                end
                if (VHINC1B_DATA.NO-CARS-IND == "Y")
                    ERROR-COUNT = ERROR-COUNT + 1;
                    NO-CAR-IN-CON = "Y";
                end
            end
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
    if (ERROR-COUNT > 0)
        VHIE03IS-BLD-MSG(); 
    end
    if (ERROR-COUNT == 0) 
        if (VHIE03G_DATA.CON-STAT[1] == "OUT" || VHIE03G_DATA.CON-STAT[1] == "SWP")
            VHIE04IW-TRIGGERS.RUN-TX-STOR-DB = "Y";
        else
            VHIE04IW-TRIGGERS.RUN-TI-STOR-DB = "Y";
        end
    end
end 

