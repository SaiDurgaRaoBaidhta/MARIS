        try
            call "VHIE03G"(XDCONTROL, VHIE03G_CRIT, VHIE03G_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
                set VHIE03W-CARS empty;
                VHIE03IW-PASSVALUE.CON-COUNTER = XDCONTROL.UROWCNT;
                CONCT = 1;
                while (CONCT <= XDCONTROL.UROWCNT)
                    if (CONCT == 1)
                        VHIE03W-CARS.CAR1 = VHIE03G_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 2)
                        VHIE03W-CARS.CAR2 = VHIE03G_DATA.CAR-FORMAT[CONCT];
                    end
