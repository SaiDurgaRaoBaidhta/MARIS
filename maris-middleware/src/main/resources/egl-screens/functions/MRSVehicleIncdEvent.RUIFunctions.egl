                        VHIE03W-CARS.CAR5 = VHIE03G_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 6)
                        VHIE03W-CARS.CAR6 = VHIE03G_DATA.CAR-FORMAT[CONCT];
                    end
