

package MRSVehicleIncdEvent;
 

Function VHIE01IS-CLEAR () 
    set VHIE01IS-MESSAGE empty;
    SELECTION-IDX = 0;
end 

Function VHIE01IS-CLEAR2 () 
    set VHIE01IS-MESSAGE empty;
    set VHIE01IW empty;
    SELECTION-IDX = 0;
end 

Function VHIE01IS-DATE-CK () 
    VHIE01IW-TRIGGERS.DATES-ARE-OK = "Y";
    set VHIE01IS-MESSAGE empty;
    VHIE01IW.TODAY = VGVar.currentGregorianDate;

  
    VHIE01IW.YYYYMMDD-YYYY = VHIE01IW.TO-YEAR;
    VHIE01IW.YYYYMMDD-MM = VHIE01IW.TO-MM;
    VHIE01IW.YYYYMMDD-DD = VHIE01IW.TO-DD;
    if (VHIE01IW.YYYYMMDD > VHIE01IW.TODAY)
        VHIE01IS-MESSAGE.MESSAGE = "Future TO Date is Not Allowed";
        VHIE01IW-TRIGGERS.DATES-ARE-OK = "N";
    end
  
    VHIE01IW.TO-YYYYMMDD = VHIE01IW.YYYYMMDD;

  
    VHIE01IW.YYYYMMDD-YYYY = VHIE01IW.FROM-YEAR;
    VHIE01IW.YYYYMMDD-MM = VHIE01IW.FROM-MM;
    VHIE01IW.YYYYMMDD-DD = VHIE01IW.FROM-DD;
    if (VHIE01IW.YYYYMMDD > VHIE01IW.TODAY)
        VHIE01IS-MESSAGE.MESSAGE = "Future FROM Date is Not Allowed";
        VHIE01IW-TRIGGERS.DATES-ARE-OK = "N";
    end
    if (VHIE01IW.TO-YYYYMMDD < VHIE01IW.YYYYMMDD)
        VHIE01IS-MESSAGE.MESSAGE = "FROM Date Must Be Less Than or Equal to TO Date";
        VHIE01IW-TRIGGERS.DATES-ARE-OK = "N";
    end

  
    if (VHIE01IW-TRIGGERS.DATES-ARE-OK == "Y")
        VHIE01IW-TRIGGERS.RUN-RETRIEVE = "Y";
    end
end 

Function VHIE01IS-EXIT ()
   
    set VHIE01IS-MESSAGE empty;
    set VHIE01A_DATA empty;
    VHIE01IW-VHIE03I.PREVIOUS-GUI = " ";
    VHIE01IW.REC-COUNT = 0;
    VHIE01IW-TRIGGERS.LOAD-DATA = "Y";
end 

Function VHIE01IS-GET-DATA ()
  
  
  
  
  
  
  
  


  
   
    set VHIE01IS-MESSAGE empty;
    set VHIE01A_DATA empty;


  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHIE01IW.FROM-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHIE01A_CRIT.FROM-DATE = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.DATE-MM-DD-YYYY = VHIE01IW.TO-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHIE01A_CRIT.TO-DATE = XXDATEW.DATE-YYYY-MM-DD;

  
    VHIE01IW-PASSVALUE.FROM-DATE = VHIE01A_CRIT.FROM-DATE;
    VHIE01IW-PASSVALUE.TO-DATE = VHIE01A_CRIT.TO-DATE;
  
    VHIE01IW-PASSVALUE.GUI-FROM = VHIE01IW.FROM-DATE;
    VHIE01IW-PASSVALUE.GUI-TO = VHIE01IW.TO-DATE;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIE01A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE01I";
    set VHIE01A_DATA empty;

    
    try
        call "VHIE01A"(XDCONTROL, VHIE01A_CRIT, VHIE01A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHIE01IW.REC-COUNT = XDCONTROL.UROWCNT;
            VHIE01IW-PASSVALUE.WHICH-REPORT = "INCLOG";
            VHIE01IW-TRIGGERS.LOAD-DATA = "Y";
  
            if (VHIE01A_CRIT.EXCEED-FLAG == "Y")
                VHIE01IS-MESSAGE.MESSAGE = "Date Request Exceeded Max Number of Rows";
            end
        else

  
        
        
  
            if (XDCONTROL.URC == 100)
                VHIE01IS-MESSAGE.MESSAGE = "No Data Found for Date Request";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end
end 

Function VHIE01IS-MOVE () 
    if (SELECTION-IDX > 0)
        VHIE01IW-PASSDATA.CAR-NO = VHIE01A_DATA.CAR-NO[SELECTION-IDX];
        VHIE01IW-PASSDATA.INCD-NO = VHIE01A_DATA.INCD-NO[SELECTION-IDX];
        VHIE01IW-PASSDATA.WHICH-GUI = "VHIE01";
        VHIE01IW-TRIGGERS.OPEN-VHSV06I = "Y";
    end
end 

Function VHIE01IS-REVTIME ()
  
  
  
  
  
  
  
   
    set VHIE01B_DATA empty;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIE01B";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE01I";
    set VHIE01A_DATA empty;

    
    try
        call "VHIE01B"(XDCONTROL, VHIE01B_CRIT, VHIE01B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end

  
    if (VHIE01B_DATA.CURRENT-TIME >= VHIE01B_DATA.TIME-REV-START)
        VHIE01IW.REV-DATE = VHIE01B_DATA.CURRENT-DATE;
    else
        VHIE01IW.REV-DATE = VHIE01B_DATA.YESTERDAY;
    end

  
    if (VHIE01IW-VHIE03I.PREVIOUS-GUI == "VHIE03I")
        VHIE01IW.REV-DATE = VHIE01IW-VHIE03I.REV-DATE;
        VHIE01IW-TRIGGERS.FROM-VHIE03I = "Y";
    end

  
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHIE01IW.REV-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHIE01IW.FROM-DATE = XXDATEW.DATE-MM-DD-YYYY;
    VHIE01IW.TO-DATE = XXDATEW.DATE-MM-DD-YYYY;
end 

Function VHIE01IS-SUBMIT () 

end 

Function VHIE02IS-BEGIN () 
    if (VHIE02IW-PASSVALUE.WHICH-REPORT == "INCLOG")
        VHIE02IW.REPORT-INDEX = 1;
    end
    if (VHIE02IW-PASSVALUE.WHICH-REPORT == "VHIE03I")
        VHIE02IW.REPORT-INDEX = 2;
    end
    if (VHIE02IW-PASSVALUE.WHICH-REPORT == "VHIE04I")
        VHIE02IW.REPORT-INDEX = 3;
    end

  
    XXEXT_CALL_Level77Items.UEXTNAM = "WS100I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS70A01";

    
    try
        call "WS70A01"(XDCONTROL, WS70A01_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHIE02IW.PRINTER-COUNT = XDCONTROL.UROWCNT;
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
  
    if (VHIE02IW.REPORT-INDEX == 99) 
  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYT27I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT27";
        

    
  

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

            else

        
        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
  

  
  
    if (VHIE02IW.REPORT-INDEX > 0)
        if (VHIE02IW.REPORT-INDEX == 1)
  
            VHIE02IW-TRIGGERS.HIDE-RANGE = "Y";
        end
        if (VHIE02IW.REPORT-INDEX == 2)
            VHIE02IW-TRIGGERS.ENABLE-DISPLAY = "Y";
            VHIE02IW-TRIGGERS.SHOW-DATE = "Y";
            VHIE02IW-TRIGGERS.HIDE-RANGE = "Y";
        end
        if (VHIE02IW.REPORT-INDEX == 3)
            VHIE02IW-TRIGGERS.ENABLE-DISPLAY = "Y";
            VHIE02IW-TRIGGERS.SHOW-DATE = "Y";
            VHIE02IW-TRIGGERS.HIDE-RANGE = "Y";
        end
        if (VHIE02IW.REPORT-INDEX == 6 || VHIE02IW.REPORT-INDEX == 7)
            VHIE02IW-TRIGGERS.ENABLE-DISPLAY = "Y";
            VHIE02IW-TRIGGERS.SHOW-DATE = "Y";
            VHIE02IW-TRIGGERS.HIDE-RANGE = "Y";
        end
        if (VHIE02IW.REPORT-INDEX == 4 || VHIE02IW.REPORT-INDEX == 5 || VHIE02IW.REPORT-INDEX == 8)
            VHIE02IW-TRIGGERS.DISABLE-DISPLAY = "Y";
            VHIE02IW-TRIGGERS.SHOW-DATE = "Y";
            VHIE02IW-TRIGGERS.HIDE-RANGE = "Y";
        end
    end
end 

Function VHIE02IS-HARD-COPY () 
    if (PRINT-IDX > 0)
        ENABLE-DISPLAY = "Y";
        VHIE02IW-PASSVALUE.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRINT-IDX];
    else
        DISABLE-DISPLAY = "Y";
    end
end 

Function VHIE02IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  


   
    if (VHIE02IW.REPORT-INDEX == 1)
        set VHIE02A_CRIT empty;

  
        VHIE02A_CRIT.REPT-TYPE = VHIE02IW-PASSVALUE.WHICH-REPORT;
        VHIE02A_CRIT.REPT-CD = VHIE02IW-PASSVALUE.VTAM-NAME;
        VHIE02A_CRIT.DATE-REPT-FROM = VHIE02IW-PASSVALUE.GUI-FROM;
        VHIE02A_CRIT.DATE-REPT-TO = VHIE02IW-PASSVALUE.GUI-TO;

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHIE02I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE02A";
        try
            call "VHIE02A"(XDCONTROL, VHIE02A_CRIT, VHIE02A_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        
       
                VHIE02IW-TRIGGERS.SUBMIT = "Y";
            else

        


        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end 

  
  
    if (VHIE02IW.REPORT-INDEX == 2)
        set VHIE02B_CRIT empty;

  
        VHIE02B_CRIT.REPT-TYPE = VHIE02IW-PASSVALUE.WHICH-REPORT;
        VHIE02B_CRIT.REPT-CD = VHIE02IW-PASSVALUE.VTAM-NAME;
        VHIE02B_CRIT.DATE-REPT-FROM = VHIE02IW-PASSVALUE.GUI-FROM;
        VHIE02B_CRIT.DATE-REPT-TO = VHIE02IW-PASSVALUE.GUI-TO;

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHIE02I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE02B";
        try
            call "VHIE02B"(XDCONTROL, VHIE02B_CRIT, VHIE02B_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        
       
                VHIE02IW-TRIGGERS.SUBMIT = "Y";
            else

        


        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end 

  
  
  
    if (VHIE02IW.REPORT-INDEX == 3)
        set VHIE02C_CRIT empty;

  
        VHIE02IW.EVENT-ID-WORK = VHIE02IW-PASSVALUE.EVENT-ID;
        VHIE02C_CRIT.REPT-TYPE = VHIE02IW-PASSVALUE.WHICH-REPORT;
        VHIE02C_CRIT.REPT-CD = VHIE02IW-PASSVALUE.VTAM-NAME;
        VHIE02C_CRIT.DATE-REPT-FROM = VHIE02IW-PASSVALUE.GUI-FROM;
        VHIE02C_CRIT.DATE-REPT-TO = VHIE02IW-PASSVALUE.GUI-TO;
        VHIE02C_CRIT.EVENT-NUM = VHIE02IW.EVENT-ID-WORK-NUMBER;

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHIE02I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE02C";
        try
            call "VHIE02C"(XDCONTROL, VHIE02C_CRIT, VHIE02C_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        
       
                VHIE02IW-TRIGGERS.SUBMIT = "Y";
            else

        


        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end 
    VHIE02IW-TRIGGERS.SUBMIT = "Y";
end 

Function VHIE03I-CHK_ACCESS ()
  
  
   
    VH01A02_CRIT.USER-GRP = VH01A01_DATA.USER-GROUP;
    VH01A02_CRIT.GUI-NAME = "VH001I";
  
  
  
  
  
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIE03I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VH01A02";
    try
        call "MRSVehicleMenu.VH01A02"(XDCONTROL, VH01A02_CRIT, VH01A02_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end


  

  
    if ("pbtEventLogCreateIncident" in VH01A02_DATA.PART-NAME)
        if (VH01A02_DATA.ACCESS-ALLOW[sysVar.arrayIndex] == "N")
            VHIE03IW-TRIGGERS.DISABLE-CREATE = "Y";
            VHIE03IW-TRIGGERS.DISABLE-CREATE-FLAG = "YES";
        else
            VHIE03IW-TRIGGERS.ENABLE-CREATE = "Y";
            VHIE03IW-TRIGGERS.DISABLE-CREATE-FLAG = "NO";
        end
    end
end 

Function VHIE03IS-ADD-DATA ()
  
  
  
  
  
  
  
   
    set VHIE03IS-MESSAGE empty;
    set VHIE03IS-HOLDMSG empty;
    set VHIE03IS-MESSAGE5 empty;
    MSGCNT = 1;

  
    VHIE03IW.ADD-ERROR = "N";
    if (VHIE04A_DATA.CAR-NO != " ")
        set VHINC6A_DATA empty;
  
        VHINC6A_CRIT.CAR-NO = VHIE04A_DATA.CAR-NO;
        try
            call "VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        
            if (XDCONTROL.UROWCNT == 0 ||
             (VHINC6A_DATA.CAR-TYPE-OCCR[1] != "A" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "B" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "C" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "D" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "E" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "L" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "M" && 
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "K"
              ))
                VHIE03IS-MESSAGE.MESSAGE = "Entered an INVALID Car No, ";
                VHIE03IW.ADD-ERROR = "Y";
            end
        else
            VHIE03IS-MESSAGE.MESSAGE = "Entered an INVALID Car No, ";
            VHIE03IW.ADD-ERROR = "Y";
        end
    end

  

  
    if (VHIE04A_DATA.CON-DIRECTION == "N" || VHIE04A_DATA.CON-DIRECTION == "S" || VHIE04A_DATA.CON-DIRECTION == "E" || VHIE04A_DATA.CON-DIRECTION == "W" || VHIE04A_DATA.CON-DIRECTION == " ")

    else
        VHIE03IS-MESSAGE5.MESSAGE[MSGCNT] = " INVALID Direction ";
        VHIE03IW.ADD-ERROR = "Y";
        MSGCNT = MSGCNT + 1;
    end

  
    if (VHIE04A_DATA.TRACKING-CD in VHIE03C_DATA.TRACKING-CD || VHIE04A_DATA.TRACKING-CD == " ")

    else
        VHIE03IS-MESSAGE5.MESSAGE[MSGCNT] = " INVALID Tracking Code ";
        VHIE03IW.ADD-ERROR = "Y";
        MSGCNT = MSGCNT + 1;
    end

  
    if (VHIE04A_DATA.ACTION-CD in VHIE03D_DATA.ACTION-CD || VHIE04A_DATA.ACTION-CD == " ")

    else
        VHIE03IS-MESSAGE5.MESSAGE[MSGCNT] = " INVALID Action Code ";
        VHIE03IW.ADD-ERROR = "Y";
        MSGCNT = MSGCNT + 1;
    end

  
    if (VHIE04A_DATA.VEH-TECH-ID in VHIE03B_DATA.VEH-TECH-ID || VHIE04A_DATA.VEH-TECH-ID == " ")

    else
        VHIE03IS-MESSAGE5.MESSAGE[MSGCNT] = " INVALID Tech ID ";
        VHIE03IW.ADD-ERROR = "Y";
        MSGCNT = MSGCNT + 1;
    end

  
  
  
  
  
  
  

  
  

  
  
  
  
  
  
  
  
  
  
  
  
  
  


  
  
  
  
  
    set VHIE03E_DATA empty;
    if (VHIE04A_DATA.CON-NO != " ")
  
  
        VHIE03E_DATA.CON-NO = VHIE04A_DATA.CON-NO;
        try
            call "VHIE03E"(XDCONTROL, VHIE03E_DATA);
        
        end
  
        if (VHIE03E_DATA.ITEM-COUNT == 0)
            VHIE03IS-MESSAGE.MESSAGE = "You Must  Entered a INVALID Con No";
            VHIE03IW.ADD-ERROR = "Y";
        end
    end 


  
    if (VHIE04A_DATA.CAR-NO == " " && VHIE04A_DATA.CON-NO == " ")
        VHIE03IW.ADD-ERROR = "Y";
        VHIE03IS-MESSAGE.MESSAGE = "You Must  Entered a valid VALID Car No,  or VALID Con No";
    end
    if (VHIE04A_DATA.SYMP-CD == " ")
  
  

    end

  
  
  
    if (VHIE03IW.ADD-ERROR == "N")
        set VHIE03IS-MESSAGE empty;

  
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHIE03IW.FROM-DATE;
        MRSCommonCode.XXDATES-CONVERT();
        VHIE04A_DATA.DATE-EVENT-OCCR = XXDATEW.DATE-YYYY-MM-DD;

  
  
        VHIE04A_DATA.DATE-REVENUE = VHIE03IW.REV-DATE;

  
        VHIE04A_DATA.USER-GRP = VHIE03IW-PASSVALUE.USER-GRP;
        VHIE04A_DATA.TERM-LAST-UPD = VHIE03IW-PASSVALUE.TERM-LAST-UPD;

  
        VHIE04A_DATA.BIN-DASH-NO = VHIE03G_DATA.BIN-DASH-NO[1];
        VHIE04A_DATA.TIME-INSRV = VHIE03G_DATA.TIME-INSRV[1];
        VHIE04A_DATA.DATE-INSRV-REV = VHIE03G_DATA.DATE-INSRV-REV[1];
        VHIE04A_DATA.DATE-INSRV = VHIE03G_DATA.DATE-INSRV[1];

  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHIE04A";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE04I";

    
        try
            call "VHIE04A"(XDCONTROL, VHIE04A_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
                if (VHIE03E_DATA.CON-STAT == "CON" || VHIE03E_DATA.CON-STAT == "CAR" || VHIE03E_DATA.CON-STAT == "SRV")
  
  

                end
                VHIE03IS-MESSAGE.MESSAGE = "Data Added Successfully";
                VHIE03IW-TRIGGERS.PUSH-LIST = "Y";
                VHIE03IW-TRIGGERS.RUN-REFRESH = "Y";
                


  
            else

  
        
        
  
                if (XDCONTROL.URC == 100)

                else
                    VHIE03IS-MESSAGE.MESSAGE = "There Was A Problem Adding Data From Your Input";
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end 

  
        end
  

  
  
  
    else 
  
        MCT = 1;
        if (VHIE03IS-MESSAGE5.MESSAGE[1] != " ")
            VHIE03IS-HOLDMSG.MSG[MCT] = VHIE03IS-MESSAGE5.MESSAGE[1];
            MCT = MCT + 1;
        end
        if (VHIE03IS-MESSAGE5.MESSAGE[2] != " ")
            VHIE03IS-HOLDMSG.MSG[MCT] = VHIE03IS-MESSAGE5.MESSAGE[2];
            MCT = MCT + 1;
        end
        if (VHIE03IS-MESSAGE5.MESSAGE[3] != " ")
            VHIE03IS-HOLDMSG.MSG[MCT] = VHIE03IS-MESSAGE5.MESSAGE[3];
            MCT = MCT + 1;
        end
        if (VHIE03IS-MESSAGE5.MESSAGE[4] != " ")
            VHIE03IS-HOLDMSG.MSG[MCT] = VHIE03IS-MESSAGE5.MESSAGE[4];
            MCT = MCT + 1;
        end
        if (VHIE03IS-MESSAGE5.MESSAGE[5] != " ")
            VHIE03IS-HOLDMSG.MSG[MCT] = VHIE03IS-MESSAGE5.MESSAGE[5];
            MCT = MCT + 1;
        end
        if (MCT > 1) 
            VHIE03IS-MESSAGE.MESSAGE = VHIE03IS-HOLDMSG.MESSAGE;
        end
    end
end 

Function VHIE03IS-ALL-CLEAR () 
    set VHIE03IS-MESSAGE empty;
    set VHIE04A_DATA empty;
    set VHIE03IW empty;
    set VHIE03A_DATA empty;
    set VHIE03A2_DATA empty;
    set VHIE03G_DATA empty;
    set VHIE03W-CARS empty;
    VHIE03IW.REC-COUNT = 1;
  
    SELECTION-IDX = 0;
    VHIE03IW-TRIGGERS.LOAD-DATA = "Y";
    VHIE03IW-TRIGGERS.DISABLE-PRINT = "Y";
    VHIE03IW-TRIGGERS.DISABLE-UPDATE = "Y";
    VHIE03IW-TRIGGERS.ENABLE-ADD = "Y";
    VHIE04IW2.SUCCESS-MESSAGE = " ";
end 

Function VHIE03IS-BLD-MSG ()
   
    ERROR-INDEX = 0;
    ERROR-MESSAGE = " ";
    if (VHIE04IW2.CAR-NO == "0000")
        if (INVALID-CAR-NO == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid car no.";
            VHIE04IW2.CAR-NO = " ";
        end
    else
        if (DISPLAY-INVALID-CAR-NO == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid car no.";
            VHIE04IW2.CAR-NO = " ";
        end
        if (DISPLAY-NOT-IN-SVC == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            if (VHIE04IW2.CAR-NO == "    " && VHIE04IW2.CON-NO != "   ")
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = " Consist is NOT in use.";
            else
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Car not in use.";
            end
        end
    end

  
    if (DISPLAY-INVALID-CON-NO == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid Con No.";
    end
    if (NO-CAR-IN-CON == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Consist has no car.";
    end
    if (VHIE04IW2.SYMP-CD == " ")
        if (INVALID-SYMP-CD == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid symp cd.";
        end
    else
        if (INVALID-SYMPCD-VAL == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Symp cd does not exist.";
        end
    end
    if (INVALID-DATE-INCD == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date of incident.";
    else
        if (DAYS-GR-05 == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Date cannot be older than 5 days.";
        else
            if (DISP-ERR-MSG == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future date not allowed.";
            end
        end
    end
    if (INVALID-TIME-INCD == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid time of incident.";
    else
        if (DISP-INVALID-TIME == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid time.";
        else
            if (DISP-TIME-ERRMSG == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future time not allowed.";
            end
        end
    end
    if (VHIE04IW2.SPEED == " ")
        if (INVALID-SPEED == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid speed.";
        end
    else
        if (INVALID-SPEED-VAL == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Speed does not have a valid value.";
        end
    end
    if (INVALID-DIRECTION == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid direction.";
    end
    if (ERROR-INDEX == 6)
        VHIE03IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-LOC == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid location.";
    end
    if (ERROR-INDEX == 6)
        VHIE03IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-NARR == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid incident narr.";
    end
    if (ERROR-INDEX == 6)
        VHIE03IS-MOVE-MSG();
        return;
    end
    if (INVALID-DATE == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date.";
    end

  
    if (INVALID-DATE-TIME == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date or time.";
    else
        if (DAYS-GR-45 == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
   
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Date too old (over 1095 days).";
        else
            if (DAYS-GR-7 == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
   
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Date too old (over 1095 days).";
            else
                if (FUTURE-DATE == "Y") 
                    ERROR-INDEX = ERROR-INDEX + 1;
                    ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future date not allowed.";
                else
                    if (FUTURE-TIME == "Y") 
                        ERROR-INDEX = ERROR-INDEX + 1;
                        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future time not allowed.";
                    end
                end
            end
        end
    end
    VHIE03IS-MOVE-MSG();
end 

Function VHIE03IS-CAR-NO ()
  
   
    if (VHIE04IW.CAR-NO != "    ")
        if (VHIE04IW.CAR-NO-NO < 1000)
            VHIE04IW.CAR-NO = VHIE04IW.CAR-NO-NO;
   
            if (VHIE04IW.CAR-NO-1 == " ")
                VHIE04IW.CAR-NO-1 = "0";
            end
        end
    end

  
  
  
    if (VHIE04IW2.CON-NO == " ")
        VHIE03IS-MESSAGE.MESSAGE = " ";
        set VHIE03H_DATA empty;
        VHIE03H_DATA.CAR-NO = VHIE04IW.CAR-NO;

  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHIE03H";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE03I";


  
 

    
        try
            call "VHIE03H"(XDCONTROL, VHIE03H_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  
                VHIE03W-CARS.CON = VHIE03H_DATA.CON-NO;
                VHIE03W-CARS.CON-DASH-NO = VHIE03H_DATA.DASH-NO-2;
                VHIE03W-CARS.CON-DASH-DASH = "-";
                if (VHIE03W-CARS.NO-1 == " ")
                    VHIE03W-CARS.NO-1 = "0";
                end
                VHIE04A_DATA.CON-DASH = VHIE03W-CARS.CON-DASH;
  
                VHIE03G_DATA.BIN-DASH-NO[1] = VHIE03H_DATA.BIN-DASH-NO;
                VHIE03G_DATA.TIME-INSRV[1] = VHIE03H_DATA.TIME-INSRV;
                VHIE03G_DATA.DATE-INSRV-REV[1] = VHIE03H_DATA.DATE-INSRV-REV;
                VHIE03G_DATA.DATE-INSRV[1] = VHIE03H_DATA.DATE-INSRV;
                


  
            else

  
        
        
  
                if (XDCONTROL.URC == 100)
                    VHIE03IS-MESSAGE.MESSAGE = "No Data Found for Date Request";
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end 
        end
    end
end 

Function VHIE03IS-CK-DATA-X ()
  

  
   
    set VHIE03IW-HOLDMSG empty;
    VHIE03IW-PASSVALUE.CAR-COUNTER = 1;
    while (VHIE03IW-PASSVALUE.CAR-COUNTER <= VHIE03IW-PASSVALUE.CON-COUNTER)
        if (VHIE03G_DATA.WHERE-IS-CAR[CAR-COUNTER] == "CON")
            ERROR-COUNT = ERROR-COUNT + 1;
            VHIE03IW-HOLDMSG.MSG2[ERROR-COUNT] = VHIE03G_DATA.CAR-NO[CAR-COUNTER];
  
            VHIE03IW-PASSVALUE.CAR-COUNTER = VHIE03IW-PASSVALUE.CAR-COUNTER + 1;
        else
            VHIE03IW-PASSVALUE.CAR-COUNTER = VHIE03IW-PASSVALUE.CAR-COUNTER + 1;
        end
    end
    if (ERROR-COUNT == 0)
  
        VHIE04IS-STOREDB-X();
    else
        VHIE03IW-HOLDMSG.MSG1 = "DASH NOT IN SERVICE CANNOT MAKE INCIDENT THESE CARS IN CON:";
        VHIE03IS-MESSAGE.MESSAGE = VHIE03IW-HOLDMSG.MSG;
    end
end 

Function VHIE03IS-CK-DATA-Y () 
    VHIE03IW-PASSVALUE.CAR-COUNTER = 1;
    while (VHIE03IW-PASSVALUE.CAR-COUNTER <= VHIE03IW-PASSVALUE.CON-COUNTER)
        if (VHIE03G_DATA.WHERE-IS-CAR[CAR-COUNTER] == "CON")
            VHIE03IS-MESSAGE.MESSAGE = "CAR IN THE CONSIST IS STILL ON CON, CANNOT MAKE INCIDENT";
            ERROR-COUNT = ERROR-COUNT + 1;
            VHIE03IW-PASSVALUE.CAR-COUNTER = VHIE03IW-PASSVALUE.CAR-COUNTER + 1;
        else
            VHIE03IW-PASSVALUE.CAR-COUNTER = VHIE03IW-PASSVALUE.CAR-COUNTER + 1;
        end
    end
    if (ERROR-COUNT == 0)
        VHIE04IW-TRIGGERS.RUN-IVR-STOR-DB = "Y";
    end
end 

Function VHIE03IS-CLEAR () 
    set VHIE03IS-MESSAGE empty;
    set VHIE04A_DATA empty;
  
    set VHIE03A_DATA empty;
    VHIE03IW.REC-COUNT = 1;
  
    SELECTION-IDX = 0;
  
