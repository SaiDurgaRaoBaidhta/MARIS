            VHIE03A2_DATA.INCD-IND[ICT] = "X";
        else
            VHIE03A2_DATA.INCD-IND[ICT] = " ";
        end

  
        VHIE03A2_DATA.DATE-INSRV-REV[ICT] = VHIE03A_DATA.DATE-INSRV-REV[ICT];
        VHIE03A2_DATA.DATE-INSRV[ICT] = VHIE03A_DATA.DATE-INSRV[ICT];
        VHIE03A2_DATA.TIME-INSRV[ICT] = VHIE03A_DATA.TIME-INSRV[ICT];
