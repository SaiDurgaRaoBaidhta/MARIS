    VHEVLX_DATA.TIME-INCD-OCCR = VHIE04A_DATA.TIME-EVENT-OCCR;

  
    VHEVLX_DATA.USER-GRP = VHIE04A_DATA.USER-GRP;
    VHEVLX_DATA.DATE-NARR = VHIE03IW.REV-DATE;
  
  
  
  
