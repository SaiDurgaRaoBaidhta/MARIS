    VHIE03IW-PRINT.GUI-TO = VHIE04W_PASSEDTO.EVENT-DATE;
    VHIE03IW-PRINT.TERM-ID = VHIE04W_PASSEDTO.TERM-LAST-UPD;
    VHIE03IW-PRINT.FROM-DATE = VHIE04W_PASSEDTO.REV-DATE;
    VHIE03IW-PRINT.EVENT-ID = VHIE04W_PASSEDTO.EVENT-ID;
