Function VHIE04IS-PSEUDO () 
    CAR-IN-CON = "N";
    set VHINXA_DATA empty;
    VHINXA_CRIT.CAR-NO = VHIE04IW2.CAR-NO;
    try
        call "VHINXA"(XDCONTROL, VHINXA_CRIT, VHINXA_DATA);
    
    end
    
    
    MRSCommonCode.XXA0IS-CHECK_EXT();
    
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            CAR-IN-CON = "Y";
        else
        
        
      
      
      
      

        end 
    end
    if (CAR-IN-CON == "Y")
        VHINXB_CRIT.CON-NO = VHINXA_DATA.CON-NO;
        VHINXB_DATA.TERM-LAST-UPD = VHIE04A_DATA.TERM-LAST-UPD;
        VHINXB_DATA.USER-GROUP = VHIE04A_DATA.USER-GRP;
        CAR-CNT = 1;
        while (CAR-CNT <= 10)
            VHINXB_DATA.CAR-NUM[CAR-CNT] = VHINXA_DATA.CAR-NO[CAR-CNT];
            VHINXB_DATA.CON-NUM[CAR-CNT] = VHINXA_DATA.CON-NO[CAR-CNT];
            CAR-CNT = CAR-CNT + 1;
        end
        try
            call "VHINXB"(XDCONTROL, VHINXB_CRIT, VHINXB_DATA);
        
        end
        
    
        MRSCommonCode.XXA0IS-CHECK_EXT();
    
        if (XXEXT_CALL_Level77Items.URC == 0)
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHINC3A_CRIT.SEND-RESET-MSG = "Y";
                 
            else
        
        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

Function VHIE04IS-RETURN () 
    set VHIE04IW2 empty;
end 

