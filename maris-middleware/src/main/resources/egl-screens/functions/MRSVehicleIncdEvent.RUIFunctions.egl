    end
end 

Function VHIE03IS-DATE-CK () 
    VHIE03IW-TRIGGERS.DATES-ARE-OK = "Y";
    set VHIE03IS-MESSAGE empty;
    VHIE03IW.TODAY = VHIE01B_DATA.CURRENT-DATE;

  
    VHIE03IW.ISO-YYYY-A = VHIE03IW.TO-YEAR;
    VHIE03IW.ISO-MM-A = VHIE03IW.TO-MM;
    VHIE03IW.ISO-DD-A = VHIE03IW.TO-DD;
    VHIE03IW.ISO-DASH1-A = "-";
    VHIE03IW.ISO-DASH2-A = "-";
    if (VHIE03IW.ISO-DATE-A > VHIE03IW.TODAY)
        VHIE03IS-MESSAGE.MESSAGE = "Future TO Date is Not Allowed";
        VHIE03IW-TRIGGERS.DATES-ARE-OK = "N";
    end
  
  

  
    VHIE03IW.ISO-YYYY-B = VHIE03IW.FROM-YEAR;
    VHIE03IW.ISO-MM-B = VHIE03IW.FROM-MM;
    VHIE03IW.ISO-DD-B = VHIE03IW.FROM-DD;
    VHIE03IW.ISO-DASH1-B = "-";
    VHIE03IW.ISO-DASH2-B = "-";
    if (VHIE03IW.ISO-DATE-B > VHIE03IW.TODAY)
        VHIE03IS-MESSAGE.MESSAGE = "Future FROM Date is Not Allowed";
        VHIE03IW-TRIGGERS.DATES-ARE-OK = "N";
    end
    if (VHIE03IW.ISO-DATE-A < VHIE03IW.ISO-DATE-B)
        VHIE03IS-MESSAGE.MESSAGE = "FROM Date Must Be Less Than or Equal to TO Date";
        VHIE03IW-TRIGGERS.DATES-ARE-OK = "N";
    end

  
    if (VHIE03IW-TRIGGERS.DATES-ARE-OK == "Y")
        VHIE03IW-TRIGGERS.RUN-RETRIEVE = "Y";
    end
end 

