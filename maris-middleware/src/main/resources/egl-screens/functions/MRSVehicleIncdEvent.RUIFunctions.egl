    VHEVLX_CRIT.INCD-TYPE = "REV";
    VHEVLX_CRIT.INCIDENT-NAME = "IVR";
    VHEVLX_DATA.TERM-LAST-UPD = VHIE04A_DATA.TERM-LAST-UPD;
    VHEVLX_DATA.INCD-TYPE = VHEVLX_CRIT.INCD-TYPE;
    try
        call "VHEVLX"(XDCONTROL, VHEVLX_CRIT, VHEVLX_DATA);
    
    end
