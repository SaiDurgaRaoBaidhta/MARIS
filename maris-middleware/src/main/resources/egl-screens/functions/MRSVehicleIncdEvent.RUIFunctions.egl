                        VHIE03W-CARS.CAR10 = VHIE03G_DATA.CAR-FORMAT[CONCT];
                    end
                    CONCT = CONCT + 1;
                end

  
                VHIE03W-CARS.CON = VHIE03G_CRIT.CON-NO;
                VHIE03W-CARS.CON-DASH-NO = VHIE03G_DATA.DASH-NO-2[1];
                VHIE03W-CARS.CON-DASH-DASH = "-";
                if (VHIE03W-CARS.NO-1 == " ")
                    VHIE03W-CARS.NO-1 = "0";
                end
                VHIE04A_DATA.CON-DASH = VHIE03W-CARS.CON-DASH;
                

  
            else

  
        
        
  
                if (XDCONTROL.URC == 100)
                    VHIE03IS-MESSAGE.MESSAGE = "No Data Found for Date Request";
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end 
        end
    end


  
  
  
  
    if (VHIE04IW2.CON-NO != " " && VHIE04A_DATA.DATE-INSRV-REV != " " && VHIE04A_DATA.TIME-INSRV != " ")
        VHIE03IS-MESSAGE.MESSAGE = " ";

  
