                        VHIE03W-CARS.CAR7 = VHIE03G_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 8)
                        VHIE03W-CARS.CAR8 = VHIE03G_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 9)
                        VHIE03W-CARS.CAR9 = VHIE03G_DATA.CAR-FORMAT[CONCT];
                    end
