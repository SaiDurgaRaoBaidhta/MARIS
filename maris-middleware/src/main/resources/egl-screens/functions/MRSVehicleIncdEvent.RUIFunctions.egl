     VHEVLX_CRIT.ERR-FOUND == "N")
        VHIE04A_DATA.INCD-NO = VHEVLX_DATA.INCD-NO;
  
        VHIE04IW2.INCD-NO = VHEVLX_DATA.INCD-NO;
  
        VHIE04IW2.NARR-COUNT = 1;
        SUCCESS-MESSAGE-1 = "Incd No ";
        SUCCESS-MESSAGE-2 = VHEVLX_DATA.INCD-NO;
        SUCCESS-MESSAGE-3 = " for Car ";
        SUCCESS-MESSAGE-4 = VHIE04IW2.CAR-NO;
        SUCCESS-MESSAGE-5 = " was filed succesfully";
        VHIE04IW-TRIGGERS.RUN-UPDATE = "Y";
         
  
  
  
  
  
        VHIE04IS-CA-CICS(); 
  
                                   
    else
        EXECUTE-CLEAR = "Y";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

