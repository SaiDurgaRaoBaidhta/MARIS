Function VHIE04IS-MOVE-MSG () 
    VHIE04IW2.ERROR-LOOP-INDEX = 1;
    VHIE04IW2.FINAL-INDEX = 0;
    VHIE04IW2.FINAL-ERROR-MSG = " ";
    VHIE04IW2.SUCCESS-MESSAGE = " ";
    VHIE04IW2.TEMP-ERROR-MSG = " ";
    if (ERROR-INDEX > 0)
        while (((ERROR-LOOP-INDEX <= 6) &&
         (ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX] != " ")))
            ERROR-INDEX = 1;
            TEMP-ERROR-MSG = ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX];
            while ((ERROR-INDEX <= 40))
                if (TEMP-MSG[ERROR-INDEX] != ".")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = TEMP-MSG[ERROR-INDEX];
                else
                    if (TEMP-MSG[ERROR-INDEX] == ".")
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = ",";
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = " ";
                        ERROR-INDEX = 40;
                    end
                end
                ERROR-INDEX = ERROR-INDEX + 1;
            end
            ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
        end
        FINAL-INDEX = FINAL-INDEX - 1;
        FINAL-MSG[FINAL-INDEX] = " ";
        VHIE04IS-MESSAGE.MESSAGE = FINAL-ERROR-MSG;
        EXECUTE-SETFOCUS = "Y";
    end
end 

Function VHIE04IS-OUTSRVCON ()
  
  

  
  
  
   
    SUCCESS-MESSAGE = " ";
    set VHEVL1F_CRIT empty;
    set VHEVL1F_DATA empty;


  
  
    VHEVL1F_DATA.CAR-NO = "0095"; 
    VHEVL1F_CRIT.CON-NO = VHIE04A_DATA.CON-NO;
    VHEVL1F_DATA.CON-NO = VHIE04A_DATA.CON-NO;
    VHEVL1F_DATA.DISCV-DUR = "1";
    VHEVL1F_DATA.INCD-LOC = VHIE04A_DATA.EVENT-LOC;
    VHEVL1F_DATA.SYMP-CD = VHIE04A_DATA.SYMP-CD;
    VHEVL1F_DATA.CON-DIRECTION = VHIE04A_DATA.CON-DIRECTION;
    VHEVL1F_DATA.SPEED = VHIE04A_DATA.SPEED;
    VHEVL1F_DATA.TERM-LAST-UPD = VHIE04A_DATA.TERM-LAST-UPD;
    VHEVL1F_DATA.DATE-INCD-OCCR-REV = VHIE03IW.REV-DATE;

  
  
  
    VHIE04IW2.TIME-W-H = VHIE04IW2.DISP-TIME-INCD-OCCR-HR; 
    VHIE04IW2.TIME-W-M = VHIE04IW2.DISP-TIME-INCD-OCCR-MIN; 
    VHIE04IW2.TIME-W-COLON = ":"; 
    VHIE04IW2.TIME-W-S = ":00"; 
    if (VHIE04IW2.TIME-W-H1 == " ")
        VHIE04IW2.TIME-W-H1 = "0";
    end
    if (VHIE04IW2.TIME-W-M1 == " ")
        VHIE04IW2.TIME-W-M1 = "0";
    end

  
    VHINCE_CRIT.REVENUE-DATE = VHIE03IW.REV-DATE;
    VHINCE_CRIT.REVENUE-TIME = VHIE04A_DATA.TIME-EVENT-OCCR;
    try
        call "VHINCE"(XDCONTROL, VHINCE_CRIT, VHINCE_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHEVL1F_DATA.DATE-INCD-OCCR = VHINCE_DATA.SYSTEM-DATE;
    else
        VHEVL1F_DATA.DATE-INCD-OCCR = " ";
    end
    VHEVL1F_DATA.TIME-INCD-OCCR = VHIE04A_DATA.TIME-EVENT-OCCR;

  
    VHEVL1F_DATA.USER-GRP = VHIE04A_DATA.USER-GRP;
    VHEVL1F_DATA.DATE-NARR = VHIE03IW.REV-DATE;
  
  
    VHEVL1F_DATA.TIME-NARR = VHIE04A_DATA.TIME-EVENT-OCCR;
    VHEVL1F_DATA.NARR = VHIE04A_DATA.NARRATIVE;
  
    try
        call "VHEVL1F"(XDCONTROL, VHEVL1F_CRIT, VHEVL1F_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHIE04A_DATA.INCD-NO = VHEVL1F_DATA.INCD-NO;
  
        VHIE04IW2.INCD-NO = VHEVL1F_DATA.INCD-NO;
  
        SUCCESS-MESSAGE-1 = "Incd No ";
        SUCCESS-MESSAGE-2 = VHEVL1F_DATA.INCD-NO;
        SUCCESS-MESSAGE-3 = " for Con";
        SUCCESS-MESSAGE-4 = VHEVL1F_CRIT.CON-NO;
        SUCCESS-MESSAGE-5 = " was generated successfully";
        VHIE04IW-TRIGGERS.RUN-UPDATE = "Y";
         
  
  
  
                                   
  
  
  
  
  
  
    else
        VHIE03IS-MESSAGE.MESSAGE = "There Was A Problem Creating This Train Incident Number";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHIE04IS-PRINT () 
    VHIE03IW-PRINT.PRINT-IDX = 3;
    VHIE03IW-PRINT.WHICH-REPORT = "VHIE04I";
    VHIE03IW-PRINT.USER-GROUP = VHIE04W_PASSEDTO.USER-GRP;
