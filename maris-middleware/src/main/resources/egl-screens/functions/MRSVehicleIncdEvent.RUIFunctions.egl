            VHIE03A2_DATA.CON[ICT] = VHIE03A_DATA.CON-NO[ICT];
            VHIE03A2_DATA.CON-DASH-DASH[ICT] = "-";
            VHIE03A2_DATA.CON-DASH-NO[ICT] = VHIE03A_DATA.NO-2[ICT];
            VHIE03A2_DATA.BIN-DASH-NO[ICT] = VHIE03A_DATA.BIN-DASH-NO[ICT];
        end
  
        VHIE03A2_DATA.NARR[ICT] = VHIE03A_DATA.NARR[ICT];

  
        VHIE03A2_DATA.E-DATE[ICT] = VHIE03A_DATA.DATE-EVENT-OCCR[ICT];
        VHIE03A2_DATA.E-DASH[ICT] = "-";
        VHIE03A2_DATA.E-NUM[ICT] = VHIE03A_DATA.CNT-EVENTS[ICT];
        ICT = ICT + 1;
    end


  
    VHIE03IW-TRIGGERS.LOAD-DATA = "Y";
  

  
    VHIE03IW-TRIGGERS.DISABLE-UPDATE = "Y";
end 

