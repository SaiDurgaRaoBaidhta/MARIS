end 

Function VHIE03IS-CON ()
  
  

   
    if (VHIE04IW2.CON-NO != " " && VHIE04A_DATA.DATE-INSRV-REV == " " && VHIE04A_DATA.TIME-INSRV == " ")
        VHIE03IS-MESSAGE.MESSAGE = " ";

  
        VHIE03G_CRIT.YEAR-INSRV = VHIE03IW.FROM-YEAR;
        VHIE03G_CRIT.MONTH-INSRV = VHIE03IW.FROM-MM;
        VHIE03G_CRIT.DAY-INSRV = VHIE03IW.FROM-DD;
        VHIE03G_CRIT.DASH1-INSRV = "-";
        VHIE03G_CRIT.DASH2-INSRV = "-";
        VHIE03G_CRIT.FLAG = "1";
        VHIE03G_CRIT.CON-NO = VHIE04IW2.CON-NO;

  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHIE03G";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE03I";


  
        set VHIE03G_DATA empty;

    
        try
            call "VHIE03G"(XDCONTROL, VHIE03G_CRIT, VHIE03G_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
                set VHIE03W-CARS empty;
                VHIE03IW-PASSVALUE.CON-COUNTER = XDCONTROL.UROWCNT - 1;
                CONCT = 1;
                while (CONCT <= XDCONTROL.UROWCNT)
                    if (CONCT == 1)
                        VHIE03W-CARS.CAR1 = VHIE03G_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 2)
                        VHIE03W-CARS.CAR2 = VHIE03G_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 3)
                        VHIE03W-CARS.CAR3 = VHIE03G_DATA.CAR-FORMAT[CONCT];
                    end
