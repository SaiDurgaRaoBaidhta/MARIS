Function VHIE04IS-STOREDB-F ()
  
  

  
  
   
    SUCCESS-MESSAGE = " ";
    set VHEVLY_CRIT empty;
    set VHEVLY_DATA empty;
    VHIE04IW2.MARIS-FUNC = "VHINC";
    VHEVLY_CRIT.TYPE-IND = "REV"; 
  
  
    VHEVLY_CRIT.CAR-NO = VHIE04A_DATA.CAR-NO;
    VHEVLY_DATA.CAR-NO = VHIE04A_DATA.CAR-NO;
    VHEVLY_DATA.CON-NO = VHIE04A_DATA.CON-NO;
    VHEVLY_DATA.CON-DIRECTION = VHIE04A_DATA.CON-DIRECTION;
    VHEVLY_DATA.SPEED = VHIE04A_DATA.SPEED;
    VHEVLY_DATA.DASH-NO = VHIE04A_DATA.BIN-DASH-NO;
    VHEVLY_DATA.DISCV-DUR = "1";
    VHEVLY_DATA.INCD-LOC = VHIE04A_DATA.EVENT-LOC;
    VHEVLY_DATA.SYMP-CD = VHIE04A_DATA.SYMP-CD;
    VHEVLY_DATA.TERM-LAST-UPD = VHIE04A_DATA.TERM-LAST-UPD;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHIE04A_DATA.DATE-INSRV;
    MRSCommonCode.XXDATES-CONVERT();
    VHEVLY_DATA.DATE-INSRV = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.DATE-MM-DD-YYYY = VHIE04A_DATA.DATE-INSRV-REV;
    MRSCommonCode.XXDATES-CONVERT();
    VHEVLY_DATA.DATE-INSRV-REV = XXDATEW.DATE-YYYY-MM-DD;
    VHEVLY_DATA.TIME-INSRV = VHIE04A_DATA.TIME-INSRV;


  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
    VHEVLY_DATA.DATE-INCD-OCCR-REV = VHIE03IW.REV-DATE; 
    VHEVLY_CRIT.DATE-INCD-OCCR-REV = VHIE03IW.REV-DATE;

  
  
  
  
  
    VHEVLY_DATA.DATE-INCD-OCCR = VHIE03IW.REV-DATE; 
    VHEVLY_DATA.TIME-INCD-OCCR = VHIE04A_DATA.TIME-EVENT-OCCR;

  
    VHEVLY_DATA.USER-GRP = VHIE04A_DATA.USER-GRP;
    VHEVLY_DATA.DATE-NARR = VHIE03IW.REV-DATE; 

  
  
    VHEVLY_DATA.TIME-NARR = VHIE04A_DATA.TIME-EVENT-OCCR;
    VHEVLY_DATA.NARR = VHIE04A_DATA.NARRATIVE;
    VHEVLY_DATA.MARIS-FUNC = VHIE04IW2.MARIS-FUNC;
  
    if (VHEVLY_CRIT.TYPE-IND == "YRD") 
        VHEVLY_CRIT.INCD-PFX = "A";
        VHEVLY_CRIT.INCD-TYPE = "YRD";
        VHEVLY_CRIT.INCIDENT-NAME = "IVY";
    else
        if (VHEVLY_CRIT.TYPE-IND == "SHP") 
            VHEVLY_CRIT.INCD-PFX = "J";
            VHEVLY_CRIT.INCD-TYPE = "SHP";
            VHEVLY_CRIT.INCIDENT-NAME = "IVD";
        else
            if (VHEVLY_CRIT.TYPE-IND == "REV") 
                VHEVLY_CRIT.INCD-PFX = "G";
                VHEVLY_CRIT.INCD-TYPE = "REV";
                VHEVLY_CRIT.INCIDENT-NAME = "IVH";
            end
        end
    end
    VHEVLY_DATA.INCD-TYPE = VHEVLY_CRIT.INCD-TYPE;
    try
        call "VHEVLY"(XDCONTROL, VHEVLY_CRIT, VHEVLY_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
        VHIE04IW2.INCD-NO = VHEVLY_DATA.INCD-NO;
  
        VHIE04A_DATA.INCD-NO = VHEVLY_DATA.INCD-NO;
        VHIE04IW2.NARR-COUNT = 1;
        SUCCESS-MESSAGE-1 = "Incd No ";
        SUCCESS-MESSAGE-2 = VHEVLY_DATA.INCD-NO;
        SUCCESS-MESSAGE-3 = " for Car ";
        SUCCESS-MESSAGE-4 = VHIE04IW2.CAR-NO;
        SUCCESS-MESSAGE-5 = " was filed succesfully";
        VHIE04IW-TRIGGERS.RUN-UPDATE = "Y";
         
  
  
  
  
  
        VHIE04IS-UPD-STAT();
        VHIE04IS-CA-CICS();
  
    else
        VHIE03IS-MESSAGE.MESSAGE = "There Was A Problem Creating This Revenue Incident Fix  Number";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

