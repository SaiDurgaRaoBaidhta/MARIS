    VHINC1X_DATA.USER-GRP = VHIE04A_DATA.USER-GRP;
    VHINC1X_DATA.DATE-NARR = VHIE03IW.REV-DATE;
  
  
    VHINC1X_DATA.TIME-NARR = VHIE04A_DATA.TIME-EVENT-OCCR;
    VHINC1X_DATA.NARR = VHIE04A_DATA.NARRATIVE;
  
    try
        call "VHINC1X"(XDCONTROL, VHINC1X_CRIT, VHINC1X_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHIE04A_DATA.INCD-NO = VHINC1X_DATA.INCD-NO;
  
        VHIE04IW2.INCD-NO = VHINC1X_DATA.INCD-NO;
  
        SUCCESS-MESSAGE-1 = "Incd No ";
        SUCCESS-MESSAGE-2 = VHINC1X_DATA.INCD-NO;
        SUCCESS-MESSAGE-3 = " for Con";
        SUCCESS-MESSAGE-4 = VHINC1X_CRIT.CON-NO;
        SUCCESS-MESSAGE-5 = " was generated successfully";
        VHIE04IW-TRIGGERS.RUN-UPDATE = "Y";
         
  
  
  
                                   
  
  
  
  
  
  
    else
        VHIE03IS-MESSAGE.MESSAGE = "There Was A Problem Creating This Train Incident Number";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHIE04IS-SYMP-DESC ()
  
   
    if (VHIE04IW.SYMP-CD-OBJECT != VHIE04W_PASSEDTO.SYMP-CD)
        if (VHIE04IW.SYMP-CD-OBJECT in VHIE04D_DATA.SYMP-CD)
            VHIE04IW.SYMP-CD-INDEX-22 = sysVar.arrayIndex;
        end
        if (VHIE04IW.SYMP-CD-INDEX-22 > 0)
  
            VHIE04IW.NARR = VHIE04D_DATA.SYMP-CD-NARR[SYMP-CD-INDEX-22];
        else
            VHIE04IW.SYMP-CD-DESC = "Not a Valid Symptom Code";
        end
    end
end 

Function VHIE04IS-TEMP-ONLY ()
   
    VHIE04IS-MESSAGE.MESSAGE = "You Have Asked for a Incident Fix (train out of service), but This Incident Type is still in Testing";
end 

Function VHIE04IS-TIME ()
  
   
    if (VHIE04W_PASSEDTO.TIME-EVENT-HHMM != VHIE04IW2.DISP-TIME-INCD-OCCR)
        VHIE04IS-MESSAGE.MESSAGE = " ";
        DISP-INVALID-TIME = "N";
  
  

  
  
        VHIE04IW-TIME.HOURS1 = VHIE04IW-TIME.POS8;
        VHIE04IW-TIME.HOURS2 = VHIE04IW-TIME.POS7;
        VHIE04IW-TIME.COLON = ":";
        VHIE04IW-TIME.MINUTES1 = VHIE04IW-TIME.POS6;
        VHIE04IW-TIME.MINUTES2 = VHIE04IW-TIME.POS5;
        VHIE04IW-TIME.COLON2 = ":";
        VHIE04IW-TIME.SEC1 = VHIE04IW-TIME.POS2;
        VHIE04IW-TIME.SEC2 = VHIE04IW-TIME.POS1;

  
        if (VHIE04IW-TIME.SEC1 == " ")
            VHIE04IW-TIME.SEC1 = "0";
        end
        if (VHIE04IW-TIME.SEC2 == " ")
            VHIE04IW-TIME.SEC2 = "0";
        end

  
        if (VHIE04IW-TIME.HOURS1 == " ")
            VHIE04IW-TIME.HOURS1 = "0";
        end

  
        VHIE04IW-TIME.TIME-CHECK = VHIE04IW-TIME.TIME-OUT; 
        if (VHIE04IW2.DISP-TIME-INCD-OCCR != " ")
            if (VHIE04IW-TIME.TIME-CHECK-HR > 24 ||
             (VHIE04IW-TIME.TIME-CHECK-HR == 24 && VHIE04IW-TIME.TIME-CHECK-MIN > 0) ||
             (VHIE04IW-TIME.TIME-CHECK-HR == 0 && VHIE04IW-TIME.TIME-CHECK-MIN == 0) ||
             (VHIE04IW-TIME.TIME-CHECK-MIN > 59))
  
                DISP-INVALID-TIME = "Y";
                VHIE04IS-MESSAGE.MESSAGE = "You Have Entered An Invalid Time";
                VHIE04IW-TRIGGERS.FOCUS-TIME = "Y";
            end
        end
        if (DISP-INVALID-TIME == "N")
            VHIE04W_PASSEDTO.TIME-EVENT-OCCR = VHIE04IW-TIME.TIME-OUT;
        end
    end
end 

Function VHIE04IS-TRK-DESC ()
   
    if (VHIE04IW.TRACK-CD-OBJECT in VHIE03C_DATA.TRACKING-CD)
        VHIE04IW.TRACK-CD-INDEX-2 = sysVar.arrayIndex;
    end
    if (VHIE04IW.TRACK-CD-INDEX-2 > 0)
        VHIE04IW.TRACK-CD-DESC = VHIE03C_DATA.TRACKING-DESC[TRACK-CD-INDEX-2];
    else
        VHIE04IW.TRACK-CD-DESC = "Not a Valid Tracking Code";
    end
end 

Function VHIE04IS-UPD-STAT () 
    VHINXC_CRIT.CAR-NO = VHIE04A_DATA.CAR-NO;
    VHINXC_DATA.TERM-LAST-UPD = VHIE04A_DATA.TERM-LAST-UPD;
    try
        call "VHINXC"(XDCONTROL, VHINXC_CRIT, VHINXC_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHIE04IS-UPDATE ()
  
  
  
  
  
  
  
   
    VHIE04B_DATA.DELETE-IND = "N";
    set VHIE04IS-MESSAGE empty;
    if (VHIE04IW.DELETE-IND == "Y") 
        VHIE04B_DATA.DELETE-IND = "Y";
    end

  
    VHIE04B_CRIT.DATE-REVENUE = VHIE04W_PASSEDTO.REV-DATE;
    VHIE04B_CRIT.CNT-EVENTS = VHIE04W_PASSEDTO.CNT-EVENTS;
    VHIE04B_CRIT.HAS-CA-NARR = VHIE04IW.HAS-CA-NARR;

  
    VHIE04B_DATA.CAR-NO = VHIE04W_PASSEDTO.CAR-NO;
    VHIE04B_DATA.CON-NO = VHIE04W_PASSEDTO.CON-NO;
    VHIE04B_DATA.CON-DIRECTION = VHIE04W_PASSEDTO.CON-DIRECTION;
    VHIE04B_DATA.EVENT-LOC = VHIE04W_PASSEDTO.EVENT-LOC;

  
    VHIE04IW2.TIME-W-H = VHIE04IW2.DISP-TIME-INCD-OCCR-HR; 
    VHIE04IW2.TIME-W-M = VHIE04IW2.DISP-TIME-INCD-OCCR-MIN; 
    VHIE04IW2.TIME-W-COLON = ":"; 
    VHIE04IW2.TIME-W-S = ":00"; 
    if (VHIE04IW2.TIME-W-H1 == " ")
        VHIE04IW2.TIME-W-H1 = "0";
    end
    if (VHIE04IW2.TIME-W-M1 == " ")
        VHIE04IW2.TIME-W-M1 = "0";
    end
    VHIE04W_PASSEDTO.TIME-EVENT-OCCR = TIME-WORKINGSTORAGE;
    VHIE04B_DATA.TIME-EVENT-OCCR = TIME-WORKINGSTORAGE;

  
    if (VHIE04IW.SYMP-CD-OBJECT == VHIE04W_PASSEDTO.SYMP-CD) 
        VHIE04B_DATA.SYMP-CD = VHIE04W_PASSEDTO.SYMP-CD;
        VHIE04B_DATA.NARR = VHIE04IW.NARR;
    end
    if (VHIE04IW.SYMP-CD-OBJECT != VHIE04W_PASSEDTO.SYMP-CD) 
        VHIE04B_DATA.SYMP-CD = VHIE04IW.SYMP-CD-OBJECT;
        VHIE04B_DATA.NARR = VHIE04IW.NARR;
    end
    VHIE04B_DATA.NARR-NO = 1; 
    VHIE04B_DATA.ACTION-CD = VHIE04IW.ACTION-CD-OBJECT;
    VHIE04B_DATA.VEH-TECH-ID = VHIE04IW.TECH-CD-OBJECT;
    VHIE04B_DATA.TRACKING-CD = VHIE04IW.TRACK-CD-OBJECT;
    VHIE04B_DATA.CA-NARR = VHIE04IW.CA-NARR;
    VHIE04B_DATA.CA-NARR-NO = VHIE04IW.CA-NARR-NO;
    VHIE04B_DATA.SPEED = VHIE04W_PASSEDTO.SPEED;

  
    if (VHIE04IW2.INCD-NO != "         ") 
        VHIE04B_DATA.INCD-NO = VHIE04IW2.INCD-NO;
    else
        VHIE04B_DATA.INCD-NO = VHIE04W_PASSEDTO.INCD-NO;
         
    end

  
    VHIE04B_DATA.TERM-LAST-UPD = VHIE04W_PASSEDTO.TERM-LAST-UPD;
    VHIE04B_DATA.USER-GRP = VHIE04W_PASSEDTO.USER-GRP;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIE04B";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE04I";

    
    try
        call "VHIE04B"(XDCONTROL, VHIE04B_CRIT, VHIE04B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            if (VHIE04IW.DELETE-IND == "Y") 
                VHIE04IS-MESSAGE.MESSAGE = "Data was Successfully Deleted ";
            end
  
            if (VHIE04IW2.SUCCESS-MESSAGE != " ")
                VHIE04IS-MESSAGE.MESSAGE = VHIE04IW2.SUCCESS-MESSAGE;
                 
            else
                VHIE04IS-MESSAGE.MESSAGE = "Data was Updated  Successfully ";
                 
            end
  
  
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                VHIE04IS-MESSAGE.MESSAGE = "There Was A Problem Adding Data From Your Input";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end
    VHIE04IW.DELETE-IND = "N";
end 

Function VHIE04IS-WHICH-ONE ()
  

  
  
  

   
    if (VHIE04W_PASSEDTO.CAR-NO == "    " && VHIE04W_PASSEDTO.CON-NO != "    ")
        VHIE04IW-TRIGGERS.RUN-TRAIN-INCD = "Y";
    end

  
    if (VHIE04IW2.CAR-NO != " ")
        set VHINC6A_DATA empty;
  
        VHINC6A_CRIT.CAR-NO = VHIE04IW2.CAR-NO;
        try
            call "VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        
            if (XDCONTROL.UROWCNT == 0 ||
             (VHINC6A_DATA.CAR-TYPE-OCCR[1] != "A" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "B" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "C" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "D" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "E" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "L" &&
              VHINC6A_DATA.CAR-TYPE-OCCR[1] != "M" && 
               VHINC6A_DATA.CAR-TYPE-OCCR[1] != "K"))
                VHIE04IS-MESSAGE.MESSAGE = "You Have Entered an INVALID Car No, and NO Consist Number";
            else

  
                if (VHINC6A_DATA.WHERE-IS-CAR == "CON") 
                    VHIE04IW-TRIGGERS.RUN-IVR = "Y";
                end
                if (VHINC6A_DATA.WHERE-IS-CAR != "CON") 
                    VHIE04IW-TRIGGERS.RUN-INCD-FIX = "Y";
                end
   
            end
        end
    else
        if (XDCONTROL.URC == 100)
            VHIE04IS-MESSAGE.MESSAGE = "You Have Entered an INVALID Car No, and NO Consist Number";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHIE06-CAR-NO ()
  
   
    if (VHIE06IW.CAR-NO != "    ")
        if (VHIE06IW.CAR-NUM < 1000)
    
            VHIE06IW.CAR-NO = VHIE06IW.CAR-NUM-CHAR;
            if (VHIE06IW.CAR-NO-1 == " ")
                VHIE06IW.CAR-NO-1 = "0";
            end
        end
    end

  
  
  
    VHIE06IW-MSG.MSG = " ";
    set VHIE03H_DATA empty;
    VHIE03H_DATA.CAR-NO = VHIE06IW.CAR-NO;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIE03H";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE03I";


  


    
    try
        call "VHIE03H"(XDCONTROL, VHIE03H_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
  
        if (VHIE03H_DATA.CON-NO != "   ")

  
            VHIE06IW.CON = VHIE03H_DATA.CON-NO;
            VHIE06IW.CON-DASH-NO = VHIE03H_DATA.DASH-NO-2;
            VHIE06IW.CON-DASH-DASH = "-";
            if (VHIE06IW.NO-1 == " ")
                VHIE06IW.NO-1 = "0";
            end

  
            VHIE06W-CARS.CON = VHIE06IW.CON;
            VHIE06IW.CLICK-FIND-CARS = "Y";
            

  
        else

  
        
        
  
            if (XDCONTROL.URC == 100)
                VHIE06IW-MSG.MSG = "No Consit Found For That Car Number";
            else
                VHIE06IW-MSG.MSG = "No Consit Found For That Car Number";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end
end 

Function VHIE06IS-CLEAR () 
    set VHIE06W-CARS empty;
    set VHIE06IW empty;
    set VHIE06IW-MSG empty;
end 

Function VHIE06IS-CON ()

  
  
  
   
    if (VHIE06IW.DATE-INSRV-REV == " ")
        VHIE06IW.DATE-INSRV-REV = " ";
    end
    if (VHIE06W-CARS.CON-NO != "   ")
        VHIE06A_CRIT.CON-NO = VHIE06W-CARS.CON-NO-NO;
        VHIE06A_CRIT.FLAG = "1";

  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHIE06A";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE06I";


  
        set VHIE06A_DATA empty;

    
        try
            call "VHIE06A"(XDCONTROL, VHIE06A_CRIT, VHIE06A_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
                set VHIE06W-CARS empty;
                CONCT = 1;
                while (CONCT <= XDCONTROL.UROWCNT)
                    if (CONCT == 1)
                        VHIE06W-CARS.CAR1 = VHIE06A_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 2)
                        VHIE06W-CARS.CAR2 = VHIE06A_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 3)
                        VHIE06W-CARS.CAR3 = VHIE06A_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 4)
                        VHIE06W-CARS.CAR4 = VHIE06A_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 5)
                        VHIE06W-CARS.CAR5 = VHIE06A_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 6)
                        VHIE06W-CARS.CAR6 = VHIE06A_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 7)
                        VHIE06W-CARS.CAR7 = VHIE06A_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 8)
                        VHIE06W-CARS.CAR8 = VHIE06A_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 9)
                        VHIE06W-CARS.CAR9 = VHIE06A_DATA.CAR-FORMAT[CONCT];
                    end
                    if (CONCT == 10)
                        VHIE06W-CARS.CAR10 = VHIE06A_DATA.CAR-FORMAT[CONCT];
                    end
                    CONCT = CONCT + 1;
                end

  
                VHIE06W-CARS.CON = VHIE06A_CRIT.CON-NO;
                VHIE06W-CARS.CON-DASH-NO = VHIE06A_DATA.DASH-NO-2[1];
                VHIE06W-CARS.CON-DASH-DASH = "-";
                if (VHIE06W-CARS.NO-1 == " ")
                    VHIE06W-CARS.NO-1 = "0";
                end
                
  


  
            else

  
        
        
  
                if (XDCONTROL.URC == 100)
                    VHIE06IW-MSG.MSG = "No Cars Found Fort That Train";
                else
                    VHIE06IW-MSG.MSG = "No Cars Found Fort That Train";
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end 
        end
    end
end 

Function VHIE07IS-BEGIN () 
    VHIE07IW.DAYS = 90;

  

  
    VHIE07IW.SYMP-CD = VHIE07I-PASSVALUE.SYMP-CD;
    set VHIE07IW-MSG empty;
end 

Function VHIE07IS-CLEAR () 
    VHIE07IW.ICT = 0;
    VHIE07IW.RCT = 1;
    set VHIE07IW-DATA empty;
    VHIE07IW.PUSH-DATA = "Y";
end 

Function VHIE07IS-LOOKUP () 
    set VHIE07IW-MSG empty;
    VHIE07IW.EVENT-CT = 0;
    VHIE07IW.INCIDENT-CT = 0;

  
    VHIE07C_CRIT.NUM-DAYS = VHIE07IW.DAYS;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIE07C";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE07I";


  
    set VHIE07C_DATA empty;

    
    try
        call "VHIE07C"(XDCONTROL, VHIE07C_CRIT, VHIE07C_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)


  

        else

  
        
        
  
            if (XDCONTROL.URC == 100)
                VHIE07IW-MSG.MSG = "Error Reading Date File - ";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end

  
  
  
    VHIE07A_CRIT.SYMP-CD = VHIE07I-PASSVALUE.SYMP-CD;
    VHIE07A_CRIT.END-DATE = VHIE07C_DATA.CURRENT-DATE;
    VHIE07A_CRIT.BEGIN-DATE = VHIE07C_DATA.BEGIN-DATE;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIE07A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE07I";


  
    set VHIE07A_DATA empty;

    
    try
        call "VHIE07A"(XDCONTROL, VHIE07A_CRIT, VHIE07A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHIE07IW.EVENT-CT = VHIE07A_CRIT.REC-COUNT;
            


  
        else

  
        
        
  
            if (XDCONTROL.URC == 100)
                VHIE07IW-MSG.MSG = "No Event Found for That Symptom Code";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end

  
  
  
    VHIE07B_CRIT.SYMP-CD = VHIE07I-PASSVALUE.SYMP-CD;
    VHIE07B_CRIT.END-DATE = VHIE07C_DATA.CURRENT-DATE;
    VHIE07B_CRIT.BEGIN-DATE = VHIE07C_DATA.BEGIN-DATE;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIE07B";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE07I";


  
    set VHIE07B_DATA empty;

    
    try
        call "VHIE07B"(XDCONTROL, VHIE07B_CRIT, VHIE07B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHIE07IW.INCIDENT-CT = VHIE07B_CRIT.REC-COUNTER;
            


  
        else

  
        
        
  
            if (XDCONTROL.URC == 100)
                VHIE07IW-MSG.MSG = "No INCIDENTS  Found for That Symptom Code";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end
end 

Function VHIE07IS-MERGE ()
   
    ICT = 1;
    RCT = 1;
    set VHIE07IW-DATA empty;
    XXDATEW.VAGen_FUNCTION = "MDY";
    while (ICT <= VHIE07IW.EVENT-CT)
        VHIE07IW-DATA.CAR-NO[RCT] = VHIE07A_DATA.CAR-NO[ICT];
        VHIE07IW-DATA.SYMP-CD[RCT] = VHIE07A_DATA.SYMP-CD[ICT];
        XXDATEW.DATE-YYYY-MM-DD = VHIE07A_DATA.DATE-INSRV[ICT];
        MRSCommonCode.XXDATES-CONVERT();
        VHIE07IW-DATA.DATE-INSRV[RCT] = XXDATEW.DATE-MM-DD-YYYY;

  
        VHIE07IW-DATA.TIME-INSRV[RCT] = VHIE07A_DATA.TIME-INSRV[ICT];
        VHIE07IW-DATA.INCD-NO[RCT] = VHIE07A_DATA.INCD-NO[ICT];
        VHIE07IW-DATA.CON-NO[RCT] = VHIE07A_DATA.CON-NO[ICT];
        VHIE07IW-DATA.DASH-NO[RCT] = VHIE07A_DATA.DASH-NO[ICT];
        VHIE07IW-DATA.NARR[RCT] = VHIE07A_DATA.NARR[ICT];
        VHIE07IW-DATA.FILE-TYPE[RCT] = "E";
        VHIE07IW-DATA.CON-DASH-CON[RCT] = VHIE07A_DATA.CON-NO[ICT];
        VHIE07IW-DATA.CON-DASH-DASH[RCT] = "-";
        VHIE07IW-DATA.CON-DASH-NO[RCT] = VHIE07IW-DATA.DASH-CHAR2[ICT];
        VHIE07IW-DATA.CAR1[RCT] = VHIE07A_DATA.CAR-NO1[ICT];
        VHIE07IW-DATA.CAR2[RCT] = VHIE07A_DATA.CAR-NO2[ICT];
        VHIE07IW-DATA.CAR3[RCT] = VHIE07A_DATA.CAR-NO3[ICT];
        VHIE07IW-DATA.CAR4[RCT] = VHIE07A_DATA.CAR-NO4[ICT];
        VHIE07IW-DATA.CAR5[RCT] = VHIE07A_DATA.CAR-NO5[ICT];
        VHIE07IW-DATA.CAR6[RCT] = VHIE07A_DATA.CAR-NO6[ICT];
        VHIE07IW-DATA.CAR7[RCT] = VHIE07A_DATA.CAR-NO7[ICT];
        VHIE07IW-DATA.CAR8[RCT] = VHIE07A_DATA.CAR-NO8[ICT];
        VHIE07IW-DATA.CAR9[RCT] = VHIE07A_DATA.CAR-NO9[ICT];
        VHIE07IW-DATA.CAR10[RCT] = VHIE07A_DATA.CAR-NO10[ICT];
        ICT = ICT + 1;
        RCT = RCT + 1;
    end 
    ICT = 1;
    while (ICT <= VHIE07IW.INCIDENT-CT)
        VHIE07IW-DATA.CAR-NO[RCT] = VHIE07B_DATA.CAR-NO[ICT];
        VHIE07IW-DATA.SYMP-CD[RCT] = VHIE07B_DATA.SYMP-CD[ICT];
  
        XXDATEW.DATE-YYYY-MM-DD = VHIE07B_DATA.DATE-INSRV[ICT];
        MRSCommonCode.XXDATES-CONVERT();
        VHIE07IW-DATA.DATE-INSRV[RCT] = XXDATEW.DATE-MM-DD-YYYY;
        VHIE07IW-DATA.TIME-INSRV[RCT] = VHIE07B_DATA.TIME-INSRV[ICT];
        VHIE07IW-DATA.INCD-NO[RCT] = VHIE07B_DATA.INCD-NO[ICT];
        VHIE07IW-DATA.CON-NO[RCT] = VHIE07B_DATA.CON-NO[ICT];
        VHIE07IW-DATA.DASH-NO[RCT] = VHIE07B_DATA.DASH-NO[ICT];
        VHIE07IW-DATA.NARR[RCT] = VHIE07B_DATA.NARR[ICT];
        VHIE07IW-DATA.FILE-TYPE[RCT] = "I";
        VHIE07IW-DATA.CON-DASH-CON[RCT] = VHIE07B_DATA.CON-NO[ICT];
        VHIE07IW-DATA.CON-DASH-DASH[RCT] = "-";
        VHIE07IW-DATA.CON-DASH-NO[RCT] = VHIE07IW-DATA.DASH-CHAR2[ICT];
        VHIE07IW-DATA.CAR1[RCT] = VHIE07B_DATA.CAR-NO1[ICT];
        VHIE07IW-DATA.CAR2[RCT] = VHIE07B_DATA.CAR-NO2[ICT];
        VHIE07IW-DATA.CAR3[RCT] = VHIE07B_DATA.CAR-NO3[ICT];
        VHIE07IW-DATA.CAR4[RCT] = VHIE07B_DATA.CAR-NO4[ICT];
        VHIE07IW-DATA.CAR5[RCT] = VHIE07B_DATA.CAR-NO5[ICT];
        VHIE07IW-DATA.CAR6[RCT] = VHIE07B_DATA.CAR-NO6[ICT];
        VHIE07IW-DATA.CAR7[RCT] = VHIE07B_DATA.CAR-NO7[ICT];
        VHIE07IW-DATA.CAR8[RCT] = VHIE07B_DATA.CAR-NO8[ICT];
        VHIE07IW-DATA.CAR9[RCT] = VHIE07B_DATA.CAR-NO9[ICT];
        VHIE07IW-DATA.CAR10[RCT] = VHIE07B_DATA.CAR-NO10[ICT];
        ICT = ICT + 1;
        RCT = RCT + 1;
    end
    VHIE07IW.TOTAL-CT = VHIE07IW.INCIDENT-CT + VHIE07IW.EVENT-CT;
    if (VHIE07IW.TOTAL-CT < RCT)
        RCT = RCT - 1;
    end
    if (RCT >= 1)
        VHIE07IW.PUSH-DATA = "Y";
    end
end
