    VHIE03IW-PRINT.GUI-TO = VHIE03IW.TO-DATE;
    VHIE03IW-PRINT.TERM-ID = VHIE03IW-PASSVALUE.TERM-LAST-UPD;
    VHIE03IW-PRINT.FROM-DATE = VHIE03IW.REV-DATE;
    VHIE03IW-PRINT.EVENT-ID = VHIE03IW-PASSVALUE.EVENT-ID;
end 

Function VHIE03IS-REFRESH ()
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIE03A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE03I";
    set VHIE04A_DATA empty;
    VHIE03IW.TIME-IN = "    ";
    set VHIE03A_DATA empty;

    
    try
        call "VHIE03A"(XDCONTROL, VHIE03A_CRIT, VHIE03A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHIE03IW.REC-COUNT = XDCONTROL.UROWCNT;
  
  
            if (VHIE03A_CRIT.EXCEED-FLAG == "Y")
                VHIE03IS-MESSAGE.MESSAGE = "Date Request Exceeded Max Number of Rows";
            end
        else

  
        
        
  
            if (XDCONTROL.URC == 100)
                VHIE03IS-MESSAGE.MESSAGE = "No Data Found for Date Request";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end
    VHIE03IS-MESSAGE.MESSAGE = "Data Added Successfully";

  
    ICT = 1;
    while (ICT <= VHIE03IW.REC-COUNT)
  
        VHIE03A_DATA.E-DATE[ICT] = VHIE03A_DATA.DATE-EVENT-OCCR[ICT];
        VHIE03A_DATA.E-DASH[ICT] = "-";
        VHIE03A_DATA.E-NUM[ICT] = VHIE03A_DATA.CNT-EVENTS[ICT];
        ICT = ICT + 1;
    end
    if (VHIE03IW.REC-COUNT > 0)
        VHIE03IW-TRIGGERS.LOAD-DATA = "Y";
    end
end 

