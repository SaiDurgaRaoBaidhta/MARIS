    VHCT012_CRIT-VEH-H.CURR-CAR-HRS-10 = VHCT01IW-SVR-REC.CAR-NO-10-CUR-HRS;
    VHCT012_CRIT-VEH-H.CURR-CAR-MIN-10 = VHCT01IW-SVR-REC.CAR-NO-10-CUR-MIN;
    VHCT012_CRIT-VEH-H.END-CAR-HRS-10 = VHCT01IW-SVR-REC.CAR-NO-10-END-HRS-SVC;
    VHCT012_CRIT-VEH-H.END-CAR-MIN-10 = VHCT01IW-SVR-REC.CAR-NO-10-END-MIN-SVC;
    VHCT012_CRIT-VEH-H.MID-CAR-HRS-10 = VHCT01IW-SVR-REC.CAR-NO-10-MID-HRS-SVC;
    VHCT012_CRIT-VEH-H.MID-CAR-MIN-10 = VHCT01IW-SVR-REC.CAR-NO-10-MID-MIN-SVC;
    VHCT012_CRIT-VEH-H.CUM-HRS-PREV-10 = VHCT01IW-SVR-REC.CAR-NO-10-PRV-HRS;
    VHCT012_CRIT-VEH-H.CUM-MIN-PREV-10 = VHCT01IW-SVR-REC.CAR-NO-10-PRV-MIN;
    VHCT01IS-MOVE-HIST();
  
    try
        call "VHCT012"(XDCONTROL, VHCT012_CRIT, VHCT012_CRIT-VEH, VHCT012_CRIT-VEH-H, VHCT012_CRIT-VEH-S);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  
  
        if (VHCT012_CRIT.ERROR-YARD-TRACK == "Y")
            VHCT01IW-CON-MSG.CON-MSG-3-X = "No room on ";
            VHCT01IW-CON-MSG.CON-MSG-3-XX = VHCT012_CRIT.CURR-LOC;
            VHCT01IW-CON-MSG.CON-MSG-3-XXX = " Pseudo Track for new location (can only hold";
            VHCT01IW-CON-MSG.CON-MSG-3-XXXX = VHCT012_CRIT.MAX-POSN;
            VHCT01IW-CON-MSG.CON-MSG-3-XXXXX = " cars).";
        else
            VHCT01IW-TRIGGER.COMPL-CLEAR = "Y";
            
  
            VHCT01IS-CALL-CICS();
        end
    else
  
  
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

