    VHCM015_CRIT.CON-CAR-NO-9 = VHCM01IW-PASSVALUE.CAR-NO-9;
    VHCM015_CRIT.CON-CAR-NO-10 = VHCM01IW-PASSVALUE.CAR-NO-10;
    VHCM015_CRIT.ORIENTATION-1 = VHCM01IW-PASSVALUE.ORIENTATION-1;
    VHCM015_CRIT.ORIENTATION-2 = VHCM01IW-PASSVALUE.ORIENTATION-2;
