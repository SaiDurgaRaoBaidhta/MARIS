Function VHTR01IS-MOVE-CAR1 () 
    if (VHTR01IW.LEFT-CON-NO == VHTR01IW.CON-NO)
        COUNTERX = 1;
        while ((VHTR01IW-PASSVALUE.COUNTERX <= VHTR01IW-PASSVALUE.LEFT-CON-SIZE))
            if (VHTR01IW-PASSVALUE.COUNTERX == 1)
                VHTR01IW-TEMP-CAR.TEMP-CAR-NO-X[COUNTERX] = VHTR01IW.CAR-NO-1;
            else
                if (VHTR01IW-PASSVALUE.COUNTERX == 2)
                    VHTR01IW-TEMP-CAR.TEMP-CAR-NO-X[COUNTERX] = VHTR01IW.CAR-NO-2;
                else
                    if (VHTR01IW-PASSVALUE.COUNTERX == 3)
                        VHTR01IW-TEMP-CAR.TEMP-CAR-NO-X[COUNTERX] = VHTR01IW.CAR-NO-3;
                    else
                        if (VHTR01IW-PASSVALUE.COUNTERX == 4)
                            VHTR01IW-TEMP-CAR.TEMP-CAR-NO-X[COUNTERX] = VHTR01IW.CAR-NO-4;
                             
                        else
                            if (VHTR01IW-PASSVALUE.COUNTERX == 5)
                                VHTR01IW-TEMP-CAR.TEMP-CAR-NO-X[COUNTERX] = VHTR01IW.CAR-NO-5;
                            else
                                if (VHTR01IW-PASSVALUE.COUNTERX == 6)
                                    VHTR01IW-TEMP-CAR.TEMP-CAR-NO-X[COUNTERX] = VHTR01IW.CAR-NO-6;
                                else
                                    if (VHTR01IW-PASSVALUE.COUNTERX == 7)
                                        VHTR01IW-TEMP-CAR.TEMP-CAR-NO-X[COUNTERX] = VHTR01IW.CAR-NO-7;
                                    else
                                        if (VHTR01IW-PASSVALUE.COUNTERX == 8)
                                            VHTR01IW-TEMP-CAR.TEMP-CAR-NO-X[COUNTERX] = VHTR01IW.CAR-NO-8;
                                        else
                                            if (VHTR01IW-PASSVALUE.COUNTERX == 9)
                                                VHTR01IW-TEMP-CAR.TEMP-CAR-NO-X[COUNTERX] = VHTR01IW.CAR-NO-9;
                                            else
                                                if (VHTR01IW-PASSVALUE.COUNTERX == 10)
                                                    VHTR01IW-TEMP-CAR.TEMP-CAR-NO-X[COUNTERX] = VHTR01IW.CAR-NO-10;
                                                else

                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            COUNTERX = COUNTERX + 1;
        end
