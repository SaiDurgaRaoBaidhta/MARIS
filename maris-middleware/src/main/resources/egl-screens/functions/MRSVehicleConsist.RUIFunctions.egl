Function VHCC01IS-CON-MSG () 
    if (VHCC01IW-TRIGGER.CON-STAT-ERR == "Y")
        VHCC01IW-CON-MSG.CON-MSG-1 = "CONSIST INVALID";
        VHCC01IW-TRIGGER.CON-STAT-ERR = " ";
        VHCC01IW-CON-MSG.CON-MESSAGE = VHCC01IW.CON-NO;
        VHCC01IW-CON-MSG.CON-MSG-1-X = VHCC01IW-CON-MSG.CON-MESSAGE;
        if (VHCC01IW-TRIGGER.CON-STAT-CON == "Y")
            VHCC01IW-TRIGGER.CON-STAT-CON = " ";
            VHCC01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST HAS TRAIN INCIDENT";
        else
            if (VHCC01IW-TRIGGER.CON-STAT-OUT == "Y")
                VHCC01IW-TRIGGER.CON-STAT-OUT = " ";
                VHCC01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST NOT IN SERVICE";
            else
                VHCC01IW-CON-MSG.CON-MSG-1-XX = "CONSIST STATUS ERROR";
            end
        end
    end
    if (VHCC01IW-TRIGGER.CON-OUT-RANGE == "Y")
        VHCC01IW-CON-MSG.CON-MSG-1 = "CONSIST NUMBER SHOULD BETWEEN 100 - 999";
        VHCC01IW-TRIGGER.CON-OUT-RANGE = " ";
        VHCC01IW-CON-MSG.CON-MESSAGE = VHCC01IW.CON-NO;
        VHCC01IW-CON-MSG.CON-MSG-1-X = VHCC01IW-CON-MSG.CON-MESSAGE;
        VHCC01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99";
    end
    if (VHCC01IW-TRIGGER.CON-NOT-EXIST == "Y")
        VHCC01IW-CON-MSG.CON-MSG-1 = "CONSIST NUMBER SHOULD BETWEEN 100 - 999";
        VHCC01IW-TRIGGER.CON-NOT-EXIST = " ";
        VHCC01IW-CON-MSG.CON-MESSAGE = VHCC01IW.CON-NO;
        VHCC01IW-CON-MSG.CON-MSG-1-X = VHCC01IW-CON-MSG.CON-MESSAGE;
        VHCC01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST NOT IN SERVICE";
    end
    if (VHCC01IW-TRIGGER.CON-NOT-SPACE == "Y")
        VHCC01IW-CON-MSG.CON-MSG-1 = "CONSIST NUMBER CANNOT BE BLANK";
        VHCC01IW-TRIGGER.CON-NOT-SPACE = " ";
    end
    if (VHCC01IW-TRIGGER.COMPLETE-CC == "Y")
        VHCC01IW-CON-MSG.CON-MSG-1 = "CHANGE CONSIST COMPLETED";
        VHCC01IW-TRIGGER.COMPLETE-CC = " ";
        
  
  
  
  
  
  
    end
    if (VHCC01IW-TRIGGER.RE-VALID-ERROR == "Y" &&
     VHCC01IW-TRIGGER.RE-VALID-SW-CON == "Y")
        VHCC01IW-TRIGGER.RE-VALID-ERROR = " ";
        VHCC01IW-TRIGGER.RE-VALID-SW-CON = " ";
        VHCC01IW-CON-MSG.CON-MSG-3-X = "Consist configuration have changed reque";
        VHCC01IW-CON-MSG.CON-MSG-3-XX = "sted changes not made,  Con Status = SWP, Please try again";
        VHCC01IW-CON-MSG.CON-MSG-1 = VHCC01IW-CON-MSG.CON-MSG-3;
        VHCC017_DATA.LOG-MSG = "CONSIST CHANGE CONFIGURATION PROBLEM, CON STATUS = SWP";
        VHCC01IS-LOG();
    end
    if (VHCC01IW-TRIGGER.RE-VALID-ERROR == "Y" &&
     VHCC01IW-TRIGGER.RE-VALID-SW-CAR == "Y")
        VHCC01IW-TRIGGER.RE-VALID-ERROR = " ";
        VHCC01IW-TRIGGER.RE-VALID-SW-CAR = " ";
        VHCC01IW-CON-MSG.CON-MSG-3-X = "Consist configuration have changed reque";
        VHCC01IW-CON-MSG.CON-MSG-3-XX = "sted changes not made,  Car size, car order has been changed, Please try again";
        VHCC01IW-CON-MSG.CON-MSG-1 = VHCC01IW-CON-MSG.CON-MSG-3;
        VHCC017_DATA.LOG-MSG = "CONSIST CHANGE CONFIGURATION PROBLEM, CAR SIZE, CAR ORDER NOT SAME";
        VHCC01IS-LOG();
    end
end 

Function VHCC01IS-CURR-LOC () 
    VHCC01IW-TRIGGER.WHERE-SW = "N";
  
  
  
  
  
  
    YARD-LOC-COUNT = 4;
    YARD-COUNTER = 1;
    while (YARD-COUNTER <= YARD-LOC-COUNT)
        if (VHCC011_DATA.ORGIN-LOC[1] ==
         VHCC01IW-YARD-CD.YARD-LOC[YARD-COUNTER])
            VHCC013_CRIT.WHERE-IS-CAR-OLD = "YRD";
            
  
        end
        YARD-COUNTER = YARD-COUNTER + 1;
    end
end 

Function VHCC01IS-DATE () 
    VHXREVC_CRIT.SEL-IDX = 3;
    try
        call "VHXREVC"(XDCONTROL, VHXREVC_CRIT, VHXREVC_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        TEMP-DATE = VHXREVC_DATA.REVENUE-DATE;
        VHCC01IW-PASSVALUE.DATE-INSRV = TEMP-DATE;
        VHCC01IW-PASSVALUE.DATE-FILLER-1 = "-";
        VHCC01IW-PASSVALUE.DATE-FILLER-2 = "-";
  
  
  
        VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
        VHCC01IW-PASSVALUE.DATE-INSRV-SYSTEM = VGVar.currentGregorianDate;
        move DATE-INSRV-SYS-YY to DATE-INSRV-SYS-YY-X withV60Compat;
        move DATE-INSRV-SYS-MM to DATE-INSRV-SYS-MM-X withV60Compat;
        move DATE-INSRV-SYS-DD to DATE-INSRV-SYS-DD-X withV60Compat;
        FIELD-1 = "-";
        FIELD-2 = "-";
    else

    end
end 

