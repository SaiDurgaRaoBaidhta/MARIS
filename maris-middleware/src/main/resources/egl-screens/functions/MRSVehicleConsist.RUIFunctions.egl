Function VHMT01IS-CAR-MSG () 
    if (VHMT01IW-TRIGGER.NOSPACE-CAR1 == "Y")
        VHMT01IW-CAR-MSG.CAR-MSG-1 = "FIRST CAR CANNOT BE BLANK";
        VHMT01IW-TRIGGER.NOSPACE-CAR1 = " ";
        VHMT01IW-WS-MSG.MSG-NO = VHMT01IW-WS-MSG.MSG-NO + 1;
        VHMT01IW-WS-MSG.MSG-LAST-BYTE = 18;
        VHMT01IW-WS-MSG.MESSAGES-X[1] = "F";
        VHMT01IW-WS-MSG.MESSAGES-X[2] = "i";
        VHMT01IW-WS-MSG.MESSAGES-X[3] = "r";
        VHMT01IW-WS-MSG.MESSAGES-X[4] = "s";
        VHMT01IW-WS-MSG.MESSAGES-X[5] = "t";
        VHMT01IW-WS-MSG.MESSAGES-X[6] = " ";
        VHMT01IW-WS-MSG.MESSAGES-X[7] = "C";
        VHMT01IW-WS-MSG.MESSAGES-X[8] = "a";
        VHMT01IW-WS-MSG.MESSAGES-X[9] = "r";
        VHMT01IW-WS-MSG.MESSAGES-X[10] = " ";
        VHMT01IW-WS-MSG.MESSAGES-X[11] = "R";
        VHMT01IW-WS-MSG.MESSAGES-X[12] = "e";
        VHMT01IW-WS-MSG.MESSAGES-X[13] = "q";
        VHMT01IW-WS-MSG.MESSAGES-X[14] = "u";
        VHMT01IW-WS-MSG.MESSAGES-X[15] = "i";
        VHMT01IW-WS-MSG.MESSAGES-X[16] = "r";
        VHMT01IW-WS-MSG.MESSAGES-X[17] = "e";
        VHMT01IW-WS-MSG.MESSAGES-X[18] = "d";
        VHMT01IS-MSG-RT();
    end
    
    if (VHMT01IW-TRIGGER.NO2CAR-ERROR == "Y")
        VHMT01IW-CAR-MSG.CAR-MSG-1 = "RANGE 2 - 10 CAR SHOULD BE ENTER";
        VHMT01IW-TRIGGER.NO2CAR-ERROR = " ";
        VHMT01IW-WS-MSG.MSG-NO = VHMT01IW-WS-MSG.MSG-NO + 1;
        VHMT01IW-WS-MSG.MSG-LAST-BYTE = 33;
        VHMT01IW-WS-MSG.MESSAGES-X[1] = "R";
        VHMT01IW-WS-MSG.MESSAGES-X[2] = "A";
        VHMT01IW-WS-MSG.MESSAGES-X[3] = "N";
        VHMT01IW-WS-MSG.MESSAGES-X[4] = "G";
        VHMT01IW-WS-MSG.MESSAGES-X[5] = "E";
        VHMT01IW-WS-MSG.MESSAGES-X[6] = " ";
        VHMT01IW-WS-MSG.MESSAGES-X[7] = "2";
        VHMT01IW-WS-MSG.MESSAGES-X[8] = " ";
