    else
        if (VHCM01IW-PASSVALUE.CAR-NO-10-WAR-IND == "Y")
            VHCM01IW-PASSVALUE.BRK-IN-HRS = VHCM01IW-PASSVALUE.CAR-NO-10-BRK-HRS;
            VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX = VHCM01IW-PASSVALUE.CAR-NO-10-MAX-BRK;
            VHCM01IS-BRK-HRS();
            VHCM01IW-PASSVALUE.CAR-NO-10-BRK-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS;
            
  
        end
    end
    VHCM01IW-PASSVALUE.CUM-HRS = VHCM01IW-PASSVALUE.CAR-NO-10-CUM-HRS;
    VHCM01IW-PASSVALUE.CUM-MIN = VHCM01IW-PASSVALUE.CAR-NO-10-CUM-MIN;
