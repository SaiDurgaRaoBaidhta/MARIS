Function VHLT01IS-CLEAR-MSG () 
    set VHLT01IW-TIME-MSG empty;
    set VHLT01IW-CON-MSG empty;
end 

Function VHLT01IS-CON-MSG () 
    if (VHLT01IW-TRIGGER.CON-NOT-INSRV == "Y")
        VHLT01IW-CON-MSG.CON-MSG-1 = "CONSIST NOT IN SERVICE";
        VHLT01IW-TRIGGER.CON-NOT-INSRV = " ";
        VHLT01IW-CON-MSG.CON-MESSAGE = VHLT01IW.CON-NO;
        VHLT01IW-CON-MSG.CON-MSG-1-X = VHLT01IW-CON-MSG.CON-MESSAGE;
        VHLT01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST NOT IN SERVICE";
    end
    if (VHLT01IW-TRIGGER.CON-STAT-ERROR == "Y")
        VHLT01IW-CON-MSG.CON-MSG-1 = "CONSIST STATUS ERROR";
        VHLT01IW-TRIGGER.CON-STAT-ERROR = " ";
        VHLT01IW-CON-MSG.CON-MESSAGE = VHLT01IW.CON-NO;
        VHLT01IW-CON-MSG.CON-MSG-1-X = VHLT01IW-CON-MSG.CON-MESSAGE;
        VHLT01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST STATUS ERROR";
    end
    if (VHLT01IW-TRIGGER.CON-NUMERIC-ERR == "Y")
        VHLT01IW-CON-MSG.CON-MSG-1 = "CONSIST NUMERIC ERROR";
        VHLT01IW-TRIGGER.CON-NUMERIC-ERR = " ";
        VHLT01IW-CON-MSG.CON-MESSAGE = VHLT01IW.CON-NO;
        VHLT01IW-CON-MSG.CON-MSG-1-X = VHLT01IW-CON-MSG.CON-MESSAGE;
        VHLT01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99";
    end
    if (VHLT01IW-TRIGGER.CON-NOT-EXIST == "Y")
        VHLT01IW-CON-MSG.CON-MSG-1 = "CONSIST NOT EXIST";
        VHLT01IW-TRIGGER.CON-NOT-EXIST = " ";
        VHLT01IW-CON-MSG.CON-MESSAGE = VHLT01IW.CON-NO;
        VHLT01IW-CON-MSG.CON-MSG-1-X = VHLT01IW-CON-MSG.CON-MESSAGE;
        VHLT01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99";
    end
    if (VHLT01IW-TRIGGER.COMPL-CLEAR == "Y")
        VHLT01IW-TRIGGER.COMPL-CLEAR = " ";
        VHLT01IW-CON-MSG.CON-MSG-2-X = "TRAIN ";
        VHLT01IW-CON-MSG.CON-MSG-2-XX = VHLT01IW.CON-NO;
        VHLT01IW-CON-MSG.CON-MSG-2-XXX = " SUCCESSFULLY LAYUP TO ";
        VHLT01IW-CON-MSG.CON-MSG-2-XXXX = VHLT01IW.YARD-LOC;
        VHLT01IW-CON-MSG.CON-MSG-2-XXXXX = ". RUN TIME ";
  
  
  
        VHLT01IW-CON-MSG.CON-MSG-FILLER = ":";
        VHLT01IW-CON-MSG.CON-MSG-1 = VHLT01IW-CON-MSG.CON-MSG-2;
    end
end 

Function VHLT01IS-CONV-TIME ()
  
  
   
    VHLT01IW-TRIGGER.TIME-ERROR-X = "N";
    if (WS15IW-TIME.TIME-IN != " ")
        if (WS15IW-TIME.POS6 != "." && WS15IW-TIME.POS6 != ":")
            WS15IW-TIME.HOURS1 = WS15IW-TIME.POS8;
            WS15IW-TIME.HOURS2 = WS15IW-TIME.POS7;
            WS15IW-TIME.COLON = ":";
            WS15IW-TIME.MINUTES1 = WS15IW-TIME.POS6;
            WS15IW-TIME.MINUTES2 = WS15IW-TIME.POS5;
            WS15IW-TIME.COLON2 = ":";
            WS15IW-TIME.SEC1 = WS15IW-TIME.POS2;
            WS15IW-TIME.SEC2 = WS15IW-TIME.POS1;
        end
  
        if (WS15IW-TIME.POS6 == ".")
            WS15IW-TIME.HOURS1 = WS15IW-TIME.POS8;
            WS15IW-TIME.HOURS2 = WS15IW-TIME.POS7;
            WS15IW-TIME.COLON = ":";
            WS15IW-TIME.MINUTES1 = WS15IW-TIME.POS5;
            WS15IW-TIME.MINUTES2 = WS15IW-TIME.POS4;
            WS15IW-TIME.COLON2 = ":";
            WS15IW-TIME.SEC1 = WS15IW-TIME.POS2;
            WS15IW-TIME.SEC2 = WS15IW-TIME.POS1;
        end

  
        if (WS15IW-TIME.SEC1 == " ")
            WS15IW-TIME.SEC1 = "0";
        end
        if (WS15IW-TIME.SEC2 == " ")
            WS15IW-TIME.SEC2 = "0";
        end

  
        if (WS15IW-TIME.HOURS1 == " ")
            WS15IW-TIME.HOURS1 = "0";
        end
        VHLT01IW.TIME-OUTSRV = WS15IW-TIME.TIME-OUT;
        VHLT01IS-VALID-TME();
    else
        VHLT01IW-TRIGGER.TIME-ERROR = "Y";
        VHLT01IW-TRIGGER.TIME-ERROR-X = "Y";
    end
end 

Function VHLT01IS-DATE () 
    VHXREVC_CRIT.SEL-IDX = 3;
    try
        call "VHXREVC"(XDCONTROL, VHXREVC_CRIT, VHXREVC_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        TEMP-DATE = VHXREVC_DATA.REVENUE-DATE;
        VHLT01IW-PASSVALUE.DATE-REV = TEMP-DATE;
        XXDATEW.DATE-MM-DD-YYYY = VHLT01IW-PASSVALUE.DATE-REV;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHLT01IW-PASSVALUE.DATE-REV = XXDATEW.DATE-YYYY-MM-DD;
  
  
  
  
  
        VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
        VHLT01IW-PASSVALUE.DATE-CURRENT = VGVar.currentGregorianDate;
        VHLT01IW-PASSVALUE.TIME-REV-START = VHXREVC_DATA.TIME-REV-START;
        
  
  
  
  
  
    else

    end
end 

Function VHLT01IS-INCD-STAT ()
   
    VHLT016_CRIT.CAR-NO = VHLT01IW-PASSVALUE.CAR-NO-INCD;
    try
        call "VHLT016"(XDCONTROL, VHLT016_CRIT, VHLT016_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
     XDCONTROL.UROWCNT > 0)
        VHLT01IS-UPD-INC();
    else
        VHLT01IW-TRIGGER.NO-INCD = "Y";
        
  
    end
end 

Function VHLT01IS-INIT () 
    VHLT010_CRIT.USER-GROUP = VH01A01_DATA.USER-GROUP;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHLT01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHLT010";
    try
        call "VHLT010"(XDCONTROL, VHLT010_CRIT, VHLT010_DATA);
    
    end
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHLT01IS-YRD-LOC();
            VHLT01IS-YRD-TRKG();
            VHLT01IS-DATE();
            VHLT01IS-TIME();
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHLT01IS-LOC () 
    VHLT011_CRIT.YRD-TRKG-YRD = VHLT01IW.YRD-TRKG-YRD;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHLT01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHLT011";
    try
        call "VHLT011"(XDCONTROL, VHLT011_CRIT, VHLT011_DATA);
    
    end
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHLT01IS-MOV-CARH () 
    VHLT01IS-CL-HIST();
    COUNT-H = 1;
    while ((VHLT01IW-SVR-REC.COUNT-H <= VHLT01IW-SVR-REC.HIST-COUNT))
        if (VHLT015_DATA.CAR-ORDER-SRV[COUNT-H] == 1)
            VHLT01IW-SVR-REC.HIST-CAR-NO-1 = VHLT015_DATA.CAR-NO-SRV[COUNT-H];
            VHLT01IW-SVR-REC.HIST-CAR-TYPE-1 = VHLT015_DATA.CAR-TYPE-SRV[COUNT-H];
            VHLT01IW-SVR-REC.CAR-NO-1-END-HRS-SVC = VHLT015_DATA.HIST-END-CAR-HRS-SRV[COUNT-H];
            VHLT01IW-SVR-REC.CAR-NO-1-END-MIN-SVC = VHLT015_DATA.HIST-END-CAR-MIN-SRV[COUNT-H];
            VHLT01IW-SVR-REC.CAR-NO-1-MID-HRS-SVC = VHLT015_DATA.HIST-MID-CAR-HRS-SRV[COUNT-H];
            VHLT01IW-SVR-REC.CAR-NO-1-MID-MIN-SVC = VHLT015_DATA.HIST-MID-CAR-MIN-SRV[COUNT-H];
            VHLT01IW-SVR-REC.CAR-NO-1-PRV-HRS = VHLT015_DATA.CUM-HRS-PREV-SRV[COUNT-H];
            VHLT01IW-SVR-REC.CAR-NO-1-PRV-MIN = VHLT015_DATA.CUM-MIN-PREV-SRV[COUNT-H];
            VHLT01IW-SVR-REC.CAR-NO-1-CUR-HRS = VHLT015_DATA.CURR-CAR-HRS-SRV[COUNT-H];
            VHLT01IW-SVR-REC.CAR-NO-1-CUR-MIN = VHLT015_DATA.CURR-CAR-MIN-SRV[COUNT-H];
            XXDATEW.DATE-MM-DD-YYYY = VHLT015_DATA.DATE-REV-SRV[COUNT-H];
            XXDATEW.VAGen_FUNCTION = "YMD";
            MRSCommonCode.XXDATES-CONVERT();
            VHLT015_DATA.DATE-REV-SRV[COUNT-H] = XXDATEW.DATE-YYYY-MM-DD;
            VHLT01IW-SVR-REC.CAR-NO-1-DATE-REV = VHLT015_DATA.DATE-REV-SRV[COUNT-H];
        else
            if (VHLT015_DATA.CAR-ORDER-SRV[COUNT-H] == 2)
                VHLT01IW-SVR-REC.HIST-CAR-NO-2 = VHLT015_DATA.CAR-NO-SRV[COUNT-H];
                VHLT01IW-SVR-REC.HIST-CAR-TYPE-2 = VHLT015_DATA.CAR-TYPE-SRV[COUNT-H];
                VHLT01IW-SVR-REC.CAR-NO-2-END-HRS-SVC = VHLT015_DATA.HIST-END-CAR-HRS-SRV[COUNT-H];
                VHLT01IW-SVR-REC.CAR-NO-2-END-MIN-SVC = VHLT015_DATA.HIST-END-CAR-MIN-SRV[COUNT-H];
                VHLT01IW-SVR-REC.CAR-NO-2-MID-HRS-SVC = VHLT015_DATA.HIST-MID-CAR-HRS-SRV[COUNT-H];
                VHLT01IW-SVR-REC.CAR-NO-2-MID-MIN-SVC = VHLT015_DATA.HIST-MID-CAR-MIN-SRV[COUNT-H];
                VHLT01IW-SVR-REC.CAR-NO-2-PRV-HRS = VHLT015_DATA.CUM-HRS-PREV-SRV[COUNT-H];
                VHLT01IW-SVR-REC.CAR-NO-2-PRV-MIN = VHLT015_DATA.CUM-MIN-PREV-SRV[COUNT-H];
                VHLT01IW-SVR-REC.CAR-NO-2-CUR-HRS = VHLT015_DATA.CURR-CAR-HRS-SRV[COUNT-H];
                VHLT01IW-SVR-REC.CAR-NO-2-CUR-MIN = VHLT015_DATA.CURR-CAR-MIN-SRV[COUNT-H];
                XXDATEW.DATE-MM-DD-YYYY = VHLT015_DATA.DATE-REV-SRV[COUNT-H];
                XXDATEW.VAGen_FUNCTION = "YMD";
                MRSCommonCode.XXDATES-CONVERT();
                VHLT015_DATA.DATE-REV-SRV[COUNT-H] = XXDATEW.DATE-YYYY-MM-DD;
                VHLT01IW-SVR-REC.CAR-NO-2-DATE-REV = VHLT015_DATA.DATE-REV-SRV[COUNT-H];
            else
                if (VHLT015_DATA.CAR-ORDER-SRV[COUNT-H] == 3)
                    VHLT01IW-SVR-REC.HIST-CAR-NO-3 = VHLT015_DATA.CAR-NO-SRV[COUNT-H];
                    VHLT01IW-SVR-REC.HIST-CAR-TYPE-3 = VHLT015_DATA.CAR-TYPE-SRV[COUNT-H];
                    VHLT01IW-SVR-REC.CAR-NO-3-END-HRS-SVC = VHLT015_DATA.HIST-END-CAR-HRS-SRV[COUNT-H];
                    VHLT01IW-SVR-REC.CAR-NO-3-END-MIN-SVC = VHLT015_DATA.HIST-END-CAR-MIN-SRV[COUNT-H];
                    VHLT01IW-SVR-REC.CAR-NO-3-MID-HRS-SVC = VHLT015_DATA.HIST-MID-CAR-HRS-SRV[COUNT-H];
                    VHLT01IW-SVR-REC.CAR-NO-3-MID-MIN-SVC = VHLT015_DATA.HIST-MID-CAR-MIN-SRV[COUNT-H];
                    VHLT01IW-SVR-REC.CAR-NO-3-PRV-HRS = VHLT015_DATA.CUM-HRS-PREV-SRV[COUNT-H];
                    VHLT01IW-SVR-REC.CAR-NO-3-PRV-MIN = VHLT015_DATA.CUM-MIN-PREV-SRV[COUNT-H];
                    VHLT01IW-SVR-REC.CAR-NO-3-CUR-HRS = VHLT015_DATA.CURR-CAR-HRS-SRV[COUNT-H];
                    VHLT01IW-SVR-REC.CAR-NO-3-CUR-MIN = VHLT015_DATA.CURR-CAR-MIN-SRV[COUNT-H];
                    XXDATEW.DATE-MM-DD-YYYY = VHLT015_DATA.DATE-REV-SRV[COUNT-H];
                    XXDATEW.VAGen_FUNCTION = "YMD";
                    MRSCommonCode.XXDATES-CONVERT();
                    VHLT015_DATA.DATE-REV-SRV[COUNT-H] = XXDATEW.DATE-YYYY-MM-DD;
                    VHLT01IW-SVR-REC.CAR-NO-3-DATE-REV = VHLT015_DATA.DATE-REV-SRV[COUNT-H];
                else
                    if (VHLT015_DATA.CAR-ORDER-SRV[COUNT-H] == 4)
                        VHLT01IW-SVR-REC.HIST-CAR-NO-4 = VHLT015_DATA.CAR-NO-SRV[COUNT-H];
