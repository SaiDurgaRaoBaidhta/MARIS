Function VHCM01IS-LIST () 
    VHCM01IW-TRIGGER.CON-ERROR = " ";
    VHCM01IW-TRIGGER.TRAIN-ERROR = " ";
  
    VHCM01IW-TRIGGER.DISABLE-COMBINE = "Y";
  
    VHCM01IW-PASSVALUE.LEFT-RIGHT = " ";
    VHCM01IW-PASSVALUE.LEFT-COUNT = 0;
    VHCM01IW-PASSVALUE.RIGHT-COUNT = 0;
    VHCM01IW-PASS-LEFT.CAR-COUNT = 0;
    VHCM01IW-PASS-RIGH.CAR-COUNT = 0;
    VHCM01IW-PASSVALUE.CAR-LR-X[1] = " ";
    VHCM01IW-PASSVALUE.CAR-LR-X[2] = " ";
    VHCM01IW-PASSVALUE.CAR-LR-X[3] = " ";
    VHCM01IW-PASSVALUE.CAR-LR-X[4] = " ";
    VHCM01IW-PASSVALUE.CAR-LR-X[5] = " ";
    VHCM01IW-PASSVALUE.CAR-LR-X[6] = " ";
    VHCM01IW-PASSVALUE.CAR-LR-X[7] = " ";
    VHCM01IW-PASSVALUE.CAR-LR-X[8] = " ";
    VHCM01IW-PASSVALUE.CAR-LR-X[9] = " ";
    VHCM01IW-PASSVALUE.CAR-LR-X[10] = " ";
    set VHCM01IW-PASS-LEFT empty;
    set VHCM01IW-CON empty;
    set VHCM01IW-STATUS empty;
    set VHCM01IW-PASS-RIGH empty;
    set VHCM01IW-1 empty;
    set VHCM01IW-CAR empty;
    set VHCM01IW-STATUS empty;
    set VHCM01IW-CON-MSG empty;
    set VHCM01IW-SVR-REC empty;
    set VHCM01IW-SVR-REC-L empty;
    set VHCM01IW-SVR-REC-R empty;
    VHCM01IS-CT();
    if (VHCM01IW-TRIGGER.CON-ERROR != "Y" &&
     VHCM01IW-TRIGGER.CON-INCD != "Y")
        VHCM01IS-CT-1();
        if (VHCM01IW-TRIGGER.TRAIN-ERROR != "Y" &&
         VHCM01IW-TRIGGER.TRAIN-INCD != "Y")
            VHCM01IS-BE-AF();
        end
    end
end 

Function VHCM01IS-MOV-CAR1H ()
   
    VHCM01IW-SVR-REC-R.COUNTER-H = 1;
    while ((VHCM01IW-SVR-REC-R.COUNTER-H <= VHCM01IW-SVR-REC-R.HIST-COUNT))
        if (VHCM013_DATA.CAR-ORDER-SRV[VHCM01IW-SVR-REC-R.COUNTER-H] == 1)
            VHCM01IW-SVR-REC-R.HIST-CAR-NO-1 = VHCM013_DATA.CAR-NO-SRV[VHCM01IW-SVR-REC-R.COUNTER-H];
            VHCM01IW-SVR-REC-R.HIST-CAR-TYPE-1 = VHCM013_DATA.CAR-TYPE-SRV[VHCM01IW-SVR-REC-R.COUNTER-H];
            VHCM01IW-SVR-REC-R.CAR-NO-1-END-HRS-SVC = VHCM013_DATA.HIST-END-CAR-HRS-SRV[VHCM01IW-SVR-REC-R.COUNTER-H];
