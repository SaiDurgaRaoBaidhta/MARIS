    VHCT018_DATA.CAR-NO = VHCT01IW-PASSVALUE.CAR-NO;
    VHCT018_CRIT.TYPE-IND = VHCT019_DATA.INCD-TYPE;
    VHCT018_DATA.DATE-INCD-OCCR-REV = VHCT01IW-PASSVALUE.DATE-REV;
    VHCT018_DATA.CURR-LOC = VHCT01IW.YARD-LOC;
    try
        call "VHCT018"(XDCONTROL, VHCT018_CRIT, VHCT018_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))

    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

