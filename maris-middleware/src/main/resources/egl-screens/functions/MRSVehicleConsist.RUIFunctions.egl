Function VHCM01IS-COMBINE ()
   
    VHCM01IS-CK-CONG();
  
    VHCM01IS-CK-OSRV();
    if (VHCM01IW.LEFT-CONG == "Y" &&
     VHCM01IW.RIGH-CONG == "Y" &&
     VHCM01IW-TRIGGER.TIME-OUT-ERR-LEFT != "Y" &&
     VHCM01IW-TRIGGER.TIME-OUT-ERR-RIGH != "Y")
        VHCM01IS-VALID-CAR();
        VHCM01IS-VALID-YRD();
        VHCM01IS-CONV-TIME();
        if (VHCM01IW-TRIGGER.TIME-ERROR-X != "Y" &&
         VHCM01IW-TRIGGER.YARD-ERROR != "Y" &&
         VHCM01IW-TRIGGER.TRAIN-STAT-ERROR != "Y" &&
         VHCM01IW-TRIGGER.CAR-TYPE-ERROR != "Y" &&
         VHCM01IW-TRIGGER.CAR-ERROR != "Y")
  
            VHCM01IS-OTIME();
  
        end
    else
        VHCM01IS-CONG-MSG();
    end
end 

Function VHCM01IS-CON-INCD () 
    if (VHCM01IW-TRIGGER.CON-NOT-INSRV == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST HAS INCIDENT";
        VHCM01IW-TRIGGER.CON-NOT-INSRV = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.COMBINE-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST HAS INCIDENT";
    end
end 

Function VHCM01IS-CON-MSG () 
    if (VHCM01IW-TRIGGER.CON-NOT-INSRV == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST NOT IN SERVICE";
        VHCM01IW-TRIGGER.CON-NOT-INSRV = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.COMBINE-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST NOT IN SERVICE";
    end
    if (VHCM01IW-TRIGGER.CON-STAT-ERROR == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST STATUS ERROR";
        VHCM01IW-TRIGGER.CON-STAT-ERROR = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.COMBINE-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST STATUS ERROR";
    end
    if (VHCM01IW-TRIGGER.CON-NUMERIC-ERR == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST NUMERIC ERROR";
        VHCM01IW-TRIGGER.CON-NUMERIC-ERR = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.COMBINE-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99";
    end
    if (VHCM01IW-TRIGGER.CON-NOT-EXIST == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST NOT EXIST";
        VHCM01IW-TRIGGER.CON-NOT-EXIST = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.COMBINE-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99";
    end
    if (VHCM01IW-TRIGGER.CON-TRBL == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST HAS TRAIN INCIDENT";
        VHCM01IW-TRIGGER.CON-TRBL = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.COMBINE-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST HAS TRAIN INCIDENT";
    end
    if (VHCM01IW-TRIGGER.COMPL-CLEAR == "Y")
        VHCM01IW-TRIGGER.COMPL-CLEAR = " ";
        VHCM01IW-CON-MSG.CON-MSG-2-X = "TRAIN ";
        VHCM01IW-CON-MSG.CON-MSG-2-XX = VHCM01IW.COMBINE-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-2-XXX = " SUCCESSFULLY CLEARED TO ";
        VHCM01IW-CON-MSG.CON-MSG-2-XXXX = VHCM01IW.YARD-LOC;
        VHCM01IW-CON-MSG.CON-MSG-2-XXXXX = ". RUN TIME ";
  
  
  
        VHCM01IW-CON-MSG.CON-MSG-FILLER = ":";
        VHCM01IW-CON-MSG.CON-MSG-1 = VHCM01IW-CON-MSG.CON-MSG-2;
    end
end 

Function VHCM01IS-CONG-MSG () 
    if (VHCM01IW.LEFT-CONG != "Y")
        VHCM01IW-CON-MSG.CON-MSG-5-1 = VHCM01IW.COMBINE-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-5-2 = " - CONFIGURATION HAS CHANGED, CANNOT COMBINE";
    else
        VHCM01IW-CON-MSG.CON-MSG-5-1 = " ";
        VHCM01IW-CON-MSG.CON-MSG-5-2 = " ";
    end
    if (VHCM01IW.RIGH-CONG != "Y")
        VHCM01IW-CON-MSG.CON-MSG-5-3 = VHCM01IW.TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-5-4 = " - CONFIGURATION HAS CHANGED, CANNOT COMBINE";
    else
        VHCM01IW-CON-MSG.CON-MSG-5-3 = " ";
        VHCM01IW-CON-MSG.CON-MSG-5-4 = " ";
    end
    VHCM01IW-CON-MSG.CON-MSG-1 = VHCM01IW-CON-MSG.CON-MSG-5;
end 

Function VHCM01IS-CONV-TIME ()
  
  
   
    VHCM01IW-TRIGGER.TIME-ERROR-X = "N";
    if (WS15IW-TIME.TIME-IN != " ")
        if (WS15IW-TIME.POS6 != "." && WS15IW-TIME.POS6 != ":")
            WS15IW-TIME.HOURS1 = WS15IW-TIME.POS8;
            WS15IW-TIME.HOURS2 = WS15IW-TIME.POS7;
            WS15IW-TIME.COLON = ":";
            WS15IW-TIME.MINUTES1 = WS15IW-TIME.POS6;
            WS15IW-TIME.MINUTES2 = WS15IW-TIME.POS5;
            WS15IW-TIME.COLON2 = ":";
            WS15IW-TIME.SEC1 = WS15IW-TIME.POS2;
            WS15IW-TIME.SEC2 = WS15IW-TIME.POS1;
        end
        if (WS15IW-TIME.POS6 == "." || WS15IW-TIME.POS6 == ":")
  
            WS15IW-TIME.HOURS1 = WS15IW-TIME.POS8;
            WS15IW-TIME.HOURS2 = WS15IW-TIME.POS7;
            WS15IW-TIME.COLON = ":";
            WS15IW-TIME.MINUTES1 = WS15IW-TIME.POS5;
            WS15IW-TIME.MINUTES2 = WS15IW-TIME.POS4;
            WS15IW-TIME.COLON2 = ":";
            WS15IW-TIME.SEC1 = WS15IW-TIME.POS2;
            WS15IW-TIME.SEC2 = WS15IW-TIME.POS1;
        end

  
        if (WS15IW-TIME.SEC1 == " ")
            WS15IW-TIME.SEC1 = "0";
        end
        if (WS15IW-TIME.SEC2 == " ")
            WS15IW-TIME.SEC2 = "0";
        end

  
        if (WS15IW-TIME.HOURS1 == " ")
            WS15IW-TIME.HOURS1 = "0";
        end
        VHCM01IW.TIME-OUTSRV = WS15IW-TIME.TIME-OUT;
        VHCM01IS-VALID-TME();
    else
        VHCM01IW-TRIGGER.TIME-ERROR = "Y";
        VHCM01IW-TRIGGER.TIME-ERROR-X = "Y";
        VHCM01IW-TIME-MSG.MSG-1 = "TIME CANNOT BE BLANK";
    end
end 

Function VHCM01IS-CT () 
    VHCM01IW-TRIGGER.CON-NOT-INSRV = " ";
    VHCM01IW-TRIGGER.CON-ERROR = " ";
    VHCM01IW-TRIGGER.COMBINE-TRAIN-ERROR = " ";
    VHCM01IW-TRIGGER.CON-TRBL = "  ";
    VHCM01IW-TRIGGER.CON-STAT-ERROR = "  ";
    VHCM01IW-TRIGGER.CON-NOT-EXIST = "  ";
    VHCM01IW-TRIGGER.CON-NUMERIC-ERR = "  ";
    VHCM01IW-TRIGGER.PSEUDO-CON-OUT = "N";
    VHCM01IW-TRIGGER.PSEUDO-NOT-FOUND = "N";
    if (VHCM01IW.COMBINE-TRAIN != " ")
  
        if (VHCM01IW.COMBINE-TRAIN is numeric)
            if (VHCM01IW.COMBINE-TRAIN-X > 99 &&
             VHCM01IW.COMBINE-TRAIN-X < 1000)
  
                VHCM011_CRIT.CON-NO = VHCM01IW.COMBINE-TRAIN;
  
  
  
                VHCM011_CRIT.DATE-INSRV-REV = VHCM01IW-PASSVALUE.DATE-REV;
                try
                    call "VHCM011"(XDCONTROL, VHCM011_CRIT, VHCM011_DATA);
                
                end
                if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
                 (VHCM011_CRIT.NO-RECORD-FOUND == "N"))
                    VHCM01IW-PASSVALUE.DATE-INSRV-REV = VHCM011_DATA.DATE-INSRV-REV;
                    VHCM01IW-PASS-LEFT.DATE-INSRV-REV = VHCM011_DATA.DATE-INSRV-REV;
                    VHCM01IW-PASSVALUE.TIME-INSRV-X = VHCM011_DATA.TIME-INSRV;
                    VHCM01IW-PASS-LEFT.TIME-INSRV-X = VHCM011_DATA.TIME-INSRV;
                    VHCM01IW-PASS-LEFT.TIME-INSRV = VHCM011_DATA.TIME-INSRV;
                    VHCM01IW-PASS-LEFT.CON-SIZE = VHCM011_DATA.CON-SIZE;
                    VHCM01IW.CON-NO = VHCM01IW.COMBINE-TRAIN;
  
                    if (VHCM011_DATA.CON-STAT == "OUT" ||
                     VHCM011_DATA.CON-STAT == "SWP")
                        VHCM01IW.COMBINE-TRAIN-SAVE = VHCM01IW.COMBINE-TRAIN;
                        VHCM01IW-TRIGGER.CON-NOT-INSRV = "Y";
                        VHCM01IW-TRIGGER.CON-ERROR = "Y";
                        VHCM01IW-TRIGGER.COMBINE-TRAIN-ERROR = "Y";
                    else
                        if (VHCM011_DATA.CON-STAT == "CON")
                            VHCM01IW.COMBINE-TRAIN-SAVE = VHCM01IW.COMBINE-TRAIN;
                            VHCM01IW-TRIGGER.CON-TRBL = "Y";
                            VHCM01IW-TRIGGER.CON-ERROR = "Y";
                        else
                            if (VHCM011_DATA.CON-STAT == "SRV" ||
                             VHCM011_DATA.CON-STAT == "CAR")
                                VHCM01IS-OSRV-TIME();
                                if (VHCM01IW-TRIGGER.TIME-OUT-ERR == "Y")
                                    VHCM01IW-TIME-MSG.MSG-4-1 = VHCM01IW.COMBINE-TRAIN;
                                    VHCM01IW-TIME-MSG.MSG-4-2 = " - TIME SHOULD BE >= IN SERVICE TIME";
                                    VHCM01IW-TIME-MSG.MSG-1 = VHCM01IW-TIME-MSG.MSG-4;
                                else
                                    VHCM015_CRIT-VEH-L.DASH-NO = VHCM011_DATA.MAX-DASH-NO + 1;
                                    VHCM015_CRIT-CONHL.DASH-NO = VHCM011_DATA.DASH-NO;
                                    VHCM015_CRIT-VEH-L.DATE-INSRV-REV = VHCM011_DATA.DATE-INSRV-REV;
                                    VHCM015_CRIT-VEH-L.DATE-INSRV = VHCM011_DATA.DATE-INSRV;
                                    VHCM015_CRIT-VEH-L.TIME-INSRV = VHCM011_DATA.TIME-INSRV;
                                    VHCM015_CRIT-VEH-L.CON-SIZE = VHCM011_DATA.CON-SIZE;
                                    VHCM015_CRIT-VEH-L.CON-STAT = VHCM011_DATA.CON-STAT;
                                end
                                if (VHCM01IW.NEW-TRAIN == " ")
                                    VHCM01IW.NEW-TRAIN = VHCM01IW.COMBINE-TRAIN;
                                end
                                VHCM01IW.COMBINE-TRAIN-SAVE = " ";
                                VHCM01IS-CKCO-IND();
  
  
                            else
                                VHCM01IW.COMBINE-TRAIN-SAVE = VHCM01IW.COMBINE-TRAIN;
                                VHCM01IW-TRIGGER.CON-STAT-ERROR = "Y";
                                VHCM01IW-TRIGGER.CON-ERROR = "Y";
                                VHCM01IW-TRIGGER.COMBINE-TRAIN-ERROR = "Y";
                            end
                        end
                    end
                else
                    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
                     (VHCM011_CRIT.NO-RECORD-FOUND == "Y"))
  
                        VHCM01IW.COMBINE-TRAIN-SAVE = VHCM01IW.COMBINE-TRAIN;
                        VHCM01IW-TRIGGER.CON-ERROR = "Y";
                        VHCM01IW-TRIGGER.CON-NOT-EXIST = "Y";
                        VHCM01IW-TRIGGER.COMBINE-TRAIN-ERROR = "Y";
                    end
                end
            else
                VHCM01IW.COMBINE-TRAIN-SAVE = VHCM01IW.COMBINE-TRAIN;
                VHCM01IW-TRIGGER.CON-NUMERIC-ERR = "Y";
                VHCM01IW-TRIGGER.CON-ERROR = "Y";
                VHCM01IW-TRIGGER.COMBINE-TRAIN-ERROR = "Y";
            end
        else
            VHCM01IW.COMBINE-TRAIN-SAVE = VHCM01IW.COMBINE-TRAIN;
            VHCM01IW-TRIGGER.CON-NUMERIC-ERR = "Y";
            VHCM01IW-TRIGGER.CON-ERROR = "Y";
            VHCM01IW-TRIGGER.COMBINE-TRAIN-ERROR = "Y";
        end
    end
    
  
    VHCM01IS-CON-MSG();
end 

Function VHCM01IS-CT-1 () 
    VHCM01IW-TRIGGER.TRAIN-NOT-INSRV = " ";
    VHCM01IW-TRIGGER.TRAIN-ERROR = " ";
    VHCM01IW-TRIGGER.TRAIN-ERROR = " ";
    VHCM01IW-TRIGGER.TRAIN-TRBL = "  ";
    VHCM01IW-TRIGGER.TRAIN-STAT-ERROR = "  ";
    VHCM01IW-TRIGGER.TRAIN-NOT-EXIST = "  ";
    VHCM01IW-TRIGGER.TRAIN-NUMERIC-ERR = "  ";
    if (VHCM01IW.TRAIN != " ")
  
        if (VHCM01IW.TRAIN is numeric)
            if (VHCM01IW.TRAIN != " ")
                if ((VHCM01IW.TRAIN-X > 99 &&
                 VHCM01IW.TRAIN-X < 1000) &&
                 VHCM01IW.TRAIN != VHCM01IW.COMBINE-TRAIN)
                    VHCM01IS-CT-X();
                else
  
                    VHCM01IW-TRIGGER.TRAIN-NUMERIC-ERR = "Y";
  
                    VHCM01IW-TRIGGER.TRAIN-ERROR = "Y";
                end
            else
  
                VHCM01IW-TRIGGER.TRAIN-NUMERIC-ERR = "Y";
  
                VHCM01IW-TRIGGER.TRAIN-ERROR = "Y";
            end
        end
    end
    VHCM01IS-TRAIN-MSG();
end 

Function VHCM01IS-CT-2 () 
    set VHCM01IW-STATUS empty;
    VHCM01IW-TRIGGER.CAR-ERROR = " ";
    if (VHCM01IW-TRIGGER.TRAIN-STAT-ERROR == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST STATUS ERROR";
  
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST STATUS ERROR";
        VHCM01IW-TRIGGER.TRAIN = "Y";
    else
        VHCM01IW-TRIGGER.NEW-TRAIN-NOT-INSRV = " ";
        VHCM01IW-TRIGGER.NEW-TRAIN-ERROR = " ";
        VHCM01IW-TRIGGER.NEW-TRAIN-ERROR = " ";
        VHCM01IW-TRIGGER.CAR-ERROR = " ";
        
  
        VHCM01IW-TRIGGER.NEW-TRAIN-STAT-ERROR = "  ";
        VHCM01IW-TRIGGER.NEW-TRAIN-EXIST = "  ";
        VHCM01IW-TRIGGER.NEW-TRAIN-NUMERIC-ERR = "  ";
        VHCM01IW-TRIGGER.NEW-TRAIN-BLANK-ERR = " ";
        if (VHCM01IW.NEW-TRAIN == VHCM01IW.COMBINE-TRAIN)
            VHCM015_CRIT.DASH-NO = VHCM015_CRIT-VEH-L.DASH-NO;
            VHCM01IS-COMBINE();
            return;
        end
        if (VHCM01IW.NEW-TRAIN == VHCM01IW.TRAIN &&
         VHCM01IW-PASS-MT.PSEUDO-SW != "Y")
            VHCM015_CRIT.DASH-NO = VHCM015_CRIT-VEH-R.DASH-NO;
            VHCM01IS-COMBINE();
            return;
        end
        if (VHCM01IW.NEW-TRAIN != " ")
  
            if (VHCM01IW.NEW-TRAIN is numeric)
                if ((VHCM01IW.NEW-TRAIN-X > 99 &&
                 VHCM01IW.NEW-TRAIN-X < 1000))
  
  
  
                    VHCM011_CRIT.CON-NO = VHCM01IW.NEW-TRAIN;
  
  
  
                    VHCM011_CRIT.DATE-INSRV-REV = VHCM01IW-PASSVALUE.DATE-REV;
                    try
                        call "VHCM011"(XDCONTROL, VHCM011_CRIT, VHCM011_DATA);
                    
                    end
                    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
                     (VHCM011_CRIT.NO-RECORD-FOUND == "N"))
                        VHCM015_CRIT.DATE-INSRV-REV = VHCM011_DATA.DATE-INSRV-REV;
                        VHCM015_CRIT.TIME-INSRV-X = VHCM011_DATA.TIME-INSRV;
                        VHCM015_CRIT.CON-NO = VHCM01IW.NEW-TRAIN;
  
                        if (VHCM011_DATA.CON-STAT == "OUT" ||
                         VHCM011_DATA.CON-STAT == "SWP")
                            VHCM015_CRIT.DASH-NO = VHCM011_DATA.MAX-DASH-NO + 1;
                            VHCM01IS-COMBINE();
                        else
                            if (VHCM011_DATA.CON-STAT == "CAR" ||
                             VHCM011_DATA.CON-STAT == "CON")
  
  
                                VHCM01IW-TRIGGER.NEW-TRAIN-TRBL = "Y";
                                VHCM01IW-TRIGGER.NEW-TRAIN-ERROR = "Y";
                            else
                                if (VHCM011_DATA.CON-STAT == "SRV")
  
                                    VHCM01IW-TRIGGER.NEW-TRAIN-ERROR = "Y";
                                    VHCM01IW-TRIGGER.NEW-TRAIN-EXIST = "Y";
                                    

  
  
                                else
  
                                    VHCM01IW-TRIGGER.NEW-TRAIN-STAT-ERROR = "Y";
  
                                    VHCM01IW-TRIGGER.NEW-TRAIN-ERROR = "Y";
                                end
                            end
  
                        end
                    else
                        if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
                         (VHCM011_CRIT.NO-RECORD-FOUND == "Y"))
  
  
  
                            VHCM01IW-TRIGGER.NEW-TRAIN-NOT-EXIST = "Y";
                            VHCM01IW-TRIGGER.NEW-TRAIN-ERROR = "Y";
                        end
                    end
                else
  
                    VHCM01IW-TRIGGER.NEW-TRAIN-NUMERIC-ERR = "Y";
  
                    VHCM01IW-TRIGGER.NEW-TRAIN-ERROR = "Y";
                end
            else
  
                VHCM01IW-TRIGGER.NEW-TRAIN-NUMERIC-ERR = "Y";
  
                VHCM01IW-TRIGGER.NEW-TRAIN-ERROR = "Y";
            end
        else
  
            VHCM01IW-TRIGGER.NEW-TRAIN-BLANK-ERR = "Y";
  
            VHCM01IW-TRIGGER.NEW-TRAIN-ERROR = "Y";
        end
        VHCM01IS-NTRAN-MSG();
    end
end 

Function VHCM01IS-CT-X () 
    VHCM011_CRIT.CON-NO = VHCM01IW.TRAIN;
    VHCM011_CRIT.DATE-INSRV-REV = VHCM01IW-PASSVALUE.DATE-REV;
    try
        call "VHCM011"(XDCONTROL, VHCM011_CRIT, VHCM011_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
     (VHCM011_CRIT.NO-RECORD-FOUND == "N"))
        VHCM01IW-PASSVALUE.DATE-INSRV-REV = VHCM011_DATA.DATE-INSRV-REV;
        VHCM01IW-PASS-RIGH.DATE-INSRV-REV = VHCM011_DATA.DATE-INSRV-REV;
        VHCM01IW-PASSVALUE.TIME-INSRV-X = VHCM011_DATA.TIME-INSRV;
        VHCM01IW-PASS-RIGH.TIME-INSRV-X = VHCM011_DATA.TIME-INSRV;
        VHCM01IW-PASS-RIGH.TIME-INSRV = VHCM011_DATA.TIME-INSRV;
        VHCM01IW-PASS-RIGH.CON-SIZE = VHCM011_DATA.CON-SIZE;
        VHCM01IW.CON-NO = VHCM01IW.TRAIN;
  
        if (VHCM011_DATA.CON-STAT == "OUT" ||
         VHCM011_DATA.CON-STAT == "SWP")
  
  
            VHCM01IS-YT-CON();
  
  
  
        else
            if (VHCM011_DATA.CON-STAT == "CON")
  
  
                VHCM01IW-TRIGGER.TRAIN-TRBL = "Y";
                VHCM01IW-TRIGGER.TRAIN-ERROR = "Y";
            else
                if (VHCM011_DATA.CON-STAT == "SRV" ||
                 VHCM011_DATA.CON-STAT == "CAR")
                    VHCM01IS-OSRV-TIME();
                    if (VHCM01IW-TRIGGER.TIME-OUT-ERR == "Y")
                        VHCM01IW-TIME-MSG.MSG-4-1 = VHCM01IW.TRAIN;
                        VHCM01IW-TIME-MSG.MSG-4-2 = " - TIME SHOULD BE >= IN SERVICE TIME";
                        VHCM01IW-TIME-MSG.MSG-1 = VHCM01IW-TIME-MSG.MSG-4;
                    else
                        VHCM015_CRIT-VEH-R.DASH-NO = VHCM011_DATA.MAX-DASH-NO + 1;
                        VHCM015_CRIT-CONHR.DASH-NO = VHCM011_DATA.DASH-NO;
                        VHCM015_CRIT-VEH-R.DATE-INSRV-REV = VHCM011_DATA.DATE-INSRV-REV;
                        VHCM015_CRIT-VEH-R.DATE-INSRV = VHCM011_DATA.DATE-INSRV;
                        VHCM015_CRIT-VEH-R.TIME-INSRV = VHCM011_DATA.TIME-INSRV;
                        VHCM015_CRIT-VEH-R.CON-SIZE = VHCM011_DATA.CON-SIZE;
                        VHCM015_CRIT-VEH-R.CON-STAT = VHCM011_DATA.CON-STAT;
                        
  
                        VHCM01IS-CKCO-IND1();
                    end

  
  
                else
  
                    VHCM01IW-TRIGGER.TRAIN-STAT-ERROR = "Y";
  
                    VHCM01IW-TRIGGER.TRAIN-ERROR = "Y";
                end
            end
        end
    else
        if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
         (VHCM011_CRIT.NO-RECORD-FOUND == "Y"))
  
  
  
  
            VHCM01IS-YT-CON();
  
  
        end
    end
end 

Function VHCM01IS-CTYPE-MSG () 
    if (VHCM01IW-TRIGGER.CAR-TYPE-ERROR == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "MID CAR TYPE ERROR";
  
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW-TRIGGER.CAR-TYPE-ERR-NO;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-MID CAR TYPE ERROR";
    end
end 

Function VHCM01IS-DATE () 
    VHCM01IS-REV-TIME();
  
  
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCM01IW-PASSVALUE.TEMP-DATE = VHXREVC_DATA.REVENUE-DATE;
        VHCM01IW-PASSVALUE.DATE-REV = VHCM01IW-PASSVALUE.TEMP-DATE;
        XXDATEW.DATE-MM-DD-YYYY = VHCM01IW-PASSVALUE.DATE-REV;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHCM01IW-PASSVALUE.DATE-REV = XXDATEW.DATE-YYYY-MM-DD;
  
  
  
  
  
        VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
        VHCM01IW-PASSVALUE.DATE-CURRENT = VGVar.currentGregorianDate;
        VHCM01IW-PASSVALUE.TIME-REV-START = VHXREVC_DATA.TIME-REV-START;
        
  
  
  
  
  
    else

    end
end 

