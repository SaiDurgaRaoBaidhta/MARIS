Function VHCC01IS-VALID-CAR () 
    VHCC01IW-TRIGGER.LAST-CAR-2 = " ";
    VHCC01IW-TRIGGER.LAST-CAR-3 = " ";
    VHCC01IW-TRIGGER.LAST-CAR-4 = " ";
    VHCC01IW-TRIGGER.LAST-CAR-5 = " ";
    VHCC01IW-TRIGGER.LAST-CAR-6 = " ";
    VHCC01IW-TRIGGER.LAST-CAR-7 = " ";
    VHCC01IW-TRIGGER.LAST-CAR-8 = " ";
    VHCC01IW-TRIGGER.LAST-CAR-9 = " ";
    VHCC01IW-TRIGGER.LAST-CAR-10 = " ";
    VHCC01IW-TRIGGER.CAR-ERROR = "N";
    if (VHCC01IW.CAR-NO-1-NEW == " " &&
     VHCC01IW.CAR-NO-2-NEW == " " &&
     VHCC01IW.CAR-NO-3-NEW == " " &&
     VHCC01IW.CAR-NO-4-NEW == " " &&
     VHCC01IW.CAR-NO-5-NEW == " " &&
     VHCC01IW.CAR-NO-6-NEW == " " &&
     VHCC01IW.CAR-NO-7-NEW == " " &&
     VHCC01IW.CAR-NO-8-NEW == " " &&
     VHCC01IW.CAR-NO-9-NEW == " " &&
     VHCC01IW.CAR-NO-10-NEW == " ")
        CON-MSG-1 = "MUST ENTER NEW CAR DATA";
        VHCC01IW-TRIGGER.CAR-ERROR-X = "Y";
        VHCC01IW-TRIGGER.CAR-ERROR = "Y";
        return;
    end

  
    if (VHCC01IW.CAR-NO-1-NEW == " ")
        VHCC01IW-TRIGGER.NOSPACE-CAR1 = "Y";
        VHCC01IW-TRIGGER.CAR-ERROR = "Y";
        
  
  
    end
  
    if (VHCC01IW.CAR-NO-10-NEW == " ")
        if (VHCC01IW.CAR-NO-9-NEW == " ")
            if (VHCC01IW.CAR-NO-8-NEW == " ")
                if (VHCC01IW.CAR-NO-7-NEW == " ")
                    if (VHCC01IW.CAR-NO-6-NEW == " ")
                        if (VHCC01IW.CAR-NO-5-NEW == " ")
                            if (VHCC01IW.CAR-NO-4-NEW == " ")
                                if (VHCC01IW.CAR-NO-3-NEW == " ")
                                    if (VHCC01IW.CAR-NO-2-NEW == " ")
                                        VHCC01IW-TRIGGER.NO2CAR-ERROR = "Y";
                                        VHCC01IW-TRIGGER.CAR-ERROR = "Y";
                                    else
                                        VHCC01IW-TRIGGER.LAST-CAR-2 = "Y";
                                        VHCC01IW.CON-CAR-SIZE = 2;
                                        VHCC01IS-CAR-TYPE();
                                        VHCC01IS-VALID-CR1();
                                        VHCC01IS-VALID-CR2();
                                    end
                                else
                                    VHCC01IW-TRIGGER.LAST-CAR-3 = "Y";
                                    VHCC01IW.CON-CAR-SIZE = 3;
                                    VHCC01IS-CAR-TYPE();
                                    VHCC01IS-VALID-CR1();
                                    VHCC01IS-VALID-CR2();
                                    VHCC01IS-VALID-CR3();
                                end
                            else
                                VHCC01IW-TRIGGER.LAST-CAR-4 = "Y";
                                VHCC01IW.CON-CAR-SIZE = 4;
                                VHCC01IS-CAR-TYPE();
                                VHCC01IS-VALID-CR1();
                                VHCC01IS-VALID-CR2();
                                VHCC01IS-VALID-CR3();
                                VHCC01IS-VALID-CR4();
                            end
                        else
                            VHCC01IW-TRIGGER.LAST-CAR-5 = "Y";
                            VHCC01IW.CON-CAR-SIZE = 5;
                            VHCC01IS-CAR-TYPE();
                            VHCC01IS-VALID-CR1();
                            VHCC01IS-VALID-CR2();
                            VHCC01IS-VALID-CR3();
                            VHCC01IS-VALID-CR4();
                            VHCC01IS-VALID-CR5();
                        end
                    else
                        VHCC01IW-TRIGGER.LAST-CAR-6 = "Y";
                        VHCC01IW.CON-CAR-SIZE = 6;
                        VHCC01IS-CAR-TYPE();
                        VHCC01IS-VALID-CR1();
                        VHCC01IS-VALID-CR2();
                        VHCC01IS-VALID-CR3();
                        VHCC01IS-VALID-CR4();
                        VHCC01IS-VALID-CR5();
                        VHCC01IS-VALID-CR6();
                    end
                else
                    VHCC01IW-TRIGGER.LAST-CAR-7 = "Y";
                    VHCC01IW.CON-CAR-SIZE = 7;
                    VHCC01IS-CAR-TYPE();
                    VHCC01IS-VALID-CR1();
                    VHCC01IS-VALID-CR2();
                    VHCC01IS-VALID-CR3();
                    VHCC01IS-VALID-CR4();
                    VHCC01IS-VALID-CR5();
                    VHCC01IS-VALID-CR6();
                    VHCC01IS-VALID-CR7();
                end
            else
                VHCC01IW-TRIGGER.LAST-CAR-8 = "Y";
                VHCC01IW.CON-CAR-SIZE = 8;
                VHCC01IS-CAR-TYPE();
                VHCC01IS-VALID-CR1();
                VHCC01IS-VALID-CR2();
                VHCC01IS-VALID-CR3();
                VHCC01IS-VALID-CR4();
                VHCC01IS-VALID-CR5();
                VHCC01IS-VALID-CR6();
                VHCC01IS-VALID-CR7();
                VHCC01IS-VALID-CR8();
            end
        else
            VHCC01IW-TRIGGER.LAST-CAR-9 = "Y";
            VHCC01IW.CON-CAR-SIZE = 9;
            VHCC01IS-CAR-TYPE();
            VHCC01IS-VALID-CR1();
            VHCC01IS-VALID-CR2();
            VHCC01IS-VALID-CR3();
            VHCC01IS-VALID-CR4();
            VHCC01IS-VALID-CR5();
            VHCC01IS-VALID-CR6();
            VHCC01IS-VALID-CR7();
            VHCC01IS-VALID-CR8();
            VHCC01IS-VALID-CR9();
        end
    else
        VHCC01IW-TRIGGER.LAST-CAR-10 = "Y";
        VHCC01IW.CON-CAR-SIZE = 10;
        VHCC01IS-CAR-TYPE();
        VHCC01IS-VALID-CR1();
        VHCC01IS-VALID-CR2();
        VHCC01IS-VALID-CR3();
        VHCC01IS-VALID-CR4();
        VHCC01IS-VALID-CR5();
        VHCC01IS-VALID-CR6();
        VHCC01IS-VALID-CR7();
        VHCC01IS-VALID-CR8();
        VHCC01IS-VALID-CR9();
        VHCC01IS-VALID-CRX();
    end
end 

Function VHCC01IS-VALID-CON () 
    if (RETURN-SW != "Y")
  
        if (VHCC01IW.CON-NO is numeric)
            if (VHCC01IW.CON-NO-X > 99 &&
             VHCC01IW.CON-NO-X < 1000)

  
                VHCC011_CRIT.CON-NO = VHCC01IW.CON-NO;
                try
                    call "VHCC011"(XDCONTROL, VHCC011_CRIT, VHCC011_DATA);
                
                end
                if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
                 (VHCC011_CRIT.NO-RECORD-FOUND == "N"))
                    VHCC01IW.DASH-NO = VHCC011_DATA.DASH-NO;
                    VHCC01IW.ORGIN-LOC = VHCC011_DATA.ORGIN-LOC;
  
                    if (VHCC011_DATA.CON-STAT == "SRV" || 
           
                     VHCC011_DATA.CON-STAT == "CAR")
                        VHCC01IW-TRIGGER.CON-ENB = "Y";
                        VHCC01IS-MOVE-CAR();
                        VHCC01IS-ENA-CAR();
                    else
                        if (VHCC011_DATA.CON-STAT == "CON")
                            VHCC01IW-TRIGGER.CON-STAT-CON = "Y";
                            VHCC01IW-TRIGGER.CON-STAT-ERR = "Y";
                            VHCC01IW-TRIGGER.CON-DIS = "Y";
                            VHCC01IS-CLR-CON();
                        end
                        if (VHCC011_DATA.CON-STAT == "OUT")
                            VHCC01IW-TRIGGER.CON-STAT-OUT = "Y";
                            VHCC01IW-TRIGGER.CON-STAT-ERR = "Y";
                            VHCC01IW-TRIGGER.CON-DIS = "Y";
                            VHCC01IS-CLR-CON();
                        end
                    end
                else
                    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
                     (VHCC011_CRIT.NO-RECORD-FOUND == "Y"))
                        VHCC01IW.DASH-NO-X = " ";
                        VHCC01IW.DASH-NO = 0;
                        VHCC01IW-TRIGGER.CON-NOT-EXIST = "Y";
                        VHCC01IW-TRIGGER.CON-DIS = "Y";
                        VHCC01IS-CLR-CON();
                    end
                end
            else
                VHCC01IW-TRIGGER.CON-OUT-RANGE = "Y";
                VHCC01IW-TRIGGER.CON-DIS = "Y";
                VHCC01IS-CLR-CON();
            end
        else
            VHCC01IW-TRIGGER.CON-NOT-SPACE = "Y";
            VHCC01IW-TRIGGER.CON-DIS = "Y";
            VHCC01IS-CLR-CON();
        end
  
  
    end
end 

Function VHCC01IS-VALID-COX () 
    VHCC01IS-CLEAR-MSG();
    RE-VALID-SW-CON = " ";
    RE-VALID-SW-CAR = " ";
    VHCC01IW-TRIGGER.CON-ERROR = "N";
    VHCC01IW-TRIGGER.CAR-ERROR = "N";
    if (VHCC01IW.CON-NO == " ")
        CON-MSG-1 = "PLEASE ENTER CON NO";
        VHCC01IW-TRIGGER.CON-ERROR = "Y";
        VHCC01IW-TRIGGER.CON-ERROR-X = "Y";
        return;
    end
    if (VHCC01IW.CON-NO is numeric)
        if (VHCC01IW.CON-NO-X > 99 &&
         VHCC01IW.CON-NO-X < 1000)
  

  
            VHCC016_CRIT.CON-NO = VHCC01IW.CON-NO;
            VHCC016_CRIT.DASH-NO = VHCC011_DATA.DASH-NO[1];
            VHCC016_CRIT.DATE-INSRV-REV = VHCC011_DATA.DATE-INSRV-REV[1];
            VHCC016_CRIT.DATE-INSRV = VHCC011_DATA.DATE-INSRV[1];
            VHCC016_CRIT.TIME-INSRV = VHCC011_DATA.TIME-INSRV[1];
            
  
  
  
  
            try
                call "VHCC016"(XDCONTROL, VHCC016_CRIT, VHCC016_DATA);
            
            end
            if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
             (VHCC016_CRIT.NO-RECORD-FOUND == "N"))
  
  
                if (VHCC016_DATA.CON-STAT == "SWP")
                    RE-VALID-ERROR = "Y";
                    RE-VALID-SW-CON = "Y";
                    return;
                end
                if (VHCC016_DATA.CON-STAT == "SRV" || VHCC016_DATA.CON-STAT == "CAR")
                    VHCC01IS-VALID-CAR();
  
                    if (CON-ERROR == "N" && CAR-ERROR == "N")
                        VHCC01IS-UPD-CON();
                        RE-VALID-SW = "N";
                        VHCC01IS-RE-VALID();
                        if (RE-VALID-SW != "Y")
                            try
                                call "VHCC013"(XDCONTROL, VHCC013_CRIT, VHCC013_DATA, VHCC013_DATA_1);
                            
                            end
                            if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
                                VHCC01IW-TRIGGER.COMPLETE-CC = "Y";
        
                                if (VHCC011_DATA.DATE-INSRV-ICS[1] != " ")
                                    VHCC016_CRIT.CON-NO = VHCC01IW.CON-NO;
                                    VHCC014_CRIT.DASH-NO = VHCC011_DATA.DASH-NO[1];
                                    VHCC014_CRIT.DATE-INSRV-REV = VHCC011_DATA.DATE-INSRV-REV[1];
                                    VHCC014_CRIT.DATE-INSRV = VHCC011_DATA.DATE-INSRV[1];
                                    VHCC014_CRIT.TIME-INSRV = VHCC011_DATA.TIME-INSRV[1];
                                    VHCC014_CRIT.DATE-INSRV-ICS = VHCC011_DATA.DATE-INSRV-ICS[1];
                                    try
                                        call "VHCC014"(XDCONTROL, VHCC014_CRIT, VHCC014_DATA);
                                    
                                    end
                                end
                                
  
  
                                VHCC01IS-CLEAR-XX();
                            end
                        else
                            VHCC01IW-TRIGGER.RE-VALID-ERROR = "Y";
                        end
                    end
                else
  
                    VHCC01IW-TRIGGER.CON-STAT-ERR = "Y";
                    VHCC01IW-TRIGGER.CON-ERROR = "Y";
                end
            else
                VHCC01IW-TRIGGER.RE-VALID-ERROR = "Y";
            end
        end
    end
end 

Function VHCC01IS-VALID-CR1 () 
    VHCC01IW-PASSVALUE.CAR-NOT-EXIST = "N";
    VHCC013_CRIT.ORIENTATION-1 = " ";
    if (VHCC01IW.CAR-NO-1-NEW is numeric)
  		
        VHCC01IW-PASSVALUE.CAR-NO = VHCC01IW.CAR-NO-1-NEW;
        VHCC01IS-VALID-TYP();
  		
        VHCC013_CRIT.ORIENTATION-1 = VHCC01IW-PASSVALUE.VAGen_ORIENTATION;
        VHCC01IW-PASSVALUE.CURR-LOC-SAVE = VHCC01IW.ORGIN-LOC;
        VHCC01IW.CON-NO-ERROR-1 = VHCC01IW-PASSVALUE.CURR-LOC;
        VHCC01IW.CAR-1-CURR-LOC = VHCC01IW-PASSVALUE.VEH-STAT;
        if (VHCC01IW-PASSVALUE.CAR-NOT-EXIST == "Y")
            VHCC01IW-TRIGGER.CAR1-NO-EXIST = "Y";
            VHCC01IW-TRIGGER.CAR-ERROR = "Y";
        else 
            if ( VHCC01IW-PASSVALUE.CAR-TYPE != "A2" &&
             VHCC01IW-PASSVALUE.CAR-TYPE != "C1" &&
             VHCC01IW-PASSVALUE.CAR-TYPE != "C2" &&
             VHCC01IW-PASSVALUE.CAR-TYPE != "D1" &&
             VHCC01IW-PASSVALUE.CAR-TYPE != "L1")
                VHCC01IW-TRIGGER.TYPE-ERROR-CAR1 = "Y";
                VHCC01IW-TRIGGER.CAR-ERROR = "Y";
            else
                if ((VHCC01IW-PASSVALUE.CAR-TYPE == "C1" ||
                 VHCC01IW-PASSVALUE.CAR-TYPE == "C2" ||
                 VHCC01IW-PASSVALUE.CAR-TYPE == "D1" || 
                 VHCC01IW-PASSVALUE.CAR-TYPE == "L1") &&
                 (VHCC01IW-PASSVALUE.ATO-PRESENT-IND != "Y"))
                    VHCC01IW-TRIGGER.TYPE-ERROR-CAR1 = "Y";
                    VHCC01IW-TRIGGER.CAR-ERROR = "Y";
                else
                    VHCC01IW-PASSVALUE.CAR-NO-NEW = CAR-NO-1-NEW;
                    VHCC01IS-CHK-SAME();
                    if (VHCC01IW-PASSVALUE.WHERE-IS-CAR == "CON" &&
                     (VHCC01IW-TRIGGER.SAME-OLD-CAR == "N"))
                        VHCC01IW-TRIGGER.CAR1-IN-SERV = "Y";
                        VHCC01IW-TRIGGER.CAR-ERROR = "Y";
                        VHCC01IW-PASSVALUE.CON-FILLER = "-";
                        VHCC01IW.CON-NO-ERROR-1 = VHCC01IW-PASSVALUE.CON-PASSVALUE;
                        
				  
				  
				  
                    else
                        if (VHCC01IW-PASSVALUE.TRAIN-INCD-IND == "Y")
                            VHCC01IW-TRIGGER.CAR1-NO-GO-TI = "Y";
                            VHCC01IW-TRIGGER.CAR-ERROR = "Y";
                            if (VHCC01IW-PASSVALUE.VEH-STAT == "NO GO")
                                VHCC01IW.CAR-1-CURR-LOC = "NO TI";
                            else
                                VHCC01IW.CAR-1-CURR-LOC = "GO TI";
                            end
                        else
                            if (VHCC01IW-PASSVALUE.VEH-STAT != "GO" &&
                             VHCC01IW-PASSVALUE.VEH-STAT != "USABLE" &&
                             VHCC01IW-PASSVALUE.VEH-STAT != "ERROR" &&
                             (VHCC01IW-TRIGGER.SAME-OLD-CAR == "N"))
                                VHCC01IW-TRIGGER.CAR1-NO-GO = "Y";
                                VHCC01IW-TRIGGER.CAR-ERROR = "Y";
                            end
                        end
                    end
                end
            end
        end
    else
        VHCC01IW-TRIGGER.NONUMERIC-CAR1 = "Y";
        VHCC01IW-TRIGGER.CAR-ERROR = "Y";
    end
end 

Function VHCC01IS-VALID-CR2 () 
    VHCC01IW-PASSVALUE.CAR-NOT-EXIST = "N";
    VHCC013_CRIT.ORIENTATION-2 = " ";
    if (VHCC01IW-TRIGGER.LAST-CAR-2 == "Y")
        if (VHCC01IW.CAR-NO-2-NEW is numeric)
            if ((VHCC01IW.CAR-NO-2-NEW == VHCC01IW.CAR-NO-1-NEW))
                VHCC01IW-TRIGGER.DUPL-CAR2 = "Y";
                VHCC01IW-TRIGGER.CAR-ERROR = "Y";
            else
  				
                VHCC01IW-PASSVALUE.CAR-NO = VHCC01IW.CAR-NO-2-NEW;
                VHCC01IS-VALID-TYP();
                VHCC013_CRIT.ORIENTATION-2 = VHCC01IW-PASSVALUE.VAGen_ORIENTATION;
                VHCC01IW.CON-NO-ERROR-2 = VHCC01IW-PASSVALUE.CURR-LOC;
                VHCC01IW.CAR-2-CURR-LOC = VHCC01IW-PASSVALUE.VEH-STAT;
