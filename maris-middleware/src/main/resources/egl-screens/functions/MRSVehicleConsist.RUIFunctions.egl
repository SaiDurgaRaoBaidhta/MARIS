    VHCT01A_CRIT.CON-CAR-X-2 = VHCT01IW-PASSVALUE.CAR-NO-2;
    VHCT01A_CRIT.CON-CAR-X-3 = VHCT01IW-PASSVALUE.CAR-NO-3;
    VHCT01A_CRIT.CON-CAR-X-4 = VHCT01IW-PASSVALUE.CAR-NO-4;
    VHCT01A_CRIT.CON-CAR-X-5 = VHCT01IW-PASSVALUE.CAR-NO-5;
