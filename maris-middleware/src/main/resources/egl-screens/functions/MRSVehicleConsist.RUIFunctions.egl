Function VHCM01IS-MOVE-BOTH () 
    VHCM01IW-PASSVALUE.PSEUDO-SW = VHCM01IW-PASS-RIGH.PSEUDO-CAR-SW;
    VHCM015_CRIT.PSEUDO-SW = VHCM01IW-PASSVALUE.PSEUDO-SW;
    VHCM015_CRIT.CON-NO = VHCM01IW.NEW-TRAIN;
    VHCM015_CRIT.DATE-INSRV-REV = VHCM01IW-PASSVALUE.DATE-REV;
    VHCM015_CRIT.DATE-INSRV = VHCM01IW-PASSVALUE.DATE-REV;
    VHCM015_CRIT.TIME-INSRV = VHCM01IW.TIME-OUTSRV;
    VHCM015_CRIT.RUN-TIME-HRS = VHCM01IW-PASSVALUE.DIFF-HH;
    VHCM015_CRIT.RUN-TIME-MIN = VHCM01IW-PASSVALUE.DIFF-MM;
    VHCM015_CRIT.TIME-OUTSRV = VHCM01IW.TIME-OUTSRV;
  
    VHCM015_CRIT.CON-SIZE-MK = VHCM01IW-PASSVALUE.LAST-CAR-NO;
    VHCM015_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
  
  
    VHCM015_CRIT.TERM-ID = VH01A01_DATA.TERM-ID;
    VHCM015_CRIT.USER-GROUP = VH01A01_DATA.USER-GROUP;
    VHCM015_CRIT.PSEUDO-CAR-SW = VHCM01IW-PASSVALUE.PSEUDO-SW;
    if (LAST-CAR-NO == 2)
        VHCM015_CRIT.CON-SIZE = 2;
    else
        if (LAST-CAR-NO == 3)
            VHCM015_CRIT.CON-SIZE = 3;
        else
            if (LAST-CAR-NO == 4)
                VHCM015_CRIT.CON-SIZE = 4;
            else
                if (LAST-CAR-NO == 5)
                    VHCM015_CRIT.CON-SIZE = 5;
                else
                    if (LAST-CAR-NO == 6)
                        VHCM015_CRIT.CON-SIZE = 6;
                    else
                        if (LAST-CAR-NO == 7)
                            VHCM015_CRIT.CON-SIZE = 7;
                        else
                            if (LAST-CAR-NO == 8)
                                VHCM015_CRIT.CON-SIZE = 8;
                            else
                                if (LAST-CAR-NO == 9)
                                    VHCM015_CRIT.CON-SIZE = 9;
                                else
                                    if (LAST-CAR-NO == 10)
                                        VHCM015_CRIT.CON-SIZE = 10;
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
  
  
    VHCM015_CRIT.CON-CAR-NO-1 = VHCM01IW-PASSVALUE.CAR-NO-1;
    VHCM015_CRIT.CON-CAR-NO-2 = VHCM01IW-PASSVALUE.CAR-NO-2;
