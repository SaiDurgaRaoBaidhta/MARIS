            VHCM01IW-PASS-LEFT.CAR-NO-1-MAX-PM = VHCM013_DATA.HRS-TO-NEXT-PM-MAX[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CAR-NO-1-MAX-BRK = VHCM013_DATA.BRK-IN-HRS-MAX[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CAR-NO-1-WAR-IND = VHCM013_DATA.WAR-IND[VHCM01IW-PASS-LEFT.COUNTER];
