        VHMT01IW-WS-MSG.MESSAGES-X[21] = "D";
        VHMT01IW-WS-MSG.MESSAGES-X[22] = " ";
        VHMT01IW-WS-MSG.MESSAGES-X[23] = "N";
        VHMT01IW-WS-MSG.MESSAGES-X[24] = "O";
