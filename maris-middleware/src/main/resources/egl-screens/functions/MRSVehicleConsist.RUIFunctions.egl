                                else
                                    if (VHTR01IW-CON-LIST.CAR-ORIENT8 == VHTS2A3_DATA.RGT-ORIENTATION-CD[8])
                                        VHTR01IW-CON-LIST.CAR-RIGHT-ORIENT-8 = VHTR01IW-CON-LIST.CAR-ORIENT8;
                                    end
                                end
                                
  
  
  
  
  
                            else
                                if (IND == 9)
                                    VHTR01IW-CON-LIST.CAR-NO-9 = VHTR011_DATA.CAR-NO[IND];
                                    VHTR01IW-CON-LIST.CAR-ORDER9 = 9;
                                    VHTR01IW-CON-LIST.CAR-ORIENT9 = VHTR011_DATA.VAGen_ORIENTATION[IND];
                                    VHTR01IW-CON-LIST.CAR-LEFT-ORIENT-9 = " ";
                                    VHTR01IW-CON-LIST.CAR-RIGHT-ORIENT-9 = " ";
