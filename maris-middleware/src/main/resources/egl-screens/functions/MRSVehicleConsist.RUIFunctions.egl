                                    else
                                        if (VHTR01IW-CON-LIST.CAR-ORIENT9 == VHTS2A3_DATA.RGT-ORIENTATION-CD[9])
                                            VHTR01IW-CON-LIST.CAR-RIGHT-ORIENT-9 = VHTR01IW-CON-LIST.CAR-ORIENT9;
                                        end
                                    end
                                else
                                    if (IND == 10)
                                        VHTR01IW-CON-LIST.CAR-NO-10 = VHTR011_DATA.CAR-NO[IND];
                                        VHTR01IW-CON-LIST.CAR-ORDER10 = 10;
                                        VHTR01IW-CON-LIST.CAR-ORIENT10 = VHTR011_DATA.VAGen_ORIENTATION[IND];
                                        VHTR01IW-CON-LIST.CAR-LEFT-ORIENT-10 = " ";
                                        VHTR01IW-CON-LIST.CAR-RIGHT-ORIENT-10 = " ";
