    VHCC013_CRIT.VEH-STAT-PREV-6 = VHCC011_DATA.VEH-STAT[6];
    VHCC013_CRIT.VEH-STAT-PREV-7 = VHCC011_DATA.VEH-STAT[7];
    VHCC013_CRIT.VEH-STAT-PREV-8 = VHCC011_DATA.VEH-STAT[8];
    VHCC013_CRIT.VEH-STAT-PREV-9 = VHCC011_DATA.VEH-STAT[9];
    VHCC013_CRIT.VEH-STAT-PREV-10 = VHCC011_DATA.VEH-STAT[10];
    VHCC013_CRIT.VEH-STAT-NEW-1 = VHCC016_DATA.VEH-STAT[1];
    VHCC013_CRIT.VEH-STAT-NEW-2 = VHCC016_DATA.VEH-STAT[2];
    VHCC013_CRIT.VEH-STAT-NEW-3 = VHCC016_DATA.VEH-STAT[3];
