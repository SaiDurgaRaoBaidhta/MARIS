        VHMT01IS-MSG-RT();
    end
    if (VHMT01IW-TRIGGER.TIME-COMP-ERR == "Y")
        VHMT01IW-TIME-MSG.MSG-1 = "TIME INSERVICE CANNOT BE FUTURE TIME";
        VHMT01IW-TRIGGER.TIME-COMP-ERR = " ";
        VHMT01IW-TIME-MSG.TIME-MESSAGE = VHMT01IW.TIME-INSRV-HRMIN;
        VHMT01IW-WS-MSG.MSG-NO = VHMT01IW-WS-MSG.MSG-NO + 1;
        VHMT01IW-WS-MSG.MSG-LAST-BYTE = 17;
        VHMT01IW-WS-MSG.MESSAGES-X[1] = TIME-MESSAGE-X[1];
        VHMT01IW-WS-MSG.MESSAGES-X[2] = TIME-MESSAGE-X[2];
        VHMT01IW-WS-MSG.MESSAGES-X[3] = TIME-MESSAGE-X[3];
        VHMT01IW-WS-MSG.MESSAGES-X[4] = TIME-MESSAGE-X[4];
        VHMT01IW-WS-MSG.MESSAGES-X[5] = TIME-MESSAGE-X[5];
        VHMT01IW-WS-MSG.MESSAGES-X[6] = "-";
        VHMT01IW-WS-MSG.MESSAGES-X[7] = "F";
        VHMT01IW-WS-MSG.MESSAGES-X[8] = "U";
        VHMT01IW-WS-MSG.MESSAGES-X[9] = "T";
        VHMT01IW-WS-MSG.MESSAGES-X[10] = "U";
        VHMT01IW-WS-MSG.MESSAGES-X[11] = "R";
        VHMT01IW-WS-MSG.MESSAGES-X[12] = "E";
        VHMT01IW-WS-MSG.MESSAGES-X[13] = " ";
        VHMT01IW-WS-MSG.MESSAGES-X[14] = "T";
        VHMT01IW-WS-MSG.MESSAGES-X[15] = "I";
        VHMT01IW-WS-MSG.MESSAGES-X[16] = "M";
        VHMT01IW-WS-MSG.MESSAGES-X[17] = "E";
        VHMT01IS-MSG-RT();
    end
end 

Function VHMT01IS-TYPE-INV () 
    VHMT01IW-WS-MSG.MSG-LAST-BYTE = 20;
  
  
  
  
    VHMT01IW-WS-MSG.MESSAGES-X[5] = "-";
    VHMT01IW-WS-MSG.MESSAGES-X[6] = "I";
    VHMT01IW-WS-MSG.MESSAGES-X[7] = "n";
    VHMT01IW-WS-MSG.MESSAGES-X[8] = "v";
    VHMT01IW-WS-MSG.MESSAGES-X[9] = "a";
    VHMT01IW-WS-MSG.MESSAGES-X[10] = "l";
    VHMT01IW-WS-MSG.MESSAGES-X[11] = "i";
    VHMT01IW-WS-MSG.MESSAGES-X[12] = "d";
    VHMT01IW-WS-MSG.MESSAGES-X[13] = " ";
    VHMT01IW-WS-MSG.MESSAGES-X[17] = " ";
    VHMT01IW-WS-MSG.MESSAGES-X[18] = "C";
    VHMT01IW-WS-MSG.MESSAGES-X[19] = "a";
    VHMT01IW-WS-MSG.MESSAGES-X[20] = "r";
    VHMT01IS-MSG-RT();
end 

Function VHMT01IS-UPD-CON () 
    XXDATEW.DATE-MM-DD-YYYY = VHMT01IW.DATE-INSRV;
    XXDATEW.VAGen_FUNCTION = "YMD";
    MRSCommonCode.XXDATES-CONVERT();
    VHMT01IW-PASSVALUE.DATE-INSRV-REV = XXDATEW.DATE-YYYY-MM-DD;
    VHMT013_CRIT.DATE-INSRV-REV = VHMT01IW-PASSVALUE.DATE-INSRV-REV;
  
  
  
  
  
    VHMT01IW.DASH-NO = VHMT011_DATA.MAX-DASH-NO + 1;
    VHMT01IW.DASH-NO-XX = VHMT01IW.DASH-NO;
    VHMT01IW.DASH-NO-X = VHMT01IW.DASH-NO-XX;
    VHMT013_CRIT.DASH-NO = VHMT01IW.DASH-NO;
    VHMT013_CRIT.CON-NO = VHMT01IW.CON-NO;
    VHMT01IW-CON-MSG.CON-NO = VHMT01IW.CON-NO;
    VHMT01IW-CON-MSG.DASH-NO = VHMT01IW.DASH-NO;
    VHMT013_CRIT.DATE-INSRV-REV = VHMT01IW-PASSVALUE.DATE-INSRV-REV;
    VHMT013_CRIT.TIME-INSRV = VHMT01IW.TIME-INSRV;
    VHMT013_CRIT.DATE-INSRV = VHMT01IW.DATE-INSRV-SYSTEM-X;
    VHMT013_CRIT.CON-STAT = "SRV";
    VHMT013_CRIT.TERM-ID = VH01A01_DATA.TERM-ID;
    VHMT013_CRIT.USER-GROUP = VH01A01_DATA.USER-GROUP;
    VHMT013_CRIT.PSEUDO-SW = VHMT01IW-PASSVALUE.PSEUDO-SW;
    if (VHMT01IW-TRIGGER.LAST-CAR-2 == "Y")
        VHMT013_CRIT.CON-SIZE = 2;
    else
        if (VHMT01IW-TRIGGER.LAST-CAR-3 == "Y")
            VHMT013_CRIT.CON-SIZE = 3;
        else
            if (VHMT01IW-TRIGGER.LAST-CAR-4 == "Y")
                VHMT013_CRIT.CON-SIZE = 4;
            else
                if (VHMT01IW-TRIGGER.LAST-CAR-5 == "Y")
                    VHMT013_CRIT.CON-SIZE = 5;
                else
                    if (VHMT01IW-TRIGGER.LAST-CAR-6 == "Y")
                        VHMT013_CRIT.CON-SIZE = 6;
                    else
                        if (VHMT01IW-TRIGGER.LAST-CAR-7 == "Y")
                            VHMT013_CRIT.CON-SIZE = 7;
                        else
                            if (VHMT01IW-TRIGGER.LAST-CAR-8 == "Y")
                                VHMT013_CRIT.CON-SIZE = 8;
                            else
                                if (VHMT01IW-TRIGGER.LAST-CAR-9 == "Y")
                                    VHMT013_CRIT.CON-SIZE = 9;
                                else
                                    if (VHMT01IW-TRIGGER.LAST-CAR-10 == "Y")
                                        VHMT013_CRIT.CON-SIZE = 10;
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    VHMT013_CRIT.ORIGIN-LOC = VHMT01IW-PASSVALUE.CURR-LOC-SAVE;
    VHMT013_CRIT.ORIGIN-LOC-SWAP = VHMT01IW-PASSVALUE.CURR-LOC-SAVE;
    VHMT013_CRIT.CON-CAR-NO-1 = VHMT01IW.CON-CAR-NO-1;
    VHMT013_CRIT.CON-CAR-NO-2 = VHMT01IW.CON-CAR-NO-2;
    VHMT013_CRIT.CON-CAR-NO-3 = VHMT01IW.CON-CAR-NO-3;
    VHMT013_CRIT.CON-CAR-NO-4 = VHMT01IW.CON-CAR-NO-4;
    VHMT013_CRIT.CON-CAR-NO-5 = VHMT01IW.CON-CAR-NO-5;
    VHMT013_CRIT.CON-CAR-NO-6 = VHMT01IW.CON-CAR-NO-6;
    VHMT013_CRIT.CON-CAR-NO-7 = VHMT01IW.CON-CAR-NO-7;
    VHMT013_CRIT.CON-CAR-NO-8 = VHMT01IW.CON-CAR-NO-8;
    VHMT013_CRIT.CON-CAR-NO-9 = VHMT01IW.CON-CAR-NO-9;
    VHMT013_CRIT.CON-CAR-NO-10 = VHMT01IW.CON-CAR-NO-10;
    VHMT013_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
    VHMT013_CRIT.PART-CON-NO-1 = VHMT015_DATA.PART-CON-NO[1];
    VHMT013_CRIT.PART-CON-NO-2 = VHMT015_DATA.PART-CON-NO[2];
    VHMT013_CRIT.PART-CON-NO-3 = VHMT015_DATA.PART-CON-NO[3];
    VHMT013_CRIT.PART-CON-NO-4 = VHMT015_DATA.PART-CON-NO[4];
    VHMT013_CRIT.PART-CON-NO-5 = VHMT015_DATA.PART-CON-NO[5];
    VHMT013_CRIT.PART-CON-NO-6 = VHMT015_DATA.PART-CON-NO[6];
    VHMT013_CRIT.PART-CON-NO-7 = VHMT015_DATA.PART-CON-NO[7];
    VHMT013_CRIT.PART-CON-NO-8 = VHMT015_DATA.PART-CON-NO[8];
    VHMT013_CRIT.PART-CON-NO-9 = VHMT015_DATA.PART-CON-NO[9];
    VHMT013_CRIT.PART-CON-NO-10 = VHMT015_DATA.PART-CON-NO[10];
end 

Function VHMT01IS-VALID-CAR () 
    VHMT01IW-TRIGGER.LAST-CAR-2 = " ";
    VHMT01IW-TRIGGER.LAST-CAR-3 = " ";
    VHMT01IW-TRIGGER.LAST-CAR-4 = " ";
    VHMT01IW-TRIGGER.LAST-CAR-5 = " ";
    VHMT01IW-TRIGGER.LAST-CAR-6 = " ";
    VHMT01IW-TRIGGER.LAST-CAR-7 = " ";
    VHMT01IW-TRIGGER.LAST-CAR-8 = " ";
    VHMT01IW-TRIGGER.LAST-CAR-9 = " ";
    VHMT01IW-TRIGGER.LAST-CAR-10 = " ";
    VHMT01IW-TRIGGER.CAR-ERROR = "N";
  
    if (VHMT01IW.CON-CAR-NO-1 == " ")
        VHMT01IW-TRIGGER.NOSPACE-CAR1 = "Y";
        VHMT01IW-TRIGGER.CAR-ERROR = "Y";
        
  
  
    end
  
    if (VHMT01IW.CON-CAR-NO-10 == " ")
        if (VHMT01IW.CON-CAR-NO-9 == " ")
            if (VHMT01IW.CON-CAR-NO-8 == " ")
                if (VHMT01IW.CON-CAR-NO-7 == " ")
                    if (VHMT01IW.CON-CAR-NO-6 == " ")
                        if (VHMT01IW.CON-CAR-NO-5 == " ")
                            if (VHMT01IW.CON-CAR-NO-4 == " ")
                                if (VHMT01IW.CON-CAR-NO-3 == " ")
                                    if (VHMT01IW.CON-CAR-NO-2 == " ")
                                        VHMT01IW-TRIGGER.NO2CAR-ERROR = "Y";
                                        VHMT01IW-TRIGGER.CAR-ERROR = "Y";
                                    else
                                        VHMT01IW-TRIGGER.LAST-CAR-2 = "Y";
                                        VHMT01IW.CON-CAR-SIZE = 2 ;
                                        VHMT01IS-CAR-TYPE();
                                        VHMT01IS-VALID-CR1();
                                        VHMT01IS-VALID-CR2(); 
                                    end
                                else
                                    VHMT01IW-TRIGGER.LAST-CAR-3 = "Y";
                                    VHMT01IW.CON-CAR-SIZE = 3;
                                    VHMT01IS-CAR-TYPE();
                                    VHMT01IS-VALID-CR1();
                                    VHMT01IS-VALID-CR2();
                                    VHMT01IS-VALID-CR3();
                                end
                            else
                                VHMT01IW-TRIGGER.LAST-CAR-4 = "Y";
                                VHMT01IW.CON-CAR-SIZE = 4;
                                VHMT01IS-CAR-TYPE();
                                VHMT01IS-VALID-CR1();
                                VHMT01IS-VALID-CR2();
                                VHMT01IS-VALID-CR3();
                                VHMT01IS-VALID-CR4();
                            end
                        else
                            VHMT01IW-TRIGGER.LAST-CAR-5 = "Y";
                            VHMT01IW.CON-CAR-SIZE = 5;
                            VHMT01IS-CAR-TYPE();
                            VHMT01IS-VALID-CR1();
                            VHMT01IS-VALID-CR2();
                            VHMT01IS-VALID-CR3();
                            VHMT01IS-VALID-CR4();
                            VHMT01IS-VALID-CR5();
                        end
                    else
                        VHMT01IW-TRIGGER.LAST-CAR-6 = "Y";
                        VHMT01IW.CON-CAR-SIZE = 6;
                        VHMT01IS-CAR-TYPE();
                        VHMT01IS-VALID-CR1();
                        VHMT01IS-VALID-CR2();
                        VHMT01IS-VALID-CR3();
                        VHMT01IS-VALID-CR4();
                        VHMT01IS-VALID-CR5();
                        VHMT01IS-VALID-CR6();
                    end
                else
                    VHMT01IW-TRIGGER.LAST-CAR-7 = "Y";
                    VHMT01IW.CON-CAR-SIZE = 7;
                    VHMT01IS-CAR-TYPE();
                    VHMT01IS-VALID-CR1();
                    VHMT01IS-VALID-CR2();
                    VHMT01IS-VALID-CR3();
                    VHMT01IS-VALID-CR4();
                    VHMT01IS-VALID-CR5();
                    VHMT01IS-VALID-CR6();
                    VHMT01IS-VALID-CR7();
                end
            else
                VHMT01IW-TRIGGER.LAST-CAR-8 = "Y";
                VHMT01IW.CON-CAR-SIZE = 8;
                VHMT01IS-CAR-TYPE();
                VHMT01IS-VALID-CR1();
                VHMT01IS-VALID-CR2();
                VHMT01IS-VALID-CR3();
                VHMT01IS-VALID-CR4();
                VHMT01IS-VALID-CR5();
                VHMT01IS-VALID-CR6();
                VHMT01IS-VALID-CR7();
                VHMT01IS-VALID-CR8();
            end
        else
            VHMT01IW-TRIGGER.LAST-CAR-9 = "Y";
            VHMT01IW.CON-CAR-SIZE = 9;
            VHMT01IS-CAR-TYPE();
            VHMT01IS-VALID-CR1();
            VHMT01IS-VALID-CR2();
            VHMT01IS-VALID-CR3();
            VHMT01IS-VALID-CR4();
            VHMT01IS-VALID-CR5();
            VHMT01IS-VALID-CR6();
            VHMT01IS-VALID-CR7();
            VHMT01IS-VALID-CR8();
            VHMT01IS-VALID-CR9();
        end
    else
        VHMT01IW-TRIGGER.LAST-CAR-10 = "Y";
        VHMT01IW.CON-CAR-SIZE = 10;
        VHMT01IS-CAR-TYPE();
        VHMT01IS-VALID-CR1();
        VHMT01IS-VALID-CR2();
        VHMT01IS-VALID-CR3();
        VHMT01IS-VALID-CR4();
        VHMT01IS-VALID-CR5();
        VHMT01IS-VALID-CR6();
        VHMT01IS-VALID-CR7();
        VHMT01IS-VALID-CR8();
        VHMT01IS-VALID-CR9();
        VHMT01IS-VALID-CRX();
    end
end 

Function VHMT01IS-VALID-CON ()
    VHMT01IW-TRIGGER.CON-ERROR = "N";
    VHMT01IW-TRIGGER.CAR-ERROR = "N";
    if (VHMT01IW.CON-NO is numeric)
        if (VHMT01IW.CON-NO-X > 99 &&
         VHMT01IW.CON-NO-X < 1000)
  
  
  
            VHMT011_CRIT.CON-NO = VHMT01IW.CON-NO;
            XXDATEW.DATE-MM-DD-YYYY = VHMT01IW.DATE-INSRV;
            XXDATEW.VAGen_FUNCTION = "YMD";
            MRSCommonCode.XXDATES-CONVERT();
            VHMT011_CRIT.DATE-INSRV-REV = XXDATEW.DATE-YYYY-MM-DD;
            try
                call "VHMT011"(XDCONTROL, VHMT011_CRIT, VHMT011_DATA);  
            
            end
            if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
             (VHMT011_CRIT.NO-RECORD-FOUND == "N"))
			    
                if (VHMT011_DATA.CON-STAT == "OUT" || VHMT011_DATA.CON-STAT == "SWP")
                    VHMT01IS-VALID-CAR();
                    VHMT01IS-CONV-TIME();
  					
                    if (CON-ERROR == "N" && CAR-ERROR == "N" && TIME-ERROR-X == "N")
                        VHMT01IS-UPD-CON();
                        try
                            call "VHMT013"(XDCONTROL, VHMT013_CRIT, VHMT013_DATA, VHMT013_DATA_1);
                        
                        end
                        if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
                            VHMT01IW-TRIGGER.COMPLETE-MT = "Y";
                            
							  
							  
                            VHMT01I-CLEAR();
                        end
                    end
                else
  					
                    VHMT01IW-TRIGGER.CON-STAT-ERR = "Y";
                    VHMT01IW-TRIGGER.CON-ERROR = "Y";
                end
            else
                if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
                 (VHMT011_CRIT.NO-RECORD-FOUND == "Y"))
                    VHMT01IW.DASH-NO-X = " ";
                    
  
                    VHMT01IS-VALID-CAR();
                    VHMT01IS-CONV-TIME();
  
                    if (CON-ERROR == "N" && CAR-ERROR == "N" && TIME-ERROR-X == "N")
                        VHMT01IS-ADD-CON();
                        try
                            call "VHMT012"(XDCONTROL, VHMT012_CRIT, VHMT012_DATA, VHMT012_DATA_1);
                        
                        end
                        if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
                            VHMT01IW-TRIGGER.COMPLETE-MT = "Y";
                            VHMT01I-CLEAR();
                        end
                    end
                end
            end
        else
  
            VHMT01IW-TRIGGER.CON-NO-NUMERIC = "Y";
            VHMT01IW-TRIGGER.CON-ERROR = "Y";
        end
    else
        VHMT01IW-TRIGGER.CON-NO-NUMERIC = "Y";
        VHMT01IW-TRIGGER.CON-ERROR = "Y";
    end
end 

Function VHMT01IS-VALID-CR1 ()
  
   
    VHMT01IW-PASSVALUE.CAR-NOT-EXIST = "N";
    VHMT013_CRIT.ORIENTATION-1 = " ";
    VHMT012_CRIT.ORIENTATION-1 = " ";
    
    if (VHMT01IW.CON-CAR-NO-1 is numeric)
        
        VHMT01IW-PASSVALUE.CAR-NO = VHMT01IW.CON-CAR-NO-1;
        VHMT01IS-VALID-TYP();
        VHMT01IW.SOFT_VER-1 = VHMT01IW-PASSVALUE.SOFT_VER;
        VHMT013_CRIT.ORIENTATION-1 = VHMT01IW-PASSVALUE.VAGen_ORIENTATION;
        VHMT012_CRIT.ORIENTATION-1 = VHMT01IW-PASSVALUE.VAGen_ORIENTATION;
        VHMT01IW-PASSVALUE.CURR-LOC-SAVE = VHMT01IW-PASSVALUE.CURR-LOC;
        VHMT01IW-PASSVALUE.SOFT_VER-SAVE = VHMT01IW-PASSVALUE.SOFT_VER;
        VHMT01IW.CON-NO-ERROR-1 = VHMT01IW-PASSVALUE.CURR-LOC;
        VHMT01IW.CAR-1-CURR-LOC = VHMT01IW-PASSVALUE.VEH-STAT;
        if (VHMT01IW-PASSVALUE.CAR-NOT-EXIST == "Y")
            VHMT01IW-TRIGGER.CAR1-NO-EXIST = "Y";
            VHMT01IW-TRIGGER.CAR-ERROR = "Y";
            VHMT01IW.CAR-1-CURR-LOC = " ";
            VHMT01IW.CON-NO-ERROR-1 = " ";
            VHMT01IW.SOFT_VER-1 = " ";
        else 
            if (VHMT01IW-PASSVALUE.CAR-TYPE != "A2" &&
             VHMT01IW-PASSVALUE.CAR-TYPE != "C1" &&
             VHMT01IW-PASSVALUE.CAR-TYPE != "C2" &&
             VHMT01IW-PASSVALUE.CAR-TYPE != "D1" &&
             VHMT01IW-PASSVALUE.CAR-TYPE != "L1")
                VHMT01IW-TRIGGER.TYPE-ERROR-CAR1 = "Y";
                VHMT01IW-TRIGGER.CAR-ERROR = "Y";
            else
                if ((VHMT01IW-PASSVALUE.CAR-TYPE == "C1" ||
                 VHMT01IW-PASSVALUE.CAR-TYPE == "C2" ||
                 VHMT01IW-PASSVALUE.CAR-TYPE == "D1" ||
                 VHMT01IW-PASSVALUE.CAR-TYPE == "L1") &&
                 (VHMT01IW-PASSVALUE.ATO-PRESENT-IND != "Y"))
                    VHMT01IW-TRIGGER.TYPE-ERROR-CAR1 = "Y";
                    VHMT01IW-TRIGGER.CAR-ERROR = "Y";
                else
                    if (VHMT01IW-PASSVALUE.WHERE-IS-CAR == "CON")
                        VHMT01IW-TRIGGER.CAR1-IN-SERV = "Y";
                        VHMT01IW-TRIGGER.CAR-ERROR = "Y";
                        VHMT01IW-PASSVALUE.CON-FILLER = "-";
                        VHMT01IW.CON-NO-ERROR-1 = VHMT01IW-PASSVALUE.CON-PASSVALUE;
                    else
                        if (VHMT01IW-PASSVALUE.TRAIN-INCD-IND == "Y")
                            VHMT01IW-TRIGGER.CAR1-NO-GO-TI = "Y";
                            VHMT01IW-TRIGGER.CAR-ERROR = "Y";
                            if (VHMT01IW-PASSVALUE.VEH-STAT == "NO GO")
                                VHMT01IW.CAR-1-CURR-LOC = "NO TI";
                            else
                                VHMT01IW.CAR-1-CURR-LOC = "GO TI";
                            end
                        else
                            if (VHMT01IW-PASSVALUE.VEH-STAT == "NO GO")
                                VHMT01IW-TRIGGER.CAR1-NO-GO = "Y";
                                VHMT01IW-TRIGGER.CAR-ERROR = "Y";
                            else
                                if (VHMT01IW-PASSVALUE.VEH-STAT != "GO" &&
                                 VHMT01IW-PASSVALUE.VEH-STAT != "USABLE" &&
                                 VHMT01IW-PASSVALUE.VEH-STAT != "ERROR")
                                    VHMT01IW-TRIGGER.CAR1-NO-GO = "Y";
                                    VHMT01IW-TRIGGER.CAR-ERROR = "Y";
                                end
                            end
                        end
                    end
                end
            end
        end
    else
        VHMT01IW-TRIGGER.NONUMERIC-CAR1 = "Y";
        VHMT01IW-TRIGGER.CAR-ERROR = "Y";
    end
end 

Function VHMT01IS-VALID-CR2 () 
    VHMT01IW-PASSVALUE.CAR-NOT-EXIST = "N";
    VHMT013_CRIT.ORIENTATION-2 = " ";
    VHMT012_CRIT.ORIENTATION-2 = " ";
    
    if (VHMT01IW-TRIGGER.LAST-CAR-2 == "Y")
        if (VHMT01IW.CON-CAR-NO-2 is numeric)
            if ((VHMT01IW.CON-CAR-NO-2 == VHMT01IW.CON-CAR-NO-1))
                VHMT01IW-TRIGGER.DUPL-CAR2 = "Y";
                VHMT01IW-TRIGGER.CAR-ERROR = "Y";
            else
                
                VHMT01IW-PASSVALUE.CAR-NO = VHMT01IW.CON-CAR-NO-2;
                VHMT01IS-VALID-TYP();
                VHMT013_CRIT.ORIENTATION-2 = VHMT01IW-PASSVALUE.VAGen_ORIENTATION;
                VHMT012_CRIT.ORIENTATION-2 = VHMT01IW-PASSVALUE.VAGen_ORIENTATION;
                VHMT01IW.CON-NO-ERROR-2 = VHMT01IW-PASSVALUE.CURR-LOC;
                VHMT01IW.CAR-2-CURR-LOC = VHMT01IW-PASSVALUE.VEH-STAT;
                VHMT01IW.SOFT_VER-2 = VHMT01IW-PASSVALUE.SOFT_VER;
                if (VHMT01IW-PASSVALUE.CAR-NOT-EXIST == "Y")
                    VHMT01IW-TRIGGER.CAR2-NO-EXIST = "Y";
                    VHMT01IW-TRIGGER.CAR-ERROR = "Y";
                    VHMT01IW.CAR-2-CURR-LOC = " ";
                    VHMT01IW.CON-NO-ERROR-2 = " ";
                    VHMT01IW.SOFT_VER-2 = " ";
                else    
                    if (VHMT01IW-PASSVALUE.CAR-TYPE != "A2" &&
                     VHMT01IW-PASSVALUE.CAR-TYPE != "C1" &&
                     VHMT01IW-PASSVALUE.CAR-TYPE != "C2"  &&
                     VHMT01IW-PASSVALUE.CAR-TYPE != "D1"  &&
                     VHMT01IW-PASSVALUE.CAR-TYPE != "L1")
                        VHMT01IW-TRIGGER.TYPE-ERROR-CAR2 = "Y";
                        VHMT01IW-TRIGGER.CAR-ERROR = "Y";
                    else
                        if ((VHMT01IW-PASSVALUE.CAR-TYPE == "C1" ||
                         VHMT01IW-PASSVALUE.CAR-TYPE == "C2" ||
                         VHMT01IW-PASSVALUE.CAR-TYPE == "L1" ||
                         VHMT01IW-PASSVALUE.CAR-TYPE == "D1") &&
                         (VHMT01IW-PASSVALUE.ATO-PRESENT-IND != "Y"))
                            VHMT01IW-TRIGGER.TYPE-ERROR-CAR2 = "Y";
                            VHMT01IW-TRIGGER.CAR-ERROR = "Y";
                        else
                            if (VHMT01IW-PASSVALUE.WHERE-IS-CAR == "CON")
                                VHMT01IW-TRIGGER.CAR2-IN-SERV = "Y";
                                VHMT01IW-TRIGGER.CAR-ERROR = "Y";
                                VHMT01IW-PASSVALUE.CON-FILLER = "-";
