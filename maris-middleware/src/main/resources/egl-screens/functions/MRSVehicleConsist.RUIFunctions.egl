Function VHTR01IS-OSRV-TIME () 
    VHTR01IW.TIME-INSRV-HH-Y = VHTR01IW-PASSVALUE.TIME-INSRV-X-HH;
    VHTR01IW.TIME-INSRV-MM-Y = VHTR01IW-PASSVALUE.TIME-INSRV-X-MM;
    VHTR01IW.TIME-OUTSRV-HH-Y = VHTR01IW.TIME-OUTSRV-HH-X;
    VHTR01IW.TIME-OUTSRV-MM-Y = VHTR01IW.TIME-OUTSRV-MM-X;
    if (TIME-OUTSRV-HH-Y >= 00 &&
     TIME-OUTSRV-HH-Y <= 02)
        TIME-OUTSRV-HH-Y = TIME-OUTSRV-HH-Y + 24;
    end
    if (TIME-INSRV-HH-Y >= 00 &&
     TIME-INSRV-HH-Y <= 02)
        TIME-INSRV-HH-Y = TIME-INSRV-HH-Y + 24;
    end
    if (TIME-OUTSRV-HH-Y < TIME-INSRV-HH-Y)
        VHTR01IW-TRIGGER.TIME-OUT-ERROR = "Y";
        VHTR01IW-TRIGGER.CON-ERROR = "Y";
        VHTR01IW-TRIGGER.TIME-OUT-ERR = "Y";
    else
        if (TIME-OUTSRV-HH-Y == TIME-INSRV-HH-Y)
            if (TIME-OUTSRV-MM-Y < TIME-INSRV-MM-Y)
                VHTR01IW-TRIGGER.TIME-OUT-ERROR = "Y";
                VHTR01IW-TRIGGER.CON-ERROR = "Y";
                VHTR01IW-TRIGGER.TIME-OUT-ERR = "Y";
            end
        end
    end
end 

Function VHTR01IS-OTIME ()
  
  
  
   
    VHTR01IW-PASSVALUE.TIME-INSRV = VHTR011_DATA.TIME-INSRV;
    
  
  
    VHTR01IS-RUN-TIME();
    VHTR01IS-VALD-CAR();
    VHTR01IS-UPD-CON();
end 

Function VHTR01IS-PM-HRS () 
    VHTR01IW-PASSVALUE.HRS-FROM-LAST-PM = VHTR01IW-PASSVALUE.HRS-FROM-LAST-PM + DIFF-HH;
    if (DIFF-MM > 29)
        VHTR01IW-PASSVALUE.HRS-FROM-LAST-PM = VHTR01IW-PASSVALUE.HRS-FROM-LAST-PM + 1;
    end
    VHTR01IW-PASSVALUE.HRS-TO-NEXT-PM = VHTR01IW-PASSVALUE.HRS-TO-NEXT-PM-MAX - VHTR01IW-PASSVALUE.HRS-FROM-LAST-PM;
end 

Function VHTR01IS-PSEUDO () 
    XXEXT_CALL_Level77Items.UEXTNAM = "VHTR01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHTR014";

 
    
    try
        call "VHTR014"(XDCONTROL, VHTR014_CRIT, VHTR014_DATA);
    
    end
    

  
    MRSCommonCode.XXA0IS-CHECK_EXT();

  
    if (XXEXT_CALL_Level77Items.URC == 0)
    
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHTR014_CRIT.NO-RECORD-FOUND != "Y")
                VHTR01IW.NEW-PSEUDO-CON-NO = VHTR014_CRIT.CON-NO;
                VHTR016_CRIT-PSEU.PSEUDO-CON-NO-OLD = VHTR014_CRIT.CON-NO;
                VHTR01IW-PASSVALUE.RIGHT-CON-SIZE = XDCONTROL.UROWCNT;
                VHTR01IS-MOVE-PSEX();
                VHTR01IS-VALD-LR4();
            else
                VHTR01IW-CON-MSG.CON-MSG-1 = "The train no.xxx not valid pseudo train";
                VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
                VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
            end
        else
            if (VHTR014_CRIT.NO-RECORD-FOUND == "Y")
                VHTR01IW-CON-MSG.CON-MSG-1 = "The train no.xxx is not valid pseudo train";
                VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
                VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
            end
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHTR01IS-RECONFIG () 
    VHTR01IS-CLEAR-MSG();
    VHTR01IS-VALID-TME();
    if (VHTR01IW.CON-NO == " ")
        VHTR01IW-CON-MSG.CON-MSG-1 = "Consist cannot be blank";
        VHTR01IW-TRIGGER.CON-ERROR = "Y";
    end
    if (VHTR01IW.YARD-LOC == " ")
        VHTR01IW-CON-MSG.CON-MSG-1 = "Location cannot be blank";
        VHTR01IW-TRIGGER.YARD-ERROR = "Y";
    end
    if (VHTR01IW.YARD-SUB-LOC == " ")
        VHTR01IW-CON-MSG.CON-MSG-1 = "Transfer/Storage Tack cannot be blank";
        VHTR01IW-TRIGGER.YARD-ERROR = "Y";
    end
    VHTR01IS-VALID-CAR();
    if (VHTR01IW-TRIGGER.CON-ERROR != "Y" &&
     VHTR01IW-TRIGGER.YARD-ERROR != "Y" &&
     VHTR01IW-TRIGGER.TIME-ERROR-X != "Y" &&
     VHTR01IW-TRIGGER.CAR-ERROR != "Y")
        VHTR01IW-TRIGGER.OPEN-POP-UP = "Y";
    end
end 

Function VHTR01IS-RIGHT-CON () 
    if (VHTR01IW.SERVICE-ACTION-IDX == 1)
        VHTR01IW.NEW-PSEUDO-CON-NO = VHTR01IW.RIGHT-CON-NO;
    end
end 

Function VHTR01IS-RUN-TIME ()
  
  
   
    VHTR01IW-PASSVALUE.WS-TIME-OUTSRV-HH = VHTR01IW.TIME-OUTSRV-HH;
    VHTR01IW-PASSVALUE.WS-TIME-OUTSRV-MM = VHTR01IW.TIME-OUTSRV-MM;
    VHTR01IW-PASSVALUE.WS-TIME-OUTSRV-SS = VHTR01IW.TIME-OUTSRV-SS;
    VHTR01IW-PASSVALUE.WS-TIME-INSRV-HH = VHTR01IW-PASSVALUE.TIME-INSRV-HH;
    VHTR01IW-PASSVALUE.WS-TIME-INSRV-MM = VHTR01IW-PASSVALUE.TIME-INSRV-MM;
    VHTR01IW-PASSVALUE.WS-TIME-INSRV-SS = VHTR01IW-PASSVALUE.TIME-INSRV-SS;
    if (VHTR01IW-PASSVALUE.WS-TIME-OUTSRV-HH <
     VHTR01IW-PASSVALUE.TIME-REV-START-HH)
        WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 24;
    else
        if (VHTR01IW-PASSVALUE.WS-TIME-OUTSRV-HH ==
         VHTR01IW-PASSVALUE.TIME-REV-START-HH && WS-TIME-OUTSRV-MM < TIME-REV-START-MM)
            WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 24;
        end
    end
    if (VHTR01IW-PASSVALUE.WS-TIME-INSRV-HH <
     VHTR01IW-PASSVALUE.TIME-REV-START-HH)
        WS-TIME-INSRV-HH = WS-TIME-INSRV-HH + 24;
    else
        if (VHTR01IW-PASSVALUE.WS-TIME-INSRV-HH ==
         VHTR01IW-PASSVALUE.TIME-REV-START-HH && WS-TIME-INSRV-MM < TIME-REV-START-MM)
            WS-TIME-INSRV-HH = WS-TIME-INSRV-HH + 24;
        end
    end
    if (VHTR01IW-PASSVALUE.WS-TIME-OUTSRV-MM <
     VHTR01IW-PASSVALUE.WS-TIME-INSRV-MM)
        WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM + 60;
        WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH - 1;
    end
    if (WS-TIME-OUTSRV-HH >= WS-TIME-INSRV-HH)
        DIFF-HH = WS-TIME-OUTSRV-HH - WS-TIME-INSRV-HH;
        DIFF-MM = WS-TIME-OUTSRV-MM - WS-TIME-INSRV-MM;
    else
        if (WS-TIME-OUTSRV-HH < WS-TIME-INSRV-HH)
            if (WS-TIME-OUTSRV-MM > 59)
                WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM - 60;
                WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 1;
            end
            if (WS-TIME-INSRV-MM < WS-TIME-OUTSRV-MM)
                WS-TIME-INSRV-MM = WS-TIME-INSRV-MM + 60;
                WS-TIME-INSRV-HH = WS-TIME-INSRV-HH - 1;
            end
            DIFF-HH = WS-TIME-OUTSRV-HH - WS-TIME-INSRV-HH;
            DIFF-MM = WS-TIME-OUTSRV-MM - WS-TIME-INSRV-MM;
            DIFF-HH = DIFF-HH * -1;
            DIFF-MM = DIFF-MM * -1;
        end
    end
    VHTR01IW-CON-MSG.CON-MSG-HH = DIFF-HH;
    VHTR01IW-CON-MSG.CON-MSG-MM = DIFF-MM;
end 

Function VHTR01IS-SPLIT () 

end 

Function VHTR01IS-SPLIT-TME ()
  
  
  
  
   
    VHTR01IW-PASSVALUE.WS-TIME-END-CAR-HH = VHTR01IW-PASSVALUE.TIME-END-CAR-HH;
    VHTR01IW-PASSVALUE.WS-TIME-END-CAR-MM = VHTR01IW-PASSVALUE.TIME-END-CAR-MM;
    VHTR01IW-PASSVALUE.WS-TIME-END-CAR-SS = VHTR01IW-PASSVALUE.TIME-END-CAR-SS;
  
  
  
    VHTR01IW-PASSVALUE.WS-TIME-INSRV-HH = VHTR01IW-PASSVALUE.TIME-INSRV-HH;
    VHTR01IW-PASSVALUE.WS-TIME-INSRV-MM = VHTR01IW-PASSVALUE.TIME-INSRV-MM;
    VHTR01IW-PASSVALUE.WS-TIME-INSRV-SS = VHTR01IW-PASSVALUE.TIME-INSRV-SS;
  
    if (VHTR01IW-PASSVALUE.WS-TIME-OUTSRV-MM <
     VHTR01IW-PASSVALUE.WS-TIME-END-CAR-MM)
        WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM + 60;
        WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH - 1;
    end
    if (WS-TIME-OUTSRV-HH >= WS-TIME-END-CAR-HH)
        DIFF-HH-SPLIT-END = WS-TIME-OUTSRV-HH - WS-TIME-END-CAR-HH;
        DIFF-MM-SPLIT-END = WS-TIME-OUTSRV-MM - WS-TIME-END-CAR-MM;
    else
        if (WS-TIME-OUTSRV-HH < WS-TIME-END-CAR-HH)
            if (WS-TIME-OUTSRV-MM > 59)
                WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM - 60;
                WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 1;
            end
            if (WS-TIME-END-CAR-MM < WS-TIME-OUTSRV-MM)
                WS-TIME-END-CAR-MM = WS-TIME-END-CAR-MM + 60;
                WS-TIME-END-CAR-HH = WS-TIME-END-CAR-HH - 1;
            end
            DIFF-HH-SPLIT-END = WS-TIME-OUTSRV-HH - WS-TIME-END-CAR-HH;
            DIFF-MM-SPLIT-END = WS-TIME-OUTSRV-MM - WS-TIME-END-CAR-MM;
            
  
  
        end
    end
  
  
  
  
  
  
    if (VHTR01IW-PASSVALUE.WS-TIME-END-CAR-MM <
     VHTR01IW-PASSVALUE.WS-TIME-INSRV-MM)
        WS-TIME-END-CAR-MM = WS-TIME-END-CAR-MM + 60;
        WS-TIME-END-CAR-HH = WS-TIME-END-CAR-HH - 1;
    end
  
    if (WS-TIME-END-CAR-HH >= WS-TIME-INSRV-HH)
  
        DIFF-HH-SPLIT-MID = WS-TIME-END-CAR-HH - WS-TIME-INSRV-HH;
  
        DIFF-MM-SPLIT-MID = WS-TIME-END-CAR-MM - WS-TIME-INSRV-MM;
    else
  
        if (WS-TIME-END-CAR-HH < WS-TIME-INSRV-HH)
            if (WS-TIME-INSRV-MM > 59)
                WS-TIME-INSRV-MM = WS-TIME-INSRV-MM - 60;
                WS-TIME-INSRV-HH = WS-TIME-INSRV-HH + 1;
            end
            if (WS-TIME-END-CAR-MM < WS-TIME-INSRV-MM)
                WS-TIME-END-CAR-MM = WS-TIME-END-CAR-MM + 60;
                WS-TIME-END-CAR-HH = WS-TIME-END-CAR-HH - 1;
            end
  
            DIFF-HH-SPLIT-MID = WS-TIME-END-CAR-HH - WS-TIME-INSRV-HH;
  
            DIFF-MM-SPLIT-MID = WS-TIME-END-CAR-MM - WS-TIME-INSRV-MM;
            DIFF-HH-SPLIT-END = DIFF-HH * -1;
            
  
        end
    end
end 

Function VHTR01IS-SRV-ACT () 
    if (VHTR01IW.SERVICE-ACTION-IDX == 1)
        VHTR01IW-TRIGGER.DISABLE-SPLIT = "Y"; 
        VHTR01IW-TRIGGER.ENABLE-PSEUDO = "Y";
    end
    if (VHTR01IW.SERVICE-ACTION-IDX == 2)
        VHTR01IW-TRIGGER.DISABLE-PSEUDO = "Y";
        VHTR01IW-TRIGGER.ENABLE-SPLIT = "Y";
    end
end 

Function VHTR01IS-STATUS () 
    if (VHTR01IW-PASSVALUE.VEH-STAT == "ERROR")
        VHTR01IW-PASSVALUE.VEH-STAT = VHTR01IW-PASSVALUE.VEH-STAT-PREV;
        VHTR01IW-PASSVALUE.VEH-STAT-PREV = " ";
        VHTR01IW-PASSVALUE.STAT-CHG-SW = "Y";
    else
        if (VHTR01IW-PASSVALUE.VEH-STAT == "USABLE")
            VHTR01IS-INCD-STAT();
            VHTR01IW-PASSVALUE.VEH-STAT-PREV = VHTR01IW-PASSVALUE.VEH-STAT;
            VHTR01IW-PASSVALUE.VEH-STAT = "NO GO";
            VHTR01IW-PASSVALUE.STAT-CHG-SW = "Y";
            VHTR01IW-PASSVALUE.NO-GO-IND = "Y";
        else
            VHTR01IW-PASSVALUE.STAT-CHG-SW = "N";
            VHTR01IS-CHK-DVS();
        end
    end
end 

Function VHTR01IS-SVC-HIST ()
   
    if (VHTR01IW-TRIGGER.YES-SPLIT == "Y")
        END-CAR-HRS-HIST = END-CAR-HRS-HIST + DIFF-HH-SPLIT-END;
        END-CAR-MIN-HIST = END-CAR-MIN-HIST + DIFF-MM-SPLIT-END;
        if (END-CAR-MIN-HIST > 59)
            END-CAR-HRS-HIST = END-CAR-HRS-HIST + 1;
            END-CAR-MIN-HIST = END-CAR-MIN-HIST - 60;
        end
        MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + DIFF-HH-SPLIT-MID;
        MID-CAR-MIN-HIST = MID-CAR-MIN-HIST + DIFF-MM-SPLIT-MID;
        if (MID-CAR-MIN-HIST > 59)
            MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + 1;
            MID-CAR-MIN-HIST = MID-CAR-MIN-HIST - 60;
        end
    else
        if (END-CAR-SW == "Y")
            END-CAR-HRS-HIST = END-CAR-HRS-HIST + DIFF-HH;
            END-CAR-MIN-HIST = END-CAR-MIN-HIST + DIFF-MM;
            if (END-CAR-MIN-HIST > 59)
                END-CAR-HRS-HIST = END-CAR-HRS-HIST + 1;
                END-CAR-MIN-HIST = END-CAR-MIN-HIST - 60;
            end
        end
        if (MID-CAR-SW == "Y")
            MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + DIFF-HH;
            MID-CAR-MIN-HIST = MID-CAR-MIN-HIST + DIFF-MM;
            if (MID-CAR-MIN-HIST > 59)
                MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + 1;
                MID-CAR-MIN-HIST = MID-CAR-MIN-HIST - 60;
            end
        end
    end
end 

Function VHTR01IS-SVC-HIT1 () 
    VHTR01IW-SVR-REC.CURR-CAR-HRS = VHTR01IW-SVR-REC.CURR-CAR-HRS + DIFF-HH;
    VHTR01IW-SVR-REC.CURR-CAR-MIN = VHTR01IW-SVR-REC.CURR-CAR-MIN + DIFF-MM;
    if (VHTR01IW-SVR-REC.CURR-CAR-MIN > 59)
        VHTR01IW-SVR-REC.CURR-CAR-HRS = VHTR01IW-SVR-REC.CURR-CAR-HRS + 1;
        VHTR01IW-SVR-REC.CURR-CAR-MIN = VHTR01IW-SVR-REC.CURR-CAR-MIN - 60;
    end
end 

Function VHTR01IS-TIME () 
    try
        call "VHTR012"(XDCONTROL, VHTR012_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHTR01IW.TIME-OUTSRV = VHTR012_DATA.CURRENT-TIME;
    end
end 

Function VHTR01IS-TIME-MSG () 
    if (VHTR01IW-TRIGGER.TIME-NOT-NUMERIC == "Y")
        VHTR01IW-TIME-MSG.MSG-1 = "TIME OUT OF SERVICE SHOULD BE NUMERIC";
        VHTR01IW-TRIGGER.TIME-NOT-NUMERIC = " ";
    end
    if (VHTR01IW-TRIGGER.TIME-OUT-RANGE == "Y")
        VHTR01IW-TIME-MSG.MSG-1 = "TIME HOURS SHOULD BETWEEN 00-23, TIME MINUTES SHOULD BETWEEN 00-59";
        VHTR01IW-TRIGGER.TIME-OUT-RANGE = " ";
    end
    if (VHTR01IW-TRIGGER.TIME-ERROR == "Y")
        VHTR01IW-TIME-MSG.MSG-1 = "TIME OUT OF SERVICE SHOULD NOT BE BLANK";
        VHTR01IW-TRIGGER.TIME-ERROR = " ";
    end
    if (VHTR01IW-TRIGGER.TIME-OUT-ERROR == "Y")
        VHTR01IW-TIME-MSG.MSG-3 = "Out-of-Service time must be greater than In-Service time";
        VHTR01IW-TIME-MSG.MSG-3-XX-1 = VHTR01IW.TIME-INSRV-HH-Y;
        VHTR01IW-TIME-MSG.MSG-3-XX-2 = ":";
        VHTR01IW-TIME-MSG.MSG-3-XX-3 = VHTR01IW.TIME-INSRV-MM-Y;
        VHTR01IW-TIME-MSG.MSG-1 = VHTR01IW-TIME-MSG.MSG-3;
        VHTR01IW-TRIGGER.TIME-OUT-ERROR = " ";
    end
    if (VHTR01IW-TRIGGER.MADE-IN-ERROR-SW == "Y")
        VHTR01IW-TIME-MSG.MSG-1 = "MADE IN ERROR SHOULD BE Y OR N";
        VHTR01IW-TRIGGER.MADE-IN-ERROR-SW = " ";
    end
    if (VHTR01IW-TRIGGER.YARD-LOC-BLANK == "Y")
        VHTR01IW-TIME-MSG.MSG-1-XX = "-LOC INVALID";
        VHTR01IW-TIME-MSG.MSG-1-X = VHTR01IW.YARD-LOC;
        VHTR01IW-TRIGGER.YARD-LOC-BLANK = " ";
    end
    if (VHTR01IW-TRIGGER.YARD-SUB-LOC-BLANK == "Y")
        VHTR01IW-TIME-MSG.MSG-1-XX = "-TRANSFER/STORAGE TRACK INVALID";
        VHTR01IW-TIME-MSG.MSG-1-X = VHTR01IW.YARD-LOC;
        VHTR01IW-TRIGGER.YARD-SUB-LOC-BLANK = " ";
    end
end 

