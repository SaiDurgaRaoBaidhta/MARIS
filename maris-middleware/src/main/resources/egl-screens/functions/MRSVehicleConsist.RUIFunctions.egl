            VHCM01IW-PASS-RIGH.CAR-NO-1-HOME-YRD = VHCM014_DATA.HOME-YRD[1];
            VHCM01IW-PASS-RIGH.DATE-END-CAR-REV-1 = VHCM014_DATA.DATE-END-CAR-REV[1];
            VHCM01IW-PASS-RIGH.TIME-END-CAR-1 = VHCM014_DATA.TIME-END-CAR[1];
            VHCM01IW-PASS-RIGH.CAR-NO-1-VEH-STAT-PREV = VHCM014_DATA.VEH-STAT-PREV[1];
            VHCM01IW-PASS-RIGH.CAR-NO-1-HOME-YRD = VHCM014_DATA.HOME-YRD[1];
            VHCM01IW-PASS-RIGH.DATE-END-CAR-REV-1 = VHCM014_DATA.DATE-END-CAR-REV[1];
            VHCM01IW-PASS-RIGH.TIME-END-CAR-1 = VHCM014_DATA.TIME-END-CAR[1];
            VHCM01IW-PASS-RIGH.ATO-PRESENT-IND-CAR-1 = VHCM014_DATA.ATO-PRESENT-IND[1];
            VHCM01IW-PASS-RIGH.TRAIN-INCD-IND-CAR-1 = VHCM014_DATA.TRAIN-INCD-IND[1];
  
            VHCM01IW-PASS-RIGH.ORIENTATION-1 = VHCM014_DATA.VAGen_ORIENTATION[1];
            VHCM015_CRIT-VEH-R.ORIENTATION-1 = VHCM014_DATA.VAGen_ORIENTATION[1];
            if (VHCM014_DATA.VAGen_ORIENTATION[VHCM01IW-PASS-RIGH.COUNTER] ==
             VHCM014_DATA.LFT-ORIENTATION-CD[VHCM01IW-PASS-RIGH.COUNTER])
                VHCM01IW-PASS-RIGH.CAR-NO-1-LFT-ORIENT = VHCM014_DATA.VAGen_ORIENTATION[VHCM01IW-PASS-RIGH.COUNTER];
                VHCM01IW-PASS-RIGH.CAR-NO-1-RGT-ORIENT = " ";
            else
                if (VHCM014_DATA.VAGen_ORIENTATION[VHCM01IW-PASS-RIGH.COUNTER] ==
                 VHCM014_DATA.RGT-ORIENTATION-CD[VHCM01IW-PASS-RIGH.COUNTER])
