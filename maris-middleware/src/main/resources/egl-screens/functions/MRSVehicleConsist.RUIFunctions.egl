Function VHCC01IS-PROCESS () 
    VHCC01IS-VALID-COX();
    VHCC01IS-VALID-CAR();
    if (VHCC01IW-TRIGGER.CAR-ERROR == "N")
        VHCC01IS-UPD-CON();
        try



        end
        if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
            VHCC01IW-TRIGGER.COMPLETE-CC = "Y";
            
  
  
            VHCC01IS-CLEAR();
        end
    end
end 

Function VHCC01IS-RE-VALID () 
    VHCC015_CRIT.CON-NO = VHCC011_CRIT.CON-NO;
    try
        call "VHCC015"(XDCONTROL, VHCC015_CRIT, VHCC015_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
  
        RE-VALID-CNT = 1;
        
  
        while (VHCC01IW-TRIGGER.RE-VALID-CNT <= 20)
            if (VHCC015_DATA.CON-SIZE[RE-VALID-CNT] ==
             VHCC011_DATA.CON-SIZE[RE-VALID-CNT] &&
             VHCC015_DATA.CAR-NO[RE-VALID-CNT] ==
             VHCC011_DATA.CAR-NO[RE-VALID-CNT] &&
             VHCC015_DATA.CAR-ORDER[RE-VALID-CNT] ==
             VHCC011_DATA.CAR-ORDER[RE-VALID-CNT] &&
             VHCC015_DATA.WHERE-IS-CAR[RE-VALID-CNT] ==
             VHCC011_DATA.WHERE-IS-CAR[RE-VALID-CNT])
                RE-VALID-CNT = RE-VALID-CNT + 1;
            else
                RE-VALID-SW = "Y";
                RE-VALID-SW-CAR = "Y";
                return;
            end
        end
    else
        RE-VALID-SW = "Y";
        RE-VALID-SW-CAR = "Y";
    end
end 

Function VHCC01IS-RETURN () 
    VHCC01IW-TRIGGER.RETURN-SW = "Y";
end 

Function VHCC01IS-TEXT () 
    CLEAR-SW = "N";
    RETURN-SW = "N";
    if (VHCC01IW.CON-NO != " ")
        VHCC01IW-TRIGGER.RUN-VALID-CON = "Y";
        set VHCC01IW-CON-MSG empty;
        
  
  
  
  
    end
end 

