Function VHCC01IS-CHK-SAME () 
    SAME-OLD-CAR = "N";
    SAME-OLD-COUNT = 1;
    while (SAME-OLD-COUNT <= VHCC011_DATA.CON-SIZE[1])
        if (VHCC01IW-PASSVALUE.CAR-NO-NEW == VHCC011_DATA.CAR-NO[SAME-OLD-COUNT])
            SAME-OLD-CAR = "Y";
        end
        SAME-OLD-COUNT = SAME-OLD-COUNT + 1;
    end
end 

