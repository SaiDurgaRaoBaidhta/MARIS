            VHCM01IW-PASS-RIGH.CAR-NO-1-END-MIN = VHCM014_DATA.END-CAR-MIN[1];
            VHCM01IW-PASS-RIGH.CAR-NO-1-MID-HRS = VHCM014_DATA.MID-CAR-HRS[1];
