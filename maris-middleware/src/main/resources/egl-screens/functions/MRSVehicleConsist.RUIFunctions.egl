    VHCC01IW-WS-MSG.MESSAGES-X[20] = "r";
    VHCC01IS-MSG-RT();
end 

Function VHCC01IS-UPD-CON ()
  
  
  
  
  
  
  
  
  
   
    VHCC013_CRIT.DASH-NO = VHCC011_DATA.DASH-NO[1];
    VHCC013_CRIT.CON-NO = VHCC01IW.CON-NO;
    VHCC013_CRIT.DATE-INSRV-REV = VHCC011_DATA.DATE-INSRV-REV[1];
    VHCC013_CRIT.TIME-INSRV = VHCC011_DATA.TIME-INSRV[1];
    VHCC013_CRIT.DATE-INSRV = VHCC011_DATA.DATE-INSRV[1];
    VHCC013_CRIT.CON-NO = VHCC01IW.CON-NO;
    VHCC013_CRIT.CON-SIZE-OLD = VHCC011_DATA.CON-SIZE[1];
    VHCC013_CRIT.CURR-LOC-OLD = VHCC011_DATA.ORGIN-LOC[1];
    VHCC01IS-CURR-LOC();
  
    if (VHCC01IW-TRIGGER.LAST-CAR-2 == "Y")
        VHCC013_CRIT.CON-SIZE = 2;
    else
        if (VHCC01IW-TRIGGER.LAST-CAR-3 == "Y")
            VHCC013_CRIT.CON-SIZE = 3;
        else
