Function VHTR01IS-MV-RIGHTX ()

   
    if ((VHSC2A1_DATA.CAR-TYPE[2] == "C1" || VHSC2A1_DATA.CAR-TYPE[2] == "C2") &&
        (VHSC2A1_DATA.CAR-TYPE[1] == "C1" ||   VHSC2A1_DATA.CAR-TYPE[1] == "C2" ) || 
     (VHSC2A1_DATA.CAR-TYPE[2] == "D1"  &&  VHSC2A1_DATA.CAR-TYPE[1] == "D1")     || 
     (VHSC2A1_DATA.CAR-TYPE[2] == "L1"  &&  VHSC2A1_DATA.CAR-TYPE[1] == "L1") )  
        VHTR01W_DATA-SC.VALID-FIRST-CAR = "Y";
    else
        VHTR01W-MSG-SC.MSG = "Split only between 1.{C1,C2}, 2.{D1}, 3.{L1}";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
        CLICK-COUNT = 0;
        return;
    end

  
    VHTR01W-MSG-SC.NEW-CON-SIZE = VHTR011_DATA.CON-SIZE - VHTR01W-MSG-SC.CAR-POS-1;
    if (VHTR01W-MSG-SC.NEW-CON-SIZE >= 2)

    else
        VHTR01W-MSG-SC.MSG = "Consist is not at least 2 cars long";
        VHTR01W_DATA-SC.VALID-FIRST-CAR = "N";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
        CLICK-COUNT = 0;
    end
    if (VHTR01W_DATA-SC.VALID-FIRST-CAR == "Y")
        CLICK-COUNT = 1;

    
        VHTR01W_DATA-SC.RIGHT-CON-SIZE = VHTR01W-MSG-SC.NEW-CON-SIZE;
        VHTR01W_DATA-SC.LEFT-CON-SIZE = VHTR011_DATA.CON-SIZE - VHTR01W_DATA-SC.RIGHT-CON-SIZE;

    
        IND = VHTR01W-MSG-SC.CAR-POS;
        VHTR01W-NEW-RIGHT.CAR-NO-1 = VHTR011_DATA.CAR-NO[IND];
        VHTR01W-NEW-RIGHT.CAR-ORDER1 = 1;
        VHTR01W-NEW-RIGHT.CAR-ORIENT1 = VHTR011_DATA.VAGen_ORIENTATION[IND];
        VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-1 = " ";
        VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-1 = " ";
        if (VHTR01W-NEW-RIGHT.CAR-ORIENT1 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
            VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-1 = VHTR01W-NEW-RIGHT.CAR-ORIENT1;
        else
            if (VHTR01W-NEW-RIGHT.CAR-ORIENT1 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-1 = VHTR01W-NEW-RIGHT.CAR-ORIENT1;
            end
        end
        IND = IND + 1;
        RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        VHTR01W-NEW-RIGHT.CAR-NO-2 = VHTR011_DATA.CAR-NO[IND];
        VHTR01W-NEW-RIGHT.CAR-ORDER2 = 2;
        VHTR01W-NEW-RIGHT.CAR-ORIENT2 = VHTR011_DATA.VAGen_ORIENTATION[IND];
        VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-2 = " ";
        VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-2 = " ";
        if (VHTR01W-NEW-RIGHT.CAR-ORIENT2 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
            VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-2 = VHTR01W-NEW-RIGHT.CAR-ORIENT2;
        else
            if (VHTR01W-NEW-RIGHT.CAR-ORIENT2 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-2 = VHTR01W-NEW-RIGHT.CAR-ORIENT2;
            end
        end
        IND = IND + 1;
        RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        if (IND <= 10)
            VHTR01W-NEW-RIGHT.CAR-NO-3 = VHTR011_DATA.CAR-NO[IND];
            VHTR01W-NEW-RIGHT.CAR-ORDER3 = 3;
            VHTR01W-NEW-RIGHT.CAR-ORIENT3 = VHTR011_DATA.VAGen_ORIENTATION[IND];
            VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-3 = " ";
            VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-3 = " ";
            if (VHTR01W-NEW-RIGHT.CAR-ORIENT3 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-3 = VHTR01W-NEW-RIGHT.CAR-ORIENT3;
            else
                if (VHTR01W-NEW-RIGHT.CAR-ORIENT3 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                    VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-3 = VHTR01W-NEW-RIGHT.CAR-ORIENT3;
                end
            end
            IND = IND + 1;
            RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        end
        if (IND <= 10)
            VHTR01W-NEW-RIGHT.CAR-NO-4 = VHTR011_DATA.CAR-NO[IND];
            VHTR01W-NEW-RIGHT.CAR-ORDER4 = 4;
            VHTR01W-NEW-RIGHT.CAR-ORIENT4 = VHTR011_DATA.VAGen_ORIENTATION[IND];
            VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-4 = " ";
            VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-4 = " ";
            if (VHTR01W-NEW-RIGHT.CAR-ORIENT4 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-4 = VHTR01W-NEW-RIGHT.CAR-ORIENT4;
            else
                if (VHTR01W-NEW-RIGHT.CAR-ORIENT4 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                    VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-4 = VHTR01W-NEW-RIGHT.CAR-ORIENT4;
                end
            end
            IND = IND + 1;
            RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        end
        if (IND <= 10)
            VHTR01W-NEW-RIGHT.CAR-NO-5 = VHTR011_DATA.CAR-NO[IND];
            VHTR01W-NEW-RIGHT.CAR-ORDER5 = 5;
            VHTR01W-NEW-RIGHT.CAR-ORIENT5 = VHTR011_DATA.VAGen_ORIENTATION[IND];
            VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-5 = " ";
            VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-5 = " ";
            if (VHTR01W-NEW-RIGHT.CAR-ORIENT5 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-5 = VHTR01W-NEW-RIGHT.CAR-ORIENT5;
            else
                if (VHTR01W-NEW-RIGHT.CAR-ORIENT5 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                    VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-5 = VHTR01W-NEW-RIGHT.CAR-ORIENT5;
                end
            end
            IND = IND + 1;
            RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        end
        if (IND <= 10)
            VHTR01W-NEW-RIGHT.CAR-NO-6 = VHTR011_DATA.CAR-NO[IND];
            VHTR01W-NEW-RIGHT.CAR-ORDER6 = 6;
            VHTR01W-NEW-RIGHT.CAR-ORIENT6 = VHTR011_DATA.VAGen_ORIENTATION[IND];
            VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-6 = " ";
            VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-6 = " ";
            if (VHTR01W-NEW-RIGHT.CAR-ORIENT6 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-6 = VHTR01W-NEW-RIGHT.CAR-ORIENT6;
            else
                if (VHTR01W-NEW-RIGHT.CAR-ORIENT6 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                    VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-6 = VHTR01W-NEW-RIGHT.CAR-ORIENT6;
                end
            end
            IND = IND + 1;
            RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        end
        if (IND <= 10)
            VHTR01W-NEW-RIGHT.CAR-NO-7 = VHTR011_DATA.CAR-NO[IND];
            VHTR01W-NEW-RIGHT.CAR-ORDER7 = 7;
            VHTR01W-NEW-RIGHT.CAR-ORIENT7 = VHTR011_DATA.VAGen_ORIENTATION[IND];
            VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-7 = " ";
            VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-7 = " ";
            if (VHTR01W-NEW-RIGHT.CAR-ORIENT7 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-7 = VHTR01W-NEW-RIGHT.CAR-ORIENT7;
            else
                if (VHTR01W-NEW-RIGHT.CAR-ORIENT7 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                    VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-7 = VHTR01W-NEW-RIGHT.CAR-ORIENT7;
                end
            end
            IND = IND + 1;
            RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        end
        if (IND <= 10)
            VHTR01W-NEW-RIGHT.CAR-NO-8 = VHTR011_DATA.CAR-NO[IND];
            VHTR01W-NEW-RIGHT.CAR-ORDER8 = 8;
            VHTR01W-NEW-RIGHT.CAR-ORIENT8 = VHTR011_DATA.VAGen_ORIENTATION[IND];
            VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-8 = " ";
            VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-8 = " ";
            if (VHTR01W-NEW-RIGHT.CAR-ORIENT8 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHTR01W-NEW-RIGHT.CAR-LEFT-ORIENT-8 = VHTR01W-NEW-RIGHT.CAR-ORIENT8;
            else
                if (VHTR01W-NEW-RIGHT.CAR-ORIENT8 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                    VHTR01W-NEW-RIGHT.CAR-RIGHT-ORIENT-8 = VHTR01W-NEW-RIGHT.CAR-ORIENT8;
                end
            end
        end
        if (VHTR01IW-TRIGGER.DISABLE-RECONFIG-X != "Y")
            VHTR01IS-BLANK-CAR();
        end
    end
end 

