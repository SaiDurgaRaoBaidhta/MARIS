        VHMT01IW-WS-MSG.MESSAGES-X[3] = TIME-MESSAGE-X[3];
        VHMT01IW-WS-MSG.MESSAGES-X[4] = TIME-MESSAGE-X[4];
        VHMT01IW-WS-MSG.MESSAGES-X[5] = TIME-MESSAGE-X[5];
        VHMT01IW-WS-MSG.MESSAGES-X[6] = "-";
        VHMT01IW-WS-MSG.MESSAGES-X[7] = "M";
        VHMT01IW-WS-MSG.MESSAGES-X[8] = "U";
        VHMT01IW-WS-MSG.MESSAGES-X[9] = "S";
        VHMT01IW-WS-MSG.MESSAGES-X[10] = "T";
        VHMT01IW-WS-MSG.MESSAGES-X[11] = " ";
        VHMT01IW-WS-MSG.MESSAGES-X[12] = "B ";
        VHMT01IW-WS-MSG.MESSAGES-X[13] = "E";
        VHMT01IW-WS-MSG.MESSAGES-X[14] = " ";
