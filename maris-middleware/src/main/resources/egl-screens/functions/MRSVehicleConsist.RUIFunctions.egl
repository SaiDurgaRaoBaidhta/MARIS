                    VHTR01IW-LEFT-CON.VEH-STAT-1 = VHTR01IW.VEH-STAT-1;
                    VHTR01IW-LEFT-CON.VEH-STAT-2 = VHTR01IW.VEH-STAT-2;
                    VHTR01IW-LEFT-CON.VEH-STAT-3 = VHTR01IW.VEH-STAT-3;
                    VHTR01IW-LEFT-CON.VEH-STAT-4 = VHTR01IW.VEH-STAT-4;
                    VHTR01IW-LEFT-CON.VEH-STAT-5 = VHTR01IW.VEH-STAT-5;
                    VHTR01IW-LEFT-CON.VEH-STAT-6 = VHTR01IW.VEH-STAT-6;
