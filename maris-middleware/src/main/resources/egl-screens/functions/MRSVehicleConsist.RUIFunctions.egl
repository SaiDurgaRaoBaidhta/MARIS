                     VHCM01IW-1.CAR-TYPE[4] == "C2" ||
                     VHCM01IW-1.CAR-TYPE[4] == "D1" ||
                     VHCM01IW-1.CAR-TYPE[4] == "L1") &&
                     (VHCM01IW-1.ATO-PRESENT-IND[4] != "Y"))
