            move COUNTERX to COUNTERXX withV60Compat;
            COUNTERX = 1;
            while ((VHTR01IW-PASSVALUE.COUNTERX <= VHTR01IW-PASSVALUE.LEFT-CON-SIZE))
                if (VHTR01IW-PASSVALUE.COUNTERX == 1)
