    VHCM01IW-PASSVALUE.CAR-NO = VHCM01IW-PASSVALUE.CAR-NO-5;
    VHCM01IW-PASSVALUE.NO-GO-IND = "N";
    VHCM01IS-STATUS();
  
    if (VHCM01IW-PASSVALUE.PSEUDO-CAR-5-SW == "Y")
        if (VHCM01IW-PASSVALUE.VEH-STAT != "GO" &&
         VHCM01IW-PASSVALUE.VEH-STAT != "USABLE" &&
         VHCM01IW-PASSVALUE.VEH-STAT != "ERROR")
            VHCM01IW-STATUS.CAR-STATUS-5 = VHCM01IW-PASSVALUE.VEH-STAT;
            VHCM01IW-TRIGGER.CAR10-NO-GO = "Y";
            VHCM01IW-TRIGGER.CAR-ERROR = "Y";
            VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 5 PSEUDO VEH-STAT ERROR";
        end
    end
    VHCM01IW-PASSVALUE.CAR-NO-5-NO-GO = VHCM01IW-PASSVALUE.NO-GO-IND;
    if (VHCM01IW-PASSVALUE.STAT-CHG-SW == "Y")
        VHCM01IW-PASSVALUE.CAR-NO-5-STAT-CHG = "Y";
    else
        VHCM01IW-PASSVALUE.CAR-NO-5-STAT-CHG = "N";
    end
    VHCM01IW-PASSVALUE.CAR-NO-5-VEH-STAT = VHCM01IW-PASSVALUE.VEH-STAT;
    VHCM01IW-PASSVALUE.CAR-NO-5-VEH-STAT-PREV = VHCM01IW-PASSVALUE.VEH-STAT-PREV;
  
  
  
  
  
   
  
    if (VHCM01IW-PASSVALUE.CAR-TYPE-5 == "C1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-5 == "C2" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-5 == "D1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-5 == "L1" )
        VHCM01IW-SVR-REC.END-CAR-HRS-HIST = VHCM01IW-SVR-REC.CAR-NO-5-END-HRS-SVC;
        VHCM01IW-SVR-REC.END-CAR-MIN-HIST = VHCM01IW-SVR-REC.CAR-NO-5-END-MIN-SVC;
        VHCM01IW-SVR-REC.MID-CAR-HRS-HIST = VHCM01IW-SVR-REC.CAR-NO-5-MID-HRS-SVC;
        VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.CAR-NO-5-MID-MIN-SVC;
        
  
  
        VHCM01IS-SVC-HIST();
        VHCM01IW-SVR-REC.CAR-NO-5-END-HRS-SVC = VHCM01IW-SVR-REC.END-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-5-END-MIN-SVC = VHCM01IW-SVR-REC.END-CAR-MIN-HIST;
        VHCM01IW-SVR-REC.CAR-NO-5-MID-HRS-SVC = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-5-MID-MIN-SVC = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST;
        
  
  
    end
    VHCM01IW-SVR-REC.CURR-CAR-HRS = VHCM01IW-SVR-REC.CAR-NO-5-CUR-HRS;
    VHCM01IW-SVR-REC.CURR-CAR-MIN = VHCM01IW-SVR-REC.CAR-NO-5-CUR-MIN;
    VHCM01IS-SVC-HIT1();
    VHCM01IW-SVR-REC.CAR-NO-5-CUR-HRS = VHCM01IW-SVR-REC.CURR-CAR-HRS;
    VHCM01IW-SVR-REC.CAR-NO-5-CUR-MIN = VHCM01IW-SVR-REC.CURR-CAR-MIN;

  
    VHCM01IW-PASSVALUE.CAR-NOT-EXIST = "N";
    VHCM015_CRIT.ORIENTATION-5 = " ";
      if (VHCM01IW-PASSVALUE.END-CAR-SW == "Y")
        if ((VHCM01IW-1.CAR-TYPE[5] == "C1" ||
         VHCM01IW-1.CAR-TYPE[5] == "C2" ||
         VHCM01IW-1.CAR-TYPE[5] == "D1" ||
         VHCM01IW-1.CAR-TYPE[5] == "L1") &&
         (VHCM01IW-1.ATO-PRESENT-IND[5] != "Y"))
            VHCM01IW-TRIGGER.TYPE-ERROR-CAR5 = "Y";
            VHCM01IW-TRIGGER.CAR-ERROR = "Y";
            VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 5 ATO PRESENT IND NOT = Y";
        else
            if (VHCM01IW-1.TRAIN-INCD-IND[5] == "Y")
                VHCM01IW-TRIGGER.CAR5-NO-GO-TI = "Y";
                VHCM01IW-TRIGGER.CAR-ERROR = "Y";
                VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 5 HAS TRAIN INCIDENT";
                if (VHCM01IW-1.CAR-STAT == "NO GO")
                    VHCM01IW-STATUS.CAR-STATUS-5 = "NO TI";
                else
                    VHCM01IW-STATUS.CAR-STATUS-5 = "GO TI";
                end
            else
                VHCM01IW-TRIGGER.CAR5-LOC-HI = "Y";
                VHCM01IW-TRIGGER.CAR5-LOC-HI = "Y";
            end
        end
    end
end 

