Function VHTR01IS-CON-MSG () 
    if (VHTR01IW-TRIGGER.CON-NOT-INSRV == "Y")
        VHTR01IW-CON-MSG.CON-MSG-1 = "CONSIST NOT IN SERVICE";
        VHTR01IW-TRIGGER.CON-NOT-INSRV = " ";
        VHTR01IW-CON-MSG.CON-MESSAGE = VHTR01IW.CON-NO;
        VHTR01IW-CON-MSG.CON-MSG-1-X = VHTR01IW-CON-MSG.CON-MESSAGE;
        VHTR01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST NOT IN SERVICE";
    end
    if (VHTR01IW-TRIGGER.CON-TRBL == "Y")
        VHTR01IW-CON-MSG.CON-MSG-1 = "TRAIN HAS TRAIN INCIDENT CANNOT BE RECONFIGURED";
        VHTR01IW-TRIGGER.CON-NOT-INSRV = " ";
        VHTR01IW-CON-MSG.CON-MESSAGE = VHTR01IW.CON-NO;
        VHTR01IW-CON-MSG.CON-MSG-1-X = VHTR01IW-CON-MSG.CON-MESSAGE;
        VHTR01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST NOT IN SERVICE";
    end
    if (VHTR01IW-TRIGGER.CON-STAT-ERROR == "Y")
        VHTR01IW-CON-MSG.CON-MSG-1 = "CONSIST STATUS ERROR";
        VHTR01IW-TRIGGER.CON-STAT-ERROR = " ";
        VHTR01IW-CON-MSG.CON-MESSAGE = VHTR01IW.CON-NO;
        VHTR01IW-CON-MSG.CON-MSG-1-X = VHTR01IW-CON-MSG.CON-MESSAGE;
        VHTR01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST STATUS ERROR";
    end
    if (VHTR01IW-TRIGGER.CON-NUMERIC-ERR == "Y")
        VHTR01IW-CON-MSG.CON-MSG-1 = "CONSIST NUMERIC ERROR";
        VHTR01IW-TRIGGER.CON-NUMERIC-ERR = " ";
        VHTR01IW-CON-MSG.CON-MESSAGE = VHTR01IW.CON-NO;
        VHTR01IW-CON-MSG.CON-MSG-1-X = VHTR01IW-CON-MSG.CON-MESSAGE;
        VHTR01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99";
    end
    if (VHTR01IW-TRIGGER.CON-NOT-EXIST == "Y")
        VHTR01IW-CON-MSG.CON-MSG-1 = "CONSIST NOT EXIST";
        VHTR01IW-TRIGGER.CON-NOT-EXIST = " ";
        VHTR01IW-CON-MSG.CON-MESSAGE = VHTR01IW.CON-NO;
        VHTR01IW-CON-MSG.CON-MSG-1-X = VHTR01IW-CON-MSG.CON-MESSAGE;
        VHTR01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99";
    end
    if (VHTR01IW-TRIGGER.COMPL-CLEAR == "Y")
        VHTR01IW-TRIGGER.COMPL-CLEAR = " ";
        VHTR01IW-CON-MSG.CON-MSG-2-X = "TRAIN ";
        VHTR01IW-CON-MSG.CON-MSG-2-XX = VHTR01IW.CON-NO;
        VHTR01IW-CON-MSG.CON-MSG-2-XXX = " SUCCESSFULLY RE-CONFIGURATION TO ";
        VHTR01IW-CON-MSG.CON-MSG-2-XXXX = VHTR01IW.YARD-LOC;
        VHTR01IW-CON-MSG.CON-MSG-2-XXXXX = ". RUN TIME ";
  
  
  
        VHTR01IW-CON-MSG.CON-MSG-FILLER = ":";
        VHTR01IW-CON-MSG.CON-MSG-1 = VHTR01IW-CON-MSG.CON-MSG-2;
    end
end 

Function VHTR01IS-CONT-REC () 
    if (VHTR02IW.YESNO == "Yes") 
  
  
        VHTR01IS-CKCO-IND();
  
  
    end
end 

Function VHTR01IS-DATE () 
    VHXREVC_CRIT.SEL-IDX = 3;
    try
        call "VHXREVC"(XDCONTROL, VHXREVC_CRIT, VHXREVC_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        TEMP-DATE = VHXREVC_DATA.REVENUE-DATE;
        VHTR01IW-PASSVALUE.DATE-REV = TEMP-DATE;
        XXDATEW.DATE-MM-DD-YYYY = VHTR01IW-PASSVALUE.DATE-REV;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHTR01IW-PASSVALUE.DATE-REV = XXDATEW.DATE-YYYY-MM-DD;
  
  
  
  
  
        VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
        VHTR01IW-PASSVALUE.DATE-CURRENT = VGVar.currentGregorianDate;
        VHTR01IW-PASSVALUE.TIME-REV-START = VHXREVC_DATA.TIME-REV-START;
        
  
  
  
  
  
    else

    end
end 

Function VHTR01IS-INCD-STAT ()
   
    VHLT016_CRIT.CAR-NO = VHTR01IW-PASSVALUE.CAR-NO-INCD;
    try
        call "VHLT016"(XDCONTROL, VHLT016_CRIT, VHLT016_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
     XDCONTROL.UROWCNT > 0)
        VHTR01IS-UPD-INC();
    else
        VHTR01IW-TRIGGER.NO-INCD = "Y";
        
  
    end
end 

Function VHTR01IS-INIT () 
    VHLT010_CRIT.USER-GROUP = VH01A01_DATA.USER-GROUP;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHLT01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHLT010";
    try
        call "VHLT010"(XDCONTROL, VHLT010_CRIT, VHLT010_DATA);
    
    end
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHTR01IS-YRD-LOC();
            VHTR01IS-DATE();
            VHTR01IS-TIME();
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHTR01IS-LOC () 
    VHLT011_CRIT.YRD-TRKG-YRD = VHTR01IW.YRD-TRKG-YRD;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHLT01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHLT011";
    try
        call "VHLT011"(XDCONTROL, VHLT011_CRIT, VHLT011_DATA);
    
    end
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHTR01IS-MOV-CARH () 
    VHTR01IS-CL-HIST();
    COUNT-H = 1;
    while ((VHTR01IW-SVR-REC.COUNT-H <= VHTR01IW-SVR-REC.HIST-COUNT))
        if (VHLT015_DATA.CAR-ORDER-SRV[COUNT-H] == 1)
            VHTR01IW-SVR-REC.HIST-CAR-NO-1 = VHLT015_DATA.CAR-NO-SRV[COUNT-H];
