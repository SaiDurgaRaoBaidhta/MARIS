Function VHMT01IS-YT-CON () 
    VHMT01IW-PASSVALUE.PSEUDO-SW = "N";
    set VHMT015_CRIT empty;
    if (VHMT01IW.CON-NO != " ")
        VHMT015_CRIT.CON-NO = VHMT01IW.CON-NO;
        try
            call "VHMT015"(XDCONTROL, VHMT015_CRIT, VHMT015_DATA);
        
        end
        if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
            VHMT01IW-PASSVALUE.PSEUDO-SW = "Y";
            VHMT013_CRIT.MT-REVERSE-IND = VHMT015_CRIT.MT-REVERSE-IND;
            VHMT01IS-YT-CAR();
        else
            if (XDCONTROL.URC == 100)
                VHMT01IS-YT-CL();
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

Function VHSC01IS-BEGIN () 
    set VHSC01W-TEMP-REC empty;
    set VH001IW-MESSAGE empty;
    VHSC01W_DATA.TIME-CHK = " ";
    VHSC01W_DATA.SPLIT-LOC = " ";
    VHSC01W_DATA.CON-NO = " ";
    VHSC01W_DATA.DASH-NO = 0;
    VHSC01W_DATA.LEFT-CON-NO = " ";
    VHSC01W_DATA.RIGHT-CON-NO = " ";
    set VHSC01W-CLEAR-SCR empty;
    set VHSC01W-NEW-RIGHT empty;
    set VHSC01IW-CON-LIST empty;
    set VHSC01W-MSG empty;
    VHSC01W-MSG.MSG = " ";
    VHSC01W-TEMP-REC.LEFT-SAME-ORG = "N";
    VHSC01W-TEMP-REC.RIGHT-SAME-ORG = "N";
    VHSC01W-TEMP-REC.LEFT-RIGHT-NEW = "N";
    DISABLE-LEFTCON = "Y";
    DISABLE-RIGHTCON = "Y";
    DISABLE-SPLITCRIT = "Y";
end 

Function VHSC01IS-CHK-ERROR () 
    if (VHSC01W-TEMP-REC.EXACT-ERROR == "CHG-ORGCONSTAT")
        VHSC01W-MSG.MSG = "Original Consist Status has changed. Requested changes not made.";
    else
        if (VHSC01W-TEMP-REC.EXACT-ERROR == "CHG-ORGCONSIZE")
            VHSC01W-MSG.MSG = "Original Consist Size has changed. Requested changes not made.";
        else
            if (VHSC01W-TEMP-REC.EXACT-ERROR == "CHG-ORGCARORDER")
                VHSC01W-MSG.MSG = "Car Order in Original Consist has changed. Requested changes not made.";
            else
                if (VHSC01W-TEMP-REC.EXACT-ERROR == "CHG-CARONCON")
                    VHSC01W-MSG.MSG = "Cars in the Original Consist have changed. Requested changes not made.";
                else
                    if (VHSC01W-TEMP-REC.EXACT-ERROR == "CHG-LEFTCONSTAT")
                        VHSC01W-MSG.MSG = "Left Consist Status has changed. Requested changes not made.";
                    else
                        if (VHSC01W-TEMP-REC.EXACT-ERROR == "CHG-RIGHTCONSTAT")
                            VHSC01W-MSG.MSG = "Right Consist Status has changed. Requested changes not made.";
                        else
                            if (VHSC01W-TEMP-REC.EXACT-ERROR == "DB-ERROR")
                                VHSC01W-MSG.MSG = "Database error. Requested changes not made.";
                            else
                                if (XDCONTROL.URC != 0 && XDCONTROL.URC != 4 &&
                                 XDCONTROL.URC != 100)
                                    VHSC01W-MSG.MSG = "Consist Split Unsuccessful. Requested changes not made.";
                                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

