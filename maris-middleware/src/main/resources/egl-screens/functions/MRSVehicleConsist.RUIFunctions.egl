    CAR-NO-8-CUR-MIN = VHCT01IW-SVR-REC.CURR-CAR-MIN;
end 

Function VHCT01IS-CAL9 () 
    if (LAST-CAR-NO-9 == "Y")
        END-CAR-SW = "Y";
        MID-CAR-SW = "N";
    else
        MID-CAR-SW = "Y";
        END-CAR-SW = "N";
    end
    if (CAR-TYPE-9 == "C1" ||
     CAR-TYPE-9 == "C2" ||
     CAR-TYPE-9 == "D1" ||
     CAR-TYPE-9 == "L1")
        VHCT01IW-PASSVALUE.END-CAR-HRS = CAR-NO-9-END-HRS;
