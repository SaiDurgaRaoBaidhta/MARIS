        VHCM015_CRIT-VEH-L.HRS-FROM-LAST-PM-10 = VHCM01IW-PASSVALUE.CAR-NO-10-FROM-PM;
        VHCM01IS-MOVE-HISL();
    end
    if (VHCM01IW-PASSVALUE.LEFT-RIGHT == "R")
