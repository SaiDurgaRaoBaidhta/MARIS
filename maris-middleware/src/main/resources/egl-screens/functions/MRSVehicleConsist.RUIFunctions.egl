Function VHMT01IS-COMP-TIME () 
    if (VHMT01IW.COMP-TIME-INSRV-HH == 0)
        VHMT01IW.COMP-TIME-INSRV-HH = 24;
    else
        if (VHMT01IW.COMP-TIME-INSRV-HH == 1)
            VHMT01IW.COMP-TIME-INSRV-HH = 25;
        else
            if (VHMT01IW.COMP-TIME-INSRV-HH == 2)
                VHMT01IW.COMP-TIME-INSRV-HH = 26;
            else
                if (VHMT01IW.COMP-TIME-INSRV-HH == 3)
                    VHMT01IW.COMP-TIME-INSRV-HH = 27;
                end
            end
        end
    end
    if (VHMT01IW.COMP-TIME-SYSTEM-HH == 0)
        VHMT01IW.COMP-TIME-SYSTEM-HH = 24;
    else
        if (VHMT01IW.COMP-TIME-SYSTEM-HH == 1)
            VHMT01IW.COMP-TIME-SYSTEM-HH = 25;
        else
            if (VHMT01IW.COMP-TIME-SYSTEM-HH == 2)
                VHMT01IW.COMP-TIME-SYSTEM-HH = 26;
            else
                if (VHMT01IW.COMP-TIME-SYSTEM-HH == 3)
                    VHMT01IW.COMP-TIME-SYSTEM-HH = 27;
                end
            end
        end
    end
end 

Function VHMT01IS-CON-MSG () 
    if (VHMT01IW-TRIGGER.CON-STAT-ERR == "Y")
        VHMT01IW-CON-MSG.CON-MSG-1 = "CONSIST INVALID";
        VHMT01IW-TRIGGER.CON-STAT-ERR = " ";
        VHMT01IW-CON-MSG.CON-MESSAGE = VHMT01IW.CON-NO;
        VHMT01IW-CON-MSG.CON-MSG-1-X = VHMT01IW-CON-MSG.CON-MESSAGE;
        VHMT01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST IN SERVICE";
    end
    if (VHMT01IW-TRIGGER.CON-NO-NUMERIC == "Y")
        VHMT01IW-CON-MSG.CON-MSG-1 = "CONSIST NUMBER SHOULD BETWEEN 100 - 999";
        VHMT01IW-TRIGGER.CON-NO-NUMERIC = " ";
        VHMT01IW-CON-MSG.CON-MESSAGE = VHMT01IW.CON-NO;
        VHMT01IW-CON-MSG.CON-MSG-1-X = VHMT01IW-CON-MSG.CON-MESSAGE;
        VHMT01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99";
    end
    if (VHMT01IW-TRIGGER.COMPLETE-MT == "Y")
        VHMT01IW-CON-MSG.CON-MSG-1 = "MAKE TRAIN COMPLETED";
        VHMT01IW-TRIGGER.COMPLETE-MT = " ";
        VHMT01IW-CON-MSG.CON-MSG-2-X = "TRAIN ";
        VHMT01IW-CON-MSG.CON-MSG-2-XX = VHMT01IW-CON-MSG.CON-NO;
        VHMT01IW-CON-MSG.CON-MSG-2-XXX = "-";
        VHMT01IW-CON-MSG.CON-MSG-2-XXXX = VHMT01IW-CON-MSG.DASH-NO;
        VHMT01IW-CON-MSG.CON-MSG-2-XXXXX = " MADE SUCCESSFULLY";
        VHMT01IW-CON-MSG.CON-MSG-1 = VHMT01IW-CON-MSG.CON-MSG-2;
    end
end 

Function VHMT01IS-CONV-TIME ()
  
  
   
    VHMT01IW-TRIGGER.TIME-ERROR-X = "N";
    if (WS15IW-TIME.TIME-IN != " ")
        if (WS15IW-TIME.POS6 != "." && WS15IW-TIME.POS6 != ":")
            WS15IW-TIME.HOURS1 = WS15IW-TIME.POS8;
            WS15IW-TIME.HOURS2 = WS15IW-TIME.POS7;
            WS15IW-TIME.COLON = ":";
            WS15IW-TIME.MINUTES1 = WS15IW-TIME.POS6;
            WS15IW-TIME.MINUTES2 = WS15IW-TIME.POS5;
            WS15IW-TIME.COLON2 = ":";
            WS15IW-TIME.SEC1 = WS15IW-TIME.POS2;
            WS15IW-TIME.SEC2 = WS15IW-TIME.POS1;
        end
  
        if (WS15IW-TIME.POS6 == ".")
            WS15IW-TIME.HOURS1 = WS15IW-TIME.POS8;
            WS15IW-TIME.HOURS2 = WS15IW-TIME.POS7;
            WS15IW-TIME.COLON = ":";
            WS15IW-TIME.MINUTES1 = WS15IW-TIME.POS5;
            WS15IW-TIME.MINUTES2 = WS15IW-TIME.POS4;
            WS15IW-TIME.COLON2 = ":";
            WS15IW-TIME.SEC1 = WS15IW-TIME.POS2;
            WS15IW-TIME.SEC2 = WS15IW-TIME.POS1;
        end

  
        if (WS15IW-TIME.SEC1 == " ")
            WS15IW-TIME.SEC1 = "0";
        end
        if (WS15IW-TIME.SEC2 == " ")
            WS15IW-TIME.SEC2 = "0";
        end

  
        if (WS15IW-TIME.HOURS1 == " ")
            WS15IW-TIME.HOURS1 = "0";
        end
        VHMT01IW.TIME-INSRV = WS15IW-TIME.TIME-OUT;
        VHMT01IS-VALID-TME();
    else
        VHMT01IW-TRIGGER.TIME-ERROR = "Y";
        VHMT01IW-TRIGGER.TIME-ERROR-X = "Y";
    end
end 

Function VHMT01IS-DATE () 
    VHMT01IS-REV-TIME();
  
  
  
  
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
        TEMP-DATE = VHXREVC_DATA.REVENUE-DATE;
        VHMT01IW.DATE-INSRV = TEMP-DATE;
        VHMT01IW.DATE-FILLER-1 = "-";
        VHMT01IW.DATE-FILLER-2 = "-";
        VHMT01IW.CURRENT-TIME = VGVar.currentFormattedTime;
        move CURRENT-TIME-MM to CURRENT-MIN-WORK withV60Compat;
        CURRENT-MIN-WORK = CURRENT-MIN-WORK + 15;
        if (CURRENT-MIN-WORK > 59)
            move CURRENT-TIME-HH to CURRENT-HR-WORK withV60Compat;
            CURRENT-HR-WORK = CURRENT-HR-WORK + 1;
            CURRENT-MIN-WORK = CURRENT-MIN-WORK - 60;
            move CURRENT-MIN-WORK to CURRENT-TIME-MM withV60Compat;
            move CURRENT-HR-WORK to CURRENT-TIME-HH withV60Compat;
        else
            move CURRENT-MIN-WORK to CURRENT-TIME-MM withV60Compat;
        end
  
  
        VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
        VHMT01IW.DATE-INSRV-SYSTEM = VGVar.currentGregorianDate;
        move DATE-INSRV-SYS-YY to DATE-INSRV-SYS-YY-X withV60Compat;
        move DATE-INSRV-SYS-MM to DATE-INSRV-SYS-MM-X withV60Compat;
        move DATE-INSRV-SYS-DD to DATE-INSRV-SYS-DD-X withV60Compat;
        FIELD-1 = "-";
        FIELD-2 = "-";
    else

    end
end 

