                    VHTR01IW-CON-LIST.CAR-LEFT-ORIENT-4 = VHTR01IW-CON-LIST.CAR-ORIENT4;
                else
                    if (VHTR01IW-CON-LIST.CAR-ORIENT4 == VHTS2A3_DATA.RGT-ORIENTATION-CD[4])
                        VHTR01IW-CON-LIST.CAR-RIGHT-ORIENT-4 = VHTR01IW-CON-LIST.CAR-ORIENT4;
                    end
                end
                
  
  
  
  
  
            else
                if (IND == 5)
                    VHTR01IW-CON-LIST.CAR-NO-5 = VHTR011_DATA.CAR-NO[IND];
                    VHTR01IW-CON-LIST.CAR-ORDER5 = 5;
                    VHTR01IW-CON-LIST.CAR-ORIENT5 = VHTR011_DATA.VAGen_ORIENTATION[IND];
