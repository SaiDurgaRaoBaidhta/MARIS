Function VHCY01IS-SW () 
    if (VHVM1A1_DATA.CURR-LOC == "SW")
        VHCY01W-TRIGGERS.DISABLE-UPDATE = "Y";
        VHCY01W-MSG.MSG = "Invalid New Location";
    else
        VHCY01W-TRIGGERS.ENABLE-UPDATE = "Y";
    end
end 

Function VHCY01IS-SW-UPDATE () 
    if (VHVM1A1_DATA.CURR-LOC != " ")
        if (VHVM1A1_DATA.CURR-LOC != "SW")
            VHCY01IS-VAL-YRD();
        else
            VHCY01W-MSG.MSG = "INVALID YARD";
        end
    else
        VHCY01W-MSG.MSG = "Please enter new Location";
    end
end 

