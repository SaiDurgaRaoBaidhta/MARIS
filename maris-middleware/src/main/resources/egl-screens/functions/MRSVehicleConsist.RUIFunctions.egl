    try
        call "VHTS1A9"(XDCONTROL, VHTS1A9_CRIT, VHTS1A9_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
           
        
  
  
  
  

        end 
    end
end 

Function VHTS01IS-CHK-SAME () 
    VHTS01IW-TRIGGER.SAME = " ";
    if (VHTS01IW-CHK-SAME.CON-FROM-1 != "   ")
        if (VHTS01IW-CHK-SAME.CON-TO-SAVE == VHTS01IW-CHK-SAME.CON-FROM-1)
            VHTS01IW-MSG.MSG = "Same consist number in chain swap sequence cannot be used";
            VHTS01IW-TRIGGER.SAME = "YES";
            VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
        end
    else
        if (VHTS01IW-CHK-SAME.CON-FROM-2 != " ")
            if (VHTS01IW-CHK-SAME.CON-TO-SAVE == VHTS01IW-CHK-SAME.CON-FROM-2)
                VHTS01IW-MSG.MSG = "Same consist number in chain swap sequence cannot be used";
                VHTS01IW-TRIGGER.SAME = "YES";
                VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
            end
        else
            if (VHTS01IW-CHK-SAME.CON-FROM-3 != " ")
                if (VHTS01IW-CHK-SAME.CON-TO-SAVE == VHTS01IW-CHK-SAME.CON-FROM-3)
                    VHTS01IW-MSG.MSG = "Same consist number in chain swap sequence cannot be used";
                    VHTS01IW-TRIGGER.SAME = "YES";
                    VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
                end
            else
                if (VHTS01IW-CHK-SAME.CON-FROM-4 != "   ")
                    if (VHTS01IW-CHK-SAME.CON-TO-SAVE == VHTS01IW-CHK-SAME.CON-FROM-4)
                        VHTS01IW-MSG.MSG = "Same consist number in chain swap sequence cannot be used";
                        VHTS01IW-TRIGGER.SAME = "YES";
                        VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
                    end
                else
                    if (VHTS01IW-CHK-SAME.CON-FROM-5 != " ")
                        if (VHTS01IW-CHK-SAME.CON-TO-SAVE == VHTS01IW-CHK-SAME.CON-FROM-5
                        )
                            VHTS01IW-MSG.MSG = "Same consist number in chain swap sequence cannot be used";
                            VHTS01IW-TRIGGER.SAME = "YES";
                            VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
                        end
                    else
                        if (VHTS01IW-CHK-SAME.CON-FROM-6 != " ")
                            if (VHTS01IW-CHK-SAME.CON-TO-SAVE ==
                             VHTS01IW-CHK-SAME.CON-FROM-6)
                                VHTS01IW-MSG.MSG = "Same consist number in chain swap sequence cannot be used";
                                VHTS01IW-TRIGGER.SAME = "YES";
                                VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
                            end
                        else
                            if (VHTS01IW-CHK-SAME.CON-FROM-7 != "   ")
                                if (VHTS01IW-CHK-SAME.CON-TO-SAVE ==
                                 VHTS01IW-CHK-SAME.CON-FROM-7)
                                    VHTS01IW-MSG.MSG = "Same consist number in chain swap sequence cannot be used";
                                    VHTS01IW-TRIGGER.SAME = "YES";
                                    VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
                                end
                            else
                                if (VHTS01IW-CHK-SAME.CON-FROM-8 != " ")
                                    if (VHTS01IW-CHK-SAME.CON-TO-SAVE ==
                                     VHTS01IW-CHK-SAME.CON-FROM-8)
                                        VHTS01IW-MSG.MSG = "Same consist number in chain swap sequence cannot be used";
                                        VHTS01IW-TRIGGER.SAME = "YES";
                                        VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
                                    end
                                else
                                    if (VHTS01IW-CHK-SAME.CON-FROM-9 != " ")
                                        if (VHTS01IW-CHK-SAME.CON-TO-SAVE ==
                                         VHTS01IW-CHK-SAME.CON-FROM-9)
                                            VHTS01IW-MSG.MSG = "Same consist number in chain swap sequence cannot be used";
                                            VHTS01IW-TRIGGER.SAME = "YES";
                                            VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
                                        end
                                    else
                                        if (VHTS01IW-CHK-SAME.CON-FROM-10 != " ")
                                            if (VHTS01IW-CHK-SAME.CON-TO-SAVE ==
                                             VHTS01IW-CHK-SAME.CON-FROM-10)
                                                VHTS01IW-MSG.MSG = "Same consist number in chain swap sequence cannot be used";
                                                VHTS01IW-TRIGGER.SAME = "YES";
                                                VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
                                            end
                                        else
                                            VHTS01IW-TRIGGER.SAME = "NO";
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

