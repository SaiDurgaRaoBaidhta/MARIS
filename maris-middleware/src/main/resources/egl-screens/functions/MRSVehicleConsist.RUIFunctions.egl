Function VHCY01IS-VAL-YRD ()
  
   
    COUNTER = 1;
    OK-RUN = "N";
    while ((VHCY01IW-PASSVALUE.COUNTER <= VHCY1A1_DATA.VAGen_INDEX))
        if (VHVM1A1_DATA.CURR-LOC == VHCY1A1_DATA.LOC[COUNTER])
            move COUNTER to NDX withV60Compat;
            COUNTER = COUNTER + 1;
            OK-RUN = "Y";
        else
            COUNTER = COUNTER + 1;
        end
    end
    if (NDX > 0)
        VHVM1A1_DATA.WHERE-IS-CAR = VHCY1A1_DATA.VAGen_TABLE[NDX];
    end
    VHCY01IW-PASSVALUE.LOC-ERROR = "N";
    VHCY01IW-VAL-LOC();
    if (VHCY01IW-PASSVALUE.LOC-ERROR == "N")
        VHCY01IS-VAL-YT();
        if (VHCY1A2_CRIT.SAME-YRD != "Y" &&
         VHCY1A2_CRIT.MAX-POS != "Y")
            VHCY01IS-VALIDATE();
            if (NO-VALID != "N")
                if (OK-RUN == "Y")
                    VHCY01W-TRIGGERS.RUN-UPDATE = "Y";

  
                    VHVM1A1_DATA.WHERE-IS-CAR = VHCY1A1_DATA.VAGen_TABLE[NDX];
                else
                    VHCY01W-MSG.MSG = "The Location You are Moving To is Not Valid";
                    FORCUS-NEW-LOC = "Y";
                end
            end
        end
    end
end 

Function VHCY01IS-VAL-YT ()
  
  
  
  
  
  
  
  
  
  
  

  
  
   
    VHCY1A2_CRIT.WHERE-IS-CAR-OLD = VHCY1A4_DATA.WHERE-IS-CAR;
  
    VHCY1A2_CRIT.LOC-OLD = VHCY1A4_DATA.CURR-LOC;
    VHCY1A2_CRIT.CAR-NO = VHVM1A2_CRIT.CAR-NO;
    VHCY1A2_CRIT.CAR-NO = VHCY1A4_DATA.CAR-NO;
    VHCY1A2_CRIT.LOC-NEW = VHVM1A1_DATA.CURR-LOC;
    VHCY1A2_CRIT.WHERE-IS-CAR-NEW = VHVM1A1_DATA.WHERE-IS-CAR;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCY01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCY1A2";

  

    
    try
        call "VHCY1A2"(XDCONTROL, VHCY1A2_CRIT, VHCY1A2_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHCY1A2_CRIT.SAME-YRD == "Y")
                VHCY01W-MSG.MSG-1-2 = "Must use Yard Tracking function for";
                VHCY01W-MSG.MSG-1-3 = VHCY1A2_DATA.YRD-TRKG-YRD-NEW;
                VHCY01W-MSG.MSG-1-4 = " to move car to new location, ";
                VHCY01W-MSG.MSG-1-5 = VHVM1A1_DATA.CURR-LOC;
                VHCY01W-MSG.MSG = VHCY01W-MSG.MSG-1;
            end
            if (VHCY1A2_CRIT.MAX-POS == "Y")
                VHCY01W-MSG.MSG-2-1 = "No room on ";
                VHCY01W-MSG.MSG-2-2 = VHCY1A2_CRIT.CAR-NO;
                VHCY01W-MSG.MSG-2-3 = " Pseudo Track for new location (can only hold ";
                VHCY01W-MSG.MSG-2-4 = VHCY1A2_CRIT.MAX-POSN;
                VHCY01W-MSG.MSG-2-5 = " cars).";
                VHCY01W-MSG.MSG = VHCY01W-MSG.MSG-1-2-1;
            end
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHCY01IS-VALIDATE () 
    VHCY01IS-GET-CAR-X();
    if (NO-VALID != "N")
        if (VHVM1A1_DATA.CAR-NO == " ")
            MSG = " INVALID CAR NO ";
            OK-RUN = " ";
            return;
        end
        COUNTER = 1;
        OK-RUN = "N";
        while ((VHCY01IW-PASSVALUE.COUNTER <= VHCY1A1_DATA.VAGen_INDEX))
            if (VHVM1A1_DATA.CURR-LOC == VHCY1A1_DATA.LOC[COUNTER])
                move COUNTER to NDX withV60Compat;
                COUNTER = COUNTER + 1;
                OK-RUN = "Y";
            else
                COUNTER = COUNTER + 1;
            end
        end
    end
end 

Function VHCY01IW-VAL-LOC () 
    if (VHCY1A4_DATA.CURR-LOC == VHVM1A1_DATA.CURR-LOC)
        VHCY01IW-PASSVALUE.LOC-ERROR = "Y";
        VHCY01W-MSG.MSG = "Cannot move to same location";
    end
end 

Function VHLT01IS-ACCU-TIME () 
    VHLT01IW-PASSVALUE.CUM-HRS = VHLT01IW-PASSVALUE.CUM-HRS + DIFF-HH;
    VHLT01IW-PASSVALUE.CUM-MIN = VHLT01IW-PASSVALUE.CUM-MIN + DIFF-MM;
    if (VHLT01IW-PASSVALUE.CUM-MIN > 59)
        VHLT01IW-PASSVALUE.CUM-HRS = VHLT01IW-PASSVALUE.CUM-HRS + 1;
        VHLT01IW-PASSVALUE.CUM-MIN = VHLT01IW-PASSVALUE.CUM-MIN - 60;
    end
end 

Function VHLT01IS-BRK-HRS () 
    CURR-SVC-HRS = 0;
    if (VHLT01IW-PASSVALUE.BRK-IN-HRS >=
     VHLT01IW-PASSVALUE.BRK-IN-HRS-MAX)
        move DIFF-HH to CURR-SVC-HRS withV60Compat;
        if (DIFF-MM > 29)
            CURR-SVC-HRS = CURR-SVC-HRS + 1;
        end
        CURR-SVC-HRS = VHLT01IW-PASSVALUE.BRK-IN-HRS - VHLT01IW-PASSVALUE.BRK-IN-HRS-MAX;
    else
        if (VHLT01IW-PASSVALUE.BRK-IN-HRS <
         VHLT01IW-PASSVALUE.BRK-IN-HRS-MAX)
            VHLT01IW-PASSVALUE.BRK-IN-HRS = VHLT01IW-PASSVALUE.BRK-IN-HRS + DIFF-HH;
            if (DIFF-MM > 29)
                VHLT01IW-PASSVALUE.BRK-IN-HRS = VHLT01IW-PASSVALUE.BRK-IN-HRS + 1;
            end
            if (VHLT01IW-PASSVALUE.BRK-IN-HRS >
             VHLT01IW-PASSVALUE.BRK-IN-HRS-MAX)
                CURR-SVC-HRS = VHLT01IW-PASSVALUE.BRK-IN-HRS - VHLT01IW-PASSVALUE.BRK-IN-HRS-MAX;
            end
        end
    end
end 

Function VHLT01IS-C-CAR ()
   
    VHLT01IW-TRIGGER.YES-SPLIT = "N";
    move DATE-END-CAR-REV-YY to WS-DATE-END-CAR-REV-YY withV60Compat;
    move DATE-END-CAR-REV-MM to WS-DATE-END-CAR-REV-MM withV60Compat;
    move DATE-END-CAR-REV-DD to WS-DATE-END-CAR-REV-DD withV60Compat;
    if (END-CAR-SW == "Y" &&
     VHLT01IW-PASSVALUE.WS-DATE-END-CAR-REV is numeric)
        VHLT01IW-TRIGGER.YES-SPLIT = "Y";
        VHLT01IS-SPLIT();
    else
        DATE-END-CAR-REV-X = VHLT01IW-PASSVALUE.DATE-END-CAR-REV;
        move DATE-END-CAR-REV-YY-X to WS-DATE-END-CAR-REV-YY withV60Compat;
        move DATE-END-CAR-REV-MM-X to WS-DATE-END-CAR-REV-MM withV60Compat;
        move DATE-END-CAR-REV-DD-X to WS-DATE-END-CAR-REV-DD withV60Compat;
        if (END-CAR-SW == "Y" &&
         VHLT01IW-PASSVALUE.WS-DATE-END-CAR-REV is numeric)
            VHLT01IS-SPLIT();
            VHLT01IW-TRIGGER.YES-SPLIT = "Y";
        else
            if (END-CAR-SW == "Y")
                VHLT01IW-PASSVALUE.END-CAR-HRS = VHLT01IW-PASSVALUE.END-CAR-HRS + DIFF-HH;
                VHLT01IW-PASSVALUE.END-CAR-MIN = VHLT01IW-PASSVALUE.END-CAR-MIN + DIFF-MM;
                if (VHLT01IW-PASSVALUE.END-CAR-MIN > 59)
                    VHLT01IW-PASSVALUE.END-CAR-HRS = VHLT01IW-PASSVALUE.END-CAR-HRS + 1;
                    VHLT01IW-PASSVALUE.END-CAR-MIN = VHLT01IW-PASSVALUE.END-CAR-MIN - 60;
                end
            end
            if (MID-CAR-SW == "Y")
                VHLT01IW-PASSVALUE.MID-CAR-HRS = VHLT01IW-PASSVALUE.MID-CAR-HRS + DIFF-HH;
                VHLT01IW-PASSVALUE.MID-CAR-MIN = VHLT01IW-PASSVALUE.MID-CAR-MIN + DIFF-MM;
                if (VHLT01IW-PASSVALUE.MID-CAR-MIN > 59)
                    VHLT01IW-PASSVALUE.MID-CAR-HRS = VHLT01IW-PASSVALUE.MID-CAR-HRS + 1;
                    VHLT01IW-PASSVALUE.MID-CAR-MIN = VHLT01IW-PASSVALUE.MID-CAR-MIN - 60;
                end
            end
        end
    end
end 

