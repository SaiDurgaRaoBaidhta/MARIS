                VHCC01IW.CAR-10-CURR-LOC = VHCC01IW-PASSVALUE.VEH-STAT;
                if (VHCC01IW-PASSVALUE.CAR-NOT-EXIST == "Y")
                    VHCC01IW-TRIGGER.CAR10-NO-EXIST = "Y";
                    VHCC01IW-TRIGGER.CAR-ERROR = "Y";
                else 
                    if (VHCC01IW-PASSVALUE.CAR-TYPE != "B1" &&
                     VHCC01IW-PASSVALUE.CAR-TYPE != "B2" &&
                     VHCC01IW-PASSVALUE.CAR-TYPE != "C1" &&
                     VHCC01IW-PASSVALUE.CAR-TYPE != "C2" &&
                     VHCC01IW-PASSVALUE.CAR-TYPE != "D1" &&
                     VHCC01IW-PASSVALUE.CAR-TYPE != "E1" &&
                     VHCC01IW-PASSVALUE.CAR-TYPE != "L1" &&
                     VHCC01IW-PASSVALUE.CAR-TYPE != "M1" &&
                     VHCC01IW-PASSVALUE.CAR-TYPE != "K1" &&
                     VHCC01IW-PASSVALUE.CAR-TYPE != "K2")
                        VHCC01IW-TRIGGER.TYPE-ERROR-CAR10 = "Y";
                        VHCC01IW-TRIGGER.CAR-ERROR = "Y";
                    else
                        VHCC01IW-PASSVALUE.CAR-NO-NEW = CAR-NO-10-NEW;
                        VHCC01IS-CHK-SAME();
                        if (VHCC01IW-PASSVALUE.WHERE-IS-CAR == "CON" &&
                         (VHCC01IW-TRIGGER.SAME-OLD-CAR == "N"))
                            VHCC01IW-TRIGGER.CAR10-IN-SERV = "Y";
                            VHCC01IW-TRIGGER.CAR-ERROR = "Y";
                            VHCC01IW-PASSVALUE.CON-FILLER = "-";
                            VHCC01IW.CON-NO-ERROR-10 = VHCC01IW-PASSVALUE.CON-PASSVALUE;
                            
					  
					  
					  
                        else
                            if (VHCC01IW-PASSVALUE.TRAIN-INCD-IND == "Y")
                                VHCC01IW-TRIGGER.CAR10-NO-GO-TI = "Y";
                                VHCC01IW-TRIGGER.CAR-ERROR = "Y";
                                if (VHCC01IW-PASSVALUE.VEH-STAT == "NO GO")
                                    VHCC01IW.CAR-10-CURR-LOC = "NO TI";
                                else
                                    VHCC01IW.CAR-10-CURR-LOC = "GO TI";
                                end
                            else
                                if (VHCC01IW-PASSVALUE.VEH-STAT != "GO" &&
                                 VHCC01IW-PASSVALUE.VEH-STAT != "USABLE" &&
                                 VHCC01IW-PASSVALUE.VEH-STAT != "ERROR" &&
                                 (VHCC01IW-TRIGGER.SAME-OLD-CAR == "N"))
                                    VHCC01IW-TRIGGER.CAR10-NO-GO = "Y";
                                    VHCC01IW-TRIGGER.CAR-ERROR = "Y";  
                                end
                            end
                        end
                    end
                end
            end
        else
            VHCC01IW-TRIGGER.NONUMERIC-CAR10 = "Y";
            VHCC01IW-TRIGGER.CAR-ERROR = "Y";
        end
    end
end 

Function VHCC01IS-VALID-TYP () 
    if (VHCC01IW.CON-CAR-SIZE > VHCC01IW-PASSVALUE.VAGen_COUNT)
        VHCC01IW-PASSVALUE.VAGen_COUNT = VHCC01IW.CON-CAR-SIZE;
    end
    VHCC01IW-TRIGGER.COUNTER = 1;
    NO-MORE-SW = "N";
    if (VHCC01IW-PASSVALUE.VAGen_COUNT > 0)
        while ((VHCC01IW-TRIGGER.COUNTER <= VHCC01IW-PASSVALUE.VAGen_COUNT))
  			
            if (VHCC01IW-PASSVALUE.CAR-NO == VHMT014_DATA.CAR-NO[COUNTER])
                VHCC01IW-PASSVALUE.CAR-TYPE = VHMT014_DATA.CAR-TYPE[COUNTER];
                VHCC01IW-PASSVALUE.VEH-STAT = VHMT014_DATA.VEH-STAT[COUNTER];
                VHCC01IW-PASSVALUE.WHERE-IS-CAR = VHMT014_DATA.WHERE-IS-CAR[COUNTER];
                VHCC01IW-PASSVALUE.CURR-LOC = VHMT014_DATA.CURR-LOC[COUNTER];
                VHCC01IW-PASSVALUE.SOFT_VER = VHMT014_DATA.SOFT_VER[COUNTER];
                VHCC01IW-PASSVALUE.ATO-PRESENT-IND = VHMT014_DATA.ATO-PRESENT-IND[COUNTER];
                VHCC01IW-PASSVALUE.TRAIN-INCD-IND = VHMT014_DATA.TRAIN-INCD-IND[COUNTER];
                VHCC01IW-PASSVALUE.CON-NO = VHMT014_DATA.CON-NO[COUNTER];
                VHCC01IW-PASSVALUE.DASH-NO = VHMT014_DATA.DASH-NO[COUNTER];
                VHCC01IW-PASSVALUE.VAGen_ORIENTATION = VHMT014_DATA.VAGen_ORIENTATION[COUNTER];
                COUNTER = COUNTER + 1;
                NO-MORE-SW = "Y";
            else
                COUNTER = COUNTER + 1;
            end
        end
    else
        NO-MORE-SW = "Y";
    end
    if (NO-MORE-SW == "N")
        VHCC01IW-PASSVALUE.CAR-NOT-EXIST = "Y";
    end
end 

Function VHCM015-COMPLETE () 
    VHCM01IW-CON-MSG.CON-MSG-1 = "TRAIN COMPLETE COMBINED";
end 

Function VHCM01IS-ACCU-TIME () 
    if (VHCM01IW-PASSVALUE.CAR-LR == "L")
        VHCM01IW-PASSVALUE.CUM-HRS = VHCM01IW-PASSVALUE.CUM-HRS + VHCM01IW-PASS-LEFT.DIFF-HH;
        VHCM01IW-PASSVALUE.CUM-MIN = VHCM01IW-PASSVALUE.CUM-MIN + VHCM01IW-PASS-LEFT.DIFF-MM;
    else
        VHCM01IW-PASSVALUE.CUM-HRS = VHCM01IW-PASSVALUE.CUM-HRS + VHCM01IW-PASS-RIGH.DIFF-HH;
        VHCM01IW-PASSVALUE.CUM-MIN = VHCM01IW-PASSVALUE.CUM-MIN + VHCM01IW-PASS-RIGH.DIFF-MM;
    end
    if (VHCM01IW-PASSVALUE.CUM-MIN > 59)
        VHCM01IW-PASSVALUE.CUM-HRS = VHCM01IW-PASSVALUE.CUM-HRS + 1;
        VHCM01IW-PASSVALUE.CUM-MIN = VHCM01IW-PASSVALUE.CUM-MIN - 60;
    end
end 

Function VHCM01IS-BE-AF () 
    if (VHCM01IW.BEFORE-AFTER == "A" ||
     VHCM01IW.BEFORE-AFTER == "B" ||
     VHCM01IW.BEFORE-AFTER == "a" ||
     VHCM01IW.BEFORE-AFTER == "b")
        VHCM01IS-BE-AF-1();
    else
        VHCM01IW-CON-MSG.CON-MSG-1 = "Please enter A or B";
        VHCM01IW-TRIGGER.BE-AF-ERROR = "Y";
    end
end 

Function VHCM01IS-BE-AF-1 () 
    VHCM01IW.TOTAL-CAR-COUNT = VHCM01IW-PASS-LEFT.CAR-COUNT + VHCM01IW-PASS-RIGH.CAR-COUNT;
    if (VHCM01IW.TOTAL-CAR-COUNT > 10)
        VHCM01IW-CON-MSG.CON-MSG-4-1 = "Total Car Length cannot over 10";
        VHCM01IW-CON-MSG.CON-MSG-4-2 = " ( ";
        VHCM01IW-CON-MSG.CON-MSG-4-3 = VHCM01IW.COMBINE-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-4-4 = " - ";
        VHCM01IW-CON-MSG.CON-MSG-4-5 = VHCM01IW-PASS-LEFT.CAR-COUNT;
        VHCM01IW-CON-MSG.CON-MSG-4-6 = " , ";
        VHCM01IW-CON-MSG.CON-MSG-4-7 = VHCM01IW.TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-4-8 = " - ";
        VHCM01IW-CON-MSG.CON-MSG-4-9 = VHCM01IW-PASS-RIGH.CAR-COUNT;
        VHCM01IW-CON-MSG.CON-MSG-4-10 = " ) ";
        VHCM01IW-CON-MSG.CON-MSG-1 = VHCM01IW-CON-MSG.CON-MSG-4;
    else
        if (VHCM01IW.BEFORE-AFTER == "A" ||
         VHCM01IW.BEFORE-AFTER == "a")
            VHCM01IW-PASSVALUE.LEFT-RIGHT = "L";
            VHCM01IS-BE-AF-2();
            VHCM01IS-BE-AF-2H();
  
        else
            if (VHCM01IW.BEFORE-AFTER == "B" ||
             VHCM01IW.BEFORE-AFTER == "b")
                VHCM01IW-PASSVALUE.LEFT-RIGHT = "R";
                VHCM01IS-BE-AF-3();
                VHCM01IS-BE-AF-3H();
  
            end
        end
    end
end 

