Function VHCT01IS-CLEAR-MSG () 
    set VHCT01IW-TIME-MSG empty;
    set VHCT01IW-CON-MSG empty;
    set VH001IW-MESSAGE empty;
end 

Function VHCT01IS-CON-MSG () 
    if (VHCT01IW-TRIGGER.CON-NOT-INSRV == "Y")
        VHCT01IW-CON-MSG.CON-MSG-1 = "CONSIST NOT IN SERVICE";
        VHCT01IW-TRIGGER.CON-NOT-INSRV = " ";
        VHCT01IW-CON-MSG.CON-MESSAGE = VHCT01IW.CON-NO;
        VHCT01IW-CON-MSG.CON-MSG-1-X = VHCT01IW-CON-MSG.CON-MESSAGE;
        VHCT01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST NOT IN SERVICE";
    end
    if (VHCT01IW-TRIGGER.CON-STAT-ERROR == "Y")
        VHCT01IW-CON-MSG.CON-MSG-1 = "CONSIST STATUS ERROR";
        VHCT01IW-TRIGGER.CON-STAT-ERROR = " ";
        VHCT01IW-CON-MSG.CON-MESSAGE = VHCT01IW.CON-NO;
        VHCT01IW-CON-MSG.CON-MSG-1-X = VHCT01IW-CON-MSG.CON-MESSAGE;
        VHCT01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST STATUS ERROR";
    end
    if (VHCT01IW-TRIGGER.CON-NUMERIC-ERR == "Y")
        VHCT01IW-CON-MSG.CON-MSG-1 = "CONSIST NUMERIC ERROR";
        VHCT01IW-TRIGGER.CON-NUMERIC-ERR = " ";
        VHCT01IW-CON-MSG.CON-MESSAGE = VHCT01IW.CON-NO;
        VHCT01IW-CON-MSG.CON-MSG-1-X = VHCT01IW-CON-MSG.CON-MESSAGE;
        VHCT01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99";
    end
    if (VHCT01IW-TRIGGER.CON-NOT-EXIST == "Y")
        VHCT01IW-CON-MSG.CON-MSG-1 = "CONSIST NOT EXIST";
        VHCT01IW-TRIGGER.CON-NOT-EXIST = " ";
        VHCT01IW-CON-MSG.CON-MESSAGE = VHCT01IW.CON-NO;
        VHCT01IW-CON-MSG.CON-MSG-1-X = VHCT01IW-CON-MSG.CON-MESSAGE;
        VHCT01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99";
    end
    if (VHCT01IW-TRIGGER.COMPL-CLEAR == "Y")
        VHCT01IW-TRIGGER.COMPL-CLEAR = " ";
        VHCT01IW-CON-MSG.CON-MSG-2-X = "TRAIN ";
        VHCT01IW-CON-MSG.CON-MSG-2-XX = VHCT01IW.CON-NO;
        VHCT01IW-CON-MSG.CON-MSG-2-XXX = " SUCCESSFULLY CLEARED TO ";
        VHCT01IW-CON-MSG.CON-MSG-2-XXXX = VHCT01IW.YARD-LOC;
        VHCT01IW-CON-MSG.CON-MSG-2-XXXXX = ". RUN TIME ";
  
  
  
        VHCT01IW-CON-MSG.CON-MSG-FILLER = ":";
        VHCT01IW-CON-MSG.CON-MSG-1 = VHCT01IW-CON-MSG.CON-MSG-2;
    end
end 

Function VHCT01IS-CONV-TIME ()
  
  
   
    VHCT01IW-TRIGGER.TIME-ERROR-X = "N";
    if (WS15IW-TIME.TIME-IN != " ")
        if (WS15IW-TIME.POS6 != "." && WS15IW-TIME.POS6 != ":")
            WS15IW-TIME.HOURS1 = WS15IW-TIME.POS8;
            WS15IW-TIME.HOURS2 = WS15IW-TIME.POS7;
            WS15IW-TIME.COLON = ":";
            WS15IW-TIME.MINUTES1 = WS15IW-TIME.POS6;
            WS15IW-TIME.MINUTES2 = WS15IW-TIME.POS5;
            WS15IW-TIME.COLON2 = ":";
            WS15IW-TIME.SEC1 = WS15IW-TIME.POS2;
            WS15IW-TIME.SEC2 = WS15IW-TIME.POS1;
        end
  
        if (WS15IW-TIME.POS6 == ".")
            WS15IW-TIME.HOURS1 = WS15IW-TIME.POS8;
            WS15IW-TIME.HOURS2 = WS15IW-TIME.POS7;
            WS15IW-TIME.COLON = ":";
            WS15IW-TIME.MINUTES1 = WS15IW-TIME.POS5;
            WS15IW-TIME.MINUTES2 = WS15IW-TIME.POS4;
            WS15IW-TIME.COLON2 = ":";
            WS15IW-TIME.SEC1 = WS15IW-TIME.POS2;
            WS15IW-TIME.SEC2 = WS15IW-TIME.POS1;
        end

  
        if (WS15IW-TIME.SEC1 == " ")
            WS15IW-TIME.SEC1 = "0";
        end
        if (WS15IW-TIME.SEC2 == " ")
            WS15IW-TIME.SEC2 = "0";
        end

  
        if (WS15IW-TIME.HOURS1 == " ")
            WS15IW-TIME.HOURS1 = "0";
        end
        VHCT01IW.TIME-OUTSRV = WS15IW-TIME.TIME-OUT;
        VHCT01IS-VALID-TME();
    else
        VHCT01IW-TRIGGER.TIME-ERROR = "Y";
        VHCT01IW-TRIGGER.TIME-ERROR-X = "Y";
    end
end 

Function VHCT01IS-DATE () 
    VHXREVC_CRIT.SEL-IDX = 3;
    try
        call "VHXREVC"(XDCONTROL, VHXREVC_CRIT, VHXREVC_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        TEMP-DATE = VHXREVC_DATA.REVENUE-DATE;
        VHCT01IW-PASSVALUE.DATE-REV = TEMP-DATE;
        XXDATEW.DATE-MM-DD-YYYY = VHCT01IW-PASSVALUE.DATE-REV;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHCT01IW-PASSVALUE.DATE-REV = XXDATEW.DATE-YYYY-MM-DD;
  
  
  
  
  
        VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
        VHCT01IW-PASSVALUE.DATE-CURRENT = VGVar.currentGregorianDate;
        VHCT01IW-PASSVALUE.TIME-REV-START = VHXREVC_DATA.TIME-REV-START;
        
  
  
  
  
  
    else

    end
end 

Function VHCT01IS-INCD-STAT ()
   
    VHCT016_CRIT.CAR-NO = VHCT01IW-PASSVALUE.CAR-NO-INCD;
    try
        call "VHCT016"(XDCONTROL, VHCT016_CRIT, VHCT016_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
     XDCONTROL.UROWCNT > 0)
        VHCT01IS-UPD-INC();
    else
        VHCT01IW-TRIGGER.NO-INCD = "Y";
        
  
    end
end 

Function VHCT01IS-INIT () 
    VHCT01IS-DATE();
end 

Function VHCT01IS-MOV-CARH () 
    VHCT01IS-CL-HIST();
    COUNT-H = 1;
    while ((VHCT01IW-SVR-REC.COUNT-H <= VHCT01IW-SVR-REC.HIST-COUNT))
        if (VHCT015_DATA.CAR-ORDER-SRV[COUNT-H] == 1)
            VHCT01IW-SVR-REC.HIST-CAR-NO-1 = VHCT015_DATA.CAR-NO-SRV[COUNT-H];
            VHCT01IW-SVR-REC.HIST-CAR-TYPE-1 = VHCT015_DATA.CAR-TYPE-SRV[COUNT-H];
            VHCT01IW-SVR-REC.CAR-NO-1-END-HRS-SVC = VHCT015_DATA.HIST-END-CAR-HRS-SRV[COUNT-H];
            VHCT01IW-SVR-REC.CAR-NO-1-END-MIN-SVC = VHCT015_DATA.HIST-END-CAR-MIN-SRV[COUNT-H];
            VHCT01IW-SVR-REC.CAR-NO-1-MID-HRS-SVC = VHCT015_DATA.HIST-MID-CAR-HRS-SRV[COUNT-H];
            VHCT01IW-SVR-REC.CAR-NO-1-MID-MIN-SVC = VHCT015_DATA.HIST-MID-CAR-MIN-SRV[COUNT-H];
            VHCT01IW-SVR-REC.CAR-NO-1-PRV-HRS = VHCT015_DATA.CUM-HRS-PREV-SRV[COUNT-H];
            VHCT01IW-SVR-REC.CAR-NO-1-PRV-MIN = VHCT015_DATA.CUM-MIN-PREV-SRV[COUNT-H];
            VHCT01IW-SVR-REC.CAR-NO-1-CUR-HRS = VHCT015_DATA.CURR-CAR-HRS-SRV[COUNT-H];
            VHCT01IW-SVR-REC.CAR-NO-1-CUR-MIN = VHCT015_DATA.CURR-CAR-MIN-SRV[COUNT-H];
            XXDATEW.DATE-MM-DD-YYYY = VHCT015_DATA.DATE-REV-SRV[COUNT-H];
            XXDATEW.VAGen_FUNCTION = "YMD";
            MRSCommonCode.XXDATES-CONVERT();
            VHCT015_DATA.DATE-REV-SRV[COUNT-H] = XXDATEW.DATE-YYYY-MM-DD;
            VHCT01IW-SVR-REC.CAR-NO-1-DATE-REV = VHCT015_DATA.DATE-REV-SRV[COUNT-H];
        else
