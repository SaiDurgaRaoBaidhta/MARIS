    VHTR016_CRIT-VEH-H.CUM-MIN-PREV-9 = VHTR01IW-SVR-REC.CAR-NO-9-PRV-MIN;
    VHTR016_CRIT-VEH-H.DATE-REV-10 = VHTR01IW-SVR-REC.CAR-NO-10-DATE-REV;
    VHTR016_CRIT-VEH-H.CAR-NO-10 = VHTR01IW-SVR-REC.HIST-CAR-NO-10;
    VHTR016_CRIT-VEH-H.CURR-CAR-HRS-10 = VHTR01IW-SVR-REC.CAR-NO-10-CUR-HRS;
    VHTR016_CRIT-VEH-H.CURR-CAR-MIN-10 = VHTR01IW-SVR-REC.CAR-NO-10-CUR-MIN;
    VHTR016_CRIT-VEH-H.END-CAR-HRS-10 = VHTR01IW-SVR-REC.CAR-NO-10-END-HRS-SVC;
    VHTR016_CRIT-VEH-H.END-CAR-MIN-10 = VHTR01IW-SVR-REC.CAR-NO-10-END-MIN-SVC;
    VHTR016_CRIT-VEH-H.MID-CAR-HRS-10 = VHTR01IW-SVR-REC.CAR-NO-10-MID-HRS-SVC;
    VHTR016_CRIT-VEH-H.MID-CAR-MIN-10 = VHTR01IW-SVR-REC.CAR-NO-10-MID-MIN-SVC;
    VHTR016_CRIT-VEH-H.CUM-HRS-PREV-10 = VHTR01IW-SVR-REC.CAR-NO-10-PRV-HRS;
    VHTR016_CRIT-VEH-H.CUM-MIN-PREV-10 = VHTR01IW-SVR-REC.CAR-NO-10-PRV-MIN;
    VHTR01IS-MOVE-HIST();
    VHTR01IS-MOVE-PSEU();
    VHTR01IS-BUILD-UP();
    
    try
        call "VHTR016"(XDCONTROL, VHTR016_CRIT, VHTR016_CRIT-VEH, VHTR016_CRIT-VEH-H, VHTR016_CRIT-VEH-S, VHTR016_CRIT-PSEU);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

         
         
        if (VHTR016_CRIT.ERROR-YARD-TRACK == "Y")
            VHTR01IW-CON-MSG.CON-MSG-3-X = "No room on ";
            VHTR01IW-CON-MSG.CON-MSG-3-XX = VHTR016_CRIT.CURR-LOC;
            VHTR01IW-CON-MSG.CON-MSG-3-XXX = " Pseudo Track for new location (can only hold";
            VHTR01IW-CON-MSG.CON-MSG-3-XXXX = VHTR016_CRIT.MAX-POSN;
            VHTR01IW-CON-MSG.CON-MSG-3-XXXXX = " cars).";
        else
            if (VHTR016_CRIT.POSITION-FULL == "Y")
  
  
  
  
  
                VHTR01IW-CON-MSG.CON-MSG-4-X = "No room on Track ";
                VHTR01IW-CON-MSG.CON-MSG-4-XX = VHTR016_CRIT.YRD-SUB-LOC;
                VHTR01IW-CON-MSG.CON-MSG-4-XXX = " (has ";
                VHTR01IW-CON-MSG.CON-MSG-4-XXXX = VHTR016_CRIT.MAX-ROWS;
                VHTR01IW-CON-MSG.CON-MSG-4-XXXXX = " cars )";
                VHTR01IW-CON-MSG.CON-MSG-1 = VHTR01IW-CON-MSG.CON-MSG-4;
            else
                VHTR01IW-TRIGGER.COMPL-CLEAR = "Y";
                
  
                VHTR01IS-CALL-CICS();
            end
        end
    else
  
  
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHTR01IS-UPD-DVS () 
    VHLT018_DATA.CAR-NO = VHTR01IW-PASSVALUE.CAR-NO;
    VHLT018_CRIT.TYPE-IND = VHLT019_DATA.INCD-TYPE;
    VHLT018_DATA.DATE-INCD-OCCR-REV = VHTR01IW-PASSVALUE.DATE-REV;
    VHLT018_DATA.CURR-LOC = VHTR01IW.YARD-LOC;
    try
        call "VHLT018"(XDCONTROL, VHLT018_CRIT, VHLT018_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))

    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHTR01IS-UPD-INC ()
   
    VHLT017_CRIT.INCD-NO = VHLT016_DATA.INCD-NO;
  
    VHLT017_DATA.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
  
    VHLT017_DATA.HOME-YRD = VHTR01IW-PASSVALUE.HOME-YRD;
    try
        call "VHLT017"(XDCONTROL, VHLT017_CRIT, VHLT017_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))

    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHTR01IS-VALD-CAR () 
    if (LAST-CAR-NO-10 == "Y")
        VHTR01IS-CAL10();
        VHTR01IS-CAL9();
        VHTR01IS-CAL8();
        VHTR01IS-CAL7();
        VHTR01IS-CAL6();
        VHTR01IS-CAL5();
        VHTR01IS-CAL4();
        VHTR01IS-CAL3();
        VHTR01IS-CAL2();
        VHTR01IS-CAL1();
    else
        if (LAST-CAR-NO-9 == "Y")
            VHTR01IS-CAL9();
            VHTR01IS-CAL8();
            VHTR01IS-CAL7();
            VHTR01IS-CAL6();
            VHTR01IS-CAL5();
            VHTR01IS-CAL4();
            VHTR01IS-CAL3();
            VHTR01IS-CAL2();
            VHTR01IS-CAL1();
        else
            if (LAST-CAR-NO-8 == "Y")
                VHTR01IS-CAL8();
                VHTR01IS-CAL7();
                VHTR01IS-CAL6();
                VHTR01IS-CAL5();
                VHTR01IS-CAL4();
                VHTR01IS-CAL3();
                VHTR01IS-CAL2();
                VHTR01IS-CAL1();
            else
                if (LAST-CAR-NO-7 == "Y")
                    VHTR01IS-CAL7();
                    VHTR01IS-CAL6();
                    VHTR01IS-CAL5();
                    VHTR01IS-CAL4();
                    VHTR01IS-CAL3();
                    VHTR01IS-CAL2();
                    VHTR01IS-CAL1();
                else
                    if (LAST-CAR-NO-6 == "Y")
                        VHTR01IS-CAL6();
                        VHTR01IS-CAL5();
                        VHTR01IS-CAL4();
                        VHTR01IS-CAL3();
                        VHTR01IS-CAL2();
                        VHTR01IS-CAL1();
                    else
                        if (LAST-CAR-NO-5 == "Y")
                            VHTR01IS-CAL5();
                            VHTR01IS-CAL4();
                            VHTR01IS-CAL3();
                            VHTR01IS-CAL2();
                            VHTR01IS-CAL1();
                        else
                            if (LAST-CAR-NO-4 == "Y")
                                VHTR01IS-CAL4();
                                VHTR01IS-CAL3();
                                VHTR01IS-CAL2();
                                VHTR01IS-CAL1();
                            else
                                if (LAST-CAR-NO-3 == "Y")
                                    VHTR01IS-CAL3();
                                    VHTR01IS-CAL2();
                                    VHTR01IS-CAL1();
                                else
                                    if (LAST-CAR-NO-2 == "Y")
                                        VHTR01IS-CAL2();
                                        VHTR01IS-CAL1();
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHTR01IS-VALD-LR () 
    set VHTR01IW-RIGHT-CON empty;
    set VHTR01IW-LEFT-CON empty;
    if (VHTR01IW.LEFT-CON-NO == " " &&
     VHTR01IW.RIGHT-CON-NO == " ")
        VHTR01IW-CON-MSG.CON-MSG-1 = "Left consist and Right consist cannot both be blank";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
    else
        if (VHTR01IW.LEFT-CON-NO == VHTR01IW.RIGHT-CON-NO)
            VHTR01IW-CON-MSG.CON-MSG-1 = "Left consist and Right consist cannot be same";
            VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
            VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
        else
            if ((VHTR01IW.LEFT-CON-NO != " " && VHTR01IW.RIGHT-CON-NO == " "))
                VHTR01IS-VALD-LR1();
            else
                if ((VHTR01IW.LEFT-CON-NO == " " && VHTR01IW.RIGHT-CON-NO != " "))
                    VHTR01IS-VALD-LR2();
                else
                    if ((VHTR01IW.LEFT-CON-NO != " " && VHTR01IW.RIGHT-CON-NO != " "))
                        VHTR01IS-VALD-LR1();
                        VHTR01IS-VALD-LR2();
                    end
                end
            end
        end
    end
end 

Function VHTR01IS-VALD-LR1 () 
    if (VHTR01IW.LEFT-CON-NO is numeric)
        if (VHTR01IW.LEFT-CON-NO-X > 99 &&
         VHTR01IW.LEFT-CON-NO-X < 1000)
            if (VHTR01IW.LEFT-CON-NO != VHTR01IW.CON-NO)
                VHTR013_CRIT.CON-NO = VHTR01IW.LEFT-CON-NO;
                try
                    call "VHTR013"(XDCONTROL, VHTR013_CRIT, VHTR013_DATA);
                
                end
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    VHTR01IW-CON-MSG.CON-MSG-1 = "Left consist is an assigned pseudo train, please enter different consist number";
                    VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
                    VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
                else
                    if (XDCONTROL.URC != 100)
                        VHTR01IW-CON-MSG.CON-MSG-1 = "left consist invalid";
                        VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
                        VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
                    end
                end
            end
        else
            VHTR01IW-CON-MSG.CON-MSG-1 = "Left consist not numeric";
            VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
            VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
        end
    else
        VHTR01IW-CON-MSG.CON-MSG-1 = "Left consist not numeric";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
    end
end 

Function VHTR01IS-VALD-LR2 () 
    if (VHTR01IW.RIGHT-CON-NO is numeric)
        if (VHTR01IW.RIGHT-CON-NO-X > 99 &&
         VHTR01IW.RIGHT-CON-NO-X < 1000)
            if (VHTR01IW.RIGHT-CON-NO != VHTR01IW.CON-NO)
                VHTR013_CRIT.CON-NO = VHTR01IW.RIGHT-CON-NO;
                try
                    call "VHTR013"(XDCONTROL, VHTR013_CRIT, VHTR013_DATA);
                
                end
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    VHTR01IW-CON-MSG.CON-MSG-1 = "Right consist is an assigned pseudo train, please enter different consist number";
                    VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
                    VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
                else
                    if (XDCONTROL.URC != 100)
                        VHTR01IW-CON-MSG.CON-MSG-1 = "right consist invalid";
                        VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
                        VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
                    end
                end
            end
        else
            VHTR01IW-CON-MSG.CON-MSG-1 = "Right consist not numeric";
            VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
            VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
        end
    else
        VHTR01IW-CON-MSG.CON-MSG-1 = "Right consist not numeric";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
    end
end 

Function VHTR01IS-VALD-LR3 () 
    set VHTR01IW-RIGHT-CON empty;
    set VHTR01IW-LEFT-CON empty;
    if (VHTR01IW.LEFT-CON-NO == " " &&
     VHTR01IW.RIGHT-CON-NO == " ")
        VHTR01IW-CON-MSG.CON-MSG-1 = "Left consist and Right consist cannot both be blank";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
    else
        if (VHTR01IW.LEFT-CON-NO == VHTR01IW.RIGHT-CON-NO)
            VHTR01IW-CON-MSG.CON-MSG-1 = "Left consist and Right consist cannot be same";
            VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
            VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
        else
            if ((VHTR01IW.LEFT-CON-NO != " " && VHTR01IW.RIGHT-CON-NO == " "))
                VHTR01IS-VALD-LR1();
            else
                if ((VHTR01IW.LEFT-CON-NO == " " && VHTR01IW.RIGHT-CON-NO != " "))
                    VHTR01IS-VALD-LR2();
                else
                    if ((VHTR01IW.LEFT-CON-NO != " " && VHTR01IW.RIGHT-CON-NO != " "))
                        VHTR01IS-VALD-LR1();
                        VHTR01IS-VALD-LR2();
                    end
                end
            end
        end
    end
end 

Function VHTR01IS-VALD-LR4 () 
    VHTR01IW-PASSVALUE.NEW-PSEUDO-CON-SIZE = VHTR01IW-PASSVALUE.LEFT-CON-SIZE + VHTR01IW-PASSVALUE.RIGHT-CON-SIZE;
    if (VHTR01IW.YRD-TRKG-YRD != VHTR014_DATA.YRD-TRKG-YRD[1])
        VHTR01IW-CON-MSG.CON-MSG-1 = "The Pseudo Train xxx location not match with the seleced location in the drop down box";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
    else
        if (VHTR01IW-PASSVALUE.NEW-PSEUDO-CON-SIZE > 10)
            VHTR01IW-CON-MSG.CON-MSG-1 = "Total consist Length cannot greater than 10";
            VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
            VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
        else
            if (VHTR011_DATA.CON-STAT == "CAR")
                VHTR01IW-CON-MSG.CON-MSG-1 = "Consist xxx status is invalid for build up";
                VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
                VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
            else
                VHTR01IW-TRIGGER.ENABLE-RECONFIG = "Y";
                VHTR01IW-LEFT-CON.LEFT-CON-NO = VHTR01IW.NEW-PSEUDO-CON-NO;
                VHTR01IS-MOVE-CAR1();
            end
        end
    end
end 

Function VHTR01IS-VALD-MORE () 

end 

Function VHTR01IS-VALD-PSEU () 
    set VHTR01IW-RIGHT-CON empty;
    set VHTR01IW-LEFT-CON empty;
    if ((VHTR01IW.LEFT-CON-NO == " " &&
     VHTR01IW.RIGHT-CON-NO == " ") ||
     (VHTR01IW.LEFT-CON-NO == " " &&
     VHTR01IW.RIGHT-CON-NO != " ") ||
     (VHTR01IW.LEFT-CON-NO != " " &&
     VHTR01IW.RIGHT-CON-NO == " "))
        VHTR01IW-CON-MSG.CON-MSG-1 = "Left consist and/or Right consist cannot be blank";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
        VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
    else
        if (VHTR01IW.LEFT-CON-NO != VHTR01IW.CON-NO)
            if (VHTR01IW.RIGHT-CON-NO != VHTR01IW.CON-NO)
                VHTR01IW-CON-MSG.CON-MSG-1 = "Either Left Consist or Right Consist have to be inservice train";
                VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
                VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
            else
  
                VHTR014_CRIT.CON-NO = VHTR01IW.LEFT-CON-NO;
                VHTR01IS-PSEUDO();
            end
        else
            if (VHTR01IW.RIGHT-CON-NO == VHTR01IW.CON-NO)
                VHTR01IW-CON-MSG.CON-MSG-1 = "Only one consist has to be inservice train";
                VHTR01IW-TRIGGER.DISABLE-RECONFIG = "Y";
                VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = "Y";
            else
                VHTR014_CRIT.CON-NO = VHTR01IW.RIGHT-CON-NO;
                VHTR01IS-PSEUDO();
  				
            end
        end
    end
end 

Function VHTR01IS-VALID-CAR ()
  
  
   
    if (VHTR01IW-LEFT-CON.LEFT-CON-NO != " ")
        VHTR015_CRIT.CON-SIZE = VHTR01IW-LEFT-CON.LEFT-CON-SIZE;
        VHTR015_CRIT.CAR-NO-1 = VHTR01IW-LEFT-CON.CAR-1;
        VHTR015_CRIT.CAR-NO-2 = VHTR01IW-LEFT-CON.CAR-2;
        VHTR015_CRIT.CAR-NO-3 = VHTR01IW-LEFT-CON.CAR-3;
        VHTR015_CRIT.CAR-NO-4 = VHTR01IW-LEFT-CON.CAR-4;
        VHTR015_CRIT.CAR-NO-5 = VHTR01IW-LEFT-CON.CAR-5;
        VHTR015_CRIT.CAR-NO-6 = VHTR01IW-LEFT-CON.CAR-6;
        VHTR015_CRIT.CAR-NO-7 = VHTR01IW-LEFT-CON.CAR-7;
        VHTR015_CRIT.CAR-NO-8 = VHTR01IW-LEFT-CON.CAR-8;
        VHTR015_CRIT.CAR-NO-9 = VHTR01IW-LEFT-CON.CAR-9;
        VHTR015_CRIT.CAR-NO-10 = VHTR01IW-LEFT-CON.CAR-10;
        try
            call "VHTR015"(XDCONTROL, VHTR015_CRIT, VHTR015_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHTR01IS-NOGO();
        end
    end
    if (VHTR01IW-RIGHT-CON.RIGHT-CON-NO != " ")
        VHTR015_CRIT.CON-SIZE = VHTR01IW-RIGHT-CON.RIGHT-CON-SIZE;
        VHTR015_CRIT.CAR-NO-1 = VHTR01IW-RIGHT-CON.CAR-1;
        VHTR015_CRIT.CAR-NO-2 = VHTR01IW-RIGHT-CON.CAR-2;
        VHTR015_CRIT.CAR-NO-3 = VHTR01IW-RIGHT-CON.CAR-3;
        VHTR015_CRIT.CAR-NO-4 = VHTR01IW-RIGHT-CON.CAR-4;
        VHTR015_CRIT.CAR-NO-5 = VHTR01IW-RIGHT-CON.CAR-5;
        VHTR015_CRIT.CAR-NO-6 = VHTR01IW-RIGHT-CON.CAR-6;
        VHTR015_CRIT.CAR-NO-7 = VHTR01IW-RIGHT-CON.CAR-7;
        VHTR015_CRIT.CAR-NO-8 = VHTR01IW-RIGHT-CON.CAR-8;
        VHTR015_CRIT.CAR-NO-9 = VHTR01IW-RIGHT-CON.CAR-9;
        VHTR015_CRIT.CAR-NO-10 = VHTR01IW-RIGHT-CON.CAR-10;
        try
            call "VHTR015"(XDCONTROL, VHTR015_CRIT, VHTR015_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHTR01IS-NOGO();
        end
    end
end 

Function VHTR01IS-VALID-CON ()
  
   
    VHTR01IW-TRIGGER.CON-ERROR = "N";
  
  
    VHTR01IW.LEFT-CON-NO = VHTR01IW.CON-NO;
  
    set VHTR01IW-CON-MSG empty;
    if (VHTR01IW.CON-NO is numeric)
        if (VHTR01IW.CON-NO-X > 99 &&
         VHTR01IW.CON-NO-X < 1000)
  
            VHTR011_CRIT.CON-NO = VHTR01IW.CON-NO;
            try
                call "VHTR011"(XDCONTROL, VHTR011_CRIT, VHTR011_DATA);
            
            end
            if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
             (VHTR011_CRIT.NO-RECORD-FOUND == "N"))
                VHTR01IW-PASSVALUE.DATE-INSRV-REV = VHTR011_DATA.DATE-INSRV-REV;
                VHTR01IW-PASSVALUE.TIME-INSRV-X = VHTR011_DATA.TIME-INSRV;
  
                if (VHTR011_DATA.CON-STAT[1] == "OUT" ||
                 VHTR011_DATA.CON-STAT[1] == "SWP")
                    VHTR01IW-TRIGGER.CON-NOT-INSRV = "Y";
                    VHTR01IW-TRIGGER.CON-ERROR = "Y";
                else
                    if (VHTR011_DATA.CON-STAT[1] == "CON")
                        VHTR01IW-TRIGGER.CON-TRBL = "Y";
                        VHTR01IW-TRIGGER.CON-ERROR = "Y";
                    else
                        if (VHTR011_DATA.CON-STAT[1] == "SRV" ||
                         VHTR011_DATA.CON-STAT[1] == "CAR")
                            VHTR01IS-MOVE-CAR();
  
  
  
                        else
                            VHTR01IW-TRIGGER.CON-STAT-ERROR = "Y";
                            VHTR01IW-TRIGGER.CON-ERROR = "Y";
                        end
                    end
                end
            else
                if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
                 (VHTR011_CRIT.NO-RECORD-FOUND == "Y"))
  
                    VHTR01IW-TRIGGER.CON-ERROR = "Y";
                    VHTR01IW-TRIGGER.CON-NOT-EXIST = "Y";
                end
            end
        else
            VHTR01IW-TRIGGER.CON-NUMERIC-ERR = "Y";
            VHTR01IW-TRIGGER.CON-ERROR = "Y";
        end
    else
        VHTR01IW-TRIGGER.CON-NUMERIC-ERR = "Y";
        VHTR01IW-TRIGGER.CON-ERROR = "Y";
    end
end 

Function VHTR01IS-VALID-TME () 
    move TIME-OUTSRV-HH to TIME-OUTSRV-HH-X withV60Compat;
    move TIME-OUTSRV-MM to TIME-OUTSRV-MM-X withV60Compat;
    move TIME-OUTSRV-HH to TIME-OUTSRV-HH-Y withV60Compat;
    move TIME-OUTSRV-MM to TIME-OUTSRV-MM-Y withV60Compat;
    if (VHTR01IW.TIME-OUTSRV-HH is numeric)
        if (VHTR01IW.TIME-OUTSRV-HH-X < 00 ||
         VHTR01IW.TIME-OUTSRV-HH-X > 23)
            VHTR01IW-TRIGGER.TIME-OUT-RANGE = "Y";
            VHTR01IW-TRIGGER.TIME-ERROR-X = "Y";
        else
            if (VHTR01IW.TIME-OUTSRV-MM is numeric)
                if (VHTR01IW.TIME-OUTSRV-MM-X < 00 ||
                 VHTR01IW.TIME-OUTSRV-MM-X > 59)
                    VHTR01IW-TRIGGER.TIME-OUT-RANGE = "Y";
                    VHTR01IW-TRIGGER.TIME-ERROR-X = "Y";
                end
            else
                VHTR01IW-TRIGGER.TIME-NOT-NUMERIC = "Y";
                VHTR01IW-TRIGGER.TIME-ERROR-X = "Y";
            end
        end
    else
        VHTR01IW-TRIGGER.TIME-NOT-NUMERIC = "Y";
        VHTR01IW-TRIGGER.TIME-ERROR-X = "Y";
    end
end 

Function VHTR01IS-YRD-LOC () 
    VHTR01IW.COUNTER = 1;
    VHTR01IW-PASSVALUE.YRD-IDX = 0;
    while (VHTR01IW.COUNTER <= XDCONTROL.UROWCNT)
        if (VHLT010_DATA.YRD[VHTR01IW.COUNTER] == VHLT010_CRIT.YRD-TRKG-YRD)
            VHTR01IW-PASSVALUE.YRD-IDX = VHTR01IW.COUNTER;
            VHTR01IW.COUNTER = VHTR01IW.COUNTER + 1;
        end
        VHTR01IW.COUNTER = VHTR01IW.COUNTER + 1;
    end
end 

Function VHTS01IS-ADD ()
  
  
  

  
  

   
    VHTS01IW-TRIGGER.TO-ERROR = " ";
    VHTS01W_DATA.SWAP-OK = "Y";
    VHTS01W_DATA.LAST-EQ-FIRST = "N";
    VHTS01IW-CHK-SAME.CON-TO-SAVE = VHTS01W_DATA.CON-TO;
    VHTS01IW-CHK-SAME.CON-FROM-SAVE = VHTS01W_DATA.CON-FROM;
    

  
  
  
  
    if (VHTS01IW-CON-LIST.CON-INDEX == 20)
        VHTS01W_DATA.SWAP-OK = "N";
        VHTS01IW-MSG.MSG = "The number of swaps allowed has exceeded 20. Train swap stopped.";
        VHTS01IW-TRIGGER.DISABLE-FROMCON = "Y";
        VHTS01IW-TRIGGER.DISABLE-TOCON = "Y";
        VHTS01IW-TRIGGER.DISABLE-SWAP = "Y";
        VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
        return;
    end


  
  
    if (VHTS01IW-CON-LIST.CON-INDEX == 0) 
        if (VHTS01W_DATA.CON-FROM == " ")
            VHTS01W_DATA.SWAP-OK = "N";
            VHTS01IW-MSG.MSG = "FROM Consist No cannot be blank";
            VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
            VHTS01IW-TRIGGER.FROMCON-SETFOCUS = "Y";
            return;
        else
            if (VHTS01W_DATA.CON-FROM not numeric)
                VHTS01W_DATA.SWAP-OK = "N";
                VHTS01IW-MSG.MSG = "FROM Consist No not valid";
                VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
                VHTS01IW-TRIGGER.FROMCON-SETFOCUS = "Y";
                return;
            else
                if (VHTS01W_DATA.CON-FROM-N >= 100 && VHTS01W_DATA.CON-FROM-N <= 999)
                    VHTS01W_DATA.SWAP-OK = "Y";
                else
                    VHTS01W_DATA.SWAP-OK = "N";
                    VHTS01IW-MSG.MSG = "Invalid FROM Consist No - out of range";
                    VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
                    VHTS01IW-TRIGGER.FROMCON-SETFOCUS = "Y";
                    return;
                end
            end
        end
    end
    if (VHTS01W_DATA.SWAP-OK == "Y")
  
        if (VHTS01W_DATA.CON-TO == " ")
            VHTS01W_DATA.SWAP-OK = "N";
            VHTS01IW-MSG.MSG = "TO Consist No cannot be blank";
            VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
            VHTS01IW-TRIGGER.TOCON-SETFOCUS = "Y";
            return;
        else
            if (VHTS01W_DATA.CON-TO not numeric)
                VHTS01W_DATA.SWAP-OK = "N";
                VHTS01IW-MSG.MSG = "TO Consist No not valid";
                VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
                VHTS01IW-TRIGGER.TOCON-SETFOCUS = "Y";
                return;
            else
                if (VHTS01W_DATA.CON-TO-N >= 100 && VHTS01W_DATA.CON-TO-N <= 999)
                    VHTS01W_DATA.SWAP-OK = "Y";
                else
                    VHTS01W_DATA.SWAP-OK = "N";
                    VHTS01IW-MSG.MSG = "Invalid TO Consist No - out of range";
                    VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
                    VHTS01IW-TRIGGER.TOCON-SETFOCUS = "Y";
                    return;
                end
            end
        end
    end
    if (VHTS01W_DATA.SWAP-OK == "Y")
        if (VHTS01W_DATA.CON-FROM == VHTS01W_DATA.CON-TO)
            VHTS01W_DATA.SWAP-OK = "N";
            VHTS01IW-MSG.MSG = "To Consist No. cannot be same as the From Consist No.";
            VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
            VHTS01IW-TRIGGER.TOCON-SETFOCUS = "Y";
            return;
        end
    end

  
    if (VHTS01W_DATA.SWAP-OK == "Y")
        VHTS01W_DATA.VAGen_EXISTS = "N";
        VHXCONB_CRIT.CON-NO = VHTS01W_DATA.CON-FROM;
        

    
        VHTS01IS-GET-CONS();
        if (VHTS01W_DATA.FOUND-CON == "Y")
            if (VHXCONB_DATA.CON-STAT[1] == "CON")
                VHTS01W_DATA.SWAP-OK = "N";
                VHTS01IW-MSG.MSG = "Swap Invalid - Train Incident present.";
                VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
                VHTS01IW-TRIGGER.FROMCON-SETFOCUS = "Y";
                return;
            else
                if (VHTS01W_DATA.CON-TO in VHTS01IW-CON-LIST.FROM-CON-NO &&
                 VHTS01IW-CON-LIST.FROM-CON-NO[1] != VHTS01W_DATA.CON-TO)
                    VHTS01W_DATA.SWAP-OK = "N";
                    VHTS01IW-MSG.MSG = "Same consist  number in chain sequence cannot be used.";
                    VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
                    VHTS01IW-TRIGGER.TOCON-SETFOCUS = "Y";
                    return;
                end
            end
            VHTS01IS-MOVE-CONS(); 
            VHTS01W_DATA.VAGen_EXISTS = "Y";
            VHTS01W_DATA.SWAP-OK = "Y";
        else
            VHTS01W_DATA.VAGen_EXISTS = "N";
            VHTS01W_DATA.SWAP-OK = "N";
            VHTS01IW-MSG.MSG = "From Consist is not valid";
            VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
            VHTS01IW-TRIGGER.FROMCON-SETFOCUS = "Y";
            return;
        end 
    end 
  

  

  
    if (VHTS01W_DATA.SWAP-OK == "Y")
        if (VHTS01W_DATA.CON-TO in VHTS01IW-CON-LIST.TO-CON-NO)
            VHTS01W_DATA.SWAP-OK = "N";
            VHTS01IW-MSG.MSG = "TO consist is already in the list of swapped consists";
            VHTS01IW-CON-LIST.DATA-RECORD[CON-INDEX] = " "; 
            CON-INDEX = CON-INDEX - 1; 
            VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
            VHTS01IW-TRIGGER.TOCON-SETFOCUS = "Y";
            return;
        end
    end

  
  
  
    if (VHTS01W_DATA.SWAP-OK == "Y")
        VHTS01W_DATA.FOUND-CON = "N";
        VHTS01W_DATA.VAGen_EXISTS = "N";
        VHXCONB_CRIT.CON-NO = VHTS01W_DATA.CON-TO;
        VHTS01IS-GET-CONS(); 
                                   
    
        if (VHTS01W_DATA.FOUND-CON == "X")
            VHTS01W_DATA.SWAP-OK = "N";
            VHTS01IW-MSG.MSG = "Consist NEVER EXISTED, cannot swap";
            VHTS01IW-CON-LIST.DATA-RECORD[CON-INDEX] = " "; 
            CON-INDEX = CON-INDEX - 1; 
            VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
            VHTS01IW-TRIGGER.TOCON-SETFOCUS = "Y";
            return;
        end
  
        if (VHTS01W_DATA.FOUND-CON == "Y")
            VHTS01W_DATA.VAGen_EXISTS = "Y";
            VHTS01W_DATA.SWAP-OK = "Y";
            VHTS01IW-CON-LIST.TO-CON-NO[CON-INDEX] = VHTS01W_DATA.CON-TO;
            VHTS01IW-CON-LIST.TO-DASH[CON-INDEX] = "-";
            
      
      
      
            VHTS01IW-CON-LIST.TO-CON-DASH-N[CON-INDEX] = VHXCONB_DATA.DASH-NO[1] + 1;
            VHTS01IS-VALID-CON(); 
            if (VHTS01IW-TRIGGER.TO-ERROR == "Y")
                VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
                VHTS01IW-TRIGGER.TOCON-SETFOCUS = "Y";
                return;
            else
                if (VHTS01IW-TRIGGER.TO-ERROR == "N")
                    VHTS01IW-TRIGGER.ENABLE-UPDATE = "Y";
                else
                    VHTS01IW-TRIGGER.ENABLE-UPDATE = "N";
                end
            end
        end

  
  
  
        if (VHTS01W_DATA.FOUND-CON == "N")
            if (VHTS01W_DATA.CON-TO in VHTS01IW-CON-LIST.FROM-CON-NO)
                VHTS01W_DATA.SWAP-OK = "N";
                VHTS01IW-MSG.MSG = "Same consist  number in chain sequence cannot be used";
                VHTS01IW-TRIGGER.DISABLE-UPDATE = "N";
                VHTS01IW-CON-LIST.DATA-RECORD[CON-INDEX] = " "; 
                CON-INDEX = CON-INDEX - 1; 
                VHTS01IW-TRIGGER.TOCON-SETFOCUS = "Y";
                return;
            end
      
            VHTS01IS-CHECK();
            if (VHTS1A9_DATA.VAGen_FOUND == "Y") 
                VHTS01IW-MSG.MSG = "TO Consist NOT in Service, Swap Stopped. Press UPDATE to Complete";
                VHTS01IW-TRIGGER.ENABLE-UPDATE = "Y";
                DISABLE-FROMCON = "Y";
                DISABLE-TOCON = "Y";
                UPDATE-SETFOCUS = "Y";
                DISABLE-SWAP = "Y";
                VHTS01W_DATA.VAGen_EXISTS = "N";
                VHTS01W_DATA.SWAP-OK = "Y";
                VHTS01IW-CON-LIST.TO-CON-NO[CON-INDEX] = VHTS01W_DATA.CON-TO;
                VHTS01IW-CON-LIST.TO-DASH[CON-INDEX] = "-";
                VHTS01IW-CON-LIST.TO-CON-DASH-N[CON-INDEX] = VHTS1A9_DATA.MAX-DASH-NO + 1;
            else
                VHTS01IW-MSG.MSG = "PROBLEM EXISTS READING THE CONSIST FILE FOR DASH NO";
                VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
                return;
            end
        end 
    end 

  

  
    if (VHTS01IW-TRIGGER.ENABLE-UPDATE == "N" && VHTS01W_DATA.FOUND-CON != "X"
    )
        VHTS01W_DATA.CON-FROM = VHTS01W_DATA.CON-TO;
        VHTS01W_DATA.CON-TO = "     ";
    end
end 

Function VHTS01IS-CHECK ()
  
  
  
  
  
  
  
  
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHTS01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHTS1A9";
    set VHTS1A9_DATA empty;

  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHXREVA_DATA.REVENUE-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHTS1A9_CRIT.DATE-INSRV-REV = XXDATEW.DATE-YYYY-MM-DD;
