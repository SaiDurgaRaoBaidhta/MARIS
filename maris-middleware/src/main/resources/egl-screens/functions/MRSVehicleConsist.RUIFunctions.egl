Function VHLT01IS-OSRV-TIME () 
    VHLT01IW.TIME-INSRV-HH-Y = VHLT01IW-PASSVALUE.TIME-INSRV-X-HH;
    VHLT01IW.TIME-INSRV-MM-Y = VHLT01IW-PASSVALUE.TIME-INSRV-X-MM;
    VHLT01IW.TIME-OUTSRV-HH-Y = VHLT01IW.TIME-OUTSRV-HH-X;
    VHLT01IW.TIME-OUTSRV-MM-Y = VHLT01IW.TIME-OUTSRV-MM-X;
    if (TIME-OUTSRV-HH-Y >= 00 &&
     TIME-OUTSRV-HH-Y <= 02)
        TIME-OUTSRV-HH-Y = TIME-OUTSRV-HH-Y + 24;
    end
    if (TIME-INSRV-HH-Y >= 00 &&
     TIME-INSRV-HH-Y <= 02)
        TIME-INSRV-HH-Y = TIME-INSRV-HH-Y + 24;
    end
    if (TIME-OUTSRV-HH-Y < TIME-INSRV-HH-Y)
        VHLT01IW-TRIGGER.TIME-OUT-ERROR = "Y";
        VHLT01IW-TRIGGER.CON-ERROR = "Y";
        VHLT01IW-TRIGGER.TIME-OUT-ERR = "Y";
    else
        if (TIME-OUTSRV-HH-Y == TIME-INSRV-HH-Y)
            if (TIME-OUTSRV-MM-Y < TIME-INSRV-MM-Y)
                VHLT01IW-TRIGGER.TIME-OUT-ERROR = "Y";
                VHLT01IW-TRIGGER.CON-ERROR = "Y";
                VHLT01IW-TRIGGER.TIME-OUT-ERR = "Y";
            end
        end
    end
end 

Function VHLT01IS-OTIME () 
    VHLT01IS-CLEAR-CAR();
  
  
  
    VHLT01IW-PASSVALUE.TIME-INSRV = VHLT009_DATA.TIME-INSRV;
    
  
  
    VHLT01IS-RUN-TIME();
    VHLT01IS-VALD-CAR();
    VHLT01IS-UPD-CON();
end 

Function VHLT01IS-PM-HRS () 
    VHLT01IW-PASSVALUE.HRS-FROM-LAST-PM = VHLT01IW-PASSVALUE.HRS-FROM-LAST-PM + DIFF-HH;
    if (DIFF-MM > 29)
        VHLT01IW-PASSVALUE.HRS-FROM-LAST-PM = VHLT01IW-PASSVALUE.HRS-FROM-LAST-PM + 1;
    end
    VHLT01IW-PASSVALUE.HRS-TO-NEXT-PM = VHLT01IW-PASSVALUE.HRS-TO-NEXT-PM-MAX - VHLT01IW-PASSVALUE.HRS-FROM-LAST-PM;
end 

Function VHLT01IS-PROCESS () 
    VHLT01IS-CLEAR-MSG();
    VHLT01IS-CONV-TIME();
    VHLT01IS-VALID-LOC();
  
  
    if (VHLT01IW-TRIGGER.TIME-ERROR-X == "N" &&
     VHLT01IW-TRIGGER.YARD-ERROR == "N" &&
     VHLT01IW-TRIGGER.YARD-SUB-LOC-ERROR == "N")
        VHLT01IS-VALID-CON();
    end
end 

Function VHLT01IS-RUN-TIME ()
  
  
   
    VHLT01IW-PASSVALUE.WS-TIME-OUTSRV-HH = VHLT01IW.TIME-OUTSRV-HH;
    VHLT01IW-PASSVALUE.WS-TIME-OUTSRV-MM = VHLT01IW.TIME-OUTSRV-MM;
    VHLT01IW-PASSVALUE.WS-TIME-OUTSRV-SS = VHLT01IW.TIME-OUTSRV-SS;
    VHLT01IW-PASSVALUE.WS-TIME-INSRV-HH = VHLT01IW-PASSVALUE.TIME-INSRV-HH;
    VHLT01IW-PASSVALUE.WS-TIME-INSRV-MM = VHLT01IW-PASSVALUE.TIME-INSRV-MM;
    VHLT01IW-PASSVALUE.WS-TIME-INSRV-SS = VHLT01IW-PASSVALUE.TIME-INSRV-SS;
    if (VHLT01IW-PASSVALUE.WS-TIME-OUTSRV-HH <
     VHLT01IW-PASSVALUE.TIME-REV-START-HH)
        WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 24;
    else
        if (VHLT01IW-PASSVALUE.WS-TIME-OUTSRV-HH ==
         VHLT01IW-PASSVALUE.TIME-REV-START-HH && WS-TIME-OUTSRV-MM < TIME-REV-START-MM)
            WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 24;
        end
    end
    if (VHLT01IW-PASSVALUE.WS-TIME-INSRV-HH <
     VHLT01IW-PASSVALUE.TIME-REV-START-HH)
        WS-TIME-INSRV-HH = WS-TIME-INSRV-HH + 24;
    else
        if (VHLT01IW-PASSVALUE.WS-TIME-INSRV-HH ==
         VHLT01IW-PASSVALUE.TIME-REV-START-HH && WS-TIME-INSRV-MM < TIME-REV-START-MM)
            WS-TIME-INSRV-HH = WS-TIME-INSRV-HH + 24;
        end
    end
    if (VHLT01IW-PASSVALUE.WS-TIME-OUTSRV-MM <
     VHLT01IW-PASSVALUE.WS-TIME-INSRV-MM)
        WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM + 60;
        WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH - 1;
    end
    if (WS-TIME-OUTSRV-HH >= WS-TIME-INSRV-HH)
        DIFF-HH = WS-TIME-OUTSRV-HH - WS-TIME-INSRV-HH;
        DIFF-MM = WS-TIME-OUTSRV-MM - WS-TIME-INSRV-MM;
    else
        if (WS-TIME-OUTSRV-HH < WS-TIME-INSRV-HH)
            if (WS-TIME-OUTSRV-MM > 59)
                WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM - 60;
                WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 1;
            end
            if (WS-TIME-INSRV-MM < WS-TIME-OUTSRV-MM)
                WS-TIME-INSRV-MM = WS-TIME-INSRV-MM + 60;
                WS-TIME-INSRV-HH = WS-TIME-INSRV-HH - 1;
            end
            DIFF-HH = WS-TIME-OUTSRV-HH - WS-TIME-INSRV-HH;
            DIFF-MM = WS-TIME-OUTSRV-MM - WS-TIME-INSRV-MM;
            DIFF-HH = DIFF-HH * -1;
            DIFF-MM = DIFF-MM * -1;
        end
    end
    VHLT01IW-CON-MSG.CON-MSG-HH = DIFF-HH;
    VHLT01IW-CON-MSG.CON-MSG-MM = DIFF-MM;
end 

Function VHLT01IS-SPLIT () 
    VHLT01IS-SPLIT-TME();
    VHLT01IW-PASSVALUE.END-CAR-HRS = VHLT01IW-PASSVALUE.END-CAR-HRS + DIFF-HH-SPLIT-END;
    VHLT01IW-PASSVALUE.END-CAR-MIN = VHLT01IW-PASSVALUE.END-CAR-MIN + DIFF-MM-SPLIT-END;
    if (VHLT01IW-PASSVALUE.END-CAR-MIN > 59)
        VHLT01IW-PASSVALUE.END-CAR-HRS = VHLT01IW-PASSVALUE.END-CAR-HRS + 1;
        VHLT01IW-PASSVALUE.END-CAR-MIN = VHLT01IW-PASSVALUE.END-CAR-MIN - 60;
    end
    VHLT01IW-PASSVALUE.MID-CAR-HRS = VHLT01IW-PASSVALUE.MID-CAR-HRS + DIFF-HH-SPLIT-MID;
    VHLT01IW-PASSVALUE.MID-CAR-MIN = VHLT01IW-PASSVALUE.MID-CAR-MIN + DIFF-MM-SPLIT-MID;
    if (VHLT01IW-PASSVALUE.MID-CAR-MIN > 59)
        VHLT01IW-PASSVALUE.MID-CAR-HRS = VHLT01IW-PASSVALUE.MID-CAR-HRS + 1;
        VHLT01IW-PASSVALUE.MID-CAR-MIN = VHLT01IW-PASSVALUE.MID-CAR-MIN - 60;
    end
end 

Function VHLT01IS-SPLIT-TME ()
  
  
  
  
   
    VHLT01IW-PASSVALUE.WS-TIME-END-CAR-HH = VHLT01IW-PASSVALUE.TIME-END-CAR-HH;
    VHLT01IW-PASSVALUE.WS-TIME-END-CAR-MM = VHLT01IW-PASSVALUE.TIME-END-CAR-MM;
    VHLT01IW-PASSVALUE.WS-TIME-END-CAR-SS = VHLT01IW-PASSVALUE.TIME-END-CAR-SS;
  
  
  
    VHLT01IW-PASSVALUE.WS-TIME-INSRV-HH = VHLT01IW-PASSVALUE.TIME-INSRV-HH;
    VHLT01IW-PASSVALUE.WS-TIME-INSRV-MM = VHLT01IW-PASSVALUE.TIME-INSRV-MM;
    VHLT01IW-PASSVALUE.WS-TIME-INSRV-SS = VHLT01IW-PASSVALUE.TIME-INSRV-SS;
  
    if (VHLT01IW-PASSVALUE.WS-TIME-OUTSRV-MM <
     VHLT01IW-PASSVALUE.WS-TIME-END-CAR-MM)
        WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM + 60;
        WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH - 1;
    end
    if (WS-TIME-OUTSRV-HH >= WS-TIME-END-CAR-HH)
        DIFF-HH-SPLIT-END = WS-TIME-OUTSRV-HH - WS-TIME-END-CAR-HH;
        DIFF-MM-SPLIT-END = WS-TIME-OUTSRV-MM - WS-TIME-END-CAR-MM;
    else
        if (WS-TIME-OUTSRV-HH < WS-TIME-END-CAR-HH)
            if (WS-TIME-OUTSRV-MM > 59)
                WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM - 60;
                WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 1;
            end
            if (WS-TIME-END-CAR-MM < WS-TIME-OUTSRV-MM)
                WS-TIME-END-CAR-MM = WS-TIME-END-CAR-MM + 60;
                WS-TIME-END-CAR-HH = WS-TIME-END-CAR-HH - 1;
            end
            DIFF-HH-SPLIT-END = WS-TIME-OUTSRV-HH - WS-TIME-END-CAR-HH;
            DIFF-MM-SPLIT-END = WS-TIME-OUTSRV-MM - WS-TIME-END-CAR-MM;
            
  
  
        end
    end
  
  
  
  
  
  
    if (VHLT01IW-PASSVALUE.WS-TIME-END-CAR-MM <
     VHLT01IW-PASSVALUE.WS-TIME-INSRV-MM)
        WS-TIME-END-CAR-MM = WS-TIME-END-CAR-MM + 60;
        WS-TIME-END-CAR-HH = WS-TIME-END-CAR-HH - 1;
    end
  
    if (WS-TIME-END-CAR-HH >= WS-TIME-INSRV-HH)
  		
        DIFF-HH-SPLIT-MID = WS-TIME-END-CAR-HH - WS-TIME-INSRV-HH;
  		
        DIFF-MM-SPLIT-MID = WS-TIME-END-CAR-MM - WS-TIME-INSRV-MM;
    else
  		
        if (WS-TIME-END-CAR-HH < WS-TIME-INSRV-HH)
            if (WS-TIME-INSRV-MM > 59)
                WS-TIME-INSRV-MM = WS-TIME-INSRV-MM - 60;
                WS-TIME-INSRV-HH = WS-TIME-INSRV-HH + 1;
            end
            if (WS-TIME-END-CAR-MM < WS-TIME-INSRV-MM)
                WS-TIME-END-CAR-MM = WS-TIME-END-CAR-MM + 60;
                WS-TIME-END-CAR-HH = WS-TIME-END-CAR-HH - 1;
            end
  			
            DIFF-HH-SPLIT-MID = WS-TIME-END-CAR-HH - WS-TIME-INSRV-HH;
  			
            DIFF-MM-SPLIT-MID = WS-TIME-END-CAR-MM - WS-TIME-INSRV-MM;
            DIFF-HH-SPLIT-END = DIFF-HH * -1;
            
  			
        end
    end
end 

Function VHLT01IS-STATUS () 
    if (VHLT01IW-PASSVALUE.VEH-STAT == "ERROR")
        VHLT01IW-PASSVALUE.VEH-STAT = VHLT01IW-PASSVALUE.VEH-STAT-PREV;
        VHLT01IW-PASSVALUE.VEH-STAT-PREV = " ";
        VHLT01IW-PASSVALUE.STAT-CHG-SW = "Y";
    else
        if (VHLT01IW-PASSVALUE.VEH-STAT == "USABLE")
            VHLT01IS-INCD-STAT();
            VHLT01IW-PASSVALUE.VEH-STAT-PREV = VHLT01IW-PASSVALUE.VEH-STAT;
            VHLT01IW-PASSVALUE.VEH-STAT = "NO GO";
            VHLT01IW-PASSVALUE.STAT-CHG-SW = "Y";
            VHLT01IW-PASSVALUE.NO-GO-IND = "Y";
        else
            VHLT01IW-PASSVALUE.STAT-CHG-SW = "N";
            VHLT01IS-CHK-DVS();
        end
    end
end 

Function VHLT01IS-SVC-HIST ()
   
    if (VHLT01IW-TRIGGER.YES-SPLIT == "Y")
        END-CAR-HRS-HIST = END-CAR-HRS-HIST + DIFF-HH-SPLIT-END;
        END-CAR-MIN-HIST = END-CAR-MIN-HIST + DIFF-MM-SPLIT-END;
        if (END-CAR-MIN-HIST > 59)
            END-CAR-HRS-HIST = END-CAR-HRS-HIST + 1;
            END-CAR-MIN-HIST = END-CAR-MIN-HIST - 60;
        end
        MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + DIFF-HH-SPLIT-MID;
        MID-CAR-MIN-HIST = MID-CAR-MIN-HIST + DIFF-MM-SPLIT-MID;
        if (MID-CAR-MIN-HIST > 59)
            MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + 1;
            MID-CAR-MIN-HIST = MID-CAR-MIN-HIST - 60;
        end
    else
        if (END-CAR-SW == "Y")
            END-CAR-HRS-HIST = END-CAR-HRS-HIST + DIFF-HH;
            END-CAR-MIN-HIST = END-CAR-MIN-HIST + DIFF-MM;
            if (END-CAR-MIN-HIST > 59)
                END-CAR-HRS-HIST = END-CAR-HRS-HIST + 1;
                END-CAR-MIN-HIST = END-CAR-MIN-HIST - 60;
            end
        end
        if (MID-CAR-SW == "Y")
            MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + DIFF-HH;
            MID-CAR-MIN-HIST = MID-CAR-MIN-HIST + DIFF-MM;
            if (MID-CAR-MIN-HIST > 59)
                MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + 1;
                MID-CAR-MIN-HIST = MID-CAR-MIN-HIST - 60;
            end
        end
    end
end 

Function VHLT01IS-SVC-HIT1 () 
    VHLT01IW-SVR-REC.CURR-CAR-HRS = VHLT01IW-SVR-REC.CURR-CAR-HRS + DIFF-HH;
    VHLT01IW-SVR-REC.CURR-CAR-MIN = VHLT01IW-SVR-REC.CURR-CAR-MIN + DIFF-MM;
    if (VHLT01IW-SVR-REC.CURR-CAR-MIN > 59)
        VHLT01IW-SVR-REC.CURR-CAR-HRS = VHLT01IW-SVR-REC.CURR-CAR-HRS + 1;
        VHLT01IW-SVR-REC.CURR-CAR-MIN = VHLT01IW-SVR-REC.CURR-CAR-MIN - 60;
    end
end 

Function VHLT01IS-TIME () 
    try
        call "VHTR012"(XDCONTROL, VHTR012_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHLT01IW.TIME-OUTSRV = VHTR012_DATA.CURRENT-TIME;
    end
end 

Function VHLT01IS-TIME-MSG () 
    if (VHLT01IW-TRIGGER.TIME-NOT-NUMERIC == "Y")
        VHLT01IW-TIME-MSG.MSG-1 = "TIME OUT OF SERVICE SHOULD BE NUMERIC";
        VHLT01IW-TRIGGER.TIME-NOT-NUMERIC = " ";
    end
    if (VHLT01IW-TRIGGER.TIME-OUT-RANGE == "Y")
        VHLT01IW-TIME-MSG.MSG-1 = "TIME HOURS SHOULD BETWEEN 00-23, TIME MINUTES SHOULD BETWEEN 00-59";
        VHLT01IW-TRIGGER.TIME-OUT-RANGE = " ";
    end
    if (VHLT01IW-TRIGGER.TIME-ERROR == "Y")
        VHLT01IW-TIME-MSG.MSG-1 = "TIME OUT OF SERVICE SHOULD NOT BE BLANK";
        VHLT01IW-TRIGGER.TIME-ERROR = " ";
    end
    if (VHLT01IW-TRIGGER.TIME-OUT-ERROR == "Y")
        VHLT01IW-TIME-MSG.MSG-3 = "Out-of-Service time must be greater than In-Service time";
        VHLT01IW-TIME-MSG.MSG-3-XX-1 = VHLT01IW.TIME-INSRV-HH-Y;
        VHLT01IW-TIME-MSG.MSG-3-XX-2 = ":";
        VHLT01IW-TIME-MSG.MSG-3-XX-3 = VHLT01IW.TIME-INSRV-MM-Y;
        VHLT01IW-TIME-MSG.MSG-1 = VHLT01IW-TIME-MSG.MSG-3;
        VHLT01IW-TRIGGER.TIME-OUT-ERROR = " ";
    end
    if (VHLT01IW-TRIGGER.MADE-IN-ERROR-SW == "Y")
        VHLT01IW-TIME-MSG.MSG-1 = "MADE IN ERROR SHOULD BE Y OR N";
        VHLT01IW-TRIGGER.MADE-IN-ERROR-SW = " ";
    end
    if (VHLT01IW-TRIGGER.YARD-LOC-BLANK == "Y")
        VHLT01IW-TIME-MSG.MSG-1-XX = "-LOC INVALID";
        VHLT01IW-TIME-MSG.MSG-1-X = VHLT01IW.YARD-LOC;
        VHLT01IW-TRIGGER.YARD-LOC-BLANK = " ";
    end
    if (VHLT01IW-TRIGGER.YARD-SUB-LOC-BLANK == "Y")
        VHLT01IW-TIME-MSG.MSG-1-XX = "-TRANSFER/STORAGE TRACK INVALID";
        VHLT01IW-TIME-MSG.MSG-1-X = VHLT01IW.YARD-LOC;
        VHLT01IW-TRIGGER.YARD-SUB-LOC-BLANK = " ";
    end
end 

Function VHLT01IS-TRAIN () 
    VHLT009_CRIT.CON-NO = VHLT01IW.CON-NO;
    try
        call "VHLT009"(XDCONTROL, VHLT009_CRIT, VHLT009_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
     (VHLT009_CRIT.NO-RECORD-FOUND == "N"))
        VHLT01IW-PASSVALUE.DATE-INSRV-REV = VHLT009_DATA.DATE-INSRV-REV;
        VHLT01IW-PASSVALUE.TIME-INSRV-X = VHLT009_DATA.TIME-INSRV;
  
        if (VHLT009_DATA.CON-STAT == "OUT" ||
         VHLT009_DATA.CON-STAT == "SWP")
            VHLT01IW-TRIGGER.PSEUDO-CON-ERROR = "Y";
            VHLT01IW-TRIGGER.DISABLE-LAY-UP = "Y";
            VHLT01IW-CON-MSG.CON-MSG-1 = "Consist not In Service";
             
        else
            if (VHLT009_DATA.CON-STAT == "CAR")
                VHLT01IW-TRIGGER.PSEUDO-CON-ERROR = "Y";
                VHLT01IW-TRIGGER.DISABLE-LAY-UP = "Y";
                VHLT01IW-CON-MSG.CON-MSG-1 = "Cannot Create Pseudo Train, Car incident present";
            else
                if (VHLT009_DATA.CON-STAT == "CON")
                    VHLT01IW-TRIGGER.PSEUDO-CON-ERROR = "Y";
                    VHLT01IW-TRIGGER.DISABLE-LAY-UP = "Y";
                    VHLT01IW-CON-MSG.CON-MSG-1 = "Cannot Create Pseudo Train, Train incident Present";
                else
                    if (VHLT009_DATA.CON-STAT == "SRV")
                        VHLT01IS-VALID-PSE();
                        if (VHLT01IW-TRIGGER.PSEUDO-CON-ERROR == "Y")
                            VHLT01IW-TRIGGER.DISABLE-LAY-UP = "Y";
                            VHLT01IW-CON-MSG.CON-MSG-1 = "Cannot create pseudo train NO GO cars present";
                        else
                            VHLT01IS-VALID-PS1();
                            if (VHLT01IW-TRIGGER.PSEUDO-CON-ERROR == "Y")
                                VHLT01IW-TRIGGER.DISABLE-LAY-UP = "Y";
                                VHLT01IW-CON-MSG.CON-MSG-5-1 = "Pseudo Train, ";
                                VHLT01IW-CON-MSG.CON-MSG-5-2 = VHLT01IW.CON-NO;
                                VHLT01IW-CON-MSG.CON-MSG-5-3 = ", already exists at: ";
                                VHLT01IW-CON-MSG.CON-MSG-5-4 = VHLT022_DATA.YRD-TRKG-YRD;
                                VHLT01IW-CON-MSG.CON-MSG-5-5 = VHLT022_DATA.YRD-SUB-LOC;
                                VHLT01IW-CON-MSG.CON-MSG-1 = VHLT01IW-CON-MSG.CON-MSG-5;
                            else
                                VHLT01IW-TRIGGER.ENABLE-LAY-UP = "Y";
                                VHLT01IW.PSEUDO-CON-NO = VHLT01IW.CON-NO;
                            end
                        end
                    end
                end
            end
        end
    end
end 

