end 

Function VHLT01IS-VALD-CAR () 
    if (LAST-CAR-NO-10 == "Y")
        VHLT01IS-CAL10();
        VHLT01IS-CAL9();
        VHLT01IS-CAL8();
        VHLT01IS-CAL7();
        VHLT01IS-CAL6();
        VHLT01IS-CAL5();
        VHLT01IS-CAL4();
        VHLT01IS-CAL3();
        VHLT01IS-CAL2();
        VHLT01IS-CAL1();
    else
        if (LAST-CAR-NO-9 == "Y")
            VHLT01IS-CAL9();
            VHLT01IS-CAL8();
            VHLT01IS-CAL7();
            VHLT01IS-CAL6();
            VHLT01IS-CAL5();
            VHLT01IS-CAL4();
            VHLT01IS-CAL3();
            VHLT01IS-CAL2();
            VHLT01IS-CAL1();
        else
            if (LAST-CAR-NO-8 == "Y")
                VHLT01IS-CAL8();
                VHLT01IS-CAL7();
                VHLT01IS-CAL6();
                VHLT01IS-CAL5();
                VHLT01IS-CAL4();
                VHLT01IS-CAL3();
                VHLT01IS-CAL2();
                VHLT01IS-CAL1();
            else
                if (LAST-CAR-NO-7 == "Y")
                    VHLT01IS-CAL7();
                    VHLT01IS-CAL6();
                    VHLT01IS-CAL5();
                    VHLT01IS-CAL4();
                    VHLT01IS-CAL3();
                    VHLT01IS-CAL2();
                    VHLT01IS-CAL1();
                else
                    if (LAST-CAR-NO-6 == "Y")
                        VHLT01IS-CAL6();
                        VHLT01IS-CAL5();
                        VHLT01IS-CAL4();
                        VHLT01IS-CAL3();
                        VHLT01IS-CAL2();
                        VHLT01IS-CAL1();
                    else
                        if (LAST-CAR-NO-5 == "Y")
                            VHLT01IS-CAL5();
                            VHLT01IS-CAL4();
                            VHLT01IS-CAL3();
                            VHLT01IS-CAL2();
                            VHLT01IS-CAL1();
                        else
                            if (LAST-CAR-NO-4 == "Y")
                                VHLT01IS-CAL4();
                                VHLT01IS-CAL3();
                                VHLT01IS-CAL2();
                                VHLT01IS-CAL1();
                            else
                                if (LAST-CAR-NO-3 == "Y")
                                    VHLT01IS-CAL3();
                                    VHLT01IS-CAL2();
                                    VHLT01IS-CAL1();
                                else
                                    if (LAST-CAR-NO-2 == "Y")
                                        VHLT01IS-CAL2();
                                        VHLT01IS-CAL1();
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHLT01IS-VALID-CON () 
    VHLT01IW-PASSVALUE.YES-CONTINUE = 0;
    VHLT01IW-PASSVALUE.NO-CONTINUE = 0;
    VHLT01IW-TRIGGER.CON-ERROR = "N";
    VHLT01IW-TRIGGER.CAR-ERROR = "N";
    if (VHLT01IW.CON-NO is numeric)
        if (VHLT01IW.CON-NO-X > 99 &&
         VHLT01IW.CON-NO-X < 1000)
  			
            VHLT009_CRIT.CON-NO = VHLT01IW.CON-NO;
            try
                call "VHLT009"(XDCONTROL, VHLT009_CRIT, VHLT009_DATA);
            
            end
            if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
             (VHLT009_CRIT.NO-RECORD-FOUND == "N"))
                VHLT01IW-PASSVALUE.DATE-INSRV-REV = VHLT009_DATA.DATE-INSRV-REV;
                VHLT01IW-PASSVALUE.TIME-INSRV-X = VHLT009_DATA.TIME-INSRV;
  
                if (VHLT009_DATA.CON-STAT == "OUT" ||
                 VHLT009_DATA.CON-STAT == "SWP")
                    VHLT01IW-TRIGGER.CON-NOT-INSRV = "Y";
                    VHLT01IW-TRIGGER.CON-ERROR = "Y";
                else
                    if (VHLT009_DATA.CON-STAT == "CAR" ||
                     VHLT009_DATA.CON-STAT == "CON")
                        VHLT01IW-TRIGGER.CON-TRBL = "Y";
                    else
                        if (VHLT009_DATA.CON-STAT == "SRV")
                            VHLT01IS-CKCO-IND();
  			
  			
                        else
                            VHLT01IW-TRIGGER.CON-STAT-ERROR = "Y";
                            VHLT01IW-TRIGGER.CON-ERROR = "Y";
                        end
                    end
                end
            else
                if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
                 (VHLT009_CRIT.NO-RECORD-FOUND == "Y"))
  
                    VHLT01IW-TRIGGER.CON-ERROR = "Y";
                    VHLT01IW-TRIGGER.CON-NOT-EXIST = "Y";
                end
            end
        else
            VHLT01IW-TRIGGER.CON-NUMERIC-ERR = "Y";
            VHLT01IW-TRIGGER.CON-ERROR = "Y";
        end
    else
        VHLT01IW-TRIGGER.CON-NUMERIC-ERR = "Y";
        VHLT01IW-TRIGGER.CON-ERROR = "Y";
    end
end 

Function VHLT01IS-VALID-LOC () 
    VHLT01IW-TRIGGER.YARD-ERROR = "N";
    VHLT01IW-TRIGGER.YARD-SUB-LOC-ERROR = "N";
    if (VHLT01IW.YARD-LOC == " ")
        VHLT01IW-TRIGGER.YARD-ERROR = "Y";
        VHLT01IW-TRIGGER.YARD-LOC-BLANK = "Y";
    end
    if (VHLT01IW.YARD-SUB-LOC == " ")
        VHLT01IW-TRIGGER.YARD-SUB-LOC-ERROR = "Y";
        VHLT01IW-TRIGGER.YARD-SUB-LOC-BLANK = "Y";
    end
end 

Function VHLT01IS-VALID-PS1 () 
    VHLT01IW-TRIGGER.PSEUDO-CON-ERROR = "N";
    VHLT022_CRIT.CON-NO = VHLT01IW.CON-NO;
    try
        call "VHLT022"(XDCONTROL, VHLT022_CRIT, VHLT022_DATA);
    
    end
    if (VHLT022_DATA.CON-NO != " ")
        VHLT01IW-TRIGGER.PSEUDO-CON-ERROR = "Y";
    end
end 

Function VHLT01IS-VALID-PSE () 
    VHLT01IW-TRIGGER.PSEUDO-CON-ERROR = "N";
    VHLT021_CRIT.CON-NO = VHLT01IW.CON-NO;
    VHLT021_CRIT.DATE-INSRV-REV = VHLT009_DATA.DATE-INSRV-REV;
    VHLT021_CRIT.TIME-INSRV = VHLT009_DATA.TIME-INSRV;
    VHLT021_CRIT.DATE-INSRV = VHLT009_DATA.DATE-INSRV;
    try
        call "VHLT021"(XDCONTROL, VHLT021_CRIT, VHLT021_DATA);
    
    end
    VHLT01IW-PASSVALUE.PSEUDO-COUNTER = 1;
    while (PSEUDO-COUNTER <= XDCONTROL.UROWCNT)
        if (VHLT021_DATA.VEH-STAT[PSEUDO-COUNTER] == "NO GO" ||
         VHLT021_DATA.VEH-STAT[PSEUDO-COUNTER] == "USABLE")
            VHLT01IW-TRIGGER.PSEUDO-CON-ERROR = "Y";
            PSEUDO-COUNTER = XDCONTROL.UROWCNT;
            PSEUDO-COUNTER = PSEUDO-COUNTER + 1;
        else
            PSEUDO-COUNTER = PSEUDO-COUNTER + 1;
        end
    end
end 

Function VHLT01IS-VALID-TME () 
    move TIME-OUTSRV-HH to TIME-OUTSRV-HH-X withV60Compat;
    move TIME-OUTSRV-MM to TIME-OUTSRV-MM-X withV60Compat;
    move TIME-OUTSRV-HH to TIME-OUTSRV-HH-Y withV60Compat;
    move TIME-OUTSRV-MM to TIME-OUTSRV-MM-Y withV60Compat;
    if (VHLT01IW.TIME-OUTSRV-HH is numeric)
        if (VHLT01IW.TIME-OUTSRV-HH-X < 00 ||
         VHLT01IW.TIME-OUTSRV-HH-X > 23)
            VHLT01IW-TRIGGER.TIME-OUT-RANGE = "Y";
            VHLT01IW-TRIGGER.TIME-ERROR-X = "Y";
        else
            if (VHLT01IW.TIME-OUTSRV-MM is numeric)
                if (VHLT01IW.TIME-OUTSRV-MM-X < 00 ||
                 VHLT01IW.TIME-OUTSRV-MM-X > 59)
                    VHLT01IW-TRIGGER.TIME-OUT-RANGE = "Y";
                    VHLT01IW-TRIGGER.TIME-ERROR-X = "Y";
                end
            else
                VHLT01IW-TRIGGER.TIME-NOT-NUMERIC = "Y";
                VHLT01IW-TRIGGER.TIME-ERROR-X = "Y";
            end
        end
    else
        VHLT01IW-TRIGGER.TIME-NOT-NUMERIC = "Y";
        VHLT01IW-TRIGGER.TIME-ERROR-X = "Y";
    end
end 

Function VHLT01IS-YRD-LOC () 
    VHLT01IW.COUNTER = 1;
    VHLT01IW-PASSVALUE.YRD-IDX = 0;
    while (VHLT01IW.COUNTER <= XDCONTROL.UROWCNT)
        if (VHLT010_DATA.YRD[VHLT01IW.COUNTER] == VHLT010_CRIT.YRD-TRKG-YRD)
            VHLT01IW-PASSVALUE.YRD-IDX = VHLT01IW.COUNTER;
            VHLT01IW.COUNTER = VHLT01IW.COUNTER + 1;
        end
        VHLT01IW.COUNTER = VHLT01IW.COUNTER + 1;
    end
end 

Function VHLT01IS-YRD-TRKG () 
    VHLT020_CRIT.USER-GRP = VH01A01_DATA.USER-GROUP;
    try
        call "VHLT020"(XDCONTROL, VHLT020_CRIT, VHLT020_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHLT01IW.TIME-OUTSRV = VHTR012_DATA.CURRENT-TIME;
    end
end 

