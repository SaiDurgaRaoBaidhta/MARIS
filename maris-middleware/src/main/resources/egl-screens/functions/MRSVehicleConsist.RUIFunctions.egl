                            end
                        end
                        
  
  
  
  
  
                    else
                        if (IND == 7)
                            VHTR01IW-CON-LIST.CAR-NO-7 = VHTR011_DATA.CAR-NO[IND];
                            VHTR01IW-CON-LIST.CAR-ORDER7 = 7;
                            VHTR01IW-CON-LIST.CAR-ORIENT7 = VHTR011_DATA.VAGen_ORIENTATION[IND];
