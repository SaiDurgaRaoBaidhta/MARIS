Function VHTR01IS-MV-LEFTX ()
  
   
    IND = VHTR01W_DATA-SC.LEFT-CON-SIZE + 1;
    while ((IND <= VHTR01IW-CON-LIST.CON-SIZE))
        if (IND == 3)
            VHTR01IW-CON-LIST.CAR-NO-3 = VHTR011_DATA.CAR-NO[IND];
            VHTR01IW-CON-LIST.CAR-ORDER3 = 3;
            VHTR01IW-CON-LIST.CAR-ORIENT3 = VHTR011_DATA.VAGen_ORIENTATION[IND];
            VHTR01IW-CON-LIST.CAR-LEFT-ORIENT-3 = " ";
            VHTR01IW-CON-LIST.CAR-RIGHT-ORIENT-3 = " ";
            if (VHTR01IW-CON-LIST.CAR-ORIENT3 == VHTS2A3_DATA.LFT-ORIENTATION-CD[3])
                VHTR01IW-CON-LIST.CAR-LEFT-ORIENT-3 = VHTR01IW-CON-LIST.CAR-ORIENT3;
            else
                if (VHTR01IW-CON-LIST.CAR-ORIENT3 == VHTS2A3_DATA.RGT-ORIENTATION-CD[3])
                    VHTR01IW-CON-LIST.CAR-RIGHT-ORIENT-3 = VHTR01IW-CON-LIST.CAR-ORIENT3;
                end
            end
            
  
  
  
  
  
        else
            if (IND == 4)
                VHTR01IW-CON-LIST.CAR-NO-4 = VHTR011_DATA.CAR-NO[IND];
                VHTR01IW-CON-LIST.CAR-ORDER4 = 4;
                VHTR01IW-CON-LIST.CAR-ORIENT4 = VHTR011_DATA.VAGen_ORIENTATION[IND];
                VHTR01IW-CON-LIST.CAR-LEFT-ORIENT-4 = " ";
                VHTR01IW-CON-LIST.CAR-RIGHT-ORIENT-4 = " ";
