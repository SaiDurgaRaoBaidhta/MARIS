                                VHSC01IW-CON-LIST.CAR-NO5 = "    ";
                                VHSC01IW-CON-LIST.CAR-NO6 = "    ";
                                VHSC01IW-CON-LIST.CAR-NO7 = "    ";
                                VHSC01IW-CON-LIST.CAR-NO8 = "    ";
                                VHSC01IW-CON-LIST.CAR-NO9 = "    ";
                                VHSC01IW-CON-LIST.CAR-NO10 = "    ";
                                DISABLE-SPLITBUTTON5 = "Y";
                                DISABLE-SPLITBUTTON6 = "Y";
                                DISABLE-SPLITBUTTON7 = "Y";
                                DISABLE-SPLITBUTTON8 = "Y";
                                DISABLE-SPLITBUTTON9 = "Y";
                            else
                                if (VHSC01W-MSG.CAR-POS == 3)
                                    VHSC01IW-CON-LIST.CAR-NO3 = "    ";
                                    VHSC01IW-CON-LIST.CAR-NO4 = "    ";
                                    VHSC01IW-CON-LIST.CAR-NO5 = "    ";
                                    VHSC01IW-CON-LIST.CAR-NO6 = "    ";
                                    VHSC01IW-CON-LIST.CAR-NO7 = "    ";
                                    VHSC01IW-CON-LIST.CAR-NO8 = "    ";
                                    VHSC01IW-CON-LIST.CAR-NO9 = "    ";
                                    VHSC01IW-CON-LIST.CAR-NO10 = "    ";
                                    DISABLE-SPLITBUTTON4 = "Y";
                                    DISABLE-SPLITBUTTON5 = "Y";
                                    DISABLE-SPLITBUTTON6 = "Y";
                                    DISABLE-SPLITBUTTON7 = "Y";
                                    DISABLE-SPLITBUTTON8 = "Y";
                                    DISABLE-SPLITBUTTON9 = "Y";
                                end
                            end
                        end
                    end
                end
            end
        end


  
  
        VHSC01W-TRIGGER.ENABLE-UPDATE = "Y";
    end
    VHSC01IS-REV-TRN2();
end 

Function VHSC01IS-ORG-CON () 
    set VHSC01W-TEMP-REC empty;
    VHSC01W_DATA.TIME-CHK = " ";
    VHSC01W_DATA.SPLIT-LOC = " ";
    VHSC01W_DATA.DASH-NO = 0;
    VHSC01W_DATA.LEFT-CON-NO = " ";
    VHSC01W_DATA.RIGHT-CON-NO = " ";
    VHSC01W-TRIGGER.CLICK-COUNT = 0;
    set VHSC01W-CLEAR-SCR empty;
    set VHSC01W-NEW-RIGHT empty;
    set VHSC01IW-CON-LIST empty;
    VHSC01W-TEMP-REC.LEFT-SAME-ORG = "N";
    VHSC01W-TEMP-REC.RIGHT-SAME-ORG = "N";
    VHSC01W-TEMP-REC.LEFT-RIGHT-NEW = "N";
    VHSC01W-MSG.MSG = " ";
    VHSC01W_DATA.FOUND-DATA = "N";
    if (VHSC01W_DATA.CON-NO != " ")
        VHSC01W-CLEAR-SCR.CON-NO = VHSC01W_DATA.CON-NO;
        VHXCONB_CRIT.CON-NO = VHSC01W_DATA.CON-NO;
        VHXCONB_CRIT.DASH-NO = VHSC01W_DATA.DASH-NO;
        VHXCONB_CRIT.USE-DASH-NO = "N";
        

      
        VHSC01IS-GET-CONS();

  
  
        if (VHXCONB_DATA.DASH-NO[1] == 8224)
            VHSC01W-CLEAR-SCR.DASH-NO-NUM = 0;
            VHSC01W_DATA.DASH-NO = 0;
        else
            VHSC01W-CLEAR-SCR.DASH-NO-NUM = VHXCONB_DATA.DASH-NO[1];
            VHSC01W_DATA.DASH-NO = VHXCONB_DATA.DASH-NO[1];
        end

    
        if (VHSC01W_DATA.FOUND-DATA == "Y" && (VHXCONB_DATA.CON-STAT[1] ==
         "SRV" ||
         VHXCONB_DATA.CON-STAT[1] == "CAR"))

        else
            if (VHSC01W_DATA.FOUND-DATA == "Y") 
                                        
                VHSC01W-MSG.MSG = "This Consist No has an Incident against it. Split cannot be done";
                DISABLE-SPLITCRIT = "Y";
                DISABLE-LEFTCON = "Y";
                DISABLE-RIGHTCON = "Y";
  
                VHSC01W_DATA.FOUND-DATA = "B";
            end
        end 

      
        if (VHSC01W_DATA.FOUND-DATA == "Y" && VHXCONB_DATA.CON-SIZE[1] < 4)
            VHSC01IS-MOVE-CONS();
            VHSC01W-MSG.MSG = "The entered Consist No has less than 4 cars in it. Split cannot be done";
            DISABLE-SPLITCRIT = "Y";
            DISABLE-LEFTCON = "Y";
            DISABLE-RIGHTCON = "Y";
            VHSC01W_DATA.FOUND-DATA = "B";
            
  
        end
        if (VHSC01W_DATA.FOUND-DATA == "Y")
            ENABLE-SPLITCRIT = "Y";
            ENABLE-LEFTCON = "Y";
            ENABLE-RIGHTCON = "Y";
            
      
            VHSC01IS-MOVE-CONS();
            LEFTCON-SETFOCUS = "Y";
        end
        if (VHSC01W_DATA.FOUND-DATA == "N")
            VHSC01W-MSG.MSG = "The entered Consist No is currently Not In Service.";
            DISABLE-SPLITCRIT = "Y";
            DISABLE-LEFTCON = "Y";
            DISABLE-RIGHTCON = "Y";
            
  
        end
    else
        VHSC01W-MSG.MSG = "Please enter a consist no to be split";
        DISABLE-SPLITCRIT = "Y";
        DISABLE-LEFTCON = "Y";
        DISABLE-RIGHTCON = "Y";
        
    
    end
end 

Function VHSC01IS-ORIENT ()
  
  
  
  
  
  
  
  
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHTS01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHTS2A3";
    set VHTS2A3_DATA empty;
    VHTS2A3_CRIT.CON-SIZE = VHXCONB_DATA.CON-SIZE[1];
    VHTS2A3_CRIT.CAR-NO-1 = VHXCONB_DATA.CAR-NO[1];
    VHTS2A3_CRIT.CAR-NO-2 = VHXCONB_DATA.CAR-NO[2];
    VHTS2A3_CRIT.CAR-NO-3 = VHXCONB_DATA.CAR-NO[3];
    VHTS2A3_CRIT.CAR-NO-4 = VHXCONB_DATA.CAR-NO[4];
    VHTS2A3_CRIT.CAR-NO-5 = VHXCONB_DATA.CAR-NO[5];
    VHTS2A3_CRIT.CAR-NO-6 = VHXCONB_DATA.CAR-NO[6];
    VHTS2A3_CRIT.CAR-NO-7 = VHXCONB_DATA.CAR-NO[7];
    VHTS2A3_CRIT.CAR-NO-8 = VHXCONB_DATA.CAR-NO[8];
    VHTS2A3_CRIT.CAR-NO-9 = VHXCONB_DATA.CAR-NO[9];
    VHTS2A3_CRIT.CAR-NO-10 = VHXCONB_DATA.CAR-NO[10];
  
  


    
    try
        call "VHTS2A3"(XDCONTROL, VHTS2A3_CRIT, VHTS2A3_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
  

  
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            
  
  
  
        end 
    end
end 

Function VHSC01IS-REV-TIME () 
    try
        call "VHMT016"(XDCONTROL, VHMT016_DATA);
    
    end
    VHXREVC_DATA.DB-REVENUE-DATE = VHMT016_DATA.REVENUE-DATE;
  
    VHXREVC_DATA.END-TIME-DAY = "24.00.00";

  
  
    VHXREVC_DATA.TIME-REV-START = "03.00.00";
    VHXREVC_DATA.TIME-REV-END = "02.59.59";

  
  
  
  
  
    VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    VHXREVC_DATA.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    VHXREVC_DATA.SYS-MINUTES = (VHXREVC_DATA.SYSTEM-TIME-HR-NUM * 60) + VHXREVC_DATA.SYSTEM-TIME-MIN-NUM;
    if (VHXREVC_DATA.SYS-MINUTES < 180)
  
  
        XXDATEW.DATE-YYYY-MM-DD = VHXREVC_DATA.DB-REVENUE-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHXREVC_DATA.REVENUE-DATE = XXDATEW.DATE-MM-DD-YYYY;
    else
        VHXREVC_DATA.REVENUE-DATE = VHXREVC_DATA.SYSTEM-DATE;
    end
    VHXREVA_DATA.REVENUE-DATE = VHXREVC_DATA.REVENUE-DATE;
end 

Function VHSC01IS-REV-TRN1 () 
    set VHSC2A2_DATA empty;
    set VHSC2A2_CRIT empty;
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHSC01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHSC2A2";
    VHSC2A2_CRIT.CON-NO-FROM = VHSC01W_DATA.CON-NO;
    VHSC2A2_CRIT.CON-NO-TO = VHSC01W_DATA.LEFT-CON-NO;
    VHSC2A2_CRIT.ORIGIN-LOC-SWAP = VHXCONB_DATA.ORIGIN-LOC-SWAP[1];

    
    try
        call "VHSC2A2"(XDCONTROL, VHSC2A2_CRIT, VHSC2A2_DATA);
    
    end
    
    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHSC2A2_DATA.REVERSE-IND == "Y")
                VHSC2A2_DATA.REVERSE-IND-LEFT = "Y";
            else
                VHSC2A2_DATA.REVERSE-IND-LEFT = " ";
            end
        else
            VHSC2A2_DATA.REVERSE-IND-LEFT = " ";
            VHSC2A2_DATA.REVERSE-IND = " ";
            

  
        
        
  
  
  
  
        end 
    end

  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHSC01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHSC2A2";
    VHSC2A2_CRIT.CON-NO-FROM = VHSC01W_DATA.CON-NO;
    VHSC2A2_CRIT.CON-NO-TO = VHSC01W_DATA.RIGHT-CON-NO;
    VHSC2A2_CRIT.ORIGIN-LOC-SWAP = VHXCONB_DATA.ORIGIN-LOC-SWAP[1];

    
    try
        call "VHSC2A2"(XDCONTROL, VHSC2A2_CRIT, VHSC2A2_DATA);
    
    end
    
    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHSC2A2_DATA.REVERSE-IND == "Y")
                VHSC2A2_DATA.REVERSE-IND-RIGHT = "Y";
            else
                VHSC2A2_DATA.REVERSE-IND-RIGHT = " ";
            end
        else
            VHSC2A2_DATA.REVERSE-IND = " ";
            VHSC2A2_DATA.REVERSE-IND-RIGHT = " ";
            

  
        
        
  
  
  
  
        end 
    end
end 

