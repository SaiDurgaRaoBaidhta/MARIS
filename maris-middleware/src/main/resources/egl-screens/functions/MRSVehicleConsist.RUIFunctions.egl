

package MRSVehicleConsist;


function getCarNo(src Char(6)) returns(string)	
    retValue char(4);
    tmp  Char(6);    
    tmp = strLib.clip(src, 0);
    if( tmp[1:1] == "$" )
		retValue = tmp[2:5];
	else
		retValue = tmp;
	end
	return (retValue);
end

function GiveAStr(SFTVER char(4) const in) returns(string)
    str string;
    if(SFTVER > " 1")
        str =  SFTVER;
    else
        str = " ";
    end
    return(str);
end

Function VHC01IS-COM-TRAIN () 
    if (VHCM01IW.NEW-TRAIN == " ")
        VHCM01IW.NEW-TRAIN = VHCM01IW.COMBINE-TRAIN;
    end
end 

