Function VHSC01IS-MV-LEFTX ()
  
   
    IND = VHSC01W_DATA.LEFT-CON-SIZE + 1;
    while ((IND <= VHSC01IW-CON-LIST.CON-SIZE))
        if (IND == 3)
            VHSC01IW-CON-LIST.CAR-NO-3 = VHXCONB_DATA2.CAR-NO[IND];
            VHSC01IW-CON-LIST.CAR-ORDER3 = 3;
            VHSC01IW-CON-LIST.CAR-ORIENT3 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
            VHSC01IW-CON-LIST.CAR-LEFT-ORIENT-3 = " ";
            VHSC01IW-CON-LIST.CAR-RIGHT-ORIENT-3 = " ";
            if (VHSC01IW-CON-LIST.CAR-ORIENT3 == VHTS2A3_DATA.LFT-ORIENTATION-CD[3])
                VHSC01IW-CON-LIST.CAR-LEFT-ORIENT-3 = VHSC01IW-CON-LIST.CAR-ORIENT3;
            else
                if (VHSC01IW-CON-LIST.CAR-ORIENT3 == VHTS2A3_DATA.RGT-ORIENTATION-CD[3])
                    VHSC01IW-CON-LIST.CAR-RIGHT-ORIENT-3 = VHSC01IW-CON-LIST.CAR-ORIENT3;
                end
            end
            if (IND == VHSC01IW-CON-LIST.CON-SIZE)
                DISABLE-SPLITBUTTON4 = "Y";
            else
                ENABLE-SPLITBUTTON4 = "Y";
            end
        else
            if (IND == 4)
                VHSC01IW-CON-LIST.CAR-NO-4 = VHXCONB_DATA2.CAR-NO[IND];
                VHSC01IW-CON-LIST.CAR-ORDER4 = 4;
                VHSC01IW-CON-LIST.CAR-ORIENT4 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
                VHSC01IW-CON-LIST.CAR-LEFT-ORIENT-4 = " ";
                VHSC01IW-CON-LIST.CAR-RIGHT-ORIENT-4 = " ";
                if (VHSC01IW-CON-LIST.CAR-ORIENT4 == VHTS2A3_DATA.LFT-ORIENTATION-CD[4])
                    VHSC01IW-CON-LIST.CAR-LEFT-ORIENT-4 = VHSC01IW-CON-LIST.CAR-ORIENT4;
                else
                    if (VHSC01IW-CON-LIST.CAR-ORIENT4 == VHTS2A3_DATA.RGT-ORIENTATION-CD[4])
                        VHSC01IW-CON-LIST.CAR-RIGHT-ORIENT-4 = VHSC01IW-CON-LIST.CAR-ORIENT4;
                    end
                end
                if (IND == VHSC01IW-CON-LIST.CON-SIZE)
                    DISABLE-SPLITBUTTON5 = "Y";
                else
                    ENABLE-SPLITBUTTON5 = "Y";
                end
            else
                if (IND == 5)
                    VHSC01IW-CON-LIST.CAR-NO-5 = VHXCONB_DATA2.CAR-NO[IND];
