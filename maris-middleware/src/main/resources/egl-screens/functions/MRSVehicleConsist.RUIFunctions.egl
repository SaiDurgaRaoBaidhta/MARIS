                            VHCM01IW-TRIGGER.CAR4-LOC-HI = "Y";
                        end
                    end
                end
            end
        end
    end
end 

Function VHCM01IS-CAL5 () 
    VHCM01IW-PASSVALUE.END-CAR-HRS = 0;
