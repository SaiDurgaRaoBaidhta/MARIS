        VHMT01IW-TIME-MSG.MSG-1 = "TIME INSERVICE SHOULD BE NUMERIC";
        VHMT01IW-TRIGGER.TIME-NOT-NUMERIC = " ";
        VHMT01IW-TIME-MSG.TIME-MESSAGE = VHMT01IW.TIME-INSRV-HRMIN;
