                                VHTR01IW-CON-LIST.CAR-NO-8 = VHTR011_DATA.CAR-NO[IND];
                                VHTR01IW-CON-LIST.CAR-ORDER8 = 8;
                                VHTR01IW-CON-LIST.CAR-ORIENT8 = VHTR011_DATA.VAGen_ORIENTATION[IND];
