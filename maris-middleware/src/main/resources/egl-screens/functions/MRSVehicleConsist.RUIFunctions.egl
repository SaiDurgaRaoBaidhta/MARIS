                                                VHLT01IW-PASSVALUE.CAR-NO-10-MAX-PM = VHLT015_DATA.HRS-TO-NEXT-PM-MAX[VHLT01IW-PASSVALUE.COUNTER];
                                                VHLT01IW-PASSVALUE.CAR-NO-10-MAX-BRK = VHLT015_DATA.BRK-IN-HRS-MAX[VHLT01IW-PASSVALUE.COUNTER];
                                                VHLT01IW-PASSVALUE.CAR-NO-10-WAR-IND = VHLT015_DATA.WAR-IND[VHLT01IW-PASSVALUE.COUNTER];
                                                VHLT01IW-PASSVALUE.CAR-NO-10-VEH-STAT = VHLT015_DATA.VEH-STAT[VHLT01IW-PASSVALUE.COUNTER];
                                                VHLT01IW-PASSVALUE.CAR-NO-10-VEH-STAT-PREV = VHLT015_DATA.VEH-STAT-PREV[VHLT01IW-PASSVALUE.COUNTER];
                                                VHLT01IW-PASSVALUE.CAR-NO-10-HOME-YRD = VHLT015_DATA.HOME-YRD[VHLT01IW-PASSVALUE.COUNTER];
                                                VHLT01IW-PASSVALUE.DATE-END-CAR-REV-10 = VHLT015_DATA.DATE-END-CAR-REV[VHLT01IW-PASSVALUE.COUNTER];
                                                VHLT01IW-PASSVALUE.TIME-END-CAR-10 = VHLT015_DATA.TIME-END-CAR[VHLT01IW-PASSVALUE.COUNTER];
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        VHLT01IW-PASSVALUE.COUNTER = VHLT01IW-PASSVALUE.COUNTER + 1;
    end
    if (VHLT015_DATA.CON-SIZE[1] == 2)
        VHLT01IW-PASSVALUE.LAST-CAR-NO-2 = "Y";
    else
        if (VHLT015_DATA.CON-SIZE[1] == 3)
            VHLT01IW-PASSVALUE.LAST-CAR-NO-3 = "Y";
        else
            if (VHLT015_DATA.CON-SIZE[1] == 4)
                VHLT01IW-PASSVALUE.LAST-CAR-NO-4 = "Y";
            else
                if (VHLT015_DATA.CON-SIZE[1] == 5)
                    VHLT01IW-PASSVALUE.LAST-CAR-NO-5 = "Y";
                else
                    if (VHLT015_DATA.CON-SIZE[1] == 6)
                        VHLT01IW-PASSVALUE.LAST-CAR-NO-6 = "Y";
                    else
                        if (VHLT015_DATA.CON-SIZE[1] == 7)
                            VHLT01IW-PASSVALUE.LAST-CAR-NO-7 = "Y";
                        else
                            if (VHLT015_DATA.CON-SIZE[1] == 8)
                                VHLT01IW-PASSVALUE.LAST-CAR-NO-8 = "Y";
                            else
                                if (VHLT015_DATA.CON-SIZE[1] == 9)
                                    VHLT01IW-PASSVALUE.LAST-CAR-NO-9 = "Y";
                                else
                                    if (VHLT015_DATA.CON-SIZE[1] == 10)
                                        VHLT01IW-PASSVALUE.LAST-CAR-NO-10 = "Y";
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

