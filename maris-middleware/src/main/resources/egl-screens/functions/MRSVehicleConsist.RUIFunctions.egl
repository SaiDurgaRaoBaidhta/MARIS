                    else
                        if (VHSC01IW-CON-LIST.CAR-ORIENT5 == VHTS2A3_DATA.RGT-ORIENTATION-CD[5])
                            VHSC01IW-CON-LIST.CAR-RIGHT-ORIENT-5 = VHSC01IW-CON-LIST.CAR-ORIENT5;
                        end
                    end
                    if (IND == VHSC01IW-CON-LIST.CON-SIZE)
                        DISABLE-SPLITBUTTON6 = "Y";
                    else
                        ENABLE-SPLITBUTTON6 = "Y";
                    end
                else
                    if (IND == 6)
                        VHSC01IW-CON-LIST.CAR-NO-6 = VHXCONB_DATA2.CAR-NO[IND];
                        VHSC01IW-CON-LIST.CAR-ORDER6 = 6;
