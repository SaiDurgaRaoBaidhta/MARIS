    VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM = VHCM01IW-PASSVALUE.CAR-NO-5-FROM-PM;
    VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM-MAX = VHCM01IW-PASSVALUE.CAR-NO-5-MAX-PM;
