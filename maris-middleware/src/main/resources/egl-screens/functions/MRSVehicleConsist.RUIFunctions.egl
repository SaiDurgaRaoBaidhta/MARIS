    VHTR016_CRIT-VEH-H.END-CAR-MIN-9 = VHTR01IW-SVR-REC.CAR-NO-9-END-MIN-SVC;
    VHTR016_CRIT-VEH-H.MID-CAR-HRS-9 = VHTR01IW-SVR-REC.CAR-NO-9-MID-HRS-SVC;
    VHTR016_CRIT-VEH-H.MID-CAR-MIN-9 = VHTR01IW-SVR-REC.CAR-NO-9-MID-MIN-SVC;
