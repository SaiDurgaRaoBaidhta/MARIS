Function VHTS01IS-ORIENT ()
  
  
  
  
  
  
  
  
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHTS01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHTS2A3";
    set VHTS2A3_DATA empty;
    VHTS2A3_CRIT.CON-SIZE = VHXCONB_DATA.CON-SIZE[1];
    VHTS2A3_CRIT.CAR-NO-1 = VHXCONB_DATA.CAR-NO[1];
    VHTS2A3_CRIT.CAR-NO-2 = VHXCONB_DATA.CAR-NO[2];
    VHTS2A3_CRIT.CAR-NO-3 = VHXCONB_DATA.CAR-NO[3];
    VHTS2A3_CRIT.CAR-NO-4 = VHXCONB_DATA.CAR-NO[4];
    VHTS2A3_CRIT.CAR-NO-5 = VHXCONB_DATA.CAR-NO[5];
    VHTS2A3_CRIT.CAR-NO-6 = VHXCONB_DATA.CAR-NO[6];
    VHTS2A3_CRIT.CAR-NO-7 = VHXCONB_DATA.CAR-NO[7];
    VHTS2A3_CRIT.CAR-NO-8 = VHXCONB_DATA.CAR-NO[8];
    VHTS2A3_CRIT.CAR-NO-9 = VHXCONB_DATA.CAR-NO[9];
    VHTS2A3_CRIT.CAR-NO-10 = VHXCONB_DATA.CAR-NO[10];
  
  


    
    try
        call "VHTS2A3"(XDCONTROL, VHTS2A3_CRIT, VHTS2A3_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
  

  
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            
  
  
  
        end 
    end
end 

Function VHTS01IS-PROCESS ()
  
  

  
   
    VHTS01W_DATA.REVERSE-IND = VHTS2A1_DATA.REVERSE-IND;
    VHTS01W_DATA.TIME-INSRV = VGVar.currentFormattedTime;
    VHTS1A2_CRIT.VAGen_FIRST = "N";
    VHTS01IW.ERROR-MESSAGE = " ";

  
  

  
    XXDATEW.DATE-MM-DD-YYYY = VHXREVA_DATA.REVENUE-DATE;
    XXDATEW.VAGen_FUNCTION = "YMD";
    MRSCommonCode.XXDATES-CONVERT();
    VHTS01W_DATA.REVENUE-DATE-DB2 = XXDATEW.DATE-YYYY-MM-DD;
    VHTS01W_DATA.TERM-LAST-UPD = VHTS01IW-PASSVALUE.TERM-LAST-UPD;
    try
        call "VHTSX"(XDCONTROL, VHTS01W_DATA, VHTS01IW-CON-LIST, VHTS1A2_CRIT, VHTS01IW-CHK-SAME);
    
    end
    if (VHTS01W_DATA.ERR-IND == "N" && VHTS01W_DATA.ERR-CHANGE == " ")
        VHTS01IW-MSG.MSG = "The Consists have been swapped";
        VHTS01IS-CLR-AFTDB(); 
                                   
    else
        if (VHTS01W_DATA.ERR-IND == "Y")
            if (VHTS01W_DATA.ERR-CHANGE == "CHG-LASTCONSTAT")
                VHTS01IW.ERROR-MESSAGE-1 = "             Last TO Consist (";
                VHTS01IW.ERROR-MESSAGE-2 = VHTS01W_DATA.ERR-CON-NO;
                VHTS01IW.ERROR-MESSAGE-3 = ") Status has changed - Train Swap not done.";
                VHTS01IW-MSG.MSG = VHTS01IW.ERROR-MESSAGE;
            else
                if (VHTS01W_DATA.ERR-CHANGE == "CHG-CONSTAT")
                    VHTS01IW.ERROR-MESSAGE-1 = "                FROM Consist (";
                    VHTS01IW.ERROR-MESSAGE-2 = VHTS01W_DATA.ERR-CON-NO;
                    VHTS01IW.ERROR-MESSAGE-3 = ") Status has changed - Train Swap not done.";
                    VHTS01IW-MSG.MSG = VHTS01IW.ERROR-MESSAGE;
                else
                    if (VHTS01W_DATA.ERR-CHANGE == "CHG-CARORDER")
                        VHTS01IW.ERROR-MESSAGE-1 = "Car Configuration for Consist ";
                        VHTS01IW.ERROR-MESSAGE-2 = VHTS01W_DATA.ERR-CON-NO;
                        VHTS01IW.ERROR-MESSAGE-3 = " has changed(revenue date not today) - Train Swap not done.";
                        VHTS01IW-MSG.MSG = VHTS01IW.ERROR-MESSAGE;
                        
  
                    else
                        VHTS01IW-MSG.MSG = "Train Swap Unsuccessful";
                        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    end
                end
            end
        else
            VHTS01IW.ERROR-MESSAGE-1 = VHTS01W_DATA.ERR-CHANGE;
            VHTS01IW.ERROR-MESSAGE-2 = " ";
            VHTS01IW.ERROR-MESSAGE-3 = "Nothing successful";
            VHTS01IW-MSG.MSG = VHTS01IW.ERROR-MESSAGE;
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHTS01IS-REV-TIME () 
    try
        call "VHMT016"(XDCONTROL, VHMT016_DATA);
    
    end
    VHXREVC_DATA.DB-REVENUE-DATE = VHMT016_DATA.REVENUE-DATE;
  
    VHXREVC_DATA.END-TIME-DAY = "24.00.00";

  
  
    VHXREVC_DATA.TIME-REV-START = "03.00.00";
    VHXREVC_DATA.TIME-REV-END = "02.59.59";

  
  
  
  
  
    VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    VHXREVC_DATA.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    VHXREVC_DATA.SYS-MINUTES = (VHXREVC_DATA.SYSTEM-TIME-HR-NUM * 60) + VHXREVC_DATA.SYSTEM-TIME-MIN-NUM;
    if (VHXREVC_DATA.SYS-MINUTES < 180)
  
  
        XXDATEW.DATE-YYYY-MM-DD = VHXREVC_DATA.DB-REVENUE-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHXREVC_DATA.REVENUE-DATE = XXDATEW.DATE-MM-DD-YYYY;
    else
        VHXREVC_DATA.REVENUE-DATE = VHXREVC_DATA.SYSTEM-DATE;
    end
    VHXREVA_DATA.REVENUE-DATE = VHXREVC_DATA.REVENUE-DATE;
end 

Function VHTS01IS-REV-TRN1 ()
  
  
  
  
  
  
  
  
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHTS01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHTS2A1";
    set VHTS2A1_DATA empty;
    VHTS2A1_CRIT.CON-NO-FROM = VHTS01W_DATA.CON-FROM;
    VHTS2A1_CRIT.CON-NO-TO = VHTS01W_DATA.CON-TO;
    VHTS2A1_CRIT.ORIGIN-LOC-SWAP = VHXCONB_DATA.ORIGIN-LOC-SWAP[1];
    

  
  


    
    try
        call "VHTS2A1"(XDCONTROL, VHTS2A1_CRIT, VHTS2A1_DATA);
    
    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
            return;
        else
            VHTS2A1_DATA.REVERSE-IND = " ";
            

  
        
        
  
  
  
  
        end 
    end
end 

Function VHTS01IS-REV-TRN2 () 
    VHTS01IW-CON-LIST.CAR-REV-IND-1[CON-INDEX] = " ";
    VHTS01IW-CON-LIST.CAR-REV-IND-2[CON-INDEX] = " ";
    VHTS01IW-CON-LIST.CAR-REV-IND-3[CON-INDEX] = " ";
    VHTS01IW-CON-LIST.CAR-REV-IND-4[CON-INDEX] = " ";
    VHTS01IW-CON-LIST.CAR-REV-IND-5[CON-INDEX] = " ";
    VHTS01IW-CON-LIST.CAR-REV-IND-6[CON-INDEX] = " ";
    VHTS01IW-CON-LIST.CAR-REV-IND-7[CON-INDEX] = " ";
    VHTS01IW-CON-LIST.CAR-REV-IND-8[CON-INDEX] = " ";
    VHTS01IW-CON-LIST.CAR-REV-IND-9[CON-INDEX] = " ";
    VHTS01IW-CON-LIST.CAR-REV-IND-10[CON-INDEX] = " ";
    if (VHXCONB_DATA.CON-SIZE[1] == 2)
        VHTS01IW-REV-TRN.CAR-NO2 = VHTS01IW-CON-LIST.CAR-NO-2[CON-INDEX];
        VHTS01IW-REV-TRN.CAR-ORIENT2 = VHTS01IW-CON-LIST.CAR-ORIENT2[CON-INDEX];
        VHTS01IW-REV-TRN.CAR-ORDER2 = VHTS01IW-CON-LIST.CAR-ORDER2[CON-INDEX];
        VHTS01IW-REV-TRN.CAR-NO1 = VHTS01IW-CON-LIST.CAR-NO-1[CON-INDEX];
        VHTS01IW-REV-TRN.CAR-ORIENT1 = VHTS01IW-CON-LIST.CAR-ORIENT1[CON-INDEX];
        VHTS01IW-REV-TRN.CAR-ORDER1 = VHTS01IW-CON-LIST.CAR-ORDER1[CON-INDEX];
        VHTS01IW-CON-LIST.CAR-REV-IND-1[CON-INDEX] = VHTS2A1_DATA.REVERSE-IND;
        VHTS01IW-CON-LIST.CAR-NO-2[CON-INDEX] = VHTS01IW-REV-TRN.CAR-NO1;
        VHTS01IW-CON-LIST.CAR-ORIENT2[CON-INDEX] = VHTS01IW-REV-TRN.CAR-ORIENT1;
        VHTS2A2_CRIT.CAR-NO = VHTS01IW-CON-LIST.CAR-NO-2[CON-INDEX];
        VHTS01IW-PASSVALUE.CAR-ORDER = VHTS01IW-CON-LIST.CAR-ORDER2[CON-INDEX];
        VHTS01IW-PASSVALUE.CAR-ORIENT = VHTS01IW-CON-LIST.CAR-ORIENT2[CON-INDEX];
        VHTS01US-REV-TRN3();
        VHTS01IW-CON-LIST.CAR-ORIENT2[CON-INDEX] = VHTS01IW-PASSVALUE.CAR-ORIENT;
        VHTS01IW-CON-LIST.CAR-RIGHT-ORIENT-2[CON-INDEX] = VHTS01IW-PASSVALUE.RIGHT-ORIENTATION;
        VHTS01IW-CON-LIST.CAR-LEFT-ORIENT-2[CON-INDEX] = VHTS01IW-PASSVALUE.LEFT-ORIENTATION;
  
        VHTS01IW-CON-LIST.CAR-NO-1[CON-INDEX] = VHTS01IW-REV-TRN.CAR-NO2;
        VHTS01IW-CON-LIST.CAR-ORIENT1[CON-INDEX] = VHTS01IW-REV-TRN.CAR-ORIENT2;
  
        VHTS01IW-CON-LIST.CAR-REV-IND-2[CON-INDEX] = VHTS2A1_DATA.REVERSE-IND;
        VHTS2A2_CRIT.CAR-NO = VHTS01IW-CON-LIST.CAR-NO-1[CON-INDEX];
        VHTS01IW-PASSVALUE.CAR-ORDER = VHTS01IW-CON-LIST.CAR-ORDER1[CON-INDEX];
        VHTS01IW-PASSVALUE.CAR-ORIENT = VHTS01IW-CON-LIST.CAR-ORIENT1[CON-INDEX];
        VHTS01US-REV-TRN3();
