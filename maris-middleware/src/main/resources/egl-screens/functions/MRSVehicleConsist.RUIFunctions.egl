Function VHCT01IS-CAR-INCD () 
    INCD-COUNT = 1;
    VHCT01IW-TRIGGER.CAR-NO-1-HI = "Y";
    VHCT01IW-TRIGGER.CAR-NO-2-HI = "Y";
    VHCT01IW-TRIGGER.CAR-NO-3-HI = "Y";
    VHCT01IW-TRIGGER.CAR-NO-4-HI = "Y";
    VHCT01IW-TRIGGER.CAR-NO-5-HI = "Y";
    VHCT01IW-TRIGGER.CAR-NO-6-HI = "Y";
    VHCT01IW-TRIGGER.CAR-NO-7-HI = "Y";
    VHCT01IW-TRIGGER.CAR-NO-8-HI = "Y";
    VHCT01IW-TRIGGER.CAR-NO-9-HI = "Y";
    VHCT01IW-TRIGGER.CAR-NO-10-HI = "Y";
    while (INCD-COUNT <= CAR-INCD-COUNT)
        if (VHCT01IW-PASSVALUE.CAR-NO-1 == VHCT013_DATA.CAR-NO[INCD-COUNT])
            VHCT01IW-TRIGGER.CAR-NO-1-SH = "Y";
        else
            if (VHCT01IW-PASSVALUE.CAR-NO-2 == VHCT013_DATA.CAR-NO[INCD-COUNT])
                VHCT01IW-TRIGGER.CAR-NO-2-SH = "Y";
            else
                if (VHCT01IW-PASSVALUE.CAR-NO-3 == VHCT013_DATA.CAR-NO[INCD-COUNT])
                    VHCT01IW-TRIGGER.CAR-NO-3-SH = "Y";
                else
                    if (VHCT01IW-PASSVALUE.CAR-NO-4 == VHCT013_DATA.CAR-NO[INCD-COUNT])
                        VHCT01IW-TRIGGER.CAR-NO-4-SH = "Y";
                    else
                        if (VHCT01IW-PASSVALUE.CAR-NO-5 == VHCT013_DATA.CAR-NO[INCD-COUNT])
                            VHCT01IW-TRIGGER.CAR-NO-5-SH = "Y";
                        else
                            if (VHCT01IW-PASSVALUE.CAR-NO-6 == VHCT013_DATA.CAR-NO[INCD-COUNT])
                                VHCT01IW-TRIGGER.CAR-NO-6-SH = "Y";
                            else
                                if (VHCT01IW-PASSVALUE.CAR-NO-7 == VHCT013_DATA.CAR-NO[INCD-COUNT])
                                    VHCT01IW-TRIGGER.CAR-NO-7-SH = "Y";
                                else
                                    if (VHCT01IW-PASSVALUE.CAR-NO-8 == VHCT013_DATA.CAR-NO[INCD-COUNT])
                                        VHCT01IW-TRIGGER.CAR-NO-8-SH = "Y";
                                    else
                                        if (VHCT01IW-PASSVALUE.CAR-NO-9 == VHCT013_DATA.CAR-NO[INCD-COUNT])
                                            VHCT01IW-TRIGGER.CAR-NO-9-SH = "Y";
                                        else
                                            if (VHCT01IW-PASSVALUE.CAR-NO-10 == VHCT013_DATA.CAR-NO[INCD-COUNT])
                                                VHCT01IW-TRIGGER.CAR-NO-10-SH = "Y";
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        CAR-COUNT = CAR-COUNT + 1;
    end
end 

Function VHCT01IS-CHK-CAR ()
  
   
    VHCT015_CRIT.WS-DATE-REV = VHCT01IW-PASSVALUE.DATE-REV;
    VHCT015_CRIT.CON-NO = VHCT01IW.CON-NO;
    try
        call "VHCT015"(XDCONTROL, VHCT015_CRIT, VHCT015_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCT01IW-PASSVALUE.CAR-COUNT = XDCONTROL.UROWCNT;
        VHCT01IW-SVR-REC.HIST-COUNT = VHCT015_CRIT.HIST-COUNT;
        VHCT01IS-MOVE-CAR();
        VHCT01IS-MOV-CARH();
        VHCT01IS-CHK-INCD();
    else
        VHCT01IW-TRIGGER.CON-ERROR = "Y";
    end
end 

Function VHCT01IS-CHK-DVS () 
    if (VHCT01IW-PASSVALUE.VEH-STAT-PREV == "GO" ||
     VHCT01IW-PASSVALUE.VEH-STAT-PREV == "USABLE")
        VHCT019_CRIT.CAR-NO = VHCT01IW-PASSVALUE.CAR-NO;
        try
            call "VHCT019"(XDCONTROL, VHCT019_CRIT, VHCT019_DATA);
        
        end
        if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
         (XDCONTROL.UROWCNT > 0 || VHCT019_DATA.INCD-COUNT-X > 0))
            VHCT01IS-UPD-DVS();
        end
    end
end 

Function VHCT01IS-CHK-INCD ()
   
    VHCT013_CRIT.CON-NO = VHCT01IW.CON-NO;
    VHCT013_CRIT.DASH-NO = VHCT011_DATA.DASH-NO;
    VHCT013_CRIT.DATE-INSRV-REV = VHCT011_DATA.DATE-INSRV-REV;
    VHCT013_CRIT.DATE-INSRV = VHCT011_DATA.DATE-INSRV;
    VHCT013_CRIT.TIME-INSRV = VHCT011_DATA.TIME-INSRV;
    try
        call "VHCT013"(XDCONTROL, VHCT013_CRIT, VHCT013_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCT01IW-PASSVALUE.CAR-INCD-COUNT = XDCONTROL.UROWCNT;
        if (XDCONTROL.UROWCNT == 0)
  
            VHCT01IS-OTIME();
  
  
        else
            VHCT01IS-CAR-INCD();
            VHCT01IW-TRIGGER.OPEN-CAR-INCD = "Y";
        end
    end
end 

Function VHCT01IS-CKCO-IND ()

   
    VHCT01IW-TRIGGER.TIME-OUT-ERR = " ";
    VHCT01IS-OSRV-TIME();
    if (VHCT01IW-TRIGGER.TIME-OUT-ERR == " ")
  
        VHCT014_CRIT.CON-NO = VHCT01IW.CON-NO;
        VHCT014_CRIT.DASH-NO = VHCT011_DATA.DASH-NO;
        VHCT014_CRIT.DATE-INSRV-REV = VHCT011_DATA.DATE-INSRV-REV;
        VHCT014_CRIT.DATE-INSRV = VHCT011_DATA.DATE-INSRV;
        VHCT014_CRIT.TIME-INSRV = VHCT011_DATA.TIME-INSRV;
        try
            call "VHCT014"(XDCONTROL, VHCT014_CRIT, VHCT014_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (XDCONTROL.UROWCNT == 0)
  
                VHCT01IS-CHK-CAR();
            else
                VHCT01IW-TRIGGER.CON-INCD = "Y";
            end
        end
    end
end 

