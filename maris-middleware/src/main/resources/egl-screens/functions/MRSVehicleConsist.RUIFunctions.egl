Function VHCM01IS-MOVE-CAR () 
    VHCM01IS-CL-VALUE();
    VHCM01IW-PASS-LEFT.COUNTER = 1;
    while ((VHCM01IW-PASS-LEFT.COUNTER <= VHCM01IW-PASS-LEFT.CAR-COUNT))
        if (VHCM013_DATA.CAR-ORDER[VHCM01IW-PASS-LEFT.COUNTER] == 1)
            VHCM01IW-PASS-LEFT.CAR-NO-1 = VHCM013_DATA.CAR-NO[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CON-NO-1 = VHCM013_DATA.CON-NO[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CAR-TYPE-1 = VHCM013_DATA.CAR-TYPE[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CAR-NO-1-CURR-LOC = VHCM013_DATA.CURR-LOC[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CAR-NO-1-END-HRS = VHCM013_DATA.END-CAR-HRS[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CAR-NO-1-END-MIN = VHCM013_DATA.END-CAR-MIN[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CAR-NO-1-MID-HRS = VHCM013_DATA.MID-CAR-HRS[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CAR-NO-1-MID-MIN = VHCM013_DATA.MID-CAR-MIN[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CAR-NO-1-CUM-HRS = VHCM013_DATA.CUM-HRS[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-SVR-REC.CAR-NO-1-PRV-HRS = VHCM013_DATA.CUM-HRS[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CAR-NO-1-CUM-MIN = VHCM013_DATA.CUM-MIN[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-SVR-REC.CAR-NO-1-PRV-MIN = VHCM013_DATA.CUM-MIN[VHCM01IW-PASS-LEFT.COUNTER];
            VHCM01IW-PASS-LEFT.CAR-NO-1-BRK-HRS = VHCM013_DATA.BRK-IN-HRS[VHCM01IW-PASS-LEFT.COUNTER];
