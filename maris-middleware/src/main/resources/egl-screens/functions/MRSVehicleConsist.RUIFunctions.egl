Function VHCM01IS-NTRAN-MSG () 
    if (VHCM01IW-TRIGGER.NEW-TRAIN-NOT-INSRV == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST NOT IN SERVICE";
        VHCM01IW-TRIGGER.CON-NOT-INSRV = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.NEW-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST NOT IN SERVICE";
        VHCM01IW-TRIGGER.NEW-TRAIN = "Y";
    end
    if (VHCM01IW-TRIGGER.NEW-TRAIN-STAT-ERROR == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST STATUS ERROR";
        VHCM01IW-TRIGGER.CON-STAT-ERROR = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.NEW-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST STATUS ERROR";
        VHCM01IW-TRIGGER.NEW-TRAIN = "Y";
    end
    if (VHCM01IW-TRIGGER.NEW-TRAIN-NUMERIC-ERR == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST NUMERIC ERROR";
        VHCM01IW-TRIGGER.CON-NUMERIC-ERR = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.NEW-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99 OR CANNOT BE SAME AS COMBINE TRAIN NO";
        VHCM01IW-TRIGGER.NEW-TRAIN = "Y";
    end
    if (VHCM01IW-TRIGGER.NEW-TRAIN-EXIST == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST EXIST";
        VHCM01IW-TRIGGER.CON-NOT-EXIST = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.NEW-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST IN SERVICE";
        VHCM01IW-TRIGGER.NEW-TRAIN = "Y";
    end
    if (VHCM01IW-TRIGGER.NEW-TRAIN-BLANK-ERR == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "NEW TRAIN CANNOT BE BLANK";
        VHCM01IW-TRIGGER.NEW-TRAIN = "Y";
    end
    if (VHCM01IW-TRIGGER.COMPL-CLEAR == "Y")
        VHCM01IW-TRIGGER.COMPL-CLEAR = " ";
        VHCM01IW-CON-MSG.CON-MSG-2-X = "TRAIN ";
        VHCM01IW-CON-MSG.CON-MSG-2-XX = VHCM01IW.NEW-TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-2-XXX = " SUCCESSFULLY CLEARED TO ";
        VHCM01IW-CON-MSG.CON-MSG-2-XXXX = VHCM01IW.YARD-LOC;
        VHCM01IW-CON-MSG.CON-MSG-2-XXXXX = ". RUN TIME ";
  
  
  
        VHCM01IW-CON-MSG.CON-MSG-FILLER = ":";
        VHCM01IW-CON-MSG.CON-MSG-1 = VHCM01IW-CON-MSG.CON-MSG-2;
        VHCM01IW-TRIGGER.NEW-TRAIN = "Y";
    end
end 

Function VHCM01IS-OSRV-TIME () 
    VHCM01IW-TRIGGER.TIME-OUT-ERR = " ";
    VHCM01IW.TIME-INSRV-HH-Y = VHCM01IW-PASSVALUE.TIME-INSRV-X-HH;
    VHCM01IW.TIME-INSRV-MM-Y = VHCM01IW-PASSVALUE.TIME-INSRV-X-MM;
    VHCM01IW.TIME-OUTSRV-HH-Y = VHCM01IW.TIME-OUTSRV-HH-X;
    VHCM01IW.TIME-OUTSRV-MM-Y = VHCM01IW.TIME-OUTSRV-MM-X;
    if (VHCM01IW.TIME-OUTSRV-HH-Y >= 00 &&
     VHCM01IW.TIME-OUTSRV-HH-Y <= 02)
        VHCM01IW.TIME-OUTSRV-HH-Y = VHCM01IW.TIME-OUTSRV-HH-Y + 24;
    end
    if (VHCM01IW.TIME-INSRV-HH-Y >= 00 &&
     VHCM01IW.TIME-INSRV-HH-Y <= 02)
        VHCM01IW.TIME-INSRV-HH-Y = VHCM01IW.TIME-INSRV-HH-Y + 24;
    end
    if (VHCM01IW.TIME-OUTSRV-HH-Y < VHCM01IW.TIME-INSRV-HH-Y)
  
  
        VHCM01IW-TRIGGER.TIME-OUT-ERR = "Y";
    else
        if (VHCM01IW.TIME-OUTSRV-HH-Y == VHCM01IW.TIME-INSRV-HH-Y)
            if (VHCM01IW.TIME-OUTSRV-MM-Y < VHCM01IW.TIME-INSRV-MM-Y)
  
  
                VHCM01IW-TRIGGER.TIME-OUT-ERR = "Y";
            end
        end
    end
end 

Function VHCM01IS-OSRV-TIMX () 
    VHCM01IW-TRIGGER.TIME-OUT-ERR = " ";
    VHCM01IW.TIME-INSRV-HH-Y = VHCM01IW-PASSVALUE.TIME-INSRV-X-HH;
    VHCM01IW.TIME-INSRV-MM-Y = VHCM01IW-PASSVALUE.TIME-INSRV-X-MM;
    VHCM01IW.TIME-OUTSRV-HH-Y = VHCM01IW.TIME-OUTSRV-HH;
    VHCM01IW.TIME-OUTSRV-MM-Y = VHCM01IW.TIME-OUTSRV-MM;
    if (VHCM01IW.TIME-OUTSRV-HH-Y >= 00 &&
     VHCM01IW.TIME-OUTSRV-HH-Y <= 02)
        VHCM01IW.TIME-OUTSRV-HH-Y = VHCM01IW.TIME-OUTSRV-HH-Y + 24;
    end
    if (VHCM01IW.TIME-INSRV-HH-Y >= 00 &&
     VHCM01IW.TIME-INSRV-HH-Y <= 02)
        VHCM01IW.TIME-INSRV-HH-Y = VHCM01IW.TIME-INSRV-HH-Y + 24;
    end
    if (VHCM01IW.TIME-OUTSRV-HH-Y < VHCM01IW.TIME-INSRV-HH-Y)
  
  
        VHCM01IW-TRIGGER.TIME-OUT-ERR = "Y";
    else
        if (VHCM01IW.TIME-OUTSRV-HH-Y == VHCM01IW.TIME-INSRV-HH-Y)
            if (VHCM01IW.TIME-OUTSRV-MM-Y < VHCM01IW.TIME-INSRV-MM-Y)
  
  
                VHCM01IW-TRIGGER.TIME-OUT-ERR = "Y";
            end
        end
    end
end 

Function VHCM01IS-OTIME ()
  
  
  
   
    VHCM01IW-PASSVALUE.TIME-INSRV = VHCM011_DATA.TIME-INSRV;
    
  
  
    VHCM01IS-RUN-TIME();
    VHCM01IS-VALD-CAR();
    if (VHCM01IW-TRIGGER.CAR-ERROR != "Y")
        VHCM01IS-UPD-CON();
    end
end 

Function VHCM01IS-PM-HRS () 
    if (VHCM01IW-PASSVALUE.CAR-LR == "L")
        VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM = VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM + VHCM01IW-PASS-LEFT.DIFF-HH;
    else
        VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM = VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM + VHCM01IW-PASS-RIGH.DIFF-HH;
    end
    if (VHCM01IW-PASSVALUE.DIFF-MM > 29)
        VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM = VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM + 1;
    end
    VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM = VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM-MAX - VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM;
end 

Function VHCM01IS-PROCESS ()
   
    VHCM01IW-CON-MSG.CON-MSG-1 = " ";
    VHCM018_CRIT.CON-NO = VHCM01IW.COMBINE-TRAIN;
    
  
  
  
    VHCM018_CRIT.DATE-INSRV-REV = VHCM01IW-PASSVALUE.DATE-REV;
    try
        call "VHCM018"(XDCONTROL, VHCM018_CRIT, VHCM018_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
     (VHCM018_CRIT.NO-RECORD-FOUND == "N"))
  
        if (VHCM018_DATA.CON-STAT == "OUT" ||
         VHCM018_DATA.CON-STAT == "SWP" ||
         VHCM018_DATA.CON-STAT == "CON")
  
            VHCM01IW-CON-MSG.CON-MSG-1 = "Train Configuration has been changed, Updates NOT made";
            return;
        else
            if (VHCM018_DATA.CON-STAT == "SRV" ||
             VHCM018_DATA.CON-STAT == "CAR")
  
                if (VHCM018_DATA.CAR-NO[1] != VHCM01IW-PASS-LEFT.CAR-NO-1 ||
                 VHCM018_DATA.CAR-NO[2] != VHCM01IW-PASS-LEFT.CAR-NO-2 ||
                 VHCM018_DATA.CAR-NO[3] != VHCM01IW-PASS-LEFT.CAR-NO-3 ||
                 VHCM018_DATA.CAR-NO[4] != VHCM01IW-PASS-LEFT.CAR-NO-4 ||
                 VHCM018_DATA.CAR-NO[5] != VHCM01IW-PASS-LEFT.CAR-NO-5 ||
                 VHCM018_DATA.CAR-NO[6] != VHCM01IW-PASS-LEFT.CAR-NO-6 ||
                 VHCM018_DATA.CAR-NO[7] != VHCM01IW-PASS-LEFT.CAR-NO-7 ||
                 VHCM018_DATA.CAR-NO[8] != VHCM01IW-PASS-LEFT.CAR-NO-8 ||
                 VHCM018_DATA.CAR-NO[9] != VHCM01IW-PASS-LEFT.CAR-NO-9 ||
                 VHCM018_DATA.CAR-NO[10] != VHCM01IW-PASS-LEFT.CAR-NO-10)
                    VHCM01IW-CON-MSG.CON-MSG-1 = "Train Configuration has been changed, Updates NOT made";
                    return;
                end
            end
        end
    end
    VHCM01IW-CON-MSG.CON-MSG-1 = " ";
    VHCM018_CRIT.CON-NO = VHCM01IW.TRAIN;
    
  
  
  
    VHCM018_CRIT.DATE-INSRV-REV = VHCM01IW-PASSVALUE.DATE-REV;
    try
        call "VHCM018"(XDCONTROL, VHCM018_CRIT, VHCM018_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
     (VHCM018_CRIT.NO-RECORD-FOUND == "N"))
  
        if (VHCM018_DATA.CON-STAT == "OUT" ||
         VHCM018_DATA.CON-STAT == "SWP" ||
         VHCM018_DATA.CON-STAT == "CON")
            VHCM01IS-PSEU();
  
  
  
        else
            if (VHCM018_DATA.CON-STAT == "SRV" ||
             VHCM018_DATA.CON-STAT == "CAR")
  
                if (VHCM018_DATA.CAR-NO[1] != VHCM01IW-PASS-RIGH.CAR-NO-1 ||
                 VHCM018_DATA.CAR-NO[2] != VHCM01IW-PASS-RIGH.CAR-NO-2 ||
                 VHCM018_DATA.CAR-NO[3] != VHCM01IW-PASS-RIGH.CAR-NO-3 ||
                 VHCM018_DATA.CAR-NO[4] != VHCM01IW-PASS-RIGH.CAR-NO-4 ||
                 VHCM018_DATA.CAR-NO[5] != VHCM01IW-PASS-RIGH.CAR-NO-5 ||
                 VHCM018_DATA.CAR-NO[6] != VHCM01IW-PASS-RIGH.CAR-NO-6 ||
                 VHCM018_DATA.CAR-NO[7] != VHCM01IW-PASS-RIGH.CAR-NO-7 ||
                 VHCM018_DATA.CAR-NO[8] != VHCM01IW-PASS-RIGH.CAR-NO-8 ||
                 VHCM018_DATA.CAR-NO[9] != VHCM01IW-PASS-RIGH.CAR-NO-9 ||
                 VHCM018_DATA.CAR-NO[10] != VHCM01IW-PASS-RIGH.CAR-NO-10)
                    VHCM01IW-CON-MSG.CON-MSG-1 = "Train Configuration has been changed, Updates NOT made";
                    return;
                end
            end
        end
    end
    if (VHCM01IW-CON-MSG.CON-MSG-1 == " ")
        VHCM01IS-CT-2();
    end
end 

Function VHCM01IS-PSEU () 
    set VHCM014_CRIT empty;
    VHCM014_CRIT.CON-NO = VHCM01IW.TRAIN;
    try
        call "VHCM014"(XDCONTROL, VHCM014_CRIT, VHCM014_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
        if (VHCM014_DATA.CAR-NO[1] != VHCM01IW-PASS-RIGH.CAR-NO-1 ||
         VHCM014_DATA.CAR-NO[2] != VHCM01IW-PASS-RIGH.CAR-NO-2 ||
         VHCM014_DATA.CAR-NO[3] != VHCM01IW-PASS-RIGH.CAR-NO-3 ||
         VHCM014_DATA.CAR-NO[4] != VHCM01IW-PASS-RIGH.CAR-NO-4 ||
         VHCM014_DATA.CAR-NO[5] != VHCM01IW-PASS-RIGH.CAR-NO-5 ||
         VHCM014_DATA.CAR-NO[6] != VHCM01IW-PASS-RIGH.CAR-NO-6 ||
         VHCM014_DATA.CAR-NO[7] != VHCM01IW-PASS-RIGH.CAR-NO-7 ||
         VHCM014_DATA.CAR-NO[8] != VHCM01IW-PASS-RIGH.CAR-NO-8 ||
         VHCM014_DATA.CAR-NO[9] != VHCM01IW-PASS-RIGH.CAR-NO-9 ||
         VHCM014_DATA.CAR-NO[10] != VHCM01IW-PASS-RIGH.CAR-NO-10)
            VHCM01IW-CON-MSG.CON-MSG-1 = "Train Configuration has been changed, Updates NOT made";
            return;
        end
    end
end 

Function VHCM01IS-REV-TIME () 
    try
        call "VHMT016"(XDCONTROL, VHMT016_DATA);
    
    end
    VHXREVC_DATA.DB-REVENUE-DATE = VHMT016_DATA.REVENUE-DATE;
  
    VHXREVC_DATA.END-TIME-DAY = "24.00.00";

  
  
    VHXREVC_DATA.TIME-REV-START = "03.00.00";
    VHXREVC_DATA.TIME-REV-END = "02.59.59";

  
  
  
  
  
    VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    VHXREVC_DATA.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    VHXREVC_DATA.SYS-MINUTES = (VHXREVC_DATA.SYSTEM-TIME-HR-NUM * 60) + VHXREVC_DATA.SYSTEM-TIME-MIN-NUM;
    if (VHXREVC_DATA.SYS-MINUTES < 180)
  
  
        XXDATEW.DATE-YYYY-MM-DD = VHXREVC_DATA.DB-REVENUE-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHXREVC_DATA.REVENUE-DATE = XXDATEW.DATE-MM-DD-YYYY;
    else
        VHXREVC_DATA.REVENUE-DATE = VHXREVC_DATA.SYSTEM-DATE;
    end
end 

Function VHCM01IS-RUN-TIME ()
  
  
   
    if (VHCM01IW.TIME-OUTSRV-HH-Y >= 00 &&
     VHCM01IW.TIME-OUTSRV-HH-Y <= 02)
        VHCM01IW.TIME-OUTSRV-HH-Y = VHCM01IW.TIME-OUTSRV-HH-Y + 24;
    end
    if (VHCM01IW.TIME-INSRV-HH-Y >= 00 &&
     VHCM01IW.TIME-INSRV-HH-Y <= 02)
        VHCM01IW.TIME-INSRV-HH-Y = VHCM01IW.TIME-INSRV-HH-Y + 24;
    end
    VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH = VHCM01IW.TIME-OUTSRV-HH-Y;
    VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-MM = VHCM01IW.TIME-OUTSRV-MM-Y;
    VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-SS = VHCM01IW.TIME-OUTSRV-SS;
    VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH = VHCM01IW-PASS-LEFT.TIME-INSRV-HH;
    VHCM01IW-PASS-LEFT.WS-TIME-INSRV-MM = VHCM01IW-PASS-LEFT.TIME-INSRV-MM;
    VHCM01IW-PASS-LEFT.WS-TIME-INSRV-SS = VHCM01IW-PASS-LEFT.TIME-INSRV-SS;
    if (VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH <
     VHCM01IW-PASS-LEFT.TIME-REV-START-HH)
        VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH = VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH + 24;
    else
        if (VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH ==
         VHCM01IW-PASS-LEFT.TIME-REV-START-HH && VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-MM < VHCM01IW-PASS-LEFT.TIME-REV-START-MM)
            VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH = VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH + 24;
        end
    end
    if (VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH <
     VHCM01IW-PASS-LEFT.TIME-REV-START-HH)
        VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH = VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH + 24;
    else
        if (VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH ==
         VHCM01IW-PASS-LEFT.TIME-REV-START-HH && VHCM01IW-PASS-LEFT.WS-TIME-INSRV-MM < VHCM01IW-PASS-LEFT.TIME-REV-START-MM)
            VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH = VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH + 24;
        end
    end
    if (VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-MM <
     VHCM01IW-PASS-LEFT.WS-TIME-INSRV-MM)
        VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-MM = VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-MM + 60;
        VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH = VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH - 1;
    end
    if (VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH >= VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH)
        VHCM01IW-PASS-LEFT.DIFF-HH = VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH - VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH;
        VHCM01IW-PASS-LEFT.DIFF-MM = VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-MM - VHCM01IW-PASS-LEFT.WS-TIME-INSRV-MM;
    else
        if (VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH < VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH)
            if (VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-MM > 59)
                VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-MM = VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-MM - 60;
                VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH = VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH + 1;
            end
            if (VHCM01IW-PASS-LEFT.WS-TIME-INSRV-MM < VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-MM)
                VHCM01IW-PASS-LEFT.WS-TIME-INSRV-MM = VHCM01IW-PASS-LEFT.WS-TIME-INSRV-MM + 60;
                VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH = VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH - 1;
            end
            VHCM01IW-PASS-LEFT.DIFF-HH = VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-HH - VHCM01IW-PASS-LEFT.WS-TIME-INSRV-HH;
            VHCM01IW-PASS-LEFT.DIFF-MM = VHCM01IW-PASS-LEFT.WS-TIME-OUTSRV-MM - VHCM01IW-PASS-LEFT.WS-TIME-INSRV-MM;
            VHCM01IW-PASS-LEFT.DIFF-HH = VHCM01IW-PASS-LEFT.DIFF-HH * -1;
            VHCM01IW-PASS-LEFT.DIFF-MM = VHCM01IW-PASS-LEFT.DIFF-MM * -1;
        end
    end
    VHCM01IW-CON-MSG.CON-MSG-HH = VHCM01IW-PASS-LEFT.DIFF-HH;
    VHCM01IW-CON-MSG.CON-MSG-MM = VHCM01IW-PASS-LEFT.DIFF-MM;

  
  
  
    VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH = VHCM01IW.TIME-OUTSRV-HH-Y;
    VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-MM = VHCM01IW.TIME-OUTSRV-MM-Y;
    VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-SS = VHCM01IW.TIME-OUTSRV-SS;
    VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH = VHCM01IW-PASS-RIGH.TIME-INSRV-HH;
    VHCM01IW-PASS-RIGH.WS-TIME-INSRV-MM = VHCM01IW-PASS-RIGH.TIME-INSRV-MM;
    VHCM01IW-PASS-RIGH.WS-TIME-INSRV-SS = VHCM01IW-PASS-RIGH.TIME-INSRV-SS;
    if (VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH <
     VHCM01IW-PASS-RIGH.TIME-REV-START-HH)
        VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH = VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH + 24;
    else
        if (VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH ==
         VHCM01IW-PASS-RIGH.TIME-REV-START-HH && VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-MM < VHCM01IW-PASS-RIGH.TIME-REV-START-MM)
            VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH = VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH + 24;
        end
    end
    if (VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH <
     VHCM01IW-PASS-RIGH.TIME-REV-START-HH)
        VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH = VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH + 24;
    else
        if (VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH ==
         VHCM01IW-PASS-RIGH.TIME-REV-START-HH && VHCM01IW-PASS-RIGH.WS-TIME-INSRV-MM < VHCM01IW-PASS-RIGH.TIME-REV-START-MM)
            VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH = VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH + 24;
        end
    end
    if (VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-MM <
     VHCM01IW-PASS-RIGH.WS-TIME-INSRV-MM)
        VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-MM = VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-MM + 60;
        VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH = VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH - 1;
    end
    if (VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH >= VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH)
        VHCM01IW-PASS-RIGH.DIFF-HH = VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH - VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH;
        VHCM01IW-PASS-RIGH.DIFF-MM = VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-MM - VHCM01IW-PASS-RIGH.WS-TIME-INSRV-MM;
    else
        if (VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH < VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH)
            if (VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-MM > 59)
                VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-MM = VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-MM - 60;
                VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH = VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH + 1;
            end
            if (VHCM01IW-PASS-RIGH.WS-TIME-INSRV-MM < VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-MM)
                VHCM01IW-PASS-RIGH.WS-TIME-INSRV-MM = VHCM01IW-PASS-RIGH.WS-TIME-INSRV-MM + 60;
                VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH = VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH - 1;
            end
            VHCM01IW-PASS-RIGH.DIFF-HH = VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-HH - VHCM01IW-PASS-RIGH.WS-TIME-INSRV-HH;
            VHCM01IW-PASS-RIGH.DIFF-MM = VHCM01IW-PASS-RIGH.WS-TIME-OUTSRV-MM - VHCM01IW-PASS-RIGH.WS-TIME-INSRV-MM;
            VHCM01IW-PASS-RIGH.DIFF-HH = VHCM01IW-PASS-RIGH.DIFF-HH * -1;
            VHCM01IW-PASS-RIGH.DIFF-MM = VHCM01IW-PASS-RIGH.DIFF-MM * -1;
        end
    end
    VHCM01IW-CON-MSG.CON-MSG-HH = VHCM01IW-PASS-RIGH.DIFF-HH;
    VHCM01IW-CON-MSG.CON-MSG-MM = VHCM01IW-PASS-RIGH.DIFF-MM;
end 

Function VHCM01IS-SPLIT () 
    VHCM01IS-SPLIT-TME();
    VHCM01IW-PASSVALUE.END-CAR-HRS = VHCM01IW-PASSVALUE.END-CAR-HRS + VHCM01IW-PASSVALUE.DIFF-HH-SPLIT-END;
    VHCM01IW-PASSVALUE.END-CAR-MIN = VHCM01IW-PASSVALUE.END-CAR-MIN + VHCM01IW-PASSVALUE.DIFF-MM-SPLIT-END;
    if (VHCM01IW-PASSVALUE.END-CAR-MIN > 59)
        VHCM01IW-PASSVALUE.END-CAR-HRS = VHCM01IW-PASSVALUE.END-CAR-HRS + 1;
        VHCM01IW-PASSVALUE.END-CAR-MIN = VHCM01IW-PASSVALUE.END-CAR-MIN - 60;
    end
    VHCM01IW-PASSVALUE.MID-CAR-HRS = VHCM01IW-PASSVALUE.MID-CAR-HRS + VHCM01IW-PASSVALUE.DIFF-HH-SPLIT-MID;
    VHCM01IW-PASSVALUE.MID-CAR-MIN = VHCM01IW-PASSVALUE.MID-CAR-MIN + VHCM01IW-PASSVALUE.DIFF-MM-SPLIT-MID;
    if (VHCM01IW-PASSVALUE.MID-CAR-MIN > 59)
        VHCM01IW-PASSVALUE.MID-CAR-HRS = VHCM01IW-PASSVALUE.MID-CAR-HRS + 1;
        VHCM01IW-PASSVALUE.MID-CAR-MIN = VHCM01IW-PASSVALUE.MID-CAR-MIN - 60;
    end
end 

Function VHCM01IS-SPLIT-TME ()
  
  
  
  
   
    VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH = VHCM01IW-PASSVALUE.TIME-END-CAR-HH;
    VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM = VHCM01IW-PASSVALUE.TIME-END-CAR-MM;
    VHCM01IW-PASSVALUE.WS-TIME-END-CAR-SS = VHCM01IW-PASSVALUE.TIME-END-CAR-SS;
    VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-HH = VHCM01IW.TIME-OUTSRV-HH-Y;
    VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-MM = VHCM01IW.TIME-OUTSRV-MM-Y;
    VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-SS = VHCM01IW.TIME-OUTSRV-SS;
    VHCM01IW-PASSVALUE.WS-TIME-INSRV-HH = VHCM01IW-PASSVALUE.TIME-INSRV-HH;
    VHCM01IW-PASSVALUE.WS-TIME-INSRV-MM = VHCM01IW-PASSVALUE.TIME-INSRV-MM;
    VHCM01IW-PASSVALUE.WS-TIME-INSRV-SS = VHCM01IW-PASSVALUE.TIME-INSRV-SS;
  
    if (VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-MM <
     VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM)
        VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-MM = VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-MM + 60;
        VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-HH = VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-HH - 1;
    end
    if (VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-HH >= VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH)
        VHCM01IW-PASSVALUE.DIFF-HH-SPLIT-END = VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-HH - VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH;
        VHCM01IW-PASSVALUE.DIFF-MM-SPLIT-END = VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-MM - VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM;
    else
        if (VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-HH < VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH)
            if (VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-MM > 59)
                VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-MM = VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-MM - 60;
                VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-HH = VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-HH + 1;
            end
            if (VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM < VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-MM)
                VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM = VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM + 60;
                VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH = VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH - 1;
            end
            VHCM01IW-PASSVALUE.DIFF-HH-SPLIT-END = VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-HH - VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH;
            VHCM01IW-PASSVALUE.DIFF-MM-SPLIT-END = VHCM01IW-PASSVALUE.WS-TIME-OUTSRV-MM - VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM;
            
  
  
        end
    end
  
  
  
  
  
  
    if (VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM <
     VHCM01IW-PASSVALUE.WS-TIME-INSRV-MM)
        VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM = VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM + 60;
        VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH = VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH - 1;
    end
  
    if (VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH >= VHCM01IW-PASSVALUE.WS-TIME-INSRV-HH)
  
        VHCM01IW-PASSVALUE.DIFF-HH-SPLIT-MID = VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH - VHCM01IW-PASSVALUE.WS-TIME-INSRV-HH;
  
        VHCM01IW-PASSVALUE.DIFF-MM-SPLIT-MID = VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM - VHCM01IW-PASSVALUE.WS-TIME-INSRV-MM;
    else
  
        if (VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH < VHCM01IW-PASSVALUE.WS-TIME-INSRV-HH)
            if (VHCM01IW-PASSVALUE.WS-TIME-INSRV-MM > 59)
                VHCM01IW-PASSVALUE.WS-TIME-INSRV-MM = VHCM01IW-PASSVALUE.WS-TIME-INSRV-MM - 60;
                VHCM01IW-PASSVALUE.WS-TIME-INSRV-HH = VHCM01IW-PASSVALUE.WS-TIME-INSRV-HH + 1;
            end
            if (VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM < VHCM01IW-PASSVALUE.WS-TIME-INSRV-MM)
                VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM = VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM + 60;
                VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH = VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH - 1;
            end
  
            VHCM01IW-PASSVALUE.DIFF-HH-SPLIT-MID = VHCM01IW-PASSVALUE.WS-TIME-END-CAR-HH - VHCM01IW-PASSVALUE.WS-TIME-INSRV-HH;
  
            VHCM01IW-PASSVALUE.DIFF-MM-SPLIT-MID = VHCM01IW-PASSVALUE.WS-TIME-END-CAR-MM - VHCM01IW-PASSVALUE.WS-TIME-INSRV-MM;
            VHCM01IW-PASSVALUE.DIFF-HH-SPLIT-END = VHCM01IW-PASSVALUE.DIFF-HH * -1;
            
  
        end
    end
end 

Function VHCM01IS-STATUS () 
    if (VHCM01IW-PASSVALUE.VEH-STAT == "ERROR")
        VHCM01IW-PASSVALUE.VEH-STAT = VHCM01IW-PASSVALUE.VEH-STAT-PREV;
        VHCM01IW-PASSVALUE.VEH-STAT-PREV = " ";
        VHCM01IW-PASSVALUE.STAT-CHG-SW = "Y";
        
  
  
  
  
  
  
  
  
  
  
  
  
    end
end 

Function VHCM01IS-SVC-HIST ()
   
    if (VHCM01IW-TRIGGER.YES-SPLIT == "Y")
        VHCM01IW-SVR-REC.END-CAR-HRS-HIST = VHCM01IW-SVR-REC.END-CAR-HRS-HIST + VHCM01IW-PASSVALUE.DIFF-HH-SPLIT-END;
        VHCM01IW-SVR-REC.END-CAR-MIN-HIST = VHCM01IW-SVR-REC.END-CAR-MIN-HIST + VHCM01IW-PASSVALUE.DIFF-MM-SPLIT-END;
        if (VHCM01IW-SVR-REC.END-CAR-MIN-HIST > 59)
            VHCM01IW-SVR-REC.END-CAR-HRS-HIST = VHCM01IW-SVR-REC.END-CAR-HRS-HIST + 1;
            VHCM01IW-SVR-REC.END-CAR-MIN-HIST = VHCM01IW-SVR-REC.END-CAR-MIN-HIST - 60;
        end
        VHCM01IW-SVR-REC.MID-CAR-HRS-HIST = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST + VHCM01IW-PASSVALUE.DIFF-HH-SPLIT-MID;
        VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST + VHCM01IW-PASSVALUE.DIFF-MM-SPLIT-MID;
        if (VHCM01IW-SVR-REC.MID-CAR-MIN-HIST > 59)
            VHCM01IW-SVR-REC.MID-CAR-HRS-HIST = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST + 1;
            VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST - 60;
        end
    else
        if (VHCM01IW-PASSVALUE.END-CAR-SW == "Y")
            if (VHCM01IW-PASSVALUE.CAR-LR == "L")
                VHCM01IW-SVR-REC.END-CAR-HRS-HIST = VHCM01IW-SVR-REC.END-CAR-HRS-HIST + VHCM01IW-PASS-LEFT.DIFF-HH;
                VHCM01IW-SVR-REC.END-CAR-MIN-HIST = VHCM01IW-SVR-REC.END-CAR-MIN-HIST + VHCM01IW-PASS-LEFT.DIFF-MM;
                if (VHCM01IW-SVR-REC.END-CAR-MIN-HIST > 59)
                    VHCM01IW-SVR-REC.END-CAR-HRS-HIST = VHCM01IW-SVR-REC.END-CAR-HRS-HIST + 1;
                    VHCM01IW-SVR-REC.END-CAR-MIN-HIST = VHCM01IW-SVR-REC.END-CAR-MIN-HIST - 60;
                end
            else
                VHCM01IW-SVR-REC.END-CAR-HRS-HIST = VHCM01IW-SVR-REC.END-CAR-HRS-HIST + VHCM01IW-PASS-RIGH.DIFF-HH;
                VHCM01IW-SVR-REC.END-CAR-MIN-HIST = VHCM01IW-SVR-REC.END-CAR-MIN-HIST + VHCM01IW-PASS-RIGH.DIFF-MM;
                if (VHCM01IW-SVR-REC.END-CAR-MIN-HIST > 59)
                    VHCM01IW-SVR-REC.END-CAR-HRS-HIST = VHCM01IW-SVR-REC.END-CAR-HRS-HIST + 1;
                    VHCM01IW-SVR-REC.END-CAR-MIN-HIST = VHCM01IW-SVR-REC.END-CAR-MIN-HIST - 60;
                end
            end
        end
        if (VHCM01IW-PASSVALUE.MID-CAR-SW == "Y")
            if (VHCM01IW-PASSVALUE.CAR-LR == "L")
                VHCM01IW-SVR-REC.MID-CAR-HRS-HIST = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST + VHCM01IW-PASS-LEFT.DIFF-HH;
                VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST + VHCM01IW-PASS-LEFT.DIFF-MM;
                if (VHCM01IW-SVR-REC.MID-CAR-MIN-HIST > 59)
                    VHCM01IW-SVR-REC.MID-CAR-HRS-HIST = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST + 1;
                    VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST - 60;
                end
            else
                VHCM01IW-SVR-REC.MID-CAR-HRS-HIST = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST + VHCM01IW-PASS-RIGH.DIFF-HH;
                VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST + VHCM01IW-PASS-RIGH.DIFF-MM;
                if (VHCM01IW-SVR-REC.MID-CAR-MIN-HIST > 59)
                    VHCM01IW-SVR-REC.MID-CAR-HRS-HIST = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST + 1;
                    VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST - 60;
                end
            end
        end
    end
end 

Function VHCM01IS-SVC-HIT1 () 
    if (VHCM01IW-PASSVALUE.CAR-LR == "L")
        VHCM01IW-SVR-REC.CURR-CAR-HRS = VHCM01IW-SVR-REC.CURR-CAR-HRS + VHCM01IW-PASS-LEFT.DIFF-HH;
        VHCM01IW-SVR-REC.CURR-CAR-MIN = VHCM01IW-SVR-REC.CURR-CAR-MIN + VHCM01IW-PASS-LEFT.DIFF-MM;
    else
        VHCM01IW-SVR-REC.CURR-CAR-HRS = VHCM01IW-SVR-REC.CURR-CAR-HRS + VHCM01IW-PASS-RIGH.DIFF-HH;
        VHCM01IW-SVR-REC.CURR-CAR-MIN = VHCM01IW-SVR-REC.CURR-CAR-MIN + VHCM01IW-PASS-RIGH.DIFF-MM;
    end
    if (VHCM01IW-SVR-REC.CURR-CAR-MIN > 59)
        VHCM01IW-SVR-REC.CURR-CAR-HRS = VHCM01IW-SVR-REC.CURR-CAR-HRS + 1;
        VHCM01IW-SVR-REC.CURR-CAR-MIN = VHCM01IW-SVR-REC.CURR-CAR-MIN - 60;
    end
end 

Function VHCM01IS-TIME ()
   
    VHCM01IW.TIME-FILLER-2 = " ";
    VHCM01IW.TIME-OUTSRV-SS = " ";
end 

Function VHCM01IS-TIME-MSG () 
    if (VHCM01IW-TRIGGER.TIME-NOT-NUMERIC == "Y")
        VHCM01IW-TIME-MSG.MSG-1 = "TIME  SHOULD BE NUMERIC";
        VHCM01IW-TRIGGER.TIME-NOT-NUMERIC = " ";
    end
    if (VHCM01IW-TRIGGER.TIME-OUT-RANGE == "Y")
        VHCM01IW-TIME-MSG.MSG-1 = "TIME HOURS SHOULD BETWEEN 00-23, TIME MINUTES SHOULD BETWEEN 00-59";
        VHCM01IW-TRIGGER.TIME-OUT-RANGE = " ";
    end
  
  
  
  
  
    if (VHCM01IW-TRIGGER.TIME-OUT-ERROR == "Y")
        VHCM01IW-TIME-MSG.MSG-3 = "Out-of-Service time must be greater than In-Service time";
        VHCM01IW-TIME-MSG.MSG-3-XX-1 = VHCM01IW.TIME-INSRV-HH-Y;
        VHCM01IW-TIME-MSG.MSG-3-XX-2 = ":";
        VHCM01IW-TIME-MSG.MSG-3-XX-3 = VHCM01IW.TIME-INSRV-MM-Y;
        VHCM01IW-TIME-MSG.MSG-1 = VHCM01IW-TIME-MSG.MSG-3;
        VHCM01IW-TRIGGER.TIME-OUT-ERROR = " ";
    end
end 

Function VHCM01IS-TRAIN-MSG () 
    if (VHCM01IW-TRIGGER.TRAIN-NOT-INSRV == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST NOT IN SERVICE";
        VHCM01IW-TRIGGER.TRAIN-NOT-INSRV = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST NOT IN SERVICE";
        VHCM01IW-TRIGGER.TRAIN = "Y";
    end
    if (VHCM01IW-TRIGGER.TRAIN-STAT-ERROR == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST STATUS ERROR";
  
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST STATUS ERROR";
        VHCM01IW-TRIGGER.TRAIN = "Y";
    end
    if (VHCM01IW-TRIGGER.TRAIN-NUMERIC-ERR == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST NUMERIC ERROR";
        VHCM01IW-TRIGGER.TRAIN-NUMERIC-ERR = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99 OR CANNOT BE SAME AS COMBINE TRAIN NO";
        VHCM01IW-TRIGGER.TRAIN = "Y";
    end
    if (VHCM01IW-TRIGGER.TRAIN-NOT-EXIST == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST NOT EXIST";
        VHCM01IW-TRIGGER.TRAIN-NOT-EXIST = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST MUST BE > 99";
        VHCM01IW-TRIGGER.TRAIN = "Y";
    end
    if (VHCM01IW-TRIGGER.TRAIN-TRBL == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "CONSIST HAS TRAIN INCIDENT";
        VHCM01IW-TRIGGER.TRAIN-TRBL = " ";
        VHCM01IW-CON-MSG.CON-MESSAGE = VHCM01IW.TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-1-X = VHCM01IW-CON-MSG.CON-MESSAGE;
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "-CONSIST HAS TRAIN INCIDENT";
        VHCM01IW-TRIGGER.TRAIN = "Y";
    end
    if (VHCM01IW-TRIGGER.COMPL-CLEAR == "Y")
        VHCM01IW-TRIGGER.COMPL-CLEAR = " ";
        VHCM01IW-CON-MSG.CON-MSG-2-X = "TRAIN ";
        VHCM01IW-CON-MSG.CON-MSG-2-XX = VHCM01IW.TRAIN;
        VHCM01IW-CON-MSG.CON-MSG-2-XXX = " SUCCESSFULLY CLEARED TO ";
        VHCM01IW-CON-MSG.CON-MSG-2-XXXX = VHCM01IW.YARD-LOC;
        VHCM01IW-CON-MSG.CON-MSG-2-XXXXX = ". RUN TIME ";
  
  
  
        VHCM01IW-CON-MSG.CON-MSG-FILLER = ":";
        VHCM01IW-CON-MSG.CON-MSG-1 = VHCM01IW-CON-MSG.CON-MSG-2;
        VHCM01IW-TRIGGER.TRAIN = "Y";
    end
end 

Function VHCM01IS-UPD-CON ()
  
  
  
  
  
  
  
  
  
   
    VHCM015_CRIT.PSEUDO-CAR-SW = VHCM01IW-PASS-RIGH.PSEUDO-CAR-SW;
    VHCM015_CRIT.LEFT-RIGHT = VHCM01IW-PASSVALUE.LEFT-RIGHT;
    VHCM01IS-MOVE-LEFT();

  

  
  
    VHCM01IS-MOVE-RIGH();

  
  
  

  
    VHCM01IS-MOVE-BOTH();

  
  
    try
        call "VHCM015"(XDCONTROL, VHCM015_CRIT, VHCM015_CRIT-VEH-L, VHCM015_CRIT-VEH-R, VHCM015_CRIT-CONHL, VHCM015_CRIT-CONHR, VHCM015_CRIT-HIS-L, VHCM015_CRIT-HIS-R, VHCM015_CRIT-SVR-L, VHCM015_CRIT-SVR-R);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  
  
        if (VHCM015_CRIT.ERROR-YARD-TRACK == "Y")
            VHCM01IW-CON-MSG.CON-MSG-3-X = "No room on ";
            VHCM01IW-CON-MSG.CON-MSG-3-XX = VHCM015_CRIT.CURR-LOC;
            VHCM01IW-CON-MSG.CON-MSG-3-XXX = " Pseudo Track for new location (can only hold";
            VHCM01IW-CON-MSG.CON-MSG-3-XXXX = VHCM015_CRIT.MAX-POSN;
            VHCM01IW-CON-MSG.CON-MSG-3-XXXXX = " cars).";
        else
            VHCM01IW-TRIGGER.COMPLETE-COMBINE = "Y";
            
  
  
        end
    else
  
  
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHCM01IS-VALD-CAR () 
    if (LAST-CAR-NO == 10)
        VHCM01IS-CAL10();
        VHCM01IS-CAL9();
        VHCM01IS-CAL8();
        VHCM01IS-CAL7();
        VHCM01IS-CAL6();
        VHCM01IS-CAL5();
        VHCM01IS-CAL4();
        VHCM01IS-CAL3();
        VHCM01IS-CAL2();
        VHCM01IS-CAL1();
    else
        if (LAST-CAR-NO == 9)
            VHCM01IS-CAL9();
            VHCM01IS-CAL8();
            VHCM01IS-CAL7();
            VHCM01IS-CAL6();
            VHCM01IS-CAL5();
            VHCM01IS-CAL4();
            VHCM01IS-CAL3();
            VHCM01IS-CAL2();
            VHCM01IS-CAL1();
        else
            if (LAST-CAR-NO == 8)
                VHCM01IS-CAL8();
                VHCM01IS-CAL7();
                VHCM01IS-CAL6();
                VHCM01IS-CAL5();
                VHCM01IS-CAL4();
                VHCM01IS-CAL3();
                VHCM01IS-CAL2();
                VHCM01IS-CAL1();
            else
                if (LAST-CAR-NO == 7)
                    VHCM01IS-CAL7();
                    VHCM01IS-CAL6();
                    VHCM01IS-CAL5();
                    VHCM01IS-CAL4();
                    VHCM01IS-CAL3();
                    VHCM01IS-CAL2();
                    VHCM01IS-CAL1();
                else
                    if (LAST-CAR-NO == 6)
                        VHCM01IS-CAL6();
                        VHCM01IS-CAL5();
                        VHCM01IS-CAL4();
                        VHCM01IS-CAL3();
                        VHCM01IS-CAL2();
                        VHCM01IS-CAL1();
                    else
                        if (LAST-CAR-NO == 5)
                            VHCM01IS-CAL5();
                            VHCM01IS-CAL4();
                            VHCM01IS-CAL3();
                            VHCM01IS-CAL2();
                            VHCM01IS-CAL1();
                        else
                            if (LAST-CAR-NO == 4)
                                VHCM01IS-CAL4();
                                VHCM01IS-CAL3();
                                VHCM01IS-CAL2();
                                VHCM01IS-CAL1();
                            else
                                if (LAST-CAR-NO == 3)
                                    VHCM01IS-CAL3();
                                    VHCM01IS-CAL2();
                                    VHCM01IS-CAL1();
                                else
                                    if (LAST-CAR-NO == 2)
                                        VHCM01IS-CAL2();
                                        VHCM01IS-CAL1();
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHCM01IS-VALID-CAR () 
    VHCM01IW-PASSVALUE.LAST-CAR-NO = VHCM01IW.TOTAL-CAR-COUNT;
    VHCM01IW-PASSVALUE.CON-SIZE = VHCM01IW.TOTAL-CAR-COUNT;
    VHCM01IW-TRIGGER.CAR-TYPE-ERROR = " ";
    VHCM01IW.COUNTER = 2;
    while (VHCM01IW.COUNTER < VHCM01IW-PASSVALUE.LAST-CAR-NO)
        if (VHCM01IW-1.CAR-TYPE-X[VHCM01IW.COUNTER] == "A1" ||
         VHCM01IW-1.CAR-TYPE-X[VHCM01IW.COUNTER] == "A2")
            VHCM01IW-TRIGGER.CAR-TYPE-ERROR = "Y";
            VHCM01IW-TRIGGER.CAR-TYPE-ERR-NO = VHCM01IW-1.CAR-NO-X[VHCM01IW.COUNTER];
            VHCM01IS-CTYPE-MSG();
        end
        VHCM01IW.COUNTER = VHCM01IW.COUNTER + 1;
    end
    VHCM01IW-PASSVALUE.CAR-TYPE-1 = VHCM01IW-1.CAR-TYPE-X[1];
    VHCM01IW-PASSVALUE.CAR-TYPE-2 = VHCM01IW-1.CAR-TYPE-X[2];
    VHCM01IW-PASSVALUE.CAR-TYPE-3 = VHCM01IW-1.CAR-TYPE-X[3];
    VHCM01IW-PASSVALUE.CAR-TYPE-4 = VHCM01IW-1.CAR-TYPE-X[4];
    VHCM01IW-PASSVALUE.CAR-TYPE-5 = VHCM01IW-1.CAR-TYPE-X[5];
    VHCM01IW-PASSVALUE.CAR-TYPE-6 = VHCM01IW-1.CAR-TYPE-X[6];
    VHCM01IW-PASSVALUE.CAR-TYPE-7 = VHCM01IW-1.CAR-TYPE-X[7];
    VHCM01IW-PASSVALUE.CAR-TYPE-8 = VHCM01IW-1.CAR-TYPE-X[8];
    VHCM01IW-PASSVALUE.CAR-TYPE-9 = VHCM01IW-1.CAR-TYPE-X[9];
    VHCM01IW-PASSVALUE.CAR-TYPE-10 = VHCM01IW-1.CAR-TYPE-X[10];
    VHCM01IW-PASSVALUE.CAR-NO-1 = VHCM01IW-1.CAR-NO-X[1];
    VHCM01IW-PASSVALUE.CAR-NO-2 = VHCM01IW-1.CAR-NO-X[2];
    VHCM01IW-PASSVALUE.CAR-NO-3 = VHCM01IW-1.CAR-NO-X[3];
    VHCM01IW-PASSVALUE.CAR-NO-4 = VHCM01IW-1.CAR-NO-X[4];
    VHCM01IW-PASSVALUE.CAR-NO-5 = VHCM01IW-1.CAR-NO-X[5];
    VHCM01IW-PASSVALUE.CAR-NO-6 = VHCM01IW-1.CAR-NO-X[6];
    VHCM01IW-PASSVALUE.CAR-NO-7 = VHCM01IW-1.CAR-NO-X[7];
    VHCM01IW-PASSVALUE.CAR-NO-8 = VHCM01IW-1.CAR-NO-X[8];
    VHCM01IW-PASSVALUE.CAR-NO-9 = VHCM01IW-1.CAR-NO-X[9];
    VHCM01IW-PASSVALUE.CAR-NO-10 = VHCM01IW-1.CAR-NO-X[10];
end 

Function VHCM01IS-VALID-TME () 
    move TIME-OUTSRV-HH to TIME-OUTSRV-HH-X withV60Compat;
    move TIME-OUTSRV-MM to TIME-OUTSRV-MM-X withV60Compat;
    move TIME-OUTSRV-HH to TIME-OUTSRV-HH-Y withV60Compat;
    move TIME-OUTSRV-MM to TIME-OUTSRV-MM-Y withV60Compat;
    if (VHCM01IW.TIME-OUTSRV-HH is numeric)
        if (VHCM01IW.TIME-OUTSRV-HH-X < 00 ||
         VHCM01IW.TIME-OUTSRV-HH-X > 23)
            VHCM01IW-TRIGGER.TIME-OUT-RANGE = "Y";
            VHCM01IW-TRIGGER.TIME-ERROR = "Y";
            VHCM01IW-TRIGGER.TIME-ERROR-X = "Y";
        else
            if (VHCM01IW.TIME-OUTSRV-MM is numeric)
                if (VHCM01IW.TIME-OUTSRV-MM-X < 00 ||
                 VHCM01IW.TIME-OUTSRV-MM-X > 59)
                    VHCM01IW-TRIGGER.TIME-OUT-RANGE = "Y";
                    VHCM01IW-TRIGGER.TIME-ERROR = "Y";
                    VHCM01IW-TRIGGER.TIME-ERROR-X = "Y";
                end
            else
                VHCM01IW-TRIGGER.TIME-NOT-NUMERIC = "Y";
                VHCM01IW-TRIGGER.TIME-ERROR = "Y";
                VHCM01IW-TRIGGER.TIME-ERROR-X = "Y";
            end
        end
    else
        VHCM01IW-TRIGGER.TIME-NOT-NUMERIC = "Y";
        VHCM01IW-TRIGGER.TIME-ERROR = "Y";
        VHCM01IW-TRIGGER.TIME-ERROR-X = "Y";
    end
    VHCM01IS-TIME-MSG();
end 

Function VHCM01IS-VALID-YRD () 
    VHCM01IW-TRIGGER.WHERE-SW = "N";
    VHCM01IW-TRIGGER.YARD-ERROR = "N";
    if (VHCM01IW.YARD-LOC == " ")
        VHCM01IW-TRIGGER.YARD-LOC-BLANK = "Y";
        VHCM01IW-TRIGGER.YARD-ERROR = "Y";
        VHCM01IW-CON-MSG.CON-MSG-1 = "COMBINE LOC CANNOT BE BLANK";
        
  
    else
        VHCM01IS-VLD-YRD1();
    end
end 

Function VHCM01IS-VLD-YRD1 () 
    VHCM01IW.YARD-COUNTER = 1;
    VHCM01IW-TRIGGER.SAME-YRD-LOC = "N";
    while (VHCM01IW.YARD-COUNTER <= VHCM017_CRIT.YRD-IDX)
  
        if (VHCM01IW.YARD-LOC == VHCM017_DATA.COMB-LOC[VHCM01IW.YARD-COUNTER])
  
            VHCM01IW-TRIGGER.SAME-YRD-LOC = "Y";
            return;
        else
            VHCM01IW.YARD-COUNTER = VHCM01IW.YARD-COUNTER + 1;
        end
    end
    if (VHCM01IW.YARD-COUNTER > VHCM017_CRIT.YRD-IDX &&
     VHCM01IW-TRIGGER.SAME-YRD-LOC == "N")
        VHCM01IW-TRIGGER.YARD-ERROR = "Y";
        VHCM01IW-CON-MSG.CON-MSG-1 = "INVALID YARD LOCATION";
    end
end 

Function VHCM01IS-YARD () 
    set VHCM017_CRIT empty;
    set VHCM017_DATA empty;
    try
        call "VHCM017"(XDCONTROL, VHCM017_CRIT, VHCM017_DATA);
    
    end
end 

Function VHCM01IS-YLOC-MSG () 
    if (VHCM01IW-TRIGGER.YARD-ERROR == "Y")
        VHCM01IW-CON-MSG.CON-MSG-1 = "COMBINE LOCATION INVALID";
        VHCM01IW-TRIGGER.YARD-ERROR = " ";
  
  
        VHCM01IW-CON-MSG.CON-MSG-1-X = " ";
        VHCM01IW-CON-MSG.CON-MSG-1-XX = "COMBINE LOCATION INVALID";
    end
end 

Function VHCM01IS-YT-CAR () 
    VHCM01IW-PASS-RIGH.CAR-COUNT = XDCONTROL.UROWCNT;
    VHCM01IW-PASS-RIGH.COUNTER = 1;
    while ((VHCM01IW-PASS-RIGH.COUNTER <= VHCM01IW-PASS-RIGH.CAR-COUNT))
        if (VHCM01IW-PASS-RIGH.COUNTER == 1)
            VHCM01IW-PASS-RIGH.CAR-NO-1-PSEUDO = "Y";
            VHCM01IW-PASS-RIGH.CAR-NO-1 = VHCM014_DATA.CAR-NO[1];
            VHCM01IW-PASS-RIGH.CON-NO-1 = VHCM014_DATA.CON-NO[1];
