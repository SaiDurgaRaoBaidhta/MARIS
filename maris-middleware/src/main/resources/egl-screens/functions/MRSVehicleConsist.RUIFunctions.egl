                                    VHMT01IW-TRIGGER.CAR-ERROR = "Y";
  
                                    VHMT01IW-TRIGGER.CAR10-LOC-SH = "Y";
                                else
                                    if (VHMT01IW-PASSVALUE.VEH-STAT != "GO" &&
                                     VHMT01IW-PASSVALUE.VEH-STAT != "USABLE" &&
                                     VHMT01IW-PASSVALUE.VEH-STAT != "ERROR")
                                        VHMT01IW-TRIGGER.CAR10-NO-GO = "Y";
                                        VHMT01IW-TRIGGER.CAR-ERROR = "Y";
                                    else
                                    	if (VHMT01IW-PASSVALUE.SOFT_VER-SAVE != VHMT01IW-PASSVALUE.SOFT_VER )
	                                            VHMT01IW-TRIGGER.CAR10-SOFTVER-ERR = "Y";
	                                            VHMT01IW-TRIGGER.CAR-ERROR = "Y";
	                                            
	                                    else
	                                        if (VHMT01IW-PASSVALUE.CURR-LOC != VHMT01IW-PASSVALUE.CURR-LOC-SAVE)
	                                            VHMT01IW-TRIGGER.CAR-ERROR = "Y";
	                                            VHMT01IW-TRIGGER.CAR10-LOC-ERR = "Y";
	
	                                            VHMT01IW-TRIGGER.CAR10-LOC-SH = "Y";
	                                            VHMT01IW-TRIGGER.CAR1-LOC-SH = "Y";
	                                        else
	                                            VHMT01IW-TRIGGER.CAR10-LOC-HI = "Y";
	                                            VHMT01IW-TRIGGER.CAR1-LOC-HI = "Y";
	                                        end
	                                    end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        else
            VHMT01IW-TRIGGER.NONUMERIC-CAR10 = "Y";
            VHMT01IW-TRIGGER.CAR-ERROR = "Y";
        end
    end
end 

Function VHMT01IS-VALID-TME () 
    if (VHMT01IW.TIME-INSRV-HR is numeric)
        if (VHMT01IW.TIME-INSRV-HR < 00 ||
         VHMT01IW.TIME-INSRV-HR > 23)
            VHMT01IW-TRIGGER.TIME-OUT-RANGE = "Y";
            VHMT01IW-TRIGGER.TIME-ERROR-X = "Y";
        else
            if (VHMT01IW.TIME-INSRV-MIN is numeric)
                if (VHMT01IW.TIME-INSRV-MIN < 00 ||
                 VHMT01IW.TIME-INSRV-MIN > 59)
                    VHMT01IW-TRIGGER.TIME-OUT-RANGE = "Y";
                    VHMT01IW-TRIGGER.TIME-ERROR-X = "Y";
                else
                    VHMT01IW.COMP-TIME-INSRV-HH = VHMT01IW.TIME-INSRV-HR;
                    VHMT01IW.COMP-TIME-INSRV-MM = VHMT01IW.TIME-INSRV-MIN;
                    VHMT01IW.COMP-TIME-SYSTEM-HH = VHMT01IW.CURRENT-TIME-HH;
                    VHMT01IW.COMP-TIME-SYSTEM-MM = VHMT01IW.CURRENT-TIME-MM;
                    
  
  
  
  
  
                end
            else
                VHMT01IW-TRIGGER.TIME-NOT-NUMERIC = "Y";
                VHMT01IW-TRIGGER.TIME-ERROR-X = "Y";
            end
        end
    else
        VHMT01IW-TRIGGER.TIME-NOT-NUMERIC = "Y";
        VHMT01IW-TRIGGER.TIME-ERROR-X = "Y";
    end
end 

Function VHMT01IS-VALID-TYP () 
    if (VHMT01IW.CON-CAR-SIZE > VHMT01IW-PASSVALUE.VAGen_COUNT)
        VHMT01IW-PASSVALUE.VAGen_COUNT = VHMT01IW.CON-CAR-SIZE;
    end
    VHMT01IW-TRIGGER.COUNTER = 1;
    NO-MORE-SW = "N";
    if (VHMT01IW-PASSVALUE.VAGen_COUNT > 0)
        while ((VHMT01IW-TRIGGER.COUNTER <= VHMT01IW-PASSVALUE.VAGen_COUNT))
  
            if (VHMT01IW-PASSVALUE.CAR-NO == VHMT014_DATA.CAR-NO[COUNTER])
                VHMT01IW-PASSVALUE.CAR-TYPE = VHMT014_DATA.CAR-TYPE[COUNTER];
                VHMT01IW-PASSVALUE.SOFT_VER = VHMT014_DATA.SOFT_VER[COUNTER];
                VHMT01IW-PASSVALUE.VEH-STAT = VHMT014_DATA.VEH-STAT[COUNTER];
                VHMT01IW-PASSVALUE.WHERE-IS-CAR = VHMT014_DATA.WHERE-IS-CAR[COUNTER];
                VHMT01IW-PASSVALUE.CURR-LOC = VHMT014_DATA.CURR-LOC[COUNTER];
                VHMT01IW-PASSVALUE.ATO-PRESENT-IND = VHMT014_DATA.ATO-PRESENT-IND[COUNTER];
                VHMT01IW-PASSVALUE.TRAIN-INCD-IND = VHMT014_DATA.TRAIN-INCD-IND[COUNTER];
                VHMT01IW-PASSVALUE.CON-NO = VHMT014_DATA.CON-NO[COUNTER];
                VHMT01IW-PASSVALUE.DASH-NO = VHMT014_DATA.DASH-NO[COUNTER];
                VHMT01IS-REV-ORINT();

                COUNTER = COUNTER + 1;
                NO-MORE-SW = "Y";
            else
                COUNTER = COUNTER + 1;
            end
        end
    else
        NO-MORE-SW = "Y";
    end

  
    if (NO-MORE-SW == "N")
        VHMT01IW-PASSVALUE.CAR-NOT-EXIST = "Y";
    end
end 

