                                                VHCM01IW-2.DATE-REV-X[NEW-COUNTER] = VHCM01IW-SVR-REC-R.CAR-NO-10-DATE-REV;
                                            else

                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        NEW-COUNTER = NEW-COUNTER + 1;
        VHCM01IW.COUNTER = VHCM01IW.COUNTER + 1;
    end
    VHCM01IS-MOVE-HRSH();
end 

