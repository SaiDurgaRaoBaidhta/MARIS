            VHCM01IW-PASS-RIGH.CAR-NO-1-CUM-HRS = VHCM014_DATA.CUM-HRS[1];
            VHCM01IW-SVR-REC.CAR-NO-1-PRV-HRS = VHCM014_DATA.CUM-HRS[1];
            VHCM01IW-PASS-RIGH.CAR-NO-1-CUM-MIN = VHCM014_DATA.CUM-MIN[1];
            VHCM01IW-SVR-REC.CAR-NO-1-PRV-MIN = VHCM014_DATA.CUM-MIN[1];
            VHCM01IW-PASS-RIGH.CAR-NO-1-BRK-HRS = VHCM014_DATA.BRK-IN-HRS[1];
            VHCM01IW-PASS-RIGH.CAR-NO-1-NEXT-PM = VHCM014_DATA.HRS-TO-NEXT-PM[1];
            VHCM01IW-PASS-RIGH.CAR-NO-1-FROM-PM = VHCM014_DATA.HRS-FROM-LAST-PM[1];
            VHCM01IW-PASS-RIGH.CAR-NO-1-MAX-PM = VHCM014_DATA.HRS-TO-NEXT-PM-MAX[1];
            VHCM01IW-PASS-RIGH.CAR-NO-1-MAX-BRK = VHCM014_DATA.BRK-IN-HRS-MAX[1];
            VHCM01IW-PASS-RIGH.CAR-NO-1-WAR-IND = VHCM014_DATA.WAR-IND[1];
            VHCM01IW-PASS-RIGH.CAR-NO-1-VEH-STAT = VHCM014_DATA.VEH-STAT[1];
