                VHCT01IW-SVR-REC.CAR-NO-2-PRV-HRS = VHCT015_DATA.CUM-HRS-PREV-SRV[COUNT-H];
                VHCT01IW-SVR-REC.CAR-NO-2-PRV-MIN = VHCT015_DATA.CUM-MIN-PREV-SRV[COUNT-H];
                VHCT01IW-SVR-REC.CAR-NO-2-CUR-HRS = VHCT015_DATA.CURR-CAR-HRS-SRV[COUNT-H];
                VHCT01IW-SVR-REC.CAR-NO-2-CUR-MIN = VHCT015_DATA.CURR-CAR-MIN-SRV[COUNT-H];
