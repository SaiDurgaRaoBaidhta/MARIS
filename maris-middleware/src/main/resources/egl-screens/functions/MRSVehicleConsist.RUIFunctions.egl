        VHCM01IW-PASSVALUE.DATE-END-CAR-REV = VHCM01IW-PASSVALUE.DATE-END-CAR-REV-9;
        VHCM01IW-PASSVALUE.TIME-END-CAR = VHCM01IW-PASSVALUE.TIME-END-CAR-9;
        VHCM01IS-C-CAR();
        VHCM01IW-PASSVALUE.CAR-NO-9-END-HRS = VHCM01IW-PASSVALUE.END-CAR-HRS;
        VHCM01IW-PASSVALUE.CAR-NO-9-END-MIN = VHCM01IW-PASSVALUE.END-CAR-MIN;
        VHCM01IW-PASSVALUE.CAR-NO-9-MID-HRS = VHCM01IW-PASSVALUE.MID-CAR-HRS;
        VHCM01IW-PASSVALUE.CAR-NO-9-MID-MIN = VHCM01IW-PASSVALUE.MID-CAR-MIN;
        VHCM01IW-PASSVALUE.BRK-IN-HRS = VHCM01IW-PASSVALUE.CAR-NO-9-BRK-HRS;
        VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX = VHCM01IW-PASSVALUE.CAR-NO-9-MAX-BRK;
        VHCM01IS-BRK-HRS();
        VHCM01IW-PASSVALUE.CAR-NO-9-BRK-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS;
        
  
    else
        if (VHCM01IW-PASSVALUE.CAR-NO-9-WAR-IND == "Y")
            VHCM01IW-PASSVALUE.BRK-IN-HRS = VHCM01IW-PASSVALUE.CAR-NO-9-BRK-HRS;
            VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX = VHCM01IW-PASSVALUE.CAR-NO-9-MAX-BRK;
            VHCM01IS-BRK-HRS();
            VHCM01IW-PASSVALUE.CAR-NO-9-BRK-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS;
            
  
        end
    end
    VHCM01IW-PASSVALUE.CUM-HRS = VHCM01IW-PASSVALUE.CAR-NO-9-CUM-HRS;
    VHCM01IW-PASSVALUE.CUM-MIN = VHCM01IW-PASSVALUE.CAR-NO-9-CUM-MIN;
    VHCM01IW-SVR-REC.CAR-NO-9-PRV-HRS = VHCM01IW-PASSVALUE.CAR-NO-9-CUM-HRS;
    VHCM01IW-SVR-REC.CAR-NO-9-PRV-MIN = VHCM01IW-PASSVALUE.CAR-NO-9-CUM-MIN;
    VHCM01IS-ACCU-TIME();
    VHCM01IW-PASSVALUE.CAR-NO-9-CUM-HRS = VHCM01IW-PASSVALUE.CUM-HRS;
    VHCM01IW-PASSVALUE.CAR-NO-9-CUM-MIN = VHCM01IW-PASSVALUE.CUM-MIN;
    VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM = VHCM01IW-PASSVALUE.CAR-NO-9-NEXT-PM;
    VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM = VHCM01IW-PASSVALUE.CAR-NO-9-FROM-PM;
    VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM-MAX = VHCM01IW-PASSVALUE.CAR-NO-9-MAX-PM;
    VHCM01IS-PM-HRS();
    VHCM01IW-PASSVALUE.CAR-NO-9-NEXT-PM = VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM;
    VHCM01IW-PASSVALUE.CAR-NO-9-FROM-PM = VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM;
    VHCM01IW-PASSVALUE.VEH-STAT = VHCM01IW-PASSVALUE.CAR-NO-9-VEH-STAT;
    VHCM01IW-PASSVALUE.VEH-STAT-PREV = VHCM01IW-PASSVALUE.CAR-NO-9-VEH-STAT-PREV;
    VHCM01IW-PASSVALUE.CAR-NO-INCD = VHCM01IW-PASSVALUE.CAR-NO-9;
    VHCM01IW-PASSVALUE.HOME-YRD = VHCM01IW-PASSVALUE.CAR-NO-9-HOME-YRD;
    VHCM01IW-PASSVALUE.CAR-NO = VHCM01IW-PASSVALUE.CAR-NO-9;
    VHCM01IW-PASSVALUE.NO-GO-IND = "N";
    VHCM01IS-STATUS();
  
    if (VHCM01IW-PASSVALUE.PSEUDO-CAR-9-SW == "Y")
        if (VHCM01IW-PASSVALUE.VEH-STAT != "GO" &&
         VHCM01IW-PASSVALUE.VEH-STAT != "USABLE" &&
         VHCM01IW-PASSVALUE.VEH-STAT != "ERROR")
            VHCM01IW-STATUS.CAR-STATUS-9 = VHCM01IW-PASSVALUE.VEH-STAT;
            VHCM01IW-TRIGGER.CAR10-NO-GO = "Y";
            VHCM01IW-TRIGGER.CAR-ERROR = "Y";
            VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 9 PSEUDO VEH-STAT ERROR";
        end
    end
    VHCM01IW-PASSVALUE.CAR-NO-9-NO-GO = VHCM01IW-PASSVALUE.NO-GO-IND;
    if (VHCM01IW-PASSVALUE.STAT-CHG-SW == "Y")
        VHCM01IW-PASSVALUE.CAR-NO-9-STAT-CHG = "Y";
    else
        VHCM01IW-PASSVALUE.CAR-NO-9-STAT-CHG = "N";
    end
    VHCM01IW-PASSVALUE.CAR-NO-9-VEH-STAT = VHCM01IW-PASSVALUE.VEH-STAT;
    VHCM01IW-PASSVALUE.CAR-NO-9-VEH-STAT-PREV = VHCM01IW-PASSVALUE.VEH-STAT-PREV;
  
  
  
  
  
  
  
    if (VHCM01IW-PASSVALUE.CAR-TYPE-9 == "C1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-9 == "C2" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-9 == "D1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-9 == "L1")
        VHCM01IW-SVR-REC.END-CAR-HRS-HIST = VHCM01IW-SVR-REC.CAR-NO-9-END-HRS-SVC;
        VHCM01IW-SVR-REC.END-CAR-MIN-HIST = VHCM01IW-SVR-REC.CAR-NO-9-END-MIN-SVC;
        VHCM01IW-SVR-REC.MID-CAR-HRS-HIST = VHCM01IW-SVR-REC.CAR-NO-9-MID-HRS-SVC;
        VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.CAR-NO-9-MID-MIN-SVC;
        
  
  
        VHCM01IS-SVC-HIST();
        VHCM01IW-SVR-REC.CAR-NO-9-END-HRS-SVC = VHCM01IW-SVR-REC.END-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-9-END-MIN-SVC = VHCM01IW-SVR-REC.END-CAR-MIN-HIST;
        VHCM01IW-SVR-REC.CAR-NO-9-MID-HRS-SVC = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-9-MID-MIN-SVC = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST;
        
  
  
    end
    VHCM01IW-SVR-REC.CURR-CAR-HRS = VHCM01IW-SVR-REC.CAR-NO-9-CUR-HRS;
    VHCM01IW-SVR-REC.CURR-CAR-MIN = VHCM01IW-SVR-REC.CAR-NO-9-CUR-MIN;
    VHCM01IS-SVC-HIT1();
    VHCM01IW-SVR-REC.CAR-NO-9-CUR-HRS = VHCM01IW-SVR-REC.CURR-CAR-HRS;
    VHCM01IW-SVR-REC.CAR-NO-9-CUR-MIN = VHCM01IW-SVR-REC.CURR-CAR-MIN;

  
    VHCM01IW-PASSVALUE.CAR-NOT-EXIST = "N";
    VHCM015_CRIT.ORIENTATION-9 = " ";
    if (VHCM01IW-PASSVALUE.END-CAR-SW == "Y")
        if ((VHCM01IW-1.CAR-TYPE[9] == "C1" ||
         VHCM01IW-1.CAR-TYPE[9] == "C2" ||
         VHCM01IW-1.CAR-TYPE[9] == "D1" ||
         VHCM01IW-1.CAR-TYPE[9] == "L1") &&
         (VHCM01IW-1.ATO-PRESENT-IND[9] != "Y"))
            VHCM01IW-TRIGGER.TYPE-ERROR-CAR9 = "Y";
            VHCM01IW-TRIGGER.CAR-ERROR = "Y";
            VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 9 ATO PRESENT IND NOT = Y";
        else
            if (VHCM01IW-1.TRAIN-INCD-IND[9] == "Y")
                VHCM01IW-TRIGGER.CAR9-NO-GO-TI = "Y";
                VHCM01IW-TRIGGER.CAR-ERROR = "Y";
                VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 9 HAS TRAIN INCIDENT";
                if (VHCM01IW-1.CAR-STAT == "NO GO")
                    VHCM01IW-STATUS.CAR-STATUS-9 = "NO TI";
                else
                    VHCM01IW-STATUS.CAR-STATUS-9 = "GO TI";
                end
            else
                VHCM01IW-TRIGGER.CAR9-LOC-HI = "Y";
                VHCM01IW-TRIGGER.CAR9-LOC-HI = "Y";
            end
        end
    end
end 

Function VHCM01IS-CAR-MSG () 
    if (VHCM01IW-TRIGGER.CAR-ERROR == "Y")
  
        VHCM01IW-CON-MSG.CON-MSG-1 = VHCM01IW-CON-MSG.CON-MSG-6;
    end
end 

Function VHCM01IS-CHK-CAR ()
  
   
    VHCM013_CRIT.WS-DATE-REV = VHCM01IW-PASSVALUE.DATE-REV;
    VHCM013_CRIT.CON-NO = VHCM01IW.COMBINE-TRAIN;
    try
        call "VHCM013"(XDCONTROL, VHCM013_CRIT, VHCM013_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCM01IW-PASS-LEFT.CAR-COUNT = XDCONTROL.UROWCNT;
        VHCM01IW-PASSVALUE.LEFT-COUNT = XDCONTROL.UROWCNT;
        VHCM01IW-SVR-REC-L.HIST-COUNT = VHCM013_CRIT.HIST-COUNT;
        VHCM01IS-MOVE-CAR();
        VHCM01IS-MOV-CARH();
  
    else
        VHCM01IW-TRIGGER.CON-ERROR = "Y";
    end
end 

Function VHCM01IS-CHK-CAR1 ()
  
   
    VHCM013_CRIT.WS-DATE-REV = VHCM01IW-PASSVALUE.DATE-REV;
    VHCM013_CRIT.CON-NO = VHCM01IW.TRAIN;
    try
        call "VHCM013"(XDCONTROL, VHCM013_CRIT, VHCM013_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCM01IW-PASS-RIGH.CAR-COUNT = XDCONTROL.UROWCNT;
        VHCM01IW-PASSVALUE.RIGHT-COUNT = XDCONTROL.UROWCNT;
        VHCM01IW-SVR-REC-R.HIST-COUNT = VHCM013_CRIT.HIST-COUNT;
        VHCM01IS-MOVE-CAR1();
        VHCM01IS-MOV-CAR1H();
  
    else
        VHCM01IW-TRIGGER.CON-ERROR = "Y";
    end
end 

Function VHCM01IS-CHK-STAT () 

end 

Function VHCM01IS-CK-CONG ()
   
    VHCM01IW.LEFT-CONG = " ";
    VHCM011_CRIT.CON-NO = VHCM01IW.COMBINE-TRAIN;
    VHCM011_CRIT.DATE-INSRV-REV = VHCM01IW-PASSVALUE.DATE-REV;
    try
        call "VHCM011"(XDCONTROL, VHCM011_CRIT, VHCM011_DATA);
    
    end
    if (VHCM011_DATA.CON-STAT == "SRV" ||
     VHCM011_DATA.CON-STAT == "CAR")
        VHCM01IW.LEFT-CONG = "Y";
    else
        VHCM01IW.LEFT-CONG = "N";
    end

  
    VHCM01IW.RIGH-CONG = " ";
    if (VHCM01IW-PASS-RIGH.PSEUDO-CAR-SW != "Y")
        VHCM011_CRIT.CON-NO = VHCM01IW.TRAIN;
        VHCM011_CRIT.DATE-INSRV-REV = VHCM01IW-PASSVALUE.DATE-REV;
        try
            call "VHCM011"(XDCONTROL, VHCM011_CRIT, VHCM011_DATA);
        
        end
        if (VHCM011_DATA.CON-STAT == "SRV" ||
         VHCM011_DATA.CON-STAT == "CAR")
            VHCM01IW.RIGH-CONG = "Y";
        else
            VHCM01IW.RIGH-CONG = "N";
        end
    else
        VHCM016_CRIT.CON-NO = VHCM01IW.TRAIN;
        try
            call "VHCM016"(XDCONTROL, VHCM016_CRIT);
        
        end
        if (VHCM016_CRIT.DISTINCT-CON-NO == VHCM01IW.TRAIN)
            VHCM01IW.RIGH-CONG = "Y";
        else
            VHCM01IW.RIGH-CONG = "N";
        end
    end
end 

Function VHCM01IS-CK-OSRV () 
    VHCM01IW-PASSVALUE.TIME-INSRV-X = VHCM01IW-PASS-LEFT.TIME-INSRV-X;
    VHCM01IW-TRIGGER.TIME-OUT-ERR-LEFT = " ";
    VHCM01IW-TRIGGER.TIME-OUT-ERR-RIGH = " ";
    VHCM01IS-OSRV-TIMX();
    VHCM01IW-TRIGGER.TIME-OUT-ERR-LEFT = VHCM01IW-TRIGGER.TIME-OUT-ERR;
    if (VHCM01IW-TRIGGER.TIME-OUT-ERR-LEFT == "Y")
        VHCM01IW-TIME-MSG.MSG-4-1 = VHCM01IW.COMBINE-TRAIN;
        VHCM01IW-TIME-MSG.MSG-4-2 = " - TIME SHOULD BE >= IN SERVICE TIME";
        VHCM01IW-TIME-MSG.MSG-1 = VHCM01IW-TIME-MSG.MSG-4;
    end
    if (VHCM01IW-PASS-RIGH.PSEUDO-CAR-SW != "Y")
        VHCM01IW-PASSVALUE.TIME-INSRV-X = VHCM01IW-PASS-RIGH.TIME-INSRV-X;
        VHCM01IS-OSRV-TIMX();
        VHCM01IW-TRIGGER.TIME-OUT-ERR-RIGH = VHCM01IW-TRIGGER.TIME-OUT-ERR;
        if (VHCM01IW-TRIGGER.TIME-OUT-ERR-RIGH == "Y")
            VHCM01IW-TIME-MSG.MSG-4-1 = VHCM01IW.TRAIN;
            VHCM01IW-TIME-MSG.MSG-4-2 = " - TIME SHOULD BE >= IN SERVICE TIME";
            VHCM01IW-TIME-MSG.MSG-1 = VHCM01IW-TIME-MSG.MSG-4;
        end
    end
end 

Function VHCM01IS-CKCO-IND ()

  
  
  
  
   
    VHCM012_CRIT.CON-NO = VHCM01IW.COMBINE-TRAIN;
    VHCM012_CRIT.DASH-NO = VHCM011_DATA.DASH-NO;
    VHCM012_CRIT.DATE-INSRV-REV = VHCM011_DATA.DATE-INSRV-REV;
    VHCM012_CRIT.DATE-INSRV = VHCM011_DATA.DATE-INSRV;
    VHCM012_CRIT.TIME-INSRV = VHCM011_DATA.TIME-INSRV;
    try
        call "VHCM012"(XDCONTROL, VHCM012_CRIT, VHCM012_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if (XDCONTROL.UROWCNT == 0)
  
            VHCM01IS-CHK-CAR();
        else
            VHCM01IW-TRIGGER.CON-INCD = "Y";
        end
    end
end 

Function VHCM01IS-CKCO-IND1 ()

  
  
  
  
   
    VHCM012_CRIT.CON-NO = VHCM01IW.TRAIN;
    VHCM012_CRIT.DASH-NO = VHCM011_DATA.DASH-NO;
    VHCM012_CRIT.DATE-INSRV-REV = VHCM011_DATA.DATE-INSRV-REV;
    VHCM012_CRIT.DATE-INSRV = VHCM011_DATA.DATE-INSRV;
    VHCM012_CRIT.TIME-INSRV = VHCM011_DATA.TIME-INSRV;
    try
        call "VHCM012"(XDCONTROL, VHCM012_CRIT, VHCM012_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if (XDCONTROL.UROWCNT == 0)
  
            VHCM01IS-CHK-CAR1();
        else
            VHCM01IW-TRIGGER.TRAIN-INCD = "Y";
        end
    end
end 

