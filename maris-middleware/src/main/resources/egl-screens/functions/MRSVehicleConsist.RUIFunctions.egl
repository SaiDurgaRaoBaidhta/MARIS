                        end
                    end
                    
  
  
  
   
  
                else
                    if (IND == 6)
                        VHTR01IW-CON-LIST.CAR-NO-6 = VHTR011_DATA.CAR-NO[IND];
                        VHTR01IW-CON-LIST.CAR-ORDER6 = 6;
                        VHTR01IW-CON-LIST.CAR-ORIENT6 = VHTR011_DATA.VAGen_ORIENTATION[IND];
