Function VHMT01IS-ADD-CON () 
    XXDATEW.DATE-MM-DD-YYYY = VHMT01IW.DATE-INSRV;
    XXDATEW.VAGen_FUNCTION = "YMD";
    MRSCommonCode.XXDATES-CONVERT();
    VHMT01IW-PASSVALUE.DATE-INSRV-REV = XXDATEW.DATE-YYYY-MM-DD;
    VHMT012_CRIT.DATE-INSRV-REV = VHMT01IW-PASSVALUE.DATE-INSRV-REV;
  
  
  
  
  
    VHMT01IW.DASH-NO = VHMT011_DATA.MAX-DASH-NO + 1;
