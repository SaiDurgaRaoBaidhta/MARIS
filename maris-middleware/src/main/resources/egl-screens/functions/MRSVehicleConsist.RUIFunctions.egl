            else
                if (VHSC01W-NEW-RIGHT.CAR-ORIENT5 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                    VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-5 = VHSC01W-NEW-RIGHT.CAR-ORIENT5;
                end
            end
            IND = IND + 1;
            RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        end
        if (IND <= 10)
            VHSC01W-NEW-RIGHT.CAR-NO-6 = VHXCONB_DATA2.CAR-NO[IND];
            VHSC01W-NEW-RIGHT.CAR-ORDER6 = 6;
            VHSC01W-NEW-RIGHT.CAR-ORIENT6 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
            VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-6 = " ";
            VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-6 = " ";
            if (VHSC01W-NEW-RIGHT.CAR-ORIENT6 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-6 = VHSC01W-NEW-RIGHT.CAR-ORIENT6;
            else
                if (VHSC01W-NEW-RIGHT.CAR-ORIENT6 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                    VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-6 = VHSC01W-NEW-RIGHT.CAR-ORIENT6;
                end
            end
            IND = IND + 1;
            RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        end
        if (IND <= 10)
            VHSC01W-NEW-RIGHT.CAR-NO-7 = VHXCONB_DATA2.CAR-NO[IND];
            VHSC01W-NEW-RIGHT.CAR-ORDER7 = 7;
            VHSC01W-NEW-RIGHT.CAR-ORIENT7 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
            VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-7 = " ";
            VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-7 = " ";
            if (VHSC01W-NEW-RIGHT.CAR-ORIENT7 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-7 = VHSC01W-NEW-RIGHT.CAR-ORIENT7;
            else
                if (VHSC01W-NEW-RIGHT.CAR-ORIENT7 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                    VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-7 = VHSC01W-NEW-RIGHT.CAR-ORIENT7;
                end
            end
            IND = IND + 1;
            RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        end
        if (IND <= 10)
            VHSC01W-NEW-RIGHT.CAR-NO-8 = VHXCONB_DATA2.CAR-NO[IND];
            VHSC01W-NEW-RIGHT.CAR-ORDER8 = 8;
            VHSC01W-NEW-RIGHT.CAR-ORIENT8 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
            VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-8 = " ";
            VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-8 = " ";
            if (VHSC01W-NEW-RIGHT.CAR-ORIENT8 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-8 = VHSC01W-NEW-RIGHT.CAR-ORIENT8;
            else
                if (VHSC01W-NEW-RIGHT.CAR-ORIENT8 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                    VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-8 = VHSC01W-NEW-RIGHT.CAR-ORIENT8;
                end
            end
        end

    
        if (VHSC01W-MSG.CAR-POS == 9)
            VHSC01IW-CON-LIST.CAR-NO9 = "    ";
            VHSC01IW-CON-LIST.CAR-NO10 = "    ";
        else
            if (VHSC01W-MSG.CAR-POS == 8)
                VHSC01IW-CON-LIST.CAR-NO8 = "    ";
                VHSC01IW-CON-LIST.CAR-NO9 = "    ";
                VHSC01IW-CON-LIST.CAR-NO10 = "    ";
                DISABLE-SPLITBUTTON9 = "Y";
            else
                if (VHSC01W-MSG.CAR-POS == 7)
                    VHSC01IW-CON-LIST.CAR-NO7 = "    ";
                    VHSC01IW-CON-LIST.CAR-NO8 = "    ";
                    VHSC01IW-CON-LIST.CAR-NO9 = "    ";
                    VHSC01IW-CON-LIST.CAR-NO10 = "    ";
                    DISABLE-SPLITBUTTON8 = "Y";
                    DISABLE-SPLITBUTTON9 = "Y";
                else
                    if (VHSC01W-MSG.CAR-POS == 6)
                        VHSC01IW-CON-LIST.CAR-NO6 = "    ";
                        VHSC01IW-CON-LIST.CAR-NO7 = "    ";
                        VHSC01IW-CON-LIST.CAR-NO8 = "    ";
                        VHSC01IW-CON-LIST.CAR-NO9 = "    ";
                        VHSC01IW-CON-LIST.CAR-NO10 = "    ";
