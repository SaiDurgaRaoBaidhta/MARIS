Function VHTR01IS-CHK-CAR ()
  
   
    VHLT015_CRIT.WS-DATE-REV = VHTR01IW-PASSVALUE.DATE-REV;
    VHLT015_CRIT.CON-NO = VHTR01IW.CON-NO;
    try
        call "VHLT015"(XDCONTROL, VHLT015_CRIT, VHLT015_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHTR01IW-PASSVALUE.CAR-COUNT = XDCONTROL.UROWCNT;
        VHTR01IW-SVR-REC.HIST-COUNT = VHLT015_CRIT.HIST-COUNT;
        VHTR01IS-MOVE-CARX();
        VHTR01IS-MOV-CARH();
        VHTR01IS-CHK-INCD();
    else
        VHTR01IW-TRIGGER.CON-ERROR = "Y";
    end
end 

Function VHTR01IS-CHK-DVS () 
    if (VHTR01IW-PASSVALUE.VEH-STAT-PREV == "GO" ||
     VHTR01IW-PASSVALUE.VEH-STAT-PREV == "USABLE")
        VHLT019_CRIT.CAR-NO = VHTR01IW-PASSVALUE.CAR-NO;
        try
            call "VHLT019"(XDCONTROL, VHLT019_CRIT, VHLT019_DATA);
        
        end
        if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
         (XDCONTROL.UROWCNT > 0 || VHLT019_DATA.INCD-COUNT-X > 0))
            VHTR01IS-UPD-DVS();
        end
    end
end 

Function VHTR01IS-CHK-INCD ()
   
    VHLT013_CRIT.CON-NO = VHTR01IW.CON-NO;
    VHLT013_CRIT.DASH-NO = VHTR011_DATA.DASH-NO[1];
    VHLT013_CRIT.DATE-INSRV-REV = VHTR011_DATA.DATE-INSRV-REV[1];
    VHLT013_CRIT.DATE-INSRV = VHTR011_DATA.DATE-INSRV[1];
    VHLT013_CRIT.TIME-INSRV = VHTR011_DATA.TIME-INSRV[1];
    try
        call "VHLT013"(XDCONTROL, VHLT013_CRIT, VHLT013_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHTR01IW-PASSVALUE.CAR-INCD-COUNT = XDCONTROL.UROWCNT;
        if (XDCONTROL.UROWCNT == 0)
  
            VHTR01IS-OTIME();
  
  
        else
  
            VHTR01IW-TRIGGER.OPEN-CAR-INCD = "Y";
        end
    end
end 

Function VHTR01IS-CKCO-IND ()

   
    VHTR01IW-TRIGGER.TIME-OUT-ERR = " ";
    VHTR01IS-OSRV-TIME();
    if (VHTR01IW-TRIGGER.TIME-OUT-ERR == " ")
  
        VHLT014_CRIT.CON-NO = VHTR01IW.CON-NO;
        VHLT014_CRIT.DASH-NO = VHTR011_DATA.DASH-NO[1];
        VHLT014_CRIT.DATE-INSRV-REV = VHTR011_DATA.DATE-INSRV-REV[1];
        VHLT014_CRIT.DATE-INSRV = VHTR011_DATA.DATE-INSRV[1];
        VHLT014_CRIT.TIME-INSRV = VHTR011_DATA.TIME-INSRV[1];
        try
            call "VHLT014"(XDCONTROL, VHLT014_CRIT, VHLT014_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (XDCONTROL.UROWCNT == 0)
  
                VHTR01IS-CHK-CAR();
            else
                VHTR01IW-TRIGGER.CON-INCD = "Y";
            end
        end
    end
end 

