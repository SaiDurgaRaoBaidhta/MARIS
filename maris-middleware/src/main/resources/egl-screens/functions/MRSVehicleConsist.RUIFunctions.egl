Function VHCM01IS-CLEAR () 
    VHCM01IW-CON-MSG.CON-MSG-1 = " ";
    set VHCM01IW empty;
    set VH001IW-MESSAGE empty;
    VHCM01IW.TIME-OUTSRV = " ";
  
    VHCM01IW.TIME-FILLER-2 = " ";
    VHCM01IW.TIME-OUTSRV-SS = " ";
    set VHCM01IW-MESSAGE empty;
    set VHCM01IW-CON-MSG empty;
    set VHCM01IW-PASSVALUE empty;
    set VHCM01IW-PASS-LEFT empty;
    set VHCM01IW-PASS-RIGH empty;
    set VHCM01IW-STATUS empty;
    set VHCM01IW-CON empty;
    set VHCM01IW-1 empty;
    set VHCM01IW-CAR empty;
    set VHCM01IW-STATUS empty;
    set VHCM01IW-TIME-MSG empty;
    set VHCM01IW-SVR-REC empty;
    set VHCM01IW-SVR-REC-L empty;
    set VHCM01IW-SVR-REC-R empty;
    VHCM01IW-TRIGGER.DISABLE-COMBINE = "Y";
    set VHCM015_CRIT empty;
    set VHCM015_CRIT-VEH empty;
    set VHCM015_CRIT-VEH-L empty;
    set VHCM015_CRIT-VEH-R empty;
    set VHCM015_CRIT-CONHL empty;
    set VHCM015_CRIT-CONHR empty;
    set VHCM015_CRIT-SVR-L empty;
    set VHCM015_CRIT-SVR-R empty;
    set VHCM01IW-STATUS empty;
    VHCM01IS-DATE();
    VHCM01IS-YARD();
end 

