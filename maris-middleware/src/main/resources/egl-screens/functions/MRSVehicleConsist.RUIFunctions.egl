Function VHCM01IS-BRK-HRS () 
    VHCM01IW-PASSVALUE.CURR-SVC-HRS = 0;
    if (VHCM01IW-PASSVALUE.BRK-IN-HRS >=
     VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX)
        VHCM01IW-PASSVALUE.CURR-SVC-HRS = VHCM01IW-PASSVALUE.DIFF-HH;
        if (VHCM01IW-PASSVALUE.DIFF-MM > 29)
            VHCM01IW-PASSVALUE.CURR-SVC-HRS = VHCM01IW-PASSVALUE.CURR-SVC-HRS + 1;
        end
        VHCM01IW-PASSVALUE.CURR-SVC-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS - VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX;
    else
        if (VHCM01IW-PASSVALUE.BRK-IN-HRS <
         VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX)
            if (VHCM01IW-PASSVALUE.CAR-LR == "L")
                VHCM01IW-PASSVALUE.BRK-IN-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS + VHCM01IW-PASS-LEFT.DIFF-HH;
            else
                VHCM01IW-PASSVALUE.BRK-IN-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS + VHCM01IW-PASS-RIGH.DIFF-HH;
            end
            if (VHCM01IW-PASSVALUE.DIFF-MM > 29)
                VHCM01IW-PASSVALUE.BRK-IN-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS + 1;
            end
            if (VHCM01IW-PASSVALUE.BRK-IN-HRS >
             VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX)
                VHCM01IW-PASSVALUE.CURR-SVC-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS - VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX;
            end
        end
    end
end 

Function VHCM01IS-C-CAR ()
   
    VHCM01IW-TRIGGER.YES-SPLIT = "N";
    VHCM01IW-PASSVALUE.WS-DATE-END-CAR-REV-YY = VHCM01IW-PASSVALUE.DATE-END-CAR-REV-YY;
    VHCM01IW-PASSVALUE.WS-DATE-END-CAR-REV-MM = VHCM01IW-PASSVALUE.DATE-END-CAR-REV-MM;
    VHCM01IW-PASSVALUE.WS-DATE-END-CAR-REV-DD = VHCM01IW-PASSVALUE.DATE-END-CAR-REV-DD;
  
    if (VHCM01IW-PASSVALUE.WS-DATE-END-CAR-REV is numeric)
        VHCM01IW-TRIGGER.YES-SPLIT = "Y";
        VHCM01IS-SPLIT();
    else
        VHCM01IW-PASSVALUE.DATE-END-CAR-REV-X = VHCM01IW-PASSVALUE.DATE-END-CAR-REV;
        VHCM01IW-PASSVALUE.WS-DATE-END-CAR-REV-YY = VHCM01IW-PASSVALUE.DATE-END-CAR-REV-YY-X;
        VHCM01IW-PASSVALUE.WS-DATE-END-CAR-REV-MM = VHCM01IW-PASSVALUE.DATE-END-CAR-REV-MM-X;
        VHCM01IW-PASSVALUE.WS-DATE-END-CAR-REV-DD = VHCM01IW-PASSVALUE.DATE-END-CAR-REV-DD-X;
  
        if (VHCM01IW-PASSVALUE.WS-DATE-END-CAR-REV is numeric)
            VHCM01IS-SPLIT();
            VHCM01IW-TRIGGER.YES-SPLIT = "Y";
        else
            if (VHCM01IW-PASSVALUE.END-CAR-SW == "Y")
                if (VHCM01IW-PASSVALUE.CAR-LR == "L")
                    VHCM01IW-PASSVALUE.END-CAR-HRS = VHCM01IW-PASSVALUE.END-CAR-HRS + VHCM01IW-PASS-LEFT.DIFF-HH;
                    VHCM01IW-PASSVALUE.END-CAR-MIN = VHCM01IW-PASSVALUE.END-CAR-MIN + VHCM01IW-PASS-LEFT.DIFF-MM;
                else
                    VHCM01IW-PASSVALUE.END-CAR-HRS = VHCM01IW-PASSVALUE.END-CAR-HRS + VHCM01IW-PASS-RIGH.DIFF-HH;
                    VHCM01IW-PASSVALUE.END-CAR-MIN = VHCM01IW-PASSVALUE.END-CAR-MIN + VHCM01IW-PASS-RIGH.DIFF-MM;
                end
                if (VHCM01IW-PASSVALUE.END-CAR-MIN > 59)
                    VHCM01IW-PASSVALUE.END-CAR-HRS = VHCM01IW-PASSVALUE.END-CAR-HRS + 1;
                    VHCM01IW-PASSVALUE.END-CAR-MIN = VHCM01IW-PASSVALUE.END-CAR-MIN - 60;
                end
            end
            if (VHCM01IW-PASSVALUE.MID-CAR-SW == "Y")
                if (VHCM01IW-PASSVALUE.CAR-LR == "L")
                    VHCM01IW-PASSVALUE.MID-CAR-HRS = VHCM01IW-PASSVALUE.MID-CAR-HRS + VHCM01IW-PASS-LEFT.DIFF-HH;
                    VHCM01IW-PASSVALUE.MID-CAR-MIN = VHCM01IW-PASSVALUE.MID-CAR-MIN + VHCM01IW-PASS-LEFT.DIFF-MM;
                else
                    VHCM01IW-PASSVALUE.MID-CAR-HRS = VHCM01IW-PASSVALUE.MID-CAR-HRS + VHCM01IW-PASS-RIGH.DIFF-HH;
                    VHCM01IW-PASSVALUE.MID-CAR-MIN = VHCM01IW-PASSVALUE.MID-CAR-MIN + VHCM01IW-PASS-RIGH.DIFF-MM;
                end
                if (VHCM01IW-PASSVALUE.MID-CAR-MIN > 59)
                    VHCM01IW-PASSVALUE.MID-CAR-HRS = VHCM01IW-PASSVALUE.MID-CAR-HRS + 1;
                    VHCM01IW-PASSVALUE.MID-CAR-MIN = VHCM01IW-PASSVALUE.MID-CAR-MIN - 60;
                end
            end
        end
    end
end 

Function VHCM01IS-CAL1 () 
    VHCM01IW-PASSVALUE.END-CAR-HRS = 0;
    VHCM01IW-PASSVALUE.END-CAR-MIN = 0;
    VHCM01IW-PASSVALUE.CAR-LR = VHCM01IW-PASSVALUE.CAR-LR-X[1];
    VHCM01IW-PASSVALUE.END-CAR-SW = "Y";
    VHCM01IW-PASSVALUE.MID-CAR-SW = "N";
    if (VHCM01IW-PASSVALUE.CAR-TYPE-1 == "C1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-1 == "C2" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-1 == "D1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-1 == "L1")
        VHCM01IW-PASSVALUE.END-CAR-HRS = VHCM01IW-PASSVALUE.CAR-NO-1-END-HRS;
        VHCM01IW-PASSVALUE.END-CAR-MIN = VHCM01IW-PASSVALUE.CAR-NO-1-END-MIN;
        VHCM01IW-PASSVALUE.MID-CAR-HRS = VHCM01IW-PASSVALUE.CAR-NO-1-MID-HRS;
        VHCM01IW-PASSVALUE.MID-CAR-MIN = VHCM01IW-PASSVALUE.CAR-NO-1-MID-MIN;
        VHCM01IW-PASSVALUE.DATE-END-CAR-REV = VHCM01IW-PASSVALUE.DATE-END-CAR-REV-1;
        VHCM01IW-PASSVALUE.TIME-END-CAR = VHCM01IW-PASSVALUE.TIME-END-CAR-1;
        VHCM01IS-C-CAR();
        VHCM01IW-PASSVALUE.CAR-NO-1-END-HRS = VHCM01IW-PASSVALUE.END-CAR-HRS;
        VHCM01IW-PASSVALUE.CAR-NO-1-END-MIN = VHCM01IW-PASSVALUE.END-CAR-MIN;
        VHCM01IW-PASSVALUE.CAR-NO-1-MID-HRS = VHCM01IW-PASSVALUE.MID-CAR-HRS;
        VHCM01IW-PASSVALUE.CAR-NO-1-MID-MIN = VHCM01IW-PASSVALUE.MID-CAR-MIN;
        VHCM01IW-PASSVALUE.BRK-IN-HRS = VHCM01IW-PASSVALUE.CAR-NO-1-BRK-HRS;
        VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX = VHCM01IW-PASSVALUE.CAR-NO-1-MAX-BRK;
        VHCM01IS-BRK-HRS();
        VHCM01IW-PASSVALUE.CAR-NO-1-BRK-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS;
        
  
    else
        if (VHCM01IW-PASSVALUE.CAR-NO-1-WAR-IND == "Y")
            VHCM01IW-PASSVALUE.BRK-IN-HRS = VHCM01IW-PASSVALUE.CAR-NO-1-BRK-HRS;
            VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX = VHCM01IW-PASSVALUE.CAR-NO-1-MAX-BRK;
            VHCM01IS-BRK-HRS();
            VHCM01IW-PASSVALUE.CAR-NO-1-BRK-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS;
            
  
        end
    end
    VHCM01IW-PASSVALUE.CUM-HRS = VHCM01IW-PASSVALUE.CAR-NO-1-CUM-HRS;
    VHCM01IW-PASSVALUE.CUM-MIN = VHCM01IW-PASSVALUE.CAR-NO-1-CUM-MIN;
    VHCM01IW-SVR-REC.CAR-NO-1-PRV-HRS = VHCM01IW-PASSVALUE.CAR-NO-1-CUM-HRS;
    VHCM01IW-SVR-REC.CAR-NO-1-PRV-MIN = VHCM01IW-PASSVALUE.CAR-NO-1-CUM-MIN;
    VHCM01IS-ACCU-TIME();
    VHCM01IW-PASSVALUE.CAR-NO-1-CUM-HRS = VHCM01IW-PASSVALUE.CUM-HRS;
    VHCM01IW-PASSVALUE.CAR-NO-1-CUM-MIN = VHCM01IW-PASSVALUE.CUM-MIN;
    VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM = VHCM01IW-PASSVALUE.CAR-NO-1-NEXT-PM;
    VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM = VHCM01IW-PASSVALUE.CAR-NO-1-FROM-PM;
    VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM-MAX = VHCM01IW-PASSVALUE.CAR-NO-1-MAX-PM;
    VHCM01IS-PM-HRS();
    VHCM01IW-PASSVALUE.CAR-NO-1-NEXT-PM = VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM;
    VHCM01IW-PASSVALUE.CAR-NO-1-FROM-PM = VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM;
    VHCM01IW-PASSVALUE.VEH-STAT = VHCM01IW-PASSVALUE.CAR-NO-1-VEH-STAT;
    VHCM01IW-PASSVALUE.VEH-STAT-PREV = VHCM01IW-PASSVALUE.CAR-NO-1-VEH-STAT-PREV;
    VHCM01IW-PASSVALUE.CAR-NO-INCD = VHCM01IW-PASSVALUE.CAR-NO-1;
    VHCM01IW-PASSVALUE.HOME-YRD = VHCM01IW-PASSVALUE.CAR-NO-1-HOME-YRD;
    VHCM01IW-PASSVALUE.CAR-NO = VHCM01IW-PASSVALUE.CAR-NO-1;
    VHCM01IW-PASSVALUE.NO-GO-IND = "N";
    VHCM01IS-STATUS();
  
    if (VHCM01IW-PASSVALUE.PSEUDO-CAR-1-SW == "Y")
        if (VHCM01IW-PASSVALUE.VEH-STAT != "GO" &&
         VHCM01IW-PASSVALUE.VEH-STAT != "USABLE" &&
         VHCM01IW-PASSVALUE.VEH-STAT != "ERROR")
            VHCM01IW-STATUS.CAR-STATUS-1 = VHCM01IW-PASSVALUE.VEH-STAT;
            VHCM01IW-TRIGGER.CAR10-NO-GO = "Y";
            VHCM01IW-TRIGGER.CAR-ERROR = "Y";
            VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 1 PSEUDO VEH-STAT ERROR";
        end
    end
    VHCM01IW-PASSVALUE.CAR-NO-1-NO-GO = VHCM01IW-PASSVALUE.NO-GO-IND;
    if (VHCM01IW-PASSVALUE.STAT-CHG-SW == "Y")
        VHCM01IW-PASSVALUE.CAR-NO-1-STAT-CHG = "Y";
    else
        VHCM01IW-PASSVALUE.CAR-NO-1-STAT-CHG = "N";
    end
    VHCM01IW-PASSVALUE.CAR-NO-1-VEH-STAT = VHCM01IW-PASSVALUE.VEH-STAT;
    VHCM01IW-PASSVALUE.CAR-NO-1-VEH-STAT-PREV = VHCM01IW-PASSVALUE.VEH-STAT-PREV;
  
  
  
  
  
  
  
    if (VHCM01IW-PASSVALUE.CAR-TYPE-1 == "C1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-1 == "C2" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-1 == "D1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-1 == "L1")
        VHCM01IW-SVR-REC.END-CAR-HRS-HIST = VHCM01IW-SVR-REC.CAR-NO-1-END-HRS-SVC;
        VHCM01IW-SVR-REC.END-CAR-MIN-HIST = VHCM01IW-SVR-REC.CAR-NO-1-END-MIN-SVC;
        VHCM01IW-SVR-REC.MID-CAR-HRS-HIST = VHCM01IW-SVR-REC.CAR-NO-1-MID-HRS-SVC;
        VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.CAR-NO-1-MID-MIN-SVC;
        
  
  
        VHCM01IS-SVC-HIST();
        VHCM01IW-SVR-REC.CAR-NO-1-END-HRS-SVC = VHCM01IW-SVR-REC.END-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-1-END-MIN-SVC = VHCM01IW-SVR-REC.END-CAR-MIN-HIST;
        VHCM01IW-SVR-REC.CAR-NO-1-MID-HRS-SVC = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-1-MID-MIN-SVC = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST;
        
  
  
    end
    VHCM01IW-SVR-REC.CURR-CAR-HRS = VHCM01IW-SVR-REC.CAR-NO-1-CUR-HRS;
    VHCM01IW-SVR-REC.CURR-CAR-MIN = VHCM01IW-SVR-REC.CAR-NO-1-CUR-MIN;
    VHCM01IS-SVC-HIT1();
    VHCM01IW-SVR-REC.CAR-NO-1-CUR-HRS = VHCM01IW-SVR-REC.CURR-CAR-HRS;
    VHCM01IW-SVR-REC.CAR-NO-1-CUR-MIN = VHCM01IW-SVR-REC.CURR-CAR-MIN;

  
    VHCM01IW-PASSVALUE.CAR-NOT-EXIST = "N";
    VHCM015_CRIT.ORIENTATION-1 = " ";

    if ((VHCM01IW-1.CAR-TYPE[1] == "C1" ||
     VHCM01IW-1.CAR-TYPE[1] == "C2"  ||
     VHCM01IW-1.CAR-TYPE[1] == "D1"  ||
     VHCM01IW-1.CAR-TYPE[1] == "L1") &&
     (VHCM01IW-1.ATO-PRESENT-IND[1] != "Y"))
        VHCM01IW-TRIGGER.TYPE-ERROR-CAR1 = "Y";
        VHCM01IW-TRIGGER.CAR-ERROR = "Y";
        VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 1 ATO PRESENT IND NOT = Y";
    else 
        if (VHCM01IW-1.TRAIN-INCD-IND[1] == "Y")
            VHCM01IW-TRIGGER.CAR1-NO-GO-TI = "Y";
            VHCM01IW-TRIGGER.CAR-ERROR = "Y";
            VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 1 HAS TRAIN INCIDENT";
            if (VHCM01IW-1.CAR-STAT == "NO GO")
                VHCM01IW-STATUS.CAR-STATUS-1 = "NO TI";
            else
                VHCM01IW-STATUS.CAR-STATUS-1 = "GO TI";
            end
        else
            VHCM01IW-TRIGGER.CAR1-LOC-HI = "Y";
            VHCM01IW-TRIGGER.CAR1-LOC-HI = "Y";
        end
    end
end 

Function VHCM01IS-CAL10 () 
    VHCM01IW-PASSVALUE.END-CAR-HRS = 0;
