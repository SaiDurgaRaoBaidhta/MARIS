Function VHTS01IS-GET-CONS ()
  
  
  
  
  
  
  
  
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHTS01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHXCONB";
    set VHXCONB_DATA empty;

  
  


    
    try
        call "VHXCONB"(XDCONTROL, VHXCONB_CRIT, VHXCONB_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  
            VHTS01W_DATA.FOUND-CON = "Y";
            VHTS01IS-REV-TRN1();
        else
            VHTS01W_DATA.FOUND-CON = "N";
            
        
        
  
  
  
  
        end 
    end
  
  
  
    if (VHTS01W_DATA.FOUND-CON == "N")
        XXEXT_CALL_Level77Items.UEXTNAM = "VHTS01I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHXCONA";
        set VHXCONA_DATA empty;
        VHXCONA_CRIT.CON-NO = VHXCONB_CRIT.CON-NO;
  


    
        try
            call "VHXCONA"(XDCONTROL, VHXCONA_CRIT, VHXCONA_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  

            else
                VHTS01W_DATA.FOUND-CON = "X";
                
        
        
            end 
        end
    end
end 

Function VHTS01IS-MOVE-CONS ()
   
    VHTS01IS-ORIENT();
    if (VHTS01W_DATA.FOUND-CON == "Y")
        CON-INDEX = CON-INDEX + 1; 
        XIND = 1;
        VHTS01IW-CON-LIST.FROM-CON-NO[CON-INDEX] = VHTS01W_DATA.CON-FROM;
        VHTS01IW-CON-LIST.FROM-DASH[CON-INDEX] = "-";
        VHTS01IW-CON-LIST.FROM-CON-DASH-N[CON-INDEX] = VHXCONB_DATA.DASH-NO[1];
    
        VHTS01IW-CON-LIST.DATE-INSRV-REV[CON-INDEX] = VHXCONB_DATA.DATE-INSRV-REV[1];
        VHTS01IW-CON-LIST.DATE-INSRV[CON-INDEX] = VHXCONB_DATA.DATE-INSRV[1];
        VHTS01IW-CON-LIST.CON-STAT[CON-INDEX] = VHXCONB_DATA.CON-STAT[1];
        VHTS01IW-CON-LIST.TIME-INSRV[CON-INDEX] = VHXCONB_DATA.TIME-INSRV[1];
        VHTS01IW-CON-LIST.TIME-INSRV-ICS[CON-INDEX] = VHXCONB_DATA.TIME-INSRV-ICS[1];
        VHTS01IW-CON-LIST.CON-SIZE[CON-INDEX] = VHXCONB_DATA.CON-SIZE[1];
        VHTS01IW-CON-LIST.ORIGIN-LOC[CON-INDEX] = VHXCONB_DATA.ORIGIN-LOC[1];
        VHTS01IW-CON-LIST.ORIGIN-LOC-SWAP[CON-INDEX] = VHXCONB_DATA.ORIGIN-LOC-SWAP[1];
        VHTS01IW-CON-LIST.OUTSRV-LOC[CON-INDEX] = VHXCONB_DATA.OUTSRV-LOC[1];
        VHTS01IW-CON-LIST.CON-NO-SPLIT[CON-INDEX] = VHXCONB_DATA.CON-NO-SPLIT[1];
        VHTS01IW-CON-LIST.DASH-NO-SPLIT[CON-INDEX] = VHXCONB_DATA.DASH-NO-SPLIT[1];
        VHTS01IW-CON-LIST.RUN-TIME-SPLIT-HRS[CON-INDEX] = VHXCONB_DATA.RUN-TIME-SPLIT-HRS[1];
        VHTS01IW-CON-LIST.RUN-TIME-SPLIT-MIN[CON-INDEX] = VHXCONB_DATA.RUN-TIME-SPLIT-MIN[1];

    
        VHTS01IW-CON-LIST.CAR-NO1[CON-INDEX] = VHXCONB_DATA.CAR-NO[1];
        VHTS01IW-CON-LIST.CAR-NO-1[CON-INDEX] = VHXCONB_DATA.CAR-NO[1];
        VHTS01IW-CON-LIST.CAR-ORDER1[CON-INDEX] = VHXCONB_DATA.CAR-ORDER[1];
        VHTS01IW-CON-LIST.CAR-ORIENT1[CON-INDEX] = VHXCONB_DATA.CAR-ORIENTATION[1];
        VHTS01IW-CON-LIST.CAR-LEFT-ORIENT-1[CON-INDEX] = " ";
        VHTS01IW-CON-LIST.CAR-RIGHT-ORIENT-1[CON-INDEX] = " ";
        if (VHTS01IW-CON-LIST.CAR-ORIENT1[CON-INDEX] == VHTS2A3_DATA.LFT-ORIENTATION-CD[1])
            VHTS01IW-CON-LIST.CAR-LEFT-ORIENT-1[CON-INDEX] = VHTS01IW-CON-LIST.CAR-ORIENT1[CON-INDEX];
        else
            if (VHTS01IW-CON-LIST.CAR-ORIENT1[CON-INDEX] == VHTS2A3_DATA.RGT-ORIENTATION-CD[1])
                VHTS01IW-CON-LIST.CAR-RIGHT-ORIENT-1[CON-INDEX] = VHTS01IW-CON-LIST.CAR-ORIENT1[CON-INDEX];
            end
        end
        if (CON-INDEX == 1)
            VHTS01IW-CON-LIST.CAR-REV-IND-1[CON-INDEX] = VHTS2A1_DATA.REVERSE-IND;
            VHTS01IW-CON-LIST.REV-TRAIN-PLAN[CON-INDEX] = VHTS2A1_CRIT.REV-TRAIN-PLAN;
        end
        VHTS01IW-CON-LIST.CAR-NO2[CON-INDEX] = VHXCONB_DATA.CAR-NO[2];
        VHTS01IW-CON-LIST.CAR-ORDER2[CON-INDEX] = VHXCONB_DATA.CAR-ORDER[2];
        VHTS01IW-CON-LIST.CAR-ORIENT2[CON-INDEX] = VHXCONB_DATA.CAR-ORIENTATION[2];
        VHTS01IW-CON-LIST.CAR-NO-2[CON-INDEX] = VHXCONB_DATA.CAR-NO[2];
        VHTS01IW-CON-LIST.CAR-LEFT-ORIENT-2[CON-INDEX] = " ";
        VHTS01IW-CON-LIST.CAR-RIGHT-ORIENT-2[CON-INDEX] = " ";
        if (VHTS01IW-CON-LIST.CAR-ORIENT2[CON-INDEX] == VHTS2A3_DATA.LFT-ORIENTATION-CD[2])
            VHTS01IW-CON-LIST.CAR-LEFT-ORIENT-2[CON-INDEX] = VHTS01IW-CON-LIST.CAR-ORIENT2[CON-INDEX];
        else
            if (VHTS01IW-CON-LIST.CAR-ORIENT2[CON-INDEX] == VHTS2A3_DATA.RGT-ORIENTATION-CD[2])
                VHTS01IW-CON-LIST.CAR-RIGHT-ORIENT-2[CON-INDEX] = VHTS01IW-CON-LIST.CAR-ORIENT2[CON-INDEX];
            end
        end
        if (CON-INDEX == 2)
            VHTS01IW-CON-LIST.CAR-REV-IND-2[CON-INDEX] = VHTS2A1_DATA.REVERSE-IND;
            VHTS01IW-CON-LIST.REV-TRAIN-PLAN[CON-INDEX] = VHTS2A1_CRIT.REV-TRAIN-PLAN;
        end
        VHTS01IW-CON-LIST.CAR-NO3[CON-INDEX] = VHXCONB_DATA.CAR-NO[3];
