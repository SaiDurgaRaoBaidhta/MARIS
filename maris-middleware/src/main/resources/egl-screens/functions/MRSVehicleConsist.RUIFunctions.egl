                    VHTR01IW-RIGHT-CON.VEH-STAT-4 = VHTR01IW.VEH-STAT-10;
                    
  
  
                else
                    if (VHTR01W-MSG-SC.CAR-POS == 6)
                        VHTR01IW-LEFT-CON.LEFT-CON-SIZE = 5;
                        VHTR01IW-RIGHT-CON.RIGHT-CON-SIZE = VHTR011_DATA.CON-SIZE - VHTR01IW-LEFT-CON.LEFT-CON-SIZE;
                        VHTR01IW-RIGHT-CON.CAR-NO-1 = VHTR01IW.CAR-NO-6;
