        end
        if (IND <= 10)
            VHSC01W-NEW-RIGHT.CAR-NO-5 = VHXCONB_DATA2.CAR-NO[IND];
            VHSC01W-NEW-RIGHT.CAR-ORDER5 = 5;
            VHSC01W-NEW-RIGHT.CAR-ORIENT5 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
