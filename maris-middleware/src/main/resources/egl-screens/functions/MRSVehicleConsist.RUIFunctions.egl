Function VHTS01IS-REV-TRN4 () 
    VHTS01IW-PASSVALUE.RIGHT-ORIENTATION = " ";
    VHTS01IW-PASSVALUE.LEFT-ORIENTATION = " ";
    if (VHTS2A2_DATA.CAR-TYPE == "C1" ||
     VHTS2A2_DATA.CAR-TYPE == "C2")
  
        if (VHTS01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHTS01IW-PASSVALUE.CAR-ORIENT == ")")
                VHTS01IW-PASSVALUE.CAR-ORIENT = "(";
                VHTS01IW-PASSVALUE.LEFT-ORIENTATION = "(";
            else
                VHTS01IW-PASSVALUE.CAR-ORIENT = ")";
                VHTS01IW-PASSVALUE.RIGHT-ORIENTATION = ")";
                
  
  
  
  
            end
        end
    end
    if ( VHTS2A2_DATA.CAR-TYPE == "A2")
  
        if (VHTS01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHTS01IW-PASSVALUE.CAR-ORIENT == ">")
                VHTS01IW-PASSVALUE.CAR-ORIENT = "<";
                VHTS01IW-PASSVALUE.LEFT-ORIENTATION = "<";
            else
                VHTS01IW-PASSVALUE.CAR-ORIENT = ">";
                VHTS01IW-PASSVALUE.RIGHT-ORIENTATION = ">";
            end
        end
    end
  
  
  
    if ( VHTS2A2_DATA.CAR-TYPE == "B2")
  		
        if (VHTS01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHTS01IW-PASSVALUE.CAR-ORIENT == "o")
                VHTS01IW-PASSVALUE.CAR-ORIENT = "O";
                VHTS01IW-PASSVALUE.LEFT-ORIENTATION = "O";
            else
                VHTS01IW-PASSVALUE.CAR-ORIENT = "o";
                VHTS01IW-PASSVALUE.RIGHT-ORIENTATION = "o";
            end
        end
    end
 
    if (VHTS2A2_DATA.CAR-TYPE == "D1" )
        if (VHTS01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHTS01IW-PASSVALUE.CAR-ORIENT == "V")
                VHTS01IW-PASSVALUE.CAR-ORIENT = "v";
                VHTS01IW-PASSVALUE.LEFT-ORIENTATION = "v";
            else
                VHTS01IW-PASSVALUE.CAR-ORIENT = "V";
                VHTS01IW-PASSVALUE.RIGHT-ORIENTATION = "V"; 
            end
        end
    end
    if (VHTS2A2_DATA.CAR-TYPE == "E1" )  
        if (VHTS01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHTS01IW-PASSVALUE.CAR-ORIENT == "}")
                VHTS01IW-PASSVALUE.CAR-ORIENT = "{";
                VHTS01IW-PASSVALUE.LEFT-ORIENTATION = "{";
            else
                VHTS01IW-PASSVALUE.CAR-ORIENT = "}";
                VHTS01IW-PASSVALUE.RIGHT-ORIENTATION = "}";
            end
        end
    end
    
        if (VHTS2A2_DATA.CAR-TYPE == "L1" )
        if (VHTS01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHTS01IW-PASSVALUE.CAR-ORIENT == "L")
                VHTS01IW-PASSVALUE.CAR-ORIENT = "l";
                VHTS01IW-PASSVALUE.LEFT-ORIENTATION = "l";
            else
                VHTS01IW-PASSVALUE.CAR-ORIENT = "L";
                VHTS01IW-PASSVALUE.RIGHT-ORIENTATION = "L"; 
            end
        end
    end
    if (VHTS2A2_DATA.CAR-TYPE == "M1" )  
        if (VHTS01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHTS01IW-PASSVALUE.CAR-ORIENT == "M")
                VHTS01IW-PASSVALUE.CAR-ORIENT = "m";
                VHTS01IW-PASSVALUE.LEFT-ORIENTATION = "m";
            else
                VHTS01IW-PASSVALUE.CAR-ORIENT = "M";
                VHTS01IW-PASSVALUE.RIGHT-ORIENTATION = "M";
            end
        end
    end
    
    if (VHTS2A2_DATA.CAR-TYPE == "K1" || VHTS2A2_DATA.CAR-TYPE == "K2" )  
        if (VHTS01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHTS01IW-PASSVALUE.CAR-ORIENT == "B")
                VHTS01IW-PASSVALUE.CAR-ORIENT = "b";
                VHTS01IW-PASSVALUE.LEFT-ORIENTATION = "b";
            else
                VHTS01IW-PASSVALUE.CAR-ORIENT = "B";
                VHTS01IW-PASSVALUE.RIGHT-ORIENTATION = "B"; 
            end
        end
    end
end 

Function VHTS01IS-VALID-CON () 
    VHTS01IS-CHK-SAME();
    VHTS01W_DATA.LAST-EQ-FIRST = "N";
    if (VHTS01IW-TRIGGER.SAME == "NO" || VHTS01IW-TRIGGER.SAME == " ")
    
    
        VHINC1B_DATA.CON-NO = VHTS01W_DATA.CON-TO;
        try
            call "MRSVehicleIncident.VHINC1B"(XDCONTROL, VHINC1B_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if ((VHINC1B_DATA.CON-STAT == "SRV" ||
             VHINC1B_DATA.CON-STAT == "CAR") &&
             VHTS01IW-CON-LIST.FROM-CON-NO[1] != VHTS01W_DATA.CON-TO)
                VHTS01IW-MSG.MSG = "Enter To consist number or Out of service consist number";
                VHTS01W_DATA.CON-FROM = VHTS01W_DATA.CON-TO;
                VHTS01W_DATA.CON-TO = "     ";
                VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
                DISABLE-FROMCON = "Y";
                VHTS01IW-TRIGGER.TO-ERROR = "Y";
            else
                if ((VHINC1B_DATA.CON-STAT == "SRV" ||
                 VHINC1B_DATA.CON-STAT == "CAR") &&
                 VHTS01IW-CON-LIST.FROM-CON-NO[1] == VHTS01W_DATA.CON-TO)
                    VHTS01IW-MSG.MSG = "Valid Out of Service entered. Swap Stopped. Press UPDATE to Complete";
                    VHTS01IW-TRIGGER.ENABLE-UPDATE = "Y";
                    DISABLE-FROMCON = "Y";
                    DISABLE-TOCON = "Y";
                    UPDATE-SETFOCUS = "Y";
                    DISABLE-SWAP = "Y";
                    VHTS01W_DATA.VAGen_EXISTS = "N";
                    VHTS01W_DATA.SWAP-OK = "Y";
                    VHTS01W_DATA.LAST-EQ-FIRST = "Y";
                    VHTS01IW-TRIGGER.TO-ERROR = "N";
                else
                    if (VHINC1B_DATA.CON-STAT == "CON")
                        VHTS01IW-MSG.MSG = "Swap Invalid - Train Incident present.";
                        VHTS01W_DATA.CON-TO = "     ";
                        VHTS01IW-CON-LIST.DATA-RECORD[CON-INDEX] = " "; 
                        CON-INDEX = CON-INDEX - 1; 
                        VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
                        VHTS01IW-TRIGGER.TO-ERROR = "Y";
                    end
                end
            end
        end
    else
        VHTS01IW-CON-LIST.DATA-RECORD[CON-INDEX] = " "; 
        CON-INDEX = CON-INDEX - 1; 
        VHTS01IW-TRIGGER.DISABLE-UPDATE = "Y";
    end
end 

Function VHTS01US-REV-TRN3 () 
    XXEXT_CALL_Level77Items.UEXTNAM = "VHTS01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHTS2A2";
    set VHTS2A2_DATA empty;

  
  


    
    try
        call "VHTS2A2"(XDCONTROL, VHTS2A2_CRIT, VHTS2A2_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHTS01IS-REV-TRN4();
        end
    end
end
