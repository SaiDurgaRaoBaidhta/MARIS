    VHCM01IW-SVR-REC.CAR-NO-10-PRV-MIN = VHCM01IW-PASSVALUE.CAR-NO-10-CUM-MIN;
    VHCM01IS-ACCU-TIME();
    VHCM01IW-PASSVALUE.CAR-NO-10-CUM-HRS = VHCM01IW-PASSVALUE.CUM-HRS;
    VHCM01IW-PASSVALUE.CAR-NO-10-CUM-MIN = VHCM01IW-PASSVALUE.CUM-MIN;
    VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM = VHCM01IW-PASSVALUE.CAR-NO-10-NEXT-PM;
    VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM = VHCM01IW-PASSVALUE.CAR-NO-10-FROM-PM;
    VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM-MAX = VHCM01IW-PASSVALUE.CAR-NO-10-MAX-PM;
    VHCM01IS-PM-HRS();
    VHCM01IW-PASSVALUE.CAR-NO-10-NEXT-PM = VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM;
    VHCM01IW-PASSVALUE.CAR-NO-10-FROM-PM = VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM;
    VHCM01IW-PASSVALUE.VEH-STAT = VHCM01IW-PASSVALUE.CAR-NO-10-VEH-STAT;
    VHCM01IW-PASSVALUE.VEH-STAT-PREV = VHCM01IW-PASSVALUE.CAR-NO-10-VEH-STAT-PREV;
    VHCM01IW-PASSVALUE.CAR-NO-INCD = VHCM01IW-PASSVALUE.CAR-NO-10;
    VHCM01IW-PASSVALUE.HOME-YRD = VHCM01IW-PASSVALUE.CAR-NO-10-HOME-YRD;
    VHCM01IW-PASSVALUE.CAR-NO = VHCM01IW-PASSVALUE.CAR-NO-10;
    VHCM01IW-PASSVALUE.NO-GO-IND = "N";
    

  
    VHCM01IS-STATUS();
  
    if (VHCM01IW-PASSVALUE.PSEUDO-CAR-10-SW == "Y")
        if (VHCM01IW-PASSVALUE.VEH-STAT != "GO" &&
         VHCM01IW-PASSVALUE.VEH-STAT != "USABLE" &&
         VHCM01IW-PASSVALUE.VEH-STAT != "ERROR")
            VHCM01IW-STATUS.CAR-STATUS-10 = VHCM01IW-PASSVALUE.VEH-STAT;
            VHCM01IW-TRIGGER.CAR10-NO-GO = "Y";
            VHCM01IW-TRIGGER.CAR-ERROR = "Y";
            VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 10 PSEUDO VEH-STAT ERROR";
        end
    end
    VHCM01IW-PASSVALUE.CAR-NO-10-NO-GO = VHCM01IW-PASSVALUE.NO-GO-IND;
    if (VHCM01IW-PASSVALUE.STAT-CHG-SW == "Y")
        VHCM01IW-PASSVALUE.CAR-NO-10-STAT-CHG = "Y";
    else
        VHCM01IW-PASSVALUE.CAR-NO-10-STAT-CHG = "N";
    end
    VHCM01IW-PASSVALUE.CAR-NO-10-VEH-STAT = VHCM01IW-PASSVALUE.VEH-STAT;
    VHCM01IW-PASSVALUE.CAR-NO-10-VEH-STAT-PREV = VHCM01IW-PASSVALUE.VEH-STAT-PREV;
  
  
  
  
  
  
  
    if (VHCM01IW-PASSVALUE.CAR-TYPE-10 == "C1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-10 == "C2" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-10 == "D1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-10 == "L1")
        VHCM01IW-SVR-REC.END-CAR-HRS-HIST = VHCM01IW-SVR-REC.CAR-NO-10-END-HRS-SVC;
        VHCM01IW-SVR-REC.END-CAR-MIN-HIST = VHCM01IW-SVR-REC.CAR-NO-10-END-MIN-SVC;
        VHCM01IW-SVR-REC.MID-CAR-HRS-HIST = VHCM01IW-SVR-REC.CAR-NO-10-MID-HRS-SVC;
        VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.CAR-NO-10-MID-MIN-SVC;
        
  
  
        VHCM01IS-SVC-HIST();
        VHCM01IW-SVR-REC.CAR-NO-10-END-HRS-SVC = VHCM01IW-SVR-REC.END-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-10-END-MIN-SVC = VHCM01IW-SVR-REC.END-CAR-MIN-HIST;
        VHCM01IW-SVR-REC.CAR-NO-10-MID-HRS-SVC = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-10-MID-MIN-SVC = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST;
        
  
  
    end
    VHCM01IW-SVR-REC.CURR-CAR-HRS = VHCM01IW-SVR-REC.CAR-NO-10-CUR-HRS;
    VHCM01IW-SVR-REC.CURR-CAR-MIN = VHCM01IW-SVR-REC.CAR-NO-10-CUR-MIN;
    VHCM01IS-SVC-HIT1();
    VHCM01IW-SVR-REC.CAR-NO-10-CUR-HRS = VHCM01IW-SVR-REC.CURR-CAR-HRS;
    VHCM01IW-SVR-REC.CAR-NO-10-CUR-MIN = VHCM01IW-SVR-REC.CURR-CAR-MIN;

  
    VHCM01IW-PASSVALUE.CAR-NOT-EXIST = "N";
    VHCM015_CRIT.ORIENTATION-10 = " ";
 
    if ((VHCM01IW-1.CAR-TYPE[10] == "C1" ||
     VHCM01IW-1.CAR-TYPE[10] == "C2" ||
     VHCM01IW-1.CAR-TYPE[10] == "D1" ||
     VHCM01IW-1.CAR-TYPE[10] == "L1") &&
     (VHCM01IW-1.ATO-PRESENT-IND[10] != "Y"))
        VHCM01IW-TRIGGER.TYPE-ERROR-CAR10 = "Y";
        VHCM01IW-TRIGGER.CAR-ERROR = "Y";
        VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 10 ATO PRESENT IND NOT = Y";
    else
  
  
  
  
  
  
  
  
  
  
        if (VHCM01IW-1.TRAIN-INCD-IND[10] == "Y")
            VHCM01IW-TRIGGER.CAR10-NO-GO-TI = "Y";
            VHCM01IW-TRIGGER.CAR-ERROR = "Y";
            VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 10 HAS TRAIN INCIDENT";
            if (VHCM01IW-1.CAR-STAT == "NO GO")
                VHCM01IW-STATUS.CAR-STATUS-10 = "NO TI";
            else
                VHCM01IW-STATUS.CAR-STATUS-10 = "GO TI";
            end
            
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
        else
            VHCM01IW-TRIGGER.CAR10-LOC-HI = "Y";
            VHCM01IW-TRIGGER.CAR10-LOC-HI = "Y";
        end
    end
end 

Function VHCM01IS-CAL2 () 
    VHCM01IW-PASSVALUE.END-CAR-HRS = 0;
    VHCM01IW-PASSVALUE.END-CAR-MIN = 0;
    VHCM01IW-PASSVALUE.CAR-LR = VHCM01IW-PASSVALUE.CAR-LR-X[2];
    if (LAST-CAR-NO == 2 ||
     VHCM01IW-PASS-LEFT.CON-SIZE == 2)
        VHCM01IW-PASSVALUE.END-CAR-SW = "Y";
        VHCM01IW-PASSVALUE.MID-CAR-SW = "N";
    else
        VHCM01IW-PASSVALUE.END-CAR-SW = "N";
        VHCM01IW-PASSVALUE.MID-CAR-SW = "Y";
    end
    if (VHCM01IW-PASSVALUE.CAR-TYPE-2 == "C1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-2 == "C2" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-2 == "D1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-2 == "L1")
        VHCM01IW-PASSVALUE.END-CAR-HRS = VHCM01IW-PASSVALUE.CAR-NO-2-END-HRS;
        VHCM01IW-PASSVALUE.END-CAR-MIN = VHCM01IW-PASSVALUE.CAR-NO-2-END-MIN;
        VHCM01IW-PASSVALUE.MID-CAR-HRS = VHCM01IW-PASSVALUE.CAR-NO-2-MID-HRS;
        VHCM01IW-PASSVALUE.MID-CAR-MIN = VHCM01IW-PASSVALUE.CAR-NO-2-MID-MIN;
        VHCM01IW-PASSVALUE.DATE-END-CAR-REV = VHCM01IW-PASSVALUE.DATE-END-CAR-REV-2;
        VHCM01IW-PASSVALUE.TIME-END-CAR = VHCM01IW-PASSVALUE.TIME-END-CAR-2;
        VHCM01IS-C-CAR();
        VHCM01IW-PASSVALUE.CAR-NO-2-END-HRS = VHCM01IW-PASSVALUE.END-CAR-HRS;
        VHCM01IW-PASSVALUE.CAR-NO-2-END-MIN = VHCM01IW-PASSVALUE.END-CAR-MIN;
        VHCM01IW-PASSVALUE.CAR-NO-2-MID-HRS = VHCM01IW-PASSVALUE.MID-CAR-HRS;
        VHCM01IW-PASSVALUE.CAR-NO-2-MID-MIN = VHCM01IW-PASSVALUE.MID-CAR-MIN;
        VHCM01IW-PASSVALUE.BRK-IN-HRS = VHCM01IW-PASSVALUE.CAR-NO-2-BRK-HRS;
        VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX = VHCM01IW-PASSVALUE.CAR-NO-2-MAX-BRK;
        VHCM01IS-BRK-HRS();
        VHCM01IW-PASSVALUE.CAR-NO-2-BRK-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS;
        
  
    else
        if (VHCM01IW-PASSVALUE.CAR-NO-2-WAR-IND == "Y")
            VHCM01IW-PASSVALUE.BRK-IN-HRS = VHCM01IW-PASSVALUE.CAR-NO-2-BRK-HRS;
            VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX = VHCM01IW-PASSVALUE.CAR-NO-2-MAX-BRK;
            VHCM01IS-BRK-HRS();
            VHCM01IW-PASSVALUE.CAR-NO-2-BRK-HRS = VHCM01IW-PASSVALUE.BRK-IN-HRS;
            
  
        end
    end
    VHCM01IW-PASSVALUE.CUM-HRS = VHCM01IW-PASSVALUE.CAR-NO-2-CUM-HRS;
    VHCM01IW-PASSVALUE.CUM-MIN = VHCM01IW-PASSVALUE.CAR-NO-2-CUM-MIN;
    VHCM01IW-SVR-REC.CAR-NO-2-PRV-HRS = VHCM01IW-PASSVALUE.CAR-NO-2-CUM-HRS;
    VHCM01IW-SVR-REC.CAR-NO-2-PRV-MIN = VHCM01IW-PASSVALUE.CAR-NO-2-CUM-MIN;
