Function VHMT01IS-REV-ORINT () 
    if (VHMT01IW-PASSVALUE.CAR-NO == VHMT015_DATA.CAR-NO[1])
        VHMT01IW-PASSVALUE.VAGen_ORIENTATION = VHMT015_DATA.VAGen_ORIENTATION[1];
        
    else
        if (VHMT01IW-PASSVALUE.CAR-NO == VHMT015_DATA.CAR-NO[2])
            VHMT01IW-PASSVALUE.VAGen_ORIENTATION = VHMT015_DATA.VAGen_ORIENTATION[2];
            
        else
            if (VHMT01IW-PASSVALUE.CAR-NO == VHMT015_DATA.CAR-NO[3])
                VHMT01IW-PASSVALUE.VAGen_ORIENTATION = VHMT015_DATA.VAGen_ORIENTATION[3];
                
            else
                if (VHMT01IW-PASSVALUE.CAR-NO == VHMT015_DATA.CAR-NO[4])
                    VHMT01IW-PASSVALUE.VAGen_ORIENTATION = VHMT015_DATA.VAGen_ORIENTATION[4];
                    
                else
                    if (VHMT01IW-PASSVALUE.CAR-NO == VHMT015_DATA.CAR-NO[5])
                        VHMT01IW-PASSVALUE.VAGen_ORIENTATION = VHMT015_DATA.VAGen_ORIENTATION[5];
                        
                    else
                        if (VHMT01IW-PASSVALUE.CAR-NO == VHMT015_DATA.CAR-NO[6])
                            VHMT01IW-PASSVALUE.VAGen_ORIENTATION = VHMT015_DATA.VAGen_ORIENTATION[6];
                            
                        else
                            if (VHMT01IW-PASSVALUE.CAR-NO == VHMT015_DATA.CAR-NO[7])
                                VHMT01IW-PASSVALUE.VAGen_ORIENTATION = VHMT015_DATA.VAGen_ORIENTATION[7];
                                
                            else
                                if (VHMT01IW-PASSVALUE.CAR-NO == VHMT015_DATA.CAR-NO[8])
                                    VHMT01IW-PASSVALUE.VAGen_ORIENTATION = VHMT015_DATA.VAGen_ORIENTATION[8];
                                    
                                else
                                    if (VHMT01IW-PASSVALUE.CAR-NO == VHMT015_DATA.CAR-NO[9])
                                        VHMT01IW-PASSVALUE.VAGen_ORIENTATION = VHMT015_DATA.VAGen_ORIENTATION[9];
                                        
                                    else
                                        if (VHMT01IW-PASSVALUE.CAR-NO == VHMT015_DATA.CAR-NO[10])
                                            VHMT01IW-PASSVALUE.VAGen_ORIENTATION = VHMT015_DATA.VAGen_ORIENTATION[10];
                                            
                                        else
                                            VHMT01IW-PASSVALUE.VAGen_ORIENTATION = VHMT014_DATA.VAGen_ORIENTATION[COUNTER];
                                            
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHMT01IS-REV-TIME () 
    try
        call "VHMT016"(XDCONTROL, VHMT016_DATA);
    
    end
    VHXREVC_DATA.DB-REVENUE-DATE = VHMT016_DATA.REVENUE-DATE;
  
    VHXREVC_DATA.END-TIME-DAY = "24.00.00";

  
  
    VHXREVC_DATA.TIME-REV-START = "03.00.00";
    VHXREVC_DATA.TIME-REV-END = "02.59.59";

  
  
  
  
  
    VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    VHXREVC_DATA.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    VHXREVC_DATA.SYS-MINUTES = (VHXREVC_DATA.SYSTEM-TIME-HR-NUM * 60) + VHXREVC_DATA.SYSTEM-TIME-MIN-NUM;
    if (VHXREVC_DATA.SYS-MINUTES < 180)
  
  
        XXDATEW.DATE-YYYY-MM-DD = VHXREVC_DATA.DB-REVENUE-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHXREVC_DATA.REVENUE-DATE = XXDATEW.DATE-MM-DD-YYYY;
    else
        VHXREVC_DATA.REVENUE-DATE = VHXREVC_DATA.SYSTEM-DATE;
    end
end 

Function VHMT01IS-TIME-MSG () 
    if (VHMT01IW-TRIGGER.TIME-OUT-RANGE == "Y")
        VHMT01IW-TIME-MSG.MSG-1 = "TIME INSERVICE HOURS SHOULD BETWEEN 00 - 24";
        VHMT01IW-TRIGGER.TIME-OUT-RANGE = " ";
        VHMT01IW-TIME-MSG.TIME-MESSAGE = VHMT01IW.TIME-INSRV-HRMIN;
        VHMT01IW-WS-MSG.MSG-NO = VHMT01IW-WS-MSG.MSG-NO + 1;
        VHMT01IW-WS-MSG.MSG-LAST-BYTE = 15;
        VHMT01IW-WS-MSG.MESSAGES-X[1] = TIME-MESSAGE-X[1];
        VHMT01IW-WS-MSG.MESSAGES-X[2] = TIME-MESSAGE-X[2];
        VHMT01IW-WS-MSG.MESSAGES-X[3] = TIME-MESSAGE-X[3];
