                                                VHTR01IW-CON-LIST.CAR-RIGHT-ORIENT-10 = VHTR01IW-CON-LIST.CAR-ORIENT10;
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        IND = IND + 1;
    end
    set VHTR01W-NEW-RIGHT empty;
    CLICK-COUNT = 0;
end 

Function VHTR01IS-MV-RIGHT ()
  
  
  
   
    VHTR01W-MSG-SC.MSG = " ";
    CLICK-COUNT = 0;
    VHTR01IW-TRIGGER.DISABLE-RECONFIG-X = " ";
    
  
  
  
  
  
  
    VHTR01IS-VALD-LR();
    if (CLICK-COUNT == 0)
        XXEXT_CALL_Level77Items.UEXTNAM = "VHSC01I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHSC2A1";
        VHTR01W-MSG-SC.CAR-POS-1 = VHTR01W-MSG-SC.CAR-POS - 1;

    
    
        VHSC2A1_CRIT.CAR-NO-L = VHTR011_DATA.CAR-NO[CAR-POS-1];
        VHSC2A1_CRIT.CAR-NO-R = VHTR011_DATA.CAR-NO[CAR-POS];
        VHTR01IW-PASSVALUE.RIGHT-CAR-POS = VHTR01W-MSG-SC.CAR-POS;

    
        try
            call "VHSC2A1"(XDCONTROL, VHSC2A1_CRIT, VHSC2A1_DATA);
        
        end
        

  
        MRSCommonCode.XXA0IS-CHECK_EXT();

  
        if (XXEXT_CALL_Level77Items.URC == 0)
    
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHTR01IS-MV-RIGHTX();
            else
        
        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    else
        if (CLICK-COUNT == 1)
            VHTR01IS-MV-LEFTX(); 
            CLICK-COUNT = 0;
        end
    end
end 

