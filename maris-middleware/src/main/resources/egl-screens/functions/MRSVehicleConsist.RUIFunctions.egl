Function VHLT01IS-CAR-INCD () 
    INCD-COUNT = 1;
    VHLT01IW-TRIGGER.CAR-NO-1-HI = "Y";
    VHLT01IW-TRIGGER.CAR-NO-2-HI = "Y";
    VHLT01IW-TRIGGER.CAR-NO-3-HI = "Y";
    VHLT01IW-TRIGGER.CAR-NO-4-HI = "Y";
    VHLT01IW-TRIGGER.CAR-NO-5-HI = "Y";
    VHLT01IW-TRIGGER.CAR-NO-6-HI = "Y";
    VHLT01IW-TRIGGER.CAR-NO-7-HI = "Y";
    VHLT01IW-TRIGGER.CAR-NO-8-HI = "Y";
    VHLT01IW-TRIGGER.CAR-NO-9-HI = "Y";
    VHLT01IW-TRIGGER.CAR-NO-10-HI = "Y";
    while (INCD-COUNT <= CAR-INCD-COUNT)
        if (VHLT01IW-PASSVALUE.CAR-NO-1 == VHLT013_DATA.CAR-NO[INCD-COUNT])
            VHLT01IW-TRIGGER.CAR-NO-1-SH = "Y";
        else
            if (VHLT01IW-PASSVALUE.CAR-NO-2 == VHLT013_DATA.CAR-NO[INCD-COUNT])
                VHLT01IW-TRIGGER.CAR-NO-2-SH = "Y";
            else
                if (VHLT01IW-PASSVALUE.CAR-NO-3 == VHLT013_DATA.CAR-NO[INCD-COUNT])
                    VHLT01IW-TRIGGER.CAR-NO-3-SH = "Y";
                else
                    if (VHLT01IW-PASSVALUE.CAR-NO-4 == VHLT013_DATA.CAR-NO[INCD-COUNT])
                        VHLT01IW-TRIGGER.CAR-NO-4-SH = "Y";
                    else
                        if (VHLT01IW-PASSVALUE.CAR-NO-5 == VHLT013_DATA.CAR-NO[INCD-COUNT])
                            VHLT01IW-TRIGGER.CAR-NO-5-SH = "Y";
                        else
                            if (VHLT01IW-PASSVALUE.CAR-NO-6 == VHLT013_DATA.CAR-NO[INCD-COUNT])
                                VHLT01IW-TRIGGER.CAR-NO-6-SH = "Y";
                            else
                                if (VHLT01IW-PASSVALUE.CAR-NO-7 == VHLT013_DATA.CAR-NO[INCD-COUNT])
                                    VHLT01IW-TRIGGER.CAR-NO-7-SH = "Y";
                                else
                                    if (VHLT01IW-PASSVALUE.CAR-NO-8 == VHLT013_DATA.CAR-NO[INCD-COUNT])
                                        VHLT01IW-TRIGGER.CAR-NO-8-SH = "Y";
                                    else
                                        if (VHLT01IW-PASSVALUE.CAR-NO-9 == VHLT013_DATA.CAR-NO[INCD-COUNT])
                                            VHLT01IW-TRIGGER.CAR-NO-9-SH = "Y";
                                        else
                                            if (VHLT01IW-PASSVALUE.CAR-NO-10 == VHLT013_DATA.CAR-NO[INCD-COUNT])
                                                VHLT01IW-TRIGGER.CAR-NO-10-SH = "Y";
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        CAR-COUNT = CAR-COUNT + 1;
    end
end 

Function VHLT01IS-CHK-CAR ()
  
   
    VHLT015_CRIT.WS-DATE-REV = VHLT01IW-PASSVALUE.DATE-REV;
    VHLT015_CRIT.CON-NO = VHLT01IW.CON-NO;
    try
        call "VHLT015"(XDCONTROL, VHLT015_CRIT, VHLT015_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHLT01IW-PASSVALUE.CAR-COUNT = XDCONTROL.UROWCNT;
        VHLT01IW-SVR-REC.HIST-COUNT = VHLT015_CRIT.HIST-COUNT;
        VHLT01IS-MOVE-CAR();
        VHLT01IS-MOV-CARH();
        VHLT01IS-CHK-INCD();
    else
        VHLT01IW-TRIGGER.CON-ERROR = "Y";
    end
end 

Function VHLT01IS-CHK-DVS () 
    if (VHLT01IW-PASSVALUE.VEH-STAT-PREV == "GO" ||
     VHLT01IW-PASSVALUE.VEH-STAT-PREV == "USABLE")
        VHLT019_CRIT.CAR-NO = VHLT01IW-PASSVALUE.CAR-NO;
        try
            call "VHLT019"(XDCONTROL, VHLT019_CRIT, VHLT019_DATA);
        
        end
        if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
         (XDCONTROL.UROWCNT > 0 || VHLT019_DATA.INCD-COUNT-X > 0))
            VHLT01IS-UPD-DVS();
        end
    end
end 

Function VHLT01IS-CHK-INCD ()
   
    VHLT013_CRIT.CON-NO = VHLT01IW.CON-NO;
    VHLT013_CRIT.DASH-NO = VHLT009_DATA.DASH-NO;
    VHLT013_CRIT.DATE-INSRV-REV = VHLT009_DATA.DATE-INSRV-REV;
    VHLT013_CRIT.DATE-INSRV = VHLT009_DATA.DATE-INSRV;
    VHLT013_CRIT.TIME-INSRV = VHLT009_DATA.TIME-INSRV;
    try
        call "VHLT013"(XDCONTROL, VHLT013_CRIT, VHLT013_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHLT01IW-PASSVALUE.CAR-INCD-COUNT = XDCONTROL.UROWCNT;
        if (XDCONTROL.UROWCNT == 0)
  
            VHLT01IS-OTIME();
  
  
        else
            VHLT01IS-CAR-INCD();
            VHLT01IW-TRIGGER.OPEN-CAR-INCD = "Y";
        end
    end
end 

Function VHLT01IS-CKCO-IND ()

   
    VHLT01IW-TRIGGER.TIME-OUT-ERR = " ";
    VHLT01IS-OSRV-TIME();
    if (VHLT01IW-TRIGGER.TIME-OUT-ERR == " ")
  
        VHLT014_CRIT.CON-NO = VHLT01IW.CON-NO;
        VHLT014_CRIT.DASH-NO = VHLT009_DATA.DASH-NO;
        VHLT014_CRIT.DATE-INSRV-REV = VHLT009_DATA.DATE-INSRV-REV;
        VHLT014_CRIT.DATE-INSRV = VHLT009_DATA.DATE-INSRV;
        VHLT014_CRIT.TIME-INSRV = VHLT009_DATA.TIME-INSRV;
        try
            call "VHLT014"(XDCONTROL, VHLT014_CRIT, VHLT014_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (XDCONTROL.UROWCNT == 0)
  
                VHLT01IS-CHK-CAR();
            else
                VHLT01IW-TRIGGER.CON-INCD = "Y";
            end
        end
    end
end 

