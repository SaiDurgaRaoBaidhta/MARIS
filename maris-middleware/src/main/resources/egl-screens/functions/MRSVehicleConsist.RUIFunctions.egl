Function VHCC01IS-MOVE-CAR () 
    COUNTERX = 1;
    while ((VHCC01IW-PASSVALUE.COUNTERX <= XDCONTROL.UROWCNT))
        if (VHCC011_DATA.CAR-ORDER[COUNTERX] == 1)
            VHCC01IW.CAR-NO-1-MARIS = VHCC011_DATA.CAR-NO[COUNTERX];
  
  
            VHCC01IW.CAR-TYPE-1-NEW = VHCC011_DATA.CAR-TYPE[COUNTERX];
            VHCC01IW.CURR-LOC-1-NEW = VHCC011_DATA.CURR-LOC[COUNTERX];
            VHCC01IW.WHERE-IS-CAR-1-NEW = VHCC011_DATA.WHERE-IS-CAR[COUNTERX];
  
  
            VHCC01IW.CAR-NO-1-ORIENT = VHCC011_DATA.VAGen_ORIENTATION[COUNTERX];
            
  
  
  
        else
            if (VHCC011_DATA.CAR-ORDER[COUNTERX] == 2)
                VHCC01IW.CAR-NO-2-MARIS = VHCC011_DATA.CAR-NO[COUNTERX];
  
  
                VHCC01IW.CAR-TYPE-2-NEW = VHCC011_DATA.CAR-TYPE[COUNTERX];
                VHCC01IW.CURR-LOC-2-NEW = VHCC011_DATA.CURR-LOC[COUNTERX];
                VHCC01IW.WHERE-IS-CAR-2-NEW = VHCC011_DATA.WHERE-IS-CAR[COUNTERX];
  
  
                VHCC01IW.CAR-NO-2-ORIENT = VHCC011_DATA.VAGen_ORIENTATION[COUNTERX];
                
  
  
  
            else
                if (VHCC011_DATA.CAR-ORDER[COUNTERX] == 3)
                    VHCC01IW.CAR-NO-3-MARIS = VHCC011_DATA.CAR-NO[COUNTERX];
  
  
                    VHCC01IW.CAR-TYPE-3-NEW = VHCC011_DATA.CAR-TYPE[COUNTERX];
                    VHCC01IW.CURR-LOC-3-NEW = VHCC011_DATA.CURR-LOC[COUNTERX];
                    VHCC01IW.WHERE-IS-CAR-3-NEW = VHCC011_DATA.WHERE-IS-CAR[COUNTERX];
  
  
                    VHCC01IW.CAR-NO-3-ORIENT = VHCC011_DATA.VAGen_ORIENTATION[COUNTERX];
                    
  
  
  
                else
                    if (VHCC011_DATA.CAR-ORDER[COUNTERX] == 4)
                        VHCC01IW.CAR-NO-4-MARIS = VHCC011_DATA.CAR-NO[COUNTERX];
  
  
                        VHCC01IW.CAR-TYPE-4-NEW = VHCC011_DATA.CAR-TYPE[COUNTERX];
                        VHCC01IW.CURR-LOC-4-NEW = VHCC011_DATA.CURR-LOC[COUNTERX];
                        VHCC01IW.WHERE-IS-CAR-4-NEW = VHCC011_DATA.WHERE-IS-CAR[COUNTERX];
  
  
                        VHCC01IW.CAR-NO-4-ORIENT = VHCC011_DATA.VAGen_ORIENTATION[COUNTERX];
                        
  
  
  
                    else
                        if (VHCC011_DATA.CAR-ORDER[COUNTERX] == 5)
                            VHCC01IW.CAR-NO-5-MARIS = VHCC011_DATA.CAR-NO[COUNTERX];
  
  
                            VHCC01IW.CAR-TYPE-5-NEW = VHCC011_DATA.CAR-TYPE[COUNTERX];
                            VHCC01IW.CURR-LOC-5-NEW = VHCC011_DATA.CURR-LOC[COUNTERX];
                            VHCC01IW.WHERE-IS-CAR-5-NEW = VHCC011_DATA.WHERE-IS-CAR[COUNTERX];
  
  
                            VHCC01IW.CAR-NO-5-ORIENT = VHCC011_DATA.VAGen_ORIENTATION[COUNTERX];
                            
  
  
  
                        else
                            if (VHCC011_DATA.CAR-ORDER[COUNTERX] == 6)
                                VHCC01IW.CAR-NO-6-MARIS = VHCC011_DATA.CAR-NO[COUNTERX];
  
  
                                VHCC01IW.CAR-TYPE-6-NEW = VHCC011_DATA.CAR-TYPE[COUNTERX];
                                VHCC01IW.CURR-LOC-6-NEW = VHCC011_DATA.CURR-LOC[COUNTERX];
                                VHCC01IW.WHERE-IS-CAR-6-NEW = VHCC011_DATA.WHERE-IS-CAR[COUNTERX];
  
  
                                VHCC01IW.CAR-NO-6-ORIENT = VHCC011_DATA.VAGen_ORIENTATION[COUNTERX];
                                
  
  
  
                            else
                                if (VHCC011_DATA.CAR-ORDER[COUNTERX] == 7)
                                    VHCC01IW.CAR-NO-7-MARIS = VHCC011_DATA.CAR-NO[COUNTERX];
  
  
                                    VHCC01IW.CAR-TYPE-7-NEW = VHCC011_DATA.CAR-TYPE[COUNTERX];
                                    VHCC01IW.CURR-LOC-7-NEW = VHCC011_DATA.CURR-LOC[COUNTERX];
                                    VHCC01IW.WHERE-IS-CAR-7-NEW = VHCC011_DATA.WHERE-IS-CAR[COUNTERX];
  
  
                                    VHCC01IW.CAR-NO-7-ORIENT = VHCC011_DATA.VAGen_ORIENTATION[COUNTERX];
                                    
  
  
  
                                else
                                    if (VHCC011_DATA.CAR-ORDER[COUNTERX] == 8)
                                        VHCC01IW.CAR-NO-8-MARIS = VHCC011_DATA.CAR-NO[COUNTERX];
  
  
                                        VHCC01IW.CAR-TYPE-8-NEW = VHCC011_DATA.CAR-TYPE[COUNTERX];
                                        VHCC01IW.CURR-LOC-8-NEW = VHCC011_DATA.CURR-LOC[COUNTERX];
                                        VHCC01IW.WHERE-IS-CAR-8-NEW = VHCC011_DATA.WHERE-IS-CAR[COUNTERX];
  
  
                                        VHCC01IW.CAR-NO-8-ORIENT = VHCC011_DATA.VAGen_ORIENTATION[COUNTERX];
                                        
  
  
  
                                    else
                                        if (VHCC011_DATA.CAR-ORDER[COUNTERX] == 9)
                                            VHCC01IW.CAR-NO-9-MARIS = VHCC011_DATA.CAR-NO[COUNTERX];
  
  
                                            VHCC01IW.CAR-TYPE-9-NEW = VHCC011_DATA.CAR-TYPE[COUNTERX];
                                            VHCC01IW.CURR-LOC-9-NEW = VHCC011_DATA.CURR-LOC[COUNTERX];
                                            VHCC01IW.WHERE-IS-CAR-9-NEW = VHCC011_DATA.WHERE-IS-CAR[COUNTERX];
  
  
                                            VHCC01IW.CAR-NO-9-ORIENT = VHCC011_DATA.VAGen_ORIENTATION[COUNTERX];
                                            
  
  
  
                                        else
                                            if (VHCC011_DATA.CAR-ORDER[COUNTERX] == 10)
                                                VHCC01IW.CAR-NO-10-MARIS = VHCC011_DATA.CAR-NO[COUNTERX];
  
  
                                                VHCC01IW.CAR-TYPE-10-NEW = VHCC011_DATA.CAR-TYPE[COUNTERX];
                                                VHCC01IW.CURR-LOC-10-NEW = VHCC011_DATA.CURR-LOC[COUNTERX];
                                                VHCC01IW.WHERE-IS-CAR-10-NEW = VHCC011_DATA.WHERE-IS-CAR[COUNTERX];
  
  
                                                VHCC01IW.CAR-NO-10-ORIENT = VHCC011_DATA.VAGen_ORIENTATION[COUNTERX];
                                                
  
  
  
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        COUNTERX = COUNTERX + 1;
    end
    VHCC01IW.DASH-NO = VHCC011_DATA.DASH-NO[1];
    VHCC01IW.TIME-INSRV = VHCC011_DATA.TIME-INSRV[1];
    VHCC01IW.DATE-INSRV = VHCC011_DATA.DATE-INSRV[1];
    move DATE-INSRV-YY to DATE-INSRV-X-YY withV60Compat;
    move DATE-INSRV-MM to DATE-INSRV-X-MM withV60Compat;
    move DATE-INSRV-DD to DATE-INSRV-X-DD withV60Compat;
    DATE-INSRV-X-1 = "-";
    DATE-INSRV-X-2 = "-";
end 

Function VHCC01IS-MSG-RT ()
   
    MSG-BYTE-COUNT = 1;
    MSG-BYTE-COUNT-X = MSG-BYTE-COUNT-X + 1;
    if (MSG-BYTE-COUNT-X > 1 && MSG-BYTE-COUNT-X <= 99)
        VHCC01IW-WS-MSG.MESSAGES[MSG-BYTE-COUNT-X] = " ";
        MSG-BYTE-COUNT-X = MSG-BYTE-COUNT-X + 1;
        VHCC01IW-WS-MSG.MESSAGES[MSG-BYTE-COUNT-X] = " ";
        MSG-BYTE-COUNT-X = MSG-BYTE-COUNT-X + 1;
    end
    if (MSG-BYTE-COUNT-X < 99)
        while ((VHCC01IW-WS-MSG.MSG-BYTE-COUNT <=
         VHCC01IW-WS-MSG.MSG-LAST-BYTE) &&
         (MSG-BYTE-COUNT-X <= 99))
            VHCC01IW-WS-MSG.MESSAGES[MSG-BYTE-COUNT-X] = VHCC01IW-WS-MSG.MESSAGES-X[MSG-BYTE-COUNT];
            MSG-BYTE-COUNT = MSG-BYTE-COUNT + 1;
            MSG-BYTE-COUNT-X = MSG-BYTE-COUNT-X + 1;
        end
    end
end 

