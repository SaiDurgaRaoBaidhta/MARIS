    VHCM01IW-SVR-REC.CAR-NO-5-PRV-MIN = VHCM01IW-PASSVALUE.CAR-NO-5-CUM-MIN;
    VHCM01IS-ACCU-TIME();
    VHCM01IW-PASSVALUE.CAR-NO-5-CUM-HRS = VHCM01IW-PASSVALUE.CUM-HRS;
    VHCM01IW-PASSVALUE.CAR-NO-5-CUM-MIN = VHCM01IW-PASSVALUE.CUM-MIN;
