                        VHTR01IW-RIGHT-CON.CAR-NO-5 = VHTR01IW.CAR-NO-10;
                        VHTR01IW-LEFT-CON.CAR-NO-1 = VHTR01IW.CAR-NO-1;
                        VHTR01IW-LEFT-CON.CAR-NO-2 = VHTR01IW.CAR-NO-2;
                        VHTR01IW-LEFT-CON.CAR-NO-3 = VHTR01IW.CAR-NO-3;
                        VHTR01IW-LEFT-CON.CAR-NO-4 = VHTR01IW.CAR-NO-4;
                        VHTR01IW-LEFT-CON.CAR-NO-5 = VHTR01IW.CAR-NO-5;
                        VHTR01IW-LEFT-CON.VEH-STAT-1 = VHTR01IW.VEH-STAT-1;
                        VHTR01IW-LEFT-CON.VEH-STAT-2 = VHTR01IW.VEH-STAT-2;
                        VHTR01IW-LEFT-CON.VEH-STAT-3 = VHTR01IW.VEH-STAT-3;
                        VHTR01IW-LEFT-CON.VEH-STAT-4 = VHTR01IW.VEH-STAT-4;
                        VHTR01IW-LEFT-CON.VEH-STAT-5 = VHTR01IW.VEH-STAT-5;
                        VHTR01IW-RIGHT-CON.VEH-STAT-1 = VHTR01IW.VEH-STAT-6;
                        VHTR01IW-RIGHT-CON.VEH-STAT-2 = VHTR01IW.VEH-STAT-7;
                        VHTR01IW-RIGHT-CON.VEH-STAT-3 = VHTR01IW.VEH-STAT-8;
                        VHTR01IW-RIGHT-CON.VEH-STAT-4 = VHTR01IW.VEH-STAT-9;
                        VHTR01IW-RIGHT-CON.VEH-STAT-5 = VHTR01IW.VEH-STAT-10;
                        
  
  
  
                    else
                        if (VHTR01W-MSG-SC.CAR-POS == 5)
                            VHTR01IW-LEFT-CON.LEFT-CON-SIZE = 4;
                            VHTR01IW-RIGHT-CON.RIGHT-CON-SIZE = VHTR011_DATA.CON-SIZE - VHTR01IW-LEFT-CON.LEFT-CON-SIZE;
                            VHTR01IW-RIGHT-CON.CAR-NO-1 = VHTR01IW.CAR-NO-5;
