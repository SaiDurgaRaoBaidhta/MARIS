                                            VHCM01IW-PASS-RIGH.DATE-END-CAR-REV-9 = VHCM014_DATA.DATE-END-CAR-REV[9];
                                            VHCM01IW-PASS-RIGH.TIME-END-CAR-9 = VHCM014_DATA.TIME-END-CAR[9];
                                            VHCM01IW-PASS-RIGH.CAR-NO-9-VEH-STAT-PREV = VHCM014_DATA.VEH-STAT-PREV[9];
                                            VHCM01IW-PASS-RIGH.CAR-NO-9-HOME-YRD = VHCM014_DATA.HOME-YRD[9];
                                            VHCM01IW-PASS-RIGH.DATE-END-CAR-REV-9 = VHCM014_DATA.DATE-END-CAR-REV[9];
                                            VHCM01IW-PASS-RIGH.TIME-END-CAR-9 = VHCM014_DATA.TIME-END-CAR[9];
                                            VHCM01IW-PASS-RIGH.ATO-PRESENT-IND-CAR-9 = VHCM014_DATA.ATO-PRESENT-IND[9];
                                            VHCM01IW-PASS-RIGH.TRAIN-INCD-IND-CAR-9 = VHCM014_DATA.TRAIN-INCD-IND[9];
                                            VHCM01IW-PASS-RIGH.ORIENTATION-9 = VHCM014_DATA.VAGen_ORIENTATION[9];
                                            VHCM015_CRIT-VEH-R.ORIENTATION-9 = VHCM014_DATA.VAGen_ORIENTATION[9];
                                            if (VHCM014_DATA.VAGen_ORIENTATION[VHCM01IW-PASS-RIGH.COUNTER] ==
                                             VHCM014_DATA.LFT-ORIENTATION-CD[VHCM01IW-PASS-RIGH.COUNTER])
                                                VHCM01IW-PASS-RIGH.CAR-NO-9-LFT-ORIENT = VHCM014_DATA.VAGen_ORIENTATION[VHCM01IW-PASS-RIGH.COUNTER];
                                                VHCM01IW-PASS-RIGH.CAR-NO-9-RGT-ORIENT = " ";
                                            else
                                                if (VHCM014_DATA.VAGen_ORIENTATION[VHCM01IW-PASS-RIGH.COUNTER] ==
                                                 VHCM014_DATA.RGT-ORIENTATION-CD[VHCM01IW-PASS-RIGH.COUNTER])
                                                    VHCM01IW-PASS-RIGH.CAR-NO-9-RGT-ORIENT = VHCM014_DATA.VAGen_ORIENTATION[VHCM01IW-PASS-RIGH.COUNTER];
                                                    VHCM01IW-PASS-RIGH.CAR-NO-9-LFT-ORIENT = " ";
                                                end
                                            end
                                            VHCM01IW-PASS-RIGH.CAR-NO-9-STAT = VHCM014_DATA.VEH-STAT[9];
                                            VHCM01IS-CHK-STAT();
                                        else
                                            if (VHCM01IW-PASS-RIGH.COUNTER == 10)
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-PSEUDO = "Y";
                                                VHCM01IW-PASS-RIGH.CAR-NO-10 = VHCM014_DATA.CAR-NO[10];
                                                VHCM01IW-PASS-RIGH.CON-NO-10 = VHCM014_DATA.CON-NO[10];
                                                VHCM01IW-PASS-RIGH.CAR-TYPE-10 = VHCM014_DATA.CAR-TYPE[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-CURR-LOC = VHCM014_DATA.CURR-LOC[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-END-HRS = VHCM014_DATA.END-CAR-HRS[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-END-MIN = VHCM014_DATA.END-CAR-MIN[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-MID-HRS = VHCM014_DATA.MID-CAR-HRS[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-MID-MIN = VHCM014_DATA.MID-CAR-MIN[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-CUM-HRS = VHCM014_DATA.CUM-HRS[10];
                                                VHCM01IW-SVR-REC.CAR-NO-10-PRV-HRS = VHCM014_DATA.CUM-HRS[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-CUM-MIN = VHCM014_DATA.CUM-MIN[10];
                                                VHCM01IW-SVR-REC.CAR-NO-10-PRV-MIN = VHCM014_DATA.CUM-MIN[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-BRK-HRS = VHCM014_DATA.BRK-IN-HRS[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-NEXT-PM = VHCM014_DATA.HRS-TO-NEXT-PM[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-FROM-PM = VHCM014_DATA.HRS-FROM-LAST-PM[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-MAX-PM = VHCM014_DATA.HRS-TO-NEXT-PM-MAX[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-MAX-BRK = VHCM014_DATA.BRK-IN-HRS-MAX[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-WAR-IND = VHCM014_DATA.WAR-IND[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-VEH-STAT = VHCM014_DATA.VEH-STAT[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-VEH-STAT-PREV = VHCM014_DATA.VEH-STAT-PREV[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-HOME-YRD = VHCM014_DATA.HOME-YRD[10];
                                                VHCM01IW-PASS-RIGH.DATE-END-CAR-REV-10 = VHCM014_DATA.DATE-END-CAR-REV[10];
                                                VHCM01IW-PASS-RIGH.TIME-END-CAR-10 = VHCM014_DATA.TIME-END-CAR[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-VEH-STAT-PREV = VHCM014_DATA.VEH-STAT-PREV[10];
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-HOME-YRD = VHCM014_DATA.HOME-YRD[10];
                                                VHCM01IW-PASS-RIGH.DATE-END-CAR-REV-10 = VHCM014_DATA.DATE-END-CAR-REV[10];
                                                VHCM01IW-PASS-RIGH.TIME-END-CAR-10 = VHCM014_DATA.TIME-END-CAR[10];
                                                VHCM01IW-PASS-RIGH.ATO-PRESENT-IND-CAR-10 = VHCM014_DATA.ATO-PRESENT-IND[10];
                                                VHCM01IW-PASS-RIGH.TRAIN-INCD-IND-CAR-10 = VHCM014_DATA.TRAIN-INCD-IND[10];
                                                VHCM01IW-PASS-RIGH.ORIENTATION-10 = VHCM014_DATA.VAGen_ORIENTATION[10];
                                                VHCM015_CRIT-VEH-R.ORIENTATION-10 = VHCM014_DATA.VAGen_ORIENTATION[10];
                                                if (VHCM014_DATA.VAGen_ORIENTATION[VHCM01IW-PASS-RIGH.COUNTER] ==
                                                 VHCM014_DATA.LFT-ORIENTATION-CD[VHCM01IW-PASS-RIGH.COUNTER])
                                                    VHCM01IW-PASS-RIGH.CAR-NO-10-LFT-ORIENT = VHCM014_DATA.VAGen_ORIENTATION[VHCM01IW-PASS-RIGH.COUNTER];
                                                    VHCM01IW-PASS-RIGH.CAR-NO-10-RGT-ORIENT = " ";
                                                else
                                                    if (VHCM014_DATA.VAGen_ORIENTATION[VHCM01IW-PASS-RIGH.COUNTER] ==
                                                     VHCM014_DATA.RGT-ORIENTATION-CD[VHCM01IW-PASS-RIGH.COUNTER])
                                                        VHCM01IW-PASS-RIGH.CAR-NO-10-RGT-ORIENT = VHCM014_DATA.VAGen_ORIENTATION[VHCM01IW-PASS-RIGH.COUNTER];
                                                        VHCM01IW-PASS-RIGH.CAR-NO-10-LFT-ORIENT = " ";
                                                    end
                                                end
                                                VHCM01IW-PASS-RIGH.CAR-NO-10-STAT = VHCM014_DATA.VEH-STAT[10];
                                                VHCM01IS-CHK-STAT();
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        VHCM01IW-PASS-RIGH.COUNTER = VHCM01IW-PASS-RIGH.COUNTER + 1;
    end
end 

Function VHCM01IS-YT-CL () 
    VHCM01IW-PASS-RIGH.CAR-NO-1 = " ";
    VHCM01IW-PASS-RIGH.CAR-NO-2 = " ";
    VHCM01IW-PASS-RIGH.CAR-NO-3 = " ";
    VHCM01IW-PASS-RIGH.CAR-NO-4 = " ";
    VHCM01IW-PASS-RIGH.CAR-NO-5 = " ";
    VHCM01IW-PASS-RIGH.CAR-NO-6 = " ";
    VHCM01IW-PASS-RIGH.CAR-NO-7 = " ";
    VHCM01IW-PASS-RIGH.CAR-NO-8 = " ";
    VHCM01IW-PASS-RIGH.CAR-NO-9 = " ";
    VHCM01IW-PASS-RIGH.CAR-NO-10 = " ";
end 

Function VHCM01IS-YT-CON () 
    VHCM01IW-PASS-MT.PSEUDO-SW = "N";
    VHCM01IW-PASS-RIGH.PSEUDO-CAR-SW = "N";
    set VHCM014_CRIT empty;
    VHCM014_CRIT.CON-NO = VHCM01IW.TRAIN;
    try
        call "VHCM014"(XDCONTROL, VHCM014_CRIT, VHCM014_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
        VHCM01IW-PASS-MT.PSEUDO-SW = "Y";
        VHCM01IW-PASS-RIGH.PSEUDO-CAR-SW = "Y";
        VHCM01IW-PASS-MT.PSEUDO-CON-NO = VHCM01IW.TRAIN;
        VHCM015_CRIT-VEH-R.CON-SIZE = XDCONTROL.UROWCNT;
        VHCM01IW-PASSVALUE.RIGHT-COUNT = XDCONTROL.UROWCNT;
        VHCM015_CRIT-VEH-R.CON-STAT = " ";
        VHCM015_CRIT.MT-REVERSE-IND = VHCM014_CRIT.MT-REVERSE-IND;
        VHCM01IS-YT-CAR();
    else
        if (XDCONTROL.URC == 100)
            VHCM01IS-YT-CL();
            if (VHCM01IW-TRIGGER.PSEUDO-CON-OUT == "Y")
                VHCM01IW-TRIGGER.TRAIN-NOT-INSRV = "Y";
  
                VHCM01IW-TRIGGER.TRAIN-ERROR = "Y";
            else
                VHCM01IW-TRIGGER.TRAIN-NOT-EXIST = "Y";
                VHCM01IW-TRIGGER.TRAIN-ERROR = "Y";
            end
  
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHCT01IS-ACCU-TIME () 
    VHCT01IW-PASSVALUE.CUM-HRS = VHCT01IW-PASSVALUE.CUM-HRS + DIFF-HH;
    VHCT01IW-PASSVALUE.CUM-MIN = VHCT01IW-PASSVALUE.CUM-MIN + DIFF-MM;
    if (VHCT01IW-PASSVALUE.CUM-MIN > 59)
        VHCT01IW-PASSVALUE.CUM-HRS = VHCT01IW-PASSVALUE.CUM-HRS + 1;
        VHCT01IW-PASSVALUE.CUM-MIN = VHCT01IW-PASSVALUE.CUM-MIN - 60;
    end
end 

Function VHCT01IS-BRK-HRS () 
    CURR-SVC-HRS = 0;
    if (VHCT01IW-PASSVALUE.BRK-IN-HRS >=
     VHCT01IW-PASSVALUE.BRK-IN-HRS-MAX)
        move DIFF-HH to CURR-SVC-HRS withV60Compat;
        if (DIFF-MM > 29)
            CURR-SVC-HRS = CURR-SVC-HRS + 1;
        end
        CURR-SVC-HRS = VHCT01IW-PASSVALUE.BRK-IN-HRS - VHCT01IW-PASSVALUE.BRK-IN-HRS-MAX;
    else
        if (VHCT01IW-PASSVALUE.BRK-IN-HRS <
         VHCT01IW-PASSVALUE.BRK-IN-HRS-MAX)
            VHCT01IW-PASSVALUE.BRK-IN-HRS = VHCT01IW-PASSVALUE.BRK-IN-HRS + DIFF-HH;
            if (DIFF-MM > 29)
                VHCT01IW-PASSVALUE.BRK-IN-HRS = VHCT01IW-PASSVALUE.BRK-IN-HRS + 1;
            end
            if (VHCT01IW-PASSVALUE.BRK-IN-HRS >
             VHCT01IW-PASSVALUE.BRK-IN-HRS-MAX)
                CURR-SVC-HRS = VHCT01IW-PASSVALUE.BRK-IN-HRS - VHCT01IW-PASSVALUE.BRK-IN-HRS-MAX;
            end
        end
    end
end 

Function VHCT01IS-C-CAR ()
   
    VHCT01IW-TRIGGER.YES-SPLIT = "N";
    move DATE-END-CAR-REV-YY to WS-DATE-END-CAR-REV-YY withV60Compat;
    move DATE-END-CAR-REV-MM to WS-DATE-END-CAR-REV-MM withV60Compat;
    move DATE-END-CAR-REV-DD to WS-DATE-END-CAR-REV-DD withV60Compat;
    if (END-CAR-SW == "Y" &&
     VHCT01IW-PASSVALUE.WS-DATE-END-CAR-REV is numeric)
        VHCT01IW-TRIGGER.YES-SPLIT = "Y";
        VHCT01IS-SPLIT();
    else
        DATE-END-CAR-REV-X = VHCT01IW-PASSVALUE.DATE-END-CAR-REV;
        move DATE-END-CAR-REV-YY-X to WS-DATE-END-CAR-REV-YY withV60Compat;
        move DATE-END-CAR-REV-MM-X to WS-DATE-END-CAR-REV-MM withV60Compat;
        move DATE-END-CAR-REV-DD-X to WS-DATE-END-CAR-REV-DD withV60Compat;
        if (END-CAR-SW == "Y" &&
         VHCT01IW-PASSVALUE.WS-DATE-END-CAR-REV is numeric)
            VHCT01IS-SPLIT();
            VHCT01IW-TRIGGER.YES-SPLIT = "Y";
        else
            if (END-CAR-SW == "Y")
                VHCT01IW-PASSVALUE.END-CAR-HRS = VHCT01IW-PASSVALUE.END-CAR-HRS + DIFF-HH;
                VHCT01IW-PASSVALUE.END-CAR-MIN = VHCT01IW-PASSVALUE.END-CAR-MIN + DIFF-MM;
                if (VHCT01IW-PASSVALUE.END-CAR-MIN > 59)
                    VHCT01IW-PASSVALUE.END-CAR-HRS = VHCT01IW-PASSVALUE.END-CAR-HRS + 1;
                    VHCT01IW-PASSVALUE.END-CAR-MIN = VHCT01IW-PASSVALUE.END-CAR-MIN - 60;
                end
            end
            if (MID-CAR-SW == "Y")
                VHCT01IW-PASSVALUE.MID-CAR-HRS = VHCT01IW-PASSVALUE.MID-CAR-HRS + DIFF-HH;
                VHCT01IW-PASSVALUE.MID-CAR-MIN = VHCT01IW-PASSVALUE.MID-CAR-MIN + DIFF-MM;
                if (VHCT01IW-PASSVALUE.MID-CAR-MIN > 59)
                    VHCT01IW-PASSVALUE.MID-CAR-HRS = VHCT01IW-PASSVALUE.MID-CAR-HRS + 1;
                    VHCT01IW-PASSVALUE.MID-CAR-MIN = VHCT01IW-PASSVALUE.MID-CAR-MIN - 60;
                end
            end
        end
    end
end 

Function VHCT01IS-CAL1 () 
    END-CAR-SW = "Y";
    MID-CAR-SW = "N";
    if (VHCT01IW-PASSVALUE.CAR-TYPE-1 == "C1" ||
     VHCT01IW-PASSVALUE.CAR-TYPE-1 == "C2" ||
     VHCT01IW-PASSVALUE.CAR-TYPE-1 == "D1" ||
     VHCT01IW-PASSVALUE.CAR-TYPE-1 == "L1")
        VHCT01IW-PASSVALUE.END-CAR-HRS = CAR-NO-1-END-HRS;
        VHCT01IW-PASSVALUE.END-CAR-MIN = CAR-NO-1-END-MIN;
        VHCT01IW-PASSVALUE.MID-CAR-HRS = CAR-NO-1-MID-HRS;
        VHCT01IW-PASSVALUE.MID-CAR-MIN = CAR-NO-1-MID-MIN;
        VHCT01IW-PASSVALUE.DATE-END-CAR-REV = DATE-END-CAR-REV-1;
        VHCT01IW-PASSVALUE.TIME-END-CAR = TIME-END-CAR-1;
        VHCT01IS-C-CAR();
        CAR-NO-1-END-HRS = VHCT01IW-PASSVALUE.END-CAR-HRS;
        CAR-NO-1-END-MIN = VHCT01IW-PASSVALUE.END-CAR-MIN;
        CAR-NO-1-MID-HRS = VHCT01IW-PASSVALUE.MID-CAR-HRS;
        CAR-NO-1-MID-MIN = VHCT01IW-PASSVALUE.MID-CAR-MIN;
        VHCT01IW-PASSVALUE.BRK-IN-HRS = CAR-NO-1-BRK-HRS;
        VHCT01IW-PASSVALUE.BRK-IN-HRS-MAX = CAR-NO-1-MAX-BRK;
        VHCT01IS-BRK-HRS();
        CAR-NO-1-BRK-HRS = VHCT01IW-PASSVALUE.BRK-IN-HRS;
        
  
    else
        if (VHCT01IW-PASSVALUE.CAR-NO-1-WAR-IND == "Y")
            VHCT01IW-PASSVALUE.BRK-IN-HRS = CAR-NO-1-BRK-HRS;
            VHCT01IW-PASSVALUE.BRK-IN-HRS-MAX = CAR-NO-1-MAX-BRK;
            VHCT01IS-BRK-HRS();
            CAR-NO-1-BRK-HRS = VHCT01IW-PASSVALUE.BRK-IN-HRS;
            
  
        end
    end
    VHCT01IW-PASSVALUE.CUM-HRS = VHCT01IW-PASSVALUE.CAR-NO-1-CUM-HRS;
    VHCT01IW-PASSVALUE.CUM-MIN = VHCT01IW-PASSVALUE.CAR-NO-1-CUM-MIN;
    VHCT01IW-SVR-REC.CAR-NO-1-PRV-HRS = VHCT01IW-PASSVALUE.CAR-NO-1-CUM-HRS;
    VHCT01IW-SVR-REC.CAR-NO-1-PRV-MIN = VHCT01IW-PASSVALUE.CAR-NO-1-CUM-MIN;
    VHCT01IS-ACCU-TIME();
    VHCT01IW-PASSVALUE.CAR-NO-1-CUM-HRS = VHCT01IW-PASSVALUE.CUM-HRS;
    VHCT01IW-PASSVALUE.CAR-NO-1-CUM-MIN = VHCT01IW-PASSVALUE.CUM-MIN;
    VHCT01IW-PASSVALUE.HRS-TO-NEXT-PM = VHCT01IW-PASSVALUE.CAR-NO-1-NEXT-PM;
    VHCT01IW-PASSVALUE.HRS-FROM-LAST-PM = VHCT01IW-PASSVALUE.CAR-NO-1-FROM-PM;
    VHCT01IW-PASSVALUE.HRS-TO-NEXT-PM-MAX = VHCT01IW-PASSVALUE.CAR-NO-1-MAX-PM;
    VHCT01IS-PM-HRS();
    VHCT01IW-PASSVALUE.CAR-NO-1-NEXT-PM = VHCT01IW-PASSVALUE.HRS-TO-NEXT-PM;
    VHCT01IW-PASSVALUE.CAR-NO-1-FROM-PM = VHCT01IW-PASSVALUE.HRS-FROM-LAST-PM;
    VHCT01IW-PASSVALUE.VEH-STAT = VHCT01IW-PASSVALUE.CAR-NO-1-VEH-STAT;
    VHCT01IW-PASSVALUE.VEH-STAT-PREV = VHCT01IW-PASSVALUE.CAR-NO-1-VEH-STAT-PREV;
    VHCT01IW-PASSVALUE.CAR-NO-INCD = VHCT01IW-PASSVALUE.CAR-NO-1;
    VHCT01IW-PASSVALUE.HOME-YRD = VHCT01IW-PASSVALUE.CAR-NO-1-HOME-YRD;
    VHCT01IW-PASSVALUE.CAR-NO = VHCT01IW-PASSVALUE.CAR-NO-1;
    VHCT01IW-PASSVALUE.NO-GO-IND = "N";
    VHCT01IS-STATUS();
    VHCT01IW-PASSVALUE.CAR-NO-1-NO-GO = VHCT01IW-PASSVALUE.NO-GO-IND;
    if (VHCT01IW-PASSVALUE.STAT-CHG-SW == "Y")
        VHCT01IW-PASSVALUE.CAR-NO-1-STAT-CHG = "Y";
    else
        VHCT01IW-PASSVALUE.CAR-NO-1-STAT-CHG = "N";
    end
    VHCT01IW-PASSVALUE.CAR-NO-1-VEH-STAT = VHCT01IW-PASSVALUE.VEH-STAT;
    VHCT01IW-PASSVALUE.CAR-NO-1-VEH-STAT-PREV = VHCT01IW-PASSVALUE.VEH-STAT-PREV;
    VHCT01IW-PASSVALUE.CAR-NO-1-INCD-NO = VHCT016_DATA.INCD-NO;
    VHCT01IW-PASSVALUE.CAR-NO-1-INCD-TYPE = VHCT016_DATA.INCD-TYPE;
    VHCT01IW-PASSVALUE.CAR-NO-1-SYMP-CD = VHCT016_DATA.SYMP-CD;
  
    if (VHCT01IW-PASSVALUE.CAR-TYPE-1 == "C1" ||
     VHCT01IW-PASSVALUE.CAR-TYPE-1 == "C2" ||
     VHCT01IW-PASSVALUE.CAR-TYPE-1 == "D1" ||
     VHCT01IW-PASSVALUE.CAR-TYPE-1 == "L1")
        move CAR-NO-1-END-HRS-SVC to END-CAR-HRS-HIST withV60Compat;
        move CAR-NO-1-END-MIN-SVC to END-CAR-MIN-HIST withV60Compat;
        move CAR-NO-1-MID-HRS-SVC to MID-CAR-HRS-HIST withV60Compat;
        move CAR-NO-1-MID-MIN-SVC to MID-CAR-MIN-HIST withV60Compat;
        
  
  
        VHCT01IS-SVC-HIST();
        move END-CAR-HRS-HIST to CAR-NO-1-END-HRS-SVC withV60Compat;
        move END-CAR-MIN-HIST to CAR-NO-1-END-MIN-SVC withV60Compat;
        move MID-CAR-HRS-HIST to CAR-NO-1-MID-HRS-SVC withV60Compat;
        move MID-CAR-MIN-HIST to CAR-NO-1-MID-MIN-SVC withV60Compat;
        
  
  
    end
    VHCT01IW-SVR-REC.CURR-CAR-HRS = CAR-NO-1-CUR-HRS;
    VHCT01IW-SVR-REC.CURR-CAR-MIN = CAR-NO-1-CUR-MIN;
    VHCT01IS-SVC-HIT1();
    CAR-NO-1-CUR-HRS = VHCT01IW-SVR-REC.CURR-CAR-HRS;
    CAR-NO-1-CUR-MIN = VHCT01IW-SVR-REC.CURR-CAR-MIN;
end 

Function VHCT01IS-CAL10 () 
    END-CAR-SW = "Y";
    MID-CAR-SW = "N";
    if (VHCT01IW-PASSVALUE.CAR-TYPE-10 == "C1" ||
     VHCT01IW-PASSVALUE.CAR-TYPE-10 == "C2" ||
     VHCT01IW-PASSVALUE.CAR-TYPE-10 == "D1" ||
     VHCT01IW-PASSVALUE.CAR-TYPE-10 == "L1")
        VHCT01IW-PASSVALUE.END-CAR-HRS = CAR-NO-10-END-HRS;
        VHCT01IW-PASSVALUE.END-CAR-MIN = CAR-NO-10-END-MIN;
        VHCT01IW-PASSVALUE.MID-CAR-HRS = CAR-NO-10-MID-HRS;
        VHCT01IW-PASSVALUE.MID-CAR-MIN = CAR-NO-10-MID-MIN;
        VHCT01IW-PASSVALUE.DATE-END-CAR-REV = DATE-END-CAR-REV-10;
        VHCT01IW-PASSVALUE.TIME-END-CAR = TIME-END-CAR-10;
        VHCT01IS-C-CAR();
        CAR-NO-10-END-HRS = VHCT01IW-PASSVALUE.END-CAR-HRS;
        CAR-NO-10-END-MIN = VHCT01IW-PASSVALUE.END-CAR-MIN;
        CAR-NO-10-MID-HRS = VHCT01IW-PASSVALUE.MID-CAR-HRS;
        CAR-NO-10-MID-MIN = VHCT01IW-PASSVALUE.MID-CAR-MIN;
        VHCT01IW-PASSVALUE.BRK-IN-HRS = CAR-NO-10-BRK-HRS;
        VHCT01IW-PASSVALUE.BRK-IN-HRS-MAX = CAR-NO-10-MAX-BRK;
        VHCT01IS-BRK-HRS();
        CAR-NO-10-BRK-HRS = VHCT01IW-PASSVALUE.BRK-IN-HRS;
        
  
    else
        if (CAR-NO-10-WAR-IND == "Y")
            VHCT01IW-PASSVALUE.BRK-IN-HRS = CAR-NO-10-BRK-HRS;
            VHCT01IW-PASSVALUE.BRK-IN-HRS-MAX = CAR-NO-10-MAX-BRK;
            VHCT01IS-BRK-HRS();
            CAR-NO-10-BRK-HRS = VHCT01IW-PASSVALUE.BRK-IN-HRS;
            
  
