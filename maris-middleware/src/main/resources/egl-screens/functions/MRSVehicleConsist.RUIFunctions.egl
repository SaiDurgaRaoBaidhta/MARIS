Function VHCT01IS-OSRV-TIME () 
    VHCT01IW.TIME-INSRV-HH-Y = VHCT01IW-PASSVALUE.TIME-INSRV-X-HH;
    VHCT01IW.TIME-INSRV-MM-Y = VHCT01IW-PASSVALUE.TIME-INSRV-X-MM;
    VHCT01IW.TIME-OUTSRV-HH-Y = VHCT01IW.TIME-OUTSRV-HH-X;
    VHCT01IW.TIME-OUTSRV-MM-Y = VHCT01IW.TIME-OUTSRV-MM-X;
    if (TIME-OUTSRV-HH-Y >= 00 &&
     TIME-OUTSRV-HH-Y <= 02)
        TIME-OUTSRV-HH-Y = TIME-OUTSRV-HH-Y + 24;
    end
    if (TIME-INSRV-HH-Y >= 00 &&
     TIME-INSRV-HH-Y <= 02)
        TIME-INSRV-HH-Y = TIME-INSRV-HH-Y + 24;
    end
    if (TIME-OUTSRV-HH-Y < TIME-INSRV-HH-Y)
        VHCT01IW-TRIGGER.TIME-OUT-ERROR = "Y";
        VHCT01IW-TRIGGER.CON-ERROR = "Y";
        VHCT01IW-TRIGGER.TIME-OUT-ERR = "Y";
    else
        if (TIME-OUTSRV-HH-Y == TIME-INSRV-HH-Y)
            if (TIME-OUTSRV-MM-Y < TIME-INSRV-MM-Y)
                VHCT01IW-TRIGGER.TIME-OUT-ERROR = "Y";
                VHCT01IW-TRIGGER.CON-ERROR = "Y";
                VHCT01IW-TRIGGER.TIME-OUT-ERR = "Y";
            end
        end
    end
end 

Function VHCT01IS-OTIME () 
    VHCT01IS-CLEAR-CAR();
  
  
  
    VHCT01IW-PASSVALUE.TIME-INSRV = VHCT011_DATA.TIME-INSRV;
    
  
  
    VHCT01IS-RUN-TIME();
    VHCT01IS-VALD-CAR();
    VHCT01IS-UPD-CON();
end 

Function VHCT01IS-PM-HRS () 
    VHCT01IW-PASSVALUE.HRS-FROM-LAST-PM = VHCT01IW-PASSVALUE.HRS-FROM-LAST-PM + DIFF-HH;
    if (DIFF-MM > 29)
        VHCT01IW-PASSVALUE.HRS-FROM-LAST-PM = VHCT01IW-PASSVALUE.HRS-FROM-LAST-PM + 1;
    end
    VHCT01IW-PASSVALUE.HRS-TO-NEXT-PM = VHCT01IW-PASSVALUE.HRS-TO-NEXT-PM-MAX - VHCT01IW-PASSVALUE.HRS-FROM-LAST-PM;
end 

Function VHCT01IS-PROCESS () 
    VHCT01IS-CLEAR-MSG();
    VHCT01IS-CONV-TIME();
    VHCT01IS-VALID-YRD();
    VHCT01IS-VALID-MAD();
    if (VHCT01IW-TRIGGER.TIME-ERROR-X == "N" &&
     VHCT01IW-TRIGGER.YARD-ERROR == "N" &&
     VHCT01IW-TRIGGER.MADE-ERROR == "N")
        VHCT01IS-VALID-CON();
    end
end 

Function VHCT01IS-RUN-TIME ()
  
  
   
    VHCT01IW-PASSVALUE.WS-TIME-OUTSRV-HH = VHCT01IW.TIME-OUTSRV-HH;
    VHCT01IW-PASSVALUE.WS-TIME-OUTSRV-MM = VHCT01IW.TIME-OUTSRV-MM;
    VHCT01IW-PASSVALUE.WS-TIME-OUTSRV-SS = VHCT01IW.TIME-OUTSRV-SS;
    VHCT01IW-PASSVALUE.WS-TIME-INSRV-HH = VHCT01IW-PASSVALUE.TIME-INSRV-HH;
    VHCT01IW-PASSVALUE.WS-TIME-INSRV-MM = VHCT01IW-PASSVALUE.TIME-INSRV-MM;
    VHCT01IW-PASSVALUE.WS-TIME-INSRV-SS = VHCT01IW-PASSVALUE.TIME-INSRV-SS;
    if (VHCT01IW-PASSVALUE.WS-TIME-OUTSRV-HH <
     VHCT01IW-PASSVALUE.TIME-REV-START-HH)
        WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 24;
    else
        if (VHCT01IW-PASSVALUE.WS-TIME-OUTSRV-HH ==
         VHCT01IW-PASSVALUE.TIME-REV-START-HH && WS-TIME-OUTSRV-MM < TIME-REV-START-MM)
            WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 24;
        end
    end
    if (VHCT01IW-PASSVALUE.WS-TIME-INSRV-HH <
     VHCT01IW-PASSVALUE.TIME-REV-START-HH)
        WS-TIME-INSRV-HH = WS-TIME-INSRV-HH + 24;
    else
        if (VHCT01IW-PASSVALUE.WS-TIME-INSRV-HH ==
         VHCT01IW-PASSVALUE.TIME-REV-START-HH && WS-TIME-INSRV-MM < TIME-REV-START-MM)
            WS-TIME-INSRV-HH = WS-TIME-INSRV-HH + 24;
        end
    end
    if (VHCT01IW-PASSVALUE.WS-TIME-OUTSRV-MM <
     VHCT01IW-PASSVALUE.WS-TIME-INSRV-MM)
        WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM + 60;
        WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH - 1;
    end
    if (WS-TIME-OUTSRV-HH >= WS-TIME-INSRV-HH)
        DIFF-HH = WS-TIME-OUTSRV-HH - WS-TIME-INSRV-HH;
        DIFF-MM = WS-TIME-OUTSRV-MM - WS-TIME-INSRV-MM;
    else
        if (WS-TIME-OUTSRV-HH < WS-TIME-INSRV-HH)
            if (WS-TIME-OUTSRV-MM > 59)
                WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM - 60;
                WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 1;
            end
            if (WS-TIME-INSRV-MM < WS-TIME-OUTSRV-MM)
                WS-TIME-INSRV-MM = WS-TIME-INSRV-MM + 60;
                WS-TIME-INSRV-HH = WS-TIME-INSRV-HH - 1;
            end
            DIFF-HH = WS-TIME-OUTSRV-HH - WS-TIME-INSRV-HH;
            DIFF-MM = WS-TIME-OUTSRV-MM - WS-TIME-INSRV-MM;
            DIFF-HH = DIFF-HH * -1;
            DIFF-MM = DIFF-MM * -1;
        end
    end
    VHCT01IW-CON-MSG.CON-MSG-HH = DIFF-HH;
    VHCT01IW-CON-MSG.CON-MSG-MM = DIFF-MM;
end 

Function VHCT01IS-SPLIT () 
    VHCT01IS-SPLIT-TME();
    VHCT01IW-PASSVALUE.END-CAR-HRS = VHCT01IW-PASSVALUE.END-CAR-HRS + DIFF-HH-SPLIT-END;
    VHCT01IW-PASSVALUE.END-CAR-MIN = VHCT01IW-PASSVALUE.END-CAR-MIN + DIFF-MM-SPLIT-END;
    if (VHCT01IW-PASSVALUE.END-CAR-MIN > 59)
        VHCT01IW-PASSVALUE.END-CAR-HRS = VHCT01IW-PASSVALUE.END-CAR-HRS + 1;
        VHCT01IW-PASSVALUE.END-CAR-MIN = VHCT01IW-PASSVALUE.END-CAR-MIN - 60;
    end
    VHCT01IW-PASSVALUE.MID-CAR-HRS = VHCT01IW-PASSVALUE.MID-CAR-HRS + DIFF-HH-SPLIT-MID;
    VHCT01IW-PASSVALUE.MID-CAR-MIN = VHCT01IW-PASSVALUE.MID-CAR-MIN + DIFF-MM-SPLIT-MID;
    if (VHCT01IW-PASSVALUE.MID-CAR-MIN > 59)
        VHCT01IW-PASSVALUE.MID-CAR-HRS = VHCT01IW-PASSVALUE.MID-CAR-HRS + 1;
        VHCT01IW-PASSVALUE.MID-CAR-MIN = VHCT01IW-PASSVALUE.MID-CAR-MIN - 60;
    end
end 

Function VHCT01IS-SPLIT-TME ()
  
  
  
  
   
    VHCT01IW-PASSVALUE.WS-TIME-END-CAR-HH = VHCT01IW-PASSVALUE.TIME-END-CAR-HH;
    VHCT01IW-PASSVALUE.WS-TIME-END-CAR-MM = VHCT01IW-PASSVALUE.TIME-END-CAR-MM;
    VHCT01IW-PASSVALUE.WS-TIME-END-CAR-SS = VHCT01IW-PASSVALUE.TIME-END-CAR-SS;
  
  
  
    VHCT01IW-PASSVALUE.WS-TIME-INSRV-HH = VHCT01IW-PASSVALUE.TIME-INSRV-HH;
    VHCT01IW-PASSVALUE.WS-TIME-INSRV-MM = VHCT01IW-PASSVALUE.TIME-INSRV-MM;
    VHCT01IW-PASSVALUE.WS-TIME-INSRV-SS = VHCT01IW-PASSVALUE.TIME-INSRV-SS;
  
    if (VHCT01IW-PASSVALUE.WS-TIME-OUTSRV-MM <
     VHCT01IW-PASSVALUE.WS-TIME-END-CAR-MM)
        WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM + 60;
        WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH - 1;
    end
    if (WS-TIME-OUTSRV-HH >= WS-TIME-END-CAR-HH)
        DIFF-HH-SPLIT-END = WS-TIME-OUTSRV-HH - WS-TIME-END-CAR-HH;
        DIFF-MM-SPLIT-END = WS-TIME-OUTSRV-MM - WS-TIME-END-CAR-MM;
    else
        if (WS-TIME-OUTSRV-HH < WS-TIME-END-CAR-HH)
            if (WS-TIME-OUTSRV-MM > 59)
                WS-TIME-OUTSRV-MM = WS-TIME-OUTSRV-MM - 60;
                WS-TIME-OUTSRV-HH = WS-TIME-OUTSRV-HH + 1;
            end
            if (WS-TIME-END-CAR-MM < WS-TIME-OUTSRV-MM)
                WS-TIME-END-CAR-MM = WS-TIME-END-CAR-MM + 60;
                WS-TIME-END-CAR-HH = WS-TIME-END-CAR-HH - 1;
            end
            DIFF-HH-SPLIT-END = WS-TIME-OUTSRV-HH - WS-TIME-END-CAR-HH;
            DIFF-MM-SPLIT-END = WS-TIME-OUTSRV-MM - WS-TIME-END-CAR-MM;
            
  
  
        end
    end
  
  
  
  
  
  
    if (VHCT01IW-PASSVALUE.WS-TIME-END-CAR-MM <
     VHCT01IW-PASSVALUE.WS-TIME-INSRV-MM)
        WS-TIME-END-CAR-MM = WS-TIME-END-CAR-MM + 60;
        WS-TIME-END-CAR-HH = WS-TIME-END-CAR-HH - 1;
    end
  
    if (WS-TIME-END-CAR-HH >= WS-TIME-INSRV-HH)
  
        DIFF-HH-SPLIT-MID = WS-TIME-END-CAR-HH - WS-TIME-INSRV-HH;
  
        DIFF-MM-SPLIT-MID = WS-TIME-END-CAR-MM - WS-TIME-INSRV-MM;
    else
  
        if (WS-TIME-END-CAR-HH < WS-TIME-INSRV-HH)
            if (WS-TIME-INSRV-MM > 59)
                WS-TIME-INSRV-MM = WS-TIME-INSRV-MM - 60;
                WS-TIME-INSRV-HH = WS-TIME-INSRV-HH + 1;
            end
            if (WS-TIME-END-CAR-MM < WS-TIME-INSRV-MM)
                WS-TIME-END-CAR-MM = WS-TIME-END-CAR-MM + 60;
                WS-TIME-END-CAR-HH = WS-TIME-END-CAR-HH - 1;
            end
  
            DIFF-HH-SPLIT-MID = WS-TIME-END-CAR-HH - WS-TIME-INSRV-HH;
  
            DIFF-MM-SPLIT-MID = WS-TIME-END-CAR-MM - WS-TIME-INSRV-MM;
            DIFF-HH-SPLIT-END = DIFF-HH * -1;
            
  
        end
    end
end 

Function VHCT01IS-STATUS () 
    if (VHCT01IW-PASSVALUE.VEH-STAT == "ERROR")
        VHCT01IW-PASSVALUE.VEH-STAT = VHCT01IW-PASSVALUE.VEH-STAT-PREV;
        VHCT01IW-PASSVALUE.VEH-STAT-PREV = " ";
        VHCT01IW-PASSVALUE.STAT-CHG-SW = "Y";
    else
        if (VHCT01IW-PASSVALUE.VEH-STAT == "USABLE")
            VHCT01IS-INCD-STAT();
            VHCT01IW-PASSVALUE.VEH-STAT-PREV = VHCT01IW-PASSVALUE.VEH-STAT;
            VHCT01IW-PASSVALUE.VEH-STAT = "NO GO";
            VHCT01IW-PASSVALUE.STAT-CHG-SW = "Y";
            VHCT01IW-PASSVALUE.NO-GO-IND = "Y";
        else
            VHCT01IW-PASSVALUE.STAT-CHG-SW = "N";
            VHCT01IS-CHK-DVS();
        end
    end
end 

Function VHCT01IS-SVC-HIST ()
   
    if (VHCT01IW-TRIGGER.YES-SPLIT == "Y")
        END-CAR-HRS-HIST = END-CAR-HRS-HIST + DIFF-HH-SPLIT-END;
        END-CAR-MIN-HIST = END-CAR-MIN-HIST + DIFF-MM-SPLIT-END;
        if (END-CAR-MIN-HIST > 59)
            END-CAR-HRS-HIST = END-CAR-HRS-HIST + 1;
            END-CAR-MIN-HIST = END-CAR-MIN-HIST - 60;
        end
        MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + DIFF-HH-SPLIT-MID;
        MID-CAR-MIN-HIST = MID-CAR-MIN-HIST + DIFF-MM-SPLIT-MID;
        if (MID-CAR-MIN-HIST > 59)
            MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + 1;
            MID-CAR-MIN-HIST = MID-CAR-MIN-HIST - 60;
        end
    else
        if (END-CAR-SW == "Y")
            END-CAR-HRS-HIST = END-CAR-HRS-HIST + DIFF-HH;
            END-CAR-MIN-HIST = END-CAR-MIN-HIST + DIFF-MM;
            if (END-CAR-MIN-HIST > 59)
                END-CAR-HRS-HIST = END-CAR-HRS-HIST + 1;
                END-CAR-MIN-HIST = END-CAR-MIN-HIST - 60;
            end
        end
        if (MID-CAR-SW == "Y")
            MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + DIFF-HH;
            MID-CAR-MIN-HIST = MID-CAR-MIN-HIST + DIFF-MM;
            if (MID-CAR-MIN-HIST > 59)
                MID-CAR-HRS-HIST = MID-CAR-HRS-HIST + 1;
                MID-CAR-MIN-HIST = MID-CAR-MIN-HIST - 60;
            end
        end
    end
end 

Function VHCT01IS-SVC-HIT1 () 
    VHCT01IW-SVR-REC.CURR-CAR-HRS = VHCT01IW-SVR-REC.CURR-CAR-HRS + DIFF-HH;
    VHCT01IW-SVR-REC.CURR-CAR-MIN = VHCT01IW-SVR-REC.CURR-CAR-MIN + DIFF-MM;
    if (VHCT01IW-SVR-REC.CURR-CAR-MIN > 59)
        VHCT01IW-SVR-REC.CURR-CAR-HRS = VHCT01IW-SVR-REC.CURR-CAR-HRS + 1;
        VHCT01IW-SVR-REC.CURR-CAR-MIN = VHCT01IW-SVR-REC.CURR-CAR-MIN - 60;
    end
end 

Function VHCT01IS-TIME-MSG () 
    if (VHCT01IW-TRIGGER.TIME-NOT-NUMERIC == "Y")
        VHCT01IW-TIME-MSG.MSG-1 = "TIME OUT OF SERVICE SHOULD BE NUMERIC";
        VHCT01IW-TRIGGER.TIME-NOT-NUMERIC = " ";
    end
    if (VHCT01IW-TRIGGER.TIME-OUT-RANGE == "Y")
        VHCT01IW-TIME-MSG.MSG-1 = "TIME HOURS SHOULD BETWEEN 00-23, TIME MINUTES SHOULD BETWEEN 00-59";
        VHCT01IW-TRIGGER.TIME-OUT-RANGE = " ";
    end
    if (VHCT01IW-TRIGGER.TIME-ERROR == "Y")
        VHCT01IW-TIME-MSG.MSG-1 = "TIME OUT OF SERVICE SHOULD NOT BE BLANK";
        VHCT01IW-TRIGGER.TIME-ERROR = " ";
    end
    if (VHCT01IW-TRIGGER.TIME-OUT-ERROR == "Y")
        VHCT01IW-TIME-MSG.MSG-3 = "Out-of-Service time must be greater than In-Service time";
        VHCT01IW-TIME-MSG.MSG-3-XX-1 = VHCT01IW.TIME-INSRV-HH-Y;
        VHCT01IW-TIME-MSG.MSG-3-XX-2 = ":";
        VHCT01IW-TIME-MSG.MSG-3-XX-3 = VHCT01IW.TIME-INSRV-MM-Y;
        VHCT01IW-TIME-MSG.MSG-1 = VHCT01IW-TIME-MSG.MSG-3;
        VHCT01IW-TRIGGER.TIME-OUT-ERROR = " ";
    end
    if (VHCT01IW-TRIGGER.MADE-IN-ERROR-SW == "Y")
        VHCT01IW-TIME-MSG.MSG-1 = "MADE IN ERROR SHOULD BE Y OR N";
        VHCT01IW-TRIGGER.MADE-IN-ERROR-SW = " ";
    end
    if (VHCT01IW-TRIGGER.YARD-LOC-BLANK == "Y")
        VHCT01IW-TIME-MSG.MSG-1-XX = "-YARD INVALID";
        VHCT01IW-TIME-MSG.MSG-1-X = VHCT01IW.YARD-LOC;
        VHCT01IW-TRIGGER.YARD-LOC-BLANK = " ";
    end
end 

