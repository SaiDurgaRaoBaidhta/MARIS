            VHCM01IW-SVR-REC-R.CAR-NO-1-CUR-HRS = VHCM013_DATA.CURR-CAR-HRS-SRV[VHCM01IW-SVR-REC-R.COUNTER-H];
            VHCM01IW-SVR-REC-R.CAR-NO-1-CUR-MIN = VHCM013_DATA.CURR-CAR-MIN-SRV[VHCM01IW-SVR-REC-R.COUNTER-H];
            XXDATEW.DATE-MM-DD-YYYY = VHCM013_DATA.DATE-REV-SRV[VHCM01IW-SVR-REC-R.COUNTER-H];
