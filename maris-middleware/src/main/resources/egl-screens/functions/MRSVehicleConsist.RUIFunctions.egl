    VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM-MAX = VHCM01IW-PASSVALUE.CAR-NO-2-MAX-PM;
    VHCM01IS-PM-HRS();
    VHCM01IW-PASSVALUE.CAR-NO-2-NEXT-PM = VHCM01IW-PASSVALUE.HRS-TO-NEXT-PM;
    VHCM01IW-PASSVALUE.CAR-NO-2-FROM-PM = VHCM01IW-PASSVALUE.HRS-FROM-LAST-PM;
    VHCM01IW-PASSVALUE.VEH-STAT = VHCM01IW-PASSVALUE.CAR-NO-2-VEH-STAT;
    VHCM01IW-PASSVALUE.VEH-STAT-PREV = VHCM01IW-PASSVALUE.CAR-NO-2-VEH-STAT-PREV;
    VHCM01IW-PASSVALUE.CAR-NO-INCD = VHCM01IW-PASSVALUE.CAR-NO-2;
    VHCM01IW-PASSVALUE.HOME-YRD = VHCM01IW-PASSVALUE.CAR-NO-2-HOME-YRD;
    VHCM01IW-PASSVALUE.CAR-NO = VHCM01IW-PASSVALUE.CAR-NO-2;
    VHCM01IW-PASSVALUE.NO-GO-IND = "N";
    VHCM01IS-STATUS();
  
    if (VHCM01IW-PASSVALUE.PSEUDO-CAR-2-SW == "Y")
        if (VHCM01IW-PASSVALUE.VEH-STAT != "GO" &&
         VHCM01IW-PASSVALUE.VEH-STAT != "USABLE" &&
         VHCM01IW-PASSVALUE.VEH-STAT != "ERROR")
            VHCM01IW-STATUS.CAR-STATUS-2 = VHCM01IW-PASSVALUE.VEH-STAT;
            VHCM01IW-TRIGGER.CAR10-NO-GO = "Y";
            VHCM01IW-TRIGGER.CAR-ERROR = "Y";
            VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 2 PSEUDO VEH-STAT ERROR";
        end
    end
    VHCM01IW-PASSVALUE.CAR-NO-2-NO-GO = VHCM01IW-PASSVALUE.NO-GO-IND;
    if (VHCM01IW-PASSVALUE.STAT-CHG-SW == "Y")
        VHCM01IW-PASSVALUE.CAR-NO-2-STAT-CHG = "Y";
    else
        VHCM01IW-PASSVALUE.CAR-NO-2-STAT-CHG = "N";
    end
    VHCM01IW-PASSVALUE.CAR-NO-2-VEH-STAT = VHCM01IW-PASSVALUE.VEH-STAT;
    VHCM01IW-PASSVALUE.CAR-NO-2-VEH-STAT-PREV = VHCM01IW-PASSVALUE.VEH-STAT-PREV;
  
  
  
  
  
  
  
    if (VHCM01IW-PASSVALUE.CAR-TYPE-2 == "C1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-2 == "C2" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-2 == "D1" ||
     VHCM01IW-PASSVALUE.CAR-TYPE-2 == "L1")
        VHCM01IW-SVR-REC.END-CAR-HRS-HIST = VHCM01IW-SVR-REC.CAR-NO-2-END-HRS-SVC;
        VHCM01IW-SVR-REC.END-CAR-MIN-HIST = VHCM01IW-SVR-REC.CAR-NO-2-END-MIN-SVC;
        VHCM01IW-SVR-REC.MID-CAR-HRS-HIST = VHCM01IW-SVR-REC.CAR-NO-2-MID-HRS-SVC;
        VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.CAR-NO-2-MID-MIN-SVC;
        
  
  
        VHCM01IS-SVC-HIST();
        VHCM01IW-SVR-REC.CAR-NO-2-END-HRS-SVC = VHCM01IW-SVR-REC.END-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-2-END-MIN-SVC = VHCM01IW-SVR-REC.END-CAR-MIN-HIST;
        VHCM01IW-SVR-REC.CAR-NO-2-MID-HRS-SVC = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-2-MID-MIN-SVC = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST;
        
  
  
    end
    VHCM01IW-SVR-REC.CURR-CAR-HRS = VHCM01IW-SVR-REC.CAR-NO-2-CUR-HRS;
    VHCM01IW-SVR-REC.CURR-CAR-MIN = VHCM01IW-SVR-REC.CAR-NO-2-CUR-MIN;
    VHCM01IS-SVC-HIT1();
    VHCM01IW-SVR-REC.CAR-NO-2-CUR-HRS = VHCM01IW-SVR-REC.CURR-CAR-HRS;
    VHCM01IW-SVR-REC.CAR-NO-2-CUR-MIN = VHCM01IW-SVR-REC.CURR-CAR-MIN;

  
    VHCM01IW-PASSVALUE.CAR-NOT-EXIST = "N";
    VHCM015_CRIT.ORIENTATION-2 = " ";
    if (LAST-CAR-NO == 2)
        if (VHCM01IW-CAR.CAR-NO2 is numeric)
            if ((VHCM01IW-CAR.CAR-NO2 == VHCM01IW-CAR.CAR-NO1))
                VHCM01IW-TRIGGER.DUPL-CAR2 = "Y";
                VHCM01IW-TRIGGER.CAR-ERROR = "Y";
            else  
                if (VHCM01IW-PASSVALUE.END-CAR-SW == "Y")
                    if ((VHCM01IW-1.CAR-TYPE[2] == "C1" ||
                     VHCM01IW-1.CAR-TYPE[2] == "C2"  ||
                     VHCM01IW-1.CAR-TYPE[2] == "D1" ||
                     VHCM01IW-1.CAR-TYPE[2] == "L1") &&
                     (VHCM01IW-1.ATO-PRESENT-IND[2] != "Y"))
                        VHCM01IW-TRIGGER.TYPE-ERROR-CAR2 = "Y";
                        VHCM01IW-TRIGGER.CAR-ERROR = "Y";
                        VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 2 ATO PRESENT IND NOT = Y";
                    else
                        if (VHCM01IW-1.TRAIN-INCD-IND[2] == "Y")
                            VHCM01IW-TRIGGER.CAR2-NO-GO-TI = "Y";
                            VHCM01IW-TRIGGER.CAR-ERROR = "Y";
                            VHCM01IW-CON-MSG.CON-MSG-6-1 = "CAR NO 2 HAS TRAIN INCIDENT";
                            if (VHCM01IW-1.CAR-STAT == "NO GO")
                                VHCM01IW-STATUS.CAR-STATUS-2 = "NO TI";
                            else
                                VHCM01IW-STATUS.CAR-STATUS-2 = "GO TI";
                            end 
                        else
                            VHCM01IW-TRIGGER.CAR2-LOC-HI = "Y";
                            VHCM01IW-TRIGGER.CAR2-LOC-HI = "Y";
                        end
                    end
                end
            end
        end
    end
end 

Function VHCM01IS-CAL3 () 
