        end
    end
    VHCM01IW-PASSVALUE.CUM-HRS = VHCM01IW-PASSVALUE.CAR-NO-5-CUM-HRS;
    VHCM01IW-PASSVALUE.CUM-MIN = VHCM01IW-PASSVALUE.CAR-NO-5-CUM-MIN;
