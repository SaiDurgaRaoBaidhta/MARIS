end 

Function VHCT01IS-VALD-CAR () 
    if (LAST-CAR-NO-10 == "Y")
        VHCT01IS-CAL10();
        VHCT01IS-CAL9();
        VHCT01IS-CAL8();
        VHCT01IS-CAL7();
        VHCT01IS-CAL6();
        VHCT01IS-CAL5();
        VHCT01IS-CAL4();
        VHCT01IS-CAL3();
        VHCT01IS-CAL2();
        VHCT01IS-CAL1();
    else
        if (LAST-CAR-NO-9 == "Y")
            VHCT01IS-CAL9();
            VHCT01IS-CAL8();
            VHCT01IS-CAL7();
            VHCT01IS-CAL6();
            VHCT01IS-CAL5();
            VHCT01IS-CAL4();
            VHCT01IS-CAL3();
            VHCT01IS-CAL2();
            VHCT01IS-CAL1();
        else
            if (LAST-CAR-NO-8 == "Y")
                VHCT01IS-CAL8();
                VHCT01IS-CAL7();
                VHCT01IS-CAL6();
                VHCT01IS-CAL5();
                VHCT01IS-CAL4();
                VHCT01IS-CAL3();
                VHCT01IS-CAL2();
                VHCT01IS-CAL1();
            else
                if (LAST-CAR-NO-7 == "Y")
                    VHCT01IS-CAL7();
                    VHCT01IS-CAL6();
                    VHCT01IS-CAL5();
                    VHCT01IS-CAL4();
                    VHCT01IS-CAL3();
                    VHCT01IS-CAL2();
                    VHCT01IS-CAL1();
                else
                    if (LAST-CAR-NO-6 == "Y")
                        VHCT01IS-CAL6();
                        VHCT01IS-CAL5();
                        VHCT01IS-CAL4();
                        VHCT01IS-CAL3();
                        VHCT01IS-CAL2();
                        VHCT01IS-CAL1();
                    else
                        if (LAST-CAR-NO-5 == "Y")
                            VHCT01IS-CAL5();
                            VHCT01IS-CAL4();
                            VHCT01IS-CAL3();
                            VHCT01IS-CAL2();
                            VHCT01IS-CAL1();
                        else
                            if (LAST-CAR-NO-4 == "Y")
                                VHCT01IS-CAL4();
                                VHCT01IS-CAL3();
                                VHCT01IS-CAL2();
                                VHCT01IS-CAL1();
                            else
                                if (LAST-CAR-NO-3 == "Y")
                                    VHCT01IS-CAL3();
                                    VHCT01IS-CAL2();
                                    VHCT01IS-CAL1();
                                else
                                    if (LAST-CAR-NO-2 == "Y")
                                        VHCT01IS-CAL2();
                                        VHCT01IS-CAL1();
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHCT01IS-VALID-CON () 
    VHCT01IW-PASSVALUE.YES-CONTINUE = 0;
    VHCT01IW-PASSVALUE.NO-CONTINUE = 0;
    VHCT01IW-TRIGGER.CON-ERROR = "N";
    VHCT01IW-TRIGGER.CAR-ERROR = "N";
    if (VHCT01IW.CON-NO is numeric)
        if (VHCT01IW.CON-NO-X > 99 &&
         VHCT01IW.CON-NO-X < 1000)
  
            VHCT011_CRIT.CON-NO = VHCT01IW.CON-NO;
            try
                call "VHCT011"(XDCONTROL, VHCT011_CRIT, VHCT011_DATA);
            
            end
            if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
             (VHCT011_CRIT.NO-RECORD-FOUND == "N"))
                VHCT01IW-PASSVALUE.DATE-INSRV-REV = VHCT011_DATA.DATE-INSRV-REV;
                VHCT01IW-PASSVALUE.TIME-INSRV-X = VHCT011_DATA.TIME-INSRV;
  				
                if (VHCT011_DATA.CON-STAT == "OUT" ||
                 VHCT011_DATA.CON-STAT == "SWP")
                    VHCT01IW-TRIGGER.CON-NOT-INSRV = "Y";
                    VHCT01IW-TRIGGER.CON-ERROR = "Y";
                else
                    if (VHCT011_DATA.CON-STAT == "CAR" ||
                     VHCT011_DATA.CON-STAT == "CON")
                        VHCT01IW-TRIGGER.CON-TRBL = "Y";
                    else
                        if (VHCT011_DATA.CON-STAT == "SRV")
                            VHCT01IS-CKCO-IND();
  
  
                        else
                            VHCT01IW-TRIGGER.CON-STAT-ERROR = "Y";
                            VHCT01IW-TRIGGER.CON-ERROR = "Y";
                        end
                    end
                end
            else
                if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
                 (VHCT011_CRIT.NO-RECORD-FOUND == "Y"))
  
                    VHCT01IW-TRIGGER.CON-ERROR = "Y";
                    VHCT01IW-TRIGGER.CON-NOT-EXIST = "Y";
                end
            end
        else
            VHCT01IW-TRIGGER.CON-NUMERIC-ERR = "Y";
            VHCT01IW-TRIGGER.CON-ERROR = "Y";
        end
    else
        VHCT01IW-TRIGGER.CON-NUMERIC-ERR = "Y";
        VHCT01IW-TRIGGER.CON-ERROR = "Y";
    end
end 

Function VHCT01IS-VALID-MAD () 
    VHCT01IW-TRIGGER.MADE-ERROR = "N";
    if (VHCT01IW.MADE-IN-ERR-IND != "Y" &&
     VHCT01IW.MADE-IN-ERR-IND != "N")
        VHCT01IW-TRIGGER.MADE-IN-ERROR-SW = "Y";
        VHCT01IW-TRIGGER.MADE-ERROR = "Y";
    end
end 

Function VHCT01IS-VALID-TME () 
    move TIME-OUTSRV-HH to TIME-OUTSRV-HH-X withV60Compat;
    move TIME-OUTSRV-MM to TIME-OUTSRV-MM-X withV60Compat;
    move TIME-OUTSRV-HH to TIME-OUTSRV-HH-Y withV60Compat;
    move TIME-OUTSRV-MM to TIME-OUTSRV-MM-Y withV60Compat;
    if (VHCT01IW.TIME-OUTSRV-HH is numeric)
        if (VHCT01IW.TIME-OUTSRV-HH-X < 00 ||
         VHCT01IW.TIME-OUTSRV-HH-X > 23)
            VHCT01IW-TRIGGER.TIME-OUT-RANGE = "Y";
            VHCT01IW-TRIGGER.TIME-ERROR-X = "Y";
        else
            if (VHCT01IW.TIME-OUTSRV-MM is numeric)
                if (VHCT01IW.TIME-OUTSRV-MM-X < 00 ||
                 VHCT01IW.TIME-OUTSRV-MM-X > 59)
                    VHCT01IW-TRIGGER.TIME-OUT-RANGE = "Y";
                    VHCT01IW-TRIGGER.TIME-ERROR-X = "Y";
                end
            else
                VHCT01IW-TRIGGER.TIME-NOT-NUMERIC = "Y";
                VHCT01IW-TRIGGER.TIME-ERROR-X = "Y";
            end
        end
    else
        VHCT01IW-TRIGGER.TIME-NOT-NUMERIC = "Y";
        VHCT01IW-TRIGGER.TIME-ERROR-X = "Y";
    end
end 

Function VHCT01IS-VALID-YRD () 
    VHCT01IW-TRIGGER.WHERE-SW = "N";
    VHCT01IW-TRIGGER.YARD-ERROR = "N";
    if (VHCT01IW.YARD-LOC == " ")
        VHCT01IW-TRIGGER.YARD-LOC-BLANK = "Y";
        VHCT01IW-TRIGGER.YARD-ERROR = "Y";
    else
        YARD-COUNTER = 1;
        while (YARD-COUNTER <= NUM-YRD)
            if (VHCT01IW.YARD-LOC == VH01A01_DATA.YRD[YARD-COUNTER])
                VHCT01A_CRIT.YARD-LOC-DESC = VH01A01_DATA.YRD-DESC[YARD-COUNTER];
                VHCT01IW.WHERE-IS-CAR = "YRD";
                VHCT01IW-TRIGGER.WHERE-SW = "Y";
            end
            YARD-COUNTER = YARD-COUNTER + 1;
        end
        if (VHCT01IW-TRIGGER.WHERE-SW == "N")
            YARD-COUNTER = 1;
            while (YARD-COUNTER <= NUM-VEH-STN)
                if (VHCT01IW.YARD-LOC == VH01A01_DATA.VEH-LOC[YARD-COUNTER])
                    VHCT01A_CRIT.YARD-LOC-DESC = VH01A01_DATA.VEH-LOC-DESC[YARD-COUNTER];
                    VHCT01IW.WHERE-IS-CAR = "STN";
                    VHCT01IW-TRIGGER.WHERE-SW = "Y";
                end
                YARD-COUNTER = YARD-COUNTER + 1;
            end
        end
        if (VHCT01IW-TRIGGER.WHERE-SW == "N")
            YARD-COUNTER = 1;
            while (YARD-COUNTER <= NUM-STOR-TRK)
                if (VHCT01IW.YARD-LOC == VH01A01_DATA.STOR-TRK-LOC[YARD-COUNTER])
                    VHCT01A_CRIT.YARD-LOC-DESC = VH01A01_DATA.STOR-TRK-DESC[YARD-COUNTER];
                    VHCT01IW.WHERE-IS-CAR = "MLS";
                    VHCT01IW-TRIGGER.WHERE-SW = "Y";
                end
                YARD-COUNTER = YARD-COUNTER + 1;
            end
        end
        if (VHCT01IW-TRIGGER.WHERE-SW == "N")
            VHCT01IW-TRIGGER.YARD-LOC-BLANK = "Y";
            VHCT01IW-TRIGGER.YARD-ERROR = "Y";
        end
    end
end 

Function VHCY01IS-CLEAR () 
    set VHCY01W-MSG empty;
    set VHVM1A1_DATA empty;
    set VHVM1A2_DATA empty;
    set VHVM1A2_CRIT empty;
    set VHCY01W-CON empty;
    set VHCY1A4_DATA empty;
end 

Function VHCY01IS-CLEAR-X () 
    set VHVM1A1_DATA empty;
    set VHVM1A2_DATA empty;
    set VHVM1A2_CRIT empty;
    set VHCY01W-CON empty;
    set VHCY1A4_DATA empty;
end 

Function VHCY01IS-GET-CAR ()
  
  
  
  
  
  
  
  
  
  
  
  errMsg string =" 0 "; 
  car_no CHAR(4);
  
  
   
    set VHCY01W-CON empty;
    VHVM1A1_CRIT.GUI = "VHCY";
    if ( VHVM1A2_CRIT.CarText != " "  )
    	car_no = getCarNo(VHVM1A2_CRIT.CarText);
    	VHVM1A2_CRIT.CAR-NO = car_no;
    	VHVM1A1_CRIT.CarText = VHVM1A2_CRIT.CarText;
    	VHVM1A1_CRIT.CAR-NO = car_no;
    	VHVM1A1_DATA.CAR-NO = car_no;
    	VHVM1A1_DATA.CarText = VHVM1A2_CRIT.CarText;
    end
    	
    
    VHCY1A4_CRIT.CAR-NO = VHVM1A2_CRIT.CAR-NO;
    
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCY01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCY1A4";
    

  
    if (VHCY1A4_CRIT.CAR-NO != " ")
    
        try
            call "VHCY1A4"(XDCONTROL, VHCY1A4_CRIT, VHCY1A4_DATA);
        	
        end
    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100))
                if (VHCY1A4_DATA.CAR-TYPE == "D" ||
                 VHCY1A4_DATA.CAR-TYPE == "T" ||
                 VHCY1A4_DATA.CAR-TYPE == "M")
                    VHCY01W-MSG.MSG = "Car NOT moved.  Car type is not A,B,C";
                    return;
                else
                    if (
                     VHCY1A4_DATA.CAR-TYPE == "A2" ||
                     VHCY1A4_DATA.CAR-TYPE == "B2" ||
                     VHCY1A4_DATA.CAR-TYPE == "D1" ||
                     VHCY1A4_DATA.CAR-TYPE == "E1" ||
                     VHCY1A4_DATA.CAR-TYPE == "K1" ||
                     VHCY1A4_DATA.CAR-TYPE == "K2" ||
                     VHCY1A4_DATA.CAR-TYPE == "L1" ||
                     VHCY1A4_DATA.CAR-TYPE == "M1" )
	                     	if (vgLib.findStr(VHCY1A4_DATA.SOFT_VER, 1, 4, "$")>=0 )                    	 
	                     		VHVM1A2_CRIT.CarText = "$"+ strLib.clip(VHVM1A2_CRIT.CAR-NO, 0); 
	                     		VHVM1A1_DATA.CarText = "$" + VHVM1A2_CRIT.CarText; 
	                     	else 
	                     		VHVM1A1_DATA.CarText = VHVM1A2_DATA.CAR-NO;	     
	                     		VHVM1A2_CRIT.CarText = VHVM1A2_CRIT.CAR-NO;             		
	                     	end
                        if ((VHCY1A4_DATA.SHOP-LOC-IND == "Y" &&
                         VHCY1A4_DATA.TRANSFER-TRK-IND == "N") &&
                         (VHCY1A4_DATA.CURR-LOC != "SW"))
                            VHCY01W-CON.CURRENT-LOC = VHCY1A4_DATA.YRD-TRKG-YRD;
                            VHCY01W-TRIGGERS.DISABLE-UPDATE = "Y";
                            VHCY01W-MSG.MSG = "Car NOT moved.  Car in the shop, Please call Shop Foreworker";
                        else
                            if ((VHCY1A4_DATA.YRD-LOC-IND == "Y" &&
                             VHCY1A4_DATA.TRANSFER-TRK-IND == "N" &&
                             VHCY1A4_DATA.YRD-SUB-LOC != "T-95") &&
                             (VHCY1A4_DATA.CURR-LOC != "SW"))
                                VHCY01W-CON.CURRENT-LOC = VHCY1A4_DATA.YRD-TRKG-YRD;
                                VHCY01W-TRIGGERS.DISABLE-UPDATE = "Y";
                                VHCY01W-MSG.MSG = "Car NOT moved.  Car in the YRD, Please call TOWER Foreworker";
                            else
                                if (VHCY1A4_DATA.WHERE-IS-CAR != "CON" &&
                                 VHCY1A4_DATA.WHERE-IS-CAR != "SHP")
                                    VHCY01W-MSG.MSG = "Enter the Move To Yard or Location";
                                    VHCY01W-TRIGGERS.ENABLE-LOC = "Y";
                                    VHCY01W-TRIGGERS.ENABLE-UPDATE = "Y";
                                    VHCY01W-CON.CURRENT-LOC = VHCY1A4_DATA.CURR-LOC;
                                else
                                    VHCY01W-MSG.MSG = "The car is either IN SERVICE or IN THE SHOP and cannot be moved";
                                    if (VHCY1A4_DATA.WHERE-IS-CAR == "CON")
                                        set VHCY01W-CON empty; 
                                        VHCY01W-CON.CON-NO = VHCY1A4_DATA.CON-NO;
                                        VHCY01W-CON.DASH = "-";
                                        VHCY01W-CON.NO-N = VHCY1A4_DATA.DASH-NO;
                                        VHCY01W-CON.CURRENT-LOC = VHCY01W-CON.CON;
                                    end
                                    if (VHCY1A4_DATA.WHERE-IS-CAR == "SHP")
                                        VHCY01W-CON.CURRENT-LOC = VHCY1A4_DATA.CURR-LOC;
                                    end
                                end
                            end
                        end
                    end
                end
  
            else
                if (VHCY1A4_DATA.CURR-LOC != " " &&
                 VHCY1A4_DATA.YRD-SUB-LOC == " ")
                    VHCY01W-CON.CURRENT-LOC = VHCY1A4_DATA.CURR-LOC;
                    VHCY01W-TRIGGERS.ENABLE-LOC = "Y";
                    VHCY01W-TRIGGERS.ENABLE-UPDATE = "Y";
                else
                    VHCY01W-MSG.MSG = "Invaid Car";
        
        
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end 
            end
        end
    end
end 

Function VHCY01IS-GET-CAR-X ()
  
  
  
  
  
  
  
  
  
  
  

  
  

   
    NO-VALID = " ";
    VHVM1A1_CRIT.GUI = "VHCY";
    

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCY01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM1A2";
    

  

    
    try
        call "MRSVehicleMaintenance.VHVM1A2"(XDCONTROL, VHVM1A2_CRIT, VHVM1A2_DATA);
    
    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 &&
         (VHVM1A2_DATA.CAR-TYPE == "A2" ||
         VHVM1A2_DATA.CAR-TYPE == "B2" ||
         VHVM1A2_DATA.CAR-TYPE == "C1" ||
         VHVM1A2_DATA.CAR-TYPE == "C2" ||
         VHVM1A2_DATA.CAR-TYPE == "D1" ||
         VHVM1A2_DATA.CAR-TYPE == "E1" ||
         VHVM1A2_DATA.CAR-TYPE == "L1" ||
         VHVM1A2_DATA.CAR-TYPE == "M1" ||
         VHVM1A2_DATA.CAR-TYPE == "K1" ||
         VHVM1A2_DATA.CAR-TYPE == "K2"))
            if (VHVM1A2_DATA.WHERE-IS-CAR == "CON" ||
             VHVM1A2_DATA.WHERE-IS-CAR == "SHP")  
                VHCY01W-MSG.MSG = "The car is either IN SERVICE or IN THE SHOP and cannot be moved";
            end
            if (VHVM1A2_DATA.WHERE-IS-CAR == "CON")
                set VHCY01W-CON empty; 
                VHCY01W-CON.CON-NO = VHVM1A2_DATA.CON-NO;
                VHCY01W-CON.DASH = "-";
                VHCY01W-CON.NO-N = VHVM1A2_DATA.DASH-NO;
                VHCY01W-CON.CURRENT-LOC = VHCY01W-CON.CON;
                NO-VALID = "N";
                return;
            end
            if (VHVM1A2_DATA.WHERE-IS-CAR == "SHP")
                VHCY01W-CON.CURRENT-LOC = VHVM1A2_DATA.CURR-LOC;
                NO-VALID = "N";
                return;
            end

  
        else
            VHCY01W-MSG.MSG = "Invaid Car";
            NO-VALID = "N";
            return;
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

