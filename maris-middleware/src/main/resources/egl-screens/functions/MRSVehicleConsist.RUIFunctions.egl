Function VHSC01IS-DBPROCESS ()
  
  
   
    XXDATEW.DATE-MM-DD-YYYY = VHXREVA_DATA.REVENUE-DATE;
    XXDATEW.VAGen_FUNCTION = "YMD";
    MRSCommonCode.XXDATES-CONVERT();
    VHTS01W_DATA.REVENUE-DATE-DB2 = XXDATEW.DATE-YYYY-MM-DD;
    

  
    VHSC01IS-MOVE-VAL();
    VHSC01IS-LEFT-VAL(); 
                                   
    VHSC01IS-RIGHT-VAL(); 
                                   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHSC01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHSCX";

   
    try
        call "VHSCX"(XDCONTROL, VHSC01W-TEMP-REC);
    
    end
    MRSCommonCode.XXA0IS-CHECK_EXT();
    if (XXEXT_CALL_Level77Items.URC == 0)
        if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
         VHSC01W-TEMP-REC.DBPROCESS-IND == "Y")
            VHSC01W-MSG.MSG-1 = "Consist ";
            VHSC01W-MSG.MSG-2 = VHSC01W-TEMP-REC.CON-NO;
            VHSC01W-MSG.MSG-3 = "-";
            VHSC01W-MSG.MSG-4 = VHSC01W-TEMP-REC.DASH-NO;
            VHSC01W-MSG.MSG-5 = " has been successfully split into consist ";
            VHSC01W-MSG.MSG-6 = VHSC01W-TEMP-REC.LEFT-CON-NO;
            VHSC01W-MSG.MSG-7 = "-";
            VHSC01W-MSG.MSG-8 = VHSC01W-TEMP-REC.LEFT-DASH-NO;
            VHSC01W-MSG.MSG-9 = " and consist ";
            VHSC01W-MSG.MSG-10 = VHSC01W-TEMP-REC.RIGHT-CON-NO;
            VHSC01W-MSG.MSG-11 = "-";
            VHSC01W-MSG.MSG-12 = VHSC01W-TEMP-REC.RIGHT-DASH-NO;
        else
            VHSC01IS-CHK-ERROR();
        end
        VHSC01W-TRIGGER.DISABLE-UPDATE = "Y";
    end
end 

