Function VHTR01IS-BLANK-CAR () 
    VHTR01IW-TRIGGER.ENABLE-RECONFIG = "Y";
    set VHTR01IW-LEFT-CON empty;
    set VHTR01IW-RIGHT-CON empty;
    
    if (VHTR01IW.SERVICE-ACTION-IDX == 2)
        VHTR01IS-BLANK-CA1();
    else
        VHTR01IS-BLANK-CA2();
    end
end 

Function VHTR01IS-BRK-HRS () 
    CURR-SVC-HRS = 0;
    if (VHTR01IW-PASSVALUE.BRK-IN-HRS >=
     VHTR01IW-PASSVALUE.BRK-IN-HRS-MAX)
        move DIFF-HH to CURR-SVC-HRS withV60Compat;
        if (DIFF-MM > 29)
            CURR-SVC-HRS = CURR-SVC-HRS + 1;
        end
        CURR-SVC-HRS = VHTR01IW-PASSVALUE.BRK-IN-HRS - VHTR01IW-PASSVALUE.BRK-IN-HRS-MAX;
    else
        if (VHTR01IW-PASSVALUE.BRK-IN-HRS <
         VHTR01IW-PASSVALUE.BRK-IN-HRS-MAX)
            VHTR01IW-PASSVALUE.BRK-IN-HRS = VHTR01IW-PASSVALUE.BRK-IN-HRS + DIFF-HH;
            if (DIFF-MM > 29)
                VHTR01IW-PASSVALUE.BRK-IN-HRS = VHTR01IW-PASSVALUE.BRK-IN-HRS + 1;
            end
            if (VHTR01IW-PASSVALUE.BRK-IN-HRS >
             VHTR01IW-PASSVALUE.BRK-IN-HRS-MAX)
                CURR-SVC-HRS = VHTR01IW-PASSVALUE.BRK-IN-HRS - VHTR01IW-PASSVALUE.BRK-IN-HRS-MAX;
            end
        end
    end
end 

Function VHTR01IS-BUILD-UP () 
    if (VHTR01IW.SERVICE-ACTION-IDX == 1)
        VHTR016_CRIT.BUILD-UP-SW = "1";
    else
        VHTR016_CRIT.BUILD-UP-SW = " ";
    end
end 

Function VHTR01IS-C-CAR ()
   
    VHTR01IW-TRIGGER.YES-SPLIT = "N";
    move DATE-END-CAR-REV-YY to WS-DATE-END-CAR-REV-YY withV60Compat;
    move DATE-END-CAR-REV-MM to WS-DATE-END-CAR-REV-MM withV60Compat;
    move DATE-END-CAR-REV-DD to WS-DATE-END-CAR-REV-DD withV60Compat;
    if (END-CAR-SW == "Y" &&
     VHTR01IW-PASSVALUE.WS-DATE-END-CAR-REV is numeric)
        VHTR01IW-TRIGGER.YES-SPLIT = "Y";
        VHTR01IS-SPLIT();
    else
        DATE-END-CAR-REV-X = VHTR01IW-PASSVALUE.DATE-END-CAR-REV;
        move DATE-END-CAR-REV-YY-X to WS-DATE-END-CAR-REV-YY withV60Compat;
        move DATE-END-CAR-REV-MM-X to WS-DATE-END-CAR-REV-MM withV60Compat;
        move DATE-END-CAR-REV-DD-X to WS-DATE-END-CAR-REV-DD withV60Compat;
        if (END-CAR-SW == "Y" &&
         VHTR01IW-PASSVALUE.WS-DATE-END-CAR-REV is numeric)
            VHTR01IS-SPLIT();
            VHTR01IW-TRIGGER.YES-SPLIT = "Y";
        else
            if (END-CAR-SW == "Y")
                VHTR01IW-PASSVALUE.END-CAR-HRS = VHTR01IW-PASSVALUE.END-CAR-HRS + DIFF-HH;
                VHTR01IW-PASSVALUE.END-CAR-MIN = VHTR01IW-PASSVALUE.END-CAR-MIN + DIFF-MM;
                if (VHTR01IW-PASSVALUE.END-CAR-MIN > 59)
                    VHTR01IW-PASSVALUE.END-CAR-HRS = VHTR01IW-PASSVALUE.END-CAR-HRS + 1;
                    VHTR01IW-PASSVALUE.END-CAR-MIN = VHTR01IW-PASSVALUE.END-CAR-MIN - 60;
                end
            end
            if (MID-CAR-SW == "Y")
                VHTR01IW-PASSVALUE.MID-CAR-HRS = VHTR01IW-PASSVALUE.MID-CAR-HRS + DIFF-HH;
                VHTR01IW-PASSVALUE.MID-CAR-MIN = VHTR01IW-PASSVALUE.MID-CAR-MIN + DIFF-MM;
                if (VHTR01IW-PASSVALUE.MID-CAR-MIN > 59)
                    VHTR01IW-PASSVALUE.MID-CAR-HRS = VHTR01IW-PASSVALUE.MID-CAR-HRS + 1;
                    VHTR01IW-PASSVALUE.MID-CAR-MIN = VHTR01IW-PASSVALUE.MID-CAR-MIN - 60;
                end
            end
        end
    end
end 

Function VHTR01IS-CAL1 () 
    END-CAR-SW = "Y";
    MID-CAR-SW = "N";
    if (VHTR01IW-PASSVALUE.CAR-TYPE-1 == "C1" ||
     VHTR01IW-PASSVALUE.CAR-TYPE-1 == "C2" ||
     VHTR01IW-PASSVALUE.CAR-TYPE-1 == "D1" ||
     VHTR01IW-PASSVALUE.CAR-TYPE-1 == "L1")
        VHTR01IW-PASSVALUE.END-CAR-HRS = CAR-NO-1-END-HRS;
        VHTR01IW-PASSVALUE.END-CAR-MIN = CAR-NO-1-END-MIN;
        VHTR01IW-PASSVALUE.MID-CAR-HRS = CAR-NO-1-MID-HRS;
        VHTR01IW-PASSVALUE.MID-CAR-MIN = CAR-NO-1-MID-MIN;
        VHTR01IW-PASSVALUE.DATE-END-CAR-REV = DATE-END-CAR-REV-1;
        VHTR01IW-PASSVALUE.TIME-END-CAR = TIME-END-CAR-1;
        VHTR01IS-C-CAR();
        CAR-NO-1-END-HRS = VHTR01IW-PASSVALUE.END-CAR-HRS;
        CAR-NO-1-END-MIN = VHTR01IW-PASSVALUE.END-CAR-MIN;
        CAR-NO-1-MID-HRS = VHTR01IW-PASSVALUE.MID-CAR-HRS;
        CAR-NO-1-MID-MIN = VHTR01IW-PASSVALUE.MID-CAR-MIN;
        VHTR01IW-PASSVALUE.BRK-IN-HRS = CAR-NO-1-BRK-HRS;
        VHTR01IW-PASSVALUE.BRK-IN-HRS-MAX = CAR-NO-1-MAX-BRK;
        VHTR01IS-BRK-HRS();
        CAR-NO-1-BRK-HRS = VHTR01IW-PASSVALUE.BRK-IN-HRS;
        
  
    else
        if (VHTR01IW-PASSVALUE.CAR-NO-1-WAR-IND == "Y")
            VHTR01IW-PASSVALUE.BRK-IN-HRS = CAR-NO-1-BRK-HRS;
            VHTR01IW-PASSVALUE.BRK-IN-HRS-MAX = CAR-NO-1-MAX-BRK;
            VHTR01IS-BRK-HRS();
            CAR-NO-1-BRK-HRS = VHTR01IW-PASSVALUE.BRK-IN-HRS;
            
  
        end
    end
    VHTR01IW-PASSVALUE.CUM-HRS = VHTR01IW-PASSVALUE.CAR-NO-1-CUM-HRS;
    VHTR01IW-PASSVALUE.CUM-MIN = VHTR01IW-PASSVALUE.CAR-NO-1-CUM-MIN;
    VHTR01IW-SVR-REC.CAR-NO-1-PRV-HRS = VHTR01IW-PASSVALUE.CAR-NO-1-CUM-HRS;
    VHTR01IW-SVR-REC.CAR-NO-1-PRV-MIN = VHTR01IW-PASSVALUE.CAR-NO-1-CUM-MIN;
    VHTR01IS-ACCU-TIME();
    VHTR01IW-PASSVALUE.CAR-NO-1-CUM-HRS = VHTR01IW-PASSVALUE.CUM-HRS;
    VHTR01IW-PASSVALUE.CAR-NO-1-CUM-MIN = VHTR01IW-PASSVALUE.CUM-MIN;
    VHTR01IW-PASSVALUE.HRS-TO-NEXT-PM = VHTR01IW-PASSVALUE.CAR-NO-1-NEXT-PM;
    VHTR01IW-PASSVALUE.HRS-FROM-LAST-PM = VHTR01IW-PASSVALUE.CAR-NO-1-FROM-PM;
    VHTR01IW-PASSVALUE.HRS-TO-NEXT-PM-MAX = VHTR01IW-PASSVALUE.CAR-NO-1-MAX-PM;
    VHTR01IS-PM-HRS();
    VHTR01IW-PASSVALUE.CAR-NO-1-NEXT-PM = VHTR01IW-PASSVALUE.HRS-TO-NEXT-PM;
    VHTR01IW-PASSVALUE.CAR-NO-1-FROM-PM = VHTR01IW-PASSVALUE.HRS-FROM-LAST-PM;
    VHTR01IW-PASSVALUE.VEH-STAT = VHTR01IW-PASSVALUE.CAR-NO-1-VEH-STAT;
    VHTR01IW-PASSVALUE.VEH-STAT-PREV = VHTR01IW-PASSVALUE.CAR-NO-1-VEH-STAT-PREV;
    VHTR01IW-PASSVALUE.CAR-NO-INCD = VHTR01IW-PASSVALUE.CAR-NO-1;
    VHTR01IW-PASSVALUE.HOME-YRD = VHTR01IW-PASSVALUE.CAR-NO-1-HOME-YRD;
    VHTR01IW-PASSVALUE.CAR-NO = VHTR01IW-PASSVALUE.CAR-NO-1;
    VHTR01IW-PASSVALUE.NO-GO-IND = "N";
    VHTR01IS-STATUS();
