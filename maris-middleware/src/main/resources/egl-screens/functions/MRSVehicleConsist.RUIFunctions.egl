    else
        if (VHCM01IW-PASSVALUE.CAR-NO-5-WAR-IND == "Y")
            VHCM01IW-PASSVALUE.BRK-IN-HRS = VHCM01IW-PASSVALUE.CAR-NO-5-BRK-HRS;
            VHCM01IW-PASSVALUE.BRK-IN-HRS-MAX = VHCM01IW-PASSVALUE.CAR-NO-5-MAX-BRK;
            VHCM01IS-BRK-HRS();
