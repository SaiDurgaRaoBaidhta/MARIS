Function VHMT01IS-MSG-RT ()
   
    MSG-BYTE-COUNT = 1;
    MSG-BYTE-COUNT-X = MSG-BYTE-COUNT-X + 1;
    if (MSG-BYTE-COUNT-X > 1 && MSG-BYTE-COUNT-X <= 99)
        VHMT01IW-WS-MSG.MESSAGES[MSG-BYTE-COUNT-X] = " ";
        MSG-BYTE-COUNT-X = MSG-BYTE-COUNT-X + 1;
        VHMT01IW-WS-MSG.MESSAGES[MSG-BYTE-COUNT-X] = " ";
        MSG-BYTE-COUNT-X = MSG-BYTE-COUNT-X + 1;
    end
    if (MSG-BYTE-COUNT-X < 99)
        while ((VHMT01IW-WS-MSG.MSG-BYTE-COUNT <=
         VHMT01IW-WS-MSG.MSG-LAST-BYTE) &&
         (MSG-BYTE-COUNT-X <= 99))
            VHMT01IW-WS-MSG.MESSAGES[MSG-BYTE-COUNT-X] = VHMT01IW-WS-MSG.MESSAGES-X[MSG-BYTE-COUNT];
            MSG-BYTE-COUNT = MSG-BYTE-COUNT + 1;
            MSG-BYTE-COUNT-X = MSG-BYTE-COUNT-X + 1;
        end
    end
end 

