        VHCM01IW-SVR-REC.MID-CAR-MIN-HIST = VHCM01IW-SVR-REC.CAR-NO-4-MID-MIN-SVC;
        
  
  
        VHCM01IS-SVC-HIST();
        VHCM01IW-SVR-REC.CAR-NO-4-END-HRS-SVC = VHCM01IW-SVR-REC.END-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-4-END-MIN-SVC = VHCM01IW-SVR-REC.END-CAR-MIN-HIST;
        VHCM01IW-SVR-REC.CAR-NO-4-MID-HRS-SVC = VHCM01IW-SVR-REC.MID-CAR-HRS-HIST;
        VHCM01IW-SVR-REC.CAR-NO-4-MID-MIN-SVC = VHCM01IW-SVR-REC.MID-CAR-MIN-HIST;
        
  
  
    end
    VHCM01IW-SVR-REC.CURR-CAR-HRS = VHCM01IW-SVR-REC.CAR-NO-4-CUR-HRS;
    VHCM01IW-SVR-REC.CURR-CAR-MIN = VHCM01IW-SVR-REC.CAR-NO-4-CUR-MIN;
    VHCM01IS-SVC-HIT1();
    VHCM01IW-SVR-REC.CAR-NO-4-CUR-HRS = VHCM01IW-SVR-REC.CURR-CAR-HRS;
    VHCM01IW-SVR-REC.CAR-NO-4-CUR-MIN = VHCM01IW-SVR-REC.CURR-CAR-MIN;

  
    VHCM01IW-PASSVALUE.CAR-NOT-EXIST = "N";
    VHCM015_CRIT.ORIENTATION-4 = " ";
    if (LAST-CAR-NO == 4)
        if (VHCM01IW-CAR.CAR-NO4 is numeric)
            if ((VHCM01IW-CAR.CAR-NO4 == VHCM01IW-CAR.CAR-NO1) ||
             (VHCM01IW-CAR.CAR-NO4 == VHCM01IW-CAR.CAR-NO2) ||
             (VHCM01IW-CAR.CAR-NO4 == VHCM01IW-CAR.CAR-NO-3))
                VHCM01IW-TRIGGER.DUPL-CAR4 = "Y";
                VHCM01IW-TRIGGER.CAR-ERROR = "Y";
            else
