Function VHSC01IS-LEFT-CON ()
  
  

   
    VHSC01W-MSG.MSG = " ";
    VHSC01W_DATA.LEFT-CON-OK = "N";
    if (VHSC01W_DATA.LEFT-CON-NO != " ")
    
        VHSCY_CRIT.CON-NO = VHSC01W_DATA.LEFT-CON-NO;
        try
            call "VHSCY"(XDCONTROL, VHSCY_CRIT);
        
        end
        if (XDCONTROL.UROWCNT == 1)

        else
            if (XDCONTROL.URC == 100)
                VHSC01W-MSG.MSG = "Entered Left Consist No does not exist in the database.";
                VHSC01W-TRIGGER.LEFTCON-SETFOCUS = "Y";
                return;
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        end
        ENABLE-DISPCONSIST = "Y";
        if (VHSC01W_DATA.LEFT-CON-NO != VHSC01W_DATA.CON-NO)
            VHSC01W_DATA.FOUND-DATA = "N";
            VHXCONB_CRIT.CON-NO = VHSC01W_DATA.LEFT-CON-NO;
            VHXCONB_CRIT.USE-DASH-NO = "N";
            VHSC01IS-GET-CONS();
            if (VHSC01W_DATA.FOUND-DATA == "Y")
                VHSC01W-MSG.MSG = "You entered a Left Consist No that is Already in Service";
                VHSC01W-TRIGGER.LEFTCON-SETFOCUS = "Y";
            else
        
                VHSC01W_DATA.LEFT-CON-OK = "Y";
                VHSC01W_DATA.LEFT-DASH-NO = VHTS1A9_DATA.MAX-DASH-NO + 1;
            end 
        else
      
            VHSC01W_DATA.LEFT-CON-OK = "Y";
            VHSC01W_DATA.LEFT-DASH-NO = VHSC01W_DATA.DASH-NO + 1;
        end
        if (VHSC01W_DATA.LEFT-CON-OK == "Y")
            VHSC01W-TRIGGER.RUN-RIGHT-CON = "Y";
        end
    else
        VHSC01W-MSG.MSG = "Left Consist No cannot be blank";
        DISABLE-DISPCONSIST = "Y";
        LEFTCON-SETFOCUS = "Y";
    end
end 

Function VHSC01IS-LEFT-VAL ()
    
    LOOP-INDEX = 1;
    VHSC01W-TEMP-REC.LEFT-CON-STAT = "SRV";
    while (LOOP-INDEX <= VHSC01W-TEMP-REC.LEFT-CON-SIZE)
        if (LOOP-INDEX == 1)
            VHSC01W-TEMP-REC.LEFT-CAR-NO[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-NO-1;
            VHSC01W-TEMP-REC.LEFT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORIENT1;
            VHSC01W-TEMP-REC.LEFT-CAR-ORDER[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORDER1;
        else
            if (LOOP-INDEX == 2)
                VHSC01W-TEMP-REC.LEFT-CAR-NO[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-NO-2;
                VHSC01W-TEMP-REC.LEFT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORIENT2;
                VHSC01W-TEMP-REC.LEFT-CAR-ORDER[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORDER2;
            else
                if (LOOP-INDEX == 3)
                    VHSC01W-TEMP-REC.LEFT-CAR-NO[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-NO-3;
                    VHSC01W-TEMP-REC.LEFT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORIENT3;
                    VHSC01W-TEMP-REC.LEFT-CAR-ORDER[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORDER3;
                else
                    if (LOOP-INDEX == 4)
                        VHSC01W-TEMP-REC.LEFT-CAR-NO[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-NO-4;
                        VHSC01W-TEMP-REC.LEFT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORIENT4;
                        VHSC01W-TEMP-REC.LEFT-CAR-ORDER[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORDER4;
                    else
                        if (LOOP-INDEX == 5)
                            VHSC01W-TEMP-REC.LEFT-CAR-NO[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-NO-5;
                            VHSC01W-TEMP-REC.LEFT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORIENT5;
                            VHSC01W-TEMP-REC.LEFT-CAR-ORDER[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORDER5;
                        else
                            if (LOOP-INDEX == 6)
                                VHSC01W-TEMP-REC.LEFT-CAR-NO[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-NO-6;
                                VHSC01W-TEMP-REC.LEFT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORIENT6;
                                VHSC01W-TEMP-REC.LEFT-CAR-ORDER[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORDER6;
                            else
                                if (LOOP-INDEX == 7)
                                    VHSC01W-TEMP-REC.LEFT-CAR-NO[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-NO-7;
                                    VHSC01W-TEMP-REC.LEFT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORIENT7;
                                    VHSC01W-TEMP-REC.LEFT-CAR-ORDER[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORDER7;
                                else
                                    if (LOOP-INDEX == 8)
                                        VHSC01W-TEMP-REC.LEFT-CAR-NO[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-NO-8;
                                        VHSC01W-TEMP-REC.LEFT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORIENT8;
                                        VHSC01W-TEMP-REC.LEFT-CAR-ORDER[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORDER8;
                                    else
                                        if (LOOP-INDEX == 9)
                                            VHSC01W-TEMP-REC.LEFT-CAR-NO[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-NO-9;
                                            VHSC01W-TEMP-REC.LEFT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORIENT9;
                                            VHSC01W-TEMP-REC.LEFT-CAR-ORDER[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORDER9;
                                        else
                                            if (LOOP-INDEX == 10)
                                                VHSC01W-TEMP-REC.LEFT-CAR-NO[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-NO-10;
                                                VHSC01W-TEMP-REC.LEFT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORIENT10;
                                                VHSC01W-TEMP-REC.LEFT-CAR-ORDER[LOOP-INDEX] = VHSC01IW-CON-LIST.CAR-ORDER10;
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if (VHSC01W-TEMP-REC.LEFT-CON-STAT == "SRV")
            VHCI01B_DATA.CAR-NO = VHSC01W-TEMP-REC.LEFT-CAR-NO[LOOP-INDEX];
            try
                call "MRSVehicleIncident.VHCI01B"(XDCONTROL, VHCI01B_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                if (VHCI01B_DATA.VEH-STAT == "NO GO")
                    VHSC01W-TEMP-REC.LEFT-CON-STAT = "CAR";
                end
            end
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
end 

