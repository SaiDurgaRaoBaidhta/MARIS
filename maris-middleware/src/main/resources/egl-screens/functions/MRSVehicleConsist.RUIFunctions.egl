Function VHSC01IS-REV-TRN5 () 
    VHSC01IW-PASSVALUE.RIGHT-ORIENTATION = " ";
    VHSC01IW-PASSVALUE.LEFT-ORIENTATION = " ";
    if (VHTS2A2_DATA.CAR-TYPE == "C1" ||
     VHTS2A2_DATA.CAR-TYPE == "C2")
  
        if (VHSC01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHSC01IW-PASSVALUE.CAR-ORIENT == ")")
                VHSC01IW-PASSVALUE.CAR-ORIENT = "(";
                VHSC01IW-PASSVALUE.LEFT-ORIENTATION = "(";
            else
                VHSC01IW-PASSVALUE.CAR-ORIENT = ")";
                VHSC01IW-PASSVALUE.RIGHT-ORIENTATION = ")";
            end
        end
    end
    if (VHTS2A2_DATA.CAR-TYPE == "A2")
  		
        if (VHSC01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHSC01IW-PASSVALUE.CAR-ORIENT == ">")
                VHSC01IW-PASSVALUE.CAR-ORIENT = "<";
                VHSC01IW-PASSVALUE.LEFT-ORIENTATION = "<";
            else
                VHSC01IW-PASSVALUE.CAR-ORIENT = ">";
                VHSC01IW-PASSVALUE.RIGHT-ORIENTATION = ">";
            end
        end
    end
    if (VHTS2A2_DATA.CAR-TYPE == "B2")
  		
        if (VHSC01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHSC01IW-PASSVALUE.CAR-ORIENT == "o")
                VHSC01IW-PASSVALUE.CAR-ORIENT = "O";
                VHSC01IW-PASSVALUE.LEFT-ORIENTATION = "O";
            else
                VHSC01IW-PASSVALUE.CAR-ORIENT = "o";
                VHSC01IW-PASSVALUE.RIGHT-ORIENTATION = "o";
            end
        end
    end  
    if (VHTS2A2_DATA.CAR-TYPE == "D1")
        if (VHSC01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHSC01IW-PASSVALUE.CAR-ORIENT == "V")
                VHSC01IW-PASSVALUE.CAR-ORIENT = "v";
                VHSC01IW-PASSVALUE.LEFT-ORIENTATION = "v";
            else
                VHSC01IW-PASSVALUE.CAR-ORIENT = "V";
                VHSC01IW-PASSVALUE.RIGHT-ORIENTATION = "V";
            end
        end
    end
        if (VHTS2A2_DATA.CAR-TYPE == "L1")
        if (VHSC01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHSC01IW-PASSVALUE.CAR-ORIENT == "L")
                VHSC01IW-PASSVALUE.CAR-ORIENT = "l";
                VHSC01IW-PASSVALUE.LEFT-ORIENTATION = "l";
            else
                VHSC01IW-PASSVALUE.CAR-ORIENT = "L";
                VHSC01IW-PASSVALUE.RIGHT-ORIENTATION = "L";
            end
        end
    end
    if (VHTS2A2_DATA.CAR-TYPE == "E1")
        if (VHSC01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHSC01IW-PASSVALUE.CAR-ORIENT == "}")
                VHSC01IW-PASSVALUE.CAR-ORIENT = "{";
                VHSC01IW-PASSVALUE.LEFT-ORIENTATION = "{";
            else
                VHSC01IW-PASSVALUE.CAR-ORIENT = "}";
                VHSC01IW-PASSVALUE.RIGHT-ORIENTATION = "}";
            end
        end
    end
        if (VHTS2A2_DATA.CAR-TYPE == "M1")
        if (VHSC01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHSC01IW-PASSVALUE.CAR-ORIENT == "M")
                VHSC01IW-PASSVALUE.CAR-ORIENT = "m";
                VHSC01IW-PASSVALUE.LEFT-ORIENTATION = "m";
            else
                VHSC01IW-PASSVALUE.CAR-ORIENT = "M";
                VHSC01IW-PASSVALUE.RIGHT-ORIENTATION = "M";
            end
        end
    end
    if (VHTS2A2_DATA.CAR-TYPE == "K1" || VHTS2A2_DATA.CAR-TYPE == "K2")
        if (VHSC01IW-PASSVALUE.CAR-ORIENT != " ")
            if (VHSC01IW-PASSVALUE.CAR-ORIENT == "B")
                VHSC01IW-PASSVALUE.CAR-ORIENT = "b";
                VHSC01IW-PASSVALUE.LEFT-ORIENTATION = "b";
            else
                VHSC01IW-PASSVALUE.CAR-ORIENT = "B";
                VHSC01IW-PASSVALUE.RIGHT-ORIENTATION = "B";
            end
        end
    end    

end 

Function VHSC01IS-RIGHT-CON () 
    VHSC01W_DATA.FOUND-DATA = "N";
    if (VHSC01W_DATA.RIGHT-CON-NO != " ")
        if (VHSC01W_DATA.RIGHT-CON-NO == VHSC01W_DATA.LEFT-CON-NO)
            VHSC01W-MSG.MSG = "Left and Right consist cannot have the same values";
            DISABLE-DISPCONSIST = "Y";
            LEFTCON-SETFOCUS = "Y";
            return;
        else
      
            VHSCY_CRIT.CON-NO = VHSC01W_DATA.RIGHT-CON-NO;
            try
                call "VHSCY"(XDCONTROL, VHSCY_CRIT);
            
            end
            if (XDCONTROL.UROWCNT == 1)

            else
                if (XDCONTROL.URC == 100)
                    VHSC01W-MSG.MSG = "Entered Right Consist No does not exist in the database.";
                    VHSC01W-TRIGGER.RIGHTCON-SETFOCUS = "Y";
                    return;
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                end
            end
            if (VHSC01W_DATA.RIGHT-CON-NO != VHSC01W_DATA.CON-NO)
                VHSC01W_DATA.FOUND-DATA = "N";
                VHXCONB_CRIT.CON-NO = VHSC01W_DATA.RIGHT-CON-NO;
                VHXCONB_CRIT.USE-DASH-NO = "N";
                

        
                VHSC01IS-GET-CONS();

        
                if (VHSC01W_DATA.FOUND-DATA == "N" && VHSC01W_DATA.LEFT-CON-OK ==
                 "Y")
                    VHSC01W_DATA.RIGHT-DASH-NO = VHTS1A9_DATA.MAX-DASH-NO + 1;
                    ENABLE-DISPCONSIST = "Y";
                else
                    if (VHSC01W_DATA.FOUND-DATA == "Y")
                        VHSC01W-MSG.MSG = "You entered a Right Consist No that is Already in Service";
                        DISABLE-DISPCONSIST = "Y";
                        return;
                    end
                end
            else
            
                VHSC01W_DATA.RIGHT-DASH-NO = VHSC01W_DATA.DASH-NO + 1;
            end

      
            if (VHSC01W_DATA.LEFT-CON-NO != VHSC01W_DATA.CON-NO &&
             VHSC01W_DATA.RIGHT-CON-NO != VHSC01W_DATA.CON-NO)
                VHSC01W-TEMP-REC.LEFT-RIGHT-NEW = "Y";
                VHSC01W-TEMP-REC.LEFT-SAME-ORG = "N";
                VHSC01W-TEMP-REC.RIGHT-SAME-ORG = "N";
            else
                if (VHSC01W_DATA.LEFT-CON-NO == VHSC01W_DATA.CON-NO &&
                 VHSC01W_DATA.RIGHT-CON-NO != VHSC01W_DATA.CON-NO)
                    VHSC01W-TEMP-REC.LEFT-RIGHT-NEW = "N";
                    VHSC01W-TEMP-REC.LEFT-SAME-ORG = "Y";
                    VHSC01W-TEMP-REC.RIGHT-SAME-ORG = "N";
                else
                    if (VHSC01W_DATA.LEFT-CON-NO != VHSC01W_DATA.CON-NO &&
                     VHSC01W_DATA.RIGHT-CON-NO == VHSC01W_DATA.CON-NO)
                        VHSC01W-TEMP-REC.LEFT-RIGHT-NEW = "N";
                        VHSC01W-TEMP-REC.LEFT-SAME-ORG = "N";
                        VHSC01W-TEMP-REC.RIGHT-SAME-ORG = "Y";
                    end
                end
            end
            VHSC01W-TRIGGER.SPLIT-MSG = "Y";
            
  
        end
    else
        VHSC01W-MSG.MSG = "Right consist cannot be blank";
        DISABLE-DISPCONSIST = "Y";
        RIGHTCON-SETFOCUS = "Y";
    end
end 

Function VHSC01IS-RIGHT-VAL ()
    
    LOOP-INDEX = 1;
    VHSC01W-TEMP-REC.RIGHT-CON-STAT = "SRV";
    while (LOOP-INDEX <= VHSC01W-TEMP-REC.RIGHT-CON-SIZE)
        if (LOOP-INDEX == 1)
            VHSC01W-TEMP-REC.RIGHT-CAR-NO[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-NO-1;
            VHSC01W-TEMP-REC.RIGHT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORIENT1;
            VHSC01W-TEMP-REC.RIGHT-CAR-ORDER[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORDER1;
        else
            if (LOOP-INDEX == 2)
                VHSC01W-TEMP-REC.RIGHT-CAR-NO[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-NO-2;
                VHSC01W-TEMP-REC.RIGHT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORIENT2;
                VHSC01W-TEMP-REC.RIGHT-CAR-ORDER[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORDER2;
            else
                if (LOOP-INDEX == 3)
                    VHSC01W-TEMP-REC.RIGHT-CAR-NO[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-NO-3;
                    VHSC01W-TEMP-REC.RIGHT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORIENT3;
                    VHSC01W-TEMP-REC.RIGHT-CAR-ORDER[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORDER3;
                else
                    if (LOOP-INDEX == 4)
                        VHSC01W-TEMP-REC.RIGHT-CAR-NO[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-NO-4;
                        VHSC01W-TEMP-REC.RIGHT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORIENT4;
                        VHSC01W-TEMP-REC.RIGHT-CAR-ORDER[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORDER4;
                    else
                        if (LOOP-INDEX == 5)
                            VHSC01W-TEMP-REC.RIGHT-CAR-NO[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-NO-5;
                            VHSC01W-TEMP-REC.RIGHT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORIENT5;
                            VHSC01W-TEMP-REC.RIGHT-CAR-ORDER[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORDER5;
                        else
                            if (LOOP-INDEX == 6)
                                VHSC01W-TEMP-REC.RIGHT-CAR-NO[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-NO-6;
                                VHSC01W-TEMP-REC.RIGHT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORIENT6;
                                VHSC01W-TEMP-REC.RIGHT-CAR-ORDER[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORDER6;
                            else
                                if (LOOP-INDEX == 7)
                                    VHSC01W-TEMP-REC.RIGHT-CAR-NO[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-NO-7;
                                    VHSC01W-TEMP-REC.RIGHT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORIENT7;
                                    VHSC01W-TEMP-REC.RIGHT-CAR-ORDER[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORDER7;
                                else
                                    if (LOOP-INDEX == 8)
                                        VHSC01W-TEMP-REC.RIGHT-CAR-NO[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-NO-8;
                                        VHSC01W-TEMP-REC.RIGHT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORIENT8;
                                        VHSC01W-TEMP-REC.RIGHT-CAR-ORDER[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORDER8;
                                    else
                                        if (LOOP-INDEX == 9)
                                            VHSC01W-TEMP-REC.RIGHT-CAR-NO[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-NO-9;
                                            VHSC01W-TEMP-REC.RIGHT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORIENT9;
                                            VHSC01W-TEMP-REC.RIGHT-CAR-ORDER[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORDER9;
                                        else
                                            if (LOOP-INDEX == 10)
                                                VHSC01W-TEMP-REC.RIGHT-CAR-NO[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-NO-10;
                                                VHSC01W-TEMP-REC.RIGHT-CAR-ORIENTATION[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORIENT10;
                                                VHSC01W-TEMP-REC.RIGHT-CAR-ORDER[LOOP-INDEX] = VHSC01W-NEW-RIGHT.CAR-ORDER10;
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if (VHSC01W-TEMP-REC.RIGHT-CON-STAT == "SRV")
            VHCI01B_DATA.CAR-NO = VHSC01W-TEMP-REC.RIGHT-CAR-NO[LOOP-INDEX];
            try
                call "MRSVehicleIncident.VHCI01B"(XDCONTROL, VHCI01B_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                if (VHCI01B_DATA.VEH-STAT == "NO GO")
                    VHSC01W-TEMP-REC.RIGHT-CON-STAT = "CAR";
                end
            end
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
end 

Function VHSC01IS-SPLIT ()
   
    VHSC01W-MSG.MSG = " ";
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHSC01IW-CON-LIST.DATE-INSRV;
    MRSCommonCode.XXDATES-CONVERT();
    VHSC01IW.TEMP-DATE = XXDATEW.DATE-MM-DD-YYYY;
    VHSC01IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    

  
    VHSC01W-TRIGGER.RUN-SPLIT-2 = "N";
    if (VHSC01W_DATA.TIME-CHK == " ")
        VHSC01W-MSG.MSG = "Split Time field cannot be blank";
        SPLITTIME-SETFOCUS = "Y";
    else
        if (VHSC01W_DATA.TIME-CHK-HR not numeric ||
         VHSC01W_DATA.TIME-CHK-MIN not numeric)
            VHSC01W-MSG.MSG = "Split Time not numeric";
            SPLITTIME-SETFOCUS = "Y";
        else
            if (VHSC01W_DATA.TIME-CHK-HR-NUM > 23 ||
             VHSC01W_DATA.TIME-CHK-MIN-NUM > 59)
                VHSC01W-MSG.MSG = "Invalid Time entered";
                VHSC01W-TRIGGER.TIME-ERROR = "Y";
            else
                if (VHSC01W_DATA.SPLIT-LOC == " ")
                    VHSC01W-MSG.MSG = "Split Location field cannot be blank";
                    SPLITLOC-SETFOCUS = "Y";
                else
                    VHSC01W-TRIGGER.RUN-SPLIT-2 = "Y";
                    VHSC01W_DATA.SPLIT-TIME-HH = VHSC01W_DATA.TIME-CHK-HR-NUM;
                    VHSC01W_DATA.SPLIT-TIME-MM = VHSC01W_DATA.TIME-CHK-MIN-NUM;
                    VHSC01W_DATA.SPLIT-TIME-DOT1 = ":";
                    VHSC01W_DATA.SPLIT-TIME-REST = ":00";
                end
            end
        end
    end
    if (VHSC01W-TRIGGER.RUN-SPLIT-2 == "Y")
        if (VHSC01IW.TEMP-DATE-YEAR == VHSC01IW.SYSTEM-DATE-YEAR &&
         VHSC01IW.TEMP-DATE-MON == VHSC01IW.SYSTEM-DATE-MON &&
         VHSC01IW.TEMP-DATE-DAY == VHSC01IW.SYSTEM-DATE-DAY)
            if (VHSC01W_DATA.SPLIT-TIME-HH < VHSC01IW-CON-LIST.TIME-INSRV-HH)
                VHSC01W-MSG.MSG = "Split time hours is less than the time in service";
                SPLITTIME-SETFOCUS = "Y";
                VHSC01W-TRIGGER.RUN-SPLIT-2 = "N";
                return;
            else
                if (VHSC01W_DATA.SPLIT-TIME-HH == VHSC01IW-CON-LIST.TIME-INSRV-HH &&
                 VHSC01W_DATA.SPLIT-TIME-MM < VHSC01IW-CON-LIST.TIME-INSRV-MM)
                    VHSC01W-MSG.MSG = "Split time minutes is less than the time in service";
                    SPLITTIME-SETFOCUS = "Y";
                    VHSC01W-TRIGGER.RUN-SPLIT-2 = "N";
                    return;
                end
            end
        end
        VHSC01IS-DBPROCESS(); 
        VHSC01IS-CLR-AFTDB(); 
                                   
  
  
    end
end 

Function VHSC01US-REV-TRN4 () 
    XXEXT_CALL_Level77Items.UEXTNAM = "VHTS01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHTS2A2";
    set VHTS2A2_DATA empty;

  
  


    
    try
        call "VHTS2A2"(XDCONTROL, VHTS2A2_CRIT, VHTS2A2_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHSC01IS-REV-TRN5();
        end
    end
end 

Function VHTR01IS-ACCU-TIME () 
    VHTR01IW-PASSVALUE.CUM-HRS = VHTR01IW-PASSVALUE.CUM-HRS + DIFF-HH;
    VHTR01IW-PASSVALUE.CUM-MIN = VHTR01IW-PASSVALUE.CUM-MIN + DIFF-MM;
    if (VHTR01IW-PASSVALUE.CUM-MIN > 59)
        VHTR01IW-PASSVALUE.CUM-HRS = VHTR01IW-PASSVALUE.CUM-HRS + 1;
        VHTR01IW-PASSVALUE.CUM-MIN = VHTR01IW-PASSVALUE.CUM-MIN - 60;
    end
end 

Function VHTR01IS-BLANK-CA1 () 
    if (VHTR01IW.LEFT-CON-NO != " " &&
     VHTR01IW.RIGHT-CON-NO != " ")
        VHTR01IW-LEFT-CON.LEFT-CON-NO = VHTR01IW.LEFT-CON-NO;
        VHTR01IW-RIGHT-CON.RIGHT-CON-NO = VHTR01IW.RIGHT-CON-NO;
        if (VHTR01W-MSG-SC.CAR-POS == 9)
            VHTR01IW-RIGHT-CON.RIGHT-CON-SIZE = 2;
