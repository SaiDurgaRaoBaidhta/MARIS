                                VHSC01IW-CON-LIST.CAR-LEFT-ORIENT-8 = " ";
                                VHSC01IW-CON-LIST.CAR-RIGHT-ORIENT-8 = " ";
                                if (VHSC01IW-CON-LIST.CAR-ORIENT8 == VHTS2A3_DATA.LFT-ORIENTATION-CD[8])
                                    VHSC01IW-CON-LIST.CAR-LEFT-ORIENT-8 = VHSC01IW-CON-LIST.CAR-ORIENT8;
                                else
                                    if (VHSC01IW-CON-LIST.CAR-ORIENT8 == VHTS2A3_DATA.RGT-ORIENTATION-CD[8])
                                        VHSC01IW-CON-LIST.CAR-RIGHT-ORIENT-8 = VHSC01IW-CON-LIST.CAR-ORIENT8;
                                    end
                                end
                                if (IND == VHSC01IW-CON-LIST.CON-SIZE)
                                    DISABLE-SPLITBUTTON9 = "Y";
                                else
                                    ENABLE-SPLITBUTTON9 = "Y";
                                end
                            else
                                if (IND == 9)
                                    VHSC01IW-CON-LIST.CAR-NO-9 = VHXCONB_DATA2.CAR-NO[IND];
                                    VHSC01IW-CON-LIST.CAR-ORDER9 = 9;
                                    VHSC01IW-CON-LIST.CAR-ORIENT9 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
                                    VHSC01IW-CON-LIST.CAR-LEFT-ORIENT-9 = " ";
                                    VHSC01IW-CON-LIST.CAR-RIGHT-ORIENT-9 = " ";
                                    if (VHSC01IW-CON-LIST.CAR-ORIENT9 == VHTS2A3_DATA.LFT-ORIENTATION-CD[9])
                                        VHSC01IW-CON-LIST.CAR-LEFT-ORIENT-9 = VHSC01IW-CON-LIST.CAR-ORIENT9;
                                    else
                                        if (VHSC01IW-CON-LIST.CAR-ORIENT9 == VHTS2A3_DATA.RGT-ORIENTATION-CD[9])
                                            VHSC01IW-CON-LIST.CAR-RIGHT-ORIENT-9 = VHSC01IW-CON-LIST.CAR-ORIENT9;
                                        end
                                    end
                                else
                                    if (IND == 10)
                                        VHSC01IW-CON-LIST.CAR-NO-10 = VHXCONB_DATA2.CAR-NO[IND];
                                        VHSC01IW-CON-LIST.CAR-ORDER10 = 10;
                                        VHSC01IW-CON-LIST.CAR-ORIENT10 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
                                        VHSC01IW-CON-LIST.CAR-LEFT-ORIENT-10 = " ";
                                        VHSC01IW-CON-LIST.CAR-RIGHT-ORIENT-10 = " ";
                                        if (VHSC01IW-CON-LIST.CAR-ORIENT10 == VHTS2A3_DATA.LFT-ORIENTATION-CD[10])
                                            VHSC01IW-CON-LIST.CAR-LEFT-ORIENT-10 = VHSC01IW-CON-LIST.CAR-ORIENT10;
                                        else
                                            if (VHSC01IW-CON-LIST.CAR-ORIENT10 == VHTS2A3_DATA.RGT-ORIENTATION-CD[10])
                                                VHSC01IW-CON-LIST.CAR-RIGHT-ORIENT-10 = VHSC01IW-CON-LIST.CAR-ORIENT10;
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        IND = IND + 1;
    end
    set VHSC01W-NEW-RIGHT empty;
    CLICK-COUNT = 0;
    VHSC01W-TRIGGER.DISABLE-UPDATE = "Y";
    VHSC01W-TRIGGER.ENABLE-LEFTCON = "Y";
    VHSC01W-TRIGGER.ENABLE-RIGHTCON = "Y";
end 

Function VHSC01IS-MV-RIGHT ()
  
  
  
   
    VHSC01W-MSG.MSG = " ";
    if (VHSC01W_DATA.LEFT-CON-NO == " " || VHSC01W_DATA.RIGHT-CON-NO == " ")
        VHSC01W-MSG.MSG = "Left consist no or Right consist no cannot be blank";
    else
        VHSC01W-MSG.MSG = " ";
        VHSC01W_DATA.VALID-FIRST-CAR = "N";
        VHSC01IS-REV-TRN1();
        if (CLICK-COUNT == 0)
            XXEXT_CALL_Level77Items.UEXTNAM = "VHSC01I";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHSC2A1";
            VHSC01W-MSG.CAR-POS-1 = VHSC01W-MSG.CAR-POS - 1;

    
    
            VHSC2A1_CRIT.CAR-NO-L = VHXCONB_DATA2.CAR-NO[CAR-POS-1];
            VHSC2A1_CRIT.CAR-NO-R = VHXCONB_DATA2.CAR-NO[CAR-POS];
            VHSC01IW-PASSVALUE.RIGHT-CAR-POS = VHSC01W-MSG.CAR-POS;

    
            try
                call "VHSC2A1"(XDCONTROL, VHSC2A1_CRIT, VHSC2A1_DATA);
            
            end
            

  
            MRSCommonCode.XXA0IS-CHECK_EXT();

  
            if (XXEXT_CALL_Level77Items.URC == 0)
    
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    VHSC01IS-MV-RIGHTX();
                else
        
        
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end
        else
            if (CLICK-COUNT == 1)
                VHSC01IS-MV-LEFTX(); 
                CLICK-COUNT = 0;
            end
        end
    end
end 

Function VHSC01IS-MV-RIGHTX ()
  

   
    if ( ( VHSC2A1_DATA.CAR-TYPE[2] == "C1" ||
       VHSC2A1_DATA.CAR-TYPE[2] == "C2") &&
       (VHSC2A1_DATA.CAR-TYPE[1] == "C1" ||
       VHSC2A1_DATA.CAR-TYPE[1] == "C2") || 
      ( VHSC2A1_DATA.CAR-TYPE[2] == "D1"  && VHSC2A1_DATA.CAR-TYPE[1] == "D1") ||
      ( VHSC2A1_DATA.CAR-TYPE[2] == "L1"  && VHSC2A1_DATA.CAR-TYPE[1] == "L1") )
        VHSC01W_DATA.VALID-FIRST-CAR = "Y";
    else
        VHSC01W-MSG.MSG = "Split can occur between C1 or C2 Cars only";
        CLICK-COUNT = 0;
        return;
    end

  
    VHSC01W-MSG.NEW-CON-SIZE = VHSC01IW-CON-LIST.CON-SIZE - VHSC01W-MSG.CAR-POS-1;
    if (VHSC01W-MSG.NEW-CON-SIZE >= 2)

    else
        VHSC01W-MSG.MSG = "Consist is not at least 2 cars long";
        VHSC01W_DATA.VALID-FIRST-CAR = "N";
        CLICK-COUNT = 0;
    end
    if (VHSC01W_DATA.VALID-FIRST-CAR == "Y")
        CLICK-COUNT = 1;

    
        VHSC01W_DATA.RIGHT-CON-SIZE = VHSC01W-MSG.NEW-CON-SIZE;
        VHSC01W_DATA.LEFT-CON-SIZE = VHSC01IW-CON-LIST.CON-SIZE - VHSC01W_DATA.RIGHT-CON-SIZE;

    
        IND = VHSC01W-MSG.CAR-POS;
        VHSC01W-NEW-RIGHT.CAR-NO-1 = VHXCONB_DATA2.CAR-NO[IND];
        VHSC01W-NEW-RIGHT.CAR-ORDER1 = 1;
        VHSC01W-NEW-RIGHT.CAR-ORIENT1 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
        VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-1 = " ";
        VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-1 = " ";
        if (VHSC01W-NEW-RIGHT.CAR-ORIENT1 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
            VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-1 = VHSC01W-NEW-RIGHT.CAR-ORIENT1;
        else
            if (VHSC01W-NEW-RIGHT.CAR-ORIENT1 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-1 = VHSC01W-NEW-RIGHT.CAR-ORIENT1;
            end
        end
        IND = IND + 1;
        RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        VHSC01W-NEW-RIGHT.CAR-NO-2 = VHXCONB_DATA2.CAR-NO[IND];
        VHSC01W-NEW-RIGHT.CAR-ORDER2 = 2;
        VHSC01W-NEW-RIGHT.CAR-ORIENT2 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
        VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-2 = " ";
        VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-2 = " ";
        if (VHSC01W-NEW-RIGHT.CAR-ORIENT2 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
            VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-2 = VHSC01W-NEW-RIGHT.CAR-ORIENT2;
        else
            if (VHSC01W-NEW-RIGHT.CAR-ORIENT2 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-2 = VHSC01W-NEW-RIGHT.CAR-ORIENT2;
            end
        end
        IND = IND + 1;
        RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        if (IND <= 10)
            VHSC01W-NEW-RIGHT.CAR-NO-3 = VHXCONB_DATA2.CAR-NO[IND];
            VHSC01W-NEW-RIGHT.CAR-ORDER3 = 3;
            VHSC01W-NEW-RIGHT.CAR-ORIENT3 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
            VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-3 = " ";
            VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-3 = " ";
            if (VHSC01W-NEW-RIGHT.CAR-ORIENT3 == VHTS2A3_DATA.LFT-ORIENTATION-CD[RIGHT-CAR-POS])
                VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-3 = VHSC01W-NEW-RIGHT.CAR-ORIENT3;
            else
                if (VHSC01W-NEW-RIGHT.CAR-ORIENT3 == VHTS2A3_DATA.RGT-ORIENTATION-CD[RIGHT-CAR-POS])
                    VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-3 = VHSC01W-NEW-RIGHT.CAR-ORIENT3;
                end
            end
            IND = IND + 1;
            RIGHT-CAR-POS = RIGHT-CAR-POS + 1;
        end
        if (IND <= 10)
            VHSC01W-NEW-RIGHT.CAR-NO-4 = VHXCONB_DATA2.CAR-NO[IND];
            VHSC01W-NEW-RIGHT.CAR-ORDER4 = 4;
            VHSC01W-NEW-RIGHT.CAR-ORIENT4 = VHXCONB_DATA2.CAR-ORIENTATION[IND];
            VHSC01W-NEW-RIGHT.CAR-LEFT-ORIENT-4 = " ";
            VHSC01W-NEW-RIGHT.CAR-RIGHT-ORIENT-4 = " ";
