    VHCM01IW-PASSVALUE.CAR-LR = VHCM01IW-PASSVALUE.CAR-LR-X[4];
    if (LAST-CAR-NO == 4 ||
     VHCM01IW-PASS-LEFT.CON-SIZE == 4)
        VHCM01IW-PASSVALUE.END-CAR-SW = "Y";
        VHCM01IW-PASSVALUE.MID-CAR-SW = "N";
