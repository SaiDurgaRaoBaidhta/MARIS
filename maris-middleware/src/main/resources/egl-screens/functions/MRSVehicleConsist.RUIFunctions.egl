    VHCC013_CRIT.CON-CAR-NO-5 = VHCC01IW.CAR-NO-5-NEW;
    VHCC013_CRIT.CON-CAR-NO-6 = VHCC01IW.CAR-NO-6-NEW;
    VHCC013_CRIT.CON-CAR-NO-7 = VHCC01IW.CAR-NO-7-NEW;
    VHCC013_CRIT.CON-CAR-NO-8 = VHCC01IW.CAR-NO-8-NEW;
    VHCC013_CRIT.CON-CAR-NO-9 = VHCC01IW.CAR-NO-9-NEW;
    VHCC013_CRIT.CON-CAR-NO-10 = VHCC01IW.CAR-NO-10-NEW;
    VHCC013_CRIT.CON-CAR-NO-1-MARIS = VHCC01IW.CAR-NO-1-MARIS;
    VHCC013_CRIT.CON-CAR-NO-2-MARIS = VHCC01IW.CAR-NO-2-MARIS;
    VHCC013_CRIT.CON-CAR-NO-3-MARIS = VHCC01IW.CAR-NO-3-MARIS;
    VHCC013_CRIT.CON-CAR-NO-4-MARIS = VHCC01IW.CAR-NO-4-MARIS;
    VHCC013_CRIT.CON-CAR-NO-5-MARIS = VHCC01IW.CAR-NO-5-MARIS;
    VHCC013_CRIT.CON-CAR-NO-6-MARIS = VHCC01IW.CAR-NO-6-MARIS;
    VHCC013_CRIT.CON-CAR-NO-7-MARIS = VHCC01IW.CAR-NO-7-MARIS;
    VHCC013_CRIT.CON-CAR-NO-8-MARIS = VHCC01IW.CAR-NO-8-MARIS;
    VHCC013_CRIT.CON-CAR-NO-9-MARIS = VHCC01IW.CAR-NO-9-MARIS;
    VHCC013_CRIT.CON-CAR-NO-10-MARIS = VHCC01IW.CAR-NO-10-MARIS;
    VHCC013_CRIT.VEH-STAT-PREV-1 = VHCC011_DATA.VEH-STAT[1];
