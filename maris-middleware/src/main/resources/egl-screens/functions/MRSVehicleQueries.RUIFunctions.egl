Function VHSV06IS-R-PRVNXT () 
    set VHSV06IW_REPR_DATA empty;
    VHSV06IW.REPR-NARR-COUNT = 0;
    VHSV06IW.CMPNT-ROW-COUNT = 0;
    if (VHSV06IW.REPR-ROW-COUNT > 0)
        if (VHSV06IW.REPR-PRV-NXT == "REPRPRV")
            REPR-INDEX = REPR-INDEX - 1;
  
  
  
            if (REPR-INDEX == 1)
                DISABLE-REPR-PRV = "Y";
                if (REPR-INDEX == VHSV06IW.REPR-ROW-COUNT)
                    DISABLE-REPR-NXT = "Y";
                else
                    ENABLE-REPR-NXT = "Y";
                    REPR-NXT-SETFOCUS = "Y";
                end
            else
                ENABLE-REPR-PRV = "Y";
                ENABLE-REPR-NXT = "Y";
                REPR-PRV-SETFOCUS = "Y";
            end
        else
            if (VHSV06IW.REPR-PRV-NXT == "REPRNXT")
                REPR-INDEX = REPR-INDEX + 1;
                ENABLE-REPR-PRV = "Y";
                if (REPR-INDEX == VHSV06IW.REPR-ROW-COUNT)
                    DISABLE-REPR-NXT = "Y";
                    REPR-PRV-SETFOCUS = "Y";
                else
                    ENABLE-REPR-NXT = "Y";
                    REPR-NXT-SETFOCUS = "Y";
                end
            else
                if (VHSV06IW.REPR-PRV-NXT == " ")
                    VHSV06IW.REPR-INDEX = 1; 
                    if (REPR-INDEX == VHSV06IW.REPR-ROW-COUNT)
                        DISABLE-REPR-PRV = "Y";
                        DISABLE-REPR-NXT = "Y";
                    else
                        DISABLE-REPR-PRV = "Y";
                        ENABLE-REPR-NXT = "Y";
                        REPR-NXT-SETFOCUS = "Y";
                    end
                end
            end
        end
        VHSV06IW_REPR_DATA.REPR-DOC-NO = VHSV06C_DATA.REPR-DOC-NO[REPR-INDEX];
        VHSV06IW_REPR_DATA.VEH-SYSTEM = VHSV06C_DATA.VEH-SYSTEM[REPR-INDEX];
        VHSV06IW_REPR_DATA.VEH-SYSTEM-FILLER = "/";
        VHSV06IW_REPR_DATA.VEH-SUB-SYSTEM = VHSV06C_DATA.VEH-SUB-SYSTEM[REPR-INDEX];
        VHSV06IW_REPR_DATA.REPR-DISP-CD = VHSV06C_DATA.REPR-DISP-CD[REPR-INDEX];
        VHSV06IW_REPR_DATA.SER-NO-ON = VHSV06C_DATA.SER-NO-ON[REPR-INDEX];
        VHSV06IW_REPR_DATA.SER-NO-OFF = VHSV06C_DATA.SER-NO-OFF[REPR-INDEX];
        VHSV06IW_REPR_DATA.VEH-PRT-CTL-NO = VHSV06C_DATA.VEH-PRT-CTL-NO[REPR-INDEX];

    
        VHNARY_CRIT.INCD-NO = VHSV06IW_INCD_DATA.INCD-NO;
        VHNARY_CRIT.REPR-DOC-NO = VHSV06IW_REPR_DATA.REPR-DOC-NO;
        try
            call "MRSVehicleMaintenance.VHNARY"(XDCONTROL, VHNARY_CRIT, VHNARY_DATA);
        
        end
        if (XDCONTROL.UROWCNT > 0)
            VHSV06IW.REPR-NARR-COUNT = XDCONTROL.UROWCNT;
        else

        end
        LOAD-REPR-NARR-DATA = "Y"; 

    
        VHSV06D_CRIT.INCD-NO = VHSV06IW_INCD_DATA.INCD-NO;
        VHSV06D_CRIT.REPR-DOC-NO = VHSV06IW_REPR_DATA.REPR-DOC-NO;
        try
            call "VHSV06D"(XDCONTROL, VHSV06D_CRIT, VHSV06D_DATA);
        
        end
        if (XDCONTROL.UROWCNT > 0)
            VHSV06IW.CMPNT-ROW-COUNT = XDCONTROL.UROWCNT;
        else

        end
        LOAD-CMPNT-DATA = "Y";
         
    else
        DISABLE-REPR-PRV = "Y";
        DISABLE-REPR-NXT = "Y";
        LOAD-REPR-NARR-DATA = "Y";
        LOAD-CMPNT-DATA = "Y";
    end
end 

Function VHSV06IS-REPR-DATA () 
    VHSV06C_CRIT.INCD-NO = VHSV06IW_INCD_DATA.INCD-NO;
    try
        call "VHSV06C"(XDCONTROL, VHSV06C_CRIT, VHSV06C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHSV06IW.REPR-ROW-COUNT = VHSV06C_CRIT.REPR-ROW-COUNT;
        EXECUTE-REPR-PRVNXT = "Y";
    else
        set VHSV06IW_REPR_DATA empty;
        set VHSV06C_DATA empty;
        set VHSV06D_DATA empty;
        VHSV06IW.REPR-ROW-COUNT = 0;
        VHSV06IW.CMPNT-ROW-COUNT = 0;
        DISABLE-REPR-PRV = "Y";
        DISABLE-REPR-NXT = "Y";
        LOAD-REPR-NARR-DATA = "Y";
        LOAD-CMPNT-DATA = "Y";
    end
end 

Function VHSV06IS-RETDATA ()
  
  
  
   
    VHSV06A_CRIT.INCD-NO = VHSV06IW-PASSVALUE.INCD-NO;
    VHSV06A_CRIT.WHICH-GUI = VHSV06IW-PASSVALUE.WHICH-GUI;
    try
        call "VHSV06F"(XDCONTROL, VHSV06F_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHSV06A_CRIT.INCD-DATE-FROM = VHSV06F_DATA.FROM-DATE;
        VHSV06A_CRIT.INCD-DATE-TO = VHSV06F_DATA.TO-DATE;
        
   
   
    end
    VHSV06IW_TITLE.TITLE = " ";
    VHSV06IW.INCD-PRV-NXT = " ";
    VHSV06IW.ROW-COUNT = 0;
    VHSV06IW.NARR-ROW-COUNT = 0;
    VHSV06IW.REPR-NARR-COUNT = 0;
    VHSV06IW.CMPNT-ROW-COUNT = 0;
    LOAD-REPR-NARR-DATA = "Y";
    LOAD-DATA = "Y";
    VHSV06IW_TITLE.TITLE-1 = "VHSV06I - Status/History Vehicle Report";
    VHSV06IW_TITLE.TITLE-2 = " for Car ";
    VHSV06IW_TITLE.TITLE-3 = VHSV06A_CRIT.CAR-NO;
    VHSV06IW_TITLE.TITLE-4 = " from Date: ";
    VHSV06IW_TITLE.TITLE-5 = VHSV06A_CRIT.INCD-DATE-FROM;
    VHSV06IW_TITLE.TITLE-6 = " to ";
    VHSV06IW_TITLE.TITLE-7 = VHSV06A_CRIT.INCD-DATE-TO;
    VHSV06IW_TITLE.TITLE-9 = "  V1 OCT.02-1.0";
    try
        call "VHSV06A"(XDCONTROL, VHSV06A_CRIT, VHSV06A_DATA_01, VHSV06A_DATA_02, VHSV06A_DATA_03);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHSV06IW.ROW-COUNT = VHSV06A_CRIT.ROW-COUNT;
        EXECUTE-INCD-PRVNXT = "Y";
        EXECUTE-MOVE-REASON = "Y";
        
  
    else
        set VHSV06F_DATA empty;
        VHSV06IW.ROW-COUNT = 0;
        VHSV06IW.NARR-ROW-COUNT = 0;
        VHSV06IW.REPR-NARR-COUNT = 0;
        VHSV06IW.CMPNT-ROW-COUNT = 0;
        set VHSV06IW_INCD_DATA empty;
        VHSV06IW_INCD_DATA.CUM-HRS = 0;
        set VHSV06IW_REPR_DATA empty;
        DISABLE-INCD-PRV = "Y";
        DISABLE-INCD-NXT = "Y";
        DISABLE-REPR-PRV = "Y";
        DISABLE-REPR-NXT = "Y";
        LOAD-DATA = "Y";
        LOAD-REPR-NARR-DATA = "Y";
        LOAD-CMPNT-DATA = "Y";
        XXMESSAGE.UMSGCODE = "AFCR001";
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

