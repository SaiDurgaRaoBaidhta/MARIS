Function VHRC01IS-DISPLAY () 
    INVALID-CARNO = "N";
    if (VHRC01IW.HOME-YARD == " ")
        INVALID-HOMEYARD = "Y";
    else
        if (VHRC01IW.HOME-YARD == "ALL")
            HARD-COPY-VALID = "Y";
             
        else
            if (VHRC01IW.CAR-NO == " ")
                OPEN-VHRC02I = "Y";
            else
                if (VHRC01IW.CAR-NO != " ")
                    if (VHRC01IW.CAR-NO == "ALL")
                        OPEN-VHRC02I = "Y";
                    else
                        if (VHRC01IW.CAR-NO not numeric)
                            CAR-NOT-NUMERIC = "Y";
                        else
          
                            VHCI01B_DATA.CAR-NO = VHRC01IW.CAR-NO;
                            try
                                call "MRSVehicleIncident.VHCI01B"(XDCONTROL, VHCI01B_DATA);
                            
                            end
                            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                                OPEN-VHRC02I = "Y";
                            else
                                if (XDCONTROL.URC == 100)
                                    INVALID-CARNO = "Y";
                                    CAR-NOT-FOUND = "Y";
                                else
                                    INVALID-CARNO = "Y";
                                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHRC01IS-HARD-COPY () 
    if (PRT-IDX > 0)
        ENABLE-HARD = "Y";
        VHRC01IW-PASSVALUE.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRT-IDX];
    else
        DISABLE-HARD = "Y";
    end
end 

