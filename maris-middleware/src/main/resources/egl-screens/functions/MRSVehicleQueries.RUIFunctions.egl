Function VHNG01IS-SUBMIT-X () 
    VHNG01IW-TRIGGER.OK-SUBMIT = "Y";
    VHNG01IW.NULL-TO-ERROR = "N";
    VHNG01IW.INVALID-TO-DATE = " ";
    VHNG01IW.INVALID-FROM-DATE = " ";
    if (VHNG01IW.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHNG01IW.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHNG01IW.INVALID-FROM-DATE = "Y";
            
   
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHNG01I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHNG01IW.TO-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHNG01IW.TO-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHNG01I_MESSAGE.MESG1 = "INVALID TO DATE";
            VHNG01IW.INVALID-TO-DATE = "Y";
            
  
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHNG01I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHNG01IW.YRD == "   ")
        VHNG01I_MESSAGE.MESG1 = "INVALID YARD SELECTION";
        VHNG01IW.INVALID-YRD = "Y";
        AFCXVLDW.NO-ERROR = "N";
    end
    if (VHNG01IW.MINUTES == 0)
        VHNG01I_MESSAGE.MESG1 = "INVALID MINUTES CRITERIA";
        VHNG01IW.INVALID-MINUTES = "Y";
        AFCXVLDW.NO-ERROR = "N";
    end
    if (VHNG01IW.INVALID-FROM-DATE == "Y")
        VHNG01I_MESSAGE.MESG1 = "INVALID FROM DATE";
        VHNG01IW-TRIGGER.OK-SUBMIT = "N";
    else
  
        if (VHNG01IW.TO-DATE != " ")
            if ((VHNG01IW.TO-DATE-YEAR-NUM > VHNG01IW.WS-CURR-YEAR-NUM) ||
             (VHNG01IW.TO-DATE-YEAR-NUM == VHNG01IW.WS-CURR-YEAR-NUM &&
             VHNG01IW.TO-DATE-MO-NUM > VHNG01IW.WS-CURR-MO-NUM) ||
             (VHNG01IW.TO-DATE-YEAR-NUM == VHNG01IW.WS-CURR-YEAR-NUM &&
             VHNG01IW.TO-DATE-MO-NUM == VHNG01IW.WS-CURR-MO-NUM &&
             VHNG01IW.TO-DATE-DAY-NUM > VHNG01IW.WS-CURR-DA-NUM))
                VHNG01I_MESSAGE.MESG1 = "To date cannot be greater than CURRENT_DATE.";
                VHNG01IW.INVALID-TO-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                
  
            end
        end
    end
    if (VHNG01IW.INVALID-TO-DATE == "Y")
        VHNG01IW-TRIGGER.OK-SUBMIT = "N";
    end
    if (VHNG01IW-TRIGGER.OK-SUBMIT == "Y")
  
        if (VHNG01IW.FROM-DATE != " " && VHNG01IW.TO-DATE != " ")
            if ((VHNG01IW.FROM-DATE-YEAR-NUM > VHNG01IW.TO-DATE-YEAR-NUM) ||
             (VHNG01IW.FROM-DATE-YEAR-NUM == VHNG01IW.TO-DATE-YEAR-NUM &&
             VHNG01IW.FROM-DATE-MO-NUM > VHNG01IW.TO-DATE-MO-NUM) ||
             (VHNG01IW.FROM-DATE-YEAR-NUM == VHNG01IW.TO-DATE-YEAR-NUM &&
             VHNG01IW.FROM-DATE-MO-NUM == VHNG01IW.TO-DATE-MO-NUM &&
             VHNG01IW.FROM-DATE-DAY-NUM > VHNG01IW.TO-DATE-DAY-NUM))
                VHNG01I_MESSAGE.MESG1 = "From date cannot be greater than To date.";
                VHNG01IW.INVALID-FROM-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                VHNG01IW-TRIGGER.OK-SUBMIT = "N";
                
  
            end
        end
    end
    if (VHNG01IW-TRIGGER.OK-SUBMIT == "Y")
        if (VHNG01IW-TRIGGER.INVALID-SYMP-TO == "Y")
            VHNG01IW-TRIGGER.OK-SUBMIT = "N";
        else
            if (VHNG01IW-TRIGGER.INVALID-SYMP-FROM == "Y")
                VHNG01IW-TRIGGER.OK-SUBMIT = "N";
            else
   
   
   
                if (AFCXVLDW.NO-ERROR == "N")
                    VHNG01IW-TRIGGER.OK-SUBMIT = " ";
                else
                    VHNG01IW-TRIGGER.OK-SUBMIT = "Y ";
                end
            end
        end
    end
end 

