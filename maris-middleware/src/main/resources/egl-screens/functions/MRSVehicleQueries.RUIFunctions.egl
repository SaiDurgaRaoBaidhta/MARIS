    CAR-DYL-DATA[1] = TOTAL-FLEET-L;
    CAR-DYM-DATA[1] = TOTAL-FLEET-M;    
    CAR-DYK-DATA[1] = TOTAL-FLEET-K;
    CAR-DYTOTAL-DATA[1] = TOTAL-FLEET-T;

  
    CAR-DYA-DATA[2] = HOLD-CARS-A;
    CAR-DYB-DATA[2] = HOLD-CARS-B;
    CAR-DYC-DATA[2] = HOLD-CARS-C;
    CAR-DYD-DATA[2] = HOLD-CARS-D;
    CAR-DYE-DATA[2] = HOLD-CARS-E;
    CAR-DYL-DATA[2] = HOLD-CARS-L;
    CAR-DYM-DATA[2] = HOLD-CARS-M;
    CAR-DYK-DATA[2] = HOLD-CARS-K;
    CAR-DYTOTAL-DATA[2] = HOLD-CARS-T;

  
    CAR-DYA-DATA[3] = TOTAL-FLEET-A - HOLD-CARS-A;
    CAR-DYB-DATA[3] = TOTAL-FLEET-B - HOLD-CARS-B;
    CAR-DYC-DATA[3] = TOTAL-FLEET-C - HOLD-CARS-C;
    CAR-DYD-DATA[3] = TOTAL-FLEET-D - HOLD-CARS-D;
