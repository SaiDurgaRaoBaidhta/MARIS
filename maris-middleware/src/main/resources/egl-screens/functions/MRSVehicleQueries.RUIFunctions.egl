            end 
        end 
        if (VHDVS01_DATA.YRD[VAGen_COUNT] == "RY")
            if (  VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS2I_RETURN.RY-A[1] = VHDVS2I_RETURN.RY-A[1] + VHDVS01_DATA.CNT-CARS-REPR-UM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-A[2] = VHDVS2I_RETURN.RY-A[2] + VHDVS01_DATA.CNT-CARS-REPR-PM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-A[3] = VHDVS2I_RETURN.RY-A[3] + VHDVS01_DATA.CNT-CARS-REPR-MOD[VAGen_COUNT];
                VHDVS2I_RETURN.RY-A[4] = VHDVS2I_RETURN.RY-A[4] + VHDVS01_DATA.CNT-CARS-REPR-MISC[VAGen_COUNT];
                VHDVS2I_RETURN.RY-A[5] = VHDVS2I_RETURN.RY-A[5] + VHDVS01_DATA.CNT-CARS-REPR-WAR[VAGen_COUNT];
                VHDVS2I_RETURN.RY-A[6] = VHDVS2I_RETURN.RY-A[1] + VHDVS2I_RETURN.RY-A[2] + VHDVS2I_RETURN.RY-A[3] + VHDVS2I_RETURN.RY-A[4] + VHDVS2I_RETURN.RY-A[5];
            end 
            if (  VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
                VHDVS2I_RETURN.RY-B[1] = VHDVS2I_RETURN.RY-B[1] + VHDVS01_DATA.CNT-CARS-REPR-UM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-B[2] = VHDVS2I_RETURN.RY-B[2] + VHDVS01_DATA.CNT-CARS-REPR-PM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-B[3] = VHDVS2I_RETURN.RY-B[3] + VHDVS01_DATA.CNT-CARS-REPR-MOD[VAGen_COUNT];
                VHDVS2I_RETURN.RY-B[4] = VHDVS2I_RETURN.RY-B[4] + VHDVS01_DATA.CNT-CARS-REPR-MISC[VAGen_COUNT];
                VHDVS2I_RETURN.RY-B[5] = VHDVS2I_RETURN.RY-B[5] + VHDVS01_DATA.CNT-CARS-REPR-WAR[VAGen_COUNT];
                VHDVS2I_RETURN.RY-B[6] = VHDVS2I_RETURN.RY-B[1] + VHDVS2I_RETURN.RY-B[2] + VHDVS2I_RETURN.RY-B[3] + VHDVS2I_RETURN.RY-B[4] + VHDVS2I_RETURN.RY-B[5];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C1" || VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C2")
                VHDVS2I_RETURN.RY-C[1] = VHDVS2I_RETURN.RY-C[1] + VHDVS01_DATA.CNT-CARS-REPR-UM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-C[2] = VHDVS2I_RETURN.RY-C[2] + VHDVS01_DATA.CNT-CARS-REPR-PM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-C[3] = VHDVS2I_RETURN.RY-C[3] + VHDVS01_DATA.CNT-CARS-REPR-MOD[VAGen_COUNT];
                VHDVS2I_RETURN.RY-C[4] = VHDVS2I_RETURN.RY-C[4] + VHDVS01_DATA.CNT-CARS-REPR-MISC[VAGen_COUNT];
                VHDVS2I_RETURN.RY-C[5] = VHDVS2I_RETURN.RY-C[5] + VHDVS01_DATA.CNT-CARS-REPR-WAR[VAGen_COUNT];
                VHDVS2I_RETURN.RY-C[6] = VHDVS2I_RETURN.RY-C[1] + VHDVS2I_RETURN.RY-C[2] + VHDVS2I_RETURN.RY-C[3] + VHDVS2I_RETURN.RY-C[4] + VHDVS2I_RETURN.RY-C[5];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "D1" )
                VHDVS2I_RETURN.RY-D[1] = VHDVS2I_RETURN.RY-D[1] + VHDVS01_DATA.CNT-CARS-REPR-UM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-D[2] = VHDVS2I_RETURN.RY-D[2] + VHDVS01_DATA.CNT-CARS-REPR-PM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-D[3] = VHDVS2I_RETURN.RY-D[3] + VHDVS01_DATA.CNT-CARS-REPR-MOD[VAGen_COUNT];
                VHDVS2I_RETURN.RY-D[4] = VHDVS2I_RETURN.RY-D[4] + VHDVS01_DATA.CNT-CARS-REPR-MISC[VAGen_COUNT];
                VHDVS2I_RETURN.RY-D[5] = VHDVS2I_RETURN.RY-D[5] + VHDVS01_DATA.CNT-CARS-REPR-WAR[VAGen_COUNT];
                VHDVS2I_RETURN.RY-D[6] = VHDVS2I_RETURN.RY-D[1] + VHDVS2I_RETURN.RY-D[2] + VHDVS2I_RETURN.RY-D[3] + VHDVS2I_RETURN.RY-D[4] + VHDVS2I_RETURN.RY-D[5];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "E1")
                VHDVS2I_RETURN.RY-E[1] = VHDVS2I_RETURN.RY-E[1] + VHDVS01_DATA.CNT-CARS-REPR-UM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-E[2] = VHDVS2I_RETURN.RY-E[2] + VHDVS01_DATA.CNT-CARS-REPR-PM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-E[3] = VHDVS2I_RETURN.RY-E[3] + VHDVS01_DATA.CNT-CARS-REPR-MOD[VAGen_COUNT];
                VHDVS2I_RETURN.RY-E[4] = VHDVS2I_RETURN.RY-E[4] + VHDVS01_DATA.CNT-CARS-REPR-MISC[VAGen_COUNT];
                VHDVS2I_RETURN.RY-E[5] = VHDVS2I_RETURN.RY-E[5] + VHDVS01_DATA.CNT-CARS-REPR-WAR[VAGen_COUNT];
                VHDVS2I_RETURN.RY-E[6] = VHDVS2I_RETURN.RY-E[1] + VHDVS2I_RETURN.RY-E[2] + VHDVS2I_RETURN.RY-E[3] + VHDVS2I_RETURN.RY-E[4] + VHDVS2I_RETURN.RY-E[5];
            end             
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "L1" )
                VHDVS2I_RETURN.RY-L[1] = VHDVS2I_RETURN.RY-L[1] + VHDVS01_DATA.CNT-CARS-REPR-UM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-L[2] = VHDVS2I_RETURN.RY-L[2] + VHDVS01_DATA.CNT-CARS-REPR-PM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-L[3] = VHDVS2I_RETURN.RY-L[3] + VHDVS01_DATA.CNT-CARS-REPR-MOD[VAGen_COUNT];
                VHDVS2I_RETURN.RY-L[4] = VHDVS2I_RETURN.RY-L[4] + VHDVS01_DATA.CNT-CARS-REPR-MISC[VAGen_COUNT];
                VHDVS2I_RETURN.RY-L[5] = VHDVS2I_RETURN.RY-L[5] + VHDVS01_DATA.CNT-CARS-REPR-WAR[VAGen_COUNT];
                VHDVS2I_RETURN.RY-L[6] = VHDVS2I_RETURN.RY-L[1] + VHDVS2I_RETURN.RY-L[2] + VHDVS2I_RETURN.RY-L[3] + VHDVS2I_RETURN.RY-L[4] + VHDVS2I_RETURN.RY-L[5];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "M1")
                VHDVS2I_RETURN.RY-M[1] = VHDVS2I_RETURN.RY-M[1] + VHDVS01_DATA.CNT-CARS-REPR-UM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-M[2] = VHDVS2I_RETURN.RY-M[2] + VHDVS01_DATA.CNT-CARS-REPR-PM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-M[3] = VHDVS2I_RETURN.RY-M[3] + VHDVS01_DATA.CNT-CARS-REPR-MOD[VAGen_COUNT];
                VHDVS2I_RETURN.RY-M[4] = VHDVS2I_RETURN.RY-M[4] + VHDVS01_DATA.CNT-CARS-REPR-MISC[VAGen_COUNT];
                VHDVS2I_RETURN.RY-M[5] = VHDVS2I_RETURN.RY-M[5] + VHDVS01_DATA.CNT-CARS-REPR-WAR[VAGen_COUNT];
                VHDVS2I_RETURN.RY-M[6] = VHDVS2I_RETURN.RY-M[1] + VHDVS2I_RETURN.RY-M[2] + VHDVS2I_RETURN.RY-M[3] + VHDVS2I_RETURN.RY-M[4] + VHDVS2I_RETURN.RY-M[5];
            end
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "K1" || VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "K2")
                VHDVS2I_RETURN.RY-K[1] = VHDVS2I_RETURN.RY-K[1] + VHDVS01_DATA.CNT-CARS-REPR-UM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-K[2] = VHDVS2I_RETURN.RY-K[2] + VHDVS01_DATA.CNT-CARS-REPR-PM[VAGen_COUNT];
                VHDVS2I_RETURN.RY-K[3] = VHDVS2I_RETURN.RY-K[3] + VHDVS01_DATA.CNT-CARS-REPR-MOD[VAGen_COUNT];
                VHDVS2I_RETURN.RY-K[4] = VHDVS2I_RETURN.RY-K[4] + VHDVS01_DATA.CNT-CARS-REPR-MISC[VAGen_COUNT];
                VHDVS2I_RETURN.RY-K[5] = VHDVS2I_RETURN.RY-K[5] + VHDVS01_DATA.CNT-CARS-REPR-WAR[VAGen_COUNT];
                VHDVS2I_RETURN.RY-K[6] = VHDVS2I_RETURN.RY-K[1] + VHDVS2I_RETURN.RY-K[2] + VHDVS2I_RETURN.RY-K[3] + VHDVS2I_RETURN.RY-K[4] + VHDVS2I_RETURN.RY-K[5];
            end 
        end 
        VAGen_COUNT = VAGen_COUNT + 1;
    end 

  
    VAGen_INDEX = 1;
    while (VAGen_INDEX < 7)
  
        VHDVS2I_RETURN.FLEET-A[VAGen_INDEX] = VHDVS2I_RETURN.CY-A[VAGen_INDEX] + VHDVS2I_RETURN.DY-A[VAGen_INDEX] + VHDVS2I_RETURN.HY-A[VAGen_INDEX] + VHDVS2I_RETURN.RY-A[VAGen_INDEX];
        VHDVS2I_RETURN.FLEET-B[VAGen_INDEX] = VHDVS2I_RETURN.CY-B[VAGen_INDEX] + VHDVS2I_RETURN.DY-B[VAGen_INDEX] + VHDVS2I_RETURN.HY-B[VAGen_INDEX] + VHDVS2I_RETURN.RY-B[VAGen_INDEX];
        VHDVS2I_RETURN.FLEET-C[VAGen_INDEX] = VHDVS2I_RETURN.CY-C[VAGen_INDEX] + VHDVS2I_RETURN.DY-C[VAGen_INDEX] + VHDVS2I_RETURN.HY-C[VAGen_INDEX] + VHDVS2I_RETURN.RY-C[VAGen_INDEX];
        VHDVS2I_RETURN.FLEET-D[VAGen_INDEX] = VHDVS2I_RETURN.CY-D[VAGen_INDEX] + VHDVS2I_RETURN.DY-D[VAGen_INDEX] + VHDVS2I_RETURN.HY-D[VAGen_INDEX] + VHDVS2I_RETURN.RY-D[VAGen_INDEX];
        VHDVS2I_RETURN.FLEET-E[VAGen_INDEX] = VHDVS2I_RETURN.CY-E[VAGen_INDEX] + VHDVS2I_RETURN.DY-E[VAGen_INDEX] + VHDVS2I_RETURN.HY-E[VAGen_INDEX] + VHDVS2I_RETURN.RY-E[VAGen_INDEX];
        VHDVS2I_RETURN.FLEET-L[VAGen_INDEX] = VHDVS2I_RETURN.CY-L[VAGen_INDEX] + VHDVS2I_RETURN.DY-L[VAGen_INDEX] + VHDVS2I_RETURN.HY-L[VAGen_INDEX] + VHDVS2I_RETURN.RY-L[VAGen_INDEX];
        VHDVS2I_RETURN.FLEET-M[VAGen_INDEX] = VHDVS2I_RETURN.CY-M[VAGen_INDEX] + VHDVS2I_RETURN.DY-M[VAGen_INDEX] + VHDVS2I_RETURN.HY-M[VAGen_INDEX] + VHDVS2I_RETURN.RY-M[VAGen_INDEX];
        VHDVS2I_RETURN.FLEET-K[VAGen_INDEX] = VHDVS2I_RETURN.CY-K[VAGen_INDEX] + VHDVS2I_RETURN.DY-K[VAGen_INDEX] + VHDVS2I_RETURN.HY-K[VAGen_INDEX] + VHDVS2I_RETURN.RY-K[VAGen_INDEX];
        VHDVS2I_RETURN.FLEET-TOT[VAGen_INDEX] = VHDVS2I_RETURN.FLEET-A[VAGen_INDEX] + VHDVS2I_RETURN.FLEET-B[VAGen_INDEX] + VHDVS2I_RETURN.FLEET-C[VAGen_INDEX]
        									  + VHDVS2I_RETURN.FLEET-D[VAGen_INDEX] + VHDVS2I_RETURN.FLEET-E[VAGen_INDEX] + VHDVS2I_RETURN.FLEET-K[VAGen_INDEX]
        									  + VHDVS2I_RETURN.FLEET-L[VAGen_INDEX] + VHDVS2I_RETURN.FLEET-M[VAGen_INDEX];
        VAGen_INDEX = VAGen_INDEX + 1;
    end 

  
  
  
  
  
    VHDVS2IW_VALUES.CY-RMV[1] = VHDVS1I_FAIL.CY-A[7] + VHDVS1I_FAIL.CY-B[7] + VHDVS1I_FAIL.CY-C[7] + VHDVS1I_FAIL.CY-D[7] + VHDVS1I_FAIL.CY-E[7] + VHDVS1I_FAIL.CY-L[7] + VHDVS1I_FAIL.CY-M[7] + VHDVS1I_FAIL.CY-K[7];
    VHDVS2IW_VALUES.DY-RMV[1] = VHDVS1I_FAIL.DY-A[7] + VHDVS1I_FAIL.DY-B[7] + VHDVS1I_FAIL.DY-C[7] + VHDVS1I_FAIL.DY-D[7] + VHDVS1I_FAIL.DY-E[7] + VHDVS1I_FAIL.DY-L[7] + VHDVS1I_FAIL.DY-M[7] + VHDVS1I_FAIL.DY-K[7];
    VHDVS2IW_VALUES.HY-RMV[1] = VHDVS1I_FAIL.HY-A[7] + VHDVS1I_FAIL.HY-B[7] + VHDVS1I_FAIL.HY-C[7] + VHDVS1I_FAIL.HY-D[7] + VHDVS1I_FAIL.HY-E[7] + VHDVS1I_FAIL.HY-L[7] + VHDVS1I_FAIL.HY-M[7] + VHDVS1I_FAIL.HY-K[7];
    VHDVS2IW_VALUES.RY-RMV[1] = VHDVS1I_FAIL.RY-A[7] + VHDVS1I_FAIL.RY-B[7] + VHDVS1I_FAIL.RY-C[7] + VHDVS1I_FAIL.RY-D[7] + VHDVS1I_FAIL.RY-E[7] + VHDVS1I_FAIL.RY-L[7] + VHDVS1I_FAIL.RY-M[7] + VHDVS1I_FAIL.RY-K[7];
    VHDVS2IW_VALUES.FLEET-TOT-RMV[1] = VHDVS2IW_VALUES.CY-RMV[1] + VHDVS2IW_VALUES.DY-RMV[1] + VHDVS2IW_VALUES.HY-RMV[1] + VHDVS2IW_VALUES.RY-RMV[1];

  
    VHDVS2IW_VALUES.CY-RMV[2] = VHDVS2I_RETURN.CY-A[6] + VHDVS2I_RETURN.CY-B[6] + VHDVS2I_RETURN.CY-C[6] + VHDVS2I_RETURN.CY-D[6] + VHDVS2I_RETURN.CY-E[6] + VHDVS2I_RETURN.CY-L[6] + VHDVS2I_RETURN.CY-M[6] + VHDVS2I_RETURN.CY-K[6];
    VHDVS2IW_VALUES.DY-RMV[2] = VHDVS2I_RETURN.DY-A[6] + VHDVS2I_RETURN.DY-B[6] + VHDVS2I_RETURN.DY-C[6] + VHDVS2I_RETURN.DY-D[6] + VHDVS2I_RETURN.DY-E[6] + VHDVS2I_RETURN.DY-L[6] + VHDVS2I_RETURN.DY-M[6] + VHDVS2I_RETURN.DY-K[6];
    VHDVS2IW_VALUES.HY-RMV[2] = VHDVS2I_RETURN.HY-A[6] + VHDVS2I_RETURN.HY-B[6] + VHDVS2I_RETURN.HY-C[6] + VHDVS2I_RETURN.HY-D[6] + VHDVS2I_RETURN.HY-E[6] + VHDVS2I_RETURN.HY-L[6] + VHDVS2I_RETURN.HY-M[6] + VHDVS2I_RETURN.HY-K[6];
    VHDVS2IW_VALUES.RY-RMV[2] = VHDVS2I_RETURN.RY-A[6] + VHDVS2I_RETURN.RY-B[6] + VHDVS2I_RETURN.RY-C[6] + VHDVS2I_RETURN.RY-D[6] + VHDVS2I_RETURN.RY-E[6] + VHDVS2I_RETURN.RY-L[6] + VHDVS2I_RETURN.RY-M[6] + VHDVS2I_RETURN.RY-K[6];
    VHDVS2IW_VALUES.FLEET-TOT-RMV[2] = VHDVS2IW_VALUES.CY-RMV[2] + VHDVS2IW_VALUES.DY-RMV[2] + VHDVS2IW_VALUES.HY-RMV[2] + VHDVS2IW_VALUES.RY-RMV[2];
end 

Function VHDVS1IS-CALCULATE ()
  

  
   
    VAGen_COUNT = 1;
    VAGen_INDEX = 1;
  
    while (VAGen_COUNT <= VHDVS1IW-TRIGGERS.UROWCNT)
        if (VHDVS01_DATA.YRD[VAGen_COUNT] == "CY")
            if (  VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS1IW_VALUES.CY-A = VHDVS1IW_VALUES.CY-A + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (   VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
                VHDVS1IW_VALUES.CY-B = VHDVS1IW_VALUES.CY-B + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C1" || VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C2")
                VHDVS1IW_VALUES.CY-C = VHDVS1IW_VALUES.CY-C + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "D1")
                VHDVS1IW_VALUES.CY-D = VHDVS1IW_VALUES.CY-D + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "E1" )
                VHDVS1IW_VALUES.CY-E = VHDVS1IW_VALUES.CY-E + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end             
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "L1")
                VHDVS1IW_VALUES.CY-L = VHDVS1IW_VALUES.CY-L + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "M1" )
                VHDVS1IW_VALUES.CY-M = VHDVS1IW_VALUES.CY-M + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end  
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "K1" || VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "K2")
                VHDVS1IW_VALUES.CY-K = VHDVS1IW_VALUES.CY-K + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end
        end 
        if (VHDVS01_DATA.YRD[VAGen_COUNT] == "DY")
            if ( VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS1IW_VALUES.DY-A = VHDVS1IW_VALUES.DY-A + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if ( VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
                VHDVS1IW_VALUES.DY-B = VHDVS1IW_VALUES.DY-B + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C1" ||  VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C2" )
                VHDVS1IW_VALUES.DY-C = VHDVS1IW_VALUES.DY-C + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "D1")
                VHDVS1IW_VALUES.DY-D = VHDVS1IW_VALUES.DY-D + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "E1")
                VHDVS1IW_VALUES.DY-E = VHDVS1IW_VALUES.DY-E + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end             
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "L1")
                VHDVS1IW_VALUES.DY-L = VHDVS1IW_VALUES.DY-L + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "M1")
                VHDVS1IW_VALUES.DY-M = VHDVS1IW_VALUES.DY-M + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "K1" || VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "K2")
                VHDVS1IW_VALUES.DY-K = VHDVS1IW_VALUES.DY-K + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end
        end 
        if (VHDVS01_DATA.YRD[VAGen_COUNT] == "HY")
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS1IW_VALUES.HY-A = VHDVS1IW_VALUES.HY-A + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if ( VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
                VHDVS1IW_VALUES.HY-B = VHDVS1IW_VALUES.HY-B + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C1" || VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C2" )
                VHDVS1IW_VALUES.HY-C = VHDVS1IW_VALUES.HY-C + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "D1" )
                VHDVS1IW_VALUES.HY-D = VHDVS1IW_VALUES.HY-D + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "E1")
                VHDVS1IW_VALUES.HY-E = VHDVS1IW_VALUES.HY-E + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end             
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "L1" )
                VHDVS1IW_VALUES.HY-L = VHDVS1IW_VALUES.HY-L + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "M1")
                VHDVS1IW_VALUES.HY-M = VHDVS1IW_VALUES.HY-M + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "K1" || VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "K2")
                VHDVS1IW_VALUES.HY-K = VHDVS1IW_VALUES.HY-K + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end
        end 
        if (VHDVS01_DATA.YRD[VAGen_COUNT] == "RY")
            if ( VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS1IW_VALUES.RY-A = VHDVS1IW_VALUES.RY-A + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if ( VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
                VHDVS1IW_VALUES.RY-B = VHDVS1IW_VALUES.RY-B + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C1" || VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C2" )
                VHDVS1IW_VALUES.RY-C = VHDVS1IW_VALUES.RY-C + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "D1" )
                VHDVS1IW_VALUES.RY-D = VHDVS1IW_VALUES.RY-D + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "E1")
                VHDVS1IW_VALUES.RY-E = VHDVS1IW_VALUES.RY-E + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "L1" )
                VHDVS1IW_VALUES.RY-L = VHDVS1IW_VALUES.RY-L + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "M1")
                VHDVS1IW_VALUES.RY-M = VHDVS1IW_VALUES.RY-M + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "K1" || VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "K2")
                VHDVS1IW_VALUES.RY-K = VHDVS1IW_VALUES.RY-K + VHDVS01_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
            end
        end 
        VAGen_COUNT = VAGen_COUNT + 1;
    end 
    VHDVS1IW_VALUES.FLEET-A = VHDVS1IW_VALUES.CY-A + VHDVS1IW_VALUES.DY-A + VHDVS1IW_VALUES.HY-A + VHDVS1IW_VALUES.RY-A;
    VHDVS1IW_VALUES.FLEET-B = VHDVS1IW_VALUES.CY-B + VHDVS1IW_VALUES.DY-B + VHDVS1IW_VALUES.HY-B + VHDVS1IW_VALUES.RY-B;
    VHDVS1IW_VALUES.FLEET-C = VHDVS1IW_VALUES.CY-C + VHDVS1IW_VALUES.DY-C + VHDVS1IW_VALUES.HY-C + VHDVS1IW_VALUES.RY-C;
    VHDVS1IW_VALUES.FLEET-D = VHDVS1IW_VALUES.CY-D + VHDVS1IW_VALUES.DY-D + VHDVS1IW_VALUES.HY-D + VHDVS1IW_VALUES.RY-D;
    VHDVS1IW_VALUES.FLEET-E = VHDVS1IW_VALUES.CY-E + VHDVS1IW_VALUES.DY-E + VHDVS1IW_VALUES.HY-E + VHDVS1IW_VALUES.RY-E;
    VHDVS1IW_VALUES.FLEET-L = VHDVS1IW_VALUES.CY-L + VHDVS1IW_VALUES.DY-L + VHDVS1IW_VALUES.HY-L + VHDVS1IW_VALUES.RY-L;
    VHDVS1IW_VALUES.FLEET-M = VHDVS1IW_VALUES.CY-M + VHDVS1IW_VALUES.DY-M + VHDVS1IW_VALUES.HY-M + VHDVS1IW_VALUES.RY-M;
    VHDVS1IW_VALUES.FLEET-K = VHDVS1IW_VALUES.CY-K + VHDVS1IW_VALUES.DY-K + VHDVS1IW_VALUES.HY-K + VHDVS1IW_VALUES.RY-K;
    VHDVS1IW_VALUES.FLEET-TOT = VHDVS1IW_VALUES.FLEET-A + VHDVS1IW_VALUES.FLEET-B + VHDVS1IW_VALUES.FLEET-C 
    							+ VHDVS1IW_VALUES.FLEET-D + VHDVS1IW_VALUES.FLEET-E 
    							+ VHDVS1IW_VALUES.FLEET-L + VHDVS1IW_VALUES.FLEET-M + VHDVS1IW_VALUES.FLEET-K;

  
  
  
  
    VHDVS3IW_OPSFLEET.A-CARS = 0;
    VHDVS3IW_OPSFLEET.B-CARS = 0;
    VHDVS3IW_OPSFLEET.C-CARS = 0;
    VHDVS3IW_OPSFLEET.D-CARS = 0;
    VHDVS3IW_OPSFLEET.E-CARS = 0;
    VHDVS3IW_OPSFLEET.L-CARS = 0;
    VHDVS3IW_OPSFLEET.M-CARS = 0;    
    VHDVS3IW_OPSFLEET.K-CARS = 0;
    VAGen_COUNT = 1;
    VAGen_INDEX = 1;
    while (VAGen_COUNT <= VHDVS1IW-TRIGGERS.UROWCNT)
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "CY")
            if (  VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS3IW_OPSFLEET.A-CARS = VHDVS3IW_OPSFLEET.A-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if ( VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
                VHDVS3IW_OPSFLEET.B-CARS = VHDVS3IW_OPSFLEET.B-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C1" || VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C2" )
                VHDVS3IW_OPSFLEET.C-CARS = VHDVS3IW_OPSFLEET.C-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "D1" )
                VHDVS3IW_OPSFLEET.D-CARS = VHDVS3IW_OPSFLEET.D-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "E1" )
                VHDVS3IW_OPSFLEET.E-CARS = VHDVS3IW_OPSFLEET.E-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end             
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "L1" )
                VHDVS3IW_OPSFLEET.L-CARS = VHDVS3IW_OPSFLEET.L-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "M1" )
                VHDVS3IW_OPSFLEET.M-CARS = VHDVS3IW_OPSFLEET.M-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end  
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K1" || VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K2")
                VHDVS3IW_OPSFLEET.K-CARS = VHDVS3IW_OPSFLEET.K-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "DY")
            if (  VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS3IW_OPSFLEET.A-CARS = VHDVS3IW_OPSFLEET.A-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end  
            if ( VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
                VHDVS3IW_OPSFLEET.B-CARS = VHDVS3IW_OPSFLEET.B-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C1" || VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C2" )
                VHDVS3IW_OPSFLEET.C-CARS = VHDVS3IW_OPSFLEET.C-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "D1")
                VHDVS3IW_OPSFLEET.D-CARS = VHDVS3IW_OPSFLEET.D-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "E1" )
                VHDVS3IW_OPSFLEET.E-CARS = VHDVS3IW_OPSFLEET.E-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end             
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "L1")
                VHDVS3IW_OPSFLEET.L-CARS = VHDVS3IW_OPSFLEET.L-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "M1" )
                VHDVS3IW_OPSFLEET.M-CARS = VHDVS3IW_OPSFLEET.M-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K1" || VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K2")
                VHDVS3IW_OPSFLEET.K-CARS = VHDVS3IW_OPSFLEET.K-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "HY")
            if ( VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS3IW_OPSFLEET.A-CARS = VHDVS3IW_OPSFLEET.A-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if ( VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
                VHDVS3IW_OPSFLEET.B-CARS = VHDVS3IW_OPSFLEET.B-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C1" || VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C2" )
                VHDVS3IW_OPSFLEET.C-CARS = VHDVS3IW_OPSFLEET.C-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "D1" )
                VHDVS3IW_OPSFLEET.D-CARS = VHDVS3IW_OPSFLEET.D-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "E1")
                VHDVS3IW_OPSFLEET.E-CARS = VHDVS3IW_OPSFLEET.E-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end             
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "L1" )
                VHDVS3IW_OPSFLEET.L-CARS = VHDVS3IW_OPSFLEET.L-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "M1")
                VHDVS3IW_OPSFLEET.M-CARS = VHDVS3IW_OPSFLEET.M-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K1" || VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K2")
                VHDVS3IW_OPSFLEET.K-CARS = VHDVS3IW_OPSFLEET.K-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "RY")
            if ( VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS3IW_OPSFLEET.A-CARS = VHDVS3IW_OPSFLEET.A-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
                VHDVS3IW_OPSFLEET.B-CARS = VHDVS3IW_OPSFLEET.B-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C1" || VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C2" )
                VHDVS3IW_OPSFLEET.C-CARS = VHDVS3IW_OPSFLEET.C-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "D1")
                VHDVS3IW_OPSFLEET.D-CARS = VHDVS3IW_OPSFLEET.D-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "E1")
                VHDVS3IW_OPSFLEET.E-CARS = VHDVS3IW_OPSFLEET.E-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end             
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "L1")
                VHDVS3IW_OPSFLEET.L-CARS = VHDVS3IW_OPSFLEET.L-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "M1")
                VHDVS3IW_OPSFLEET.M-CARS = VHDVS3IW_OPSFLEET.M-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K1" || VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K2")
                VHDVS3IW_OPSFLEET.K-CARS = VHDVS3IW_OPSFLEET.K-CARS + VHDVS02_DATA.CNT-CARS-IN-FLEET[VAGen_COUNT];
            end
        end 
        VAGen_COUNT = VAGen_COUNT + 1;
    end 
    VHDVS3IW_OPSFLEET.TOTAL = VHDVS3IW_OPSFLEET.C-CARS + VHDVS3IW_OPSFLEET.B-CARS + VHDVS3IW_OPSFLEET.A-CARS 
     						+ VHDVS3IW_OPSFLEET.D-CARS + VHDVS3IW_OPSFLEET.E-CARS;
end 

Function VHDVS1IS-CLEAR () 
    set VHDVS1IW_VALUES empty;
    set VHDVS1I_FAIL empty;
    set VHDVS01_DATA empty;
    set VHDVS02_DATA empty;
    set VHDVS2IW_AVAIL empty;
    set VHDVS2I_RETURN empty;

  
  
  
  
    set VHDVS3I_FLEET empty;

  
  
  
    VHDVS1IW_VALUES.VAGen_DESC[1] = "Previous";
    VHDVS1I_FAIL.VAGen_DESC[1] = "Warranty Failures";
    VHDVS1I_FAIL.VAGen_DESC[2] = "Main Failures";
    VHDVS1I_FAIL.VAGen_DESC[3] = "Yard Failures";
    VHDVS1I_FAIL.VAGen_DESC[4] = "Shopped PM";
    VHDVS1I_FAIL.VAGen_DESC[5] = "Modification";
    VHDVS1I_FAIL.VAGen_DESC[6] = "Misc Action";
    VHDVS1I_FAIL.VAGen_DESC[7] = "Total Removed";

  
    VHDVS2IW_VALUES.VAGen_DESC[1] = "Fleet Removals";
    VHDVS2IW_VALUES.VAGen_DESC[2] = "Fleet Returns";
    VHDVS2IW_VALUES.VAGen_DESC[3] = "Prod Gain/Loss";
  
    VHDVS2I_RETURN.VAGen_DESC[1] = "Repairs";
    VHDVS2I_RETURN.VAGen_DESC[2] = "PM";
    VHDVS2I_RETURN.VAGen_DESC[3] = "Modicications";
    VHDVS2I_RETURN.VAGen_DESC[4] = "Misc Action";
    VHDVS2I_RETURN.VAGen_DESC[5] = "Warranty Reps";
    VHDVS2I_RETURN.VAGen_DESC[6] = "Total Returned";

  
    VHDVS3IW_OPSFLEET.VAGen_DESC = "Fleet";
    VHDVS3IW_VALUES.VAGen_DESC[1] = "Req for Service";
    VHDVS3IW_VALUES.VAGen_DESC[2] = "Avail @ 0400";
    VHDVS3IW_VALUES.VAGen_DESC[3] = "Difference";
    VHDVS3I_FLEET.VAGen_DESC[1] = "Engr Hold";
    VHDVS3I_FLEET.VAGen_DESC[2] = "Parts";
    VHDVS3I_FLEET.VAGen_DESC[3] = "Cars in PM";
    VHDVS3I_FLEET.VAGen_DESC[4] = "Unschd Maint";
    VHDVS3I_FLEET.VAGen_DESC[5] = "Modification";
    VHDVS3I_FLEET.VAGen_DESC[6] = "Warnty Fail";
    VHDVS3I_FLEET.VAGen_DESC[7] = "Tot Not Avail";
end 

Function VHDVS1IS-CONVERT ()
   
    XDATECON-W2.WS-GREG-IN-FLAG = "R";
    XDATECON-W2.WS-RPT-GREG-IN = VHDVS01_CRIT.REPORT-DATE;
    MRSCommonCode.XDATECON-LOAD-TBL();
    MRSCommonCode.XDATECON-GREG2JUL();

  
    XDATECON-W2.WS-JUL-IN = XDATECON-W1.WS-DATES-CYDDD;
    MRSCommonCode.XDATECON-JUL2GREG();
    VHDVS01_CRIT.DATE-INSRV-REV2-MDY = XDATECON-W1.WS-DATES-MDCY;

  
  
    if (XDATECON-W1.WS-DATES-CYDDD-DDD == 1)
        XDATECON-W1.WS-DATES-CYDDD-CY = XDATECON-W1.WS-DATES-CYDDD-CY - 1; 
        XDATECON-W1.WS-DATES-CYDDD-DDD = 31;
         
    else
        XDATECON-W1.WS-DATES-CYDDD = XDATECON-W1.WS-DATES-CYDDD - 1;
    end

  
    XDATECON-W2.WS-JUL-IN = XDATECON-W1.WS-DATES-CYDDD;
    MRSCommonCode.XDATECON-JUL2GREG();
    VHDVS01_CRIT.DATE-INSRV-REV-MDY = XDATECON-W1.WS-DATES-MDCY;

  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHDVS01_CRIT.DATE-INSRV-REV2-MDY;
    MRSCommonCode.XXDATES-CONVERT();
    VHDVS01_CRIT.DATE-INSRV-REPORT = XXDATEW.DATE-YYYY-MM-DD;
    if (VHDVS01_CRIT.REPORT-DATE == "01-01-2000")
        VHDVS01_CRIT.DATE-INSRV-REV-MDY = "12-31-1999";
    end
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHDVS01_CRIT.DATE-INSRV-REV-MDY;
    MRSCommonCode.XXDATES-CONVERT();
    VHDVS01_CRIT.DATE-INSRV-REV = XXDATEW.DATE-YYYY-MM-DD;
    set VHDVS11_DATA empty;
    if (VHDVS2IW-DATETIME.CURRENT-DATE != " ")
        VHDVS11_DATA.REPORT-DATE = VHDVS2IW-DATETIME.CURRENT-DATE;
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHDVS11_DATA.REPORT-DATE;
        MRSCommonCode.XXDATES-CONVERT();
        VHDVS11_DATA.REPORT-DATE = XXDATEW.DATE-YYYY-MM-DD;
    else
        VHDVS11_DATA.REPORT-DATE = " ";
    end
    try
        call "VHDVS11"(XDCONTROL, VHDVS11_DATA);
    
    end
    VHDVS01_CRIT.DATE-INSRV-REV = VHDVS11_DATA.FROM-DATE;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHDVS01_CRIT.DATE-INSRV-REV;
    MRSCommonCode.XXDATES-CONVERT();
    VHDVS01_CRIT.DATE-INSRV-REV-MDY = XXDATEW.DATE-MM-DD-YYYY;
end 

Function VHDVS1IS-GET-DATA ()
  
  
  
  
  
  
  
  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHDVS01";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHDVS1I";
    set VHDVS01_DATA empty;
    set VHDVS02_DATA empty;

    
    try
        call "VHDVS01"(XDCONTROL, VHDVS01_CRIT, VHDVS01_DATA, VHDVS02_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHDVS1IW-TRIGGERS.GOT-DATA = "Y";
            VHDVS1IW-TRIGGERS.UROWCNT = XDCONTROL.UROWCNT;
        else
            XDCONTROL.UROWCNT = 0;
        
        
  
            if (XDCONTROL.URC == 100)
                XXMESSAGE.UMSGCODE = "NO DATA FOUND";
                XXMESSAGE.UMSGINS[1] = "Valid Data";
                XXMESSAGE.UMSGINS[2] = "Search Criteria";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
  
  
  
        ;
    end
end 

Function VHDVS1IS-HOME-YRD ()
  
  
  
  
  
  
  
  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHDVS03";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHDVS1I";
    set VHDVS03_DATA empty;


    
    try
        call "VHDVS03"(XDCONTROL, VHDVS03_CRIT, VHDVS03_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHDVS1IW-TRIGGERS.GOT-DATA = "Y";
            VHDVS1IW-TRIGGERS.HOME-YRD-CNT = XDCONTROL.UROWCNT;
        else
            XDCONTROL.UROWCNT = 0;
        
        
  
            if (XDCONTROL.URC == 100)
                XXMESSAGE.UMSGCODE = "NO DATA FOUND";
                XXMESSAGE.UMSGINS[1] = "Valid Data";
