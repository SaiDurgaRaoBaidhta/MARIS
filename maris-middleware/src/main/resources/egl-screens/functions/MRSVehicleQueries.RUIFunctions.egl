Function VHHF01IS-TYPE-CHK () 
    LOOP-INDEX = 1;
    HOLD-CARS-T = 0;
    HOLD-CARS-A = 0;
    HOLD-CARS-B = 0;
    HOLD-CARS-C = 0;
    HOLD-CARS-D = 0;
    HOLD-CARS-E = 0;
    HOLD-CARS-L = 0;
    HOLD-CARS-M = 0;
    HOLD-CARS-K = 0;    
    REV-SERVICE-A = 0;
    REV-SERVICE-B = 0;
    REV-SERVICE-C = 0;
    REV-SERVICE-D = 0;
    REV-SERVICE-E = 0;
    REV-SERVICE-L = 0;
    REV-SERVICE-M = 0;
    REV-SERVICE-K = 0;
    REV-SERVICE-T = 0;
    TOTAL-MAINT-A = 0;
    TOTAL-MAINT-B = 0;
    TOTAL-MAINT-C = 0;
    TOTAL-MAINT-D = 0;
    TOTAL-MAINT-E = 0;
    TOTAL-MAINT-L = 0;
    TOTAL-MAINT-M = 0;
    TOTAL-MAINT-K = 0;
    TOTAL-MAINT-T = 0;
    WARRANTY-A = 0;
    WARRANTY-B = 0;
    WARRANTY-C = 0;
    WARRANTY-D = 0;
    WARRANTY-E = 0;
    WARRANTY-L = 0;
    WARRANTY-M = 0;
    WARRANTY-K = 0;    
    WARRANTY-T = 0;
    UNSCHD-MAIN-A = 0;
    UNSCHD-MAIN-B = 0;
    UNSCHD-MAIN-C = 0;
    UNSCHD-MAIN-D = 0;
    UNSCHD-MAIN-E = 0;
    UNSCHD-MAIN-L = 0;
    UNSCHD-MAIN-M = 0;
    UNSCHD-MAIN-K = 0;
    UNSCHD-MAIN-T = 0;
    WAITPART-UM-A = 0;
    WAITPART-UM-B = 0;
    WAITPART-UM-C = 0;
    WAITPART-UM-D = 0;
    WAITPART-UM-E = 0;
    WAITPART-UM-L = 0;
    WAITPART-UM-M = 0;
    WAITPART-UM-K = 0;
    WAITPART-UM-T = 0;
    PREVEN-MAIN-A = 0;
    PREVEN-MAIN-B = 0;
    PREVEN-MAIN-C = 0;
    PREVEN-MAIN-D = 0;
    PREVEN-MAIN-E = 0;
    PREVEN-MAIN-L = 0;
    PREVEN-MAIN-M = 0;
    PREVEN-MAIN-K = 0;
    PREVEN-MAIN-T = 0;
    ENGRNG-HOLD-A = 0;
    ENGRNG-HOLD-B = 0;
    ENGRNG-HOLD-C = 0;
    ENGRNG-HOLD-D = 0;
    ENGRNG-HOLD-E = 0;
    ENGRNG-HOLD-L = 0;
    ENGRNG-HOLD-M = 0;
    ENGRNG-HOLD-K = 0;
    ENGRNG-HOLD-T = 0;
    MODIFY-CARS-A = 0;
    MODIFY-CARS-B = 0;
    MODIFY-CARS-C = 0;
    MODIFY-CARS-D = 0;
    MODIFY-CARS-E = 0;
    MODIFY-CARS-L = 0;
    MODIFY-CARS-M = 0;
    MODIFY-CARS-K = 0;
    MODIFY-CARS-T = 0;
    MISCEL-HOLD-A = 0;
    MISCEL-HOLD-B = 0;
    MISCEL-HOLD-C = 0;
    MISCEL-HOLD-D = 0;
    MISCEL-HOLD-E = 0;
    MISCEL-HOLD-L = 0;
    MISCEL-HOLD-M = 0;
    MISCEL-HOLD-K = 0; 
    MISCEL-HOLD-T = 0;
    GO-AVAIL-A = 0;
    GO-AVAIL-B = 0;
    GO-AVAIL-C = 0;
    GO-AVAIL-D = 0;
    GO-AVAIL-E = 0;
    GO-AVAIL-L = 0;
    GO-AVAIL-M = 0;
    GO-AVAIL-K = 0;
    GO-AVAIL-T = 0;
    TOTAL-FLEET-A = 0;
    TOTAL-FLEET-B = 0;
    TOTAL-FLEET-C = 0;
    TOTAL-FLEET-D = 0;
    TOTAL-FLEET-E = 0;
    TOTAL-FLEET-L = 0;
    TOTAL-FLEET-M = 0;
    TOTAL-FLEET-K = 0;
    TOTAL-FLEET-T = 0;
    while ((LOOP-INDEX <= TOTAL-CAR-COUNT))
        if (VHHF01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "A")
            VHHF01IS-TYPE-A(); 
        else
            if (VHHF01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "B")
                VHHF01IS-TYPE-B(); 
            else
                if (VHHF01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "C")
					
					
					
					
                    VHHF01IS-TYPE-C(); 
  					
                end
                if (VHHF01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "D")
                	VHHF01IS-TYPE-D();
                else 
                	if (VHHF01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "E")
                		VHHF01IS-TYPE-E();
                	else
                		if (VHHF01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "L")
                			VHHF01IS-TYPE-L();
                		else 
                			if (VHHF01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "M")
                				VHHF01IS-TYPE-M();
                			end
                		end
                	end                	
                end
                if (VHHF01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "K")
                	VHHF01IS-TYPE-K();
                end
            end
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end

  
    VHHF01B_CRIT.YRD = VHHF01A_CRIT.HOME-YRD-OCCR[YARD-INDEX];
    try
        call "VHHF01B"(XDCONTROL, VHHF01B_CRIT, VHHF01B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHHF01IW.REQD-COUNT = XDCONTROL.UROWCNT;
        VHHF01IS-REQD-CHK();
    else

    end
    if (VHHF01A_CRIT.HOME-YRD-OCCR[YARD-INDEX] == "CY")
        VHHF01IS-MOVE-CY();
    else
        if (VHHF01A_CRIT.HOME-YRD-OCCR[YARD-INDEX] == "DY")
            VHHF01IS-MOVE-DY();
        else
            if (VHHF01A_CRIT.HOME-YRD-OCCR[YARD-INDEX] == "HY")
                VHHF01IS-MOVE-HY();
            else
                if (VHHF01A_CRIT.HOME-YRD-OCCR[YARD-INDEX] == "RY")
                    VHHF01IS-MOVE-RY();
                end
            end
        end
    end
    VHHF01IW-TRIGGER.LOAD-DATA = "Y";
end 




Function VHHF02IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  

  
  
  
   
    set VHHF02A_CRIT empty;
    VHHF02A_CRIT.REPT-TYPE = VHDVS4IW-PASSVALUE.VTAM-NAME;
  

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHHF02I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHHF02A";

    
    try
        call "VHHF02A"(XDCONTROL, VHHF02A_CRIT, VHHF02A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
            VHDVS4IW-TRIGGER.SUBMIT = "Y";
        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHMC01IS-CLEAR () 
    VHMC01IW.WS-CURRENT-DATE = VGVar.currentFormattedGregorianDate;
    VHMC01IW.MINUTES = 10;
  
    try
        call "VHMC01A"(XDCONTROL, VHMC01A_CRIT, VHMC01A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHMC01IW.FROM-DATE = VHMC01A_DATA.FROM-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHMC01IW.FROM-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHMC01IW.FROM-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHMC01IW.FROM-DATE-FILLER1 = "-";
        VHMC01IW.FROM-DATE-FILLER2 = "-";
    end
    try
        call "VHMC01B"(XDCONTROL, VHMC01B_CRIT, VHMC01B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHMC01IW.TO-DATE = VHMC01B_DATA.TO-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHMC01IW.TO-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHMC01IW.TO-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHMC01IW.TO-DATE-FILLER1 = "-";
        VHMC01IW.TO-DATE-FILLER2 = "-";
    end
  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHMC01C";
    try
        call "VHMC01C"(XDCONTROL, VHMC01C_CRIT, VHMC01C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHMC01C_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    VHMC01IW.YRD = "ALL";
    VHMC01I_MESSAGE.MESG1 = "                                                                                   ";
    VHMC01I_MESSAGE.MESG2 = "                                                                                   ";
    VHMC01I_MESSAGE.MESG3 = "                                                                                   ";

  
  
    VHMC01IW.YRD-DROP = "                        ";
    VHMC01IW.MINUTES = 10;
end 

Function VHMC01IS-HARD-COPY () 
    if (VHMC01IW-TRIGGER.PRX-ID > 0)
        WS100IW-TRIGGER_Level77Items.ENABLE-HARD = "Y";
        VHMC01IW-TRIGGER.VTAM-NAME = WS70A01_DATA.VTAM-NAME[VHMC01IW-TRIGGER.PRX-ID];
    else
        WS100IW-TRIGGER_Level77Items.DISABLE-HARD = "Y";
    end
end 

Function VHMC01IS-INIT () 
    VHMC01IW.WS-CURRENT-DATE = VGVar.currentFormattedGregorianDate;
    VHMC01IW.MINUTES = 10;
    VHMC01IW.WHICH-REPORT = 0;
    try
