    TOTAL-FLEET-M = 0;
    TOTAL-FLEET-K = 0;
    TOTAL-FLEET-T = 0;
    while ((LOOP-INDEX <= TOTAL-CAR-COUNT))
        if (VHFR01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "A")
            VHFR01IS-TYPE-A(); 
        else
            if (VHFR01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "B")
                VHFR01IS-TYPE-B(); 
            else
                if (VHFR01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "C")
                    if (VHFR01A_DATA.ATO-PRESENT-IND[LOOP-INDEX] == "Y")
                        VHFR01IS-TYPE-CW(); 
                    else
                        VHFR01IS-TYPE-CO(); 
                    end
                end
                    
                if (VHFR01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "D")
            		VHFR01IS-TYPE-D();       
                else
                	if  (VHFR01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "E")
            			VHFR01IS-TYPE-E();  
            		end
            	end
                if (VHFR01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "L")
            		VHFR01IS-TYPE-L();       
                else
                	if  (VHFR01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "M")
            			VHFR01IS-TYPE-M();  
            		end
            	end            	
            	if  (VHFR01A_DATA.CAR-TYPE-1[LOOP-INDEX] == "K")
            			VHFR01IS-TYPE-K();  
            	end
            end
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end

  
    CAR-A-DATA[1] = TOTAL-FLEET-A;
    CAR-B-DATA[1] = TOTAL-FLEET-B;
