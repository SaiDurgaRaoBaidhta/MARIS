    end
end 

Function VHMC01IS-SUBMIT-M () 
    VHMC01IW-TRIGGER.OK-SUBMIT = "Y";
    VHMC01IW.NULL-TO-ERROR = "N";
    VHMC01IW.INVALID-TO-DATE = " ";
    VHMC01IW.INVALID-FROM-DATE = " ";
    if (VHMC01IW.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHMC01IW.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHMC01IW.INVALID-FROM-DATE = "Y";
            
   
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHMC01I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHMC01IW.TO-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHMC01IW.TO-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHMC01I_MESSAGE.MESG1 = "INVALID TO DATE";
            VHMC01IW.INVALID-TO-DATE = "Y";
            
  
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHMC01I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHMC01IW.YRD == "   ")
        VHMC01I_MESSAGE.MESG1 = "INVALID YARD SELECTION";
        VHMC01IW.INVALID-YRD = "Y";
        AFCXVLDW.NO-ERROR = "N";
    end
    if (VHMC01IW.MINUTES == 0.0)
        VHMC01I_MESSAGE.MESG1 = "INVALID MINUTES CRITERIA";
        VHMC01IW.INVALID-MINUTES = "Y";
        AFCXVLDW.NO-ERROR = "N";
    end
    if (VHMC01IW.INVALID-FROM-DATE == "Y")
        VHMC01I_MESSAGE.MESG1 = "INVALID FROM DATE";
        VHMC01IW-TRIGGER.OK-SUBMIT = "N";
    else
  
        if (VHMC01IW.TO-DATE != " ")
            if ((VHMC01IW.TO-DATE-YEAR-NUM > VHMC01IW.WS-CURR-YEAR-NUM) ||
             (VHMC01IW.TO-DATE-YEAR-NUM == VHMC01IW.WS-CURR-YEAR-NUM &&
             VHMC01IW.TO-DATE-MO-NUM > VHMC01IW.WS-CURR-MO-NUM) ||
             (VHMC01IW.TO-DATE-YEAR-NUM == VHMC01IW.WS-CURR-YEAR-NUM &&
             VHMC01IW.TO-DATE-MO-NUM == VHMC01IW.WS-CURR-MO-NUM &&
             VHMC01IW.TO-DATE-DAY-NUM > VHMC01IW.WS-CURR-DA-NUM))
                VHMC01I_MESSAGE.MESG1 = "To date cannot be greater than CURRENT_DATE.";
                VHMC01IW.INVALID-TO-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                
  
            end
        end
    end
    if (VHMC01IW.INVALID-TO-DATE == "Y")
        VHMC01IW-TRIGGER.OK-SUBMIT = "N";
    end
    if (VHMC01IW-TRIGGER.OK-SUBMIT == "Y")
  
        if (VHMC01IW.FROM-DATE != " " && VHMC01IW.TO-DATE != " ")
            if ((VHMC01IW.FROM-DATE-YEAR-NUM > VHMC01IW.TO-DATE-YEAR-NUM) ||
             (VHMC01IW.FROM-DATE-YEAR-NUM == VHMC01IW.TO-DATE-YEAR-NUM &&
             VHMC01IW.FROM-DATE-MO-NUM > VHMC01IW.TO-DATE-MO-NUM) ||
             (VHMC01IW.FROM-DATE-YEAR-NUM == VHMC01IW.TO-DATE-YEAR-NUM &&
             VHMC01IW.FROM-DATE-MO-NUM == VHMC01IW.TO-DATE-MO-NUM &&
             VHMC01IW.FROM-DATE-DAY-NUM > VHMC01IW.TO-DATE-DAY-NUM))
                VHMC01I_MESSAGE.MESG1 = "From date cannot be greater than To date.";
                VHMC01IW.INVALID-FROM-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                VHMC01IW-TRIGGER.OK-SUBMIT = "N";
                
  
            end
        end
    end

  
  
  
  
  
  
  
   
   
   
    if (AFCXVLDW.NO-ERROR == "N")
        VHMC01IW-TRIGGER.OK-SUBMIT = " ";
    else
        VHMC01IW-TRIGGER.OK-SUBMIT-MAKE = "Y ";
    end
end 

