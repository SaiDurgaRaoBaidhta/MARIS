    CAR-CO-DATA[1] = TOTAL-FLEET-CO;
    CAR-D-DATA[1] = TOTAL-FLEET-D;
    CAR-E-DATA[1] = TOTAL-FLEET-E;
    CAR-L-DATA[1] = TOTAL-FLEET-L;
    CAR-M-DATA[1] = TOTAL-FLEET-M;
    CAR-K-DATA[1] = TOTAL-FLEET-K;
    CAR-TOTAL-DATA[1] = TOTAL-FLEET-T;

  
    CAR-A-DATA[2] = HOLD-CARS-A;
