Function VHDC01IS-PRINT-NBK ()
  
  
  
  
  
  
  
  
  
  

  
  
  
   
    set VHDC012_CRIT empty;
    VHDC012_CRIT.REPT-TYPE = VHDC01IW.CICS-VTAM-NAME;
    VHDC012_CRIT.REPT-ID = "REPRINT";
    VHDC012_CRIT.USER-GRP = VH01A01_DATA.USER-GROUP;
    VHDC012_CRIT.TERM-ID = VH01A01_DATA.TERM-ID;
    VHDC012_CRIT.INCD-NO = VHDC01IW.INCIDENT-NO;
    VHDC012_CRIT.CON-CAR-1 = VHDC01IW.CAR-NO;

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHDC01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHDC012";

    
    try
        call "VHDC012"(XDCONTROL, VHDC012_CRIT, VHDC012_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
            VHDC01IW-TRIGGER.OK = "Y";
        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHDC01IS-VALID-CAR ()
  
  
  
  
  
  
  
   
    VHDC013_CRIT.CAR-NO = VHDC01IW.CAR-NO;
    VHDC013_CRIT.INCD-NO = VHDC01IW.INCIDENT-NO;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHDC01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHDC013";

    
    try
        call "VHDC013"(XDCONTROL, VHDC013_CRIT, VHDC013_DATA);
    
    end
    if (VHDC013_DATA.CAR-NO not blanks)
       
		
    	 try
	    	call "printDnC" (VHDC01IW.CICS-VTAM-NAME, "CT", VHDC013_CRIT.CAR-NO, VHDC013_CRIT.INCD-NO);
    	end
    end
    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (XDCONTROL.UROWCNT > 0)
                VHDC01IS-PRINT-NBK();
            else
                VHDC01IW-TRIGGER.ERROR-CAR = "Y";
            end
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHDP01IS-CLEAR () 
    VHDP01I_MESSAGE.MESG1 = "                                                                                   ";
    VHDP01I_MESSAGE.MESG2 = "                                                                                   ";
    VHDP01I_MESSAGE.MESG3 = "                                                                                   ";
    VHDP01IW.WS-CURRENT-DATE = VGVar.currentFormattedGregorianDate;
    try
        call "VHDP01A"(XDCONTROL, VHDP01A_CRIT, VHDP01A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHDP01IW.FROM-DATE = VHDP01A_DATA.FROM-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHDP01IW.FROM-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHDP01IW.FROM-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHDP01IW.FROM-DATE-FILLER1 = "-";
        VHDP01IW.FROM-DATE-FILLER2 = "-";
    end
    try
        call "VHDP01B"(XDCONTROL, VHDP01B_CRIT, VHDP01B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHDP01IW.TO-DATE = VHDP01B_DATA.TO-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHDP01IW.TO-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHDP01IW.TO-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHDP01IW.TO-DATE-FILLER1 = "-";
        VHDP01IW.TO-DATE-FILLER2 = "-";
    end
end 

Function VHDP01IS-HARD-COPY () 
    if (VHDP01IW-TRIGGER.PRX-ID > 0)
        WS100IW-TRIGGER_Level77Items.ENABLE-HARD = "Y";
        VHDP01IW-TRIGGER.VTAM-NAME = WS70A01_DATA.VTAM-NAME[VHDP01IW-TRIGGER.PRX-ID];
    else
        WS100IW-TRIGGER_Level77Items.DISABLE-HARD = "Y";
    end
end 

Function VHDP01IS-INIT () 
    VHDP01IW.WS-CURRENT-DATE = VGVar.currentFormattedGregorianDate;
    try
        call "VHDP01A"(XDCONTROL, VHDP01A_CRIT, VHDP01A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHDP01IW.FROM-DATE = VHDP01A_DATA.FROM-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHDP01IW.FROM-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHDP01IW.FROM-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHDP01IW.FROM-DATE-FILLER1 = "-";
        VHDP01IW.FROM-DATE-FILLER2 = "-";
    end
    try
        call "VHDP01B"(XDCONTROL, VHDP01B_CRIT, VHDP01B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHDP01IW.TO-DATE = VHDP01B_DATA.TO-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHDP01IW.TO-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHDP01IW.TO-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHDP01IW.TO-DATE-FILLER1 = "-";
        VHDP01IW.TO-DATE-FILLER2 = "-";
    end
    VHDP01I_MESSAGE.MESG1 = "                                                                                   ";
    VHDP01I_MESSAGE.MESG2 = "                                                                                   ";
    VHDP01I_MESSAGE.MESG3 = "                                                                                   ";
end 

Function VHDP01IS-INIT-X ()
  
  
  
  
  
  
  
  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "WS100I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS70A01";

    
    try
        call "WS70A01"(XDCONTROL, WS70A01_DATA);
    
    end
    

  
    MRSCommonCode.XXA0IS-CHECK_EXT();

  
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

