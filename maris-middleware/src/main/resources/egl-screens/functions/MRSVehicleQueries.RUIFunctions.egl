Function VHSV01IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  

  
  
  
   
    VHSV01IS-SUBMIT-X();
    if (VHSV01IW-TRIGGER.OK-SUBMIT == "Y")
        set VHSV012_CRIT empty;
        VHSV012_CRIT.REPT-TYPE = VHSV01IW-PASSVALUE.VTAM-NAME;
        VHSV012_CRIT.REPT-ID = VHSV01IW.REPORT-INDEX;
        VHSV012_CRIT.CON-CAR-1 = VHSV01IW.CAR-NO;
        VHSV012_CRIT.DATE-REPT-FROM = VHSV01IW.FROM-DATE;
        XXDATEW.DATE-MM-DD-YYYY = VHSV012_CRIT.DATE-REPT-FROM;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHSV012_CRIT.DATE-REPT-FROM = XXDATEW.DATE-YYYY-MM-DD;
        VHSV012_CRIT.DATE-REPT-TO = VHSV01IW.TO-DATE;
        XXDATEW.DATE-MM-DD-YYYY = VHSV012_CRIT.DATE-REPT-TO;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHSV012_CRIT.DATE-REPT-TO = XXDATEW.DATE-YYYY-MM-DD;
        VHSV012_CRIT.SYMP-CD = VHSV01IW.SYMP-CD-FROM;
        VHSV012_CRIT.SYMP-CD-TO = VHSV01IW.SYMP-CD-TO;
        VHSV012_CRIT.DEFERRED-ITEM = VHSV01IW.DEF-ITEMS;

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHSV01I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHSV012";

    
        try
            call "VHSV012"(XDCONTROL, VHSV012_CRIT, VHSV012_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
                VHSV01IW-TRIGGER.SUBMIT = "Y";
            else

        


        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

Function VHSV01IS-SUBMIT-X () 
    VHSV01IW-TRIGGER.OK-SUBMIT = "N";
    VHSV01IW.CAR-NO = VHSV01IW.CAR-NO-NUM;
    if (VHSV01IW.CAR-NO == " ")
        VHSV01IW.CAR-MESSAGE = "Car no field cannot be blank";
        VHSV01IW.INVALID-CAR-NO = "Y";
        return;
    else
        if (VHSV01IW.CAR-NO not numeric)
            VHSV01IW.CAR-MESSAGE = "Invalid Car No.";
            VHSV01IW.INVALID-CAR-NO = "Y";
            return;
        else
      
            VHINC6A_CRIT.CAR-NO = VHSV01IW.CAR-NO;
            try
                call "MRSVehicleIncident.VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
            
            end
            if (XDCONTROL.UROWCNT == 1)

            else
                if (XDCONTROL.URC == 100)
                    VHSV01IW.CAR-MESSAGE = "Car no does not exist";
                    INVALID-CAR-NO = "Y";
                     
                    return;
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                end
            end
        end
    end
    if (VHSV01IW.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHSV01IW.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHSV01IW.CAR-MESSAGE = "Invalid From date.";
            VHSV01IW.INVALID-FROM-DATE = "Y";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHSV01IW.TO-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHSV01IW.TO-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHSV01IW.CAR-MESSAGE = "Invalid To date.";
            VHSV01IW.INVALID-TO-DATE = "Y";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end

  
    if (VHSV01IW.TO-DATE != " ")
        if ((VHSV01IW.TO-DATE-YEAR-NUM > VHSV01IW.WS-CURR-YEAR-NUM) ||
         (VHSV01IW.TO-DATE-YEAR-NUM == VHSV01IW.WS-CURR-YEAR-NUM &&
         VHSV01IW.TO-DATE-MO-NUM > VHSV01IW.WS-CURR-MO-NUM) ||
         (VHSV01IW.TO-DATE-YEAR-NUM == VHSV01IW.WS-CURR-YEAR-NUM &&
         VHSV01IW.TO-DATE-MO-NUM == VHSV01IW.WS-CURR-MO-NUM &&
         VHSV01IW.TO-DATE-DAY-NUM > VHSV01IW.WS-CURR-DA-NUM))
            VHSV01IW.CAR-MESSAGE = "To date cannot be greater than CURRENT_DATE.";
            VHSV01IW.INVALID-TO-DATE = "Y";
            return;
        end
    end

  
    if (VHSV01IW.FROM-DATE != " " && VHSV01IW.TO-DATE != " ")
        if ((VHSV01IW.FROM-DATE-YEAR-NUM > VHSV01IW.TO-DATE-YEAR-NUM) ||
         (VHSV01IW.FROM-DATE-YEAR-NUM == VHSV01IW.TO-DATE-YEAR-NUM &&
         VHSV01IW.FROM-DATE-MO-NUM > VHSV01IW.TO-DATE-MO-NUM) ||
         (VHSV01IW.FROM-DATE-YEAR-NUM == VHSV01IW.TO-DATE-YEAR-NUM &&
         VHSV01IW.FROM-DATE-MO-NUM == VHSV01IW.TO-DATE-MO-NUM &&
         VHSV01IW.FROM-DATE-DAY-NUM > VHSV01IW.TO-DATE-DAY-NUM))
            VHSV01IW.CAR-MESSAGE = "From date cannot be greater than To date.";
            VHSV01IW.INVALID-FROM-DATE = "Y";
            return;
        end
    end
    if (VHSV01IW.SYMP-CD-FROM != " " &&
     VHSV01IW.SYMP-CD-TO != " ")
        if (VHSV01IW.SYMP-CD-TO-NUM < VHSV01IW.SYMP-CD-FROM-NUM)
            VHSV01IW.CAR-MESSAGE = "Value of 'Symp Cd To' should be >= 'Symp Cd From' value";
            VHSV01IW-TRIGGER.INVALID-SYMP-TO = "Y";
            return;
        end
    end
    if (VHSV01IW.SYMP-CD-FROM != " ")
        if (VHSV01IW.SYMP-CD-FROM not numeric)
            VHSV01IW.CAR-MESSAGE = "Invalid From symp cd";
            VHSV01IW-TRIGGER.INVALID-SYMP-FROM = "Y";
            return;
        end
    end
    if (VHSV01IW.SYMP-CD-TO == " ")
        VHSV01IW.SYMP-CD-TO = VHSV01IW.SYMP-CD-FROM;
    end
    if (VHSV01IW.SYMP-CD-TO != " ")
        if (VHSV01IW.SYMP-CD-TO not numeric)
            VHSV01IW.CAR-MESSAGE = "Invalid To symp cd";
            VHSV01IW-TRIGGER.INVALID-SYMP-TO = "Y";
            return;
        end
    end
    if (REPORT-INDEX == 2)
        if (VHSV01IW.DEF-ITEMS != " ")
            if (VHSV01IW.DEF-ITEMS != "A" &&
             VHSV01IW.DEF-ITEMS != "a" &&
             VHSV01IW.DEF-ITEMS != "B" &&
             VHSV01IW.DEF-ITEMS != "b" &&
             VHSV01IW.DEF-ITEMS != "C" &&
             VHSV01IW.DEF-ITEMS != "c" &&
             VHSV01IW.DEF-ITEMS != "ALL" &&
             VHSV01IW.DEF-ITEMS != "all")
                VHSV01IW.CAR-MESSAGE = "Invalid Deferred item entered/selected";
                VHSV01IW.DEF-ITEMS-ERROR = "Y";
                return;
            end
        end
    end
    VHSV01IW-TRIGGER.OK-SUBMIT = "Y";
end 

Function VHSV02AS-BUILD-SQL ()
   
    VHSV02AW1.WHERE-CLAUSE = " ";
    VHSV02AW1.WHERE-1 = " WHERE T1.CAR_NO = '";
    VHSV02AW1.WHERE-2 = VHSV02A_CRIT.CAR-NO;
  
  
    VHSV02AW1.WHERE-3 = "' ";
    if (VHSV02A_CRIT.SYMP-CD-FROM != " ")
        VHSV02AW1.WHERE-4-1 = " AND T1.SYMP_CD >= '";
        VHSV02AW1.WHERE-4-2 = VHSV02A_CRIT.SYMP-CD-FROM;
        VHSV02AW1.WHERE-4-3 = "'";
    else
        VHSV02AW1.WHERE-4 = " ";
    end
    if (VHSV02A_CRIT.SYMP-CD-TO != " ")
        VHSV02AW1.WHERE-5-1 = " AND T1.SYMP_CD <= '";
        VHSV02AW1.WHERE-5-2 = VHSV02A_CRIT.SYMP-CD-TO;
        VHSV02AW1.WHERE-5-3 = "'";
    else
        VHSV02AW1.WHERE-5 = " ";
    end
    if (VHSV02A_CRIT.INCD-DATE-FROM != " ")
        VHSV02AW1.WHERE-6-1 = " AND to_char(T1.DATETIME_INCD_OCCR,'yyyy-mm-dd') >= '";
        VHSV02AW1.WHERE-6-2 = VHSV02A_CRIT.INCD-DATE-FROM;
        VHSV02AW1.WHERE-6-3 = "'";
    else
        VHSV02AW1.WHERE-6 = " ";
    end
    if (VHSV02A_CRIT.INCD-DATE-TO != " ")
        VHSV02AW1.WHERE-7-1 = " AND to_char(T1.DATETIME_INCD_OCCR,'yyyy-mm-dd') <= '";
        VHSV02AW1.WHERE-7-2 = VHSV02A_CRIT.INCD-DATE-TO;
        VHSV02AW1.WHERE-7-3 = "'";
    else
        VHSV02AW1.WHERE-7 = " ";
    end
    if (VHSV02A_CRIT.REPORT-INDEX == 1) 
        if (VHSV02A_CRIT.DEF-ITEMS != " ")
            VHSV02AW1.WHERE-8 = " AND T1.VEH_INCD_STAT IN ('DEF')";
            if (VHSV02A_CRIT.DEF-ITEMS == "ALL")
                VHSV02AW1.WHERE-9 = " ";
            else
                VHSV02AW1.WHERE-9-1 = " AND T1.DEFERRED_PRIORITY '";
                VHSV02AW1.WHERE-9-2 = VHSV02A_CRIT.DEF-ITEMS;
                VHSV02AW1.WHERE-9-3 = "'";
            end
        else
            VHSV02AW1.WHERE-8 = " AND T1.VEH_INCD_STAT NOT IN ('CLO')";
        end
    else
        if (VHSV02A_CRIT.REPORT-INDEX == 2) 
            if (VHSV02A_CRIT.DEF-ITEMS != " ")
                VHSV02AW1.WHERE-8 = " AND T1.VEH_INCD_STAT IN ('DEF')";
                if (VHSV02A_CRIT.DEF-ITEMS == "ALL")
                    VHSV02AW1.WHERE-9 = " ";
                else
                    VHSV02AW1.WHERE-9-1 = " AND T1.DEFERRED_PRIORITY '";
                    VHSV02AW1.WHERE-9-2 = VHSV02A_CRIT.DEF-ITEMS;
                    VHSV02AW1.WHERE-9-3 = "'";
                end
            else
                VHSV02AW1.WHERE-8 = " AND T1.VEH_INCD_STAT NOT IN ('REP','USE','PMS','CLO')";
            end
  
  
  
  
        end
    end
    VHSV02AW1.WHERE-10 = " AND T1.DELETE_IND = 'N'";
end 

Function VHSV02IS-DATE-DIFF () 
    XDATECON-W2.WS-GREG-IN-FLAG = "R";
    XDATECON-W2.WS-RPT-GREG-IN = VGVar.currentFormattedGregorianDate;
    MRSCommonCode.XDATECON-LOAD-TBL();
    MRSCommonCode.XDATECON-GREG2JUL();
    VHSV02IW.JULIAN-DATE-1 = XDATECON-W1.WS-DATES-CYDDD;
    VHSV02IW.DATE-NXT-CAR-WASH = VHSV02A_DATA_01.DATE-NXT-CAR-WASH;
    if (VHSV02IW.DATE-NXT-CAR-WASH != " ")
        XDATECON-W2.WS-GREG-IN-FLAG = "R";
        XDATECON-W2.WS-RPT-GREG-IN = VHSV02A_DATA_01.DATE-NXT-CAR-WASH;
        MRSCommonCode.XDATECON-LOAD-TBL();
        MRSCommonCode.XDATECON-GREG2JUL();
        VHSV02IW.JULIAN-DATE-2 = XDATECON-W1.WS-DATES-CYDDD;
        JULIAN-DATE-DIFF = JULIAN-DATE-2 - JULIAN-DATE-1;
        if (JULIAN-DATE-DIFF >= 0)
            VHSV02A_DATA_01.WASH-OD = 0;
        else
            JULIAN-DATE-DIFF = JULIAN-DATE-1 - JULIAN-DATE-2;
            VHSV02A_DATA_01.WASH-OD = JULIAN-DATE-DIFF;
        end
    else
        VHSV02A_DATA_01.WASH-OD = 0;
    end
end 

Function VHSV02IS-GET-ORI () 
    if (VHSV02A_DATA_01.LFT-ORIENTATION-CD ==
     VHSV02A_DATA_01.VAGen_ORIENTATION)
        VHSV02IW-PASSVALUE.LFT-ORIENT = VHSV02A_DATA_01.LFT-ORIENTATION-CD;
        VHSV02IW-PASSVALUE.RGT-ORIENT = " ";
    else
        if (VHSV02A_DATA_01.RGT-ORIENTATION-CD ==
         VHSV02A_DATA_01.VAGen_ORIENTATION)
            VHSV02IW-PASSVALUE.RGT-ORIENT = VHSV02A_DATA_01.RGT-ORIENTATION-CD;
            VHSV02IW-PASSVALUE.LFT-ORIENT = " ";
        end
    end
    VHSV02IW-PASSVALUE.CAR-NO-D = VHSV02IW-PASSVALUE.GR1-CAR1;

   if (strLib.indexOf(VHSV02A_DATA_01.SOFT_VER, "$")>0)
    	VHSV02IW-PASSVALUE.GR1_CAR1_SVER = "$" + strLib.clip( VHSV02IW-PASSVALUE.GR1-CAR1, 0);
    else
    	VHSV02IW-PASSVALUE.GR1_CAR1_SVER = strLib.clip( VHSV02IW-PASSVALUE.GR1-CAR1, 0);
    end
end 

Function VHSV02IS-MOVE-CARS () 
   tstErr string ;
   txt char(6);
   isleft boolean ;

    if (VHSV02A_DATA_03.INCD-CON-NO[INCD-INDEX] == " ")
    	VHSV02IW.CON_DASH_NO = " ";
        VHSV02IW.INCD-CON-NO = " ";
        VHSV02IW.CAR-NO-1 = " ";
        VHSV02IW.CAR-NO-2 = " ";
        VHSV02IW.CAR-NO-3 = " ";
        VHSV02IW.CAR-NO-4 = " ";
        VHSV02IW.CAR-NO-5 = " ";
        VHSV02IW.CAR-NO-6 = " ";
        VHSV02IW.CAR-NO-7 = " ";
        VHSV02IW.CAR-NO-8 = " ";
        VHSV02IW.CAR-NO-9 = " ";
        VHSV02IW.CAR-NO-10 = " ";
        VHSV02IW.CARNOTXT1 = " ";
        VHSV02IW.CARNOTXT2 = " ";
        VHSV02IW.CARNOTXT3 = " ";
        VHSV02IW.CARNOTXT4 = " ";
        VHSV02IW.CARNOTXT5 = " ";
        VHSV02IW.CARNOTXT6 = " ";
        VHSV02IW.CARNOTXT7 = " ";
        VHSV02IW.CARNOTXT8 = " ";
        VHSV02IW.CARNOTXT9 = " ";
        VHSV02IW.CARNOTXT10 = " ";
    else
    	
        VHSV02IW.INCD-CON-NO = VHSV02A_DATA_03.INCD-CON-NO[INCD-INDEX] ;
        if( VHSV02A_DATA_03.INCD-DASH-NO[INCD-INDEX]>0 ) 
        	fmtStr string = "(##)";      
            dashStr string = strLib.formatNumber( VHSV02A_DATA_03.INCD-DASH-NO[INCD-INDEX], fmtStr);
        	VHSV02IW.CON_DASH_NO = VHSV02A_DATA_03.INCD-CON-NO[INCD-INDEX] +"-"+ dashStr; 
        end
        
        
    	
        VHSV02IW.CAR-NO-1 = VHSV02C_DATA.CAR-NO[1];
        VHSV02IW.CAR-NO-2 = VHSV02C_DATA.CAR-NO[2];
        VHSV02IW.CAR-NO-3 = VHSV02C_DATA.CAR-NO[3];
        VHSV02IW.CAR-NO-4 = VHSV02C_DATA.CAR-NO[4];
        VHSV02IW.CAR-NO-5 = VHSV02C_DATA.CAR-NO[5];
        VHSV02IW.CAR-NO-6 = VHSV02C_DATA.CAR-NO[6];
        VHSV02IW.CAR-NO-7 = VHSV02C_DATA.CAR-NO[7];
        VHSV02IW.CAR-NO-8 = VHSV02C_DATA.CAR-NO[8];
        VHSV02IW.CAR-NO-9 = VHSV02C_DATA.CAR-NO[9];
        VHSV02IW.CAR-NO-10 = VHSV02C_DATA.CAR-NO[10];
        
        

        

        
        for (i int from 1 to 10 by 1)
        	tstErr="22-0";
        	txt = "      ";
	        isleft = FALSE;
			
	        if (VHSV02C_DATA.ORIENTATION[i] != null)
	    			isleft  = strLib.indexOf( "<O({vblm", VHSV02C_DATA.ORIENTATION[i] ) > 0;
	    		tstErr="22-1";
	  		    if(isleft)
	        		txt = VHSV02C_DATA.ORIENTATION[i] + VHSV02C_DATA.CAR-NO[i];
	        		tstErr="22-1A";
	        	else
	        		txt = VHSV02C_DATA.CAR-NO[i] + VHSV02C_DATA.ORIENTATION[i];
	        		tstErr="22-1B";
	        	end
	        end
        	
        	
        	
        	tstErr="22-1C";
        	VHSV02C_DATA.CARNOTXT[i] = txt;
        	
        	
        end
		tstErr="31";
		VHSV02IW.CARNOTXT1 = VHSV02C_DATA.CARNOTXT[1];
        VHSV02IW.CARNOTXT2 = VHSV02C_DATA.CARNOTXT[2];
        VHSV02IW.CARNOTXT3 = VHSV02C_DATA.CARNOTXT[3];
        VHSV02IW.CARNOTXT4 = VHSV02C_DATA.CARNOTXT[4];
        VHSV02IW.CARNOTXT5 = VHSV02C_DATA.CARNOTXT[5];
        VHSV02IW.CARNOTXT6 = VHSV02C_DATA.CARNOTXT[6];
        VHSV02IW.CARNOTXT7 = VHSV02C_DATA.CARNOTXT[7];
        VHSV02IW.CARNOTXT8 = VHSV02C_DATA.CARNOTXT[8];
        VHSV02IW.CARNOTXT9 = VHSV02C_DATA.CARNOTXT[9];
        VHSV02IW.CARNOTXT10 = VHSV02C_DATA.CARNOTXT[10];
        
        
        
        
		

		
		
		
    end
end 

Function VHSV02IS-OPN-VM () 
    VHVM11IW-PASS-DATA.CAR-NO = VHSV02IW-PASSVALUE.CAR-NO-X;
    VHVM11IW-PASS-DATA.PASS-FROM-GUI = "VHSV02";
end 

Function VHSV02IS-PRVNXT () 
    if (VHSV02IW.ROW-COUNT > 0)
        if (VHSV02IW.PRV-NXT == "PRV")
            INCD-INDEX = INCD-INDEX - 1;
            if (INCD-INDEX == 1)
                DISABLE-PRV = "Y";
                if (INCD-INDEX == VHSV02IW.ROW-COUNT)
                    DISABLE-NXT = "Y";
                else
                    ENABLE-NXT = "Y";
                    NXT-SETFOCUS = "Y";
                end
            else
                ENABLE-PRV = "Y";
                ENABLE-NXT = "Y";
                PRV-SETFOCUS = "Y";
            end
        else
            if (VHSV02IW.PRV-NXT == "NXT")
                INCD-INDEX = INCD-INDEX + 1;
                ENABLE-PRV = "Y";
                if (INCD-INDEX == VHSV02IW.ROW-COUNT)
                    DISABLE-NXT = "Y";
                    PRV-SETFOCUS = "Y";
                else
                    ENABLE-NXT = "Y";
                    NXT-SETFOCUS = "Y";
                end
            else
                if (VHSV02IW.PRV-NXT == " ")
                    VHSV02IW.INCD-INDEX = 1; 
                    if (INCD-INDEX == VHSV02IW.ROW-COUNT)
                        DISABLE-PRV = "Y";
                        DISABLE-NXT = "Y";
                    else
                        DISABLE-PRV = "Y";
                        ENABLE-NXT = "Y";
                        NXT-SETFOCUS = "Y";
                    end
                end
            end
        end
        move " " to VHSV02IW.INCD-DETAILS[1] for all;
        VHSV02IW.TEMP-COUNT = 1;
        VHSV02IW.INCD-NO[1] = VHSV02A_DATA_03.INCD-NO[INCD-INDEX];
        VHSV02IW.DATE-INCD-OCCR[1] = VHSV02A_DATA_03.DATE-INCD-OCCR[INCD-INDEX];
        VHSV02IW.TIME-INCD-OCCR[1] = VHSV02A_DATA_03.TIME-INCD-OCCR[INCD-INDEX];
        VHSV02IW.SYMP-CD[1] = VHSV02A_DATA_03.SYMP-CD[INCD-INDEX];
        VHSV02IW.INCD-LOC[1] = VHSV02A_DATA_03.INCD-LOC[INCD-INDEX];
        VHSV02IW.VEH-INCD-STAT[1] = VHSV02A_DATA_03.VEH-INCD-STAT[INCD-INDEX];
        VHSV02IW.CON-DIRECTION[1] = VHSV02A_DATA_03.CON-DIRECTION[INCD-INDEX];
        VHSV02IW.CUM-HRS[1] = VHSV02A_DATA_03.CUM-HRS[INCD-INDEX];
        VHSV02IW.DEFERRED-PRIORITY[1] = VHSV02A_DATA_03.DEFERRED-PRIORITY[INCD-INDEX];
        VHNARX_DATA.CRIT-INCD-NO = VHSV02IW.INCD-NO[1];
        try
            call "MRSVehicleMaintenance.VHNARX"(XDCONTROL, VHNARX_DATA);
        
        end
        if (XDCONTROL.UROWCNT > 0)
            VHSV02IW.NARR-ROW-COUNT = XDCONTROL.UROWCNT;
            LOAD-DATA = "Y";
        else

        end
        if (VHSV02A_DATA_03.INCD-CON-NO[INCD-INDEX] != " " &&
         VHSV02A_DATA_03.INCD-DASH-NO[INCD-INDEX] > 0)
      
            VHSV02C_CRIT.CON-NO = VHSV02A_DATA_03.INCD-CON-NO[INCD-INDEX];
            VHSV02C_CRIT.DASH-NO = VHSV02A_DATA_03.INCD-DASH-NO[INCD-INDEX];
            VHSV02C_CRIT.DATE-INSRV-REV = VHSV02A_DATA_03.DATE-INSRV-REV[INCD-INDEX];
            VHSV02C_CRIT.DATE-INSRV = VHSV02A_DATA_03.DATE-INSRV[INCD-INDEX];
            VHSV02C_CRIT.TIME-INSRV = VHSV02A_DATA_03.TIME-INSRV[INCD-INDEX];
            try
                call "VHSV02C"(XDCONTROL, VHSV02C_CRIT, VHSV02C_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHSV02IS-MOVE-CARS();
            end
        else
            VHSV02IS-MOVE-CARS();
        end
    else
        DISABLE-PRV = "Y";
        DISABLE-NXT = "Y";
    end
end 

Function VHSV02IS-RETDATA () 
    set VHSV02IW empty;
    VHSV02IW-PASSVALUE.CAR-NO-X = VHSV02IW-PASSVALUE.CAR-NO;
    VHSV02IW-PASSVALUE.LFT-ORIENT = " ";
    VHSV02IW-PASSVALUE.RGT-ORIENT = " ";
    VHSV02A_CRIT.REPORT-INDEX = VHSV02IW-PASSVALUE.REPORT-INDEX;
    VHSV02A_CRIT.CAR-NO = VHSV02IW-PASSVALUE.CAR-NO;
    VHSV02A_CRIT.SYMP-CD-FROM = VHSV02IW-PASSVALUE.SYMP-CD-FROM;
    VHSV02A_CRIT.SYMP-CD-TO = VHSV02IW-PASSVALUE.SYMP-CD-TO;
    VHSV02A_CRIT.INCD-DATE-FROM = VHSV02IW-PASSVALUE.DATE-FROM;
    VHSV02A_CRIT.INCD-DATE-TO = VHSV02IW-PASSVALUE.DATE-TO;
    VHSV02A_CRIT.DEF-ITEMS = VHSV02IW-PASSVALUE.DEF-ITEMS;
    VHSV02IW.TITLE = " ";
    VHSV02IW.PRV-NXT = " ";
    VHSV02IW.ROW-COUNT = 0;
    VHSV02IW.NARR-ROW-COUNT = 0;
    VHSV02IW.TITLE-7 = "VER OCT/01-1.0";
    if (VHSV02A_CRIT.REPORT-INDEX == 1)
        VHSV02IW.TITLE-1 = "VHSV02I - Open/Repaired Incidents";
    else
        if (VHSV02A_CRIT.REPORT-INDEX == 2)
            VHSV02IW.TITLE-1 = "VHSV02I - Open/Deferred Incidents";
        end
    end
    if (VHSV02A_CRIT.INCD-DATE-FROM == " ")
        VHSV02IW.TITLE-2 = " ";
    else
        VHSV02IW.TITLE-2-1 = " from ";
        VHSV02IW.TITLE-2-2 = VHSV02A_CRIT.INCD-DATE-FROM;
    end
    if (VHSV02A_CRIT.INCD-DATE-TO == " ")
        VHSV02IW.TITLE-3 = " ";
    else
        VHSV02IW.TITLE-3-1 = " to ";
        VHSV02IW.TITLE-3-2 = VHSV02A_CRIT.INCD-DATE-TO;
    end
    if (VHSV02A_CRIT.SYMP-CD-FROM == " ")
        VHSV02IW.TITLE-4 = " ";
    else
        VHSV02IW.TITLE-4-1 = ", symp cd ";
        VHSV02IW.TITLE-4-2 = VHSV02A_CRIT.SYMP-CD-FROM;
    end
    if (VHSV02A_CRIT.SYMP-CD-TO == " ")
        VHSV02IW.TITLE-5 = " ";
    else
        VHSV02IW.TITLE-5-1 = " to ";
        VHSV02IW.TITLE-5-2 = VHSV02A_CRIT.SYMP-CD-TO;
    end
    if (VHSV02A_CRIT.DEF-ITEMS == " ")
        VHSV02IW.TITLE-6 = " ";
    else
        VHSV02IW.TITLE-6-1 = ", def ";
        VHSV02IW.TITLE-6-2 = VHSV02A_CRIT.DEF-ITEMS;
    end
    if (VHSV02A_CRIT.INCD-DATE-FROM != " ")
        XXDATEW.DATE-MM-DD-YYYY = VHSV02A_CRIT.INCD-DATE-FROM;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHSV02A_CRIT.INCD-DATE-FROM = XXDATEW.DATE-YYYY-MM-DD;
    else
        VHSV02A_CRIT.INCD-DATE-FROM = " ";
    end
    if (VHSV02A_CRIT.INCD-DATE-TO != " ")
        XXDATEW.DATE-MM-DD-YYYY = VHSV02A_CRIT.INCD-DATE-TO;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHSV02A_CRIT.INCD-DATE-TO = XXDATEW.DATE-YYYY-MM-DD;
    else
        VHSV02A_CRIT.INCD-DATE-TO = " ";
    end
    VHSV02AS-BUILD-SQL();
    try
        call "VHSV02A"(XDCONTROL, VHSV02A_CRIT, VHSV02A_DATA_01, VHSV02A_DATA_02, VHSV02A_DATA_03, VHSV02AW1);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHSV02IW.ROW-COUNT = VHSV02A_CRIT.ROW-COUNT;
        
  
        VHSV02IS-GET-ORI();
        VHSV02IS-DATE-DIFF(); 
        EXECUTE-PRVNXT = "Y";
    else
        move " " to VHSV02IW.INCD-DETAILS[1] for all;
        set VHNARX_DATA empty;
        VHSV02IW.TEMP-COUNT = 0;
        VHSV02IW.NARR-ROW-COUNT = 0;
        DISABLE-PRV = "Y";
        DISABLE-NXT = "Y";
        LOAD-DATA = "Y";
        XXMESSAGE.UMSGCODE = "AFCR001";
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHSV04IS-DISPLAY () 
    VHSV04IW.CAR-MESSAGE = " ";
    VHSV04IW.CAR-NO = VHSV04IW.CAR-NO-NUM;
    if (VHSV04IW.CAR-NO == "0000")
        VHSV04IW.CAR-MESSAGE = "Car no field cannot be blank";
        VHSV04IW.CAR-NO = " ";
        VHSV04IW.INVALID-CAR-NO = "Y";
        return;
    else
        if (VHSV04IW.CAR-NO not numeric)
            VHSV04IW.CAR-MESSAGE = "Invalid Car No.";
            VHSV04IW.INVALID-CAR-NO = "Y";
            return;
        else
    
            VHINC6A_CRIT.CAR-NO = VHSV04IW.CAR-NO;
            try
                call "MRSVehicleIncident.VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
            
            end
            if (XDCONTROL.UROWCNT == 1)

            else
                if (XDCONTROL.URC == 100)
                    VHSV04IW.CAR-MESSAGE = "Car no does not exist";
                    INVALID-CAR-NO = "Y";
                     
                    return;
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                end
            end
        end
    end
    if (VHSV04IW.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHSV04IW.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHSV04IW.CAR-MESSAGE = "Invalid From date.";
            VHSV04IW.INVALID-FROM-DATE = "Y";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHSV04IW.TO-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHSV04IW.TO-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHSV04IW.CAR-MESSAGE = "Invalid To date.";
            VHSV04IW.INVALID-TO-DATE = "Y";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end

  
    if (VHSV04IW.TO-DATE != " ")
        if ((VHSV04IW.TO-DATE-YEAR-NUM > VHSV04IW.WS-CURR-YEAR-NUM) ||
         (VHSV04IW.TO-DATE-YEAR-NUM == VHSV04IW.WS-CURR-YEAR-NUM &&
         VHSV04IW.TO-DATE-MO-NUM > VHSV04IW.WS-CURR-MO-NUM) ||
         (VHSV04IW.TO-DATE-YEAR-NUM == VHSV04IW.WS-CURR-YEAR-NUM &&
         VHSV04IW.TO-DATE-MO-NUM == VHSV04IW.WS-CURR-MO-NUM &&
         VHSV04IW.TO-DATE-DAY-NUM > VHSV04IW.WS-CURR-DA-NUM))
            VHSV04IW.CAR-MESSAGE = "To date cannot be greater than CURRENT_DATE.";
            VHSV04IW.INVALID-TO-DATE = "Y";
            return;
        end
    end

  
    if (VHSV04IW.FROM-DATE != " " && VHSV04IW.TO-DATE != " ")
        if ((VHSV04IW.FROM-DATE-YEAR-NUM > VHSV04IW.TO-DATE-YEAR-NUM) ||
         (VHSV04IW.FROM-DATE-YEAR-NUM == VHSV04IW.TO-DATE-YEAR-NUM &&
         VHSV04IW.FROM-DATE-MO-NUM > VHSV04IW.TO-DATE-MO-NUM) ||
         (VHSV04IW.FROM-DATE-YEAR-NUM == VHSV04IW.TO-DATE-YEAR-NUM &&
         VHSV04IW.FROM-DATE-MO-NUM == VHSV04IW.TO-DATE-MO-NUM &&
         VHSV04IW.FROM-DATE-DAY-NUM > VHSV04IW.TO-DATE-DAY-NUM))
            VHSV04IW.CAR-MESSAGE = "From date cannot be greater than To date.";
            VHSV04IW.INVALID-FROM-DATE = "Y";
            return;
        end
    end
    if (VHSV04IW.SYMP-CD-FROM != " " &&
     VHSV04IW.SYMP-CD-TO != " ")
        if (VHSV04IW.SYMP-CD-TO-NUM < VHSV04IW.SYMP-CD-FROM-NUM)
            VHSV04IW.CAR-MESSAGE = "Value of 'Symp Cd To' should be >= 'Symp Cd From' value";
            VHSV04IW-TRIGGER.INVALID-SYMP-TO = "Y";
            return;
        end
    end
    if (VHSV04IW.SYMP-CD-FROM != " ")
        if (VHSV04IW.SYMP-CD-FROM not numeric)
            VHSV04IW.CAR-MESSAGE = "Invalid From symp cd";
            VHSV04IW-TRIGGER.INVALID-SYMP-FROM = "Y";
            return;
        end
    end
    if (VHSV04IW.SYMP-CD-TO == " ")
        VHSV04IW.SYMP-CD-TO = VHSV04IW.SYMP-CD-FROM;
    end
    if (VHSV04IW.SYMP-CD-TO != " ")
        if (VHSV04IW.SYMP-CD-TO not numeric)
            VHSV04IW.CAR-MESSAGE = "Invalid To symp cd";
            VHSV04IW-TRIGGER.INVALID-SYMP-TO = "Y";
            return;
        end
    end
    VHSV04IW.RUN-VHSV05 = "Y";
end 

Function VHSV04IS-HARD-COPY () 
    if (VHSV01IW-PASSVALUE.PRT-IDX > 0)
        VHSV04IW-TRIGGER.ENABLE-HARD = "Y";
        VHSV04IW-PASSVALUE.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRT-IDX];
    else
        VHSV04IW-TRIGGER.DISABLE-HARD = "Y";
    end
end 

Function VHSV04IS-INIT () 
    VHSV04IW.TO-DATE = VGVar.currentFormattedGregorianDate;
    VHSV04IW.WS-CURRENT-DATE = VGVar.currentFormattedGregorianDate;
    VHSV04IW.CAR-NO = " ";
    try
        call "VHSV011"(XDCONTROL, VHSV011_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHSV04IW.FROM-DATE = VHSV011_DATA.FROM-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHSV04IW.FROM-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHSV04IW.FROM-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHSV04IW.FROM-DATE-FILLER1 = "-";
        VHSV04IW.FROM-DATE-FILLER2 = "-";
    end
end 




Function VHSV04IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  

  
  
  
   
    VHSV04IS-SUBMIT-X();
    if (VHSV04IW-TRIGGER.OK-SUBMIT == "Y")
        set VHSV012_CRIT empty;
        VHSV012_CRIT.REPT-TYPE = VHSV04IW-PASSVALUE.VTAM-NAME;
        VHSV012_CRIT.REPT-ID = "3";
        VHSV012_CRIT.CON-CAR-1 = VHSV04IW.CAR-NO;
        VHSV012_CRIT.DATE-REPT-FROM = VHSV04IW.FROM-DATE;
        XXDATEW.DATE-MM-DD-YYYY = VHSV012_CRIT.DATE-REPT-FROM;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHSV012_CRIT.DATE-REPT-FROM = XXDATEW.DATE-YYYY-MM-DD;
        VHSV012_CRIT.DATE-REPT-TO = VHSV04IW.TO-DATE;
        XXDATEW.DATE-MM-DD-YYYY = VHSV012_CRIT.DATE-REPT-TO;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHSV012_CRIT.DATE-REPT-TO = XXDATEW.DATE-YYYY-MM-DD;
        VHSV012_CRIT.SYMP-CD = VHSV04IW.SYMP-CD-FROM;
        VHSV012_CRIT.SYMP-CD-TO = VHSV04IW.SYMP-CD-TO;
        if (VHSV012_CRIT.SYMP-CD == "0000" && VHSV012_CRIT.SYMP-CD-TO == "9999")
            VHSV012_CRIT.SYMP-CD = " ";
        end


    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHSV04I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHSV012";

    
        try
            call "VHSV012"(XDCONTROL, VHSV012_CRIT, VHSV012_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
                VHSV04IW-TRIGGER.SUBMIT = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

Function VHSV04IS-SUBMIT-X () 
    VHSV04IW.CAR-MESSAGE = " ";
    VHSV04IW.CAR-NO = VHSV04IW.CAR-NO-NUM;
    if (VHSV04IW.CAR-NO == "0000")
        VHSV04IW.CAR-MESSAGE = "Car no field cannot be blank";
        VHSV04IW.CAR-NO = " ";
        VHSV04IW.INVALID-CAR-NO = "Y";
        return;
    else
        if (VHSV04IW.CAR-NO not numeric)
            VHSV04IW.CAR-MESSAGE = "Invalid Car No.";
            VHSV04IW.INVALID-CAR-NO = "Y";
            return;
        else
    
            VHINC6A_CRIT.CAR-NO = VHSV04IW.CAR-NO;
            try
                call "MRSVehicleIncident.VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
            
            end
            if (XDCONTROL.UROWCNT == 1)

            else
                if (XDCONTROL.URC == 100)
                    VHSV04IW.CAR-MESSAGE = "Car no does not exist";
                    INVALID-CAR-NO = "Y";
                     
                    return;
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                end
            end
        end
    end
    if (VHSV04IW.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHSV04IW.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHSV04IW.CAR-MESSAGE = "Invalid From date.";
            VHSV04IW.INVALID-FROM-DATE = "Y";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHSV04IW.TO-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHSV04IW.TO-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHSV04IW.CAR-MESSAGE = "Invalid To date.";
            VHSV04IW.INVALID-TO-DATE = "Y";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end

  
    if (VHSV04IW.TO-DATE != " ")
        if ((VHSV04IW.TO-DATE-YEAR-NUM > VHSV04IW.WS-CURR-YEAR-NUM) ||
         (VHSV04IW.TO-DATE-YEAR-NUM == VHSV04IW.WS-CURR-YEAR-NUM &&
         VHSV04IW.TO-DATE-MO-NUM > VHSV04IW.WS-CURR-MO-NUM) ||
         (VHSV04IW.TO-DATE-YEAR-NUM == VHSV04IW.WS-CURR-YEAR-NUM &&
         VHSV04IW.TO-DATE-MO-NUM == VHSV04IW.WS-CURR-MO-NUM &&
         VHSV04IW.TO-DATE-DAY-NUM > VHSV04IW.WS-CURR-DA-NUM))
            VHSV04IW.CAR-MESSAGE = "To date cannot be greater than CURRENT_DATE.";
            VHSV04IW.INVALID-TO-DATE = "Y";
            return;
        end
    end

  
    if (VHSV04IW.FROM-DATE != " " && VHSV04IW.TO-DATE != " ")
        if ((VHSV04IW.FROM-DATE-YEAR-NUM > VHSV04IW.TO-DATE-YEAR-NUM) ||
         (VHSV04IW.FROM-DATE-YEAR-NUM == VHSV04IW.TO-DATE-YEAR-NUM &&
         VHSV04IW.FROM-DATE-MO-NUM > VHSV04IW.TO-DATE-MO-NUM) ||
         (VHSV04IW.FROM-DATE-YEAR-NUM == VHSV04IW.TO-DATE-YEAR-NUM &&
         VHSV04IW.FROM-DATE-MO-NUM == VHSV04IW.TO-DATE-MO-NUM &&
         VHSV04IW.FROM-DATE-DAY-NUM > VHSV04IW.TO-DATE-DAY-NUM))
            VHSV04IW.CAR-MESSAGE = "From date cannot be greater than To date.";
            VHSV04IW.INVALID-FROM-DATE = "Y";
            return;
        end
    end
    if (VHSV04IW.SYMP-CD-FROM != " " &&
     VHSV04IW.SYMP-CD-TO != " ")
        if (VHSV04IW.SYMP-CD-TO-NUM < VHSV04IW.SYMP-CD-FROM-NUM)
            VHSV04IW.CAR-MESSAGE = "Value of 'Symp Cd To' should be >= 'Symp Cd From' value";
            VHSV04IW-TRIGGER.INVALID-SYMP-TO = "Y";
            return;
        end
    end
    if (VHSV04IW.SYMP-CD-FROM != " ")
        if (VHSV04IW.SYMP-CD-FROM not numeric)
            VHSV04IW.CAR-MESSAGE = "Invalid From symp cd";
            VHSV04IW-TRIGGER.INVALID-SYMP-FROM = "Y";
            return;
        end
    end
    if (VHSV04IW.SYMP-CD-TO == " ")
        VHSV04IW.SYMP-CD-TO = VHSV04IW.SYMP-CD-FROM;
    end
    if (VHSV04IW.SYMP-CD-TO != " ")
        if (VHSV04IW.SYMP-CD-TO not numeric)
            VHSV04IW.CAR-MESSAGE = "Invalid To symp cd";
            VHSV04IW-TRIGGER.INVALID-SYMP-TO = "Y";
            return;
        end
    end
    if ((VHSV04IW.SYMP-CD-FROM == " " &&
     VHSV04IW.SYMP-CD-TO == " ") ||
     (VHSV04IW.SYMP-CD-FROM-NUM == 0 &&
     VHSV04IW.SYMP-CD-TO-NUM == 0))
        VHSV04IW.SYMP-CD-FROM = "0000";
        VHSV04IW.SYMP-CD-TO = "9999";
    end
    VHSV04IW-TRIGGER.OK-SUBMIT = "Y";
end 




Function VHSV05IS-I-PRVNXT () 
    VHSV05IW.REPR-PRV-NXT = " ";
    set VHSV05IW_INCD_DATA empty;
    set VHSV05IW_REPR_DATA empty;
    VHSV05IW_INCD_DATA.CUM-HRS = 0;
    VHSV05IW.REPR-NARR-COUNT = 0;
    VHSV05IW.CMPNT-ROW-COUNT = 0;
    if (VHSV05IW.ROW-COUNT > 0)
        if (VHSV05IW.INCD-PRV-NXT == "INCDPRV")
            INCD-INDEX = INCD-INDEX - 1;
            if (INCD-INDEX == 1)
                DISABLE-INCD-PRV = "Y";
                if (INCD-INDEX == VHSV05IW.ROW-COUNT)
                    DISABLE-INCD-NXT = "Y";
                else
                    ENABLE-INCD-NXT = "Y";
                    INCD-NXT-SETFOCUS = "Y";
                end
            else
                ENABLE-INCD-PRV = "Y";
                ENABLE-INCD-NXT = "Y";
                INCD-PRV-SETFOCUS = "Y";
            end
        else
            if (VHSV05IW.INCD-PRV-NXT == "INCDNXT")
                INCD-INDEX = INCD-INDEX + 1;
                ENABLE-INCD-PRV = "Y";
                if (INCD-INDEX == VHSV05IW.ROW-COUNT)
                    DISABLE-INCD-NXT = "Y";
                    INCD-PRV-SETFOCUS = "Y";
                else
                    ENABLE-INCD-NXT = "Y";
                    INCD-NXT-SETFOCUS = "Y";
                end
            else
                if (VHSV05IW.INCD-PRV-NXT == " ")
                    VHSV05IW.INCD-INDEX = 1; 
                    if (INCD-INDEX == VHSV05IW.ROW-COUNT)
                        DISABLE-INCD-PRV = "Y";
                        DISABLE-INCD-NXT = "Y";
                    else
                        DISABLE-INCD-PRV = "Y";
                        ENABLE-INCD-NXT = "Y";
                        INCD-NXT-SETFOCUS = "Y";
                    end
                end
            end
        end
        VHSV05IW_INCD_DATA.INCD-NO = VHSV05A_DATA_03.INCD-NO[INCD-INDEX];
        VHSV05IW_INCD_DATA.DATE-INCD-OCCR = VHSV05A_DATA_03.DATE-INCD-OCCR[INCD-INDEX];
        VHSV05IW_INCD_DATA.TIME-INCD-OCCR = VHSV05A_DATA_03.TIME-INCD-OCCR[INCD-INDEX];
        VHSV05IW_INCD_DATA.SYMP-CD = VHSV05A_DATA_03.SYMP-CD[INCD-INDEX];
        VHSV05IW_INCD_DATA.INCD-LOC = VHSV05A_DATA_03.INCD-LOC[INCD-INDEX];
        VHSV05IW_INCD_DATA.VEH-INCD-STAT = VHSV05A_DATA_03.VEH-INCD-STAT[INCD-INDEX];
        VHSV05IW_INCD_DATA.CON-DIRECTION = VHSV05A_DATA_03.CON-DIRECTION[INCD-INDEX];
        VHSV05IW_INCD_DATA.DEFERRED-PRIORITY = VHSV05A_DATA_03.DEFERRED-PRIORITY[INCD-INDEX];
        VHSV05IW_INCD_DATA.CUM-HRS = VHSV05A_DATA_03.CUM-HRS[INCD-INDEX];
        VHSV05IW_INCD_DATA.PM-TEAM = VHSV05A_DATA_03.PM-TEAM[INCD-INDEX];
        VHSV05F_CRIT.CRIT-INCD-NO = VHSV05IW_INCD_DATA.INCD-NO;
        try
            call "VHSV05F"(XDCONTROL, VHSV05F_CRIT, VHSV05F_DATA);
        
        end
        if (XDCONTROL.UROWCNT > 0)
            VHSV05IW.NARR-ROW-COUNT = XDCONTROL.UROWCNT;
            LOAD-DATA = "Y";
        else

        end
    else
        DISABLE-INCD-PRV = "Y";
        DISABLE-INCD-NXT = "Y";
        LOAD-REPR-NARR-DATA = "Y";
        LOAD-CMPNT-DATA = "Y";
    end
end 

Function VHSV05IS-R-PRVNXT () 
    set VHSV05IW_REPR_DATA empty;
    VHSV05IW.REPR-NARR-COUNT = 0;
    VHSV05IW.CMPNT-ROW-COUNT = 0;
    if (VHSV05IW.REPR-ROW-COUNT > 0)
        if (VHSV05IW.REPR-PRV-NXT == "REPRPRV")
            REPR-INDEX = REPR-INDEX - 1;
            if (REPR-INDEX == 1)
                DISABLE-REPR-PRV = "Y";
                if (REPR-INDEX == VHSV05IW.REPR-ROW-COUNT)
                    DISABLE-REPR-NXT = "Y";
                else
                    ENABLE-REPR-NXT = "Y";
                    REPR-NXT-SETFOCUS = "Y";
                end
            else
                ENABLE-REPR-PRV = "Y";
                ENABLE-REPR-NXT = "Y";
                REPR-PRV-SETFOCUS = "Y";
            end
        else
            if (VHSV05IW.REPR-PRV-NXT == "REPRNXT")
                REPR-INDEX = REPR-INDEX + 1;
                ENABLE-REPR-PRV = "Y";
                if (REPR-INDEX == VHSV05IW.REPR-ROW-COUNT)
                    DISABLE-REPR-NXT = "Y";
                    REPR-PRV-SETFOCUS = "Y";
                else
                    ENABLE-REPR-NXT = "Y";
                    REPR-NXT-SETFOCUS = "Y";
                end
            else
                if (VHSV05IW.REPR-PRV-NXT == " ")
                    VHSV05IW.REPR-INDEX = 1; 
                    if (REPR-INDEX == VHSV05IW.REPR-ROW-COUNT)
                        DISABLE-REPR-PRV = "Y";
                        DISABLE-REPR-NXT = "Y";
                    else
                        DISABLE-REPR-PRV = "Y";
                        ENABLE-REPR-NXT = "Y";
                        REPR-NXT-SETFOCUS = "Y";
                    end
                end
            end
        end
        VHSV05IW_REPR_DATA.REPR-DOC-NO = VHSV05C_DATA.REPR-DOC-NO[REPR-INDEX];
        VHSV05IW_REPR_DATA.VEH-SYSTEM = VHSV05C_DATA.VEH-SYSTEM[REPR-INDEX];
        VHSV05IW_REPR_DATA.VEH-SYSTEM-FILLER = "/";
        VHSV05IW_REPR_DATA.VEH-SUB-SYSTEM = VHSV05C_DATA.VEH-SUB-SYSTEM[REPR-INDEX];
        VHSV05IW_REPR_DATA.REPR-DISP-CD = VHSV05C_DATA.REPR-DISP-CD[REPR-INDEX];
        VHSV05IW_REPR_DATA.SER-NO-ON = VHSV05C_DATA.SER-NO-ON[REPR-INDEX];
        VHSV05IW_REPR_DATA.SER-NO-OFF = VHSV05C_DATA.SER-NO-OFF[REPR-INDEX];
        VHSV05IW_REPR_DATA.VEH-PRT-CTL-NO = VHSV05C_DATA.VEH-PRT-CTL-NO[REPR-INDEX];

    
        VHNARY_CRIT.INCD-NO = VHSV05IW_INCD_DATA.INCD-NO;
        VHNARY_CRIT.REPR-DOC-NO = VHSV05IW_REPR_DATA.REPR-DOC-NO;
        try
            call "MRSVehicleMaintenance.VHNARY"(XDCONTROL, VHNARY_CRIT, VHNARY_DATA);
        
        end
        if (XDCONTROL.UROWCNT > 0)
            VHSV05IW.REPR-NARR-COUNT = XDCONTROL.UROWCNT;
        else

        end
        LOAD-REPR-NARR-DATA = "Y"; 

    
        VHSV05D_CRIT.INCD-NO = VHSV05IW_INCD_DATA.INCD-NO;
        VHSV05D_CRIT.REPR-DOC-NO = VHSV05IW_REPR_DATA.REPR-DOC-NO;
        try
            call "VHSV05D"(XDCONTROL, VHSV05D_CRIT, VHSV05D_DATA);
        
        end
        if (XDCONTROL.UROWCNT > 0)
            VHSV05IW.CMPNT-ROW-COUNT = XDCONTROL.UROWCNT;
        else

        end
        LOAD-CMPNT-DATA = "Y";
         
    else
        DISABLE-REPR-PRV = "Y";
        DISABLE-REPR-NXT = "Y";
        LOAD-REPR-NARR-DATA = "Y";
        LOAD-CMPNT-DATA = "Y";
    end
end 

Function VHSV05IS-REPR-DATA () 
    VHSV05C_CRIT.INCD-NO = VHSV05IW_INCD_DATA.INCD-NO;
    try
        call "VHSV05C"(XDCONTROL, VHSV05C_CRIT, VHSV05C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHSV05IW.REPR-ROW-COUNT = VHSV05C_CRIT.REPR-ROW-COUNT;
        EXECUTE-REPR-PRVNXT = "Y";
    else
        set VHSV05IW_REPR_DATA empty;
        set VHSV05C_DATA empty;
        set VHSV05D_DATA empty;
        VHSV05IW.REPR-ROW-COUNT = 0;
        VHSV05IW.CMPNT-ROW-COUNT = 0;
        DISABLE-REPR-PRV = "Y";
        DISABLE-REPR-NXT = "Y";
        LOAD-REPR-NARR-DATA = "Y";
        LOAD-CMPNT-DATA = "Y";
    end
end 

Function VHSV05IS-RETDATA ()
  
  
  
   
    VHSV05IW-PASSVALUE.CAR-NO-X = VHSV05IW-PASSVALUE.CAR-NO;
    VHSV05IW-PASSVALUE.LFT-ORIENT = " ";
    VHSV05IW-PASSVALUE.RGT-ORIENT = " ";
    VHSV05A_CRIT.CAR-NO = VHSV05IW-PASSVALUE.CAR-NO;
    VHSV05A_CRIT.SYMP-CD-FROM = VHSV05IW-PASSVALUE.SYMP-CD-FROM;
    VHSV05A_CRIT.SYMP-CD-TO = VHSV05IW-PASSVALUE.SYMP-CD-TO;
    VHSV05A_CRIT.INCD-DATE-FROM = VHSV05IW-PASSVALUE.DATE-FROM;
    VHSV05A_CRIT.INCD-DATE-TO = VHSV05IW-PASSVALUE.DATE-TO;
    VHSV05IW_TITLE.TITLE = " ";
    VHSV05IW.INCD-PRV-NXT = " ";
    VHSV05IW.ROW-COUNT = 0;
    VHSV05IW.NARR-ROW-COUNT = 0;
    VHSV05IW.REPR-NARR-COUNT = 0;
    VHSV05IW.CMPNT-ROW-COUNT = 0;
    VHSV05IW_TITLE.TITLE-1 = "VHSV05I - History Vehicle Report";
    VHSV05IW_TITLE.TITLE-6 = "     V1.NOV.15.04.01";
    if (VHSV05A_CRIT.INCD-DATE-FROM == " ")
        VHSV05IW_TITLE.TITLE-2 = " ";
        VHSV05IW_TITLE.TITLE-3 = " ";
        VHSV05IW_TITLE.TITLE-4 = " ";
        VHSV05IW_TITLE.TITLE-5 = " ";
        if (VHSV05A_CRIT.INCD-DATE-TO != " ")
            VHSV05IW_TITLE.TITLE-2 = "   for date >= ";
            VHSV05IW_TITLE.TITLE-3 = VHSV05A_CRIT.INCD-DATE-TO;
        end
    else
        VHSV05IW_TITLE.TITLE-2 = " for date range from ";
        VHSV05IW_TITLE.TITLE-3 = VHSV05A_CRIT.INCD-DATE-FROM;
        if (VHSV05A_CRIT.INCD-DATE-TO == " ")
            VHSV05IW_TITLE.TITLE-4 = " to ";
            VHSV05IW_TITLE.TITLE-5 = "Current ";
        else
            VHSV05IW_TITLE.TITLE-4 = " to ";
            VHSV05IW_TITLE.TITLE-5 = VHSV05A_CRIT.INCD-DATE-TO;
        end
    end
    if (VHSV05A_CRIT.SYMP-CD-FROM == " ")
        VHSV05IW_TITLE.TITLE-5A = " ";
    else
        VHSV05IW_TITLE.TITLE-5A-1 = ", symp cd ";
        VHSV05IW_TITLE.TITLE-5A-2 = VHSV05A_CRIT.SYMP-CD-FROM;
    end
    if (VHSV05A_CRIT.SYMP-CD-TO == " ")
        VHSV05IW_TITLE.TITLE-5B = " ";
    else
        VHSV05IW_TITLE.TITLE-5B-1 = " to ";
        VHSV05IW_TITLE.TITLE-5B-2 = VHSV05A_CRIT.SYMP-CD-TO;
    end
    try
        call "VHSV05A"(XDCONTROL, VHSV05A_CRIT, VHSV05A_DATA_01, VHSV05A_DATA_02, VHSV05A_DATA_03);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHSV05IW.ROW-COUNT = VHSV05A_CRIT.ROW-COUNT;
        EXECUTE-INCD-PRVNXT = "Y";
    else
        set VHSV05F_DATA empty;
        VHSV05IW.ROW-COUNT = 0;
        VHSV05IW.NARR-ROW-COUNT = 0;
        VHSV05IW.REPR-NARR-COUNT = 0;
        VHSV05IW.CMPNT-ROW-COUNT = 0;
        set VHSV05IW_INCD_DATA empty;
        VHSV05IW_INCD_DATA.CUM-HRS = 0;
        set VHSV05IW_REPR_DATA empty;
        DISABLE-INCD-PRV = "Y";
        DISABLE-INCD-NXT = "Y";
        DISABLE-REPR-PRV = "Y";
        DISABLE-REPR-NXT = "Y";
        LOAD-DATA = "Y";
        LOAD-REPR-NARR-DATA = "Y";
        LOAD-CMPNT-DATA = "Y";
        XXMESSAGE.UMSGCODE = "AFCR001";
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    if (VHSV05A_DATA_01.LFT-ORIENTATION-CD ==
     VHSV05A_DATA_01.VAGen_ORIENTATION)
        VHSV05IW-PASSVALUE.LFT-ORIENT = VHSV05A_DATA_01.LFT-ORIENTATION-CD;
        VHSV05IW-PASSVALUE.RGT-ORIENT = " ";
    else
        if (VHSV05A_DATA_01.RGT-ORIENTATION-CD ==
         VHSV05A_DATA_01.VAGen_ORIENTATION)
            VHSV05IW-PASSVALUE.RGT-ORIENT = VHSV05A_DATA_01.RGT-ORIENTATION-CD;
            VHSV05IW-PASSVALUE.LFT-ORIENT = " ";
        end
    end
    
    
    	
   if (strLib.indexOf(VHSV05A_DATA_01.SOFT_VER, "$")>0)
    	VHSV05IW-PASSVALUE.GR1_CAR1_SVER = "$" + strLib.clip( VHSV05IW-PASSVALUE.GR1-CAR1, 0);
    else
    	VHSV05IW-PASSVALUE.GR1_CAR1_SVER = strLib.clip( VHSV05IW-PASSVALUE.GR1-CAR1, 0);
    end
    
end 

Function VHSV06IS-DATE-DIFF () 
    XDATECON-W2.WS-GREG-IN-FLAG = "R";
    XDATECON-W2.WS-RPT-GREG-IN = VGVar.currentFormattedGregorianDate;
    MRSCommonCode.XDATECON-LOAD-TBL();
    MRSCommonCode.XDATECON-GREG2JUL();
    VHSV06IW.JULIAN-DATE-1 = XDATECON-W1.WS-DATES-CYDDD;
    VHSV06IW.DATE-NXT-CAR-WASH = VHSV06A_DATA_01.DATE-NXT-CAR-WASH;
    if (VHSV06IW.DATE-NXT-CAR-WASH != " ")
        XDATECON-W2.WS-GREG-IN-FLAG = "R";
        XDATECON-W2.WS-RPT-GREG-IN = VHSV06A_DATA_01.DATE-NXT-CAR-WASH;
        MRSCommonCode.XDATECON-LOAD-TBL();
        MRSCommonCode.XDATECON-GREG2JUL();
        VHSV06IW.JULIAN-DATE-2 = XDATECON-W1.WS-DATES-CYDDD;
        JULIAN-DATE-DIFF = JULIAN-DATE-2 - JULIAN-DATE-1;
        if (JULIAN-DATE-DIFF >= 0)
            VHSV06A_DATA_01.WASH-OD = 0;
        else
            JULIAN-DATE-DIFF = JULIAN-DATE-1 - JULIAN-DATE-2;
            VHSV06A_DATA_01.WASH-OD = JULIAN-DATE-DIFF;
        end
    else
        VHSV06A_DATA_01.WASH-OD = 0;
    end
end 




Function VHSV06IS-I-PRVNXT () 
    VHSV06IW.REPR-PRV-NXT = " ";
    set VHSV06IW_INCD_DATA empty;
    set VHSV06IW_REPR_DATA empty;
    VHSV06IW_INCD_DATA.CUM-HRS = 0;
    VHSV06IW.REPR-NARR-COUNT = 0;
    VHSV06IW.CMPNT-ROW-COUNT = 0;
    if (VHSV06IW.ROW-COUNT > 0)
        if (VHSV06IW.INCD-PRV-NXT == "INCDPRV")
            INCD-INDEX = INCD-INDEX - 1;
            if (INCD-INDEX == 1)
                DISABLE-INCD-PRV = "Y";
                if (INCD-INDEX == VHSV06IW.ROW-COUNT)
                    DISABLE-INCD-NXT = "Y";
                else
                    ENABLE-INCD-NXT = "Y";
                    INCD-NXT-SETFOCUS = "Y";
                end
            else
                ENABLE-INCD-PRV = "Y";
                ENABLE-INCD-NXT = "Y";
                INCD-PRV-SETFOCUS = "Y";
            end
        else
            if (VHSV06IW.INCD-PRV-NXT == "INCDNXT")
                INCD-INDEX = INCD-INDEX + 1;
                ENABLE-INCD-PRV = "Y";
                if (INCD-INDEX == VHSV06IW.ROW-COUNT)
                    DISABLE-INCD-NXT = "Y";
                    INCD-PRV-SETFOCUS = "Y";
                else
                    ENABLE-INCD-NXT = "Y";
                    INCD-NXT-SETFOCUS = "Y";
                end
            else
                if (VHSV06IW.INCD-PRV-NXT == " ")
                    VHSV06IW.INCD-INDEX = 1; 
                    if (INCD-INDEX == VHSV06IW.ROW-COUNT)
                        DISABLE-INCD-PRV = "Y";
                        DISABLE-INCD-NXT = "Y";
                    else
                        DISABLE-INCD-PRV = "Y";
                        ENABLE-INCD-NXT = "Y";
                        INCD-NXT-SETFOCUS = "Y";
                    end
                end
            end
        end
        VHSV06IW_INCD_DATA.INCD-NO = VHSV06A_DATA_03.INCD-NO[INCD-INDEX];
        VHSV06IW_INCD_DATA.DATE-INCD-OCCR = VHSV06A_DATA_03.DATE-INCD-OCCR[INCD-INDEX];
        VHSV06IW_INCD_DATA.TIME-INCD-OCCR = VHSV06A_DATA_03.TIME-INCD-OCCR[INCD-INDEX];
        VHSV06IW_INCD_DATA.SYMP-CD = VHSV06A_DATA_03.SYMP-CD[INCD-INDEX];
        VHSV06IW_INCD_DATA.INCD-LOC = VHSV06A_DATA_03.INCD-LOC[INCD-INDEX];
        VHSV06IW_INCD_DATA.VEH-INCD-STAT = VHSV06A_DATA_03.VEH-INCD-STAT[INCD-INDEX];
        VHSV06IW_INCD_DATA.CON-DIRECTION = VHSV06A_DATA_03.CON-DIRECTION[INCD-INDEX];
        VHSV06IW_INCD_DATA.DEFERRED-PRIORITY = VHSV06A_DATA_03.DEFERRED-PRIORITY[INCD-INDEX];
        VHSV06IW_INCD_DATA.CUM-HRS = VHSV06A_DATA_03.CUM-HRS[INCD-INDEX];
        VHSV06N_CRIT.CRIT-INCD-NO = VHSV06IW_INCD_DATA.INCD-NO;
        try
            call "VHSV06N"(XDCONTROL, VHSV06N_CRIT, VHSV06N_DATA);
        
        end
        if (XDCONTROL.UROWCNT > 0)
            VHSV06IW.NARR-ROW-COUNT = XDCONTROL.UROWCNT;
            LOAD-DATA = "Y";
            VHSV06IS-MOVE-CON();
        else

        end
    else
        DISABLE-INCD-PRV = "Y";
        DISABLE-INCD-NXT = "Y";
        LOAD-REPR-NARR-DATA = "Y";
        LOAD-CMPNT-DATA = "Y";
    end
end 

Function VHSV06IS-M-NXTPRV () 
    VHSV06IW.REPR-PRV-NXT = "REPRNXT";
end 

