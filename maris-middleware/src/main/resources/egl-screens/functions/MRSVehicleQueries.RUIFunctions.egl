                                                    VHCL02B_DATA.CAR-WN-2[X] = VHCL02C_DATA.CAR-WN-IND[Y2];
                                                    VHCL02B_DATA.CAR-WN-3[X] = VHCL02C_DATA.CAR-WN-IND[Y3];
                                                    VHCL02B_DATA.CAR-WN-4[X] = VHCL02C_DATA.CAR-WN-IND[Y4];
                                                    VHCL02B_DATA.CAR-WN-5[X] = VHCL02C_DATA.CAR-WN-IND[Y5];
                                                    VHCL02B_DATA.CAR-WN-6[X] = VHCL02C_DATA.CAR-WN-IND[Y6];
