Function VHYS06IS-CHK-SEL () 
    ERROR = "N";
    FINAL-ERROR-MESSAGE = " ";
    if ((VHYS06IW.OPT-YARD-BASE == 1 &&
     VHYS06IW.OPT-YARD-STATUS == 0 &&
     VHYS06IW.OPT-YARD-NOGO == 0 &&
     VHYS06IW.OPT-YARD-SUMMARY == 0))
  
        if (YARD-BASE in VHYS06A_DATA.YRD)

        else
            FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
            INVALID-YARD = "Y";
            ERROR = "Y";
        end
  
        if (YARD-BASE == " ")
            INVALID-YARD = "Y";
            FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
            ERROR = "Y";
        else
            if (NARR-IND-BASE == " ")
                INVALID-NARR-IND = "Y";
                FINAL-ERROR-MESSAGE = "Invalid Narrative Indicator";
                ERROR = "Y";
            else
  

            end
        end
    else
        if ((VHYS06IW.OPT-YARD-BASE == 0 &&
         VHYS06IW.OPT-YARD-STATUS == 1 &&
         VHYS06IW.OPT-YARD-NOGO == 0 &&
         VHYS06IW.OPT-YARD-SUMMARY == 0))
  			
            if (YARD-STATUS in VHYS06A_DATA.YRD)

            else
                FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
                INVALID-YARD = "Y";
                ERROR = "Y";
            end 
  			
            if (VHYS06IW.VEH-STATUS in VHYS06B_DATA.VEH-STAT)

            else
                FINAL-ERROR-MESSAGE = "Invalid Vehicle Status Entered";
                INVALID-VEHSTAT = "Y";
                ERROR = "Y";
            end


            if (YARD-STATUS == " ")
                INVALID-YARD = "Y";
                FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
                ERROR = "Y";
            else
                if (VHYS06IW.VEH-STATUS == " ")
                    INVALID-VEHSTAT = "Y";
                    FINAL-ERROR-MESSAGE = "Invalid Vehicle Status    ";
                    ERROR = "Y";
                else
                    if (NARR-IND-STATUS == " ")
                        INVALID-NARR-IND = "Y";
                        FINAL-ERROR-MESSAGE = "Invalid Narrative Indicator";
                        ERROR = "Y";
                    end
                end
            end
        else
            if ((VHYS06IW.OPT-YARD-BASE == 0 &&
             VHYS06IW.OPT-YARD-STATUS == 0 &&
             VHYS06IW.OPT-YARD-NOGO == 1 &&
             VHYS06IW.OPT-YARD-SUMMARY == 0))
  				
                if (YARD-NOGO in VHYS06A_DATA.YRD)

                else
                    FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
                    INVALID-YARD = "Y";
                    ERROR = "Y";
                end

                if (YARD-NOGO == " ")
                    INVALID-YARD = "Y";
                    FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
                    ERROR = "Y";
                else
  

                end
            else
                if ((VHYS06IW.OPT-YARD-BASE == 0 &&
                 VHYS06IW.OPT-YARD-STATUS == 0 &&
                 VHYS06IW.OPT-YARD-NOGO == 0 &&
                 VHYS06IW.OPT-YARD-SUMMARY == 1))
  
                    if (YARD-SUMMARY in VHYS06A_DATA.YRD)

                    else
                        FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
                        INVALID-YARD = "Y";
                        ERROR = "Y";
                    end
  
                    if (YARD-SUMMARY == " ")
                        INVALID-YARD = "Y";
                        FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
                        ERROR = "Y";
                    else
  

                    end
                else
                    VHYS06IW-TRIGGER.SELECT-ONE = 1;
                    FINAL-ERROR-MESSAGE = "You Must Select At least ONE of the options";
                    ERROR = "Y";
                end
            end
        end
    end

  
    if (VHYS06IW.CAR-NO-FROM == "   ")
        VHYS06IW.CAR-NO-FROM = "0096";
    end
    if (VHYS06IW.CAR-NO-TO=="0000" || strLib.characterLen(VHYS06IW.CAR-NO-TO )<1)
        VHYS06IW.CAR-NO-TO = "5000";
    end
    if (VHYS06IW.CAR-NO-TO < VHYS06IW.CAR-NO-FROM)
        ERROR = "Y";
        FINAL-ERROR-MESSAGE = "The TO CAR cannot be less than the FROM CAR";
    end

  
    if (ERROR == "N")
        NO-ERROR = "Y";
    end
end 

Function VHYS06IS-CHK-SEL-X () 
    if (VHYS06IW.OPT-YARD-BASE != 1 &&
     VHYS06IW.OPT-YARD-NOGO != 1 &&
     VHYS06IW.OPT-YARD-STATUS != 1 &&
     VHYS06IW.OPT-YARD-SUMMARY != 1)
        FINAL-ERROR-MESSAGE = " INVALID SELECTION ";
        ERROR-X = "Y";
        return;
    end
    VHYS06IW-TRIGGER.SELECT-ONE-X = " ";
    VHYS06IW-TRIGGER.ERROR-X = " ";
    if ((VHYS06IW.OPT-YARD-BASE == 1 &&
     VHYS06IW.OPT-YARD-STATUS == 0 &&
     VHYS06IW.OPT-YARD-NOGO == 0 &&
     VHYS06IW.OPT-YARD-SUMMARY == 0))
        if (YARD-BASE == " ")
            FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
            INVALID-YARD = "Y";
            ERROR-X = "Y";
        else
            if (NARR-IND-BASE == " ")
                FINAL-ERROR-MESSAGE = "Invalid Narrative Indicator";
                INVALID-NARR-IND = "Y";
                ERROR-X = "Y";
            end
        end
    else
        if ((VHYS06IW.OPT-YARD-BASE == 0 &&
         VHYS06IW.OPT-YARD-STATUS == 1 &&
         VHYS06IW.OPT-YARD-NOGO == 0 &&
         VHYS06IW.OPT-YARD-SUMMARY == 0))
            if (YARD-STATUS == " ")
                FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
                INVALID-YARD = "Y";
                ERROR-X = "Y";
            else
                if (VHYS06IW.VEH-STATUS == " ")
                    FINAL-ERROR-MESSAGE = "Invalid Vehicle Status Entered";
                    INVALID-VEHSTAT = "Y";
                    ERROR-X = "Y";
                else
                    if (NARR-IND-STATUS == " ")
                        FINAL-ERROR-MESSAGE = "Invalid Narrative Indicator";
                        INVALID-NARR-IND = "Y";
                        ERROR-X = "Y";
                    end
                end
            end
        else
            if ((VHYS06IW.OPT-YARD-BASE == 0 &&
             VHYS06IW.OPT-YARD-STATUS == 0 &&
             VHYS06IW.OPT-YARD-NOGO == 1 &&
             VHYS06IW.OPT-YARD-SUMMARY == 0))
                if (YARD-NOGO == " ")
                    FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
                    INVALID-YARD = "Y";
                    ERROR-X = "Y";
                end
            else
                if ((VHYS06IW.OPT-YARD-BASE == 0 &&
                 VHYS06IW.OPT-YARD-STATUS == 0 &&
                 VHYS06IW.OPT-YARD-NOGO == 0 &&
                 VHYS06IW.OPT-YARD-SUMMARY == 1))
                    if (YARD-SUMMARY == " ")
                        FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
                        ERROR-X = "Y";
                        INVALID-YARD = "Y";
                    end
                else
                    VHYS06IW-TRIGGER.SELECT-ONE = 1;
                    
  
                end
            end
        end
    end
    if (ERROR-X == " ")
        VHYS06IW-TRIGGER.SELECT-ONE-X = 1;
    end
end 

