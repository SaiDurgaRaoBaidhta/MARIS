    CAR-TOTAL-DATA[3] = TOTAL-FLEET-T - HOLD-CARS-T;

  

  
    CAR-A-DATA[5] = UNSCHD-MAIN-A;
    CAR-B-DATA[5] = UNSCHD-MAIN-B;
