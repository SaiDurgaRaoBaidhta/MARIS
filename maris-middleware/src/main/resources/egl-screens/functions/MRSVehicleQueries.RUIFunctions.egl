Function VHMR02IW-SUBMIT-X () 
    VHMR02IW-TRIGGER.OK-SUBMIT = "Y";
    VHMR02IW.NULL-TO-ERROR = "N";
    VHMR02IW.INVALID-TO-DATE = " ";
    VHMR02IW.INVALID-FROM-DATE = " ";
    if (VHMR02IW.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHMR02IW.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHMR02IW.INVALID-FROM-DATE = "Y";
            
   
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHMR02I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHMR02IW.TO-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHMR02IW.TO-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHMR02IW.INVALID-TO-DATE = "Y";
            
  
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHMR02I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHMR02IW.YRD == "   ")
        VHMR02I_MESSAGE.MESG1 = "INVALID YARD SELECTION";
        VHMR02IW.INVALID-YRD = "Y";
        AFCXVLDW.NO-ERROR = "N";
    end
    if (VHMR02IW.INVALID-FROM-DATE == "Y")
        VHMR02I_MESSAGE.MESG1 = "INVALID FROM DATE";
        VHMR02IW-TRIGGER.OK-SUBMIT = "N";
    else
  
        if (VHMR02IW.TO-DATE != " ")
            if ((VHMR02IW.TO-DATE-YEAR-NUM > VHMR02IW.WS-CURR-YEAR-NUM) ||
             (VHMR02IW.TO-DATE-YEAR-NUM == VHMR02IW.WS-CURR-YEAR-NUM &&
             VHMR02IW.TO-DATE-MO-NUM > VHMR02IW.WS-CURR-MO-NUM) ||
             (VHMR02IW.TO-DATE-YEAR-NUM == VHMR02IW.WS-CURR-YEAR-NUM &&
             VHMR02IW.TO-DATE-MO-NUM == VHMR02IW.WS-CURR-MO-NUM &&
             VHMR02IW.TO-DATE-DAY-NUM > VHMR02IW.WS-CURR-DA-NUM))
                VHMR02I_MESSAGE.MESG1 = "To date cannot be greater than CURRENT_DATE.";
                VHMR02IW.INVALID-TO-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                
  
            end
        end
    end
    if (VHMR02IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHMR02IW.INVALID-TO-DATE == "Y")
            VHMR02I_MESSAGE.MESG1 = "INVALID TO DATE";
            VHMR02IW-TRIGGER.OK-SUBMIT = "N";
        else
  
            if (VHMR02IW.FROM-DATE != " " && VHMR02IW.TO-DATE != " ")
                if ((VHMR02IW.FROM-DATE-YEAR-NUM > VHMR02IW.TO-DATE-YEAR-NUM) ||
                 (VHMR02IW.FROM-DATE-YEAR-NUM == VHMR02IW.TO-DATE-YEAR-NUM &&
                 VHMR02IW.FROM-DATE-MO-NUM > VHMR02IW.TO-DATE-MO-NUM) ||
                 (VHMR02IW.FROM-DATE-YEAR-NUM == VHMR02IW.TO-DATE-YEAR-NUM &&
                 VHMR02IW.FROM-DATE-MO-NUM == VHMR02IW.TO-DATE-MO-NUM &&
                 VHMR02IW.FROM-DATE-DAY-NUM > VHMR02IW.TO-DATE-DAY-NUM))
                    VHMR02I_MESSAGE.MESG1 = "From date cannot be greater than To date.";
                    VHMR02IW.INVALID-FROM-DATE = "Y";
                    AFCXVLDW.NO-ERROR = "N";
                    
  
                end
            end
        end
    end
    if (VHMR02IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHMR02IW-TRIGGER.INVALID-SYMP-TO == "Y")
            VHMR02IW-TRIGGER.OK-SUBMIT = "N";
        else
            if (VHMR02IW-TRIGGER.INVALID-SYMP-FROM == "Y")
                VHMR02IW-TRIGGER.OK-SUBMIT = "N";
            else
  
  
  
                if (AFCXVLDW.NO-ERROR == "N")
                    VHMR02IW-TRIGGER.OK-SUBMIT = " ";
                else
                    VHMR02IW-TRIGGER.OK-SUBMIT = "Y ";
                end
            end
        end
    end
end 

