

package MRSVehicleQueries;
 

Function VHCHG1IS-CLEAR () 
    set VHCHG1W-MSG empty;
    set VHVM1A1_DATA empty;
    set VHVM1A2_DATA empty;
    set VHVM1A2_CRIT empty;
end 

Function VHCHG1IS-GET-DATA ()
  
  
  
  
  
  
  
  
  
  
  

  
  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCY01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCY1A1";

  

    
    try
        call "MRSVehicleConsist.VHCY1A1"(XDCONTROL, VHCY1A1_CRIT, VHCY1A1_DATA);
    
    end    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
    VHCHG1W-MSG.MSG = "Enter the Car Number";
end 

Function VHCHG1IS-GET-STAT ()
  
  
  
  
  
  
  
  
  
  
  

  
   
    VHVM1A1_CRIT.GUI = "VHCHG";

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCHGI";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM1A2";

  

    
    try
        call "MRSVehicleMaintenance.VHVM1A2"(XDCONTROL, VHVM1A2_CRIT, VHVM1A2_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCHG1W-MSG.MSG = "Enter the New Vehicle Status ";
            VHCY01W-TRIGGERS.ENABLE-LOC = "Y";
            VHCY01W-TRIGGERS.ENABLE-UPDATE = "Y";
        else
            VHCHG1W-MSG.MSG = "The car information could not be retrieved";
        end
  
    else


        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHCHG1IS-UPDATE ()
  
  
  
  
  
  
  
  
  
  
  

  
  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCY01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM1A1";

  

    
    try
        call "MRSVehicleMaintenance.VHVM1A1"(XDCONTROL, VHVM1A1_CRIT, VHVM1A1_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCHG1W-MSG.MSG = "The Vehicle Status Change Has Been Made";
            

  
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHCHR01IS-HARD-CPY () 
    if (PRT-IDX > 0)
        VHCHR1IW-TRIGGER.ENABLE-HARD = "Y";
        VHCHR1IW.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRT-IDX];
    else
        VHCHR1IW-TRIGGER.DISABLE-HARD = "Y";
    end
end 




Function VHCHR01IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
   
    DATE-REV-FROM-FILLER1 = "/";
    DATE-REV-FROM-FILLER2 = "/";
    VHCHR01_CRIT.DATE-REV-FROM = VHCHR1IW.DATE-REV-FROM;

  
  
  
  
    DATE-REV-TO-FILLER1 = "/";
    DATE-REV-TO-FILLER2 = "/";
    VHCHR01_CRIT.DATE-REV-TO = VHCHR1IW.DATE-REV-TO;
    VHCHR01_CRIT.CAR-NO = VHCHR1IW.CAR-NO-NUM;
    VHCHR01_CRIT.REPT-TYPE = VHCHR1IW.VTAM-NAME;

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCHR01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCHR01";

    
    try
        call "VHCHR01"(XDCONTROL, VHCHR01_CRIT, VHCHR01_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
            VHCHR1IW-TRIGGER.SUBMIT = "Y";
        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHCHR1IS-INIT () 
    set VHCHR1IW empty;
    VHCHR1IW.DATE-REV-FROM = " ";
    VHCHR1IW.DATE-REV-TO = " ";
    set VHCHR1A_DATA empty;
end 

Function VHCHR1IS-INIT-X ()
  
  
  
  
  
  
  
  


   
    XXEXT_CALL_Level77Items.UEXTNAM = "WS100I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS70A01";

    
    try
        call "WS70A01"(XDCONTROL, WS70A01_DATA);
    
    end
    

  
    MRSCommonCode.XXA0IS-CHECK_EXT();

  
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHCHR1IS-LIST () 
    VHCHR1IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    VHCHR1IW.CAR-NO = VHCHR1IW.CAR-NO-NUM;
    if (VHCHR1IW.CAR-NO not numeric)
        VHCHR1IW.CAR-MESSAGE = "Car no not numeric";
        VHCHR1IW-TRIGGER.INVALID-CAR-NO = "Y";
        return;
    else
        if (VHCHR1IW.CAR-NO == " " || VHCHR1IW.CAR-NO == "0000")
            VHCHR1IW.CAR-MESSAGE = "Invalid Car no ";
            VHCHR1IW-TRIGGER.INVALID-CAR-NO = "Y";
            return;
        else
    
            VHINC6A_CRIT.CAR-NO = VHCHR1IW.CAR-NO;
            try
                call "MRSVehicleIncident.VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
            
            end
            if (XDCONTROL.UROWCNT == 1)

            else
                if (XDCONTROL.URC == 100)
                    VHCHR1IW.CAR-MESSAGE = "Car no does not exist";
                    INVALID-CAR-NO = "Y";
                     
                    return;
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                end
            end
        end
    end
    if (VHCHR1IW.DATE-REV-FROM == " ")
        INVALID-DATE-REV-FROM = "Y";
        return;
    else
        AFCXVLD_CRIT.FORM-DATE = VHCHR1IW.DATE-REV-FROM;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            INVALID-DATE-REV-FROM = "Y";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end

  
    if ((DATE-REV-FROM-YEAR < 1999) ||
     (DATE-REV-FROM-YEAR == 1999 &&
     DATE-REV-FROM-MON < 12) ||
     (DATE-REV-FROM-YEAR == 1999 &&
     DATE-REV-FROM-MON == 12 &&
     DATE-REV-FROM-DAY < 29))
        VHCHR1IW.DATE-REV-FROM = "12-29-1999";
    end
  
    if (VHCHR1IW.DATE-REV-TO == " ")
        INVALID-DATE-REV-TO = "Y";
        return;
    else
        AFCXVLD_CRIT.FORM-DATE = VHCHR1IW.DATE-REV-TO;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            INVALID-DATE-REV-TO = "Y";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if ((DATE-REV-TO-YEAR > SYSTEM-DATE-YEAR) ||
     (DATE-REV-TO-YEAR == SYSTEM-DATE-YEAR &&
     DATE-REV-TO-MON > SYSTEM-DATE-MON) ||
     (DATE-REV-TO-YEAR == SYSTEM-DATE-YEAR &&
     DATE-REV-TO-MON == SYSTEM-DATE-MON &&
     DATE-REV-TO-DAY > SYSTEM-DATE-DAY))
        INVALID-TO-GR-SYS = "Y";
        return;
    end
    if ((DATE-REV-FROM-YEAR > DATE-REV-TO-YEAR) ||
     (DATE-REV-FROM-YEAR == DATE-REV-TO-YEAR &&
     DATE-REV-FROM-MON > DATE-REV-TO-MON) ||
     (DATE-REV-FROM-YEAR == DATE-REV-TO-YEAR &&
     DATE-REV-FROM-MON == DATE-REV-TO-MON &&
     DATE-REV-FROM-DAY > DATE-REV-TO-DAY))
        INVALID-FROM-GR-TO = "Y";
        return;
    end
    XXDATEW.DATE-MM-DD-YYYY = VHCHR1IW.DATE-REV-FROM;
    XXDATEW.VAGen_FUNCTION = "YMD";
    MRSCommonCode.XXDATES-CONVERT();
    VHCHR1A_CRIT.DATE-REV-FROM = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.DATE-MM-DD-YYYY = VHCHR1IW.DATE-REV-TO;
    XXDATEW.VAGen_FUNCTION = "YMD";
    MRSCommonCode.XXDATES-CONVERT();
    VHCHR1A_CRIT.DATE-REV-TO = XXDATEW.DATE-YYYY-MM-DD;
    VHCHR1A_CRIT.CAR-NO = VHCHR1IW.CAR-NO;
    try
        call "VHCHR1A"(XDCONTROL, VHCHR1A_CRIT, VHCHR1A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else
        if (XDCONTROL.URC == 100)
            XXMESSAGE.UMSGCODE = "AFCR001";
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHCHR1IS-SUBMIT-X () 
    VHCHR1IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    VHCHR1IW.CAR-NO = VHCHR1IW.CAR-NO-NUM;
    if (VHCHR1IW.CAR-NO not numeric)
        VHCHR1IW.CAR-MESSAGE = "Car no not numeric";
        VHCHR1IW-TRIGGER.INVALID-CAR-NO = "Y";
        return;
    else
        if (VHCHR1IW.CAR-NO == " " || VHCHR1IW.CAR-NO == "0000")
            VHCHR1IW.CAR-MESSAGE = "Invalid Car no ";
            VHCHR1IW-TRIGGER.INVALID-CAR-NO = "Y";
            return;
        else
    
            VHINC6A_CRIT.CAR-NO = VHCHR1IW.CAR-NO;
            try
                call "MRSVehicleIncident.VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
            
            end
            if (XDCONTROL.UROWCNT == 1)

            else
                if (XDCONTROL.URC == 100)
                    VHCHR1IW.CAR-MESSAGE = "Car no does not exist";
                    INVALID-CAR-NO = "Y";
                     
                    return;
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                end
            end
        end
    end
    if (VHCHR1IW.DATE-REV-FROM == " ")
        INVALID-DATE-REV-FROM = "Y";
        return;
    else
        AFCXVLD_CRIT.FORM-DATE = VHCHR1IW.DATE-REV-FROM;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            INVALID-DATE-REV-FROM = "Y";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHCHR1IW.DATE-REV-TO == " ")
        INVALID-DATE-REV-TO = "Y";
        return;
    else
        AFCXVLD_CRIT.FORM-DATE = VHCHR1IW.DATE-REV-TO;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            INVALID-DATE-REV-TO = "Y";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if ((DATE-REV-TO-YEAR > SYSTEM-DATE-YEAR) ||
     (DATE-REV-TO-YEAR == SYSTEM-DATE-YEAR &&
     DATE-REV-TO-MON > SYSTEM-DATE-MON) ||
     (DATE-REV-TO-YEAR == SYSTEM-DATE-YEAR &&
     DATE-REV-TO-MON == SYSTEM-DATE-MON &&
     DATE-REV-TO-DAY > SYSTEM-DATE-DAY))
        INVALID-TO-GR-SYS = "Y";
        return;
    end
    if ((DATE-REV-FROM-YEAR > DATE-REV-TO-YEAR) ||
     (DATE-REV-FROM-YEAR == DATE-REV-TO-YEAR &&
     DATE-REV-FROM-MON > DATE-REV-TO-MON) ||
     (DATE-REV-FROM-YEAR == DATE-REV-TO-YEAR &&
     DATE-REV-FROM-MON == DATE-REV-TO-MON &&
     DATE-REV-FROM-DAY > DATE-REV-TO-DAY))
        INVALID-FROM-GR-TO = "Y";
        return;
    end
    VHCHR01IS-SUBMIT();
end 

Function VHCL01I-REV-DATE2 ()
  
  
  
  
  
  
  
  
  
  
  

  
  

  
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHST01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHXREVA";

  
    VHXREVA_CRIT.SEL-IDX = 3;

    
    try
        call "VHXREVA"(XDCONTROL, VHXREVA_CRIT, VHXREVA_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end


  
  
  
  
  
  
  

  
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHST01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHSV011";

  
    try
        call "VHSV011"(XDCONTROL, VHSV011_DATA);
    
    end
    
    
    MRSCommonCode.XXA0IS-CHECK_EXT();
    
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHST01IW.DATE-LOW = VHSV011_DATA.FROM-DATE;
             
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end


  
  

  
  
  
  

  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHXREVA_DATA.REVENUE-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHST01IW.REV-DATE-DB2 = XXDATEW.DATE-YYYY-MM-DD;

  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHST01IW.DATE-LOW;
    MRSCommonCode.XXDATES-CONVERT();
    VHST01IW.DATE-LOW-DB2 = XXDATEW.DATE-YYYY-MM-DD;
end 

Function VHCL01IS-CLEAR () 
    set VHCL01IW empty;
    set VHCL01IW-MSG empty;
    VHCL01IW-TRIGGERS.DISABLE-HARD = "Y";
