    CAR-TOTAL-DATA[13] = UNSCHD-MAIN-T + WAITPART-UM-T + PREVEN-MAIN-T + WARRANTY-T + ENGRNG-HOLD-T + MODIFY-CARS-T + MISCEL-HOLD-T;

  

  
    CAR-A-DATA[15] = CAR-A-DATA[3] - CAR-A-DATA[13];
    CAR-B-DATA[15] = CAR-B-DATA[3] - CAR-B-DATA[13];
    CAR-CW-DATA[15] = CAR-CW-DATA[3] - CAR-CW-DATA[13];
