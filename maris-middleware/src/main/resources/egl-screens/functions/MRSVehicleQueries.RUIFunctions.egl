            end 
        end 
        VAGen_COUNT = VAGen_COUNT + 1;
    end 

  
    VAGen_INDEX = 1;
    while (VAGen_INDEX < 8)
  
        VHDVS3I_FLEET.FLEET-A[VAGen_INDEX] = VHDVS3I_FLEET.CY-A[VAGen_INDEX] + VHDVS3I_FLEET.DY-A[VAGen_INDEX] + VHDVS3I_FLEET.HY-A[VAGen_INDEX] + VHDVS3I_FLEET.RY-A[VAGen_INDEX];
        VHDVS3I_FLEET.FLEET-B[VAGen_INDEX] = VHDVS3I_FLEET.CY-B[VAGen_INDEX] + VHDVS3I_FLEET.DY-B[VAGen_INDEX] + VHDVS3I_FLEET.HY-B[VAGen_INDEX] + VHDVS3I_FLEET.RY-B[VAGen_INDEX];
