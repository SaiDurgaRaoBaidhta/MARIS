Function VHCP01IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  

  
  
  
   
    if (VHCP01IW-TRIGGER.OK-SUBMIT == "Y")
        VHCP01IW.FROM-DATE-FILLER1 = "/";
        VHCP01IW.FROM-DATE-FILLER2 = "/";
        VHCP01IW.TO-DATE-FILLER1 = "/";
        VHCP01IW.TO-DATE-FILLER2 = "/";
        VHCP01D_CRIT.FROM-DATE = VHCP01IW.FROM-DATE;
        VHCP01D_CRIT.TO-DATE = VHCP01IW.TO-DATE;
        VHCP01D_CRIT.YRD = VHCP01IW.YRD;
        VHCP01D_CRIT.REPT-ID = VHCP01IW-TRIGGER.VTAM-NAME;

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHCP01I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCP01D";

    
        try
            call "VHCP01D"(XDCONTROL, VHCP01D_CRIT, VHCP01D_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
                VHCP01IW-TRIGGER.SUBMIT = "Y";
            else

        


        
    
    
    
    
                VHCP01I_MESSAGE.MESG1 = "INVALID PARAMETER LIST";
            end
        else

        end
    end
end 

Function VHCP01IS-SUBMIT-X () 
    VHCP01IW-TRIGGER.OK-SUBMIT = "Y";
    VHCP01IW.NULL-TO-ERROR = "N";
    VHCP01IW.INVALID-TO-DATE = " ";
    VHCP01IW.INVALID-FROM-DATE = " ";
    if (VHCP01IW.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHCP01IW.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHCP01IW.INVALID-FROM-DATE = "Y";
            
   
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHCP01I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHCP01IW.TO-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHCP01IW.TO-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHCP01IW.INVALID-TO-DATE = "Y";
            
  
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHCP01I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHCP01IW.YRD == "   ")
        VHCP01I_MESSAGE.MESG1 = "INVALID YARD SELECTION";
        VHCP01IW.INVALID-YRD = "Y";
        AFCXVLDW.NO-ERROR = "N";
    end
    if (VHCP01IW.INVALID-FROM-DATE == "Y")
        VHCP01I_MESSAGE.MESG1 = "INVALID FROM DATE";
        VHCP01IW-TRIGGER.OK-SUBMIT = "N";
    else
  
        if (VHCP01IW.TO-DATE != " ")
            if ((VHCP01IW.TO-DATE-YEAR-NUM > VHCP01IW.WS-CURR-YEAR-NUM) ||
             (VHCP01IW.TO-DATE-YEAR-NUM == VHCP01IW.WS-CURR-YEAR-NUM &&
             VHCP01IW.TO-DATE-MO-NUM > VHCP01IW.WS-CURR-MO-NUM) ||
             (VHCP01IW.TO-DATE-YEAR-NUM == VHCP01IW.WS-CURR-YEAR-NUM &&
             VHCP01IW.TO-DATE-MO-NUM == VHCP01IW.WS-CURR-MO-NUM &&
             VHCP01IW.TO-DATE-DAY-NUM > VHCP01IW.WS-CURR-DA-NUM))
                VHCP01I_MESSAGE.MESG1 = "To date cannot be greater than CURRENT_DATE.";
                VHCP01IW.INVALID-TO-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                
  
            end
        end
    end
    if (VHCP01IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHCP01IW.INVALID-TO-DATE == "Y")
            VHCP01I_MESSAGE.MESG1 = "INVALID TO DATE";
            VHCP01IW-TRIGGER.OK-SUBMIT = "N";
        else
  
            if (VHCP01IW.FROM-DATE != " " && VHCP01IW.TO-DATE != " ")
                if ((VHCP01IW.FROM-DATE-YEAR-NUM > VHCP01IW.TO-DATE-YEAR-NUM) ||
                 (VHCP01IW.FROM-DATE-YEAR-NUM == VHCP01IW.TO-DATE-YEAR-NUM &&
                 VHCP01IW.FROM-DATE-MO-NUM > VHCP01IW.TO-DATE-MO-NUM) ||
                 (VHCP01IW.FROM-DATE-YEAR-NUM == VHCP01IW.TO-DATE-YEAR-NUM &&
                 VHCP01IW.FROM-DATE-MO-NUM == VHCP01IW.TO-DATE-MO-NUM &&
                 VHCP01IW.FROM-DATE-DAY-NUM > VHCP01IW.TO-DATE-DAY-NUM))
                    VHCP01I_MESSAGE.MESG1 = "From date cannot be greater than To date.";
                    VHCP01IW.INVALID-FROM-DATE = "Y";
                    AFCXVLDW.NO-ERROR = "N";
                    
  
                end
            end
        end
    end
    if (VHCP01IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHCP01IW-TRIGGER.INVALID-SYMP-TO == "Y")
            VHCP01IW-TRIGGER.OK-SUBMIT = "N";
        else
            if (VHCP01IW-TRIGGER.INVALID-SYMP-FROM == "Y")
                VHCP01IW-TRIGGER.OK-SUBMIT = "N";
            else
  
  
  
                if (AFCXVLDW.NO-ERROR == "N")
                    VHCP01IW-TRIGGER.OK-SUBMIT = " ";
                else
                    VHCP01IW-TRIGGER.OK-SUBMIT = "Y ";
                end
            end
        end
    end
end 

Function VHCP01OS-INIT () 
    VHCP01IW.WS-CURRENT-DATE = VGVar.currentFormattedGregorianDate;
    try
        call "VHCP01A"(XDCONTROL, VHCP01A_CRIT, VHCP01A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCP01IW.FROM-DATE = VHCP01A_DATA.FROM-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHCP01IW.FROM-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHCP01IW.FROM-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHCP01IW.FROM-DATE-FILLER1 = "-";
        VHCP01IW.FROM-DATE-FILLER2 = "-";
    end
    try
        call "VHCP01B"(XDCONTROL, VHCP01B_CRIT, VHCP01B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCP01IW.TO-DATE = VHCP01B_DATA.TO-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHCP01IW.TO-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHCP01IW.TO-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHCP01IW.TO-DATE-FILLER1 = "-";
        VHCP01IW.TO-DATE-FILLER2 = "-";
    end
  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCP01C";
    try
        call "VHCP01C"(XDCONTROL, VHCP01C_CRIT, VHCP01C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCP01C_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
  
  
  
    VHCP01I_MESSAGE.MESG1 = "                                                                                   ";
    VHCP01I_MESSAGE.MESG2 = "                                                                                   ";
    VHCP01I_MESSAGE.MESG3 = "                                                                                   ";
end 

Function VHCSH1IS-PRINT () 
    VHCSH1IW.CAR-COUNT = 0;
    VHCSH1IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    if (VHCSH1IW.CAR-NO == " ")
        INVALID-CARNO = "Y";
        return;
    else
        if (VHCSH1IW.CAR-NO not numeric)
            INVALID-CARNO = "Y";
            return;
        end
    end
    if (VHCSH1IW.FROM-DATE == " ")
        INVALID-FROM-DATE = "Y";
        return;
    else
        if ((VHCSH1IW.FROM-DATE-FILLER1 != "-" &&
         VHCSH1IW.FROM-DATE-FILLER1 != "/") ||
         (VHCSH1IW.FROM-DATE-FILLER2 != "-" &&
         VHCSH1IW.FROM-DATE-FILLER2 != "/"))
            INVALID-FROM-DATE = "Y";
            return;
        else
            AFCXVLD_CRIT.FORM-DATE = VHCSH1IW.FROM-DATE;
            MRSCommonCode.AFCXVLD-VALIDATE();
            if (AFCXVLDW.INCORRECT-DATE == "Y")
                INVALID-FROM-DATE = "Y";
                return;
            else
                if (AFCXVLDW.SQL-ERROR == "Y")
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                else
                    if (AFCXVLDW.NO-ERROR == "Y")

                    end
                end
            end
        end
    end
    if (VHCSH1IW.FROM-DATE-YR > VHCSH1IW.SYSTEM-DATE-YR ||
     (VHCSH1IW.FROM-DATE-YR == VHCSH1IW.SYSTEM-DATE-YR &&
     VHCSH1IW.FROM-DATE-MON > VHCSH1IW.SYSTEM-DATE-MON) ||
     (VHCSH1IW.FROM-DATE-YR == VHCSH1IW.SYSTEM-DATE-YR &&
     VHCSH1IW.FROM-DATE-MON == VHCSH1IW.SYSTEM-DATE-MON &&
     VHCSH1IW.FROM-DATE-DAY > VHCSH1IW.SYSTEM-DATE-DAY))
        FROM-GR-SYS = "Y";
        return;
    end
    if (VHCSH1IW.TO-DATE == " ")
        INVALID-TO-DATE = "Y";
        return;
    else
        if ((VHCSH1IW.TO-DATE-FILLER1 != "-" &&
         VHCSH1IW.TO-DATE-FILLER1 != "/") ||
         (VHCSH1IW.TO-DATE-FILLER2 != "-" &&
         VHCSH1IW.TO-DATE-FILLER2 != "/"))
            INVALID-TO-DATE = "Y";
            return;
        else
            AFCXVLD_CRIT.FORM-DATE = VHCSH1IW.TO-DATE;
            MRSCommonCode.AFCXVLD-VALIDATE();
            if (AFCXVLDW.INCORRECT-DATE == "Y")
                VHCSH1IW-TRIGGER.INVALID-TO-DATE = "Y";
                return;
            else
                if (AFCXVLDW.SQL-ERROR == "Y")
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                else
                    if (AFCXVLDW.NO-ERROR == "Y")

                    end
                end
            end
        end
    end
    if (VHCSH1IW.TO-DATE-YR > VHCSH1IW.SYSTEM-DATE-YR ||
     (VHCSH1IW.TO-DATE-YR == VHCSH1IW.SYSTEM-DATE-YR &&
     VHCSH1IW.TO-DATE-MON > VHCSH1IW.SYSTEM-DATE-MON) ||
     (VHCSH1IW.TO-DATE-YR == VHCSH1IW.SYSTEM-DATE-YR &&
     VHCSH1IW.TO-DATE-MON == VHCSH1IW.SYSTEM-DATE-MON &&
     VHCSH1IW.TO-DATE-DAY > VHCSH1IW.SYSTEM-DATE-DAY))
        TO-GR-SYS = "Y";
        return;
    else
        if (VHCSH1IW.TO-DATE-YR < VHCSH1IW.FROM-DATE-YR ||
         (VHCSH1IW.TO-DATE-YR == VHCSH1IW.FROM-DATE-YR &&
         VHCSH1IW.TO-DATE-MON < VHCSH1IW.FROM-DATE-MON) ||
         (VHCSH1IW.TO-DATE-YR == VHCSH1IW.FROM-DATE-YR &&
         VHCSH1IW.TO-DATE-MON == VHCSH1IW.FROM-DATE-MON &&
         VHCSH1IW.TO-DATE-DAY < VHCSH1IW.FROM-DATE-DAY))
            FROM-LESS-TO = "Y";
            return;
        else
            if (AFCXVLDW.NO-ERROR == "Y")
                VHCSH1IW-TRIGGER.VAGen_PRINT = "Y";
            end
        end
    end
    VHCSH1A_CRIT.CAR-NO = VHCSH1IW.CAR-NO;
    VHCSH1A_CRIT.FROM-DATE = VHCSH1IW.FROM-DATE;
    VHCSH1A_CRIT.TO-DATE = VHCSH1IW.TO-DATE;
end 

Function VHCSH1IS-RET-DATA () 
    VHCSH1IW.CAR-COUNT = 0;
    VHCSH1IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    if (VHCSH1IW.CAR-NO == " ")
        INVALID-CARNO = "Y";
        return;
    else
        if (VHCSH1IW.CAR-NO not numeric)
            INVALID-CARNO = "Y";
            return;
        else
     
            VHINC6A_CRIT.CAR-NO = VHCSH1IW.CAR-NO;
            try
                call "MRSVehicleIncident.VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
            
            end
            if (XDCONTROL.UROWCNT == 1)

            else
                if (XDCONTROL.URC == 100)
                    CAR-NOT-FOUND = "Y";
                    return;
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                end
            end
        end
    end
    if (VHCSH1IW.FROM-DATE == " ")
        INVALID-FROM-DATE = "Y";
        return;
    else
        if ((VHCSH1IW.FROM-DATE-FILLER1 != "-" &&
         VHCSH1IW.FROM-DATE-FILLER1 != "/") ||
         (VHCSH1IW.FROM-DATE-FILLER2 != "-" &&
         VHCSH1IW.FROM-DATE-FILLER2 != "/"))
            INVALID-FROM-DATE = "Y";
            return;
        else
            AFCXVLD_CRIT.FORM-DATE = VHCSH1IW.FROM-DATE;
            MRSCommonCode.AFCXVLD-VALIDATE();
            if (AFCXVLDW.INCORRECT-DATE == "Y")
                INVALID-FROM-DATE = "Y";
                return;
            else
                if (AFCXVLDW.SQL-ERROR == "Y")
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                else
                    if (AFCXVLDW.NO-ERROR == "Y")

                    end
                end
            end
        end
    end

  
    if (VHCSH1IW.FROM-DATE-YR < 2000 ||
     (VHCSH1IW.FROM-DATE-YR == 2000 &&
     VHCSH1IW.FROM-DATE-MON < 01) ||
     (VHCSH1IW.FROM-DATE-YR == 2000 &&
     VHCSH1IW.FROM-DATE-MON == 01 &&
     VHCSH1IW.FROM-DATE-DAY < 14))
        VHCSH1IW.FROM-DATE = "01-14-2000";
    end
  
    if (VHCSH1IW.FROM-DATE-YR > VHCSH1IW.SYSTEM-DATE-YR ||
     (VHCSH1IW.FROM-DATE-YR == VHCSH1IW.SYSTEM-DATE-YR &&
     VHCSH1IW.FROM-DATE-MON > VHCSH1IW.SYSTEM-DATE-MON) ||
     (VHCSH1IW.FROM-DATE-YR == VHCSH1IW.SYSTEM-DATE-YR &&
     VHCSH1IW.FROM-DATE-MON == VHCSH1IW.SYSTEM-DATE-MON &&
     VHCSH1IW.FROM-DATE-DAY > VHCSH1IW.SYSTEM-DATE-DAY))
        FROM-GR-SYS = "Y";
        return;
    end
    if (VHCSH1IW.TO-DATE == " ")
        INVALID-TO-DATE = "Y";
        return;
    else
        if ((VHCSH1IW.TO-DATE-FILLER1 != "-" &&
         VHCSH1IW.TO-DATE-FILLER1 != "/") ||
         (VHCSH1IW.TO-DATE-FILLER2 != "-" &&
         VHCSH1IW.TO-DATE-FILLER2 != "/"))
            INVALID-TO-DATE = "Y";
            return;
        else
            AFCXVLD_CRIT.FORM-DATE = VHCSH1IW.TO-DATE;
            MRSCommonCode.AFCXVLD-VALIDATE();
            if (AFCXVLDW.INCORRECT-DATE == "Y")
                VHCSH1IW-TRIGGER.INVALID-TO-DATE = "Y";
                return;
            else
                if (AFCXVLDW.SQL-ERROR == "Y")
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                else
                    if (AFCXVLDW.NO-ERROR == "Y")

                    end
                end
            end
        end
    end
    if (VHCSH1IW.TO-DATE-YR > VHCSH1IW.SYSTEM-DATE-YR ||
     (VHCSH1IW.TO-DATE-YR == VHCSH1IW.SYSTEM-DATE-YR &&
     VHCSH1IW.TO-DATE-MON > VHCSH1IW.SYSTEM-DATE-MON) ||
     (VHCSH1IW.TO-DATE-YR == VHCSH1IW.SYSTEM-DATE-YR &&
     VHCSH1IW.TO-DATE-MON == VHCSH1IW.SYSTEM-DATE-MON &&
     VHCSH1IW.TO-DATE-DAY > VHCSH1IW.SYSTEM-DATE-DAY))
        TO-GR-SYS = "Y";
        return;
    end
    if (VHCSH1IW.TO-DATE-YR < VHCSH1IW.FROM-DATE-YR ||
     (VHCSH1IW.TO-DATE-YR == VHCSH1IW.FROM-DATE-YR &&
     VHCSH1IW.TO-DATE-MON < VHCSH1IW.FROM-DATE-MON) ||
     (VHCSH1IW.TO-DATE-YR == VHCSH1IW.FROM-DATE-YR &&
     VHCSH1IW.TO-DATE-MON == VHCSH1IW.FROM-DATE-MON &&
     VHCSH1IW.TO-DATE-DAY < VHCSH1IW.FROM-DATE-DAY))
        FROM-LESS-TO = "Y";
        return;
    end
    VHCSH1A_CRIT.CAR-NO = VHCSH1IW.CAR-NO;
    VHCSH1A_CRIT.FROM-DATE = VHCSH1IW.FROM-DATE;
    VHCSH1A_CRIT.TO-DATE = VHCSH1IW.TO-DATE;
    try
        call "VHCSH1A"(XDCONTROL, VHCSH1A_CRIT, VHCSH1A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCSH1IW.CAR-COUNT = XDCONTROL.UROWCNT;
        VHCSH1IW.HOME-YRD = VHCSH1A_DATA.HOME-YRD;
        if (VHCSH1IW.CAR-COUNT == 200)
            DISPLAY-FOOTER = "Y";
        else
            HIDE-FOOTER = "Y";
        end
        LOAD-DATA = "Y";
    else
        if (XDCONTROL.URC == 100)
            set VHCSH1A_DATA empty;
            LOAD-DATA = "Y";
            HIDE-FOOTER = "Y";
            NO-REC-FOUND = "Y";
        else
            set VHCSH1A_DATA empty;
            LOAD-DATA = "Y";
            HIDE-FOOTER = "Y";
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHCSH1IW-CLEAR () 
    VHCSH1IW.CAR-COUNT = 0;
    VHCSH1IW.CAR-NO = " ";
    VHCSH1IW.FROM-DATE = " ";
    VHCSH1IW.TO-DATE = " ";
    VHCSH1IW.HOME-YRD = " ";
    set VHCSH1A_DATA empty;
    HIDE-FOOTER = "Y";
    LOAD-DATA = "Y";
end 

Function VHCSH2IS-HARD-COPY () 
    if (PRT-IDX > 0)
        ENABLE-HARD = "Y";
        VHCSH2IW-PASSVALUE.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRT-IDX];
    else
        DISABLE-HARD = "Y";
    end
end 




Function VHCSH2IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  

  
  
  
   
    set VHCSH2A_CRIT empty;
    VHCSH2A_CRIT.REPT-TYPE = VHCSH2IW-PASSVALUE.VTAM-NAME;
    DATE-FROM-FILLER1 = "/";
    DATE-FROM-FILLER2 = "/";
    DATE-TO-FILLER1 = "/";
    DATE-TO-FILLER2 = "/";
    VHCSH2A_CRIT.DATE-FROM = VHCSH2IW-PASSVALUE.DATE-FROM;
    VHCSH2A_CRIT.DATE-TO = VHCSH2IW-PASSVALUE.DATE-TO;
    VHCSH2A_CRIT.CAR-NO = VHCSH2IW-PASSVALUE.CAR-NO;

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCSH2I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCSH2A";

    
    try
        call "VHCSH2A"(XDCONTROL, VHCSH2A_CRIT, VHCSH2A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
            VHCSH2IW-TRIGGER.SUBMIT = "Y";
        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHDC01I-CLEAR () 
    VHDC01IW.BLANK-FORM = "N";
    VHDC01IW.CAR-NO = " ";
    VHDC01IW.INCIDENT-NO = " ";
end 

Function VHDC01I-VALIDATE () 
    if (VHDC01IW.BLANK-FORM == "Y")
        if (VHDC01IW.CAR-NO == " " &&
         VHDC01IW.INCIDENT-NO == " ")
            VHDC01IS-PRINT-BK();
        else
            VHDC01IW-TRIGGER.NO-BLANK-ERROR = "Y";
        end
    else
        if (VHDC01IW.BLANK-FORM == "N")
            if (VHDC01IW.CAR-NO == " " &&
             VHDC01IW.INCIDENT-NO == " ")
                VHDC01IW-TRIGGER.NO-CAR-ERROR = "Y";
            else
                VHDC01IS-VALID-CAR();
  
            end
        else
            VHDC01IW-TRIGGER.ERROR-BLANK = "Y";
        end
    end
end 

Function VHDC01IS-HARD-COPY () 
    if (PRT-IDX > 0)
        ENABLE-OK = "Y";
        VHDC01IW.CICS-VTAM-NAME = VHDC011_DATA.CICS-VTAM-NAME[PRT-IDX];
    else
        DISABLE-OK = "Y";
    end
end 

