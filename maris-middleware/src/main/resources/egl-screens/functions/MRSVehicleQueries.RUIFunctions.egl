Function VHPS01IS-SUBMIT-X () 
    VHPS01IW-TRIGGER.OK-SUBMIT = "Y";
    VHPS01IW.NULL-TO-ERROR = "N";
    VHPS01IW.INVALID-TO-DATE = " ";
    VHPS01IW.INVALID-FROM-DATE = " ";
    if (VHPS01IW.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHPS01IW.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHPS01IW.INVALID-FROM-DATE = "Y";
            
         
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHPS01I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHPS01IW.TO-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHPS01IW.TO-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHPS01IW.INVALID-TO-DATE = "Y";
            
  
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHPS01I_MESSAGE.MESG1 = "INVALID TO DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHPS01IW.INVALID-FROM-DATE == "Y")
        VHPS01I_MESSAGE.MESG1 = "INVALID FROM DATE";
        VHPS01IW-TRIGGER.OK-SUBMIT = "N";
    else
  
        if (VHPS01IW.TO-DATE != " ")
            if ((VHPS01IW.TO-DATE-YEAR-NUM > VHPS01IW.WS-CURR-YEAR-NUM) ||
             (VHPS01IW.TO-DATE-YEAR-NUM == VHPS01IW.WS-CURR-YEAR-NUM &&
             VHPS01IW.TO-DATE-MO-NUM > VHPS01IW.WS-CURR-MO-NUM) ||
             (VHPS01IW.TO-DATE-YEAR-NUM == VHPS01IW.WS-CURR-YEAR-NUM &&
             VHPS01IW.TO-DATE-MO-NUM == VHPS01IW.WS-CURR-MO-NUM &&
             VHPS01IW.TO-DATE-DAY-NUM > VHPS01IW.WS-CURR-DA-NUM))
                VHPS01I_MESSAGE.MESG1 = "To date cannot be greater than CURRENT_DATE.";
                VHPS01IW.INVALID-TO-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                
  
            end
        end
    end
    if (VHPS01IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHPS01IW.INVALID-TO-DATE == "Y")
            VHPS01I_MESSAGE.MESG1 = "INVALID TO DATE";
            VHPS01IW-TRIGGER.OK-SUBMIT = "N";
        else
  
            if (VHPS01IW.FROM-DATE != " " && VHPS01IW.TO-DATE != " ")
                if ((VHPS01IW.FROM-DATE-YEAR-NUM > VHPS01IW.TO-DATE-YEAR-NUM) ||
                 (VHPS01IW.FROM-DATE-YEAR-NUM == VHPS01IW.TO-DATE-YEAR-NUM &&
                 VHPS01IW.FROM-DATE-MO-NUM > VHPS01IW.TO-DATE-MO-NUM) ||
                 (VHPS01IW.FROM-DATE-YEAR-NUM == VHPS01IW.TO-DATE-YEAR-NUM &&
                 VHPS01IW.FROM-DATE-MO-NUM == VHPS01IW.TO-DATE-MO-NUM &&
                 VHPS01IW.FROM-DATE-DAY-NUM > VHPS01IW.TO-DATE-DAY-NUM))
                    VHPS01I_MESSAGE.MESG1 = "From date cannot be greater than To date.";
                    VHPS01IW.INVALID-FROM-DATE = "Y";
                    AFCXVLDW.NO-ERROR = "N";
                    
  
                end
            end
        end
    end
    if (VHPS01IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHPS01IW-TRIGGER.INVALID-SYMP-TO == "Y")
            VHPS01IW-TRIGGER.OK-SUBMIT = "N";
        else
            if (VHPS01IW-TRIGGER.INVALID-SYMP-FROM == "Y")
                VHPS01IW-TRIGGER.OK-SUBMIT = "N";
            else
   
   
   
                if (AFCXVLDW.NO-ERROR == "N")
                    VHPS01IW-TRIGGER.OK-SUBMIT = " ";
                else
                    VHPS01IW-TRIGGER.OK-SUBMIT = "Y ";
                end
            end
        end
    end
end 

Function VHPT01-CLEAR () 
    VHPT01IW.WS-CURRENT-DATE = VGVar.currentFormattedGregorianDate;
    try
        call "VHPT01A"(XDCONTROL, VHPT01A_CRIT, VHPT01A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHPT01IW.FROM-DATE = VHPT01A_DATA.FROM-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHPT01IW.FROM-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHPT01IW.FROM-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHPT01IW.FROM-DATE-FILLER1 = "-";
        VHPT01IW.FROM-DATE-FILLER2 = "-";
    end
    try
        call "VHPT01B"(XDCONTROL, VHPT01B_CRIT, VHPT01B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHPT01IW.TO-DATE = VHPT01B_DATA.TO-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHPT01IW.TO-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHPT01IW.TO-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHPT01IW.TO-DATE-FILLER1 = "-";
        VHPT01IW.TO-DATE-FILLER2 = "-";
    end
  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHPT01C";
    try
        call "VHPT01C"(XDCONTROL, VHPT01C_CRIT, VHPT01C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHPT01C_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    VHPT01I_MESSAGE.MESG1 = "                                                                                   ";
    VHPT01I_MESSAGE.MESG2 = "                                                                                   ";
    VHPT01I_MESSAGE.MESG3 = "                                                                                   ";
end 

