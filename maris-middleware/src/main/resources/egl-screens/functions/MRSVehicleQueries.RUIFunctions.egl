Function VHYS01IS-MOVE-VAL () 
    FINAL-ERROR-MESSAGE = " ";
    VHYS01IW.CAR-ERROR-MESSAGE = " ";
    if (VHYS01IW.CAR-NO-FROM != " ")
        if (VHYS01IW.CAR-NO-FROM not numeric)
            VHYS01IW.CAR-ERROR-MESSAGE = "Invalid From Car no";
            FINAL-ERROR-MESSAGE = VHYS01IW.CAR-ERROR-MESSAGE;
            CAR-FROM-SETFOCUS = "Y";
            return;
        else

        end
    end
    if (VHYS01IW.CAR-NO-TO != " ")
        if (VHYS01IW.CAR-NO-TO not numeric)
            VHYS01IW.CAR-ERROR-MESSAGE = "Invalid To Car no";
            FINAL-ERROR-MESSAGE = VHYS01IW.CAR-ERROR-MESSAGE;
            CAR-TO-SETFOCUS = "Y";
            return;
        else

        end
    end
    if (VHYS01IW.CAR-NO-FROM == " ")
        VHYS01IW.PASSVALUE-CAR-FROM = "0000";
    else
        VHYS01IW.PASSVALUE-CAR-FROM = VHYS01IW.CAR-NO-FROM;
    end
    if (VHYS01IW.CAR-NO-TO == " ")
        VHYS01IW.PASSVALUE-CAR-TO = "9999";
    else
        VHYS01IW.PASSVALUE-CAR-TO = VHYS01IW.CAR-NO-TO;
    end
    if (VHYS01IW.HOME-YARD-BASE == 1 &&
     VHYS01IW.HOME-YARD-STATUS == 0 &&
     VHYS01IW.HOME-YARD-NOGO == 0 &&
     VHYS01IW.HOME-YARD-SUMMARY == 0)
        VHYS01IW.PASSVALUE-HOME-YRD = VHYS01IW.YARD-BASE;
        VHYS01IW.PASSVALUE-NARR-IND = VHYS01IW.NARR-IND-BASE;
        VHYS01IW.PASSVALUE-TITLE = "VHYS02I - Home Yard Status Report - Base";
        VHYS01IW.PASSVALUE-REPORT-OPTION = 1;
        VHYS01IW-TRIGGER.OPEN-VHYS02I = "Y";
    else
        if (VHYS01IW.HOME-YARD-BASE == 0 &&
         VHYS01IW.HOME-YARD-STATUS == 1 &&
         VHYS01IW.HOME-YARD-NOGO == 0 &&
         VHYS01IW.HOME-YARD-SUMMARY == 0)
            VHYS01IW.PASSVALUE-HOME-YRD = VHYS01IW.YARD-STATUS;
            VHYS01IW.PASSVALUE-VEH-STAT = VHYS01IW.VEH-STATUS;
            VHYS01IW.PASSVALUE-NARR-IND = VHYS01IW.NARR-IND-STATUS;
            VHYS01IW.PASSVALUE-REPORT-OPTION = 2;
            VHYS01IW.PASSVALUE-TITLE = "VHYS02I - Home Yard Status Report - Status";
            VHYS01IW-TRIGGER.OPEN-VHYS02I = "Y";
        else
            if (VHYS01IW.HOME-YARD-BASE == 0 &&
             VHYS01IW.HOME-YARD-STATUS == 0 &&
             VHYS01IW.HOME-YARD-NOGO == 1 &&
             VHYS01IW.HOME-YARD-SUMMARY == 0)
                VHYS01IW.PASSVALUE-HOME-YRD = VHYS01IW.YARD-NOGO;
                VHYS01IW.PASSVALUE-NARR-IND = " ";
                VHYS01IW.PASSVALUE-REPORT-OPTION = 3;
                VHYS01IW.PASSVALUE-TITLE = "VHYS03I - Home Yard Status Report - NOGO";
                VHYS01IW-TRIGGER.OPEN-VHYS03I = "Y";
            else
                if (VHYS01IW.HOME-YARD-BASE == 0 &&
                 VHYS01IW.HOME-YARD-STATUS == 0 &&
                 VHYS01IW.HOME-YARD-NOGO == 0 &&
                 VHYS01IW.HOME-YARD-SUMMARY == 1)
                    VHYS01IW.PASSVALUE-HOME-YRD = VHYS01IW.YARD-SUMMARY;
                    VHYS01IW.PASSVALUE-NARR-IND = " ";
                    VHYS01IW.PASSVALUE-TITLE = "VHYS04I - Home Yard Status Report - Summary";
                    VHYS01IW.PASSVALUE-REPORT-OPTION = 4;
                    VHYS01IW-TRIGGER.OPEN-VHYS04I = "Y";
                else

                end
            end
        end
    end
end 

Function VHYS01IS-SETFOCUS () 
    if ((VHYS01IW.HOME-YARD-BASE == 1 &&
     VHYS01IW.HOME-YARD-STATUS == 0 &&
     VHYS01IW.HOME-YARD-NOGO == 0 &&
     VHYS01IW.HOME-YARD-SUMMARY == 0))
        YARDBASE-SETFOCUS = "Y";
    else
        if ((VHYS01IW.HOME-YARD-BASE == 0 &&
         VHYS01IW.HOME-YARD-STATUS == 1 &&
         VHYS01IW.HOME-YARD-NOGO == 0 &&
         VHYS01IW.HOME-YARD-SUMMARY == 0))
            if (VHYS01IW.YARD-STATUS == " ")
                YARDSTATUS-SETFOCUS = "Y";
            else
                if (VHYS01IW.VEH-STATUS == " ")
                    VEHSTAT-SETFOCUS = "Y";
                end
            end
        else
            if ((VHYS01IW.HOME-YARD-BASE == 0 &&
             VHYS01IW.HOME-YARD-STATUS == 0 &&
             VHYS01IW.HOME-YARD-NOGO == 1 &&
             VHYS01IW.HOME-YARD-SUMMARY == 0))
                YARDNOGO-SETFOCUS = "Y";
            else
                if ((VHYS01IW.HOME-YARD-BASE == 0 &&
                 VHYS01IW.HOME-YARD-STATUS == 0 &&
                 VHYS01IW.HOME-YARD-NOGO == 0 &&
                 VHYS01IW.HOME-YARD-SUMMARY == 1))
                    YARDSUMMARY-SETFOCUS = "Y";
                end
            end
        end
    end
end 




Function VHYS01IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
   
    VHYS01IS-CHK-SEL-X();
  
  
  
  
    if (VHYS01IW.CAR-NO-FROM == "0000" || strLib.characterLen(VHYS01IW.CAR-NO-FROM )<1)
        VHYS01IW.CAR-NO-FROM = "0096";
    end    
    if (VHYS01IW.CAR-NO-TO == "0000" || strLib.characterLen(VHYS01IW.CAR-NO-TO )<1 )
        VHYS01IW.CAR-NO-TO = "5000";
    end
    if (VHYS01IW.CAR-NO-TO < VHYS01IW.CAR-NO-FROM)
        ERROR = "Y";
        FINAL-ERROR-MESSAGE = "The TO CAR cannot be less than the FROM CAR";
        return;
    end
    if (VHYS01IW-TRIGGER.SELECT-ONE-X == "1")
        set VHYS01C_CRIT empty;
        VHYS01C_CRIT.CAR-NO-FROM = VHYS01IW.CAR-NO-FROM;
        VHYS01C_CRIT.CAR-NO-TO = VHYS01IW.CAR-NO-TO;
        if (HOME-YARD-BASE == 1)
            VHYS01C_CRIT.REPT-ID = "1";
            VHYS01C_CRIT.HOME-YRD = YARD-BASE;
            VHYS01C_CRIT.REPT-MISC = NARR-IND-BASE;
            VHYS01C_CRIT.INCD-STAT = " ";
        else
            if (HOME-YARD-STATUS == 1)
                VHYS01C_CRIT.REPT-ID = "2";
                VHYS01C_CRIT.HOME-YRD = YARD-STATUS;
                VHYS01C_CRIT.REPT-MISC = NARR-IND-STATUS;
                VHYS01C_CRIT.INCD-STAT = VEH-STATUS;
            else
                if (HOME-YARD-NOGO == 1)
                    VHYS01C_CRIT.REPT-ID = "3";
                    VHYS01C_CRIT.HOME-YRD = YARD-NOGO;
                    VHYS01C_CRIT.REPT-MISC = " ";
                    VHYS01C_CRIT.INCD-STAT = " ";
                else
                    if (HOME-YARD-SUMMARY == 1)
                        VHYS01C_CRIT.REPT-ID = "4";
                        VHYS01C_CRIT.HOME-YRD = YARD-SUMMARY;
                        VHYS01C_CRIT.REPT-MISC = " ";
                        VHYS01C_CRIT.INCD-STAT = " ";
                    end
                end
            end
        end
        VHYS01C_CRIT.REPT-TYPE = VHYS01IW-PASSVALUE.VTAM-NAME;

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYS01I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYS01C";

    
        try
            call "VHYS01C"(XDCONTROL, VHYS01C_CRIT, VHYS01C_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
                FINAL-ERROR-MESSAGE = "Your Report Has Been Submitted, Pick Up Report from Local Printer";
                
  
  
            else

        


        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

Function VHYS02IS-CPRV-CNXT () 
    VHYS02IW.CAR-DETAILS = " ";
    if (VHYS02IW.CAR-PRV-NXT == "PRV")
        CAR-INDEX = CAR-INDEX - 1;
        if (CAR-INDEX == 1)
            DISABLE-CARPRV = "Y";
            if (CAR-INDEX == CAR-COUNT)
                DISABLE-CARNXT = "Y";
            else
                ENABLE-CARNXT = "Y";
                CARNXT-SETFOCUS = "Y";
            end
        else
            ENABLE-CARPRV = "Y";
            ENABLE-CARNXT = "Y";
            CARPRV-SETFOCUS = "Y";
        end
    else
        if (VHYS02IW.CAR-PRV-NXT == "NXT")
            CAR-INDEX = CAR-INDEX + 1;
            ENABLE-CARPRV = "Y";
            if (CAR-INDEX == CAR-COUNT)
                DISABLE-CARNXT = "Y";
                CARPRV-SETFOCUS = "Y";
            else
                ENABLE-CARNXT = "Y";
                CARNXT-SETFOCUS = "Y";
            end
        else
            if (VHYS02IW.CAR-PRV-NXT == " ")
                VHYS02IW.CAR-INDEX = 1; 
                if (CAR-INDEX == CAR-COUNT)
                    DISABLE-CARPRV = "Y";
                    DISABLE-CARNXT = "Y";
                else
                    DISABLE-CARPRV = "Y";
                    ENABLE-CARNXT = "Y";
                    CARNXT-SETFOCUS = "Y";
                end
            end
        end
    end
    VHYS02IW.CAR-NO = VHYS02A_CAR_DATA.CAR-NO[CAR-INDEX];
    VHYS02IW.DISP-VEH-STAT = VHYS02A_CAR_DATA.DISP-VEH-STAT[CAR-INDEX];
    VHYS02IW.CURR-LOC = VHYS02A_CAR_DATA.CURR-LOC[CAR-INDEX];
    VHYS02IW.ATO-PRESENT-IND = VHYS02A_CAR_DATA.ATO-PRESENT-IND[CAR-INDEX];
    VHYS02IW.CUM-HRS = VHYS02A_CAR_DATA.CUM-HRS[CAR-INDEX];
    VHYS02IW.CUM-MIN = VHYS02A_CAR_DATA.CUM-MIN[CAR-INDEX];
    VHYS02IW.MTBI = VHYS02A_CAR_DATA.MTBI[CAR-INDEX];
    VHYS02IW.HOME-YRD = VHYS02A_CAR_DATA.HOME-YRD[CAR-INDEX];

  
    LOAD-INCD = "Y";
end 

Function VHYS02IS-INCD-DET () 
    VHYS02IW.LOOP-INDEX = 1;
    VHYS02IW.NARR = " ";
    VHYS02A_INCD_DATA.CAR-INCD-COUNT = 0;

  
    VHYS02A_CRIT.RET-IND = "INCDS";
    VHYS02A_CRIT.CAR-NO = VHYS02A_CAR_DATA.CAR-NO[CAR-INDEX];
    try
        call "VHYS02A"(XDCONTROL, VHYS02A_CRIT, VHYS02A_CAR_DATA, VHYS02A_INCD_DATA);
    
    end
    if (XDCONTROL.UROWCNT > 0)
        VHYS02IW-TRIGGER.SET-INDEX-1 = "Y";
    else
        if (XDCONTROL.UROWCNT == 0 && XDCONTROL.URC == 100)
            VHYS02A_INCD_DATA.CAR-INCD-COUNT = 0;
            VHYS02IW.NARR = "NO INCIDENTS FOUND FOR THIS CAR";
            DISABLE-NARRPRV = "Y";
            DISABLE-NARRNXT = "Y";
        else

        end
    end
    LOAD-INCD-DATA = "Y";
    if (VHYS02IW.SELECTION-IDX == 1)
        VHYS02IS-SELECT();
    end
end 

Function VHYS02IS-NPRV-NNXT () 
    if (VHYS02IW.NARR-PRV-NXT == "PRV")
        NARR-INDEX = NARR-INDEX - 1;
        if (NARR-INDEX == 1)
            DISABLE-NARRPRV = "Y";
            if (NARR-INDEX == NARR-COUNT)
                DISABLE-NARRNXT = "Y";
            else
                ENABLE-NARRNXT = "Y";
                NARRNXT-SETFOCUS = "Y";
            end
        else
            ENABLE-NARRPRV = "Y";
            ENABLE-NARRNXT = "Y";
            NARRPRV-SETFOCUS = "Y";
        end
    else
        if (VHYS02IW.NARR-PRV-NXT == "NXT")
            NARR-INDEX = NARR-INDEX + 1;
            ENABLE-NARRPRV = "Y";
            if (NARR-INDEX == NARR-COUNT)
                DISABLE-NARRNXT = "Y";
                NARRPRV-SETFOCUS = "Y";
            else
                ENABLE-NARRNXT = "Y";
                NARRNXT-SETFOCUS = "Y";
            end
        else
            if (VHYS02IW.NARR-PRV-NXT == " ")
                VHYS02IW.NARR-INDEX = 1; 
                if (NARR-INDEX == NARR-COUNT)
                    DISABLE-NARRPRV = "Y";
                    DISABLE-NARRNXT = "Y";
                else
                    DISABLE-NARRPRV = "Y";
                    ENABLE-NARRNXT = "Y";
                    NARRNXT-SETFOCUS = "Y";
                end
            end
        end
    end
    VHYS02IW.NARR = VHYS02B_NARR_DATA.NARR[NARR-INDEX];
end 

Function VHYS02IS-RET-DATA ()
  
  
   
    VHYS02IW.FINAL-ERROR-MESSAGE = " ";
    VHYS02IW.CAR-INDEX = 0;
    VHYS02IW.CAR-PRV-NXT = " ";
    VHYS02IW.NARR-PRV-NXT = " ";

  
    if (VHYS02A_CRIT.CAR-NO-FROM == "   ")
        VHYS02A_CRIT.CAR-NO-FROM = "0096";
    end
    if (VHYS02A_CRIT.CAR-NO-TO=="0000" || strLib.characterLen(VHYS02A_CRIT.CAR-NO-TO)<1)
        VHYS02A_CRIT.CAR-NO-TO = "5000";
    end
    VHYS02A_CRIT.HOME-YRD = VHYS02IW-PASSVALUE.HOME-YRD;
    VHYS02A_CRIT.VEH-STAT = VHYS02IW-PASSVALUE.VEH-STAT;
    VHYS02A_CRIT.CAR-NO-FROM = VHYS02IW-PASSVALUE.CAR-NO-FROM;
    VHYS02A_CRIT.CAR-NO-TO = VHYS02IW-PASSVALUE.CAR-NO-TO;
    VHYS02A_CRIT.REPORT-OPTION = VHYS02IW-PASSVALUE.REPORT-OPTION;
    VHYS02A_CRIT.RET-IND = "CAR";
    try
        call "VHYS02A"(XDCONTROL, VHYS02A_CRIT, VHYS02A_CAR_DATA, VHYS02A_INCD_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        LOAD-CAR = "Y";
        
  
    else
        CAR-INCD-COUNT = 0;
        VHYS02IW.CAR-DETAILS = " ";
        VHYS02IW.NARR = " ";
        DISABLE-CARPRV = "Y";
        DISABLE-CARNXT = "Y";
        DISABLE-NARRPRV = "Y";
        DISABLE-NARRNXT = "Y";
        LOAD-INCD-DATA = "Y";
        if (XDCONTROL.URC == 100)
            VHYS02IW.FINAL-ERROR-MESSAGE = "No Data Found for Search Criteria";
            
  
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHYS02IS-SELECT () 
    if (VHYS02A_INCD_DATA.CAR-INCD-COUNT > 0)
        if (VHYS02IW-PASSVALUE.NARR-IND == "Y")
            if (SELECTION-IDX == 0)
                SELECTION-IDX = 1;
            end
            if (SELECTION-IDX > 0)
                NARR-INDEX = 0;
                VHYS02IW.NARR-PRV-NXT = " ";
                VHYS02B_CRIT.CAR-NO = VHYS02IW.CAR-NO;
                VHYS02B_CRIT.INCD-NO = VHYS02A_INCD_DATA.INCD-NO[SELECTION-IDX];
                VHYS02B_CRIT.HOME-YRD = VHYS02IW.HOME-YRD;
                try
                    call "VHYS02B"(XDCONTROL, VHYS02B_CRIT, VHYS02B_NARR_DATA);
                
                end
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    if (NARR-COUNT > 0)
                        LOAD-NARR = "Y";
                    end
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end
        else
            DISABLE-NARRPRV = "Y";
            DISABLE-NARRNXT = "Y";
        end
    end
end 

Function VHYS03IS-600-ROWS () 
    VHYS03IW.FINAL-ERROR-MESSAGE = "The Frist 600 Rows Have Been Displayed";
end 

Function VHYS03IS-CPRV-CNXT () 
    if (VHYS03IW.PAGE-PRV-NXT == "PRV")
        CAR-INDEX = CAR-INDEX - 1;
        if (CAR-INDEX == 10)
            DISABLE-PAGEPRV = "Y";
            if (CAR-INDEX <= VHYS03IW.CAR-CNT)
                DISABLE-PAGENXT = "Y";
            else
                ENABLE-PAGENXT = "Y";
                PAGENXT-SETFOCUS = "Y";
            end
        else
            ENABLE-PAGEPRV = "Y";
            ENABLE-PAGENXT = "Y";
            PAGEPRV-SETFOCUS = "Y";
        end
    else
        if (VHYS03IW.PAGE-PRV-NXT == "NXT")
            CAR-INDEX = CAR-INDEX + 1;
            ENABLE-PAGEPRV = "Y";
            if (CAR-INDEX >= VHYS03IW.CAR-CNT)
                DISABLE-PAGENXT = "Y";
                PAGEPRV-SETFOCUS = "Y";
            else
                ENABLE-PAGENXT = "Y";
                PAGENXT-SETFOCUS = "Y";
            end
        else
            if (VHYS03IW.PAGE-PRV-NXT == " ")
                CAR-INDEX = 1;
                if (CAR-INDEX == VHYS03IW.CAR-CNT)
                    DISABLE-PAGEPRV = "Y";
                    DISABLE-PAGENXT = "Y";
                else
                    DISABLE-PAGEPRV = "Y";
                    ENABLE-PAGENXT = "Y";
                    PAGENXT-SETFOCUS = "Y";
                end
            end
        end
    end
    LOAD-CAR = "Y";
end 

Function VHYS03IS-NPRV-NNXT () 
    if (VHYS03IW.NARR-PRV-NXT == "PRV")
        NARR-INDEX = NARR-INDEX - 1;
        if (NARR-INDEX == 1)
            DISABLE-NARRPRV = "Y";
            if (NARR-INDEX == NARR-COUNT)
                DISABLE-NARRNXT = "Y";
            else
                ENABLE-NARRNXT = "Y";
                NARRNXT-SETFOCUS = "Y";
            end
        else
            ENABLE-NARRPRV = "Y";
            ENABLE-NARRNXT = "Y";
            NARRPRV-SETFOCUS = "Y";
        end
    else
        if (VHYS03IW.NARR-PRV-NXT == "NXT")
            NARR-INDEX = NARR-INDEX + 1;
            ENABLE-NARRPRV = "Y";
            if (NARR-INDEX == NARR-COUNT)
                DISABLE-NARRNXT = "Y";
                NARRPRV-SETFOCUS = "Y";
            else
                ENABLE-NARRNXT = "Y";
                NARRNXT-SETFOCUS = "Y";
            end
        else
            if (VHYS03IW.NARR-PRV-NXT == " ")
                VHYS03IW.NARR-INDEX = 1; 
                if (NARR-INDEX == NARR-COUNT)
                    DISABLE-NARRPRV = "Y";
                    DISABLE-NARRNXT = "Y";
                else
                    DISABLE-NARRPRV = "Y";
                    ENABLE-NARRNXT = "Y";
                    NARRNXT-SETFOCUS = "Y";
                end
            end
        end
    end
    VHYS03IW.NARR = VHYS02B_NARR_DATA.NARR[NARR-INDEX];
end 

Function VHYS03IS-RET-DATA ()
  
   
    VHYS03IW.FINAL-ERROR-MESSAGE = " ";
    VHYS03B_CRIT.ROW-CNT = 0;
    VHYS03IW.CAR-CNT = 0;
    VHYS03IW.INCD-CNT = 0;
    VHYS03IW.PAGE-PRV-NXT = " ";
    VHYS03IW.CAR-INDEX = 0;
    VHYS03IW.CNT = 1;
    VHYS03IW.NARR = " ";

  
    if (VHYS03A_CRIT.CAR-NO-FROM == "   ")
        VHYS03A_CRIT.CAR-NO-FROM = "0096";
    end
    if (VHYS03A_CRIT.CAR-NO-TO=="0000" || strLib.characterLen(VHYS03A_CRIT.CAR-NO-TO)<1)
        VHYS03A_CRIT.CAR-NO-TO = "5000";
    end
    VHYS03A_CRIT.HOME-YRD = VHYS03IW-PASSVALUE.HOME-YRD;
    VHYS03A_CRIT.REPORT-OPTION = VHYS03IW-PASSVALUE.REPORT-OPTION;
    move " " to VHYS03B_DATA.DATA_ROW[1] for all;
    try
        call "VHYS03A"(XDCONTROL, VHYS03A_CRIT, VHYS03A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYS03IW.CAR-CNT = XDCONTROL.UROWCNT;
        while (CNT <= VHYS03IW.CAR-CNT)
            VHYS03B_CRIT.INCD-IND = VHYS03A_DATA.INCD-IND[CNT];
            VHYS03B_CRIT.VEH-STAT = VHYS03A_DATA.VEH-STAT[CNT];
            VHYS03B_CRIT.VEH-STAT-FILLER = VHYS03A_DATA.VEH-STAT-FILLER[CNT];
            VHYS03B_CRIT.CURR-LOC = VHYS03A_DATA.CURR-LOC[CNT];
            VHYS03B_CRIT.CAR-NO = VHYS03A_DATA.CAR-NO[CNT];
            try
                call "VHYS03B"(XDCONTROL, VHYS03B_CRIT, VHYS03B_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHYS03IW.INCD-CNT = VHYS03B_CRIT.ROW-CNT;
                if (VHYS03IW.INCD-CNT == 600)
                    DISPLAY-FOOTER = "Y";
                else
                    HIDE-FOOTER = "Y";
                end
            end
            VHYS03IW.CNT = VHYS03IW.CNT + 1;
        end
        if (VHYS03IW.INCD-CNT > 0)
            LOAD-CAR = "Y";
            SELECT-NARR = "Y";
        else
            HIDE-FOOTER = "Y";
            DISABLE-PAGEPRV = "Y";
            DISABLE-PAGENXT = "Y";
            DISABLE-NARRPRV = "Y";
            DISABLE-NARRNXT = "Y";
            LOAD-CAR = "Y";
        end
    end
end 

Function VHYS03IS-SELECT () 
    if (VHYS03IW.CAR-CNT > 0)
        if (SELECTION-IDX == 0)
            SELECTION-IDX = 1;
        end
        if (SELECTION-IDX > 0)
            NARR-INDEX = 0;
            VHYS03IW.NARR-PRV-NXT = " ";
            VHYS02B_CRIT.CAR-NO = VHYS03B_DATA.STORE-CAR-NO[SELECTION-IDX];
            VHYS02B_CRIT.INCD-NO = VHYS03B_DATA.INCD-NO[SELECTION-IDX];
            VHYS02B_CRIT.HOME-YRD = VHYS03IW-PASSVALUE.HOME-YRD;
            try
                call "VHYS02B"(XDCONTROL, VHYS02B_CRIT, VHYS02B_NARR_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                if (NARR-COUNT > 0)
                    LOAD-NARR = "Y";
                else
                    VHYS03IW.NARR = " ";
                end
            else

            end
        end
    else
        VHYS03IW.FINAL-ERROR-MESSAGE = "No Cars Were Found ";
        
  
    end
end 

Function VHYS04IS-RET-DATA ()
  
   
    VHYS04IW.CAR-COUNT = 0;
    VHYS04A_CRIT.HOME-YRD = VHYS04IW-PASSVALUE.HOME-YRD;
    if (VHYS04IW-PASSVALUE.HOME-YRD == "HY")
        VHYS04IW.HEADER = "HAYWARD HOME YARD";
    else
        if (VHYS04IW-PASSVALUE.HOME-YRD == "CY")
            VHYS04IW.HEADER = "CONCORD HOME YARD";
        else
            if (VHYS04IW-PASSVALUE.HOME-YRD == "DY")
                VHYS04IW.HEADER = "DAILY CITY HOME YARD";
            else
                if (VHYS04IW-PASSVALUE.HOME-YRD == "RY")
                    VHYS04IW.HEADER = "RICHMOND HOME YARD";
                end
            end
        end
    end
    try
        call "VHYS04A"(XDCONTROL, VHYS04A_CRIT, VHYS04A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYS04IW.CAR-COUNT = XDCONTROL.UROWCNT;
        ENABLE-SUMMARY = "Y";
        if (VHYS04IW.CAR-COUNT == 500)
            DISPLAY-FOOTER = "Y";
        else
            HIDE-FOOTER = "Y";
        end
        LOAD-CAR = "Y";
    else
        HIDE-FOOTER = "Y";
        LOAD-CAR = "Y";
        DISABLE-SUMMARY = "Y";
        NO-CARS-FOUND = "Y";
    end
end 

Function VHYS05IS-INIT ()
  

   
    VHYS05A_CRIT.HOME-YRD = VHYS05IW-PASSVALUE.HOME-YRD;
    if (VHYS05IW-PASSVALUE.HOME-YRD == "HY")
        VHYS05IW.HEADER = "HAYWARD HOME YARD";
    else
        if (VHYS05IW-PASSVALUE.HOME-YRD == "CY")
            VHYS05IW.HEADER = "CONCORD HOME YARD";
        else
            if (VHYS05IW-PASSVALUE.HOME-YRD == "DY")
                VHYS05IW.HEADER = "DAILY CITY HOME YARD";
            else
                if (VHYS05IW-PASSVALUE.HOME-YRD == "RY")
                    VHYS05IW.HEADER = "RICHMOND HOME YARD";
                end
            end
        end
    end
    VHYS05IW.ROW-COUNT = 17;
    CAR-TYPE-DATA[1] = "Total  Home Yard Cars";
    CAR-TYPE-DATA[2] = "        Cars in  Hold";
    CAR-TYPE-DATA[3] = "Adjusted Home Yrd Flt";
    CAR-TYPE-DATA[4] = " ";
    CAR-TYPE-DATA[5] = "Cars in Unsched Maint";
    CAR-TYPE-DATA[6] = "Cars in UM (No Parts)";
    CAR-TYPE-DATA[7] = "Cars in Prevent Maint";
  
    CAR-TYPE-DATA[8] = "Cars in  Warranty Rep";
    CAR-TYPE-DATA[9] = "Cars in Engnerng Hold";
    CAR-TYPE-DATA[10] = "Cars in Modification";
    CAR-TYPE-DATA[11] = "Cars in Miscell Hold";
    CAR-TYPE-DATA[12] = " ";
    CAR-TYPE-DATA[13] = "Total  Cars in Maint";
    CAR-TYPE-DATA[14] = " ";
    CAR-TYPE-DATA[15] = "Total Avail For Servc";
    CAR-TYPE-DATA[16] = "Cars in Revenue Servc";
    CAR-TYPE-DATA[17] = "Avail GO Cars in Yrds";
    try
        call "VHYS05A"(XDCONTROL, VHYS05A_CRIT, VHYS05A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYS05IW.TOTAL-CAR-COUNT = XDCONTROL.UROWCNT;
        VHYS05IS-TYPE-CHK(); 
    else
        if (XDCONTROL.URC == 100)

        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHYS05IS-TYPE-A () 
    TOTAL-FLEET-A = TOTAL-FLEET-A + 1;
    TOTAL-FLEET-T = TOTAL-FLEET-T + 1;
    if (VHYS05A_DATA.VEH-STAT[LOOP-INDEX] == "STOR" ||
     VHYS05A_DATA.VEH-STAT[LOOP-INDEX] == "SAFETY" ||
     VHYS05A_DATA.VEH-STAT[LOOP-INDEX] == "ACIDNT" ||
     VHYS05A_DATA.VEH-STAT[LOOP-INDEX] == "TEST")
        HOLD-CARS-A = HOLD-CARS-A + 1;
        HOLD-CARS-T = HOLD-CARS-T + 1;
    else
        if (VHYS05A_DATA.WHERE-IS-CAR[LOOP-INDEX] == "CON")
            REV-SERVICE-A = REV-SERVICE-A + 1;
            REV-SERVICE-T = REV-SERVICE-T + 1;
        else
            TOTAL-MAINT-A = TOTAL-MAINT-A + 1;
            TOTAL-MAINT-T = TOTAL-MAINT-T + 1;
            if (VHYS05A_DATA.WAR-IND[LOOP-INDEX] == "Y" &&
             VHYS05A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                WARRANTY-A = WARRANTY-A + 1;
                WARRANTY-T = WARRANTY-T + 1;
            else
                if (VHYS05A_DATA.WAR-IND[LOOP-INDEX] == "N" &&
                 VHYS05A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                    UNSCHD-MAIN-A = UNSCHD-MAIN-A + 1;
                    UNSCHD-MAIN-T = UNSCHD-MAIN-T + 1;
                else
                    if (VHYS05A_DATA.VEH-STAT[LOOP-INDEX] == "AWPART")
                        WAITPART-UM-A = WAITPART-UM-A + 1;
                        WAITPART-UM-T = WAITPART-UM-T + 1;
                    else
                        if (VHYS05A_DATA.VEH-STAT[LOOP-INDEX] == "PM")
                            PREVEN-MAIN-A = PREVEN-MAIN-A + 1;
                            PREVEN-MAIN-T = PREVEN-MAIN-T + 1;
                        else
                            if (VHYS05A_DATA.VEH-STAT[LOOP-INDEX] == "ENGHLD")
                                ENGRNG-HOLD-A = ENGRNG-HOLD-A + 1;
                                ENGRNG-HOLD-T = ENGRNG-HOLD-T + 1;
                            else
                                if (VHYS05A_DATA.VEH-STAT[LOOP-INDEX] == "MODHLD")
                                    MODIFY-CARS-A = MODIFY-CARS-A + 1;
                                    MODIFY-CARS-T = MODIFY-CARS-T + 1;
                                else
                                    if (VHYS05A_DATA.VEH-STAT[LOOP-INDEX] == "MISC")
                                        MISCEL-HOLD-A = MISCEL-HOLD-A + 1;
                                        MISCEL-HOLD-T = MISCEL-HOLD-T + 1;
                                    else
                                        TOTAL-MAINT-A = TOTAL-MAINT-A - 1;
                                        TOTAL-MAINT-T = TOTAL-MAINT-T - 1;
                                        if (VHYS05A_DATA.VEH-STAT[LOOP-INDEX] != "GO" &&
                                         VHYS05A_DATA.VEH-STAT[LOOP-INDEX] != "USABLE" &&
                                         VHYS05A_DATA.VEH-STAT[LOOP-INDEX] != "ERROR")
                                            TOTAL-FLEET-A = TOTAL-FLEET-A - 1;
                                            TOTAL-FLEET-T = TOTAL-FLEET-T - 1;
                                        else
                                            GO-AVAIL-A = GO-AVAIL-A + 1;
                                            GO-AVAIL-T = GO-AVAIL-T + 1;
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

