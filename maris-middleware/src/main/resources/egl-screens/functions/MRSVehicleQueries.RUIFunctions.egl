        if (VHST03IW-4.CONSIST in VHST02IW-CNTS.VAGen_HOLD)
            VHST02IW-CNTS.CON-INDEX = sysVar.arrayIndex;
        end
        VHST02IW-CNTS.CON-INDEX = VHST02IW-CNTS.CON-INDEX + 1;
         
    end
    if (VHST02IW-CNTS.BUTTON == "UP")
  
        if (VHST03IW-1.CONSIST in VHST02IW-CNTS.VAGen_HOLD)
            VHST02IW-CNTS.CON-INDEX = sysVar.arrayIndex;
        end
        VHST02IW-CNTS.CON-INDEX = VHST02IW-CNTS.CON-INDEX - 4;
    end
    IND = 1;
  
    while (VHST02IW-CNTS.VAGen_HOLD[CON-INDEX] != VHST3A1_DATA.CONSIST[IND])
  
        IND = IND + 1;
    end
end 

Function VHST04IS-CL-WASH ()

  
  

  
  
  

  
   
    MRSCommonCode.XDATECON-LOAD-TBL();
    VHST04IW-CL-WASH.JUL-REV-DATE = VHST01IW.REV-DATE-JULIAN;
    IND = 1;
    while (IND <= TOT-CAR-COUNT)

  
        if (VHST04B_DATA.DATE-NXT-CAR-WASH[IND] < "01-01-1999")
            VHST04B_DATA.DATE-NXT-CAR-WASH[IND] = "01-01-1999";
        end

  
        XDATECON-W2.WS-GREG-IN-FLAG = "R";
        XDATECON-W2.WS-RPT-GREG-IN = VHST04B_DATA.DATE-NXT-CAR-WASH[IND];
        MRSCommonCode.XDATECON-GREG2JUL();
        VHST04IW-CL-WASH.JUL-DATE = XDATECON-W1.WS-DATES-CYDDD;
        if (VHST04IW-CL-WASH.JUL-DATE < VHST04IW-CL-WASH.JUL-REV-DATE)
            VHST04B_DATA.WASH-DAYS[IND] = VHST04IW-CL-WASH.JUL-REV-DATE - VHST04IW-CL-WASH.JUL-DATE;
        end
  
        if (VHST04B_DATA.WASH-DAYS[IND] > 366)
            XJULIAN-FIX.LOW-DATES-CYDDD = VHST04IW-CL-WASH.JUL-DATE;
            XJULIAN-FIX.HIGH-DATES-CYDDD = VHST04IW-CL-WASH.JUL-REV-DATE;
            MRSCommonCode.XJULIAN-FIX-S();
            VHST04B_DATA.WASH-DAYS[IND] = XJULIAN-FIX.TOTAL-DAYS;
        end


  
        if (VHST04B_DATA.DATE-CAR-CLEAN-BWK[IND] != "          ")
            XDATECON-W2.WS-GREG-IN-FLAG = "R";
  
            XDATECON-W2.WS-RPT-GREG-IN = VHST04B_DATA.DATE-CAR-CLEAN-BWK[IND];
            MRSCommonCode.XDATECON-GREG2JUL();
            VHST04IW-CL-WASH.CLEAN-BWK = XDATECON-W1.WS-DATES-CYDDD;
            VHST04IW-CL-WASH.ELAP-DAYS = VHST04IW-CL-WASH.JUL-REV-DATE - VHST04IW-CL-WASH.CLEAN-BWK; 
  
            if (VHST04IW-CL-WASH.ELAP-DAYS > 366)
                XJULIAN-FIX.LOW-DATES-CYDDD = VHST04IW-CL-WASH.CLEAN-BWK;
                XJULIAN-FIX.HIGH-DATES-CYDDD = VHST04IW-CL-WASH.JUL-REV-DATE;
                MRSCommonCode.XJULIAN-FIX-S();
                VHST04IW-CL-WASH.ELAP-DAYS = XJULIAN-FIX.TOTAL-DAYS;
            end
            if (VHST04IW-CL-WASH.ELAP-DAYS > VHST4A2_DATA.CNT-DAYS-BIWK-OD)
                VHST04B_DATA.CLEAN-B[IND] = "B";
            end
        else
            VHST04B_DATA.CLEAN-B[IND] = "B";
        end


  
        if (VHST04B_DATA.DATE-CAR-CLEAN-SHM[IND] != "          ")
            XDATECON-W2.WS-GREG-IN-FLAG = "R";
            XDATECON-W2.WS-RPT-GREG-IN = VHST04B_DATA.DATE-CAR-CLEAN-SHM[IND];
            MRSCommonCode.XDATECON-GREG2JUL();
            VHST04IW-CL-WASH.CLEAN-SHM = XDATECON-W1.WS-DATES-CYDDD;
            VHST04IW-CL-WASH.ELAP-DAYS = VHST04IW-CL-WASH.JUL-REV-DATE - VHST04IW-CL-WASH.CLEAN-SHM; 

  
            if (VHST04IW-CL-WASH.ELAP-DAYS > 366)
                XJULIAN-FIX.LOW-DATES-CYDDD = VHST04IW-CL-WASH.CLEAN-SHM;
                XJULIAN-FIX.HIGH-DATES-CYDDD = VHST04IW-CL-WASH.JUL-REV-DATE;
                MRSCommonCode.XJULIAN-FIX-S();
                VHST04IW-CL-WASH.ELAP-DAYS = XJULIAN-FIX.TOTAL-DAYS;
            end
  
            if (VHST04IW-CL-WASH.ELAP-DAYS > VHST4A2_DATA.CNT-DAYS-SHAMPO-OD)
                VHST04B_DATA.CLEAN-S[IND] = "S";
            end
        else
            VHST04B_DATA.CLEAN-S[IND] = "S";
        end

  
        if (VHST04B_DATA.DATE-CAR-CLEAN-THR[IND] != "          ")
            XDATECON-W2.WS-GREG-IN-FLAG = "R";
            XDATECON-W2.WS-RPT-GREG-IN = VHST04B_DATA.DATE-CAR-CLEAN-THR[IND];
            MRSCommonCode.XDATECON-GREG2JUL();
            VHST04IW-CL-WASH.CLEAN-THR = XDATECON-W1.WS-DATES-CYDDD;
            VHST04IW-CL-WASH.ELAP-DAYS = VHST04IW-CL-WASH.JUL-REV-DATE - VHST04IW-CL-WASH.CLEAN-THR; 

  
            if (VHST04IW-CL-WASH.ELAP-DAYS > 366)
                XJULIAN-FIX.LOW-DATES-CYDDD = VHST04IW-CL-WASH.CLEAN-THR;
                XJULIAN-FIX.HIGH-DATES-CYDDD = VHST04IW-CL-WASH.JUL-REV-DATE;
                MRSCommonCode.XJULIAN-FIX-S();
                VHST04IW-CL-WASH.ELAP-DAYS = XJULIAN-FIX.TOTAL-DAYS;
            end
  
            if (VHST04IW-CL-WASH.ELAP-DAYS > VHST4A2_DATA.CNT-DAYS-THORO-OD)
                VHST04B_DATA.CLEAN-T[IND] = "T";
            end
        else
            VHST04B_DATA.CLEAN-T[IND] = "T";
        end
  
        IND = IND + 1;
    end
end 

Function VHST04IS-GET-DATA ()
  
  
  
  
  
  
  
  
   
    VHST02IW-CNTS.CNT = 0;
    VHST02IW-CNTS.ROWS-RETURNED = 0;
    VHST02IW-CNTS.PAGE = 0;
    VHST02IW-CNTS.TOTAL-PAGES = 0;

  
  
    set VHST04IW-1 empty;
    set VHST04IW-2 empty;

  
    try
        call "VHST04A"(XDCONTROL, VHST04A_CRIT, VHST04A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        REC-COUNT = 1;
        TOT-CAR-COUNT = XDCONTROL.UROWCNT;
        move " " to VHST04B_DATA.DATA_ROW[1] for all;
        VHST04B_CRIT.TOT-CLN-COUNT = 0;
        VHST02IW-CNTS.FIRST-TIME = "N";
        VHST02IW-CNTS.ROWS-RETURNED = TOT-CAR-COUNT;
        while (REC-COUNT <= TOT-CAR-COUNT)
            VHST04B_CRIT.CAR-NO = VHST04A_DATA.CAR-NO[REC-COUNT];
            VHST04B_CRIT.VAGen_COUNT = REC-COUNT;
            try
                call "VHST04B"(XDCONTROL, VHST04B_CRIT, VHST04B_DATA);
            
            end
      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

            else
        
        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
            REC-COUNT = REC-COUNT + 1;
        end
    else
    
    
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end

  
    if (VHST02IW-CNTS.ROWS-RETURNED > 0)
        VHST02IW-TRIGGERS.RUN-CALCS = "Y";
    end
end 

Function VHST04IS-LOAD-DATA ()
   
    if (VHST02IW-CNTS.FIRST-TIME != "Y")
     
        VHST02IW-CNTS.IND = 1;
        VHST02IW-CNTS.CNT = 1;
        VHST02IW-CNTS.VAGen_HOLD[CNT] = VHST04A_DATA.CONSIST[IND];
        while (IND <= VHST04B_CRIT.TOT-CLN-COUNT)
            if (VHST02IW-CNTS.VAGen_HOLD[CNT] != VHST04A_DATA.CONSIST[IND])
                VHST02IW-CNTS.CNT = VHST02IW-CNTS.CNT + 1;
                VHST02IW-CNTS.VAGen_HOLD[CNT] = VHST04A_DATA.CONSIST[IND];
            end
            IND = IND + 1;
        end
     
        VHST02IW-CNTS.CNT = VHST02IW-CNTS.CNT - 1;

     
     
        if (VHST02IW-CNTS.CNT == 0)
            VHST02IW-CNTS.TOTAL-PAGES = 1;
             
        else
            VHST02IW-CNTS.TOTAL-PAGES = VHST02IW-CNTS.CNT / 2;
            if (VHST02IW-CNTS.TOTAL-REM != 0)
                VHST02IW-CNTS.TOTAL-PAGES = VHST02IW-CNTS.TOTAL-PAGES + 1;
                VHST02IW-CNTS.TOTAL-REM = 0;
            end
        end
        VHST02IW-CNTS.FIRST-TIME = "Y";
        VHST02IW-CNTS.PAGE = 1;
        VHST02IW-CNTS.IND = 1;
        set VHST04IW-1 empty;
        set VHST04IW-2 empty;
    else
        if (VHST02IW-CNTS.ROWS-RETURNED > 0) 
            VHST04IS-POSITION(); 
        end
        set VHST04IW-1 empty;
        set VHST04IW-2 empty;
    end 

  
    if (VHST02IW-CNTS.TOTAL-PAGES == 1)
        VHST02IW-TRIGGERS.DISABLE-UP = "Y";
        VHST02IW-TRIGGERS.DISABLE-DOWN = "Y";
    else
     
        if (VHST02IW-CNTS.PAGE == 1)
            VHST02IW-TRIGGERS.DISABLE-UP = "Y";
        else
            VHST02IW-TRIGGERS.ENABLE-UP = "Y";
        end
    end

  
  
    VHST04IW-0.CON-COUNT = 1;
    if (IND <= TOT-CLN-COUNT && CON-COUNT <= VHST02IW-CNTS.CNT)
        VHST04IW-1.CONSIST = VHST04A_DATA.CONSIST[IND];
        VHST04IW-1.ORIGIN = VHST04A_DATA.ORIGIN-LOC[IND];
        if (VHST04IW-1.ORIGIN == "HY")
            VHST04IW-1.ORIGIN = "Hayward";
        else
            if (VHST04IW-1.ORIGIN == "DY")
                VHST04IW-1.ORIGIN = "Daly City";
            else
                if (VHST04IW-1.ORIGIN == "RY")
                    VHST04IW-1.ORIGIN = "Richmond";
                else
                    if (VHST04IW-1.ORIGIN == "CY")
                        VHST04IW-1.ORIGIN = "Concord";
                    end
                end
            end
        end
        VHST04IW-1.DATE-INSRV = VHST04A_DATA.DATE-INSRV-REV[IND];
        XXDATEW.DATE-YYYY-MM-DD = VHST04IW-1.DATE-INSRV;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHST04IW-1.DATE-INSRV = XXDATEW.DATE-MM-DD-YYYY;
        VHST04IW-1.TIME-INSRV = VHST04A_DATA.TIME-INSRV[IND];
        CON-COUNT = CON-COUNT + 1;

    
        if (VHST04IW-1.CONSIST == VHST04A_DATA.CONSIST[IND] && VHST04A_DATA.CAR-NO[IND] != " ")
            VHST04IW-1.CAR1 = VHST04A_DATA.CAR-NO[IND];
            VHST04IW-1.HY1 = VHST04B_DATA.HOME-YRD[IND];

       
            if (VHST04B_DATA.CURR-SCHD-PM-NO[IND] == "  ")
                VHST04IW-1.PM1 = VHST04B_DATA.HRS-FROM-LAST-PM[IND];
            else
                VHST04IW-1.PM1 = "PMS";
            end

       
            VHST04IW-1.WASH1 = VHST04B_DATA.WASH-DAYS[IND];
            VHST04IW-1.CLEAN1 = VHST04B_DATA.CLEAN[IND];
            IND = IND + 1;
             
        end
        if (VHST04IW-1.CONSIST == VHST04A_DATA.CONSIST[IND] && VHST04A_DATA.CAR-NO[IND] != " ")
            VHST04IW-1.CAR2 = VHST04A_DATA.CAR-NO[IND];
