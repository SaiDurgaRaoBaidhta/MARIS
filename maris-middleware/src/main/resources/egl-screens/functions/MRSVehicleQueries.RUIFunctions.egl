                                                VHCL02B_DATA.HOME-YRD-9[X] = VHCL02C_DATA.HOME-YRD[Y9];
                                                VHCL02B_DATA.CAR-WN-1[X] = VHCL02C_DATA.CAR-WN-IND[Y1];
                                                VHCL02B_DATA.CAR-WN-2[X] = VHCL02C_DATA.CAR-WN-IND[Y2];
