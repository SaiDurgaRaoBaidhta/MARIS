Function VHCL01IS-REV-TIME () 

end 




Function VHCL01IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
   
    VHCL01IS-VALIDX();
    VHCL011_CRIT.CON-NO-FROM = VHCL01IW.CON-FROM;
    VHCL011_CRIT.CON-NO-TO = VHCL01IW.CON-TO;
    VHCL011_CRIT.REPT-TYPE = VHCL01IW.VTAM-NAME;
    VHCL011_CRIT.REPT-ID = VHCL01IW.VTAM-NAME;
    XXDATEW.DATE-MM-DD-YYYY = VHCL01IW.REV-DATE;
    XXDATEW.VAGen_FUNCTION = "YMD";
    MRSCommonCode.XXDATES-CONVERT();
    VHCL011_CRIT.DATE-INSRV-REV = XXDATEW.DATE-YYYY-MM-DD;


    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCL01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCL011";

    
    try
        call "VHCL011"(XDCONTROL, VHCL011_CRIT, VHCL011_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
            VHCL01IW-TRIGGERS.SUBMIT = "Y";
        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHCL01IS-VALID () 
    set VHCL01IW-MSG empty;
    VHCL01IW.VALID = "Y";
    if (VHCL01IW.CON-FROM != "ALL")
  
        if (VHCL01IW.CON-FROM <= 0)
            VHST01IW-TRIGGERS.INVALID-FROM = "Y";
            VHCL01IW.VALID = "N";
        else
            if (VHCL01IW.CON-TO-N != 0 &&
             VHCL01IW.CON-TO-N < VHCL01IW.CON-FROM-N)
                VHST01IW-TRIGGERS.INVALID-TO = "Y";
                VHCL01IW.VALID = "N";
            end
        end
    end

  
    if (VHCL01IW.CON-TO == "    ")
        VHCL01IW.CON-TO = VHCL01IW.CON-FROM;
    end
    if (VHCL01IW.CON-FROM == "ALL")
        VHCL01IW.CON-FROM = "100";
        VHCL01IW.CON-TO = "999";
    end
    if (VHCL01IW.VALID == "Y")
        VHST01IW-TRIGGERS.RUN-DISPLAY = "Y";
  
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHCL01IW.REV-DATE;
        MRSCommonCode.XXDATES-CONVERT();
        VHCL01IW.REV-DATE-DB2 = XXDATEW.DATE-YYYY-MM-DD;
    end
end 

Function VHCL01IS-VALIDX () 
    set VHCL01IW-MSG empty;
    VHCL01IW.VALID = "Y";
    if (VHCL01IW.CON-FROM == "ALL")
        VHCL01IW.CON-FROM = "100";
        VHCL01IW.CON-TO = "999";
    else
        if (VHCL01IW.CON-FROM-N <= 0)
            VHCL01IW-MSG.MESSAGE = " THE FROM CONSIST IS INVALID";
            VHCL01IW.VALID = "N";
        else
            if (VHCL01IW.CON-TO == "  ")
                VHCL01IW.CON-TO = VHCL01IW.CON-FROM;
            else
                if (VHCL01IW.CON-TO-N < VHCL01IW.CON-FROM-N)
                    VHCL01IW-MSG.MESSAGE = " THE TO CONSIST NO CANNOT BE LESS THAN FROM CONSIST NO";
                    VHCL01IW.VALID = "N";
                end
            end
        end
    end
    VHCL01IW.WS-DATE = VHCL01IW.WS-DATEX;
    if (VHCL01IW.WS-1 == "-")
        VHCL01E_CRIT.DATE-WORK = VHCL01IW.WS-DATE;
    else
        XXDATEW.DATE-MM-DD-YYYY = VHCL01IW.WS-DATE;
        move MONTH-MM-DD-YYYY to MONTH-YYYY-MM-DD withV60Compat;
        move DAY-MM-DD-YYYY to DAY-YYYY-MM-DD withV60Compat;
        move YEAR-MM-DD-YYYY to YEAR-YYYY-MM-DD withV60Compat;
        SEP1-YYYY-MM-DD = "-";
        SEP2-YYYY-MM-DD = "-";
        VHCL01E_CRIT.DATE-WORK = XXDATEW.DATE-YYYY-MM-DD;
        VHCL01IW.WS-DATE = XXDATEW.DATE-YYYY-MM-DD;
    end
    try
        call "VHCL01E"(XDCONTROL, VHCL01E_CRIT, VHCL01E_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCL01IW.REV-DATE-DB2 = VHCL01E_DATA.DATE-WORK;
        move MONTH-YYYY-MM-DD to MONTH-MM-DD-YYYY withV60Compat;
        move DAY-YYYY-MM-DD to DAY-MM-DD-YYYY withV60Compat;
        move YEAR-YYYY-MM-DD to YEAR-MM-DD-YYYY withV60Compat;
        SEP1-MM-DD-YYYY = "/";
        SEP2-MM-DD-YYYY = "/";
        VHCL01IW.REV-DATE = XXDATEW.DATE-MM-DD-YYYY;
    else
        VHCL01IW-MSG.MESSAGE = " DATE IS INVALID";
        VHCL01IW.VALID = "N";
        
  
  
  
  
  
    end
    if (VHCL01IW.VALID == "Y")
        VHST01IW-TRIGGERS.RUN-DISPLAY = "Y";
    end
end 

Function VHCL02IS-CLEAR () 
    set VHCL02IW-CNT empty;
    set VHCL02IW-CON-1 empty;
    set VHCL02IW-CON-2 empty;
    set VHCL02IW-CON-3 empty;
    set VHCL02IW-CON-4 empty;
    DISABLE-PRINT = "Y";
    DISABLE-CLEAR = "Y";
    DISABLE-PRV-PAGE = "Y";
    DISABLE-NXT-PAGE = "Y";
    VHCL02IW-MSG.FINAL-MESSAGE = " ";
end 

