                    VHMR01I_MESSAGE.MESG1 = "From date cannot be greater than To date.";
                    VHMR01IW.INVALID-FROM-DATE = "Y";
                    AFCXVLDW.NO-ERROR = "N";
                    
  
                end
            end
        end
    end
    if (VHMR01IW-TRIGGER.OK-SUBMIT == "N")

    else
