    VAGen_INDEX = 1;
    while (VAGen_INDEX < 8)
  		
        VHDVS1I_FAIL.FLEET-A[VAGen_INDEX] = VHDVS1I_FAIL.CY-A[VAGen_INDEX] + VHDVS1I_FAIL.DY-A[VAGen_INDEX] + VHDVS1I_FAIL.HY-A[VAGen_INDEX] + VHDVS1I_FAIL.RY-A[VAGen_INDEX];
        VHDVS1I_FAIL.FLEET-B[VAGen_INDEX] = VHDVS1I_FAIL.CY-B[VAGen_INDEX] + VHDVS1I_FAIL.DY-B[VAGen_INDEX] + VHDVS1I_FAIL.HY-B[VAGen_INDEX] + VHDVS1I_FAIL.RY-B[VAGen_INDEX];
