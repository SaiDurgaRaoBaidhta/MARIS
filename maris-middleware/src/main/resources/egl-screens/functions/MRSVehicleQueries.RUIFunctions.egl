        VHDVS1I_FAIL.FLEET-TOT[VAGen_INDEX] = VHDVS1I_FAIL.FLEET-A[VAGen_INDEX] + VHDVS1I_FAIL.FLEET-B[VAGen_INDEX] + VHDVS1I_FAIL.FLEET-C[VAGen_INDEX]
        									+ VHDVS1I_FAIL.FLEET-D[VAGen_INDEX] + VHDVS1I_FAIL.FLEET-E[VAGen_INDEX] 
                                            + VHDVS1I_FAIL.FLEET-L[VAGen_INDEX] + VHDVS1I_FAIL.FLEET-K[VAGen_INDEX] + VHDVS1I_FAIL.FLEET-K[VAGen_INDEX];
        VAGen_INDEX = VAGen_INDEX + 1;
    end
end 

Function VHDVS1IS-CAL-RET ()
  
   
    VAGen_COUNT = 1;
    while (VAGen_COUNT <= VHDVS1IW-TRIGGERS.UROWCNT)
        if (VHDVS01_DATA.YRD[VAGen_COUNT] == "CY")
            if ( VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS2I_RETURN.CY-A[1] = VHDVS2I_RETURN.CY-A[1] + VHDVS01_DATA.CNT-CARS-REPR-UM[VAGen_COUNT];
                VHDVS2I_RETURN.CY-A[2] = VHDVS2I_RETURN.CY-A[2] + VHDVS01_DATA.CNT-CARS-REPR-PM[VAGen_COUNT];
                VHDVS2I_RETURN.CY-A[3] = VHDVS2I_RETURN.CY-A[3] + VHDVS01_DATA.CNT-CARS-REPR-MOD[VAGen_COUNT];
