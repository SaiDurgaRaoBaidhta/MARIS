    CAR-L-DATA[16] = REV-SERVICE-L;
    CAR-M-DATA[16] = REV-SERVICE-M;
    CAR-K-DATA[16] = REV-SERVICE-K;
    CAR-TOTAL-DATA[16] = REV-SERVICE-T;

  
    CAR-A-DATA[17] = GO-AVAIL-A;
    CAR-B-DATA[17] = GO-AVAIL-B;
    CAR-C-DATA[17] = GO-AVAIL-C;
    CAR-D-DATA[17] = GO-AVAIL-D;
    CAR-E-DATA[17] = GO-AVAIL-E;
    CAR-L-DATA[17] = GO-AVAIL-L;
    CAR-M-DATA[17] = GO-AVAIL-M;
    CAR-K-DATA[17] = GO-AVAIL-K;
    CAR-TOTAL-DATA[17] = GO-AVAIL-T;
    VHYS05IW-TRIGGER.LOAD-DATA = "Y";
end 

