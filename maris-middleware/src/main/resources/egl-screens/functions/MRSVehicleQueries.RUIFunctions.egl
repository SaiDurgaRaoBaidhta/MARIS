Function VHST02IS-POSITION ()
   
    if (VHST02IW-CNTS.BUTTON == "DOWN")
  
        if (VHST02IW-4.CONSIST in VHST02IW-CNTS.VAGen_HOLD)
            VHST02IW-CNTS.CON-INDEX = sysVar.arrayIndex;
        end
        VHST02IW-CNTS.CON-INDEX = VHST02IW-CNTS.CON-INDEX + 1;
         
    end
    if (VHST02IW-CNTS.BUTTON == "UP")
  
        if (VHST02IW-1.CONSIST in VHST02IW-CNTS.VAGen_HOLD)
            VHST02IW-CNTS.CON-INDEX = sysVar.arrayIndex;
        end
        VHST02IW-CNTS.CON-INDEX = VHST02IW-CNTS.CON-INDEX - 4;
    end
    IND = 1;
  
    while (VHST02IW-CNTS.VAGen_HOLD[CON-INDEX] != VHST2A1_DATA.CONSIST[IND])
  
        IND = IND + 1;
    end
end 

Function VHST02IS-UP () 
    VHST02IW-CNTS.BUTTON = "UP";
    VHST02IW-CNTS.PAGE = VHST02IW-CNTS.PAGE - 1;
    VHST02IW-TRIGGERS.ENABLE-DOWN = "Y";
end 

Function VHST03IS-GET-DATA ()
  
  
  
  
  
  
  
  
   
    VHST02IW-CNTS.CNT = 0;
    VHST02IW-CNTS.ROWS-RETURNED = 0;
    VHST02IW-CNTS.PAGE = 0;
    VHST02IW-CNTS.TOTAL-PAGES = 0;
    set VHST03IW-1 empty;
    set VHST03IW-2 empty;
    set VHST03IW-3 empty;
    set VHST03IW-4 empty;
    VHST02IW-CNTS.NO-DATA = "N";
    try
        call "VHST3A3"(XDCONTROL, VHST3A3_CRIT, VHST3A3_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHST3A1_CRIT.DATE-LOW = VHST3A3_DATA.FROM-DATE;
    end
    try
        call "VHST3A4"(XDCONTROL, VHST3A4_CRIT, VHST3A4_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHST3A1_CRIT.DATE-REV = VHST3A4_DATA.TO-DATE;
    end
    XXEXT_CALL_Level77Items.UEXTNAM = "VHST03I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHST3A1";

    
    try
        call "VHST3A1"(XDCONTROL, VHST3A1_CRIT, VHST3A1_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHST02IW-CNTS.FIRST-TIME = "N";
            VHST02IW-CNTS.ROWS-RETURNED = XDCONTROL.UROWCNT;
            

  
        else
            VHST02IW-CNTS.NO-DATA = "Y";
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function CarWithSoftVer(carNo char(6) in, soft_ver char(4) in) returns(string)
    retValue string;
    
    
    if (strLib.indexOf(soft_ver, "$")>0)
    	retValue = "$" + strLib.clip( carNo, 0);
    else
    	retValue = strLib.clip( carNo, 0);
    end
    return(retValue);
end

Function VHST03IS-LOAD () 
    
    if (VHST02IW-CNTS.NO-DATA != "Y")

  
        if (VHST02IW-CNTS.FIRST-TIME != "Y")

     
            VHST02IW-CNTS.IND = 1;
            VHST02IW-CNTS.CNT = 1;
            VHST02IW-CNTS.VAGen_HOLD[CNT] = VHST3A1_DATA.CONSIST[IND];
            while (IND <= UROWCNT)
                if (VHST02IW-CNTS.VAGen_HOLD[CNT] != VHST3A1_DATA.CONSIST[IND])
                    VHST02IW-CNTS.CNT = VHST02IW-CNTS.CNT + 1;
                    VHST02IW-CNTS.VAGen_HOLD[CNT] = VHST3A1_DATA.CONSIST[IND];
                end
                IND = IND + 1;
            end

		  
		  
		
		  
            VHST02IW-CNTS.TOTAL-PAGES = CNT / 3;
            if (VHST02IW-CNTS.TOTAL-PAGES == 0)
                VHST02IW-CNTS.TOTAL-PAGES = 1;
                 
            end
            if (VHST02IW-CNTS.TOTAL-REM != 0)
                VHST02IW-CNTS.TOTAL-PAGES = VHST02IW-CNTS.TOTAL-PAGES + 1;
            end
            VHST02IW-CNTS.FIRST-TIME = "Y";
            VHST02IW-CNTS.PAGE = 1;
            VHST02IW-CNTS.IND = 1;
            set VHST03IW-1 empty;
            set VHST03IW-2 empty;
            set VHST03IW-3 empty;
            
  		
        else
            if (VHST02IW-CNTS.ROWS-RETURNED > 0) 
                VHST03IS-POSITION(); 
            end
      		
            set VHST03IW-1 empty;
            set VHST03IW-2 empty;
            set VHST03IW-3 empty;
            
  		
        end 
		
		

  		
        if (VHST02IW-CNTS.PAGE == 1)
            VHST02IW-TRIGGERS.DISABLE-UP = "Y";
        else
            VHST02IW-TRIGGERS.ENABLE-UP = "Y";
        end


  
  
        if (IND <= UROWCNT)
            VHST03IW-1.CONSIST = VHST3A1_DATA.CONSIST[IND];
            VHST03IW-1.ORIGIN = VHST3A1_DATA.ORIGIN-LOC[IND];
            if (VHST03IW-1.ORIGIN == "HY")
                VHST03IW-1.ORIGIN = "Hayward";
            end
            if (VHST03IW-1.ORIGIN == "DY")
                VHST03IW-1.ORIGIN = "Daly City";
            end
            if (VHST03IW-1.ORIGIN == "RY")
                VHST03IW-1.ORIGIN = "Richmond";
            end
            if (VHST03IW-1.ORIGIN == "CY")
                VHST03IW-1.ORIGIN = "Concord";
            end
            VHST03IW-1.DATE-INSRV = VHST3A1_DATA.DATE-INSRV-REV[IND];
            XXDATEW.DATE-YYYY-MM-DD = VHST03IW-1.DATE-INSRV;
            XXDATEW.VAGen_FUNCTION = "MDY";
            MRSCommonCode.XXDATES-CONVERT();
            VHST03IW-1.DATE-INSRV = XXDATEW.DATE-MM-DD-YYYY;
            VHST03IW-1.TIME-INSRV = VHST3A1_DATA.TIME-INSRV[IND];
            if (VHST3A1_DATA.CON-STAT[IND] == "CON")
                VHST03IW-1.MSG = "TI";
            end

           
            if (VHST03IW-1.CONSIST == VHST3A1_DATA.CONSIST[IND])
                if (VHST3A1_DATA.CON-STAT[IND] == "CON" || VHST3A1_DATA.TRAIN-INCD-IND[IND] == "Y")
                    VHST03IW-COLOR.CAR1-COLOR-1 = "RED";
                    VHST03IW-COLOR.CAR2-COLOR-1 = "RED";
                    VHST03IW-COLOR.CAR3-COLOR-1 = "RED";
                    VHST03IW-COLOR.CAR4-COLOR-1 = "RED";
                    VHST03IW-COLOR.CAR5-COLOR-1 = "RED";
                    VHST03IW-COLOR.CAR6-COLOR-1 = "RED";
                    VHST03IW-COLOR.CAR7-COLOR-1 = "RED";
                    VHST03IW-COLOR.CAR8-COLOR-1 = "RED";
                    VHST03IW-COLOR.CAR9-COLOR-1 = "RED";
                    VHST03IW-COLOR.CAR10-COLOR-1 = "RED";
                else
                    VHST03IW-COLOR.CAR1-COLOR-1 = "BLACK";
                    VHST03IW-COLOR.CAR2-COLOR-1 = "BLACK";
                    VHST03IW-COLOR.CAR3-COLOR-1 = "BLACK";
                    VHST03IW-COLOR.CAR4-COLOR-1 = "BLACK";
                    VHST03IW-COLOR.CAR5-COLOR-1 = "BLACK";
                    VHST03IW-COLOR.CAR6-COLOR-1 = "BLACK";
                    VHST03IW-COLOR.CAR7-COLOR-1 = "BLACK";
                    VHST03IW-COLOR.CAR8-COLOR-1 = "BLACK";
                    VHST03IW-COLOR.CAR9-COLOR-1 = "BLACK";
                    VHST03IW-COLOR.CAR10-COLOR-1 = "BLACK";
                end
                if (VHST3A1_DATA.TRAIN-INCD-IND[IND] == "Y")
                    VHST03IW-COLOR.CAR1-COLOR-1 = "RED";
                else
                    if (VHST3A1_DATA.VEH-STAT[IND] == "GO")
                        VHST03IW-COLOR.CAR1-COLOR-1 = "BLACK";
                    else
                        if (VHST3A1_DATA.VEH-STAT[IND] == "USABLE")
                            VHST03IW-COLOR.CAR1-COLOR-1 = "DARK GREEN";
                        else
                            VHST03IW-COLOR.CAR1-COLOR-1 = "RED";
                        end
                    end
                end
                if (VHST3A1_DATA.LFT-ORIENTATION-CD[IND] ==
                 VHST3A1_DATA.VAGen_ORIENTATION[IND])
                    VHST03IW-1.LFT-ORIENT-1 = VHST3A1_DATA.LFT-ORIENTATION-CD[IND];
                    VHST03IW-1.RGT-ORIENT-1 = " ";
                else
                    if (VHST3A1_DATA.RGT-ORIENTATION-CD[IND] ==
                     VHST3A1_DATA.VAGen_ORIENTATION[IND])
                        VHST03IW-1.RGT-ORIENT-1 = VHST3A1_DATA.RGT-ORIENTATION-CD[IND];
                        VHST03IW-1.LFT-ORIENT-1 = " ";
                    end
                end
                VHST03IW-1.CAR1 = VHST3A1_DATA.CAR-NO[IND];
                VHST03IW-1.SV_GR_CAR1 = CarWithSoftVer (VHST03IW-1.GR-CAR1, VHST3A1_DATA.SOFT_VER[IND]);
                if(VHST3A1_DATA.ROW_COUNT >= IND)
                	VHST03IW-1.HY1 = VHST3A1_DATA.SYMP-COUNT[IND];
                end
                VHST03IW-1.HOME-YRD1 = VHST3A1_DATA.HOME-YRD[IND];
                IND = IND + 1;
            end
            if (VHST03IW-1.CONSIST == VHST3A1_DATA.CONSIST[IND])
                if (VHST3A1_DATA.TRAIN-INCD-IND[IND] == "Y")
                    VHST03IW-COLOR.CAR2-COLOR-1 = "RED";
                else
                    if (VHST3A1_DATA.VEH-STAT[IND] == "GO")
                        VHST03IW-COLOR.CAR2-COLOR-1 = "BLACK";
                    else
                        if (VHST3A1_DATA.VEH-STAT[IND] == "USABLE")
                            VHST03IW-COLOR.CAR2-COLOR-1 = "DARK GREEN";
                        else
                            VHST03IW-COLOR.CAR2-COLOR-1 = "RED";
                        end
                    end
                end
                if (VHST3A1_DATA.LFT-ORIENTATION-CD[IND] ==
                 VHST3A1_DATA.VAGen_ORIENTATION[IND])
                    VHST03IW-1.LFT-ORIENT-2 = VHST3A1_DATA.LFT-ORIENTATION-CD[IND];
                    VHST03IW-1.RGT-ORIENT-2 = " ";
                else
                    if (VHST3A1_DATA.RGT-ORIENTATION-CD[IND] ==
                     VHST3A1_DATA.VAGen_ORIENTATION[IND])
                        VHST03IW-1.RGT-ORIENT-2 = VHST3A1_DATA.RGT-ORIENTATION-CD[IND];
                        VHST03IW-1.LFT-ORIENT-2 = " ";
                    end
                end
                VHST03IW-1.CAR2 = VHST3A1_DATA.CAR-NO[IND];
                VHST03IW-1.SV_GR_CAR2 = CarWithSoftVer (VHST03IW-1.GR-CAR2, VHST3A1_DATA.SOFT_VER[IND]);
                if(VHST3A1_DATA.ROW_COUNT >=IND)
                	VHST03IW-1.HY2 = VHST3A1_DATA.SYMP-COUNT[IND];
                end
                VHST03IW-1.HOME-YRD2 = VHST3A1_DATA.HOME-YRD[IND];
                IND = IND + 1;
            end
            if (VHST03IW-1.CONSIST == VHST3A1_DATA.CONSIST[IND])
                if (VHST3A1_DATA.TRAIN-INCD-IND[IND] == "Y")
                    VHST03IW-COLOR.CAR3-COLOR-1 = "RED";
                else
                    if (VHST3A1_DATA.VEH-STAT[IND] == "GO")
                        VHST03IW-COLOR.CAR3-COLOR-1 = "BLACK";
                    else
                        if (VHST3A1_DATA.VEH-STAT[IND] == "USABLE")
                            VHST03IW-COLOR.CAR3-COLOR-1 = "DARK GREEN";
                        else
                            VHST03IW-COLOR.CAR3-COLOR-1 = "RED";
                        end
                    end
                end
                if (VHST3A1_DATA.LFT-ORIENTATION-CD[IND] ==
                 VHST3A1_DATA.VAGen_ORIENTATION[IND])
                    VHST03IW-1.LFT-ORIENT-3 = VHST3A1_DATA.LFT-ORIENTATION-CD[IND];
