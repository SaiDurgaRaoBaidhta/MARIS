end 

Function VHRC03IS-SUBMIT-X () 
    VHRC03IW-TRIGGER.OK-SUBMIT = "Y";
    VHRC03IW.NULL-TO-ERROR = "N";
    VHRC03IW.INVALID-TO-DATE = " ";
    VHRC03IW.INVALID-FROM-DATE = " ";
    if (VHRC03IW.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHRC03IW.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHRC03IW.INVALID-FROM-DATE = "Y";
            
   
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHRC03I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHRC03IW.TO-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHRC03IW.TO-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHRC03IW.INVALID-TO-DATE = "Y";
            
  
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHRC03I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHRC03IW.INVALID-FROM-DATE == "Y")
        VHRC03I_MESSAGE.MESG1 = "INVALID FROM DATE";
        VHRC03IW-TRIGGER.OK-SUBMIT = "N";
    else
  
        if (VHRC03IW.TO-DATE != " ")
            if ((VHRC03IW.TO-DATE-YEAR-NUM > VHRC03IW.WS-CURR-YEAR-NUM) ||
             (VHRC03IW.TO-DATE-YEAR-NUM == VHRC03IW.WS-CURR-YEAR-NUM &&
             VHRC03IW.TO-DATE-MO-NUM > VHRC03IW.WS-CURR-MO-NUM) ||
             (VHRC03IW.TO-DATE-YEAR-NUM == VHRC03IW.WS-CURR-YEAR-NUM &&
             VHRC03IW.TO-DATE-MO-NUM == VHRC03IW.WS-CURR-MO-NUM &&
             VHRC03IW.TO-DATE-DAY-NUM > VHRC03IW.WS-CURR-DA-NUM))
                VHRC03I_MESSAGE.MESG1 = "To date cannot be greater than CURRENT_DATE.";
                VHRC03IW.INVALID-TO-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                
  
            end
        end
    end
    if (VHRC03IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHRC03IW.INVALID-TO-DATE == "Y")
            VHRC03I_MESSAGE.MESG1 = "INVALID TO DATE";
            VHRC03IW-TRIGGER.OK-SUBMIT = "N";
        else
  
            if (VHRC03IW.FROM-DATE != " " && VHRC03IW.TO-DATE != " ")
                if ((VHRC03IW.FROM-DATE-YEAR-NUM > VHRC03IW.TO-DATE-YEAR-NUM) ||
                 (VHRC03IW.FROM-DATE-YEAR-NUM == VHRC03IW.TO-DATE-YEAR-NUM &&
                 VHRC03IW.FROM-DATE-MO-NUM > VHRC03IW.TO-DATE-MO-NUM) ||
                 (VHRC03IW.FROM-DATE-YEAR-NUM == VHRC03IW.TO-DATE-YEAR-NUM &&
                 VHRC03IW.FROM-DATE-MO-NUM == VHRC03IW.TO-DATE-MO-NUM &&
                 VHRC03IW.FROM-DATE-DAY-NUM > VHRC03IW.TO-DATE-DAY-NUM))
                    VHRC03I_MESSAGE.MESG1 = "From date cannot be greater than To date.";
                    VHRC03IW.INVALID-FROM-DATE = "Y";
                    AFCXVLDW.NO-ERROR = "N";
                    
  
                end
            end
        end
    end
    if (VHRC03IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHRC03IW-TRIGGER.INVALID-SYMP-TO == "Y")
            VHRC03IW-TRIGGER.OK-SUBMIT = "N";
        else
            if (VHRC03IW-TRIGGER.INVALID-SYMP-FROM == "Y")
                VHRC03IW-TRIGGER.OK-SUBMIT = "N";
            else
  
  
  
                if (AFCXVLDW.NO-ERROR == "N")
                    VHRC03IW-TRIGGER.OK-SUBMIT = " ";
                else
                    VHRC03IW-TRIGGER.OK-SUBMIT = "Y ";
                end
            end
        end
    end
end 

Function VHSCM1IS-CLEAR () 
    set VHSCM1IW empty;
    VHSCM1IW.SYSTEM-TIME = VGVar.currentFormattedTime;
    VHXREVA_CRIT.SEL-IDX = 3;
    try
        call "VHXREVA"(XDCONTROL, VHXREVA_CRIT, VHXREVA_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        XXDATEW.DATE-MM-DD-YYYY = VHXREVA_DATA.REVENUE-DATE;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHSCM1A_DATA.REV-DATE = XXDATEW.DATE-YYYY-MM-DD;
        try
            call "VHSCM1A"(XDCONTROL, VHSCM1A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHSCM1IS-FIND-DAY();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    DISABLE-PRV = "Y";
    DISABLE-NXT = "Y";
    set VHSCM1B_DATA empty;
    LOAD-DATA = "Y";
    SCHDAY-SETFOCUS = "Y";
end 

Function VHSCM1IS-FIND-DAY () 
    if (VHSCM1A_DATA.REV-DAY == 1)
        VHSCM1IW.SCHEDULE-DAY = "SU";
        VHSCM1IW.SCHEDULE-TIME = "DA";
    else
        if (VHSCM1A_DATA.REV-DAY == 2)
            VHSCM1IW.SCHEDULE-DAY = "MO";
            VHSCM1IS-FIND-TIME();
        else
            if (VHSCM1A_DATA.REV-DAY == 3)
                VHSCM1IW.SCHEDULE-DAY = "TU";
                VHSCM1IS-FIND-TIME();
            else
                if (VHSCM1A_DATA.REV-DAY == 4)
                    VHSCM1IW.SCHEDULE-DAY = "WE";
                    VHSCM1IS-FIND-TIME();
                else
                    if (VHSCM1A_DATA.REV-DAY == 5)
                        VHSCM1IW.SCHEDULE-DAY = "TH";
                        VHSCM1IS-FIND-TIME();
                    else
                        if (VHSCM1A_DATA.REV-DAY == 6)
                            VHSCM1IW.SCHEDULE-DAY = "FR";
                            VHSCM1IS-FIND-TIME();
                        else
                            if (VHSCM1A_DATA.REV-DAY == 7)
                                VHSCM1IW.SCHEDULE-DAY = "SA";
                                VHSCM1IW.SCHEDULE-TIME = "DA";
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHSCM1IS-FIND-TIME () 
    if (VHSCM1IW.SYSTEM-TIME-HR >= 0 && VHSCM1IW.SYSTEM-TIME-HR < 7)
        VHSCM1IW.SCHEDULE-TIME = "AM";
    else
        if (VHSCM1IW.SYSTEM-TIME-HR == 7)
            if (VHSCM1IW.SYSTEM-TIME-MIN == 0)
                VHSCM1IW.SCHEDULE-TIME = "AM";
            else
                VHSCM1IW.SCHEDULE-TIME = "PM";
            end
        else
            if (VHSCM1IW.SYSTEM-TIME-HR > 7 && VHSCM1IW.SYSTEM-TIME-HR <= 17)
                VHSCM1IW.SCHEDULE-TIME = "PM";
            else
                if (VHSCM1IW.SYSTEM-TIME-HR >= 18 && VHSCM1IW.SYSTEM-TIME-HR <= 24)
                    VHSCM1IW.SCHEDULE-TIME = "AM";
                end
            end
        end
    end
end 

Function VHSCM1IS-LIST () 
    VHSCM1IW.HOME-YRD[1] = "CY";
    VHSCM1IW.HOME-YRD[2] = "DY";
    VHSCM1IW.HOME-YRD[3] = "HY";
    VHSCM1IW.HOME-YRD[4] = "RY";
    VHSCM1IW.YRD-INDEX = 1;
    VHSCM1IW.ROW-COUNT = 7;
    BUTTON-CLICK = " ";
    VHSCM1B_DATA.RET-IND = " ";
    if ((VHSCM1IW.SCHEDULE-DAY == " " && VHSCM1IW.SCHEDULE-TIME == " "))
        VHSCM1B_DATA.RET-IND = " ";
    else
        if ((VHSCM1IW.SCHEDULE-DAY != " " && VHSCM1IW.SCHEDULE-TIME != " "))
            if (VHSCM1IW.SCHEDULE-DAY == "MO" ||
             VHSCM1IW.SCHEDULE-DAY == "TU" ||
             VHSCM1IW.SCHEDULE-DAY == "WE" ||
             VHSCM1IW.SCHEDULE-DAY == "TH" ||
             VHSCM1IW.SCHEDULE-DAY == "FR" ||
             VHSCM1IW.SCHEDULE-DAY == "SA" ||
             VHSCM1IW.SCHEDULE-DAY == "SU")

            else
                INVALID-DAY = "Y";
                return;
            end
            if (VHSCM1IW.SCHEDULE-TIME == "AM" ||
             VHSCM1IW.SCHEDULE-TIME == "PM" ||
             VHSCM1IW.SCHEDULE-TIME == "DA")

            else
                INVALID-TIME = "Y";
                return;
            end
            VHSCM1B_DATA.RET-IND = "BOTH";
            VHSCM1B_DATA.SCHEDULE-DAY = VHSCM1IW.SCHEDULE-DAY;
            VHSCM1B_DATA.SCHEDULE-TIME = VHSCM1IW.SCHEDULE-TIME;
        else
            if (VHSCM1IW.SCHEDULE-DAY == " " && VHSCM1IW.SCHEDULE-TIME != " ")
                INVALID-DAY = "Y";
                return;
            else
                if (VHSCM1IW.SCHEDULE-DAY != " " && VHSCM1IW.SCHEDULE-TIME == " ")
                    INVALID-TIME = "Y";
                    return;
                end
            end
        end
    end
    EXECUTE-PRVNXT = "Y";
end 

Function VHSCM1IS-PRVNXT () 
    if (BUTTON-CLICK == "PRV ")
        VHSCM1IW.YRD-INDEX = VHSCM1IW.YRD-INDEX - 1;
        if (VHSCM1IW.YRD-INDEX <= 1)
            VHSCM1IW.YRD-INDEX = 1;
            DISABLE-PRV = "Y";
            ENABLE-NXT = "Y";
            NXT-SETFOCUS = "Y";
        else
            ENABLE-NXT = "Y";
            ENABLE-PRV = "Y";
            PRV-SETFOCUS = "Y";
        end
    else
        if (BUTTON-CLICK == "NXT")
            VHSCM1IW.YRD-INDEX = VHSCM1IW.YRD-INDEX + 1;
            ENABLE-PRV = "Y";
            if (VHSCM1IW.YRD-INDEX >= 4)
                VHSCM1IW.YRD-INDEX = 4;
                DISABLE-NXT = "Y";
                PRV-SETFOCUS = "Y";
            else
                ENABLE-NXT = "Y";
                NXT-SETFOCUS = "Y";
            end
        else
            DISABLE-PRV = "Y";
            ENABLE-NXT = "Y";
            NXT-SETFOCUS = "Y";
        end
    end
    VHSCM1B_DATA.CRIT-HOME-YRD = VHSCM1IW.HOME-YRD[YRD-INDEX];
    try
        call "VHSCM1B"(XDCONTROL, VHSCM1B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if (VHSCM1B_DATA.REC-FOUND == "Y")
            VHSCM1IW-TRIGGER.LOAD-DATA = "Y";
        else
            if (VHSCM1B_DATA.REC-FOUND == "N")
                set VHSCM1B_DATA empty;
                VHSCM1IW.ROW-COUNT = 0;
                VHSCM1B_DATA.HOME-YRD[1] = " ";
                VHSCM1B_DATA.HOME-YRD[2] = " ";
                VHSCM1B_DATA.HOME-YRD[3] = " ";
                VHSCM1B_DATA.HOME-YRD[4] = " ";
                DISABLE-PRV = "Y";
                DISABLE-NXT = "Y";
                VHSCM1IW-TRIGGER.LOAD-DATA = "Y";
                VHSCM1IW-TRIGGER.NO-REC-FOUND = "Y";
            else
                VHSCM1IW.ROW-COUNT = 0;
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    else
        set VHSCM1B_DATA empty;
        VHSCM1IW.ROW-COUNT = 1;
        VHSCM1B_DATA.HOME-YRD[1] = VHSCM1IW.HOME-YRD[YRD-INDEX];
        VHSCM1IW-TRIGGER.LOAD-DATA = "Y";
    end
end 

Function VHST01IS-CLEAR () 
    set VHST01IW-MSG empty;
    set VHST01IW2 empty;
    VHST01IW.CON-FROM = " ";
end 

