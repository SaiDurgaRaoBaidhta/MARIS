    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        YRD-COUNT = XDCONTROL.UROWCNT + 1;
        VHYS01A_DATA.YRD[YRD-COUNT] = "ALL";
        LOAD-YRD = "Y";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
