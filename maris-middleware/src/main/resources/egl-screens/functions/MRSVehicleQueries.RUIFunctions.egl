    CAR-D-DATA[15] = CAR-D-DATA[3] - CAR-D-DATA[13];
    CAR-E-DATA[15] = CAR-E-DATA[3] - CAR-E-DATA[13];
    CAR-L-DATA[15] = CAR-L-DATA[3] - CAR-L-DATA[13];
    CAR-M-DATA[15] = CAR-M-DATA[3] - CAR-M-DATA[13];    
    CAR-K-DATA[15] = CAR-K-DATA[3] - CAR-K-DATA[13];
    CAR-TOTAL-DATA[15] = CAR-TOTAL-DATA[3] - CAR-TOTAL-DATA[13];

  
