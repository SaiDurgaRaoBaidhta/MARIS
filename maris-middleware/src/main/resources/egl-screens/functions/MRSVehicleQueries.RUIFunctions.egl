                VHMC01I_MESSAGE.MESG1 = "To date cannot be greater than CURRENT_DATE.";
                VHMC01IW.INVALID-TO-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                
  
            end
        end
    end
    if (VHMC01IW.INVALID-TO-DATE == "Y")
        VHMC01IW-TRIGGER.OK-SUBMIT = "N";
    end
    if (VHMC01IW-TRIGGER.OK-SUBMIT == "Y")
  
        if (VHMC01IW.FROM-DATE != " " && VHMC01IW.TO-DATE != " ")
            if ((VHMC01IW.FROM-DATE-YEAR-NUM > VHMC01IW.TO-DATE-YEAR-NUM) ||
             (VHMC01IW.FROM-DATE-YEAR-NUM == VHMC01IW.TO-DATE-YEAR-NUM &&
             VHMC01IW.FROM-DATE-MO-NUM > VHMC01IW.TO-DATE-MO-NUM) ||
             (VHMC01IW.FROM-DATE-YEAR-NUM == VHMC01IW.TO-DATE-YEAR-NUM &&
             VHMC01IW.FROM-DATE-MO-NUM == VHMC01IW.TO-DATE-MO-NUM &&
             VHMC01IW.FROM-DATE-DAY-NUM > VHMC01IW.TO-DATE-DAY-NUM))
                VHMC01I_MESSAGE.MESG1 = "From date cannot be greater than To date.";
                VHMC01IW.INVALID-FROM-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                VHMC01IW-TRIGGER.OK-SUBMIT = "N";
                
  
            end
        end
    end

  
  
  
  
  
  
  
   
   
   
    if (AFCXVLDW.NO-ERROR == "N")
        VHMC01IW-TRIGGER.OK-SUBMIT = " ";
    else
        VHMC01IW-TRIGGER.OK-SUBMIT-CLEAR = "Y ";
    end
end 

