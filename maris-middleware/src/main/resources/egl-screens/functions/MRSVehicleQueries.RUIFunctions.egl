    if (PRT-IDX > 0)
        ENABLE-HARD = "Y";
        VHST01IS-PASSVALUE.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRT-IDX];
    else
        DISABLE-HARD = "Y";
    end
end 

Function VHST01IS-MSG () 
    if (VHST01IW-TRIGGERS.INVALID-FROM == "Y")
        VHST01IW-MSG.WS-MSG = "THE FROM CONSIST NUMBER IS INVALID";
        VHST01IW-TRIGGERS.INVALID-FROM = " ";
    end
    if (VHST01IW-TRIGGERS.INVALID-TO == "Y")
        VHST01IW-MSG.WS-MSG = "THE TO CONSIST NUMBER CANNOT BE LESS THAN FROM CONSIST";
        VHST01IW-TRIGGERS.INVALID-TO = " ";
    end
end 

Function VHST01IS-PRINTER ()
  
  
  
  
  
  
  
  
  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "WS100I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS70A01";

    
    try
        call "WS70A01"(XDCONTROL, WS70A01_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHST01IS-SUBMIT () 
    VHST01IW.VALID = "Y";
    if (VHST01IW.CON-FROM != "ALL")
        if (VHST01IW.CON-FROM-N <= 0)
            VHST01IW-TRIGGERS.INVALID-FROM = "Y";
            VHST01IW.VALID = "N";
        else
            if (VHST01IW.CON-TO-N != 0 &&
             VHST01IW.CON-TO-N < VHST01IW.CON-FROM-N)
                VHST01IW-TRIGGERS.INVALID-TO = "Y";
                VHST01IW.VALID = "N";
            end
        end
    end

  
    if (VHST01IW.CON-TO == "    ")
        VHST01IW.CON-TO = VHST01IW.CON-FROM;
    end
    if (VHST01IW.CON-FROM == "ALL")
        VHST01IW.CON-FROM = "0100";
        VHST01IW.CON-TO = "9999";
    end
    if (VHST01IW.VALID == "Y")
        VHST01IS-SUBMIT-X();
    end
end 

Function VHST01IS-SUBMIT-1 () 
    VHST01IW.VALID = "Y";
    if (VHST01IW.CON-FROM-N <= 0)
        VHST01IW-TRIGGERS.INVALID-FROM = "Y";
        VHST01IW.VALID = "N";
    else
        if (VHST01IW.CON-TO-N != 0 &&
         VHST01IW.CON-FROM-N < 100 &&
         VHST01IW.CON-FROM-N > 999)
            VHST01IW-TRIGGERS.INVALID-FROM = "Y";
            VHST01IW.VALID = "N";
        end
    end
    if (VHST01IW2.SYMP-CD == " ")
        VHST01IW-MSG.WS-MSG = "SYMPTOM CODE CANNOT BE BLANK";
        VHST01IW-TRIGGERS.SYMP-CD-ERR = "Y";
        VHST01IW.VALID = "N";
    end
    if (VHST01IW.VALID == "Y")
        VHST01IS-SUBMIT-XX();
    end
end 




Function VHST01IS-SUBMIT-X ()
  
  
  
  
  
  
  
  
  
  
  
  
  
   
    set VHST011_CRIT empty;
    VHST011_CRIT.REPT-ID = VHST01IW.RPT;
    if (VHST01IW.RPT == "3")
        VHST011_CRIT.REPT-ID = "2";
    end
    VHST011_CRIT.REPT-TYPE = VHST01IS-PASSVALUE.VTAM-NAME;
    VHST011_CRIT.REPT-MISC = VHST01IW2.CON-FROM;
    VHST011_CRIT.CON-NO = VHST01IW2.CON-TO;
    VHST011_CRIT.SYMP-CD = VHST01IW.SYMP-CD;
    VHST011_CRIT.DATE-INSRV-REV = VHST01IW.REV-DATE-DB2;


    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHST01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHST011";

    
    try
        call "VHST011"(XDCONTROL, VHST011_CRIT, VHST011_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
            VHST01IS-PASSVALUE.SUBMIT = "Y";
        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 




Function VHST01IS-SUBMIT-XX ()
  
  
  
  
  
  
  
  
  
  
  
  
  
   
    set VHST011_CRIT empty;
