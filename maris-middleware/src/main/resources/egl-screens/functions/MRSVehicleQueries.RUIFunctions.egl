Function VHDP01IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  

  
  
  
   
    if (VHDP01IW-TRIGGER.OK-SUBMIT == "Y")
        VHDP01IW.FROM-DATE-FILLER1 = "/";
        VHDP01IW.FROM-DATE-FILLER2 = "/";
        VHDP01IW.TO-DATE-FILLER1 = "/";
        VHDP01IW.TO-DATE-FILLER2 = "/";
        VHDP01C_CRIT.FROM-DATE = VHDP01IW.FROM-DATE;
        VHDP01C_CRIT.TO-DATE = VHDP01IW.TO-DATE;
        VHDP01C_CRIT.REPT-ID = VHDP01IW-TRIGGER.VTAM-NAME;

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHDP01I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHDP01C";

    
        try
            call "VHDP01C"(XDCONTROL, VHDP01C_CRIT, VHDP01C_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
                VHDP01IW-TRIGGER.SUBMIT = "Y";
            else

        


        
    
    
    
    
                VHDP01I_MESSAGE.MESG1 = "INVALID PARAMETER LIST";
            end
        else

        end
    end
end 

Function VHDP01IS-SUBMIT-X () 
    VHDP01IW-TRIGGER.OK-SUBMIT = "Y";
    VHDP01IW.NULL-TO-ERROR = "N";
    VHDP01IW.INVALID-TO-DATE = " ";
    VHDP01IW.INVALID-FROM-DATE = " ";
    if (VHDP01IW.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHDP01IW.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHDP01IW.INVALID-FROM-DATE = "Y";
            
   
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHDP01I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHDP01IW.TO-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHDP01IW.TO-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHDP01IW.INVALID-TO-DATE = "Y";
            
  
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHDP01I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHDP01IW.INVALID-FROM-DATE == "Y")
        VHDP01I_MESSAGE.MESG1 = "INVALID FROM DATE";
        VHDP01IW-TRIGGER.OK-SUBMIT = "N";
    else
  
        if (VHDP01IW.TO-DATE != " ")
            if ((VHDP01IW.TO-DATE-YEAR-NUM > VHDP01IW.WS-CURR-YEAR-NUM) ||
             (VHDP01IW.TO-DATE-YEAR-NUM == VHDP01IW.WS-CURR-YEAR-NUM &&
             VHDP01IW.TO-DATE-MO-NUM > VHDP01IW.WS-CURR-MO-NUM) ||
             (VHDP01IW.TO-DATE-YEAR-NUM == VHDP01IW.WS-CURR-YEAR-NUM &&
             VHDP01IW.TO-DATE-MO-NUM == VHDP01IW.WS-CURR-MO-NUM &&
             VHDP01IW.TO-DATE-DAY-NUM > VHDP01IW.WS-CURR-DA-NUM))
                VHDP01I_MESSAGE.MESG1 = "To date cannot be greater than CURRENT_DATE.";
                VHDP01IW.INVALID-TO-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                
  
            end
        end
    end
    if (VHDP01IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHDP01IW.INVALID-TO-DATE == "Y")
            VHDP01I_MESSAGE.MESG1 = "INVALID TO DATE";
            VHDP01IW-TRIGGER.OK-SUBMIT = "N";
        else
  
            if (VHDP01IW.FROM-DATE != " " && VHDP01IW.TO-DATE != " ")
                if ((VHDP01IW.FROM-DATE-YEAR-NUM > VHDP01IW.TO-DATE-YEAR-NUM) ||
                 (VHDP01IW.FROM-DATE-YEAR-NUM == VHDP01IW.TO-DATE-YEAR-NUM &&
                 VHDP01IW.FROM-DATE-MO-NUM > VHDP01IW.TO-DATE-MO-NUM) ||
                 (VHDP01IW.FROM-DATE-YEAR-NUM == VHDP01IW.TO-DATE-YEAR-NUM &&
                 VHDP01IW.FROM-DATE-MO-NUM == VHDP01IW.TO-DATE-MO-NUM &&
                 VHDP01IW.FROM-DATE-DAY-NUM > VHDP01IW.TO-DATE-DAY-NUM))
                    VHDP01I_MESSAGE.MESG1 = "From date cannot be greater than To date.";
                    VHDP01IW.INVALID-FROM-DATE = "Y";
                    AFCXVLDW.NO-ERROR = "N";
                    
  
                end
            end
        end
    end
    if (VHDP01IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHDP01IW-TRIGGER.INVALID-SYMP-TO == "Y")
            VHDP01IW-TRIGGER.OK-SUBMIT = "N";
        else
            if (VHDP01IW-TRIGGER.INVALID-SYMP-FROM == "Y")
                VHDP01IW-TRIGGER.OK-SUBMIT = "N";
            else
  
  
  
                if (AFCXVLDW.NO-ERROR == "N")
                    VHDP01IW-TRIGGER.OK-SUBMIT = " ";
                else
                    VHDP01IW-TRIGGER.OK-SUBMIT = "Y ";
                end
            end
        end
    end
end 

Function VHDVS1IS-AT-0400 ()
  
   
    VHDVS3IW_VALUES.CY-A[2] = 0;
    VHDVS3IW_VALUES.CY-B[2] = 0;
    VHDVS3IW_VALUES.CY-C[2] = 0;
    VHDVS3IW_VALUES.CY-D[2] = 0;
    VHDVS3IW_VALUES.CY-E[2] = 0;
    VHDVS3IW_VALUES.CY-K[2] = 0;
    VHDVS3IW_VALUES.CY-L[2] = 0;
    VHDVS3IW_VALUES.CY-M[2] = 0;
    VHDVS3IW_VALUES.DY-A[2] = 0;
    VHDVS3IW_VALUES.DY-B[2] = 0;
    VHDVS3IW_VALUES.DY-C[2] = 0;
    VHDVS3IW_VALUES.DY-D[2] = 0;
    VHDVS3IW_VALUES.DY-E[2] = 0;
    VHDVS3IW_VALUES.DY-K[2] = 0;
    VHDVS3IW_VALUES.DY-L[2] = 0;
    VHDVS3IW_VALUES.DY-M[2] = 0;
    VHDVS3IW_VALUES.HY-A[2] = 0;
    VHDVS3IW_VALUES.HY-B[2] = 0;
    VHDVS3IW_VALUES.HY-C[2] = 0;
    VHDVS3IW_VALUES.HY-D[2] = 0;
    VHDVS3IW_VALUES.HY-E[2] = 0;
    VHDVS3IW_VALUES.HY-K[2] = 0;    
    VHDVS3IW_VALUES.HY-L[2] = 0;
    VHDVS3IW_VALUES.HY-M[2] = 0;
    VHDVS3IW_VALUES.RY-A[2] = 0;
    VHDVS3IW_VALUES.RY-B[2] = 0;
    VHDVS3IW_VALUES.RY-C[2] = 0;
    VHDVS3IW_VALUES.RY-D[2] = 0;
    VHDVS3IW_VALUES.RY-E[2] = 0;
    VHDVS3IW_VALUES.RY-K[2] = 0;
    VHDVS3IW_VALUES.RY-L[2] = 0;
    VHDVS3IW_VALUES.RY-M[2] = 0;
  
  
    VAGen_COUNT = 1;
    while (VAGen_COUNT <= VHDVS1IW-TRIGGERS.UROWCNT)

        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "CY" &&  VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
            VHDVS3IW_VALUES.CY-A[2] = VHDVS3IW_VALUES.CY-A[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "CY" &&  VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
            VHDVS3IW_VALUES.CY-B[2] = VHDVS3IW_VALUES.CY-B[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "CY" &&
         (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C1" ||
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C2" ) )
         	VHDVS3IW_VALUES.CY-C[2] = VHDVS3IW_VALUES.CY-C[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "CY" && 	
          ( VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K1" ||
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K2"))
            VHDVS3IW_VALUES.CY-K[2] = VHDVS3IW_VALUES.CY-K[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "CY" &&
                     VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "D1" )
            VHDVS3IW_VALUES.CY-D[2] = VHDVS3IW_VALUES.CY-D[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "CY" &&
            VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "E1")
            VHDVS3IW_VALUES.CY-E[2] = VHDVS3IW_VALUES.CY-E[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "CY" &&
                     VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "L1" )
            VHDVS3IW_VALUES.CY-L[2] = VHDVS3IW_VALUES.CY-L[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "CY" &&
            VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "M1")
            VHDVS3IW_VALUES.CY-M[2] = VHDVS3IW_VALUES.CY-M[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
         
        
        
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "DY" && 
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
            VHDVS3IW_VALUES.DY-A[2] = VHDVS3IW_VALUES.DY-A[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "DY" &&
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
            VHDVS3IW_VALUES.DY-B[2] = VHDVS3IW_VALUES.DY-B[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "DY" &&
         (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C1" || VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C2" ))
         	  VHDVS3IW_VALUES.DY-C[2] = VHDVS3IW_VALUES.DY-C[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
         end
         if (VHDVS02_DATA.YRD[VAGen_COUNT] == "DY" &&
         ( VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K1" ||  VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K2"))
            VHDVS3IW_VALUES.DY-K[2] = VHDVS3IW_VALUES.DY-K[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "DY" &&
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "D1")
            VHDVS3IW_VALUES.DY-D[2] = VHDVS3IW_VALUES.DY-D[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "DY" &&
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "E1")
            VHDVS3IW_VALUES.DY-E[2] = VHDVS3IW_VALUES.DY-E[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end  
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "DY" &&
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "L1")
            VHDVS3IW_VALUES.DY-L[2] = VHDVS3IW_VALUES.DY-L[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "DY" &&
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "M1")
            VHDVS3IW_VALUES.DY-M[2] = VHDVS3IW_VALUES.DY-M[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end  
        
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "HY" &&
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
            VHDVS3IW_VALUES.HY-A[2] = VHDVS3IW_VALUES.HY-A[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "HY" &&
          VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
            VHDVS3IW_VALUES.HY-B[2] = VHDVS3IW_VALUES.HY-B[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "HY" &&
         (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C1" ||
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C2" ) )
            VHDVS3IW_VALUES.HY-C[2] = VHDVS3IW_VALUES.HY-C[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "HY" && (                 	
          VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K1" ||
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K2"))
             VHDVS3IW_VALUES.HY-K[2] = VHDVS3IW_VALUES.HY-K[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 	
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "HY" &&
          VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "D1" )
            VHDVS3IW_VALUES.HY-D[2] = VHDVS3IW_VALUES.HY-D[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "HY" &&
          VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "E1")
            VHDVS3IW_VALUES.HY-E[2] = VHDVS3IW_VALUES.HY-E[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "HY" &&
          VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "M1" )
            VHDVS3IW_VALUES.HY-M[2] = VHDVS3IW_VALUES.HY-M[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "HY" &&
          VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "L1")
            VHDVS3IW_VALUES.HY-L[2] = VHDVS3IW_VALUES.HY-L[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end  
		
		
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "RY" && 
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
            VHDVS3IW_VALUES.RY-A[2] = VHDVS3IW_VALUES.RY-A[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "RY" && VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
            VHDVS3IW_VALUES.RY-B[2] = VHDVS3IW_VALUES.RY-B[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "RY" &&
         (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C1" ||
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C2" ) )
            VHDVS3IW_VALUES.RY-C[2] = VHDVS3IW_VALUES.RY-C[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end 
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "RY" && ( 
           VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K1" ||
         VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "K2"))
            VHDVS3IW_VALUES.RY-K[2] = VHDVS3IW_VALUES.RY-K[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end          	
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "RY" &&
          VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "D1" )
            VHDVS3IW_VALUES.RY-D[2] = VHDVS3IW_VALUES.RY-D[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "RY" &&
          VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "E1" )
            VHDVS3IW_VALUES.RY-E[2] = VHDVS3IW_VALUES.RY-E[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "RY" &&
          VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "L1" )
            VHDVS3IW_VALUES.RY-L[2] = VHDVS3IW_VALUES.RY-L[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "RY" &&
          VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "M1" )
            VHDVS3IW_VALUES.RY-M[2] = VHDVS3IW_VALUES.RY-M[2] + VHDVS02_DATA.CNT-CARS-AVAIL-AM[VAGen_COUNT];
        end
        
        VAGen_COUNT = VAGen_COUNT + 1;
    end 

  
    VHDVS3IW_VALUES.FLEET-A[2] = VHDVS3IW_VALUES.CY-A[2] + VHDVS3IW_VALUES.HY-A[2] + VHDVS3IW_VALUES.DY-A[2] + VHDVS3IW_VALUES.RY-A[2];
    VHDVS3IW_VALUES.FLEET-B[2] = VHDVS3IW_VALUES.CY-B[2] + VHDVS3IW_VALUES.HY-B[2] + VHDVS3IW_VALUES.DY-B[2] + VHDVS3IW_VALUES.RY-B[2];
    VHDVS3IW_VALUES.FLEET-C[2] = VHDVS3IW_VALUES.CY-C[2] + VHDVS3IW_VALUES.HY-C[2] + VHDVS3IW_VALUES.DY-C[2] + VHDVS3IW_VALUES.RY-C[2];
    VHDVS3IW_VALUES.FLEET-D[2] = VHDVS3IW_VALUES.CY-D[2] + VHDVS3IW_VALUES.HY-D[2] + VHDVS3IW_VALUES.DY-D[2] + VHDVS3IW_VALUES.RY-D[2];
    VHDVS3IW_VALUES.FLEET-E[2] = VHDVS3IW_VALUES.CY-E[2] + VHDVS3IW_VALUES.HY-E[2] + VHDVS3IW_VALUES.DY-E[2] + VHDVS3IW_VALUES.RY-E[2];
    VHDVS3IW_VALUES.FLEET-K[2] = VHDVS3IW_VALUES.CY-K[2] + VHDVS3IW_VALUES.HY-K[2] + VHDVS3IW_VALUES.DY-K[2] + VHDVS3IW_VALUES.RY-K[2];
    VHDVS3IW_VALUES.FLEET-L[2] = VHDVS3IW_VALUES.CY-L[2] + VHDVS3IW_VALUES.HY-L[2] + VHDVS3IW_VALUES.DY-L[2] + VHDVS3IW_VALUES.RY-L[2];
    VHDVS3IW_VALUES.FLEET-M[2] = VHDVS3IW_VALUES.CY-M[2] + VHDVS3IW_VALUES.HY-M[2] + VHDVS3IW_VALUES.DY-M[2] + VHDVS3IW_VALUES.RY-M[2];
    VHDVS3IW_VALUES.FLEET-TOT[2] = VHDVS3IW_VALUES.FLEET-A[2] + VHDVS3IW_VALUES.FLEET-B[2] + VHDVS3IW_VALUES.FLEET-C[2] + VHDVS3IW_VALUES.FLEET-D[2] 
    + VHDVS3IW_VALUES.FLEET-E[2] + VHDVS3IW_VALUES.FLEET-K[2]+ VHDVS3IW_VALUES.FLEET-L[2]+ VHDVS3IW_VALUES.FLEET-M[2];

  
  
  
    VHDVS3IW_VALUES.CY-A[3] = VHDVS3IW_VALUES.CY-A[2] - VHDVS3IW_VALUES.CY-A[1];
    VHDVS3IW_VALUES.CY-B[3] = VHDVS3IW_VALUES.CY-B[2] - VHDVS3IW_VALUES.CY-B[1];
    VHDVS3IW_VALUES.CY-C[3] = VHDVS3IW_VALUES.CY-C[2] - VHDVS3IW_VALUES.CY-C[1];
    VHDVS3IW_VALUES.CY-D[3] = VHDVS3IW_VALUES.CY-D[2] - VHDVS3IW_VALUES.CY-D[1];
    VHDVS3IW_VALUES.CY-E[3] = VHDVS3IW_VALUES.CY-E[2] - VHDVS3IW_VALUES.CY-E[1];
    VHDVS3IW_VALUES.CY-L[3] = VHDVS3IW_VALUES.CY-L[2] - VHDVS3IW_VALUES.CY-L[1];
    VHDVS3IW_VALUES.CY-M[3] = VHDVS3IW_VALUES.CY-M[2] - VHDVS3IW_VALUES.CY-M[1];
    VHDVS3IW_VALUES.CY-K[3] = VHDVS3IW_VALUES.CY-K[2] - VHDVS3IW_VALUES.CY-K[1];
    
    VHDVS3IW_VALUES.DY-A[3] = VHDVS3IW_VALUES.DY-A[2] - VHDVS3IW_VALUES.DY-A[1];
    VHDVS3IW_VALUES.DY-B[3] = VHDVS3IW_VALUES.DY-B[2] - VHDVS3IW_VALUES.DY-B[1];
    VHDVS3IW_VALUES.DY-C[3] = VHDVS3IW_VALUES.DY-C[2] - VHDVS3IW_VALUES.DY-C[1];
    VHDVS3IW_VALUES.DY-D[3] = VHDVS3IW_VALUES.DY-D[2] - VHDVS3IW_VALUES.DY-D[1];
    VHDVS3IW_VALUES.DY-E[3] = VHDVS3IW_VALUES.DY-E[2] - VHDVS3IW_VALUES.DY-E[1];
    VHDVS3IW_VALUES.DY-L[3] = VHDVS3IW_VALUES.DY-L[2] - VHDVS3IW_VALUES.DY-L[1];
    VHDVS3IW_VALUES.DY-M[3] = VHDVS3IW_VALUES.DY-M[2] - VHDVS3IW_VALUES.DY-M[1];
    VHDVS3IW_VALUES.DY-K[3] = VHDVS3IW_VALUES.DY-K[2] - VHDVS3IW_VALUES.DY-K[1];
    
    VHDVS3IW_VALUES.HY-A[3] = VHDVS3IW_VALUES.HY-A[2] - VHDVS3IW_VALUES.HY-A[1];
    VHDVS3IW_VALUES.HY-B[3] = VHDVS3IW_VALUES.HY-B[2] - VHDVS3IW_VALUES.HY-B[1];
    VHDVS3IW_VALUES.HY-C[3] = VHDVS3IW_VALUES.HY-C[2] - VHDVS3IW_VALUES.HY-C[1];
    VHDVS3IW_VALUES.HY-D[3] = VHDVS3IW_VALUES.HY-D[2] - VHDVS3IW_VALUES.HY-D[1];
    VHDVS3IW_VALUES.HY-E[3] = VHDVS3IW_VALUES.HY-E[2] - VHDVS3IW_VALUES.HY-E[1];
    VHDVS3IW_VALUES.HY-L[3] = VHDVS3IW_VALUES.HY-L[2] - VHDVS3IW_VALUES.HY-L[1];
    VHDVS3IW_VALUES.HY-M[3] = VHDVS3IW_VALUES.HY-M[2] - VHDVS3IW_VALUES.HY-M[1];
    VHDVS3IW_VALUES.HY-K[3] = VHDVS3IW_VALUES.HY-K[2] - VHDVS3IW_VALUES.HY-K[1];
    
    VHDVS3IW_VALUES.RY-A[3] = VHDVS3IW_VALUES.RY-A[2] - VHDVS3IW_VALUES.RY-A[1];       
    VHDVS3IW_VALUES.RY-B[3] = VHDVS3IW_VALUES.RY-B[2] - VHDVS3IW_VALUES.RY-B[1];
    VHDVS3IW_VALUES.RY-C[3] = VHDVS3IW_VALUES.RY-C[2] - VHDVS3IW_VALUES.RY-C[1];
    VHDVS3IW_VALUES.RY-D[3] = VHDVS3IW_VALUES.RY-D[2] - VHDVS3IW_VALUES.RY-D[1];
    VHDVS3IW_VALUES.RY-E[3] = VHDVS3IW_VALUES.RY-E[2] - VHDVS3IW_VALUES.RY-E[1]; 
    VHDVS3IW_VALUES.RY-L[3] = VHDVS3IW_VALUES.RY-L[2] - VHDVS3IW_VALUES.RY-L[1];
    VHDVS3IW_VALUES.RY-M[3] = VHDVS3IW_VALUES.RY-M[2] - VHDVS3IW_VALUES.RY-M[1];       
    VHDVS3IW_VALUES.RY-K[3] = VHDVS3IW_VALUES.RY-K[2] - VHDVS3IW_VALUES.RY-K[1]; 
         
    VHDVS3IW_VALUES.FLEET-A[3] = VHDVS3IW_VALUES.FLEET-A[2] - VHDVS3IW_VALUES.FLEET-A[1];
    VHDVS3IW_VALUES.FLEET-B[3] = VHDVS3IW_VALUES.FLEET-B[2] - VHDVS3IW_VALUES.FLEET-B[1];
    VHDVS3IW_VALUES.FLEET-C[3] = VHDVS3IW_VALUES.FLEET-C[2] - VHDVS3IW_VALUES.FLEET-C[1];
    VHDVS3IW_VALUES.FLEET-D[3] = VHDVS3IW_VALUES.FLEET-D[2] - VHDVS3IW_VALUES.FLEET-D[1];
    VHDVS3IW_VALUES.FLEET-E[3] = VHDVS3IW_VALUES.FLEET-E[2] - VHDVS3IW_VALUES.FLEET-E[1];
    VHDVS3IW_VALUES.FLEET-L[3] = VHDVS3IW_VALUES.FLEET-L[2] - VHDVS3IW_VALUES.FLEET-L[1];
    VHDVS3IW_VALUES.FLEET-M[3] = VHDVS3IW_VALUES.FLEET-M[2] - VHDVS3IW_VALUES.FLEET-M[1];    
    VHDVS3IW_VALUES.FLEET-K[3] = VHDVS3IW_VALUES.FLEET-K[2] - VHDVS3IW_VALUES.FLEET-K[1];
    VHDVS3IW_VALUES.FLEET-TOT[3] = VHDVS3IW_VALUES.FLEET-TOT[2] - VHDVS3IW_VALUES.FLEET-TOT[1];
end 

Function VHDVS1IS-AVAIL ()
  
  
   
    VHDVS2IW_VALUES.CY-RMV[3] = VHDVS2IW_VALUES.CY-RMV[2] - VHDVS2IW_VALUES.CY-RMV[1];
    VHDVS2IW_VALUES.DY-RMV[3] = VHDVS2IW_VALUES.DY-RMV[2] - VHDVS2IW_VALUES.DY-RMV[1];
    VHDVS2IW_VALUES.HY-RMV[3] = VHDVS2IW_VALUES.HY-RMV[2] - VHDVS2IW_VALUES.HY-RMV[1];
    VHDVS2IW_VALUES.RY-RMV[3] = VHDVS2IW_VALUES.RY-RMV[2] - VHDVS2IW_VALUES.RY-RMV[1];
    VHDVS2IW_VALUES.FLEET-TOT-RMV[3] = VHDVS2IW_VALUES.FLEET-TOT-RMV[2] - VHDVS2IW_VALUES.FLEET-TOT-RMV[1];

  

  
    VHDVS2IW_AVAIL.CY-GAIN = (VHDVS3IW_VALUES.CY-A[2] + VHDVS3IW_VALUES.CY-B[2] + VHDVS3IW_VALUES.CY-C[2] + VHDVS3IW_VALUES.CY-D[2] + 
    						  VHDVS3IW_VALUES.CY-E[2] + VHDVS3IW_VALUES.CY-L[2] + VHDVS3IW_VALUES.CY-M[2] + VHDVS3IW_VALUES.CY-K[2]) 
                           - (VHDVS1IW_VALUES.CY-A[1] + VHDVS1IW_VALUES.CY-B[1] + VHDVS1IW_VALUES.CY-C[1] + VHDVS1IW_VALUES.CY-D[1] + 
                              VHDVS1IW_VALUES.CY-E[1] + VHDVS1IW_VALUES.CY-L[1] + VHDVS1IW_VALUES.CY-M[1] + VHDVS1IW_VALUES.CY-K[1]);
    VHDVS2IW_AVAIL.DY-GAIN = (VHDVS3IW_VALUES.DY-A[2] + VHDVS3IW_VALUES.DY-B[2] + VHDVS3IW_VALUES.DY-C[2] + VHDVS3IW_VALUES.DY-D[2] + 
    						  VHDVS3IW_VALUES.DY-E[2] + VHDVS3IW_VALUES.DY-L[2] + VHDVS3IW_VALUES.DY-M[2] + VHDVS3IW_VALUES.DY-K[2]) 
                           - (VHDVS1IW_VALUES.DY-A[1] + VHDVS1IW_VALUES.DY-B[1] + VHDVS1IW_VALUES.DY-C[1] + VHDVS1IW_VALUES.DY-D[1] + 
                              VHDVS1IW_VALUES.DY-E[1] + VHDVS1IW_VALUES.DY-L[1] + VHDVS1IW_VALUES.DY-M[1] + VHDVS1IW_VALUES.DY-K[1]);
    VHDVS2IW_AVAIL.HY-GAIN = (VHDVS3IW_VALUES.HY-A[2] + VHDVS3IW_VALUES.HY-B[2] + VHDVS3IW_VALUES.HY-C[2] + VHDVS3IW_VALUES.HY-D[2] + 
    						  VHDVS3IW_VALUES.HY-E[2] + VHDVS3IW_VALUES.HY-L[2] + VHDVS3IW_VALUES.HY-M[2] + VHDVS3IW_VALUES.HY-K[2]) 
                           - (VHDVS1IW_VALUES.HY-A[1] + VHDVS1IW_VALUES.HY-B[1] + VHDVS1IW_VALUES.HY-C[1] + VHDVS1IW_VALUES.HY-D[1] + 
                              VHDVS1IW_VALUES.HY-E[1] + VHDVS1IW_VALUES.HY-L[1] + VHDVS1IW_VALUES.HY-M[1] + VHDVS1IW_VALUES.HY-K[1]);
    VHDVS2IW_AVAIL.RY-GAIN = (VHDVS3IW_VALUES.RY-A[2] + VHDVS3IW_VALUES.RY-B[2] + VHDVS3IW_VALUES.RY-C[2] + VHDVS3IW_VALUES.RY-D[2] + 
    						  VHDVS3IW_VALUES.RY-E[2] + VHDVS3IW_VALUES.RY-L[2] + VHDVS3IW_VALUES.RY-M[2] + VHDVS3IW_VALUES.RY-K[2]) 
                           - (VHDVS1IW_VALUES.RY-A[1] + VHDVS1IW_VALUES.RY-B[1] + VHDVS1IW_VALUES.RY-C[1] + VHDVS1IW_VALUES.RY-D[1] + 
                           	  VHDVS1IW_VALUES.RY-E[1] + VHDVS1IW_VALUES.RY-L[1] + VHDVS1IW_VALUES.RY-M[1] + VHDVS1IW_VALUES.RY-K[1]);
    VHDVS2IW_AVAIL.TOTAL-GAIN = (VHDVS2IW_AVAIL.CY-GAIN + VHDVS2IW_AVAIL.DY-GAIN + VHDVS2IW_AVAIL.HY-GAIN + VHDVS2IW_AVAIL.RY-GAIN);
end 

Function VHDVS1IS-CAL-FAIL ()
  
  
  
  
   

    VAGen_COUNT = 1;
    while (VAGen_COUNT <= VHDVS1IW-TRIGGERS.UROWCNT)
        if (VHDVS01_DATA.YRD[VAGen_COUNT] == "CY")
            if ( VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS1I_FAIL.CY-A[1] = VHDVS1I_FAIL.CY-A[1] + VHDVS01_DATA.CNT-CARS-SHOP-WAR[VAGen_COUNT];
                VHDVS1I_FAIL.CY-A[2] = VHDVS1I_FAIL.CY-A[2] + VHDVS01_DATA.CNT-CARS-ML-FAIL[VAGen_COUNT];
                VHDVS1I_FAIL.CY-A[3] = VHDVS1I_FAIL.CY-A[3] + VHDVS01_DATA.CNT-CARS-YRD-FAIL[VAGen_COUNT];
                VHDVS1I_FAIL.CY-A[4] = VHDVS1I_FAIL.CY-A[4] + VHDVS01_DATA.CNT-CARS-SHOP-PM[VAGen_COUNT];
                VHDVS1I_FAIL.CY-A[5] = VHDVS1I_FAIL.CY-A[5] + VHDVS01_DATA.CNT-CARS-SHOP-MOD[VAGen_COUNT];
                VHDVS1I_FAIL.CY-A[6] = VHDVS1I_FAIL.CY-A[6] + VHDVS01_DATA.CNT-CARS-SHOP-MISC[VAGen_COUNT];
                VHDVS1I_FAIL.CY-A[7] = VHDVS1I_FAIL.CY-A[1] + VHDVS1I_FAIL.CY-A[2] + VHDVS1I_FAIL.CY-A[3] + VHDVS1I_FAIL.CY-A[4] + VHDVS1I_FAIL.CY-A[5] + VHDVS1I_FAIL.CY-A[6];
            end 
            if ( VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
                VHDVS1I_FAIL.CY-B[1] = VHDVS1I_FAIL.CY-B[1] + VHDVS01_DATA.CNT-CARS-SHOP-WAR[VAGen_COUNT];
                VHDVS1I_FAIL.CY-B[2] = VHDVS1I_FAIL.CY-B[2] + VHDVS01_DATA.CNT-CARS-ML-FAIL[VAGen_COUNT];
                VHDVS1I_FAIL.CY-B[3] = VHDVS1I_FAIL.CY-B[3] + VHDVS01_DATA.CNT-CARS-YRD-FAIL[VAGen_COUNT];
                VHDVS1I_FAIL.CY-B[4] = VHDVS1I_FAIL.CY-B[4] + VHDVS01_DATA.CNT-CARS-SHOP-PM[VAGen_COUNT];
                VHDVS1I_FAIL.CY-B[5] = VHDVS1I_FAIL.CY-B[5] + VHDVS01_DATA.CNT-CARS-SHOP-MOD[VAGen_COUNT];
                VHDVS1I_FAIL.CY-B[6] = VHDVS1I_FAIL.CY-B[6] + VHDVS01_DATA.CNT-CARS-SHOP-MISC[VAGen_COUNT];
                VHDVS1I_FAIL.CY-B[7] = VHDVS1I_FAIL.CY-B[1] + VHDVS1I_FAIL.CY-B[2] + VHDVS1I_FAIL.CY-B[3] + VHDVS1I_FAIL.CY-B[4] + VHDVS1I_FAIL.CY-B[5] + VHDVS1I_FAIL.CY-B[6];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C1" || VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "C2")
                VHDVS1I_FAIL.CY-C[1] = VHDVS1I_FAIL.CY-C[1] + VHDVS01_DATA.CNT-CARS-SHOP-WAR[VAGen_COUNT];
                VHDVS1I_FAIL.CY-C[2] = VHDVS1I_FAIL.CY-C[2] + VHDVS01_DATA.CNT-CARS-ML-FAIL[VAGen_COUNT];
                VHDVS1I_FAIL.CY-C[3] = VHDVS1I_FAIL.CY-C[3] + VHDVS01_DATA.CNT-CARS-YRD-FAIL[VAGen_COUNT];
                VHDVS1I_FAIL.CY-C[4] = VHDVS1I_FAIL.CY-C[4] + VHDVS01_DATA.CNT-CARS-SHOP-PM[VAGen_COUNT];
                VHDVS1I_FAIL.CY-C[5] = VHDVS1I_FAIL.CY-C[5] + VHDVS01_DATA.CNT-CARS-SHOP-MOD[VAGen_COUNT];
                VHDVS1I_FAIL.CY-C[6] = VHDVS1I_FAIL.CY-C[6] + VHDVS01_DATA.CNT-CARS-SHOP-MISC[VAGen_COUNT];
                VHDVS1I_FAIL.CY-C[7] = VHDVS1I_FAIL.CY-C[1] + VHDVS1I_FAIL.CY-C[2] + VHDVS1I_FAIL.CY-C[3] + VHDVS1I_FAIL.CY-C[4] + VHDVS1I_FAIL.CY-C[5] + VHDVS1I_FAIL.CY-C[6];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "D1")
                VHDVS1I_FAIL.CY-D[1] = VHDVS1I_FAIL.CY-D[1] + VHDVS01_DATA.CNT-CARS-SHOP-WAR[VAGen_COUNT];
                VHDVS1I_FAIL.CY-D[2] = VHDVS1I_FAIL.CY-D[2] + VHDVS01_DATA.CNT-CARS-ML-FAIL[VAGen_COUNT];
                VHDVS1I_FAIL.CY-D[3] = VHDVS1I_FAIL.CY-D[3] + VHDVS01_DATA.CNT-CARS-YRD-FAIL[VAGen_COUNT];
                VHDVS1I_FAIL.CY-D[4] = VHDVS1I_FAIL.CY-D[4] + VHDVS01_DATA.CNT-CARS-SHOP-PM[VAGen_COUNT];
                VHDVS1I_FAIL.CY-D[5] = VHDVS1I_FAIL.CY-D[5] + VHDVS01_DATA.CNT-CARS-SHOP-MOD[VAGen_COUNT];
                VHDVS1I_FAIL.CY-D[6] = VHDVS1I_FAIL.CY-D[6] + VHDVS01_DATA.CNT-CARS-SHOP-MISC[VAGen_COUNT];
                VHDVS1I_FAIL.CY-D[7] = VHDVS1I_FAIL.CY-D[1] + VHDVS1I_FAIL.CY-D[2] + VHDVS1I_FAIL.CY-D[3] + VHDVS1I_FAIL.CY-D[4] + VHDVS1I_FAIL.CY-D[5] + VHDVS1I_FAIL.CY-D[6];
            end 
            if (VHDVS01_DATA.CAR-TYPE[VAGen_COUNT] == "E1")
                VHDVS1I_FAIL.CY-E[1] = VHDVS1I_FAIL.CY-E[1] + VHDVS01_DATA.CNT-CARS-SHOP-WAR[VAGen_COUNT];
                VHDVS1I_FAIL.CY-E[2] = VHDVS1I_FAIL.CY-E[2] + VHDVS01_DATA.CNT-CARS-ML-FAIL[VAGen_COUNT];
                VHDVS1I_FAIL.CY-E[3] = VHDVS1I_FAIL.CY-E[3] + VHDVS01_DATA.CNT-CARS-YRD-FAIL[VAGen_COUNT];
                VHDVS1I_FAIL.CY-E[4] = VHDVS1I_FAIL.CY-E[4] + VHDVS01_DATA.CNT-CARS-SHOP-PM[VAGen_COUNT];
