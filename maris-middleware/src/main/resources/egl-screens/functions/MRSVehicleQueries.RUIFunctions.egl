end 

Function VHYS01IS-CHK-SEL ()
  
  
   
    FINAL-ERROR-MESSAGE = " ";
    ERROR = "N";
    if ((VHYS01IW.HOME-YARD-BASE == 1 &&
     VHYS01IW.HOME-YARD-STATUS == 0 &&
     VHYS01IW.HOME-YARD-NOGO == 0 &&
     VHYS01IW.HOME-YARD-SUMMARY == 0))
  		
        if (YARD-BASE in VHYS01A_DATA.YRD)

        else
            FINAL-ERROR-MESSAGE = "You Have Entered an Invalid Yard";
            INVALID-YARD = "Y";
            ERROR = "Y";
        end
  		
        if (YARD-BASE == " ")
            FINAL-ERROR-MESSAGE = "You Have Entered an Invalid Yard.";
            INVALID-YARD = "Y";
            ERROR = "Y";
        else
            if (NARR-IND-BASE == " ")
                FINAL-ERROR-MESSAGE = "Invalid Response for Narr.";
                INVALID-NARR-IND = "Y";
                ERROR = "Y";
            else
  				

            end
        end
    else
        if ((VHYS01IW.HOME-YARD-BASE == 0 &&
         VHYS01IW.HOME-YARD-STATUS == 1 &&
         VHYS01IW.HOME-YARD-NOGO == 0 &&
         VHYS01IW.HOME-YARD-SUMMARY == 0))
  			
            if (YARD-STATUS in VHYS01A_DATA.YRD)

            else
                FINAL-ERROR-MESSAGE = "You Have Entered an Invalid Yard";
                INVALID-YARD = "Y";
                ERROR = "Y";
            end
  			
            if (VHYS01IW.VEH-STATUS in VHYS01B_DATA.VEH-STAT)

            else
                FINAL-ERROR-MESSAGE = "Invalid Vehicle Status Entered";
                INVALID-VEHSTAT = "Y";
                ERROR = "Y";
            end

  			
            if (YARD-STATUS == " ")
                FINAL-ERROR-MESSAGE = "You Have Entered an Invalid Yard";
                INVALID-YARD = "Y";
                ERROR = "Y";
            else
                if (VHYS01IW.VEH-STATUS == " ")
                    FINAL-ERROR-MESSAGE = "Invalid Status.";
                    INVALID-VEHSTAT = "Y";
                    ERROR = "Y";
                else
                    if (NARR-IND-STATUS == " ")
                        FINAL-ERROR-MESSAGE = "Invalid Response for Narr.";
                        INVALID-NARR-IND = "Y";
                        ERROR = "Y";
                    else
  						

                    end
                end
            end
        else
            if ((VHYS01IW.HOME-YARD-BASE == 0 &&
             VHYS01IW.HOME-YARD-STATUS == 0 &&
             VHYS01IW.HOME-YARD-NOGO == 1 &&
             VHYS01IW.HOME-YARD-SUMMARY == 0))
  				
                if (YARD-NOGO in VHYS01A_DATA.YRD)

                else
                    FINAL-ERROR-MESSAGE = "You Have Entered an Invalid Yard";
                    INVALID-YARD = "Y";
                    ERROR = "Y";
                end
 				 
                if (YARD-NOGO == " ")
                    FINAL-ERROR-MESSAGE = "You Have Entered Invalid Yard.";
                    INVALID-YARD = "Y";
                    ERROR = "Y";
                else
  					

                end
            else
                if ((VHYS01IW.HOME-YARD-BASE == 0 &&
                 VHYS01IW.HOME-YARD-STATUS == 0 &&
                 VHYS01IW.HOME-YARD-NOGO == 0 &&
                 VHYS01IW.HOME-YARD-SUMMARY == 1))
  					
                    if (YARD-SUMMARY in VHYS01A_DATA.YRD)

                    else
                        FINAL-ERROR-MESSAGE = "Invalid Yard. or Locatiion";
                        INVALID-YARD = "Y";
                        ERROR = "Y";
                    end
                    if (YARD-SUMMARY == " ")
                        FINAL-ERROR-MESSAGE = "Invalid Yard.";
                        INVALID-YARD = "Y";
                        ERROR = "Y";
                    else
  						

                    end
                else
                    FINAL-ERROR-MESSAGE = "Please Selection One Report Option.";
                    VHYS01IW-TRIGGER.SELECT-ONE = 1;
                    ERROR = "Y";
                end
            end
        end
    end

  
    if (VHYS01IW.CAR-NO-FROM == "   ")
        VHYS01IW.CAR-NO-FROM = "0096";
    end
    if (VHYS01IW.CAR-NO-TO == "   ")
        VHYS01IW.CAR-NO-TO = "5000";
    end
    if (VHYS01IW.CAR-NO-TO < VHYS01IW.CAR-NO-FROM)
        ERROR = "Y";
        FINAL-ERROR-MESSAGE = "The TO CAR cannot be less than the FROM CAR";
    end

    
    if (ERROR == "N")
        NO-ERROR = "Y";
    end
end 

Function VHYS01IS-CHK-SEL-X () 
    SELECT-ONE-X = " ";
    FINAL-ERROR-MESSAGE = " ";
    VHYS01IW-TRIGGER.SELECT-ONE-X = " ";
    ERROR-X = " ";
    if (VHYS01IW.HOME-YARD-BASE != 1 &&
     VHYS01IW.HOME-YARD-NOGO != 1 &&
     VHYS01IW.HOME-YARD-STATUS != 1 &&
     VHYS01IW.HOME-YARD-SUMMARY != 1)
        FINAL-ERROR-MESSAGE = " INVALID SELECTION ";
        ERROR-X = "Y";
        return;
    end
    if ((VHYS01IW.HOME-YARD-BASE == 1 &&
     VHYS01IW.HOME-YARD-STATUS == 0 &&
     VHYS01IW.HOME-YARD-NOGO == 0 &&
     VHYS01IW.HOME-YARD-SUMMARY == 0))
        if (YARD-BASE == " ")
            FINAL-ERROR-MESSAGE = "You Have Entered an Invalid Yard";
            INVALID-YARD = "Y";
            ERROR-X = "Y";
        else
            if (NARR-IND-BASE == " ")
                FINAL-ERROR-MESSAGE = "Invalid Response for Narr.";
                INVALID-NARR-IND = "Y";
                ERROR-X = "Y";
            end
        end
    else
        if ((VHYS01IW.HOME-YARD-BASE == 0 &&
         VHYS01IW.HOME-YARD-STATUS == 1 &&
         VHYS01IW.HOME-YARD-NOGO == 0 &&
         VHYS01IW.HOME-YARD-SUMMARY == 0))
            if (YARD-STATUS == " ")
                FINAL-ERROR-MESSAGE = "You Have Entered an Invalid Yard";
                INVALID-YARD = "Y";
                ERROR-X = "Y";
            else
                if (VHYS01IW.VEH-STATUS == " ")
                    FINAL-ERROR-MESSAGE = "Invalid Vehicle Status Entered";
                    INVALID-VEHSTAT = "Y";
                    ERROR-X = "Y";
                else
                    if (NARR-IND-STATUS == " ")
                        FINAL-ERROR-MESSAGE = "Invalid Response for Narr.";
                        INVALID-NARR-IND = "Y";
                        ERROR-X = "Y";
                    end
                end
            end
        else
            if ((VHYS01IW.HOME-YARD-BASE == 0 &&
             VHYS01IW.HOME-YARD-STATUS == 0 &&
             VHYS01IW.HOME-YARD-NOGO == 1 &&
             VHYS01IW.HOME-YARD-SUMMARY == 0))
                if (YARD-NOGO == " ")
                    FINAL-ERROR-MESSAGE = "You Have Entered an Invalid Yard";
                    INVALID-YARD = "Y";
                    ERROR-X = "Y";
                end
            else
                if ((VHYS01IW.HOME-YARD-BASE == 0 &&
                 VHYS01IW.HOME-YARD-STATUS == 0 &&
                 VHYS01IW.HOME-YARD-NOGO == 0 &&
                 VHYS01IW.HOME-YARD-SUMMARY == 1))
                    if (YARD-SUMMARY == " ")
                        FINAL-ERROR-MESSAGE = "You Have Entered an Invalid Yard";
                        INVALID-YARD = "Y";
                        ERROR-X = "Y";
                    end
                else
                    VHYS01IW-TRIGGER.SELECT-ONE = "1";
                    
  					
                end
            end
        end
    end
    if (ERROR-X == "  ")
        VHYS01IW-TRIGGER.SELECT-ONE-X = "1";
    end
end 

Function VHYS01IS-CLEAR () 
    set VHYS01IW empty;
    set VHYS01IW-MSG empty;
end 

Function VHYS01IS-CLEAR-X () 
    set VHYS01IW empty;
end 

Function VHYS01IS-HARD-COPY () 
    if (VHYS01IW.HOME-YARD-BASE != 1 &&
     VHYS01IW.HOME-YARD-NOGO != 1 &&
     VHYS01IW.HOME-YARD-STATUS != 1 &&
     VHYS01IW.HOME-YARD-SUMMARY != 1)
        DISABLE-HARD = "Y";
    else
        if (PRT-IDX > 0)
            ENABLE-HARD = "Y";
            VHYS01IW-PASSVALUE.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRT-IDX];
        else
            DISABLE-HARD = "Y";
        end
    end
end 

