    CAR-RYL-DATA[6] = PREVEN-MAIN-L;
    CAR-RYM-DATA[6] = PREVEN-MAIN-M;
    CAR-RYK-DATA[6] = PREVEN-MAIN-K;
    CAR-RYTOTAL-DATA[6] = PREVEN-MAIN-T;

  

  
    CAR-RYA-DATA[7] = WARRANTY-A;
    CAR-RYB-DATA[7] = WARRANTY-B;
    CAR-RYC-DATA[7] = WARRANTY-C;
    CAR-RYD-DATA[7] = WARRANTY-D;
    CAR-RYE-DATA[7] = WARRANTY-E;
    CAR-RYL-DATA[7] = WARRANTY-L;
    CAR-RYM-DATA[7] = WARRANTY-M;
    CAR-RYK-DATA[7] = WARRANTY-K;
    CAR-RYTOTAL-DATA[7] = WARRANTY-T;


  
    CAR-RYA-DATA[8] = ENGRNG-HOLD-A;
    CAR-RYB-DATA[8] = ENGRNG-HOLD-B;
    CAR-RYC-DATA[8] = ENGRNG-HOLD-C;
    CAR-RYD-DATA[8] = ENGRNG-HOLD-D;
    CAR-RYE-DATA[8] = ENGRNG-HOLD-E;
    CAR-RYL-DATA[8] = ENGRNG-HOLD-L;
    CAR-RYM-DATA[8] = ENGRNG-HOLD-M;
    CAR-RYK-DATA[8] = ENGRNG-HOLD-K;    
    CAR-RYTOTAL-DATA[8] = ENGRNG-HOLD-T;

  
    CAR-RYA-DATA[9] = MODIFY-CARS-A;
    CAR-RYB-DATA[9] = MODIFY-CARS-B;
    CAR-RYC-DATA[9] = MODIFY-CARS-C;
    CAR-RYD-DATA[9] = MODIFY-CARS-D;
    CAR-RYE-DATA[9] = MODIFY-CARS-E;
    CAR-RYL-DATA[9] = MODIFY-CARS-L;
    CAR-RYM-DATA[9] = MODIFY-CARS-M;
    CAR-RYK-DATA[9] = MODIFY-CARS-K;
    CAR-RYTOTAL-DATA[9] = MODIFY-CARS-T;

  
    CAR-RYA-DATA[10] = MISCEL-HOLD-A;
    CAR-RYB-DATA[10] = MISCEL-HOLD-B;
    CAR-RYC-DATA[10] = MISCEL-HOLD-C;
    CAR-RYD-DATA[10] = MISCEL-HOLD-D;
    CAR-RYE-DATA[10] = MISCEL-HOLD-E;
    CAR-RYL-DATA[10] = MISCEL-HOLD-L;
    CAR-RYM-DATA[10] = MISCEL-HOLD-M;
    CAR-RYK-DATA[10] = MISCEL-HOLD-K;
    CAR-RYTOTAL-DATA[10] = MISCEL-HOLD-T;

  
    CAR-RYA-DATA[11] = UNSCHD-MAIN-A + WAITPART-UM-A + PREVEN-MAIN-A + WARRANTY-A + ENGRNG-HOLD-A + MODIFY-CARS-A + MISCEL-HOLD-A;
    CAR-RYB-DATA[11] = UNSCHD-MAIN-B + WAITPART-UM-B + PREVEN-MAIN-B + WARRANTY-B + ENGRNG-HOLD-B + MODIFY-CARS-B + MISCEL-HOLD-B;
    CAR-RYC-DATA[11] = UNSCHD-MAIN-C + WAITPART-UM-C + PREVEN-MAIN-C + WARRANTY-C + ENGRNG-HOLD-C + MODIFY-CARS-C + MISCEL-HOLD-C;
    CAR-RYD-DATA[11] = UNSCHD-MAIN-D + WAITPART-UM-D + PREVEN-MAIN-D + WARRANTY-D + ENGRNG-HOLD-D + MODIFY-CARS-D + MISCEL-HOLD-D;
    CAR-RYE-DATA[11] = UNSCHD-MAIN-E + WAITPART-UM-E + PREVEN-MAIN-E + WARRANTY-E + ENGRNG-HOLD-E + MODIFY-CARS-E + MISCEL-HOLD-E;
    CAR-RYL-DATA[11] = UNSCHD-MAIN-L + WAITPART-UM-L + PREVEN-MAIN-L + WARRANTY-L + ENGRNG-HOLD-L + MODIFY-CARS-L + MISCEL-HOLD-L;
    CAR-RYM-DATA[11] = UNSCHD-MAIN-M + WAITPART-UM-M + PREVEN-MAIN-M + WARRANTY-M + ENGRNG-HOLD-M + MODIFY-CARS-M + MISCEL-HOLD-M;
    CAR-RYK-DATA[11] = UNSCHD-MAIN-K + WAITPART-UM-K + PREVEN-MAIN-K + WARRANTY-K + ENGRNG-HOLD-K + MODIFY-CARS-K + MISCEL-HOLD-K;    
    CAR-RYTOTAL-DATA[11] = UNSCHD-MAIN-T + WAITPART-UM-T + PREVEN-MAIN-T + WARRANTY-T + ENGRNG-HOLD-T + MODIFY-CARS-T + MISCEL-HOLD-T;

  
  
    CAR-RYA-DATA[15] = TOTAL-REQD-A;
    CAR-RYB-DATA[15] = TOTAL-REQD-B;
    CAR-RYC-DATA[15] = TOTAL-REQD-C;
    CAR-RYD-DATA[15] = TOTAL-REQD-D;
    CAR-RYE-DATA[15] = TOTAL-REQD-E;
    CAR-RYL-DATA[15] = TOTAL-REQD-L;
    CAR-RYM-DATA[15] = TOTAL-REQD-M;
    CAR-RYK-DATA[15] = TOTAL-REQD-K;    
    CAR-RYTOTAL-DATA[15] = TOTAL-REQD-T;


  
    CAR-RYA-DATA[16] = CAR-RYA-DATA[3] - CAR-RYA-DATA[11];
    CAR-RYB-DATA[16] = CAR-RYB-DATA[3] - CAR-RYB-DATA[11];
    CAR-RYC-DATA[16] = CAR-RYC-DATA[3] - CAR-RYC-DATA[11];
    CAR-RYD-DATA[16] = CAR-RYD-DATA[3] - CAR-RYD-DATA[11];
    CAR-RYE-DATA[16] = CAR-RYE-DATA[3] - CAR-RYE-DATA[11];
    CAR-RYL-DATA[16] = CAR-RYL-DATA[3] - CAR-RYL-DATA[11];
    CAR-RYM-DATA[16] = CAR-RYM-DATA[3] - CAR-RYM-DATA[11];
    CAR-RYK-DATA[16] = CAR-RYK-DATA[3] - CAR-RYK-DATA[11];
    CAR-RYTOTAL-DATA[16] = CAR-RYTOTAL-DATA[3] - CAR-RYTOTAL-DATA[11];

  
    CAR-RYA-DATA[17] = REV-SERVICE-A;
    CAR-RYB-DATA[17] = REV-SERVICE-B;
    CAR-RYC-DATA[17] = REV-SERVICE-C;
    CAR-RYD-DATA[17] = REV-SERVICE-D;
    CAR-RYE-DATA[17] = REV-SERVICE-E;
    CAR-RYL-DATA[17] = REV-SERVICE-L;
    CAR-RYM-DATA[17] = REV-SERVICE-M;
    CAR-RYK-DATA[17] = REV-SERVICE-K;    
    CAR-RYTOTAL-DATA[17] = REV-SERVICE-T;

  
    CAR-RYA-DATA[18] = GO-AVAIL-A;
    CAR-RYB-DATA[18] = GO-AVAIL-B;
    CAR-RYC-DATA[18] = GO-AVAIL-C;
    CAR-RYD-DATA[18] = GO-AVAIL-D;
    CAR-RYE-DATA[18] = GO-AVAIL-E;
    CAR-RYL-DATA[18] = GO-AVAIL-L;
    CAR-RYM-DATA[18] = GO-AVAIL-M;
    CAR-RYK-DATA[18] = GO-AVAIL-K;
    CAR-RYTOTAL-DATA[18] = GO-AVAIL-T;
end 

Function VHHF01IS-REQD-CHK () 
    LOOP-INDEX = 1;
    TOTAL-REQD-A = 0;
    TOTAL-REQD-B = 0;
    TOTAL-REQD-C = 0;
    TOTAL-REQD-D = 0;
    TOTAL-REQD-E = 0;
    TOTAL-REQD-L = 0;
    TOTAL-REQD-M = 0;
    TOTAL-REQD-K = 0;
    TOTAL-REQD-T = 0;
    while ((LOOP-INDEX <= VHHF01IW.REQD-COUNT))
        if (VHHF01B_DATA.CAR-TYPE-1[LOOP-INDEX] == "A")
            TOTAL-REQD-A = TOTAL-REQD-A + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
            TOTAL-REQD-T = TOTAL-REQD-T + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
        else
            if (VHHF01B_DATA.CAR-TYPE-1[LOOP-INDEX] == "B")
                TOTAL-REQD-B = TOTAL-REQD-B + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
                TOTAL-REQD-T = TOTAL-REQD-T + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
            else
                if (VHHF01B_DATA.CAR-TYPE-1[LOOP-INDEX] == "C")
                    TOTAL-REQD-C = TOTAL-REQD-C + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
                    TOTAL-REQD-T = TOTAL-REQD-T + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
                else
                	if (VHHF01B_DATA.CAR-TYPE-1[LOOP-INDEX] == "D")
                    	TOTAL-REQD-D = TOTAL-REQD-D + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
                    	TOTAL-REQD-T = TOTAL-REQD-T + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
                    else
	                	if (VHHF01B_DATA.CAR-TYPE-1[LOOP-INDEX] == "E")
	                    	TOTAL-REQD-E = TOTAL-REQD-E + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
	                    	TOTAL-REQD-T = TOTAL-REQD-T + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];	
	                    else    
		                   	if (VHHF01B_DATA.CAR-TYPE-1[LOOP-INDEX] == "L")
		                     	TOTAL-REQD-L = TOTAL-REQD-L + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
		                     	TOTAL-REQD-T = TOTAL-REQD-T + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];	
		                     else
		                     		if (VHHF01B_DATA.CAR-TYPE-1[LOOP-INDEX] == "M")
		                     		TOTAL-REQD-M = TOTAL-REQD-M + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
		                     		TOTAL-REQD-T = TOTAL-REQD-T + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];	
		                     		else 
		                     			if (VHHF01B_DATA.CAR-TYPE-1[LOOP-INDEX] == "K")
		                     				TOTAL-REQD-K = TOTAL-REQD-K + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
		                     				TOTAL-REQD-T = TOTAL-REQD-T + VHHF01B_DATA.CNT-CARS-REQD[LOOP-INDEX];
		                     			end	
		                     		end 
		                     end  
		                end                	
                	end
                end                 
            end
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
end 

Function VHHF01IS-TYPE-A () 
    TOTAL-FLEET-A = TOTAL-FLEET-A + 1;
    TOTAL-FLEET-T = TOTAL-FLEET-T + 1;
    if (VHHF01A_DATA.VEH-STAT[LOOP-INDEX] == "STOR" ||
     VHHF01A_DATA.VEH-STAT[LOOP-INDEX] == "SAFETY" ||
     VHHF01A_DATA.VEH-STAT[LOOP-INDEX] == "ACIDNT" ||
     VHHF01A_DATA.VEH-STAT[LOOP-INDEX] == "TEST")
        HOLD-CARS-A = HOLD-CARS-A + 1;
        HOLD-CARS-T = HOLD-CARS-T + 1;
    else
        if (VHHF01A_DATA.WHERE-IS-CAR[LOOP-INDEX] == "CON")
            REV-SERVICE-A = REV-SERVICE-A + 1;
            REV-SERVICE-T = REV-SERVICE-T + 1;
        else
            TOTAL-MAINT-A = TOTAL-MAINT-A + 1;
            TOTAL-MAINT-T = TOTAL-MAINT-T + 1;
            if (VHHF01A_DATA.WAR-IND[LOOP-INDEX] == "Y" &&
             VHHF01A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                WARRANTY-A = WARRANTY-A + 1;
                WARRANTY-T = WARRANTY-T + 1;
            else
                if (VHHF01A_DATA.WAR-IND[LOOP-INDEX] == "N" &&
                 VHHF01A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                    UNSCHD-MAIN-A = UNSCHD-MAIN-A + 1;
                    UNSCHD-MAIN-T = UNSCHD-MAIN-T + 1;
                else
                    if (VHHF01A_DATA.VEH-STAT[LOOP-INDEX] == "AWPART") 
                    else
                        if (VHHF01A_DATA.VEH-STAT[LOOP-INDEX] == "PM")
                            PREVEN-MAIN-A = PREVEN-MAIN-A + 1;
                            PREVEN-MAIN-T = PREVEN-MAIN-T + 1;
                        else
                            if (VHHF01A_DATA.VEH-STAT[LOOP-INDEX] == "ENGHLD")
                                ENGRNG-HOLD-A = ENGRNG-HOLD-A + 1;
                                ENGRNG-HOLD-T = ENGRNG-HOLD-T + 1;
                            else
                                if (VHHF01A_DATA.VEH-STAT[LOOP-INDEX] == "MODHLD")
                                    MODIFY-CARS-A = MODIFY-CARS-A + 1;
                                    MODIFY-CARS-T = MODIFY-CARS-T + 1;
                                else
                                    if (VHHF01A_DATA.VEH-STAT[LOOP-INDEX] == "MISC")
                                        MISCEL-HOLD-A = MISCEL-HOLD-A + 1;
                                        MISCEL-HOLD-T = MISCEL-HOLD-T + 1;
                                    else
                                        TOTAL-MAINT-A = TOTAL-MAINT-A - 1;
                                        TOTAL-MAINT-T = TOTAL-MAINT-T - 1;
                                        if (VHHF01A_DATA.VEH-STAT[LOOP-INDEX] != "GO" &&
                                         VHHF01A_DATA.VEH-STAT[LOOP-INDEX] != "USABLE" &&
                                         VHHF01A_DATA.VEH-STAT[LOOP-INDEX] != "ERROR")
                                            TOTAL-FLEET-A = TOTAL-FLEET-A - 1;
                                            TOTAL-FLEET-T = TOTAL-FLEET-T - 1;
                                        else
                                            GO-AVAIL-A = GO-AVAIL-A + 1;
                                            GO-AVAIL-T = GO-AVAIL-T + 1;
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

