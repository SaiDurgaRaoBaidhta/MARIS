Function VHMR01IS-INIT () 
    VHMR01IW.WS-CURRENT-DATE = VGVar.currentFormattedGregorianDate;
    try
        call "VHMR01A"(XDCONTROL, VHMR01A_CRIT, VHMR01A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHMR01IW.FROM-DATE = VHMR01A_DATA.FROM-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHMR01IW.FROM-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHMR01IW.FROM-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHMR01IW.FROM-DATE-FILLER1 = "-";
        VHMR01IW.FROM-DATE-FILLER2 = "-";
    end
