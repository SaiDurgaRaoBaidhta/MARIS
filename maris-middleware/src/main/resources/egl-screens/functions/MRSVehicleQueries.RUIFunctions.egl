Function VHYT0TIS-INIT-Y () 
    VHYTOTIW.YRD-COUNTER = 1;
    VHYTOTIW.FOUND-SW = "N";
    while (VHYTOTIW.YRD-COUNTER <= VHYTOTA_CRIT.COUNTER)
        if (VHYTOTIW.YRD-TRKG-YRD == VHYTOTA_DATA.YRD-TRKG-YRD[YRD-COUNTER])
  
            VHYTOTIW.FOUND-SW = "Y";
            return;
        end
        YRD-COUNTER = YRD-COUNTER + 1;
    end
    if (FOUND-SW == "N")
        YRD-COUNTER = 1;
    end
end 

Function VHYTOTIS-CLEAR () 
    VHYTOTI_MESSAGE.MESG1 = "                                                                                   ";
    VHYTOTI_MESSAGE.MESG2 = "                                                                                   ";
    VHYTOTI_MESSAGE.MESG3 = "                                                                                   ";
end 

Function VHYTOTIS-HARD-COPY () 
    if (VHYTOTIW-TRIGGER.PRX-ID > 0)
        WS100IW-TRIGGER_Level77Items.ENABLE-HARD = "Y";
        VHYTOTIW-TRIGGER.VTAM-NAME = WS70A01_DATA.VTAM-NAME[VHYTOTIW-TRIGGER.PRX-ID];
    else
        WS100IW-TRIGGER_Level77Items.DISABLE-HARD = "Y";
    end
end 

Function VHYTOTIS-INIT ()

   
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYTOTA";
    try
        call "VHYTOTA"(XDCONTROL, VHYTOTA_CRIT, VHYTOTA_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYTOTA_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
  
  
  
    VHYTOTI_MESSAGE.MESG1 = "                                                                                   ";
    VHYTOTI_MESSAGE.MESG2 = "                                                                                   ";
    VHYTOTI_MESSAGE.MESG3 = "                                                                                   ";
end 

Function VHYTOTIS-INIT-X ()
  
  
  
  
  
  
  
  


  	 
    XXEXT_CALL_Level77Items.UEXTNAM = "WS100I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS70A01";

    
    try
        call "WS70A01"(XDCONTROL, WS70A01_DATA);
    
    end
    

  	
    MRSCommonCode.XXA0IS-CHECK_EXT();

  	
    if (XXEXT_CALL_Level77Items.URC == 0)
  	
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
		  
		  
		  
		  
            VHYTOTI_MESSAGE.MESG1 = "INVALID PRINTER";
        end
    end
end 

Function VHYTOTIS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  

  
  
  
   
    if (VHYTOTIW-TRIGGER.OK-SUBMIT == "Y")
        VHYTOTB_CRIT.YRD = VHYTOTIW.YRD;
        VHYTOTB_CRIT.REPT-ID = VHYTOTIW-TRIGGER.VTAM-NAME;

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYTOTI";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYTOTD";

    
        try
            call "VHYTOTB"(XDCONTROL, VHYTOTB_CRIT, VHYTOTB_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
                VHYTOTIW-TRIGGER.SUBMIT = "Y";
            else

        


        
    
    
    
    
                VHYTOTI_MESSAGE.MESG1 = "INVALID PARAMETER LIST";
            end
        else

        end
    end
end 

Function VHYTOTIS-SUBMIT-X () 
    VHYTOTIW-TRIGGER.OK-SUBMIT = "Y";
    VHYTOTIW.NULL-TO-ERROR = "N";
    if (VHYTOTIW.YRD == "   ")
        VHYTOTI_MESSAGE.MESG1 = "INVALID YARD SELECTION";
        VHYTOTIW.INVALID-YRD = "Y";
        AFCXVLDW.NO-ERROR = "N";
    end
    if (VHYTOTIW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHYTOTIW-TRIGGER.INVALID-SYMP-TO == "Y")
            VHYTOTIW-TRIGGER.OK-SUBMIT = "N";
        else
            if (VHYTOTIW-TRIGGER.INVALID-SYMP-FROM == "Y")
                VHYTOTIW-TRIGGER.OK-SUBMIT = "N";
            else
  
  
  
                if (AFCXVLDW.NO-ERROR == "N")
                    VHYTOTIW-TRIGGER.OK-SUBMIT = " ";
                else
                    VHYTOTIW-TRIGGER.OK-SUBMIT = "Y ";
                end
            end
        end
    end
end
