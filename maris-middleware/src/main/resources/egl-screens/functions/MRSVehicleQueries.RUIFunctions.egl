Function VHDVS1IS-OOS ()
  

  

  
  
  
   
    VAGen_COUNT = 1;
  
    while (VAGen_COUNT <= VHDVS1IW-TRIGGERS.UROWCNT)
        if (VHDVS02_DATA.YRD[VAGen_COUNT] == "CY")
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "A1" ||
             VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "A2")
                VHDVS3I_FLEET.CY-A[1] = VHDVS3I_FLEET.CY-A[1] + VHDVS02_DATA.CNT-CARS-OOS-ENGR[VAGen_COUNT];
                VHDVS3I_FLEET.CY-A[2] = VHDVS3I_FLEET.CY-A[2] + VHDVS02_DATA.CNT-CARS-OOS-AWP[VAGen_COUNT];
                VHDVS3I_FLEET.CY-A[3] = VHDVS3I_FLEET.CY-A[3] + VHDVS02_DATA.CNT-CARS-OOS-PM[VAGen_COUNT];
                VHDVS3I_FLEET.CY-A[4] = VHDVS3I_FLEET.CY-A[4] + VHDVS02_DATA.CNT-CARS-OOS-UM[VAGen_COUNT];
                VHDVS3I_FLEET.CY-A[5] = VHDVS3I_FLEET.CY-A[5] + VHDVS02_DATA.CNT-CARS-OOS-MOD[VAGen_COUNT];
                VHDVS3I_FLEET.CY-A[6] = VHDVS3I_FLEET.CY-A[6] + VHDVS02_DATA.CNT-CARS-OOS-WAR[VAGen_COUNT];
                VHDVS3I_FLEET.CY-A[7] = VHDVS3I_FLEET.CY-A[1] + VHDVS3I_FLEET.CY-A[6] + VHDVS3I_FLEET.CY-A[2] + VHDVS3I_FLEET.CY-A[3] + VHDVS3I_FLEET.CY-A[4] + VHDVS3I_FLEET.CY-A[5];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "B1" ||
             VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "B2")
                VHDVS3I_FLEET.CY-B[1] = VHDVS3I_FLEET.CY-B[1] + VHDVS02_DATA.CNT-CARS-OOS-ENGR[VAGen_COUNT];
                VHDVS3I_FLEET.CY-B[2] = VHDVS3I_FLEET.CY-B[2] + VHDVS02_DATA.CNT-CARS-OOS-AWP[VAGen_COUNT];
                VHDVS3I_FLEET.CY-B[3] = VHDVS3I_FLEET.CY-B[3] + VHDVS02_DATA.CNT-CARS-OOS-PM[VAGen_COUNT];
                VHDVS3I_FLEET.CY-B[4] = VHDVS3I_FLEET.CY-B[4] + VHDVS02_DATA.CNT-CARS-OOS-UM[VAGen_COUNT];
                VHDVS3I_FLEET.CY-B[5] = VHDVS3I_FLEET.CY-B[5] + VHDVS02_DATA.CNT-CARS-OOS-MOD[VAGen_COUNT];
                VHDVS3I_FLEET.CY-B[6] = VHDVS3I_FLEET.CY-B[6] + VHDVS02_DATA.CNT-CARS-OOS-WAR[VAGen_COUNT];
                VHDVS3I_FLEET.CY-B[7] = VHDVS3I_FLEET.CY-B[1] + VHDVS3I_FLEET.CY-B[2] + VHDVS3I_FLEET.CY-B[3] + VHDVS3I_FLEET.CY-B[4] + VHDVS3I_FLEET.CY-B[5] + VHDVS3I_FLEET.CY-B[6];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C1" ||
             VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "C2" )
                VHDVS3I_FLEET.CY-C[1] = VHDVS3I_FLEET.CY-C[1] + VHDVS02_DATA.CNT-CARS-OOS-ENGR[VAGen_COUNT];
                VHDVS3I_FLEET.CY-C[2] = VHDVS3I_FLEET.CY-C[2] + VHDVS02_DATA.CNT-CARS-OOS-AWP[VAGen_COUNT];
                VHDVS3I_FLEET.CY-C[3] = VHDVS3I_FLEET.CY-C[3] + VHDVS02_DATA.CNT-CARS-OOS-PM[VAGen_COUNT];
                VHDVS3I_FLEET.CY-C[4] = VHDVS3I_FLEET.CY-C[4] + VHDVS02_DATA.CNT-CARS-OOS-UM[VAGen_COUNT];
                VHDVS3I_FLEET.CY-C[5] = VHDVS3I_FLEET.CY-C[5] + VHDVS02_DATA.CNT-CARS-OOS-MOD[VAGen_COUNT];
                VHDVS3I_FLEET.CY-C[6] = VHDVS3I_FLEET.CY-C[6] + VHDVS02_DATA.CNT-CARS-OOS-WAR[VAGen_COUNT];
                VHDVS3I_FLEET.CY-C[7] = VHDVS3I_FLEET.CY-C[1] + VHDVS3I_FLEET.CY-C[2] + VHDVS3I_FLEET.CY-C[3] + VHDVS3I_FLEET.CY-C[4] + VHDVS3I_FLEET.CY-C[5] + VHDVS3I_FLEET.CY-C[6];
            end 
            if (VHDVS02_DATA.CAR-TYPE[VAGen_COUNT] == "D1" )
                VHDVS3I_FLEET.CY-D[1] = VHDVS3I_FLEET.CY-D[1] + VHDVS02_DATA.CNT-CARS-OOS-ENGR[VAGen_COUNT];
                VHDVS3I_FLEET.CY-D[2] = VHDVS3I_FLEET.CY-D[2] + VHDVS02_DATA.CNT-CARS-OOS-AWP[VAGen_COUNT];
                VHDVS3I_FLEET.CY-D[3] = VHDVS3I_FLEET.CY-D[3] + VHDVS02_DATA.CNT-CARS-OOS-PM[VAGen_COUNT];
                VHDVS3I_FLEET.CY-D[4] = VHDVS3I_FLEET.CY-D[4] + VHDVS02_DATA.CNT-CARS-OOS-UM[VAGen_COUNT];
                VHDVS3I_FLEET.CY-D[5] = VHDVS3I_FLEET.CY-D[5] + VHDVS02_DATA.CNT-CARS-OOS-MOD[VAGen_COUNT];
                VHDVS3I_FLEET.CY-D[6] = VHDVS3I_FLEET.CY-D[6] + VHDVS02_DATA.CNT-CARS-OOS-WAR[VAGen_COUNT];
                VHDVS3I_FLEET.CY-D[7] = VHDVS3I_FLEET.CY-D[1] + VHDVS3I_FLEET.CY-D[2] + VHDVS3I_FLEET.CY-D[3] + VHDVS3I_FLEET.CY-D[4] + VHDVS3I_FLEET.CY-D[5] + VHDVS3I_FLEET.CY-D[6];
