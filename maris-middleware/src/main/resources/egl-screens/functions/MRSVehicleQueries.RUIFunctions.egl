Function VHYS09IS-RET-DATA ()
  
   
    VHYS09IW.MSG = " ";
    VHYS09IW.CAR-COUNT = 0;
    VHYS09A_CRIT.YARD = VHYS09IW-PASSVALUE.YARD;
    VHYS09IW.HEADER = VHYS09IW-PASSVALUE.YARD;
    if (VHYS09IW-PASSVALUE.YARD == "HY")
        VHYS09IW.HEADER = "HAYWARD YARD";
    else
        if (VHYS09IW-PASSVALUE.YARD == "CY")
            VHYS09IW.HEADER = "CONCORD YARD";
        else
            if (VHYS09IW-PASSVALUE.YARD == "DY")
                VHYS09IW.HEADER = "DAILY CITY YARD";
            else
                if (VHYS09IW-PASSVALUE.YARD == "RY")
                    VHYS09IW.HEADER = "RICHMOND YARD";
                end
            end
        end
    end
    try
        call "VHYS09A"(XDCONTROL, VHYS09A_CRIT, VHYS09A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYS09IW.CAR-COUNT = XDCONTROL.UROWCNT;
        ENABLE-SUMMARY = "Y";
        if (VHYS09IW.CAR-COUNT == 500)
            DISPLAY-FOOTER = "Y";
        else
            HIDE-FOOTER = "Y";
        end
        LOAD-CAR = "Y";
    else
        HIDE-FOOTER = "Y";
        LOAD-CAR = "Y";
        DISABLE-SUMMARY = "Y";
        NO-CARS-FOUND = "Y";
    end
end 

Function VHYS10IS-INIT ()

   
    VHYS10A_CRIT.YARD = VHYS10IW-PASSVALUE.YARD;
    if (VHYS10IW-PASSVALUE.YARD == "HY")
        VHYS10IW.HEADER = "HAYWARD YARD";
    else
        if (VHYS10IW-PASSVALUE.YARD == "CY")
            VHYS10IW.HEADER = "CONCORD YARD";
        else
            if (VHYS10IW-PASSVALUE.YARD == "DY")
                VHYS10IW.HEADER = "DAILY CITY YARD";
            else
                if (VHYS10IW-PASSVALUE.YARD == "RY")
                    VHYS10IW.HEADER = "RICHMOND YARD";
                end
            end
        end
    end
    VHYS10IW.ROW-COUNT = 17;
    VHYS10IW.CAR-TYPE-DATA[1] = "Total  Cars in Yard";
    VHYS10IW.CAR-TYPE-DATA[2] = "      Cars in  Hold";
    VHYS10IW.CAR-TYPE-DATA[3] = "Total Operating Yard";
    VHYS10IW.CAR-TYPE-DATA[4] = " ";
    VHYS10IW.CAR-TYPE-DATA[5] = "Cars in Unsched Maint";
    VHYS10IW.CAR-TYPE-DATA[6] = "Cars in UM (No Parts)";
    VHYS10IW.CAR-TYPE-DATA[7] = "Cars in Prevent Maint";
  
    VHYS10IW.CAR-TYPE-DATA[8] = "Cars in  Warranty Rep";
    VHYS10IW.CAR-TYPE-DATA[9] = "Cars in Engnerng Hold";
    VHYS10IW.CAR-TYPE-DATA[10] = "Cars in Modification";
    VHYS10IW.CAR-TYPE-DATA[11] = "Cars in Miscell Hold";
    VHYS10IW.CAR-TYPE-DATA[12] = " ";
    VHYS10IW.CAR-TYPE-DATA[13] = "Total  Cars in Maint";
    VHYS10IW.CAR-TYPE-DATA[14] = " ";
    VHYS10IW.CAR-TYPE-DATA[15] = "Total Avail For Servc";
    VHYS10IW.CAR-TYPE-DATA[16] = "Cars in Revenue Servc";
    VHYS10IW.CAR-TYPE-DATA[17] = "Avail GO Cars in Yrds";
    try
        call "VHYS10A"(XDCONTROL, VHYS10A_CRIT, VHYS10A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYS10IW.TOTAL-CAR-COUNT = XDCONTROL.UROWCNT;
        VHYS10IS-TYPE-CHK(); 
    else
        if (XDCONTROL.URC == 100)

        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHYS10IS-TYPE-A () 
    TOTAL-YARD-A = TOTAL-YARD-A + 1;
    TOTAL-YARD-T = TOTAL-YARD-T + 1;
    if (VHYS10A_DATA.VEH-STAT[LOOP-INDEX] == "STOR" ||
     VHYS10A_DATA.VEH-STAT[LOOP-INDEX] == "SAFETY" ||
     VHYS10A_DATA.VEH-STAT[LOOP-INDEX] == "ACIDNT" ||
     VHYS10A_DATA.VEH-STAT[LOOP-INDEX] == "TEST")
        HOLD-CARS-A = HOLD-CARS-A + 1;
        HOLD-CARS-T = HOLD-CARS-T + 1;
    else
        if (VHYS10A_DATA.WHERE-IS-CAR[LOOP-INDEX] == "CON")
            REV-SERVICE-A = REV-SERVICE-A + 1;
            REV-SERVICE-T = REV-SERVICE-T + 1;
        else
            TOTAL-MAINT-A = TOTAL-MAINT-A + 1;
            TOTAL-MAINT-T = TOTAL-MAINT-T + 1;
            if (VHYS10A_DATA.WAR-IND[LOOP-INDEX] == "Y" &&
             VHYS10A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                WARRANTY-A = WARRANTY-A + 1;
                WARRANTY-T = WARRANTY-T + 1;
            else
                if (VHYS10A_DATA.WAR-IND[LOOP-INDEX] == "N" &&
                 VHYS10A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                    UNSCHD-MAIN-A = UNSCHD-MAIN-A + 1;
                    UNSCHD-MAIN-T = UNSCHD-MAIN-T + 1;
                else
                    if (VHYS10A_DATA.VEH-STAT[LOOP-INDEX] == "AWPART")
                        WAITPART-UM-A = WAITPART-UM-A + 1;
                        WAITPART-UM-T = WAITPART-UM-T + 1;
                    else
                        if (VHYS10A_DATA.VEH-STAT[LOOP-INDEX] == "PM")
                            PREVEN-MAIN-A = PREVEN-MAIN-A + 1;
                            PREVEN-MAIN-T = PREVEN-MAIN-T + 1;
                        else
                            if (VHYS10A_DATA.VEH-STAT[LOOP-INDEX] == "ENGHLD")
                                ENGRNG-HOLD-A = ENGRNG-HOLD-A + 1;
                                ENGRNG-HOLD-T = ENGRNG-HOLD-T + 1;
                            else
                                if (VHYS10A_DATA.VEH-STAT[LOOP-INDEX] == "MODHLD")
                                    MODIFY-CARS-A = MODIFY-CARS-A + 1;
                                    MODIFY-CARS-T = MODIFY-CARS-T + 1;
                                else
                                    if (VHYS10A_DATA.VEH-STAT[LOOP-INDEX] == "MISC")
                                        MISCEL-HOLD-A = MISCEL-HOLD-A + 1;
                                        MISCEL-HOLD-T = MISCEL-HOLD-T + 1;
                                    else
                                        TOTAL-MAINT-A = TOTAL-MAINT-A - 1;
                                        TOTAL-MAINT-T = TOTAL-MAINT-T - 1;
                                        if (VHYS10A_DATA.VEH-STAT[LOOP-INDEX] != "GO" &&
                                         VHYS10A_DATA.VEH-STAT[LOOP-INDEX] != "USABLE" &&
                                         VHYS10A_DATA.VEH-STAT[LOOP-INDEX] != "ERROR")
                                            TOTAL-YARD-A = TOTAL-YARD-A - 1;
                                            TOTAL-YARD-T = TOTAL-YARD-T - 1;
                                        else
                                            GO-AVAIL-A = GO-AVAIL-A + 1;
                                            GO-AVAIL-T = GO-AVAIL-T + 1;
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

