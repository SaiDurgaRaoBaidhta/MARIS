Function VHFO01IS-SUBMIT-X () 
    VHFO01IW-TRIGGER.OK-SUBMIT = "Y";
    VHFO01IW.NULL-TO-ERROR = "N";
    VHFO01IW.INVALID-TO-DATE = " ";
    VHFO01IW.INVALID-FROM-DATE = " ";
    if (VHFO01IW.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHFO01IW.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHFO01IW.INVALID-FROM-DATE = "Y";
            
   
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHFO01I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHFO01IW.TO-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHFO01IW.TO-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHFO01IW.INVALID-TO-DATE = "Y";
            
  
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHFO01I_MESSAGE.MESG1 = "INVALID FROM DATE";
                
   
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHFO01IW.INVALID-FROM-DATE == "Y")
        VHFO01I_MESSAGE.MESG1 = "INVALID FROM DATE";
        VHFO01IW-TRIGGER.OK-SUBMIT = "N";
    else
  
        if (VHFO01IW.TO-DATE != " ")
            if ((VHFO01IW.TO-DATE-YEAR-NUM > VHFO01IW.WS-CURR-YEAR-NUM) ||
             (VHFO01IW.TO-DATE-YEAR-NUM == VHFO01IW.WS-CURR-YEAR-NUM &&
             VHFO01IW.TO-DATE-MO-NUM > VHFO01IW.WS-CURR-MO-NUM) ||
             (VHFO01IW.TO-DATE-YEAR-NUM == VHFO01IW.WS-CURR-YEAR-NUM &&
             VHFO01IW.TO-DATE-MO-NUM == VHFO01IW.WS-CURR-MO-NUM &&
             VHFO01IW.TO-DATE-DAY-NUM > VHFO01IW.WS-CURR-DA-NUM))
                VHFO01I_MESSAGE.MESG1 = "To date cannot be greater than CURRENT_DATE.";
                VHFO01IW.INVALID-TO-DATE = "Y";
                AFCXVLDW.NO-ERROR = "N";
                
  
            end
        end
    end
    if (VHFO01IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHFO01IW.INVALID-TO-DATE == "Y")
            VHFO01I_MESSAGE.MESG1 = "INVALID TO DATE";
            VHFO01IW-TRIGGER.OK-SUBMIT = "N";
        else
  
            if (VHFO01IW.FROM-DATE != " " && VHFO01IW.TO-DATE != " ")
                if ((VHFO01IW.FROM-DATE-YEAR-NUM > VHFO01IW.TO-DATE-YEAR-NUM) ||
                 (VHFO01IW.FROM-DATE-YEAR-NUM == VHFO01IW.TO-DATE-YEAR-NUM &&
                 VHFO01IW.FROM-DATE-MO-NUM > VHFO01IW.TO-DATE-MO-NUM) ||
                 (VHFO01IW.FROM-DATE-YEAR-NUM == VHFO01IW.TO-DATE-YEAR-NUM &&
                 VHFO01IW.FROM-DATE-MO-NUM == VHFO01IW.TO-DATE-MO-NUM &&
                 VHFO01IW.FROM-DATE-DAY-NUM > VHFO01IW.TO-DATE-DAY-NUM))
                    VHFO01I_MESSAGE.MESG1 = "From date cannot be greater than To date.";
                    VHFO01IW.INVALID-FROM-DATE = "Y";
                    AFCXVLDW.NO-ERROR = "N";
                    
  
                end
            end
        end
    end
    if (VHFO01IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHFO01IW-TRIGGER.INVALID-SYMP-TO == "Y")
            VHFO01IW-TRIGGER.OK-SUBMIT = "N";
        else
            if (VHFO01IW-TRIGGER.INVALID-SYMP-FROM == "Y")
                VHFO01IW-TRIGGER.OK-SUBMIT = "N";
            else
  
  
  
                if (AFCXVLDW.NO-ERROR == "N")
                    VHFO01IW-TRIGGER.OK-SUBMIT = " ";
                else
                    VHFO01IW-TRIGGER.OK-SUBMIT = "Y ";
                end
            end
        end
    end
end 

