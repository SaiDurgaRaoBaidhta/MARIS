        VHDVS3I_FLEET.FLEET-TOT[VAGen_INDEX] = VHDVS3I_FLEET.FLEET-A[VAGen_INDEX] + VHDVS3I_FLEET.FLEET-B[VAGen_INDEX] + VHDVS3I_FLEET.FLEET-C[VAGen_INDEX] + 
        										VHDVS3I_FLEET.FLEET-D[VAGen_INDEX] + VHDVS3I_FLEET.FLEET-E[VAGen_INDEX] +
