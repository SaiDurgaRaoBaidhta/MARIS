Function VHCL02IS-GET-CARS () 
    set VHCL02C_DATA empty;
    VHCL02C_CRIT.CON-NO-LOW = VHCL02B_CRIT.CON-NO-LOW;
    VHCL02C_CRIT.CON-NO-HIGH = VHCL02B_CRIT.CON-NO-HIGH;
    VHCL02C_CRIT.DATE-INSRV-REV = VHCL02B_CRIT.DATE-INSRV-REV;
    try
        call "VHCL02C"(XDCONTROL, VHCL02C_CRIT, VHCL02C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if (XDCONTROL.UROWCNT > 1000)
            VHCL02IW-CNT.CAR-ROW-CNT = 1000;
        else
            VHCL02IW-CNT.CAR-ROW-CNT = XDCONTROL.UROWCNT;
        end
    else
        if (XDCONTROL.URC == 100)
            VHCL02IW-MSG.FINAL-MSG-2 = " There is no data for this selection";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

Function VHCL02IS-GET-DATA2 () 
    set VHCL02B_DATA empty;
    VHCL02B_DATA.EXCEED-LIMIT = "N";
    set VHCL02IW-MSG empty;
    VHCL02IW-TRIGGER.DATA-MOVED = "N";
    VHCL02B_CRIT.CON-NO-LOW = VHCL2A1_CRIT.CON-NO-LOW;
    VHCL02B_CRIT.CON-NO-HIGH = VHCL2A1_CRIT.CON-NO-HIGH;
    VHCL02B_CRIT.DATE-INSRV-REV = VHCL2A1_CRIT.REV-DATE-DB2;
    try
        call "VHCL02B"(XDCONTROL, VHCL02B_CRIT, VHCL02B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if (XDCONTROL.UROWCNT > 100)
            VHCL02IW-CNT.CON-ROW-CNT = 100;
        else
            VHCL02IW-CNT.CON-ROW-CNT = XDCONTROL.UROWCNT;
        end
        VHCL02IS-GET-CARS();
        VHCL02IS-MOVE-DATA();
        if (VHCL02IW-TRIGGER.DATA-MOVED == "Y")
            VHCL02IS-PAGE-CNT();
            VHCL02IW-CNT.PAGE-CNT = 1;
            VHCL02IS-LOAD-PAGE();
            VHCL02IW-MSG.FINAL-MSG-1 = VHCL02IW-CNT.CON-ROW-CNT;
            VHCL02IW-MSG.FINAL-MSG-2 = " Consist(s) are selected and total number of cars is  ";
            VHCL02IW-MSG.FINAL-MSG-3 = VHCL02IW-CNT.CAR-ROW-CNT;
            DISABLE-LIST = "Y";
            ENABLE-PRINT = "Y";
            ENABLE-CLEAR = "Y";
        end
    else
        if (XDCONTROL.URC == 100)
      
            VHCL02IW-MSG.FINAL-MSG-2 = "There is no consist for this selection";
            DISABLE-LIST = "Y";
            DISABLE-PRINT = "Y";
            DISABLE-CLEAR = "Y";
            DISABLE-PRV-PAGE = "Y";
            DISABLE-NXT-PAGE = "Y";
            set VHCL02IW-CNT empty;
            set VHCL02IW-CON-1 empty;
            set VHCL02IW-CON-2 empty;
            set VHCL02IW-CON-3 empty;
            set VHCL02IW-CON-4 empty;
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
    if (VHCL02B_DATA.EXCEED-LIMIT == "Y")
    
        VHCL02IW-MSG.FINAL-MSG-2 = "Data exceed program limit. Please use PRINT option to see all consists";
    end
end 

