    set VHYS06IW-MSG empty;
    set VHYS06IW empty;
    VHYS06IW.CAR-NO-FROM = " ";
    VHYS06IW.CAR-NO-TO =   " ";
end 

Function VHYS06IS-CLEAR-X () 
    set VHYS06IW empty;
    VHYS06IW.CAR-NO-FROM = " ";
    VHYS06IW.CAR-NO-TO =   " ";
end 

Function VHYS06IS-HARD-COPY () 
    if (PRT-IDX > 0)
        ENABLE-HARD = "Y";
        VHYS01IW-PASSVALUE.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRT-IDX];
    else
        DISABLE-HARD = "Y";
    end
end 

Function VHYS06IS-INIT () 
    VHYS06IW.OPT-YARD-BASE = 0;
    VHYS06IW.OPT-YARD-STATUS = 0;
    VHYS06IW.OPT-YARD-NOGO = 0;
    VHYS06IW.OPT-YARD-SUMMARY = 0;
    YARD-BASE = " ";
    NARR-IND-BASE = " ";
    YARD-STATUS = " ";
    VHYS06IW.VEH-STATUS = " ";
    NARR-IND-STATUS = " ";
    YARD-NOGO = " ";
    YARD-SUMMARY = " ";

  
    try
        call "VHYS06A"(XDCONTROL, VHYS06A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else

    end

  
    try
        call "VHYS06B"(XDCONTROL, VHYS06B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else

    end
end 

Function VHYS06IS-MOVE-VAL () 
    if (VHYS06IW.OPT-YARD-BASE == 1 &&
     VHYS06IW.OPT-YARD-STATUS == 0 &&
     VHYS06IW.OPT-YARD-NOGO == 0 &&
     VHYS06IW.OPT-YARD-SUMMARY == 0)
        VHYS06IW.PASSVALUE-YARD = VHYS06IW.YARD-BASE;
        VHYS06IW.PASSVALUE-NARR-IND = VHYS06IW.NARR-IND-BASE;
        VHYS06IW.PASSVALUE-TITLE = "VHYS07I - Yard Status Report - Base";
        VHYS06IW.PASSVALUE-REPORT-OPTION = 1;
        VHYS06IW-TRIGGER.OPEN-VHYS07I = "Y";
    else
        if (VHYS06IW.OPT-YARD-BASE == 0 &&
         VHYS06IW.OPT-YARD-STATUS == 1 &&
         VHYS06IW.OPT-YARD-NOGO == 0 &&
         VHYS06IW.OPT-YARD-SUMMARY == 0)
            VHYS06IW.PASSVALUE-YARD = VHYS06IW.YARD-STATUS;
            VHYS06IW.PASSVALUE-VEH-STAT = VHYS06IW.VEH-STATUS;
            VHYS06IW.PASSVALUE-NARR-IND = VHYS06IW.NARR-IND-STATUS;
            VHYS06IW.PASSVALUE-REPORT-OPTION = 2;
            VHYS06IW.PASSVALUE-TITLE = "VHYS07I - Yard Status Report - Status";
            VHYS06IW-TRIGGER.OPEN-VHYS07I = "Y";
        else
            if (VHYS06IW.OPT-YARD-BASE == 0 &&
             VHYS06IW.OPT-YARD-STATUS == 0 &&
             VHYS06IW.OPT-YARD-NOGO == 1 &&
             VHYS06IW.OPT-YARD-SUMMARY == 0)
                VHYS06IW.PASSVALUE-YARD = VHYS06IW.YARD-NOGO;
                VHYS06IW.PASSVALUE-NARR-IND = " ";
                VHYS06IW.PASSVALUE-REPORT-OPTION = 3;
                VHYS06IW.PASSVALUE-TITLE = "VHYS08I - Yard Status Report - NOGO          V1.OCT.31.00.01";
                VHYS06IW-TRIGGER.OPEN-VHYS08I = "Y";
            else
                if (VHYS06IW.OPT-YARD-BASE == 0 &&
                 VHYS06IW.OPT-YARD-STATUS == 0 &&
                 VHYS06IW.OPT-YARD-NOGO == 0 &&
                 VHYS06IW.OPT-YARD-SUMMARY == 1)
                    VHYS06IW.PASSVALUE-YARD = VHYS06IW.YARD-SUMMARY;
                    VHYS06IW.PASSVALUE-NARR-IND = " ";
                    VHYS06IW.PASSVALUE-TITLE = "VHYS09I - Yard Status Report - Summary";
                    VHYS06IW.PASSVALUE-REPORT-OPTION = 4;
                    VHYS06IW-TRIGGER.OPEN-VHYS09I = "Y";
                else

                end
            end
        end
    end
end 

Function VHYS06IS-SETFOCUS () 
    if ((VHYS06IW.OPT-YARD-BASE == 1 &&
     VHYS06IW.OPT-YARD-STATUS == 0 &&
     VHYS06IW.OPT-YARD-NOGO == 0 &&
     VHYS06IW.OPT-YARD-SUMMARY == 0))
        YARDBASE-SETFOCUS = "Y";
    else
        if ((VHYS06IW.OPT-YARD-BASE == 0 &&
         VHYS06IW.OPT-YARD-STATUS == 1 &&
         VHYS06IW.OPT-YARD-NOGO == 0 &&
         VHYS06IW.OPT-YARD-SUMMARY == 0))
            if (VHYS06IW.YARD-STATUS == " ")
                YARDSTATUS-SETFOCUS = "Y";
            else
                if (VHYS06IW.VEH-STATUS == " ")
                    VEHSTAT-SETFOCUS = "Y";
                end
            end
        else
            if ((VHYS06IW.OPT-YARD-BASE == 0 &&
             VHYS06IW.OPT-YARD-STATUS == 0 &&
             VHYS06IW.OPT-YARD-NOGO == 1 &&
             VHYS06IW.OPT-YARD-SUMMARY == 0))
                YARDNOGO-SETFOCUS = "Y";
            else
                if ((VHYS06IW.OPT-YARD-BASE == 0 &&
                 VHYS06IW.OPT-YARD-STATUS == 0 &&
                 VHYS06IW.OPT-YARD-NOGO == 0 &&
                 VHYS06IW.OPT-YARD-SUMMARY == 1))
                    YARDSUMMARY-SETFOCUS = "Y";
                end
            end
        end
    end
end 




Function VHYS06IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
   
    VHYS06IS-CHK-SEL-X();
  
  
  
  
    if (VHYS06IW.CAR-NO-FROM == "   ")
        VHYS06IW.CAR-NO-FROM = "0096";
    end
    if (VHYS06IW.CAR-NO-TO=="0000" || strLib.characterLen(VHYS06IW.CAR-NO-TO )<1)
        VHYS06IW.CAR-NO-TO = "5000";
    end
    if (VHYS06IW.CAR-NO-TO < VHYS06IW.CAR-NO-FROM)
        ERROR = "Y";
        FINAL-ERROR-MESSAGE = "The TO CAR cannot be less than the FROM CAR";
        return;
    end
    if (VHYS06IW-TRIGGER.SELECT-ONE-X == "1")
        set VHYS06C_CRIT empty;
        VHYS06C_CRIT.CAR-NO-FROM = VHYS06IW.CAR-NO-FROM;
        VHYS06C_CRIT.CAR-NO-TO = VHYS06IW.CAR-NO-TO;
        if (OPT-YARD-BASE == 1)
            VHYS06C_CRIT.REPT-ID = "1";
            VHYS06C_CRIT.HOME-YRD = YARD-BASE;
            VHYS06C_CRIT.REPT-MISC = NARR-IND-BASE;
            VHYS06C_CRIT.INCD-STAT = " ";
        else
            if (OPT-YARD-STATUS == 1)
                VHYS06C_CRIT.REPT-ID = "2";
                VHYS06C_CRIT.HOME-YRD = YARD-STATUS;
                VHYS06C_CRIT.REPT-MISC = NARR-IND-STATUS;
                VHYS06C_CRIT.INCD-STAT = VEH-STATUS;
            else
                if (OPT-YARD-NOGO == 1)
                    VHYS06C_CRIT.REPT-ID = "3";
                    VHYS06C_CRIT.HOME-YRD = YARD-NOGO;
                    VHYS06C_CRIT.REPT-MISC = " ";
                    VHYS06C_CRIT.INCD-STAT = " ";
                else
                    if (OPT-YARD-SUMMARY == 1)
                        VHYS06C_CRIT.REPT-ID = "4";
                        VHYS06C_CRIT.HOME-YRD = YARD-SUMMARY;
                        VHYS06C_CRIT.REPT-MISC = " ";
                        VHYS06C_CRIT.INCD-STAT = " ";
                    end
                end
            end
        end
        VHYS06C_CRIT.REPT-TYPE = VHYS01IW-PASSVALUE.VTAM-NAME;

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYS01I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYS06C";

    
        try
            call "VHYS06C"(XDCONTROL, VHYS06C_CRIT, VHYS06C_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
                FINAL-ERROR-MESSAGE = "Report Has Been Submitted, Pick Up at Your Local Printer ";
                CLEAR-X = "Y";
                
  
            else

        


        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

Function VHYS07IS-CPRV-CNXT () 
    VHYS07IW.CAR-DETAILS = " ";
    if (VHYS07IW.CAR-PRV-NXT == "PRV")
        CAR-INDEX = CAR-INDEX - 1;
        if (CAR-INDEX == 1)
            DISABLE-CARPRV = "Y";
            if (CAR-INDEX == CAR-COUNT)
                DISABLE-CARNXT = "Y";
            else
                ENABLE-CARNXT = "Y";
                CARNXT-SETFOCUS = "Y";
            end
        else
            ENABLE-CARPRV = "Y";
            ENABLE-CARNXT = "Y";
            CARPRV-SETFOCUS = "Y";
        end
    else
        if (VHYS07IW.CAR-PRV-NXT == "NXT")
            CAR-INDEX = CAR-INDEX + 1;
            ENABLE-CARPRV = "Y";
            if (CAR-INDEX == CAR-COUNT)
                DISABLE-CARNXT = "Y";
                CARPRV-SETFOCUS = "Y";
            else
                ENABLE-CARNXT = "Y";
                CARNXT-SETFOCUS = "Y";
            end
        else
            if (VHYS07IW.CAR-PRV-NXT == " ")
                VHYS07IW.CAR-INDEX = 1; 
                if (CAR-INDEX == CAR-COUNT)
                    DISABLE-CARPRV = "Y";
                    DISABLE-CARNXT = "Y";
                else
                    DISABLE-CARPRV = "Y";
                    ENABLE-CARNXT = "Y";
                    CARNXT-SETFOCUS = "Y";
                end
            end
        end
    end
    VHYS07IW.CAR-NO = VHYS07A_CAR_DATA.CAR-NO[CAR-INDEX];
    VHYS07IW.DISP-VEH-STAT = VHYS07A_CAR_DATA.DISP-VEH-STAT[CAR-INDEX];
    VHYS07IW.CURR-LOC = VHYS07A_CAR_DATA.CURR-LOC[CAR-INDEX];
    VHYS07IW.ATO-PRESENT-IND = VHYS07A_CAR_DATA.ATO-PRESENT-IND[CAR-INDEX];
    VHYS07IW.CUM-HRS = VHYS07A_CAR_DATA.CUM-HRS[CAR-INDEX];
    VHYS07IW.CUM-MIN = VHYS07A_CAR_DATA.CUM-MIN[CAR-INDEX];
    VHYS07IW.MTBI = VHYS07A_CAR_DATA.MTBI[CAR-INDEX];
    VHYS07IW.HOME-YRD = VHYS07A_CAR_DATA.HOME-YRD[CAR-INDEX];

  
    LOAD-INCD = "Y";
end 

Function VHYS07IS-INCD-DET () 
    VHYS07IW.LOOP-INDEX = 1;
    VHYS07IW.NARR = " ";


  
    VHYS07A_CRIT.RET-IND = "INCDS";
    VHYS07A_CRIT.CAR-NO = VHYS07A_CAR_DATA.CAR-NO[CAR-INDEX];
    try
        call "VHYS07A"(XDCONTROL, VHYS07A_CRIT, VHYS07A_CAR_DATA, VHYS07A_INCD_DATA);
    
    end
    if (XDCONTROL.UROWCNT > 0)

    else
        if (XDCONTROL.UROWCNT == 0 && XDCONTROL.URC == 100)
            VHYS07A_INCD_DATA.CAR-INCD-COUNT = 0;
            VHYS07IW.NARR = "NO INCIDENTS FOUND FOR THIS CAR";
            DISABLE-NARRPRV = "Y";
            DISABLE-NARRNXT = "Y";
        else

        end
    end
    LOAD-INCD-DATA = "Y";
    if (VHYS07IW.SELECTION-IDX == 1)
        VHYS07IS-SELECT();
    end
end 

Function VHYS07IS-NPRV-NNXT () 
    if (VHYS07IW.NARR-PRV-NXT == "PRV")
        NARR-INDEX = NARR-INDEX - 1;
        if (NARR-INDEX == 1)
            DISABLE-NARRPRV = "Y";
            if (NARR-INDEX == NARR-COUNT)
                DISABLE-NARRNXT = "Y";
            else
                ENABLE-NARRNXT = "Y";
                NARRNXT-SETFOCUS = "Y";
            end
        else
            ENABLE-NARRPRV = "Y";
            ENABLE-NARRNXT = "Y";
            NARRPRV-SETFOCUS = "Y";
        end
    else
        if (VHYS07IW.NARR-PRV-NXT == "NXT")
            NARR-INDEX = NARR-INDEX + 1;
            ENABLE-NARRPRV = "Y";
            if (NARR-INDEX == NARR-COUNT)
                DISABLE-NARRNXT = "Y";
                NARRPRV-SETFOCUS = "Y";
            else
                ENABLE-NARRNXT = "Y";
                NARRNXT-SETFOCUS = "Y";
            end
        else
            if (VHYS07IW.NARR-PRV-NXT == " ")
                VHYS07IW.NARR-INDEX = 1; 
                if (NARR-INDEX == NARR-COUNT)
                    DISABLE-NARRPRV = "Y";
                    DISABLE-NARRNXT = "Y";
                else
                    DISABLE-NARRPRV = "Y";
                    ENABLE-NARRNXT = "Y";
                    NARRNXT-SETFOCUS = "Y";
                end
            end
        end
    end
    VHYS07IW.NARR = VHYS07B_NARR_DATA.NARR[NARR-INDEX];
end 

Function VHYS07IS-RET-DATA ()
  
  
   
    VHYS07IW.MSG = " ";
    VHYS07IW.CAR-INDEX = 0;
    VHYS07IW.CAR-PRV-NXT = " ";
    VHYS07IW.NARR-PRV-NXT = " ";

  
    if (VHYS07A_CRIT.CAR-NO-FROM == "   ")
        VHYS07A_CRIT.CAR-NO-FROM = "0096";
    end
    if (VHYS07A_CRIT.CAR-NO-TO=="0000" || strLib.characterLen(VHYS07A_CRIT.CAR-NO-TO)<1)
        VHYS07A_CRIT.CAR-NO-TO = "5000";
    end
    VHYS07A_CRIT.YARD = VHYS07IW-PASSVALUE.YARD;
    VHYS07A_CRIT.VEH-STAT = VHYS07IW-PASSVALUE.VEH-STAT;
    VHYS07A_CRIT.REPORT-OPTION = VHYS07IW-PASSVALUE.REPORT-OPTION;
    VHYS07A_CRIT.RET-IND = "CAR";
    try
        call "VHYS07A"(XDCONTROL, VHYS07A_CRIT, VHYS07A_CAR_DATA, VHYS07A_INCD_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        LOAD-CAR = "Y";
    else
        CAR-INCD-COUNT = 0;
        VHYS07IW.CAR-DETAILS = " ";
        VHYS07IW.NARR = " ";
        DISABLE-CARPRV = "Y";
        DISABLE-CARNXT = "Y";
        DISABLE-NARRPRV = "Y";
        DISABLE-NARRNXT = "Y";
        LOAD-INCD-DATA = "Y";
        if (XDCONTROL.URC == 100)
            VHYS07IW.MSG = "No Data Found for Search Criteria";
            NO-CARS-FOUND = "Y";
        else
		  
		  
		  
		  
            VHYS07IW.MSG = "Maximum of 500 Records Was Reached";
        end
    end
end 

Function VHYS07IS-SELECT () 
    if (VHYS07A_INCD_DATA.CAR-INCD-COUNT > 0)
        if (VHYS07IW-PASSVALUE.NARR-IND == "Y")
            if (SELECTION-IDX == 0)
                SELECTION-IDX = 1;
            end
            if (SELECTION-IDX > 0)
                NARR-INDEX = 0;
                VHYS07IW.NARR-PRV-NXT = " ";
                VHYS07B_CRIT.CAR-NO = VHYS07IW.CAR-NO;
                VHYS07B_CRIT.INCD-NO = VHYS07A_INCD_DATA.INCD-NO[SELECTION-IDX];
                VHYS07B_CRIT.YARD = VHYS07IW.CURR-LOC;
                try
                    call "VHYS07B"(XDCONTROL, VHYS07B_CRIT, VHYS07B_NARR_DATA);
                
                end
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    if (NARR-COUNT > 0)
                        LOAD-NARR = "Y";
                    end
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end
        else
            DISABLE-NARRPRV = "Y";
            DISABLE-NARRNXT = "Y";
        end
    end
end 

Function VHYS08IS-600-ROWS () 
    VHYS08IW.FINAL-ERROR-MESSAGE = "The Frist 600 Rows Have Been Displayed";
end 

Function VHYS08IS-NPRV-NNXT () 
    if (VHYS08IW.NARR-PRV-NXT == "PRV")
        NARR-INDEX = NARR-INDEX - 1;
        if (NARR-INDEX == 1)
            DISABLE-NARRPRV = "Y";
            if (NARR-INDEX == NARR-COUNT)
                DISABLE-NARRNXT = "Y";
            else
                ENABLE-NARRNXT = "Y";
                NARRNXT-SETFOCUS = "Y";
            end
        else
            ENABLE-NARRPRV = "Y";
            ENABLE-NARRNXT = "Y";
            NARRPRV-SETFOCUS = "Y";
        end
    else
        if (VHYS08IW.NARR-PRV-NXT == "NXT")
            NARR-INDEX = NARR-INDEX + 1;
            ENABLE-NARRPRV = "Y";
            if (NARR-INDEX == NARR-COUNT)
                DISABLE-NARRNXT = "Y";
                NARRPRV-SETFOCUS = "Y";
            else
                ENABLE-NARRNXT = "Y";
                NARRNXT-SETFOCUS = "Y";
            end
        else
            if (VHYS08IW.NARR-PRV-NXT == " ")
                VHYS08IW.NARR-INDEX = 1;   
                if (NARR-INDEX == NARR-COUNT)
                    DISABLE-NARRPRV = "Y";
                    DISABLE-NARRNXT = "Y";
                else
                    DISABLE-NARRPRV = "Y";
                    ENABLE-NARRNXT = "Y";
                    NARRNXT-SETFOCUS = "Y";
                end
            end
        end
    end
    VHYS08IW.NARR = VHYS07B_NARR_DATA.NARR[NARR-INDEX];
end 

Function VHYS08IS-RET-DATA ()
  
   
    VHYS08IW.FINAL-ERROR-MESSAGE = " ";
    VHYS08IW.CAR-COUNT = 0;
    VHYS08IW.PAGE-PRV-NXT = " ";
    VHYS08IW.CAR-INDEX = 0;
    VHYS08IW.NARR = " ";
    VHYS08B_CRIT.ROW-CNT = 0;
    VHYS08IW.CNT = 1;
    VHYS08IW.INCD-CNT = 0;


  
    if (VHYS08A_CRIT.CAR-NO-FROM == "   ")
        VHYS08A_CRIT.CAR-NO-FROM = "0096";
    end
    if (VHYS08A_CRIT.CAR-NO-TO=="0000" || strLib.characterLen(VHYS08A_CRIT.CAR-NO-TO)< 1 )
        VHYS08A_CRIT.CAR-NO-TO = "5000";
    end
    VHYS08A_CRIT.YARD = VHYS08IW-PASSVALUE.YARD;
    VHYS08A_CRIT.REPORT-OPTION = VHYS08IW-PASSVALUE.REPORT-OPTION;
    move " " to VHYS08B_DATA.DATA_ROW[1] for all;
    try
        call "VHYS08A"(XDCONTROL, VHYS08A_CRIT, VHYS08A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYS08IW.CAR-COUNT = XDCONTROL.UROWCNT;
        while (CNT <= VHYS08IW.CAR-COUNT)
            VHYS08B_CRIT.INCD-IND = VHYS08A_DATA.INCD-IND[CNT];
            VHYS08B_CRIT.VEH-STAT = VHYS08A_DATA.VEH-STAT[CNT];
            VHYS08B_CRIT.VEH-STAT-FILLER = VHYS08A_DATA.VEH-STAT-FILLER[CNT];
            VHYS08B_CRIT.HOME-YRD = VHYS08A_DATA.HOME-YRD[CNT];
            VHYS08B_CRIT.CAR-NO = VHYS08A_DATA.CAR-NO[CNT];
            try
                call "VHYS08B"(XDCONTROL, VHYS08B_CRIT, VHYS08B_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHYS08IW.INCD-CNT = VHYS08B_CRIT.ROW-CNT;
                if (VHYS08IW.CAR-COUNT == 600)
                    DISPLAY-FOOTER = "Y";
                else
                    HIDE-FOOTER = "Y";
                end
            end
            VHYS08IW.CNT = VHYS08IW.CNT + 1;
        end
        if (VHYS08IW.INCD-CNT > 0)
            LOAD-CAR = "Y";
            SELECT-NARR = "Y";
        else
            HIDE-FOOTER = "Y";
            DISABLE-PAGEPRV = "Y";
            DISABLE-PAGENXT = "Y";
            DISABLE-NARRPRV = "Y";
            DISABLE-NARRNXT = "Y";
            LOAD-CAR = "Y";
            VHYS08IW.FINAL-ERROR-MESSAGE = "NO INCIDENT WAS FOUND  ";
        end
    else
        VHYS08IW.FINAL-ERROR-MESSAGE = "NO CAR WAS FOUND";
        HIDE-FOOTER = "Y";
        DISABLE-PAGEPRV = "Y";
        DISABLE-PAGENXT = "Y";
        DISABLE-NARRPRV = "Y";
        DISABLE-NARRNXT = "Y";
        LOAD-CAR = "Y";
    end
end 

Function VHYS08IS-SELECT () 
    if (VHYS08IW.CAR-COUNT > 0)
        if (SELECTION-IDX == 0)
            SELECTION-IDX = 1;
        end
        if (SELECTION-IDX > 0)
            NARR-INDEX = 0;
            VHYS08IW.NARR-PRV-NXT = " ";
            VHYS07B_CRIT.CAR-NO = VHYS08B_DATA.STORE-CAR-NO[SELECTION-IDX];
            VHYS07B_CRIT.INCD-NO = VHYS08B_DATA.INCD-NO[SELECTION-IDX];
            VHYS07B_CRIT.YARD = VHYS08IW-PASSVALUE.YARD;
            try
                call "VHYS07B"(XDCONTROL, VHYS07B_CRIT, VHYS07B_NARR_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                if (NARR-COUNT > 0)
                    LOAD-NARR = "Y";
                else
                    VHYS08IW.NARR = " ";
                end
            else

            end
        end
    else
        VHYS08IW.FINAL-ERROR-MESSAGE = "No Cars Were Found ";
        

  
    end
end 

