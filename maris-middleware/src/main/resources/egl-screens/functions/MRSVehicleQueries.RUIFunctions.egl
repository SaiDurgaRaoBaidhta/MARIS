        VHCL01IW-TRIGGERS.ENABLE-HARD = "Y";
        VHCL01IW.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRT-IDX];
    else
        VHCL01IW-TRIGGERS.DISABLE-HARD = "Y";
    end
end 

Function VHCL01IS-INIT () 
    VHCL01IW.FIRST-TIME = "N";
    VHCL01IW.CNT = 0;
    VHCL01IW.WS-DATEX = VGVar.currentFormattedGregorianDate;
end 

Function VHCL01IS-MSG () 
    if (VHST01IW-TRIGGERS.INVALID-FROM == "Y")
        VHCL01IW-MSG.MESSAGE = " THE FROM CONSIST IS INVALID";
        VHST01IW-TRIGGERS.INVALID-FROM = " ";
    end
    if (VHST01IW-TRIGGERS.INVALID-TO == "Y")
        VHCL01IW-MSG.MESSAGE = " THE TO CONSIST NO CANNOT BE LESS THAN FROM CONSIST NO";
        VHST01IW-TRIGGERS.INVALID-TO = " ";
    end
end 

