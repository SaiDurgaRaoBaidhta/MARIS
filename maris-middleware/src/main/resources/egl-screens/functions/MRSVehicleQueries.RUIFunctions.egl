Function VHYS05IS-TYPE-CHK () 
    LOOP-INDEX = 1;
    HOLD-CARS-T = 0;
    HOLD-CARS-A = 0;
    HOLD-CARS-B = 0;
    HOLD-CARS-C = 0;
    HOLD-CARS-D = 0;
    HOLD-CARS-E = 0;
    HOLD-CARS-L = 0;
    HOLD-CARS-M = 0;
    HOLD-CARS-K = 0;
    REV-SERVICE-A = 0;
    REV-SERVICE-B = 0;
    REV-SERVICE-C = 0;
    REV-SERVICE-D = 0;
    REV-SERVICE-E = 0;
    REV-SERVICE-L = 0;
    REV-SERVICE-M = 0;
    REV-SERVICE-K = 0;
    REV-SERVICE-T = 0;
    TOTAL-MAINT-A = 0;
    TOTAL-MAINT-B = 0;
    TOTAL-MAINT-C = 0;
    TOTAL-MAINT-D = 0;
    TOTAL-MAINT-E = 0;
    TOTAL-MAINT-L = 0;
    TOTAL-MAINT-M = 0;
    TOTAL-MAINT-K = 0;
    TOTAL-MAINT-T = 0;
    WARRANTY-A = 0;
    WARRANTY-B = 0;
    WARRANTY-C = 0;
    WARRANTY-D = 0;
    WARRANTY-E = 0;
    WARRANTY-L = 0;
    WARRANTY-M = 0;
    WARRANTY-K = 0;
    WARRANTY-T = 0;
    UNSCHD-MAIN-A = 0;
    UNSCHD-MAIN-B = 0;
    UNSCHD-MAIN-C = 0;
    UNSCHD-MAIN-D = 0;
    UNSCHD-MAIN-E = 0;
    UNSCHD-MAIN-L = 0;
    UNSCHD-MAIN-M = 0;
    UNSCHD-MAIN-K = 0;
    UNSCHD-MAIN-T = 0;
    WAITPART-UM-A = 0;
    WAITPART-UM-B = 0;
    WAITPART-UM-C = 0;
    WAITPART-UM-D = 0;
    WAITPART-UM-E = 0;
    WAITPART-UM-L = 0;
    WAITPART-UM-M = 0;
    WAITPART-UM-K = 0;
    WAITPART-UM-T = 0;
    PREVEN-MAIN-A = 0;
    PREVEN-MAIN-B = 0;
    PREVEN-MAIN-C = 0;
    PREVEN-MAIN-D = 0;
    PREVEN-MAIN-E = 0;
    PREVEN-MAIN-L = 0;
    PREVEN-MAIN-M = 0;
    PREVEN-MAIN-K = 0;
    PREVEN-MAIN-T = 0;
    ENGRNG-HOLD-A = 0;
    ENGRNG-HOLD-B = 0;
    ENGRNG-HOLD-C = 0;
    ENGRNG-HOLD-D = 0;
    ENGRNG-HOLD-E = 0;
    ENGRNG-HOLD-L = 0;
    ENGRNG-HOLD-M = 0;
    ENGRNG-HOLD-K = 0;
    ENGRNG-HOLD-T = 0;
    MODIFY-CARS-A = 0;
    MODIFY-CARS-B = 0;
    MODIFY-CARS-C = 0;
    MODIFY-CARS-D = 0;
    MODIFY-CARS-E = 0;
    MODIFY-CARS-L = 0;
    MODIFY-CARS-M = 0;
    MODIFY-CARS-K = 0;
    MODIFY-CARS-T = 0;
    MISCEL-HOLD-A = 0;
    MISCEL-HOLD-B = 0;
    MISCEL-HOLD-C = 0;
    MISCEL-HOLD-D = 0;
    MISCEL-HOLD-E = 0;
    MISCEL-HOLD-L = 0;
    MISCEL-HOLD-M = 0;
    MISCEL-HOLD-K = 0;
    MISCEL-HOLD-T = 0;
    GO-AVAIL-A = 0;
    GO-AVAIL-B = 0;
    GO-AVAIL-C = 0;
    GO-AVAIL-D = 0;
    GO-AVAIL-E = 0;
    GO-AVAIL-L = 0;
    GO-AVAIL-M = 0;
    GO-AVAIL-K = 0;
    GO-AVAIL-T = 0;
    TOTAL-FLEET-A = 0;
    TOTAL-FLEET-B = 0;
    TOTAL-FLEET-C = 0;
    TOTAL-FLEET-D = 0;
    TOTAL-FLEET-E = 0;
    TOTAL-FLEET-L = 0;
    TOTAL-FLEET-M = 0;
    TOTAL-FLEET-K = 0;    
    TOTAL-FLEET-T = 0;
    while ((LOOP-INDEX <= TOTAL-CAR-COUNT))
        if (VHYS05A_DATA.CAR-TYPE-1[LOOP-INDEX] == "A")
            VHYS05IS-TYPE-A(); 
        else
            if (VHYS05A_DATA.CAR-TYPE-1[LOOP-INDEX] == "B")
                VHYS05IS-TYPE-B(); 
            else
                if (VHYS05A_DATA.CAR-TYPE-1[LOOP-INDEX] == "C")
                    VHYS05IS-TYPE-C(); 
                end
                if (VHYS05A_DATA.CAR-TYPE-1[LOOP-INDEX] == "D")
                    VHYS05IS-TYPE-D(); 
                else
                    if (VHYS05A_DATA.CAR-TYPE-1[LOOP-INDEX] == "E")
                    	VHYS05IS-TYPE-E(); 
                    else
                    	if (VHYS05A_DATA.CAR-TYPE-1[LOOP-INDEX] == "L")
		                    VHYS05IS-TYPE-L(); 
		                else
		                    if (VHYS05A_DATA.CAR-TYPE-1[LOOP-INDEX] == "M")
		                    	VHYS05IS-TYPE-M(); 
		                    end         
                		end  
                    end         
                end                
            end
        end
        if (VHYS05A_DATA.CAR-TYPE-1[LOOP-INDEX] == "K")
        	VHYS05IS-TYPE-K(); 
        end  
        LOOP-INDEX = LOOP-INDEX + 1;
    end


  
    CAR-A-DATA[1] = TOTAL-FLEET-A;
    CAR-B-DATA[1] = TOTAL-FLEET-B;
    CAR-C-DATA[1] = TOTAL-FLEET-C;
    CAR-D-DATA[1] = TOTAL-FLEET-D;
    CAR-E-DATA[1] = TOTAL-FLEET-E;
    CAR-L-DATA[1] = TOTAL-FLEET-L;
    CAR-M-DATA[1] = TOTAL-FLEET-M;
    CAR-K-DATA[1] = TOTAL-FLEET-K;
    CAR-TOTAL-DATA[1] = TOTAL-FLEET-T;

  
    CAR-A-DATA[2] = HOLD-CARS-A;
    CAR-B-DATA[2] = HOLD-CARS-B;
    CAR-C-DATA[2] = HOLD-CARS-C;
    CAR-D-DATA[2] = HOLD-CARS-D;
    CAR-E-DATA[2] = HOLD-CARS-E;
    CAR-L-DATA[2] = HOLD-CARS-L;
    CAR-M-DATA[2] = HOLD-CARS-M;
    CAR-K-DATA[2] = HOLD-CARS-K;
    CAR-TOTAL-DATA[2] = HOLD-CARS-T;
    CAR-TYPE-DATA[3] = "Adjusted Home Yrd Flt";
    CAR-A-DATA[3] = TOTAL-FLEET-A - HOLD-CARS-A;
    CAR-B-DATA[3] = TOTAL-FLEET-B - HOLD-CARS-B;
    CAR-C-DATA[3] = TOTAL-FLEET-C - HOLD-CARS-C;
    CAR-D-DATA[3] = TOTAL-FLEET-D - HOLD-CARS-D;
    CAR-E-DATA[3] = TOTAL-FLEET-E - HOLD-CARS-E;
    CAR-L-DATA[3] = TOTAL-FLEET-L - HOLD-CARS-L;
    CAR-M-DATA[3] = TOTAL-FLEET-M - HOLD-CARS-M;
    CAR-K-DATA[3] = TOTAL-FLEET-K - HOLD-CARS-K;
    CAR-TOTAL-DATA[3] = TOTAL-FLEET-T - HOLD-CARS-T;

  

  
    CAR-A-DATA[5] = UNSCHD-MAIN-A;
    CAR-B-DATA[5] = UNSCHD-MAIN-B;
    CAR-C-DATA[5] = UNSCHD-MAIN-C;
    CAR-D-DATA[5] = UNSCHD-MAIN-D;
    CAR-E-DATA[5] = UNSCHD-MAIN-E;
    CAR-L-DATA[5] = UNSCHD-MAIN-L;
    CAR-M-DATA[5] = UNSCHD-MAIN-M;
    CAR-K-DATA[5] = UNSCHD-MAIN-K;
    CAR-TOTAL-DATA[5] = UNSCHD-MAIN-T;

  
    CAR-A-DATA[6] = WAITPART-UM-A;
    CAR-B-DATA[6] = WAITPART-UM-B;
    CAR-C-DATA[6] = WAITPART-UM-C;
    CAR-D-DATA[6] = WAITPART-UM-D;
    CAR-E-DATA[6] = WAITPART-UM-E;
    CAR-L-DATA[6] = WAITPART-UM-L;
    CAR-M-DATA[6] = WAITPART-UM-M;
    CAR-K-DATA[6] = WAITPART-UM-K;
    CAR-TOTAL-DATA[6] = WAITPART-UM-T;

  
    CAR-A-DATA[7] = PREVEN-MAIN-A;
    CAR-B-DATA[7] = PREVEN-MAIN-B;
    CAR-C-DATA[7] = PREVEN-MAIN-C;
    CAR-D-DATA[7] = PREVEN-MAIN-D;
    CAR-E-DATA[7] = PREVEN-MAIN-E;
    CAR-L-DATA[7] = PREVEN-MAIN-L;
    CAR-M-DATA[7] = PREVEN-MAIN-M;
    CAR-K-DATA[7] = PREVEN-MAIN-K;
    CAR-TOTAL-DATA[7] = PREVEN-MAIN-T;

  

  
    CAR-A-DATA[8] = WARRANTY-A;
    CAR-B-DATA[8] = WARRANTY-B;
    CAR-C-DATA[8] = WARRANTY-C;
    CAR-D-DATA[8] = WARRANTY-D;
    CAR-E-DATA[8] = WARRANTY-E;
    CAR-L-DATA[8] = WARRANTY-L;
    CAR-M-DATA[8] = WARRANTY-M;
    CAR-K-DATA[8] = WARRANTY-K;
    CAR-TOTAL-DATA[8] = WARRANTY-T;


  
    CAR-A-DATA[9] = ENGRNG-HOLD-A;
    CAR-B-DATA[9] = ENGRNG-HOLD-B;
    CAR-C-DATA[9] = ENGRNG-HOLD-C;
    CAR-D-DATA[9] = ENGRNG-HOLD-D;
    CAR-E-DATA[9] = ENGRNG-HOLD-E;
    CAR-L-DATA[9] = ENGRNG-HOLD-L;
    CAR-M-DATA[9] = ENGRNG-HOLD-M;
    CAR-K-DATA[9] = ENGRNG-HOLD-K;
    CAR-TOTAL-DATA[9] = ENGRNG-HOLD-T;

  
    CAR-A-DATA[10] = MODIFY-CARS-A;
    CAR-B-DATA[10] = MODIFY-CARS-B;
    CAR-C-DATA[10] = MODIFY-CARS-C;
    CAR-D-DATA[10] = MODIFY-CARS-D;
    CAR-E-DATA[10] = MODIFY-CARS-E;
    CAR-L-DATA[10] = MODIFY-CARS-L;
    CAR-M-DATA[10] = MODIFY-CARS-M;
    CAR-K-DATA[10] = MODIFY-CARS-K;
    CAR-TOTAL-DATA[10] = MODIFY-CARS-T;

  
    CAR-A-DATA[11] = MISCEL-HOLD-A;
    CAR-B-DATA[11] = MISCEL-HOLD-B;
    CAR-C-DATA[11] = MISCEL-HOLD-C;
    CAR-D-DATA[11] = MISCEL-HOLD-D;
    CAR-E-DATA[11] = MISCEL-HOLD-E;
    CAR-L-DATA[11] = MISCEL-HOLD-L;
    CAR-M-DATA[11] = MISCEL-HOLD-M;
    CAR-K-DATA[11] = MISCEL-HOLD-K;
    CAR-TOTAL-DATA[11] = MISCEL-HOLD-T;

  

  
    CAR-A-DATA[13] = UNSCHD-MAIN-A + WAITPART-UM-A + PREVEN-MAIN-A + WARRANTY-A + ENGRNG-HOLD-A + MODIFY-CARS-A + MISCEL-HOLD-A;
    CAR-B-DATA[13] = UNSCHD-MAIN-B + WAITPART-UM-B + PREVEN-MAIN-B + WARRANTY-B + ENGRNG-HOLD-B + MODIFY-CARS-B + MISCEL-HOLD-B;
    CAR-C-DATA[13] = UNSCHD-MAIN-C + WAITPART-UM-C + PREVEN-MAIN-C + WARRANTY-C + ENGRNG-HOLD-C + MODIFY-CARS-C + MISCEL-HOLD-C;
    CAR-D-DATA[13] = UNSCHD-MAIN-D + WAITPART-UM-D + PREVEN-MAIN-D + WARRANTY-D + ENGRNG-HOLD-D + MODIFY-CARS-D + MISCEL-HOLD-D;
    CAR-E-DATA[13] = UNSCHD-MAIN-E + WAITPART-UM-E + PREVEN-MAIN-E + WARRANTY-E + ENGRNG-HOLD-E + MODIFY-CARS-E + MISCEL-HOLD-E;
    CAR-L-DATA[13] = UNSCHD-MAIN-L + WAITPART-UM-L + PREVEN-MAIN-L + WARRANTY-L + ENGRNG-HOLD-L + MODIFY-CARS-L + MISCEL-HOLD-L;
    CAR-M-DATA[13] = UNSCHD-MAIN-M + WAITPART-UM-M + PREVEN-MAIN-M + WARRANTY-M + ENGRNG-HOLD-M + MODIFY-CARS-M + MISCEL-HOLD-M;
    CAR-K-DATA[13] = UNSCHD-MAIN-K + WAITPART-UM-K + PREVEN-MAIN-K + WARRANTY-K + ENGRNG-HOLD-K + MODIFY-CARS-K + MISCEL-HOLD-K;
    CAR-TOTAL-DATA[13] = UNSCHD-MAIN-T + WAITPART-UM-T + PREVEN-MAIN-T + WARRANTY-T + ENGRNG-HOLD-T + MODIFY-CARS-T + MISCEL-HOLD-T;

  

  
    CAR-A-DATA[15] = CAR-A-DATA[3] - CAR-A-DATA[13];
    CAR-B-DATA[15] = CAR-B-DATA[3] - CAR-B-DATA[13];
    CAR-C-DATA[15] = CAR-C-DATA[3] - CAR-C-DATA[13];
    CAR-D-DATA[15] = CAR-D-DATA[3] - CAR-D-DATA[13];
    CAR-E-DATA[15] = CAR-E-DATA[3] - CAR-E-DATA[13];
    CAR-L-DATA[15] = CAR-L-DATA[3] - CAR-L-DATA[13];
    CAR-M-DATA[15] = CAR-M-DATA[3] - CAR-M-DATA[13];
    CAR-K-DATA[15] = CAR-K-DATA[3] - CAR-K-DATA[13];
    CAR-TOTAL-DATA[15] = CAR-TOTAL-DATA[3] - CAR-TOTAL-DATA[13];

  
    CAR-A-DATA[16] = REV-SERVICE-A;
    CAR-B-DATA[16] = REV-SERVICE-B;
    CAR-C-DATA[16] = REV-SERVICE-C;
    CAR-D-DATA[16] = REV-SERVICE-D;
