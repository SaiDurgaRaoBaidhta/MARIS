			                        		    	VHCL02B_DATA.SOFT_VER7[X] = VHCL02C_DATA.SOFT_VER[Y7];
		                        		    		VHCL02B_DATA.SOFT_VER8[X] = VHCL02C_DATA.SOFT_VER[Y8];
	                        		    			VHCL02B_DATA.SOFT_VER9[X] = VHCL02C_DATA.SOFT_VER[Y9];
                        		    			    VHCL02B_DATA.SOFT_VER10[X] = VHCL02C_DATA.SOFT_VER[Y10];
                        		    			                                                    
                                                    VHCL02B_DATA.HOME-YRD-1[X] = VHCL02C_DATA.HOME-YRD[Y1];
                                                    VHCL02B_DATA.HOME-YRD-2[X] = VHCL02C_DATA.HOME-YRD[Y2];
                                                    VHCL02B_DATA.HOME-YRD-3[X] = VHCL02C_DATA.HOME-YRD[Y3];
                                                    VHCL02B_DATA.HOME-YRD-4[X] = VHCL02C_DATA.HOME-YRD[Y4];
