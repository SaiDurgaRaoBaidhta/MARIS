    XXEXT_CALL_Level77Items.UEXTNAM = "VHST01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHST011";

    
    try
        call "VHST011"(XDCONTROL, VHST011_CRIT, VHST011_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
            VHST01IS-PASSVALUE.SUBMIT = "Y";
        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHST01IS-VALID () 
    VHST01IW.VALID = "Y";
    if (VHST01IW.CON-FROM != "ALL")
        if (VHST01IW.CON-FROM-N <= 0)
            VHST01IW-TRIGGERS.INVALID-FROM = "Y";
            VHST01IW.VALID = "N";
        else
            if (VHST01IW.CON-TO-N != 0 &&
             VHST01IW.CON-TO-N < VHST01IW.CON-FROM-N)
                VHST01IW-TRIGGERS.INVALID-TO = "Y";
                VHST01IW.VALID = "N";
            end
        end
    end

  
    if (VHST01IW.CON-TO == "    ")
        VHST01IW.CON-TO = VHST01IW.CON-FROM;
    end
    if (VHST01IW.CON-FROM == "ALL")
        VHST01IW.CON-FROM = "100";
        VHST01IW.CON-TO = "999";
    end
    if (VHST01IW.VALID == "Y")
        VHST01IW-TRIGGERS.RUN-DISPLAY = "Y";
    end
end 

Function VHST01IS-VALID-X () 
    VHST01IW.VALID = "Y";
    if (VHST01IW.CON-FROM-N <= 0)
        VHST01IW-TRIGGERS.INVALID-FROM = "Y";
        VHST01IW.VALID = "N";
    else
        if (VHST01IW.CON-TO-N != 0 &&
         VHST01IW.CON-FROM-N < 100 &&
         VHST01IW.CON-FROM-N > 999)
            VHST01IW-TRIGGERS.INVALID-FROM = "Y";
            VHST01IW.VALID = "N";
        end
    end
    if (VHST01IW.VALID == "Y")
        VHST01IW-TRIGGERS.RUN-DISPLAY = "Y";
    end
end 

Function VHST02IS-DIS-DOWN () 
    VHST02IW-TRIGGERS.DISABLE-DOWN = "Y";
end 

Function VHST02IS-DIS-DOWN1 () 
    VHST02IW-TRIGGERS.ENABLE-DOWN = "Y";
end 

Function VHST02IS-DOWN () 
    VHST02IW-CNTS.BUTTON = "DOWN";
    VHST02IW-CNTS.PAGE = VHST02IW-CNTS.PAGE + 1;
    VHST02IW-TRIGGERS.ENABLE-UP = "Y";

  
    if (VHST02IW-CNTS.TOTAL-INT <= VHST02IW-CNTS.PAGE)
        VHST02IS-DIS-DOWN();
        VHST02IW-TRIGGERS.DISABLE-DOWN = "Y";
    end
end 

Function VHST02IS-GET-DATA ()
  
  
  
  
  
  
  
  
   
    VHST02IW-CNTS.CNT = 0;
    VHST02IW-CNTS.ROWS-RETURNED = 0;
    VHST02IW-CNTS.PAGE = 0;
    VHST02IW-CNTS.TOTAL-PAGES = 0;
    set VHST02IW-1 empty;
    set VHST02IW-2 empty;
    set VHST02IW-3 empty;
    set VHST02IW-4 empty;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHST02I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHST2A1";

    
    try
        call "VHST2A1"(XDCONTROL, VHST2A1_CRIT, VHST2A1_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  
  
            VHST02IW-CNTS.FIRST-TIME = "N";
            VHST02IW-CNTS.ROWS-RETURNED = XDCONTROL.UROWCNT;
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end

  
    if (VHST02IW-CNTS.ROWS-RETURNED > 0)
        VHST02IW-TRIGGERS.RUN-CALCS = "Y";
    end
end 

Function VHST02IS-LOAD () 
    VHST02IS-LOAD_1();
    VHST02IS-LOAD_2();
    VHST02IS-LOAD_3();
    VHST02IS-LOAD_4();
    VHST02IS-LOAD_5();
end 

Function VHST02IS-LOAD_1 ()
	 
    VHST02IW-COLOR.CON-WN-COLOR-1 = "white";
    VHST02IW-COLOR.CAR1-WN-COLOR-1 = "white";
    VHST02IW-COLOR.CAR2-WN-COLOR-1 = "white";
    VHST02IW-COLOR.CAR3-WN-COLOR-1 = "white";
    VHST02IW-COLOR.CAR4-WN-COLOR-1 = "white";
    VHST02IW-COLOR.CAR5-WN-COLOR-1 = "white";
    VHST02IW-COLOR.CAR6-WN-COLOR-1 = "white";
    VHST02IW-COLOR.CAR7-WN-COLOR-1 = "white";
    VHST02IW-COLOR.CAR8-WN-COLOR-1 = "white";
    VHST02IW-COLOR.CAR9-WN-COLOR-1 = "white";
    VHST02IW-COLOR.CAR10-WN-COLOR-1 = "white";
    VHST02IW-COLOR.CON-WN-COLOR-2 = "white";
    VHST02IW-COLOR.CAR1-WN-COLOR-2 = "white";
    VHST02IW-COLOR.CAR2-WN-COLOR-2 = "white";
    VHST02IW-COLOR.CAR3-WN-COLOR-2 = "white";
    VHST02IW-COLOR.CAR4-WN-COLOR-2 = "white";
    VHST02IW-COLOR.CAR5-WN-COLOR-2 = "white";
    VHST02IW-COLOR.CAR6-WN-COLOR-2 = "white";
    VHST02IW-COLOR.CAR7-WN-COLOR-2 = "white";
    VHST02IW-COLOR.CAR8-WN-COLOR-2 = "white";
    VHST02IW-COLOR.CAR9-WN-COLOR-2 = "white";
    VHST02IW-COLOR.CAR10-WN-COLOR-2 = "white";
    VHST02IW-COLOR.CON-WN-COLOR-3 = "white";
    VHST02IW-COLOR.CAR1-WN-COLOR-3 = "white";
    VHST02IW-COLOR.CAR2-WN-COLOR-3 = "white";
    VHST02IW-COLOR.CAR3-WN-COLOR-3 = "white";
    VHST02IW-COLOR.CAR4-WN-COLOR-3 = "white";
    VHST02IW-COLOR.CAR5-WN-COLOR-3 = "white";
    VHST02IW-COLOR.CAR6-WN-COLOR-3 = "white";
    VHST02IW-COLOR.CAR7-WN-COLOR-3 = "white";
    VHST02IW-COLOR.CAR8-WN-COLOR-3 = "white";
    VHST02IW-COLOR.CAR9-WN-COLOR-3 = "white";
    VHST02IW-COLOR.CAR10-WN-COLOR-3 = "white";
    VHST02IW-COLOR.CON-WN-COLOR-4 = "white";
    VHST02IW-COLOR.CAR1-WN-COLOR-4 = "white";
    VHST02IW-COLOR.CAR2-WN-COLOR-4 = "white";
    VHST02IW-COLOR.CAR3-WN-COLOR-4 = "white";
    VHST02IW-COLOR.CAR4-WN-COLOR-4 = "white";
    VHST02IW-COLOR.CAR5-WN-COLOR-4 = "white";
    VHST02IW-COLOR.CAR6-WN-COLOR-4 = "white";
    VHST02IW-COLOR.CAR7-WN-COLOR-4 = "white";
    VHST02IW-COLOR.CAR8-WN-COLOR-4 = "white";
    VHST02IW-COLOR.CAR9-WN-COLOR-4 = "white";
    VHST02IW-COLOR.CAR10-WN-COLOR-4 = "white";
    if (VHST02IW-CNTS.FIRST-TIME != "Y")

     
        VHST02IW-CNTS.IND = 1;
        VHST02IW-CNTS.CNT = 1;
        VHST02IW-CNTS.VAGen_HOLD[CNT] = VHST2A1_DATA.CONSIST[IND];
        while (IND <= UROWCNT)
            if (VHST02IW-CNTS.VAGen_HOLD[CNT] != VHST2A1_DATA.CONSIST[IND])
                VHST02IW-CNTS.CNT = VHST02IW-CNTS.CNT + 1;
                VHST02IW-CNTS.VAGen_HOLD[CNT] = VHST2A1_DATA.CONSIST[IND];
            end
            IND = IND + 1;
        end

  
  
        VHST02IW-CNTS.TOTAL-PAGES = CNT / 4;
        if (VHST02IW-CNTS.TOTAL-PAGES == 0)
            VHST02IW-CNTS.TOTAL-PAGES = 1;
             
        end
        if (VHST02IW-CNTS.TOTAL-REM != 0)
            VHST02IW-CNTS.TOTAL-PAGES = VHST02IW-CNTS.TOTAL-PAGES + 1;
        end
        VHST02IW-CNTS.FIRST-TIME = "Y";
        VHST02IW-CNTS.PAGE = 1;
        VHST02IW-CNTS.IND = 1;
        set VHST02IW-1 empty;
        set VHST02IW-2 empty;
        set VHST02IW-3 empty;
        set VHST02IW-4 empty;
    else
        VHST02IS-POSITION(); 
        set VHST02IW-1 empty;
        set VHST02IW-2 empty;
        set VHST02IW-3 empty;
        set VHST02IW-4 empty;
    end 


  
    if (VHST02IW-CNTS.PAGE == 1)
        VHST02IW-TRIGGERS.DISABLE-UP = "Y";
    else
        VHST02IW-TRIGGERS.ENABLE-UP = "Y";
    end
    if (VHST02IW-CNTS.TOTAL-INT == 1)
        VHST02IS-DIS-DOWN();
    else
        VHST02IS-DIS-DOWN1();
    end
end

Function VHST02IS-LOAD_2 ()
	
   
    if (IND <= UROWCNT)
        VHST02IW-1.CONSIST = VHST2A1_DATA.CONSIST[IND];
        VHST02IW-1.ORIGIN = VHST2A1_DATA.ORIGIN-LOC[IND];
        if (VHST2A1_DATA.SCANNER-DIR[IND] != " ")
            VHST02IW-1.MSG-LOC = VHST2A1_DATA.MSG-LOC[IND];
            VHST02IW-1.ORDER-FILLER = "-";
            VHST02IW-1.SCANNER-DIR = VHST2A1_DATA.SCANNER-DIR[IND];
        else
            VHST02IW-1.MSG-LOC = VHST2A1_DATA.MSG-LOC[IND];
            VHST02IW-1.ORDER-FILLER = " ";
            VHST02IW-1.SCANNER-DIR = " ";
        end
        VHST02IW-1.ORIENT-OF-CARS = VHST2A1_DATA.ORIENT-OF-CARS[IND];
        if (VHST02IW-1.ORIGIN == "HY")
            VHST02IW-1.ORIGIN = "Hayward";
        end
        if (VHST02IW-1.ORIGIN == "DY")
            VHST02IW-1.ORIGIN = "Daly City";
        end
        if (VHST02IW-1.ORIGIN == "RY")
            VHST02IW-1.ORIGIN = "Richmond";
        end
        if (VHST02IW-1.ORIGIN == "CY")
            VHST02IW-1.ORIGIN = "Concord";
        end
        VHST02IW-1.DATE-INSRV = VHST2A1_DATA.DATE-INSRV-REV[IND];
        XXDATEW.DATE-YYYY-MM-DD = VHST02IW-1.DATE-INSRV;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHST02IW-1.DATE-INSRV = XXDATEW.DATE-MM-DD-YYYY;
        VHST02IW-1.TIME-INSRV = VHST2A1_DATA.TIME-INSRV[IND];

  
        VHST02IW-1.TI-1 = " ";
        if (VHST02IW-1.CONSIST == VHST2A1_DATA.CONSIST[IND])
            if (VHST2A1_DATA.CON-STAT[IND] == "CON" || VHST2A1_DATA.TRAIN-INCD-IND[IND] == "Y")
                VHST02IW-1.TI-1 = "TI";
                VHST02IW-COLOR.CAR1-COLOR-1 = "RED";
                VHST02IW-COLOR.CAR2-COLOR-1 = "RED";
                VHST02IW-COLOR.CAR3-COLOR-1 = "RED";
                VHST02IW-COLOR.CAR4-COLOR-1 = "RED";
                VHST02IW-COLOR.CAR5-COLOR-1 = "RED";
                VHST02IW-COLOR.CAR6-COLOR-1 = "RED";
                VHST02IW-COLOR.CAR7-COLOR-1 = "RED";
                VHST02IW-COLOR.CAR8-COLOR-1 = "RED";
                VHST02IW-COLOR.CAR9-COLOR-1 = "RED";
                VHST02IW-COLOR.CAR10-COLOR-1 = "RED";
            else
                VHST02IW-1.TI-1 = "  ";
                VHST02IW-COLOR.CAR1-COLOR-1 = "BLACK";
                VHST02IW-COLOR.CAR2-COLOR-1 = "BLACK";
                VHST02IW-COLOR.CAR3-COLOR-1 = "BLACK";
                VHST02IW-COLOR.CAR4-COLOR-1 = "BLACK";
                VHST02IW-COLOR.CAR5-COLOR-1 = "BLACK";
                VHST02IW-COLOR.CAR6-COLOR-1 = "BLACK";
                VHST02IW-COLOR.CAR7-COLOR-1 = "BLACK";
