    GO-CAR-TYPE-TOTAL[1] = GO-CONCORD-T;

  
    GO-CAR-TYPE-A[2] = GO-HAYWARD-A;
    GO-CAR-TYPE-B[2] = GO-HAYWARD-B;
    GO-CAR-TYPE-CW[2] = GO-HAYWARD-CW;
    GO-CAR-TYPE-CO[2] = GO-HAYWARD-CO;
    GO-CAR-TYPE-D[2] = GO-HAYWARD-D;
    GO-CAR-TYPE-E[2] = GO-HAYWARD-E;
    GO-CAR-TYPE-L[2] = GO-HAYWARD-L;
    GO-CAR-TYPE-M[2] = GO-HAYWARD-M;
    GO-CAR-TYPE-K[2] = GO-HAYWARD-K;
    GO-CAR-TYPE-TOTAL[2] = GO-HAYWARD-T;

  
