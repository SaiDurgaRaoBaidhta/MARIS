Function VHSV07IS-CLEAR () 
    VHSV07I_MESSAGE.MESG1 = "                                                                                   ";
    VHSV07I_MESSAGE.MESG2 = "                                                                                   ";
    VHSV07I_MESSAGE.MESG3 = "                                                                                   ";
    VHSV07IW.CAR-NO = "    ";
end 

Function VHSV07IS-DISPLAY ()
  

   
    if (VHSV07IW.CAR-NO == " ")
        VHSV07I_MESSAGE.MESG1 = " Invalid Car Number.";
        
  
  
    else
        if (VHSV07IW.CAR-NO < "0000" || VHSV07IW.CAR-NO not numeric)
            VHSV07I_MESSAGE.MESG1 = " Invalid Car Number.";
            
  
        else
            OK-SUBMIT = "Y";
        end
    end
end 

Function VHSV07IS-HARD-COPY () 
    if (VHSV07IW-TRIGGER.PRX-ID > 0)
        WS100IW-TRIGGER_Level77Items.ENABLE-HARD = "Y";
        VHSV07IW-TRIGGER.VTAM-NAME = WS70A01_DATA.VTAM-NAME[VHSV07IW-TRIGGER.PRX-ID];
    else
        WS100IW-TRIGGER_Level77Items.DISABLE-HARD = "Y";
    end
end 

Function VHSV07IS-INIT () 
    VHSV07IW.WS-CURRENT-DATE = VGVar.currentFormattedGregorianDate;
    try
        call "VHSV07A"(XDCONTROL, VHSV07A_CRIT, VHSV07A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHSV07IW.FROM-DATE = VHSV07A_DATA.FROM-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHSV07IW.FROM-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHSV07IW.FROM-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHSV07IW.FROM-DATE-FILLER1 = "-";
        VHSV07IW.FROM-DATE-FILLER2 = "-";
    end
    try
        call "VHSV07B"(XDCONTROL, VHSV07B_CRIT, VHSV07B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHSV07IW.TO-DATE = VHSV07B_DATA.TO-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHSV07IW.TO-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHSV07IW.TO-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHSV07IW.TO-DATE-FILLER1 = "-";
        VHSV07IW.TO-DATE-FILLER2 = "-";
    end
    VHSV07I_MESSAGE.MESG1 = "                                                                                   ";
    VHSV07I_MESSAGE.MESG2 = "                                                                                   ";
    VHSV07I_MESSAGE.MESG3 = "                                                                                   ";
end 

Function VHSV07IS-INIT-X ()
  
  
  
  
  
  
  
  


   
    XXEXT_CALL_Level77Items.UEXTNAM = "WS100I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS70A01";

    
    try
        call "WS70A01"(XDCONTROL, WS70A01_DATA);
    
    end
    

  
    MRSCommonCode.XXA0IS-CHECK_EXT();

  
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
  
  
  
  
            VHSV07I_MESSAGE.MESG1 = "INVALID PRINTER";
        end
    end
end 

Function VHSV07IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  

  
  
  
   
    if (VHSV07IW-TRIGGER.OK-SUBMIT == "Y")
  
  
  
  
  
  
        VHSV07C_CRIT.CAR-NO = VHSV07IW.CAR-NO;
        VHSV07C_CRIT.REPT-ID = VHSV07IW-TRIGGER.VTAM-NAME;

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHSV07I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHSV07C";

    
        try
            call "VHSV07C"(XDCONTROL, VHSV07C_CRIT, VHSV07C_DATA);
        
        end
        

       
        MRSCommonCode.XXA0IS-CHECK_EXT();

        
        if (XXEXT_CALL_Level77Items.URC == 0)

            
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
               
                VHSV07IW-TRIGGER.SUBMIT = "Y";
            else
                VHSV07I_MESSAGE.MESG1 = "INVALID PARAMETER LIST";
            end
        else

        end
    end
end 

Function VHSV07IS-SUBMIT-X () 
    VHSV07IW-TRIGGER.OK-SUBMIT = "Y";
    VHSV07IW.NULL-TO-ERROR = "N";
  
    if (VHSV07IW-TRIGGER.OK-SUBMIT == "N")

    else
        if (VHSV07IW-TRIGGER.INVALID-SYMP-TO == "Y")
            VHSV07IW-TRIGGER.OK-SUBMIT = "N";
        else
            if (VHSV07IW-TRIGGER.INVALID-SYMP-FROM == "Y")
                VHSV07IW-TRIGGER.OK-SUBMIT = "N";
            else
  				
  				
  				
                if (AFCXVLDW.NO-ERROR == "N")
                    VHSV07IW-TRIGGER.OK-SUBMIT = " ";
                else
                    VHSV07IW-TRIGGER.OK-SUBMIT = "Y ";
                end
            end
        end
    end
end 

