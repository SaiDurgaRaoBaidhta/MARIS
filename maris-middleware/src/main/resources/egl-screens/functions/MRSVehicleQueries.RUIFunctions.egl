Function VHCL02IS-INIT () 
    VHCL02IW-MSG.FINAL-MESSAGE = " ";
    set VHCL02IW-CNT empty;
    set VHCL02IW-CON-1 empty;
    set VHCL02IW-CON-2 empty;
    set VHCL02IW-CON-3 empty;
    set VHCL02IW-CON-4 empty;
    DISABLE-PRV-PAGE = "Y";
    DISABLE-NXT-PAGE = "Y";
    VHCL02IS-INI-COLOR();


  
  
  
  
    VHCL02IS-GET-DATA2();
end 

Function VHCL02IS-LOAD-PAGE () 
try
    set VHCL02IW-CON-1 empty;
    set VHCL02IW-CON-2 empty;
    set VHCL02IW-CON-3 empty;
    set VHCL02IW-CON-4 empty;
    VHCL02IS-INI-COLOR();
    X = ((PAGE-CNT - 1) * 4) + 1;
  
    VHCL02IW-CON-1.CONSIST = VHCL02B_DATA.CONSIST[X];
    VHCL02IW-CON-1.ORIGIN-LOC = VHCL02B_DATA.ORIGIN-LOC[X];
    VHCL02IW-CON-1.OUTSRV-LOC = VHCL02B_DATA.OUTSRV-LOC[X];
    VHCL02IW-CON-1.TIME-INSRV = VHCL02B_DATA.TIME-INSRV[X];
    VHCL02IW-CON-1.TIME-OUTSRV = VHCL02B_DATA.TIME-OUTSRV[X];
    VHCL02IW-CON-1.DATE-INSRV-REV = VHCL02B_DATA.DATE-INSRV-REV[X];
    VHCL02IW-CON-1.RUN-TIME-HRS = VHCL02B_DATA.RUN-TIME-HRS[X];
    VHCL02IW-CON-1.RUN-SEP = ":";
    VHCL02IW-CON-1.RUN-TIME-MIN = VHCL02B_DATA.RUN-TIME-MIN[X];
    VHCL02IW-CON-1.ORIGIN-LOC-SWAP = VHCL02B_DATA.ORIGIN-LOC-SWAP[X];
    if (VHCL02B_DATA.CON-NO-SWAP[X] == " ")
        VHCL02IW-CON-1.CONSIST-SWAP = " ";
    else
        VHCL02IW-CON-1.CONSIST-SWAP = VHCL02B_DATA.CONSIST-SWAP[X];
    end
    if (VHCL02B_DATA.CON-NO-SPLIT[X] == " ")
        VHCL02IW-CON-1.CONSIST-SPLIT = " ";
    else
        VHCL02IW-CON-1.CONSIST-SPLIT = VHCL02B_DATA.CONSIST-SPLIT[X];
    end
    VHCL02IW-CON-1.WASH-IND = VHCL02B_DATA.WASH-IND[X];
    VHCL02IW-CON-1.CAR-CNT = VHCL02B_DATA.EXACT-ROW-CNT[X];
    
  
    VHCL02IS-COLOR1();
    VHCL02IW-CON-1.CAR-NO-1 = VHCL02B_DATA.CAR-NO-1[X];
    VHCL02IW-CON-1.CAR-NO-2 = VHCL02B_DATA.CAR-NO-2[X];
    VHCL02IW-CON-1.CAR-NO-3 = VHCL02B_DATA.CAR-NO-3[X];
    VHCL02IW-CON-1.CAR-NO-4 = VHCL02B_DATA.CAR-NO-4[X];
    VHCL02IW-CON-1.CAR-NO-5 = VHCL02B_DATA.CAR-NO-5[X];
    VHCL02IW-CON-1.CAR-NO-6 = VHCL02B_DATA.CAR-NO-6[X];
    VHCL02IW-CON-1.CAR-NO-7 = VHCL02B_DATA.CAR-NO-7[X];
    VHCL02IW-CON-1.CAR-NO-8 = VHCL02B_DATA.CAR-NO-8[X];
    VHCL02IW-CON-1.CAR-NO-9 = VHCL02B_DATA.CAR-NO-9[X];
    VHCL02IW-CON-1.CAR-NO-10 = VHCL02B_DATA.CAR-NO-10[X];
    
    VHCL02IW-CON-1.CAR_EXT-1 = VHCL02B_DATA.CAR-NO-1[X];
    VHCL02IW-CON-1.CAR_EXT-2 = VHCL02B_DATA.CAR-NO-2[X];
    VHCL02IW-CON-1.CAR_EXT-3 = VHCL02B_DATA.CAR-NO-3[X];
    VHCL02IW-CON-1.CAR_EXT-4 = VHCL02B_DATA.CAR-NO-4[X];
    VHCL02IW-CON-1.CAR_EXT-5 = VHCL02B_DATA.CAR-NO-5[X];
    VHCL02IW-CON-1.CAR_EXT-6 = VHCL02B_DATA.CAR-NO-6[X];
    VHCL02IW-CON-1.CAR_EXT-7 = VHCL02B_DATA.CAR-NO-7[X];
    VHCL02IW-CON-1.CAR_EXT-8 = VHCL02B_DATA.CAR-NO-8[X];
    VHCL02IW-CON-1.CAR_EXT-9 = VHCL02B_DATA.CAR-NO-9[X];
    VHCL02IW-CON-1.CAR_EXT-10 = VHCL02B_DATA.CAR-NO-10[X];
    
    
    if (strLib.indexOf(VHCL02B_DATA.SOFT_VER1[X], "$")>0)
		VHCL02IW-CON-1.CAR_EXT-1 = "$" + strLib.clip( VHCL02IW-CON-1.CAR-NO-1, 0);
	end
	
   if (strLib.indexOf(VHCL02B_DATA.SOFT_VER2[X], "$")>0 ) 
		VHCL02IW-CON-1.CAR_EXT-2 = "$" + strLib.clip( VHCL02IW-CON-1.CAR-NO-2, 0);
	end  
	
	if (strLib.indexOf(VHCL02B_DATA.SOFT_VER3[X], "$")>0 ) 
		VHCL02IW-CON-1.CAR_EXT-3 = "$" + strLib.clip( VHCL02IW-CON-1.CAR-NO-3, 0);
	end
	
   if (strLib.indexOf(VHCL02B_DATA.SOFT_VER4[X], "$")>0 ) 
		VHCL02IW-CON-1.CAR_EXT-4 = "$" + strLib.clip( VHCL02IW-CON-1.CAR-NO-4, 0);
	end 
	
	if (strLib.indexOf(VHCL02B_DATA.SOFT_VER5[X], "$")>0 ) 
		VHCL02IW-CON-1.CAR_EXT-5 = "$" + strLib.clip( VHCL02IW-CON-1.CAR-NO-5, 0);
	end 
	
   if (strLib.indexOf(VHCL02B_DATA.SOFT_VER6[X], "$")>0 ) 
