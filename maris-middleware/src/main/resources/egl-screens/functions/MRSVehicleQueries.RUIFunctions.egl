Function VHFO010S-INIT () 
    VHFO01IW.WS-CURRENT-DATE = VGVar.currentFormattedGregorianDate;
    try
        call "VHFO01A"(XDCONTROL, VHFO01A_CRIT, VHFO01A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHFO01IW.FROM-DATE = VHFO01A_DATA.FROM-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHFO01IW.FROM-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHFO01IW.FROM-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHFO01IW.FROM-DATE-FILLER1 = "-";
        VHFO01IW.FROM-DATE-FILLER2 = "-";
    end
    try
        call "VHFO01B"(XDCONTROL, VHFO01B_CRIT, VHFO01B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHFO01IW.TO-DATE = VHFO01B_DATA.TO-DATE;
        XXDATEW.DATE-YYYY-MM-DD = VHFO01IW.TO-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHFO01IW.TO-DATE = XXDATEW.DATE-MM-DD-YYYY;
        VHFO01IW.TO-DATE-FILLER1 = "-";
        VHFO01IW.TO-DATE-FILLER2 = "-";
    end
    VHFO01I_MESSAGE.MESG1 = "                                                                                   ";
    VHFO01I_MESSAGE.MESG2 = "                                                                                   ";
    VHFO01I_MESSAGE.MESG3 = "                                                                                   ";
end 

