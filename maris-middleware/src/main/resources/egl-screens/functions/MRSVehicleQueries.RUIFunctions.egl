                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            VHCL02IW-TRIGGER.DATA-MOVED = "Y";
            if (MAX-POSN-NO[X] == 0)
                POSN-CNT = 1;
            else
                POSN-CNT = MAX-POSN-NO[X];
            end
            Y1 = Y1 + POSN-CNT;
            X = X + 1;
        else
            VHCL02IW-MSG.FINAL-MESSAGE = "Database has been changed.  Please re-select Consist range.";
      
            X = VHCL02IW-CNT.CON-ROW-CNT + 1;
        end
    end
end 

Function VHCL02IS-PAGE-CNT () 
    VHCL02IW-CNT.TOT-PAGE-CNT = 0;
    VHCL02IW-CNT.TOT-PAGE-CNT = VHCL02IW-CNT.CON-ROW-CNT / 4.00;
    if (VHCL02IW-CNT.REMAINDER == 0)

    else
        VHCL02IW-CNT.TOT-PAGE = VHCL02IW-CNT.TOT-PAGE + 1;
    end
    if (VHCL02IW-CNT.TOT-PAGE == 1)
        DISABLE-NXT-PAGE = "Y";
        DISABLE-PRV-PAGE = "Y";
    else
        ENABLE-NXT-PAGE = "Y";
        DISABLE-PRV-PAGE = "Y";
    end
end 

Function VHCL02IS-PAGE-DOWN () 
    if (PAGE-CNT < TOT-PAGE)
        PAGE-CNT = PAGE-CNT + 1;
        if (PAGE-CNT == TOT-PAGE)
            DISABLE-NXT-PAGE = "Y";
        else
            ENABLE-NXT-PAGE = "Y";
        end
        ENABLE-PRV-PAGE = "Y";
    end
    VHCL02IS-LOAD-PAGE();
end 

Function VHCL02IS-PAGE-UP () 
    if (PAGE-CNT > 1)
        PAGE-CNT = PAGE-CNT - 1;
        if (PAGE-CNT == 1)
            DISABLE-PRV-PAGE = "Y";
        else
            ENABLE-PRV-PAGE = "Y";
        end
        ENABLE-NXT-PAGE = "Y";
    end
    VHCL02IS-LOAD-PAGE();
end 

Function VHCO01I-SUBMIT ()
  
  
  
  
  
  
  
  
  
   
    VHCO01IS-VALID();
    VHCO011_CRIT.CON-NO-FROM = VHCO01IW.CON-FROM;
    VHCO011_CRIT.CON-NO-TO = VHCO01IW.CON-TO;
    VHCO011_CRIT.REPT-TYPE = VHCO01IW.VTAM-NAME;
    XXDATEW.DATE-MM-DD-YYYY = VHCO01IW.REV-DATE;
    XXDATEW.VAGen_FUNCTION = "YMD";
    MRSCommonCode.XXDATES-CONVERT();
    VHCO011_CRIT.DATE-INSRV-REV = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.DATE-MM-DD-YYYY = VHCO01IW.REV-DATE-TO;
    XXDATEW.VAGen_FUNCTION = "YMD";
    MRSCommonCode.XXDATES-CONVERT();
    VHCO011_CRIT.DATE-INSRV-REV-TO = XXDATEW.DATE-YYYY-MM-DD;


    
    XXEXT_CALL_Level77Items.UEXTNAM = "VEHDIR";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCO011";

    
    try
        call "VHCO011"(XDCONTROL, VHCO011_CRIT, VHCO011_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
            VHCO01IW-TRIGGERS.SUBMIT = "Y";
        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHCO01ID-MSG () 
    if (VHST01IW-TRIGGERS.INVALID-FROM == "Y")
        VHCO01IW-MSG.MESSAGE = " THE FROM CONSIST IS INVALID";
        VHST01IW-TRIGGERS.INVALID-FROM = " ";
    end
    if (VHST01IW-TRIGGERS.INVALID-TO == "Y")
        VHCO01IW-MSG.MESSAGE = " THE TO CONSIST NO CANNOT BE LESS THAN FROM CONSIST NO";
        VHST01IW-TRIGGERS.INVALID-TO = " ";
    end
end 

Function VHCO01IS-CLEAR () 
    set VHCO01IW empty;
    set VHCO01IW-MSG empty;
    VHCO01IW-TRIGGERS.DISABLE-HARD = "Y";
end 

Function VHCO01IS-HARD-COPY () 
    if (VHCO01IW.PRT-IDX > 0)
        VHCO01IW-TRIGGERS.ENABLE-HARD = "Y";
        VHCO01IW.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRT-IDX];
    else
        VHCO01IW-TRIGGERS.DISABLE-HARD = "Y";
    end
end 

Function VHCO01IS-INIT () 
    VHCO01IW.FIRST-TIME = "N";
    VHCO01IW.CNT = 0;
end 

Function VHCO01IS-PRINTER ()
  
  
  
  
  
  
  
  
   
    XXEXT_CALL_Level77Items.UEXTNAM = "WS100I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS70A01";

    
    try
        call "WS70A01"(XDCONTROL, WS70A01_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHCO01IS-VALID () 
    set VHCO01IW-MSG empty;
    VHCO01IW.VALID = "Y";
    if (VHCO01IW.CON-FROM != "ALL")
  
        if (VHCO01IW.CON-FROM <= 0)
            VHST01IW-TRIGGERS.INVALID-FROM = "Y";
            VHCO01IW.VALID = "N";
        else
            if (VHCO01IW.CON-TO-N != 0 &&
             VHCO01IW.CON-TO-N < VHCO01IW.CON-FROM-N)
                VHST01IW-TRIGGERS.INVALID-TO = "Y";
                VHCO01IW.VALID = "N";
            end
        end
    end

  
    if (VHCO01IW.CON-TO == "    ")
        VHCO01IW.CON-TO = VHCO01IW.CON-FROM;
    end
    if (VHCO01IW.CON-FROM == "ALL")
        VHCO01IW.CON-FROM = "100";
        VHCO01IW.CON-TO = "999";
    end
    if (VHCO01IW.VALID == "Y")
        VHST01IW-TRIGGERS.RUN-DISPLAY = "Y";
  
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHCO01IW.REV-DATE;
        MRSCommonCode.XXDATES-CONVERT();
        VHCO01IW.REV-DATE-DB2 = XXDATEW.DATE-YYYY-MM-DD;
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHCO01IW.REV-DATE-TO;
        MRSCommonCode.XXDATES-CONVERT();
        VHCO01IW.REV-DATE-DB2-TO = XXDATEW.DATE-YYYY-MM-DD;
    end
end 

Function VHCO1I-REV-DATE2 ()
  
  
  
  
  
  
  
  
  
  
  

  
  
  
  
  
  
  
  
  
  
  
  
  
  


  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHHPM1I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHHPMA3";

    
    try
        call "MRSVehiclePrevMaint.VHHPMA3"(XDCONTROL, VHHPMA3_CRIT, VHHPMA3_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end

  
    if (VHHPMA3_DATA.CURRENT-TIME >= VHHPMA3_DATA.TIME-REV-START)
        VHCO01IW.REV-DATE-DB2 = VHHPMA3_DATA.CURRENT-DATE;
    else
        VHCO01IW.REV-DATE-DB2 = VHHPMA3_DATA.YESTERDAY;
    end


  
  
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHST01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHSV011";

  
    try
        call "VHSV011"(XDCONTROL, VHSV011_DATA);
    
    end
    
    
    MRSCommonCode.XXA0IS-CHECK_EXT();
    
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHST01IW.DATE-LOW = VHSV011_DATA.FROM-DATE;
             
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end

  
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCO01IW.REV-DATE-DB2;
    MRSCommonCode.XXDATES-CONVERT();
    VHCO01-REVTO-DATE.REVENUE-DATE-TO = XXDATEW.DATE-MM-DD-YYYY;

  
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHSV011_DATA.FROM-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHCO01IW.REV-DATE = XXDATEW.DATE-MM-DD-YYYY;

  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHST01IW.DATE-LOW;
    MRSCommonCode.XXDATES-CONVERT();
    VHST01IW.DATE-LOW-DB2 = XXDATEW.DATE-YYYY-MM-DD;
end 

