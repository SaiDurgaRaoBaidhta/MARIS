    VHFR01IW-TRIGGER.LOAD-DATA = "Y";


  
    GO-CAR-TYPE-A[1] = GO-CONCORD-A;
    GO-CAR-TYPE-B[1] = GO-CONCORD-B;
    GO-CAR-TYPE-CW[1] = GO-CONCORD-CW;
