Function VHRC02IS-RET-DATA () 
    VHRC02IW.TOTAL-INCDS = 0;
    VHRC02A_CRIT.CAR-NO = VHRC02IW-PASSVALUE.CAR-NO;
    VHRC02A_CRIT.HOME-YRD = VHRC02IW-PASSVALUE.HOME-YRD;
    try
        call "VHRC02A"(XDCONTROL, VHRC02A_CRIT, VHRC02A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHRC02IW.TOTAL-INCDS = VHRC02A_DATA.TOTAL-INCDS;
        if (VHRC02IW.TOTAL-INCDS > 500)
            SHOW-FOOTER = "Y";
        else
            HIDE-FOOTER = "Y";
        end
        VHRC02IW-TRIGGER.LOAD-INCDS = "Y";
    else
        VHRC02IW-TRIGGER.LOAD-INCDS = "Y";
        HIDE-FOOTER = "Y";
        if (XDCONTROL.URC == 100)
            XXMESSAGE.UMSGCODE = "AFCR001";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

