    CAR-A-DATA[13] = UNSCHD-MAIN-A + WAITPART-UM-A + PREVEN-MAIN-A + WARRANTY-A + ENGRNG-HOLD-A + MODIFY-CARS-A + MISCEL-HOLD-A;
    CAR-B-DATA[13] = UNSCHD-MAIN-B + WAITPART-UM-B + PREVEN-MAIN-B + WARRANTY-B + ENGRNG-HOLD-B + MODIFY-CARS-B + MISCEL-HOLD-B;
