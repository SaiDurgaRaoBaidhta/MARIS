Function VHYS10IS-TYPE-CHK () 
    LOOP-INDEX = 1;
    HOLD-CARS-T = 0;
    HOLD-CARS-A = 0;
    HOLD-CARS-B = 0;
    HOLD-CARS-C = 0;
    HOLD-CARS-D = 0;
    HOLD-CARS-E = 0;
    HOLD-CARS-L = 0;
    HOLD-CARS-M = 0;
    HOLD-CARS-K = 0;
    REV-SERVICE-A = 0;
    REV-SERVICE-B = 0;
    REV-SERVICE-C = 0;
    REV-SERVICE-D = 0;
    REV-SERVICE-E = 0;
    REV-SERVICE-L = 0;
    REV-SERVICE-M = 0;
    REV-SERVICE-K = 0;
    REV-SERVICE-T = 0;
    TOTAL-MAINT-A = 0;
    TOTAL-MAINT-B = 0;
    TOTAL-MAINT-C = 0;
    TOTAL-MAINT-D = 0;
    TOTAL-MAINT-E = 0;
    TOTAL-MAINT-L = 0;
    TOTAL-MAINT-M = 0;
    TOTAL-MAINT-K = 0;
    TOTAL-MAINT-T = 0;
    WARRANTY-A = 0;
    WARRANTY-B = 0;
    WARRANTY-C = 0;
    WARRANTY-D = 0;
    WARRANTY-E = 0;
    WARRANTY-L = 0;
    WARRANTY-M = 0;
    WARRANTY-K = 0;
    WARRANTY-T = 0;
    UNSCHD-MAIN-A = 0;
    UNSCHD-MAIN-B = 0;
    UNSCHD-MAIN-C = 0;
    UNSCHD-MAIN-D = 0;
    UNSCHD-MAIN-E = 0;
    UNSCHD-MAIN-L = 0;
    UNSCHD-MAIN-M = 0;
    UNSCHD-MAIN-K = 0;
    UNSCHD-MAIN-T = 0;
    WAITPART-UM-A = 0;
    WAITPART-UM-B = 0;
    WAITPART-UM-C = 0;
    WAITPART-UM-D = 0;
    WAITPART-UM-E = 0;
    WAITPART-UM-L = 0;
    WAITPART-UM-M = 0;
    WAITPART-UM-K = 0;
    WAITPART-UM-T = 0;
    PREVEN-MAIN-A = 0;
    PREVEN-MAIN-B = 0;
    PREVEN-MAIN-C = 0;
    PREVEN-MAIN-D = 0;
    PREVEN-MAIN-E = 0;
    PREVEN-MAIN-L = 0;
    PREVEN-MAIN-M = 0;
    PREVEN-MAIN-K = 0;
    PREVEN-MAIN-T = 0;
    ENGRNG-HOLD-A = 0;
    ENGRNG-HOLD-B = 0;
    ENGRNG-HOLD-C = 0;
    ENGRNG-HOLD-D = 0;
    ENGRNG-HOLD-E = 0;
    ENGRNG-HOLD-L = 0;
    ENGRNG-HOLD-M = 0;
    ENGRNG-HOLD-K = 0;
    ENGRNG-HOLD-T = 0;
    MODIFY-CARS-A = 0;
    MODIFY-CARS-B = 0;
    MODIFY-CARS-C = 0;
    MODIFY-CARS-D = 0;
    MODIFY-CARS-E = 0;
    MODIFY-CARS-L = 0;
    MODIFY-CARS-M = 0;
    MODIFY-CARS-K = 0;
    MODIFY-CARS-T = 0;
    MISCEL-HOLD-A = 0;
    MISCEL-HOLD-B = 0;
    MISCEL-HOLD-C = 0;
    MISCEL-HOLD-D = 0;
    MISCEL-HOLD-E = 0;
    MISCEL-HOLD-L = 0;
    MISCEL-HOLD-M = 0;
    MISCEL-HOLD-K = 0;
    MISCEL-HOLD-T = 0;
    GO-AVAIL-A = 0;
    GO-AVAIL-B = 0;
    GO-AVAIL-C = 0;
    GO-AVAIL-D = 0;
    GO-AVAIL-E = 0;
    GO-AVAIL-L = 0;
    GO-AVAIL-M = 0;
    GO-AVAIL-K = 0;
    GO-AVAIL-T = 0;
    TOTAL-YARD-A = 0;
    TOTAL-YARD-B = 0;
    TOTAL-YARD-C = 0;
    TOTAL-YARD-D = 0;
    TOTAL-YARD-E = 0;
    TOTAL-YARD-L = 0;
    TOTAL-YARD-M = 0;
    TOTAL-YARD-K = 0;
    TOTAL-YARD-T = 0;
    while ((LOOP-INDEX <= TOTAL-CAR-COUNT))
        if (VHYS10A_DATA.CAR-TYPE-1[LOOP-INDEX] == "A")
            VHYS10IS-TYPE-A(); 
        else
            if (VHYS10A_DATA.CAR-TYPE-1[LOOP-INDEX] == "B")
                VHYS10IS-TYPE-B(); 
            else
                if (VHYS10A_DATA.CAR-TYPE-1[LOOP-INDEX] == "C")
                    VHYS10IS-TYPE-C();  
                end
                if (VHYS10A_DATA.CAR-TYPE-1[LOOP-INDEX] == "D")
                	VHYS10IS-TYPE-D(); 
                else
                	if (VHYS10A_DATA.CAR-TYPE-1[LOOP-INDEX] == "E")
                		VHYS10IS-TYPE-E(); 
                	else
                		if (VHYS10A_DATA.CAR-TYPE-1[LOOP-INDEX] == "L")
                			VHYS10IS-TYPE-L(); 
		                else
		                	if (VHYS10A_DATA.CAR-TYPE-1[LOOP-INDEX] == "M")
		                		VHYS10IS-TYPE-M(); 
		                	end
		                end
                	end
                end
            end
        end
        if (VHYS10A_DATA.CAR-TYPE-1[LOOP-INDEX] == "K")
    		VHYS10IS-TYPE-K(); 
    	end
        LOOP-INDEX = LOOP-INDEX + 1;
    end


  
    VHYS10IW.CAR-A-DATA[1] = TOTAL-YARD-A;
    VHYS10IW.CAR-B-DATA[1] = TOTAL-YARD-B;
