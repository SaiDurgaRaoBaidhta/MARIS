        HOLD-CARS-M = HOLD-CARS-M + 1;
        HOLD-CARS-T = HOLD-CARS-T + 1;
    else
        if (VHFR01A_DATA.WHERE-IS-CAR[LOOP-INDEX] == "CON")
            REV-SERVICE-M = REV-SERVICE-M + 1;
            REV-SERVICE-T = REV-SERVICE-T + 1;
        else
            TOTAL-MAINT-M = TOTAL-MAINT-M + 1;
            TOTAL-MAINT-T = TOTAL-MAINT-T + 1;
            if (VHFR01A_DATA.WAR-IND[LOOP-INDEX] == "Y" &&
             VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                WARRANTY-M = WARRANTY-M + 1;
                WARRANTY-T = WARRANTY-T + 1;
            else
                if (VHFR01A_DATA.WAR-IND[LOOP-INDEX] == "N" &&
                 VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                    UNSCHD-MAIN-M = UNSCHD-MAIN-M + 1;
                    UNSCHD-MAIN-T = UNSCHD-MAIN-T + 1;
                else
                    if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "AWPART")
                        WAITPART-UM-M = WAITPART-UM-M + 1;
                        WAITPART-UM-T = WAITPART-UM-T + 1;
                    else
                        if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "PM")
                            PREVEN-MAIN-M = PREVEN-MAIN-M + 1;
                            PREVEN-MAIN-T = PREVEN-MAIN-T + 1;
                        else
                            if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "ENGHLD")
                                ENGRNG-HOLD-M = ENGRNG-HOLD-M + 1;
                                ENGRNG-HOLD-T = ENGRNG-HOLD-T + 1;
                            else
                                if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "MODHLD")
                                    MODIFY-CARS-M = MODIFY-CARS-M + 1;
                                    MODIFY-CARS-T = MODIFY-CARS-T + 1;
                                else
                                    if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "MISC")
                                        MISCEL-HOLD-M = MISCEL-HOLD-M + 1;
                                        MISCEL-HOLD-T = MISCEL-HOLD-T + 1;
                                    else
                                        TOTAL-MAINT-M = TOTAL-MAINT-M - 1;
                                        TOTAL-MAINT-T = TOTAL-MAINT-T - 1;
                                        if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "GO" &&
                                         VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "USABLE" &&
                                         VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "ERROR")
                                            TOTAL-FLEET-M = TOTAL-FLEET-M - 1;
                                            TOTAL-FLEET-T = TOTAL-FLEET-T - 1;
                                        else
                                            GO-AVAIL-M = GO-AVAIL-M + 1;
                                            GO-AVAIL-T = GO-AVAIL-T + 1;
                                            if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "HY")
                                                GO-HAYWARD-M = GO-HAYWARD-M + 1;
                                                GO-HAYWARD-T = GO-HAYWARD-T + 1;
                                            else
                                                if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "CY")
                                                    GO-CONCORD-M = GO-CONCORD-M + 1;
                                                    GO-CONCORD-T = GO-CONCORD-T + 1;
                                                else
                                                    if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "RY")
                                                        GO-RICHMOND-M = GO-RICHMOND-M + 1;
                                                        GO-RICHMOND-T = GO-RICHMOND-T + 1;
                                                    else
                                                        if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "DY")
                                                            GO-DALYCITYY-M = GO-DALYCITYY-M + 1;
                                                            GO-DALYCITYY-T = GO-DALYCITYY-T + 1;
                                                        else
                                                            GO-OTHER-M = GO-OTHER-M + 1;
                                                            GO-OTHER-T = GO-OTHER-T + 1;
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHFR01IS-TYPE-K () 
    TOTAL-FLEET-K = TOTAL-FLEET-K + 1;
    TOTAL-FLEET-T = TOTAL-FLEET-T + 1;
    if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "STOR" ||
     VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "SAFETY" ||
     VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "ACIDNT" ||
     VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "TEST")
        HOLD-CARS-K = HOLD-CARS-K + 1;
        HOLD-CARS-T = HOLD-CARS-T + 1;
    else
        if (VHFR01A_DATA.WHERE-IS-CAR[LOOP-INDEX] == "CON")
            REV-SERVICE-K = REV-SERVICE-K + 1;
            REV-SERVICE-T = REV-SERVICE-T + 1;
        else
            TOTAL-MAINT-K = TOTAL-MAINT-K + 1;
            TOTAL-MAINT-T = TOTAL-MAINT-T + 1;
            if (VHFR01A_DATA.WAR-IND[LOOP-INDEX] == "Y" &&
             VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                WARRANTY-K = WARRANTY-K + 1;
                WARRANTY-T = WARRANTY-T + 1;
            else
                if (VHFR01A_DATA.WAR-IND[LOOP-INDEX] == "N" &&
                 VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                    UNSCHD-MAIN-K = UNSCHD-MAIN-K + 1;
                    UNSCHD-MAIN-T = UNSCHD-MAIN-T + 1;
                else
                    if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "AWPART")
                        WAITPART-UM-K = WAITPART-UM-K + 1;
                        WAITPART-UM-T = WAITPART-UM-T + 1;
                    else
                        if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "PM")
                            PREVEN-MAIN-K = PREVEN-MAIN-K + 1;
                            PREVEN-MAIN-T = PREVEN-MAIN-T + 1;
                        else
                            if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "ENGHLD")
                                ENGRNG-HOLD-K = ENGRNG-HOLD-K + 1;
                                ENGRNG-HOLD-T = ENGRNG-HOLD-T + 1;
                            else
                                if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "MODHLD")
                                    MODIFY-CARS-K = MODIFY-CARS-K + 1;
                                    MODIFY-CARS-T = MODIFY-CARS-T + 1;
                                else
                                    if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "MISC")
                                        MISCEL-HOLD-K = MISCEL-HOLD-K + 1;
                                        MISCEL-HOLD-T = MISCEL-HOLD-T + 1;
                                    else
                                        TOTAL-MAINT-K = TOTAL-MAINT-K - 1;
                                        TOTAL-MAINT-T = TOTAL-MAINT-T - 1;
                                        if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "GO" &&
                                         VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "USABLE" &&
                                         VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "ERROR")
                                            TOTAL-FLEET-K = TOTAL-FLEET-K - 1;
                                            TOTAL-FLEET-T = TOTAL-FLEET-T - 1;
                                        else
                                            GO-AVAIL-K = GO-AVAIL-K + 1;
                                            GO-AVAIL-T = GO-AVAIL-T + 1;
                                            if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "HY")
                                                GO-HAYWARD-K = GO-HAYWARD-K + 1;
                                                GO-HAYWARD-T = GO-HAYWARD-T + 1;
                                            else
                                                if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "CY")
                                                    GO-CONCORD-K = GO-CONCORD-K + 1;
                                                    GO-CONCORD-T = GO-CONCORD-T + 1;
                                                else
                                                    if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "RY")
                                                        GO-RICHMOND-K = GO-RICHMOND-K + 1;
                                                        GO-RICHMOND-T = GO-RICHMOND-T + 1;
                                                    else
                                                        if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "DY")
                                                            GO-DALYCITYY-K = GO-DALYCITYY-K + 1;
                                                            GO-DALYCITYY-T = GO-DALYCITYY-T + 1;
                                                        else
                                                            GO-OTHER-K = GO-OTHER-K + 1;
                                                            GO-OTHER-T = GO-OTHER-T + 1;
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHHF01IS-INIT () 
    VHHF01IW.ROW-COUNT = 18;
    CAR-TYPE-DATA[1] = "Cars Assigned";
    CAR-TYPE-DATA[2] = "Not in Fleet";
    CAR-TYPE-DATA[3] = "Adj Total";
    CAR-TYPE-DATA[4] = " ";
    CAR-TYPE-DATA[5] = "Unsched Maint";
    CAR-TYPE-DATA[6] = "Prevent Maint";
    CAR-TYPE-DATA[7] = "Warranty Rep";
    CAR-TYPE-DATA[8] = "Engnerng Hold";
    CAR-TYPE-DATA[9] = "Modification";
    CAR-TYPE-DATA[10] = "Misc Hold";
    CAR-TYPE-DATA[11] = "Total in Maint";
    CAR-TYPE-DATA[12] = " ";
    CAR-TYPE-DATA[13] = "Awaiting Parts-A";
    CAR-TYPE-DATA[15] = "Reqd for SVC";
    CAR-TYPE-DATA[16] = "Avail For SVC";
    CAR-TYPE-DATA[17] = "In Rev SVC";
    CAR-TYPE-DATA[18] = "GO Cars in Yrds";

  
    VHHF01A_CRIT.HOME-YRD-OCCR[1] = "CY";
    VHHF01A_CRIT.HOME-YRD-OCCR[2] = "DY";
    VHHF01A_CRIT.HOME-YRD-OCCR[3] = "HY";
    VHHF01A_CRIT.HOME-YRD-OCCR[4] = "RY";
    YARD-INDEX = 1;
    while ((YARD-INDEX <= 4))
        VHHF01A_CRIT.AWP-A-COUNT = 0;
        VHHF01A_CRIT.AWP-B-COUNT = 0;
        VHHF01A_CRIT.AWP-C-COUNT = 0;
        VHHF01A_CRIT.AWP-D-COUNT = 0;
        VHHF01A_CRIT.AWP-E-COUNT = 0;
        VHHF01A_CRIT.AWP-L-COUNT = 0;
        VHHF01A_CRIT.AWP-M-COUNT = 0;
        VHHF01A_CRIT.AWP-K-COUNT = 0;
        VHHF01A_CRIT.HOME-YRD = VHHF01A_CRIT.HOME-YRD-OCCR[YARD-INDEX];
        try
            call "VHHF01A"(XDCONTROL, VHHF01A_CRIT, VHHF01A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHHF01IW.TOTAL-CAR-COUNT = XDCONTROL.UROWCNT;
            VHHF01IS-TYPE-CHK(); 
        else
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
        YARD-INDEX = YARD-INDEX + 1;
    end
end 

Function VHHF01IS-MOVE-CY ()
   
    CAR-CYA-DATA[1] = TOTAL-FLEET-A;
    CAR-CYB-DATA[1] = TOTAL-FLEET-B;
    CAR-CYC-DATA[1] = TOTAL-FLEET-C;
    CAR-CYD-DATA[1] = TOTAL-FLEET-D;
    CAR-CYE-DATA[1] = TOTAL-FLEET-E;
    CAR-CYL-DATA[1] = TOTAL-FLEET-L;
    CAR-CYM-DATA[1] = TOTAL-FLEET-M;    
    CAR-CYK-DATA[1] = TOTAL-FLEET-K;
    CAR-CYTOTAL-DATA[1] = TOTAL-FLEET-T;

  
    CAR-CYA-DATA[2] = HOLD-CARS-A;
    CAR-CYB-DATA[2] = HOLD-CARS-B;
    CAR-CYC-DATA[2] = HOLD-CARS-C;
    CAR-CYD-DATA[2] = HOLD-CARS-D;
    CAR-CYE-DATA[2] = HOLD-CARS-E;
    CAR-CYL-DATA[2] = HOLD-CARS-L;
    CAR-CYM-DATA[2] = HOLD-CARS-M;
    CAR-CYK-DATA[2] = HOLD-CARS-K;
    CAR-CYTOTAL-DATA[2] = HOLD-CARS-T;

  
    CAR-CYA-DATA[3] = TOTAL-FLEET-A - HOLD-CARS-A;
    CAR-CYB-DATA[3] = TOTAL-FLEET-B - HOLD-CARS-B;
    CAR-CYC-DATA[3] = TOTAL-FLEET-C - HOLD-CARS-C;
    CAR-CYD-DATA[3] = TOTAL-FLEET-D - HOLD-CARS-D;
    CAR-CYE-DATA[3] = TOTAL-FLEET-E - HOLD-CARS-E;
    CAR-CYL-DATA[3] = TOTAL-FLEET-L - HOLD-CARS-L;
    CAR-CYM-DATA[3] = TOTAL-FLEET-M - HOLD-CARS-M;
    CAR-CYK-DATA[3] = TOTAL-FLEET-K - HOLD-CARS-K;
    CAR-CYTOTAL-DATA[3] = TOTAL-FLEET-T - HOLD-CARS-T;

  

  
    CAR-CYA-DATA[5] = UNSCHD-MAIN-A;
    CAR-CYB-DATA[5] = UNSCHD-MAIN-B;
    CAR-CYC-DATA[5] = UNSCHD-MAIN-C;
    CAR-CYD-DATA[5] = UNSCHD-MAIN-D;
    CAR-CYE-DATA[5] = UNSCHD-MAIN-E;
    CAR-CYL-DATA[5] = UNSCHD-MAIN-L;
    CAR-CYM-DATA[5] = UNSCHD-MAIN-M;
    CAR-CYK-DATA[5] = UNSCHD-MAIN-K;
    CAR-CYTOTAL-DATA[5] = UNSCHD-MAIN-T;

  
  
  
  
  
    CAR-CYA-DATA[13] = VHHF01A_CRIT.AWP-A-COUNT;
    CAR-CYB-DATA[13] = VHHF01A_CRIT.AWP-B-COUNT;
    CAR-CYC-DATA[13] = VHHF01A_CRIT.AWP-C-COUNT;
    CAR-CYD-DATA[13] = VHHF01A_CRIT.AWP-D-COUNT;
    CAR-CYE-DATA[13] = VHHF01A_CRIT.AWP-E-COUNT;
    CAR-CYL-DATA[13] = VHHF01A_CRIT.AWP-L-COUNT;
    CAR-CYM-DATA[13] = VHHF01A_CRIT.AWP-M-COUNT;
    CAR-CYK-DATA[13] = VHHF01A_CRIT.AWP-K-COUNT;
    CAR-CYTOTAL-DATA[13] = VHHF01A_CRIT.AWP-A-COUNT + VHHF01A_CRIT.AWP-B-COUNT + VHHF01A_CRIT.AWP-C-COUNT + 
    		VHHF01A_CRIT.AWP-D-COUNT + VHHF01A_CRIT.AWP-E-COUNT +
       		VHHF01A_CRIT.AWP-L-COUNT + VHHF01A_CRIT.AWP-M-COUNT + VHHF01A_CRIT.AWP-K-COUNT;

  
    CAR-CYA-DATA[6] = PREVEN-MAIN-A;
    CAR-CYB-DATA[6] = PREVEN-MAIN-B;
    CAR-CYC-DATA[6] = PREVEN-MAIN-C;
    CAR-CYD-DATA[6] = PREVEN-MAIN-D;
    CAR-CYE-DATA[6] = PREVEN-MAIN-E;
    CAR-CYL-DATA[6] = PREVEN-MAIN-L;
    CAR-CYM-DATA[6] = PREVEN-MAIN-M;
    CAR-CYK-DATA[6] = PREVEN-MAIN-K;
    CAR-CYTOTAL-DATA[6] = PREVEN-MAIN-T;

  

  
    CAR-CYA-DATA[7] = WARRANTY-A;
    CAR-CYB-DATA[7] = WARRANTY-B;
    CAR-CYC-DATA[7] = WARRANTY-C;
    CAR-CYD-DATA[7] = WARRANTY-D;
    CAR-CYE-DATA[7] = WARRANTY-E;
    CAR-CYL-DATA[7] = WARRANTY-L;
    CAR-CYM-DATA[7] = WARRANTY-M;
    CAR-CYK-DATA[7] = WARRANTY-K;
    CAR-CYTOTAL-DATA[7] = WARRANTY-T;


  
    CAR-CYA-DATA[8] = ENGRNG-HOLD-A;
    CAR-CYB-DATA[8] = ENGRNG-HOLD-B;
    CAR-CYC-DATA[8] = ENGRNG-HOLD-C;
    CAR-CYD-DATA[8] = ENGRNG-HOLD-D;
    CAR-CYE-DATA[8] = ENGRNG-HOLD-E;
    CAR-CYL-DATA[8] = ENGRNG-HOLD-L;
    CAR-CYM-DATA[8] = ENGRNG-HOLD-M;
    CAR-CYK-DATA[8] = ENGRNG-HOLD-K;
    CAR-CYTOTAL-DATA[8] = ENGRNG-HOLD-T;

  
    CAR-CYA-DATA[9] = MODIFY-CARS-A;
    CAR-CYB-DATA[9] = MODIFY-CARS-B;
    CAR-CYC-DATA[9] = MODIFY-CARS-C;
    CAR-CYD-DATA[9] = MODIFY-CARS-D;
    CAR-CYE-DATA[9] = MODIFY-CARS-E;
    CAR-CYL-DATA[9] = MODIFY-CARS-L;
    CAR-CYM-DATA[9] = MODIFY-CARS-M;
    CAR-CYK-DATA[9] = MODIFY-CARS-K;
    CAR-CYTOTAL-DATA[9] = MODIFY-CARS-T;

  
    CAR-CYA-DATA[10] = MISCEL-HOLD-A;
    CAR-CYB-DATA[10] = MISCEL-HOLD-B;
    CAR-CYC-DATA[10] = MISCEL-HOLD-C;
    CAR-CYD-DATA[10] = MISCEL-HOLD-D;
    CAR-CYE-DATA[10] = MISCEL-HOLD-E;
    CAR-CYL-DATA[10] = MISCEL-HOLD-L;
    CAR-CYM-DATA[10] = MISCEL-HOLD-M;
    CAR-CYK-DATA[10] = MISCEL-HOLD-K;
    CAR-CYTOTAL-DATA[10] = MISCEL-HOLD-T;

  
    CAR-CYA-DATA[11] = UNSCHD-MAIN-A + WAITPART-UM-A + PREVEN-MAIN-A + WARRANTY-A + ENGRNG-HOLD-A + MODIFY-CARS-A + MISCEL-HOLD-A;
    CAR-CYB-DATA[11] = UNSCHD-MAIN-B + WAITPART-UM-B + PREVEN-MAIN-B + WARRANTY-B + ENGRNG-HOLD-B + MODIFY-CARS-B + MISCEL-HOLD-B;
    CAR-CYC-DATA[11] = UNSCHD-MAIN-C + WAITPART-UM-C + PREVEN-MAIN-C + WARRANTY-C + ENGRNG-HOLD-C + MODIFY-CARS-C + MISCEL-HOLD-C;
    CAR-CYD-DATA[11] = UNSCHD-MAIN-D + WAITPART-UM-D + PREVEN-MAIN-D + WARRANTY-D + ENGRNG-HOLD-D + MODIFY-CARS-D + MISCEL-HOLD-D;
    CAR-CYE-DATA[11] = UNSCHD-MAIN-E + WAITPART-UM-E + PREVEN-MAIN-E + WARRANTY-E + ENGRNG-HOLD-E + MODIFY-CARS-E + MISCEL-HOLD-E;
    CAR-CYL-DATA[11] = UNSCHD-MAIN-L + WAITPART-UM-L + PREVEN-MAIN-L + WARRANTY-L + ENGRNG-HOLD-L + MODIFY-CARS-L + MISCEL-HOLD-L;
    CAR-CYM-DATA[11] = UNSCHD-MAIN-M + WAITPART-UM-M + PREVEN-MAIN-M + WARRANTY-M + ENGRNG-HOLD-M + MODIFY-CARS-M + MISCEL-HOLD-M;
    CAR-CYK-DATA[11] = UNSCHD-MAIN-K + WAITPART-UM-K + PREVEN-MAIN-K + WARRANTY-K + ENGRNG-HOLD-K + MODIFY-CARS-K + MISCEL-HOLD-K;    
    CAR-CYTOTAL-DATA[11] = UNSCHD-MAIN-T + WAITPART-UM-T + PREVEN-MAIN-T + WARRANTY-T + ENGRNG-HOLD-T + MODIFY-CARS-T + MISCEL-HOLD-T;

  
  
    CAR-CYA-DATA[15] = TOTAL-REQD-A;
    CAR-CYB-DATA[15] = TOTAL-REQD-B;
    CAR-CYC-DATA[15] = TOTAL-REQD-C;
    CAR-CYD-DATA[15] = TOTAL-REQD-D;
    CAR-CYE-DATA[15] = TOTAL-REQD-E;
    CAR-CYL-DATA[15] = TOTAL-REQD-L;
    CAR-CYM-DATA[15] = TOTAL-REQD-M;
    CAR-CYK-DATA[15] = TOTAL-REQD-K;    
    CAR-CYTOTAL-DATA[15] = TOTAL-REQD-T;

  
    CAR-CYA-DATA[16] = CAR-CYA-DATA[3] - CAR-CYA-DATA[11];
    CAR-CYB-DATA[16] = CAR-CYB-DATA[3] - CAR-CYB-DATA[11];
    CAR-CYC-DATA[16] = CAR-CYC-DATA[3] - CAR-CYC-DATA[11];
    CAR-CYD-DATA[16] = CAR-CYD-DATA[3] - CAR-CYD-DATA[11];
    CAR-CYE-DATA[16] = CAR-CYE-DATA[3] - CAR-CYE-DATA[11];
    CAR-CYL-DATA[16] = CAR-CYL-DATA[3] - CAR-CYL-DATA[11];
    CAR-CYM-DATA[16] = CAR-CYM-DATA[3] - CAR-CYM-DATA[11];
    CAR-CYK-DATA[16] = CAR-CYK-DATA[3] - CAR-CYK-DATA[11];
    CAR-CYTOTAL-DATA[16] = CAR-CYTOTAL-DATA[3] - CAR-CYTOTAL-DATA[11];

  
    CAR-CYA-DATA[17] = REV-SERVICE-A;
    CAR-CYB-DATA[17] = REV-SERVICE-B;
    CAR-CYC-DATA[17] = REV-SERVICE-C;
    CAR-CYD-DATA[17] = REV-SERVICE-D;
    CAR-CYE-DATA[17] = REV-SERVICE-E;
    CAR-CYL-DATA[17] = REV-SERVICE-L;
    CAR-CYM-DATA[17] = REV-SERVICE-M;    
    CAR-CYK-DATA[17] = REV-SERVICE-K;
    CAR-CYTOTAL-DATA[17] = REV-SERVICE-T;

  
    CAR-CYA-DATA[18] = GO-AVAIL-A;
    CAR-CYB-DATA[18] = GO-AVAIL-B;
    CAR-CYC-DATA[18] = GO-AVAIL-C;
    CAR-CYD-DATA[18] = GO-AVAIL-D;
    CAR-CYE-DATA[18] = GO-AVAIL-E;
    CAR-CYL-DATA[18] = GO-AVAIL-L;
    CAR-CYM-DATA[18] = GO-AVAIL-M;
    CAR-CYK-DATA[18] = GO-AVAIL-K;
    CAR-CYTOTAL-DATA[18] = GO-AVAIL-T;
end 

Function VHHF01IS-MOVE-DY ()
  
    CAR-DYA-DATA[1] = TOTAL-FLEET-A;
    CAR-DYB-DATA[1] = TOTAL-FLEET-B;
    CAR-DYC-DATA[1] = TOTAL-FLEET-C;
