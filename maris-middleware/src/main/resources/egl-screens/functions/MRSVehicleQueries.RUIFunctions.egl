Function VHFR01IS-TYPE-A () 
    TOTAL-FLEET-A = TOTAL-FLEET-A + 1;
    TOTAL-FLEET-T = TOTAL-FLEET-T + 1;
    if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "STOR" ||
     VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "SAFETY" ||
     VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "ACIDNT" ||
     VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "TEST")
        HOLD-CARS-A = HOLD-CARS-A + 1;
        HOLD-CARS-T = HOLD-CARS-T + 1;
    else
        if (VHFR01A_DATA.WHERE-IS-CAR[LOOP-INDEX] == "CON")
            REV-SERVICE-A = REV-SERVICE-A + 1;
            REV-SERVICE-T = REV-SERVICE-T + 1;
        else
            TOTAL-MAINT-A = TOTAL-MAINT-A + 1;
            TOTAL-MAINT-T = TOTAL-MAINT-T + 1;
            if (VHFR01A_DATA.WAR-IND[LOOP-INDEX] == "Y" &&
             VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                WARRANTY-A = WARRANTY-A + 1;
                WARRANTY-T = WARRANTY-T + 1;
            else
                if (VHFR01A_DATA.WAR-IND[LOOP-INDEX] == "N" &&
                 VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                    UNSCHD-MAIN-A = UNSCHD-MAIN-A + 1;
                    UNSCHD-MAIN-T = UNSCHD-MAIN-T + 1;
                else
                    if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "AWPART")
                        WAITPART-UM-A = WAITPART-UM-A + 1;
                        WAITPART-UM-T = WAITPART-UM-T + 1;
                    else
                        if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "PM")
                            PREVEN-MAIN-A = PREVEN-MAIN-A + 1;
                            PREVEN-MAIN-T = PREVEN-MAIN-T + 1;
                        else
                            if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "ENGHLD")
                                ENGRNG-HOLD-A = ENGRNG-HOLD-A + 1;
                                ENGRNG-HOLD-T = ENGRNG-HOLD-T + 1;
                            else
                                if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "MODHLD")
                                    MODIFY-CARS-A = MODIFY-CARS-A + 1;
                                    MODIFY-CARS-T = MODIFY-CARS-T + 1;
                                else
                                    if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "MISC")
                                        MISCEL-HOLD-A = MISCEL-HOLD-A + 1;
                                        MISCEL-HOLD-T = MISCEL-HOLD-T + 1;
                                    else
                                        TOTAL-MAINT-A = TOTAL-MAINT-A - 1;
                                        TOTAL-MAINT-T = TOTAL-MAINT-T - 1;
                                        if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "GO" &&
                                         VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "USABLE" &&
                                         VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "ERROR")
                                            TOTAL-FLEET-A = TOTAL-FLEET-A - 1;
                                            TOTAL-FLEET-T = TOTAL-FLEET-T - 1;
                                        else
                                            GO-AVAIL-A = GO-AVAIL-A + 1;
                                            GO-AVAIL-T = GO-AVAIL-T + 1;
                                            if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "HY")
                                                GO-HAYWARD-A = GO-HAYWARD-A + 1;
                                                GO-HAYWARD-T = GO-HAYWARD-T + 1;
                                            else
                                                if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "CY")
                                                    GO-CONCORD-A = GO-CONCORD-A + 1;
                                                    GO-CONCORD-T = GO-CONCORD-T + 1;
                                                else
                                                    if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "RY")
                                                        GO-RICHMOND-A = GO-RICHMOND-A + 1;
                                                        GO-RICHMOND-T = GO-RICHMOND-T + 1;
                                                    else
                                                        if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "DY")
                                                            GO-DALYCITYY-A = GO-DALYCITYY-A + 1;
                                                            GO-DALYCITYY-T = GO-DALYCITYY-T + 1;
                                                        else
                                                            GO-OTHER-A = GO-OTHER-A + 1;
                                                            GO-OTHER-T = GO-OTHER-T + 1;
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHFR01IS-TYPE-B () 
    TOTAL-FLEET-B = TOTAL-FLEET-B + 1;
    TOTAL-FLEET-T = TOTAL-FLEET-T + 1;
    if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "STOR" ||
     VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "SAFETY" ||
     VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "ACIDNT" ||
     VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "TEST")
        HOLD-CARS-B = HOLD-CARS-B + 1;
        HOLD-CARS-T = HOLD-CARS-T + 1;
    else
        if (VHFR01A_DATA.WHERE-IS-CAR[LOOP-INDEX] == "CON")
            REV-SERVICE-B = REV-SERVICE-B + 1;
            REV-SERVICE-T = REV-SERVICE-T + 1;
        else
            TOTAL-MAINT-B = TOTAL-MAINT-B + 1;
            TOTAL-MAINT-T = TOTAL-MAINT-T + 1;
            if (VHFR01A_DATA.WAR-IND[LOOP-INDEX] == "Y" &&
             VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                WARRANTY-B = WARRANTY-B + 1;
                WARRANTY-T = WARRANTY-T + 1;
            else
                if (VHFR01A_DATA.WAR-IND[LOOP-INDEX] == "N" &&
                 VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "NO GO")
                    UNSCHD-MAIN-B = UNSCHD-MAIN-B + 1;
                    UNSCHD-MAIN-T = UNSCHD-MAIN-T + 1;
                else
                    if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "AWPART")
                        WAITPART-UM-B = WAITPART-UM-B + 1;
                        WAITPART-UM-T = WAITPART-UM-T + 1;
                    else
                        if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "PM")
                            PREVEN-MAIN-B = PREVEN-MAIN-B + 1;
                            PREVEN-MAIN-T = PREVEN-MAIN-T + 1;
                        else
                            if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "ENGHLD")
                                ENGRNG-HOLD-B = ENGRNG-HOLD-B + 1;
                                ENGRNG-HOLD-T = ENGRNG-HOLD-T + 1;
                            else
                                if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "MODHLD")
                                    MODIFY-CARS-B = MODIFY-CARS-B + 1;
                                    MODIFY-CARS-T = MODIFY-CARS-T + 1;
                                else
                                    if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] == "MISC")
                                        MISCEL-HOLD-B = MISCEL-HOLD-B + 1;
                                        MISCEL-HOLD-T = MISCEL-HOLD-T + 1;
                                    else
                                        TOTAL-MAINT-B = TOTAL-MAINT-B - 1;
                                        TOTAL-MAINT-T = TOTAL-MAINT-T - 1;
                                        if (VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "GO" &&
                                         VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "USABLE" &&
                                         VHFR01A_DATA.VEH-STAT[LOOP-INDEX] != "ERROR")
                                            TOTAL-FLEET-B = TOTAL-FLEET-B - 1;
                                            TOTAL-FLEET-T = TOTAL-FLEET-T - 1;
                                        else
                                            GO-AVAIL-B = GO-AVAIL-B + 1;
                                            GO-AVAIL-T = GO-AVAIL-T + 1;
                                            if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "HY")
                                                GO-HAYWARD-B = GO-HAYWARD-B + 1;
                                                GO-HAYWARD-T = GO-HAYWARD-T + 1;
                                            else
                                                if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "CY")
                                                    GO-CONCORD-B = GO-CONCORD-B + 1;
                                                    GO-CONCORD-T = GO-CONCORD-T + 1;
                                                else
                                                    if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "RY")
                                                        GO-RICHMOND-B = GO-RICHMOND-B + 1;
                                                        GO-RICHMOND-T = GO-RICHMOND-T + 1;
                                                    else
                                                        if (VHFR01A_DATA.CURR-LOC[LOOP-INDEX] == "DY")
                                                            GO-DALYCITYY-B = GO-DALYCITYY-B + 1;
                                                            GO-DALYCITYY-T = GO-DALYCITYY-T + 1;
                                                        else
                                                            GO-OTHER-B = GO-OTHER-B + 1;
                                                            GO-OTHER-T = GO-OTHER-T + 1;
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

