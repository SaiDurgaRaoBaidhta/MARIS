                VHST02IW-COLOR.CAR9-COLOR-1 = "BLACK";
                VHST02IW-COLOR.CAR10-COLOR-1 = "BLACK";
            end
            if (VHST2A1_DATA.CON-WN-IND[IND] == "Y")
                VHST02IW-COLOR.CON-WN-COLOR-1 = "yellow";
            end
            if (VHST2A1_DATA.CAR-WN-IND[IND] == "Y")
                VHST02IW-COLOR.CAR1-WN-COLOR-1 = "yellow";
            end
            if (VHST2A1_DATA.TRAIN-INCD-IND[IND] == "Y" || VHST2A1_DATA.JA-INCD-IND[IND] == "Y")
