    CAR-D-DATA[13] = UNSCHD-MAIN-D + WAITPART-UM-D + PREVEN-MAIN-D + WARRANTY-D + ENGRNG-HOLD-D + MODIFY-CARS-D + MISCEL-HOLD-D;
    CAR-E-DATA[13] = UNSCHD-MAIN-E + WAITPART-UM-E + PREVEN-MAIN-E + WARRANTY-E + ENGRNG-HOLD-E + MODIFY-CARS-E + MISCEL-HOLD-E;
    CAR-L-DATA[13] = UNSCHD-MAIN-L + WAITPART-UM-L + PREVEN-MAIN-L + WARRANTY-L + ENGRNG-HOLD-L + MODIFY-CARS-L + MISCEL-HOLD-L;
    CAR-M-DATA[13] = UNSCHD-MAIN-M + WAITPART-UM-M + PREVEN-MAIN-M + WARRANTY-M + ENGRNG-HOLD-M + MODIFY-CARS-M + MISCEL-HOLD-M;    
