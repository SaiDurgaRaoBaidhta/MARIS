

package MRSVehicleCarBright;
 

Function VHCBP1I-REV-DATE2 ()
  
  
  
  
  
  
  
   
    set VHIE01B_DATA empty;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIE01B";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE01I";
    set VHIE01B_DATA empty;

    
    try
        call "MRSVehicleIncdEvent.VHIE01B"(XDCONTROL, VHIE01B_CRIT, VHIE01B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end

  
    if (VHIE01B_DATA.CURRENT-TIME >= VHIE01B_DATA.TIME-REV-START)
        VHCBP1I-DATE.REV-DATE = VHIE01B_DATA.CURRENT-DATE;
    else
        VHCBP1I-DATE.REV-DATE = VHIE01B_DATA.YESTERDAY;
    end

  
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCBP1I-DATE.REV-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHCBP1I-DATE.REV-DATE-MMDDYYYY = XXDATEW.DATE-MM-DD-YYYY;
    VHCBP1IW.TIME-HOLD = VHIE01B_DATA.CURRENT-TIME;
    VHCBP1I-DATE.VAGen_TIME = VHIE01B_DATA.CURRENT-TIME;
    VHCBP1IW.TIME-CAR-BRIT = VHIE01B_DATA.CURRENT-TIME;
end 

Function VHCBP1IS-ADD () 
    set VHCBP1A_DATA empty;
    ERR-IND = 0;
    ERROR-CAR = " ";
    VHCBP1IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    INNER-LOOP-INDEX = 1;
    OUTER-LOOP-INDEX = 1;
    VHCBP1IW.DUP-CAR-ERROR = "N";
    YARD-ERROR = "N";
    SCR-DATE-ERROR = "N";
    TIME-ERROR = "N";
    CAR-ERROR = "N";
    CAR-ERROR-MESSAGE = " ";
    FINAL-ERROR-MSG = " ";
    move " " to ERROR-MESSAGE[1] for all;
    if (VHCBP1IW.BRIT-LOC == " ")
        ERR-IND = ERR-IND + 1;
        YARD-ERROR = "Y";
        ERROR-MESSAGE[ERR-IND] = "Yard cannot be blank.";
    else
        if (VHCBP1IW.BRIT-LOC != "CY" &&
         VHCBP1IW.BRIT-LOC != "DY" &&
         VHCBP1IW.BRIT-LOC != "HY" &&
         VHCBP1IW.BRIT-LOC != "RY" &&
         VHCBP1IW.BRIT-LOC != "ALL")
            ERR-IND = ERR-IND + 1;
            YARD-ERROR = "Y";
            ERROR-MESSAGE[ERR-IND] = "Invalid Yard.";
            return;
        end
    end
    if (VHCBP1IW.DATE-CAR-BRIT == " ")
        ERR-IND = ERR-IND + 1;
        SCR-DATE-ERROR = "Y";
        ERROR-MESSAGE[ERR-IND] = "Date cannot be blank.";
    end
    if ((VHCBP1IW.DATE-CAR-BRIT-YEAR > VHCBP1IW.SYSTEM-DATE-YEAR) ||
     (VHCBP1IW.DATE-CAR-BRIT-YEAR == VHCBP1IW.SYSTEM-DATE-YEAR &&
     VHCBP1IW.DATE-CAR-BRIT-MON > VHCBP1IW.SYSTEM-DATE-MON) ||
     (VHCBP1IW.DATE-CAR-BRIT-YEAR == VHCBP1IW.SYSTEM-DATE-YEAR &&
     VHCBP1IW.DATE-CAR-BRIT-MON == VHCBP1IW.SYSTEM-DATE-MON &&
     VHCBP1IW.DATE-CAR-BRIT-DAY > VHCBP1IW.SYSTEM-DATE-DAY))
        ERR-IND = ERR-IND + 1;
        SCR-DATE-ERROR = "Y";
        ERROR-MESSAGE[ERR-IND] = "Date cannot be greater than today's date.";
    end

  
    set VHCBP1B_DATA empty;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCBP1IW.DATE-CAR-BRIT;
    MRSCommonCode.XXDATES-CONVERT();
    VHCBP1B_CRIT.VAGen_DATE = XXDATEW.DATE-YYYY-MM-DD;
    VHCBP1B_DATA.DATE-IS-VALID = "Y";
    
  
  
    if (VHCBP1B_DATA.DATE-IS-VALID == "N")
        ERR-IND = ERR-IND + 1;
        SCR-DATE-ERROR = "Y";
        ERROR-MESSAGE[ERR-IND] = "Date cannot be older than 30 days.";
    end
    if (VHCBP1IW.SCR-TIME-CAR-BRIT == " ")
        ERR-IND = ERR-IND + 1;
        TIME-ERROR = "Y";
        ERROR-MESSAGE[ERR-IND] = "Time cannot be blank.";
    else
        if (VHCBP1IW.SCR-TIME-CAR-BRIT == "0000" ||
         VHCBP1IW.SCR-TIME-CAR-BRIT > "2400")
            ERR-IND = ERR-IND + 1;
            TIME-ERROR = "Y";
            ERROR-MESSAGE[ERR-IND] = "Invalid Time.";
        end
    end
    if (CAR-NO-ARRAY[1] == " ")
        ERR-IND = ERR-IND + 1;
        CAR-ERROR = "Y";
        ERROR-MESSAGE[ERR-IND] = "First car no field cannot be blank.";
        
  
    end

  
    if (CAR-ERROR == "N")
        while ((OUTER-LOOP-INDEX <= 20) && VHCBP1IW.DUP-CAR-ERROR == "N")
            INNER-LOOP-INDEX = 1;
            while ((INNER-LOOP-INDEX <= 20) && VHCBP1IW.DUP-CAR-ERROR == "N")
                if (CAR-NO-ARRAY[INNER-LOOP-INDEX] != " ")
                    if (CAR-NO-ARRAY[INNER-LOOP-INDEX] ==
                     CAR-NO-ARRAY[OUTER-LOOP-INDEX] && INNER-LOOP-INDEX != OUTER-LOOP-INDEX)
                        VHCBP1IW.DUP-CAR-ERROR = "Y";
                        
  
                    end
                end
                INNER-LOOP-INDEX = INNER-LOOP-INDEX + 1;
            end
            OUTER-LOOP-INDEX = OUTER-LOOP-INDEX + 1;
        end
        if (DUP-CAR-ERROR == "Y")
            ERR-IND = ERR-IND + 1;
            DUP-CAR-ERROR = "Y";
            ERROR-MESSAGE[ERR-IND] = "Duplicate car nos entered.";
        end
    end
    VHCBP1IW.ERROR-LOOP-INDEX = 1;
    VHCBP1IW.FINAL-INDEX = 0;
    VHCBP1IW-TRIGGER.FINAL-ERROR-MSG = " ";
    VHCBP1IW.TEMP-ERROR-MSG = " ";
    if (ERR-IND > 0)
        VHCBP1IS-MOVE-MSG();
    else
        OUTER-LOOP-INDEX = 1;
        while ((OUTER-LOOP-INDEX <= 20 && CAR-ERROR-MESSAGE == " "))
            if (CAR-NO-ARRAY[OUTER-LOOP-INDEX] != " ")
                if (CAR-NO-ARRAY[OUTER-LOOP-INDEX] not numeric)
                    VHCBP1IW.ERROR-CAR = "Y";
                    CAR-ERR-1 = "         Car No ";
                    CAR-ERR-2 = CAR-NO-ARRAY[OUTER-LOOP-INDEX];
                    CAR-ERR-3 = " not numeric";
                    
  
                else
          
                    VHCBR2C_CRIT.CAR-NO = CAR-NO-ARRAY[OUTER-LOOP-INDEX];
                    try
                        call "VHCBR2C"(XDCONTROL, VHCBR2C_CRIT, VHCBR2C_DATA);
                    
                    end
                    if (XDCONTROL.UROWCNT == 1)

                    else
                        if (XDCONTROL.URC == 100)
                            VHCBP1IW.ERROR-CAR = "Y";
                            CAR-ERR-1 = "         Car No ";
                            CAR-ERR-2 = CAR-NO-ARRAY[OUTER-LOOP-INDEX];
                            CAR-ERR-3 = " does not exist in Vehicle database.";
                            
  
                        else
                            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                            return;
                        end
                    end
                end
            end
            OUTER-LOOP-INDEX = OUTER-LOOP-INDEX + 1;
        end
        move CAR-ERROR-MESSAGE to FINAL-ERROR-MSG withV60Compat;
    end

  
    if (FINAL-ERROR-MSG == " ")
        VHCBP1IS-MOVE-VAL();
        try
            call "VHCBP1A"(XDCONTROL, VHCBP1A_DATA);
        
        end
        if (VHCBP1A_DATA.RECORD-FOUND == "N")
            FINAL-ERROR-MSG = "Car Thorough Cleaing records added successfully";
        else
            if (VHCBP1A_DATA.RECORD-FOUND == "Y")
                FINAL-ERROR-MSG = "Duplicate car Cleaning  records cannot be added.";
                VHCBP1IS-MSG-X();
                return;
            else
                FINAL-ERROR-MSG = "Error - Car Thorough Clean records not added.";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
    if (ERROR-CAR == " ")
        VHCBP1IW-TRIGGER.ADD-SW = "Y";
    end
end 

Function VHCBP1IS-AFT-ADD () 
    if (ERR-IND == 0)
        set VHCBP1IW empty;
        set VHCB1W-MSG empty;
        VHCBP1IW.BRIT-LOC = "HY";
        VHCBP1IW.DATE-CAR-BRIT = " ";
        DATE-SETFOCUS = "Y";
    else

    end
end 

