Function VHCBP1IS-INIT () 
    set VHCBP1IW empty;
    set VHCB1W-MSG empty;
    FINAL-ERROR-MSG = " ";
    VHCBP1IW.BRIT-LOC = "HY";
    VHCBP1IW.DATE-CAR-BRIT = " ";
end 

