Function VHCBP1IS-MOVE-MSG () 
    while (((ERROR-LOOP-INDEX <= 4) &&
     (ERROR-MESSAGE[ERROR-LOOP-INDEX] != " ")))
        ERR-IND = 1;
        TEMP-ERROR-MSG = ERROR-MESSAGE[ERROR-LOOP-INDEX];
        while ((ERR-IND <= 50))
            if (TEMP-MSG[ERR-IND] != ".")
                FINAL-INDEX = FINAL-INDEX + 1;
                FINAL-MSG[FINAL-INDEX] = TEMP-MSG[ERR-IND];
            else
                if (TEMP-MSG[ERR-IND] == ".")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = ",";
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = " ";
                    ERR-IND = 50;
                end
            end
            ERR-IND = ERR-IND + 1;
        end
        ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
    end
    FINAL-INDEX = FINAL-INDEX - 1;
    FINAL-MSG[FINAL-INDEX] = " ";
    LOAD-ERR-MSG = "Y";
end 

Function VHCBP1IS-MOVE-VAL () 
    VHCBP1A_DATA.BRIT-LOC = VHCBP1IW.BRIT-LOC;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCBP1IW.DATE-CAR-BRIT;
  
    VHCBP1A_DATA.DATE-CAR-BRIT = XXDATEW.DATE-YYYY-MM-DD;

  
    VHCBP1A_DATA.TIME-CAR-HHMM = VHCBP1IW.TIME-CAR-BRIT-HH-MM;
    VHCBP1A_DATA.TIME-CAR-BRIT-FILLER2 = ".00";
    if (VHCBP1A_DATA.SEPERATOR != ".")
        VHCBP1A_DATA.SEPERATOR = ".";
    end
    VHCBP1A_DATA.TERM-LAST-UPD = VHCBP1IW-PASSVALUE.TERM-LAST-UPD;
    OUTER-LOOP-INDEX = 1;
    INNER-LOOP-INDEX = 0;
    while ((OUTER-LOOP-INDEX <= 20))
        if (CAR-NO-ARRAY[OUTER-LOOP-INDEX] != " ")
            INNER-LOOP-INDEX = INNER-LOOP-INDEX + 1;
            VHCBP1A_DATA.CAR-NO[INNER-LOOP-INDEX] = CAR-NO-ARRAY[OUTER-LOOP-INDEX];
        end
        OUTER-LOOP-INDEX = OUTER-LOOP-INDEX + 1;
    end

  
    VHCBP1A_DATA.NUM-OF-CARS = INNER-LOOP-INDEX;
end 

Function VHCBP1IS-MSG-X () 
    VHCB1W-MSG.CAR-20-MSG = " ";
end 

Function VHCBP1IS-SETFOCUS () 
    if (YARD-ERROR == "Y")
        YARD-SETFOCUS = "Y";
    else
        if (SCR-DATE-ERROR == "Y")
            DATE-SETFOCUS = "Y";
        else
            if (TIME-ERROR == "Y")
                TIME-SETFOCUS = "Y";
            else
                if (CAR-ERROR == "Y")
                    CAR-SETFOCUS = "Y";
                else
                    if (DUP-CAR-ERROR == "Y")
                        CAR-SETFOCUS = "Y";
                    end
                end
            end
        end
    end
end 

Function VHCBR01IS-PRINT () 
    FINAL-MESSAGE = " ";
    if (VHCBR1IW.HOME-YRD == " " ||
     (VHCBR1IW.HOME-YRD != "CY" &&
     VHCBR1IW.HOME-YRD != "DY" &&
     VHCBR1IW.HOME-YRD != "HY" &&
     VHCBR1IW.HOME-YRD != "RY" &&
     VHCBR1IW.HOME-YRD != "ALL"))
        FINAL-MESSAGE = "Please enter a valid home yard.";
        HOMEYRD-SETFOCUS = "Y";
        return;
    end
    RUN-VHCBR02 = "Y";
end 

Function VHCBR1IS-CLEAR () 
    set VHCBR1IW empty;
    VHCBR1IW.OPTION-INDEX = 1;
    LOAD-DATA = "Y";
end 

Function VHCBR1IS-LIST () 
    FINAL-MESSAGE = " ";
    if (VHCBR1IW.HOME-YRD == " " ||
     (VHCBR1IW.HOME-YRD != "CY" &&
     VHCBR1IW.HOME-YRD != "DY" &&
     VHCBR1IW.HOME-YRD != "HY" &&
     VHCBR1IW.HOME-YRD != "RY" &&
     VHCBR1IW.HOME-YRD != "ALL"))
        FINAL-MESSAGE = "Please enter a valid home yard.";
        HOMEYRD-SETFOCUS = "Y";
        return;
    end
    try
        call "VHCBR1X"(XDCONTROL, VHCBR1X_DATA);
    
    end
    if (XDCONTROL.URC == 0)
        VHCBR1A_CRIT.DATE-CRIT = VHCBR1X_DATA.DATE-CAR-BRIT;
        VHCBR1A_CRIT.HOME-YRD = VHCBR1IW.HOME-YRD;
        VHCBR1A_CRIT.OVER-DUE-DATE = VHCBR1X_DATA.OVER-DUE-DATE;
        VHCBR1A_CRIT.OPTION-INDEX = VHCBR1IW.OPTION-INDEX;

   
        try
            call "VHCBR1A"(XDCONTROL, VHCBR1A_CRIT, VHCBR1A_DATA);
        
        end
        if (XDCONTROL.UROWCNT > 0)
            VHCBR1IW.ROW-COUNT = XDCONTROL.UROWCNT;
            LOAD-DATA = "Y";
        else
            if (XDCONTROL.URC == 100)
                VHCBR1IW.ROW-COUNT = 0;
                FINAL-MESSAGE = "No records found.";
                LOAD-DATA = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    else
        FINAL-MESSAGE = "Date car brit is not retrieved. Please check Mrs_Sys_Parm table.";
    end
    CLEAR-SETFOCUS = "Y";
end 



Function VHCBR2IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
   
    if (VHCBR02W-PASSVALUE.BRIGHTEN-SW == "1")

  
        set VHCBR02_CRIT empty;
        VHCBR02_CRIT.REPT-TYPE = VHDVS4IW-PASSVALUE.VTAM-NAME;
        VHCBR02_CRIT.DATE-REPT-FROM = VHDVS4IW-PASSVALUE.REPORT-DATE;
        VHCBR02_CRIT.HOME-YRD = VHCBR02W-PASSVALUE.HOME-YRD;


    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHCBR2I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCBR02";

    
        try
            call "VHCBR02"(XDCONTROL, VHCBR02_CRIT, VHCBR02_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
                VHDVS4IW-TRIGGER.SUBMIT = "Y";
            else

        


        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
  
    if (VHCBR02W-PASSVALUE.BRIGHTEN-SW == "2")
        set VHCBR02_CRIT empty;
        VHCBR02_CRIT.REPT-TYPE = VHDVS4IW-PASSVALUE.VTAM-NAME;
        VHCBR02_CRIT.DATE-REPT-FROM = VHDVS4IW-PASSVALUE.REPORT-DATE;
        VHCBR02_CRIT.HOME-YRD = VHCBR02W-PASSVALUE.HOME-YRD;
        if (VHCBR02W-PASSVALUE.BRIGHTEN-SW == "1")
            VHCBR02_CRIT.BRIGHTEN-SW = "Y";
        else
            VHCBR02_CRIT.BRIGHTEN-SW = "N";
        end


    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHCBR2I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCBR02";

    
        try
            call "VHCBR02"(XDCONTROL, VHCBR02_CRIT, VHCBR02_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
                VHDVS4IW-TRIGGER.SUBMIT = "Y";
            else

        


        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end
