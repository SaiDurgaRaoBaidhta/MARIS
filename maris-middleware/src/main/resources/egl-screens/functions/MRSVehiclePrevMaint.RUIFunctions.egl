

package MRSVehiclePrevMaint;


Function VHHPD1IS-GET-DATA ()
  
  
  
  
  
  
  
  
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHHPD1I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHHPDA1";

  


  
    try
        call "VHHPDA1"(XDCONTROL, VHHPDA1_CRIT, VHHPDA1_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            

        else

        
        
            VHHPR1I-TRIGGERS.BAD-YARD = "Y";
            

  
  
  
  
        end 
    end

  
    set VHHPD1IW-MTBI empty;
    CNT = 1;
    while (CNT <= XDCONTROL.UROWCNT)
        VHHPD1IW-MTBI.MTBI-TOTAL-HRS = VHHPD1IW-MTBI.MTBI-TOTAL-HRS + VHHPDA1_DATA.MTBI_HRS[CNT];
        VHHPD1IW-MTBI.MTBI-TOTAL-INCDS = VHHPD1IW-MTBI.MTBI-TOTAL-INCDS + VHHPDA1_DATA.MTBI_INCDS[CNT];
        VHHPD1IW-MTBI.CAR-COUNT = VHHPD1IW-MTBI.CAR-COUNT + 1;

  
        if (VHHPDA1_DATA.WHERE-IS-CAR[CNT] == "CON")
            VHHPDA1_DATA.CURR-LOC[CNT] = VHHPDA1_DATA.CON-NO[CNT];
        end

  
  
  
  
        if (VHHPR1IW.HOME-YRD != "ALL")
            if (VHHPDA1_DATA.CURR-LOC[CNT] == VHHPR1IW.HOME-YRD)
                VHHPDA1_DATA.CURR-LOC[CNT] = "   ";
            end
        end
  

  
        CNT = CNT + 1;
    end

  
    VHHPD1IW-MTBI.MTBI-AVG = VHHPD1IW-MTBI.MTBI-TOTAL-HRS / VHHPD1IW-MTBI.MTBI-TOTAL-INCDS;
end 

Function VHHPD1IS-HOME-YARD () 
    if (VHHPR1IW.HOME-YRD == "ALL")
        VHHPDA1_CRIT.HOME-YRD-LOW = "CY";
        VHHPDA1_CRIT.HOME-YRD-HIGH = "RY";
    else
        VHHPDA1_CRIT.HOME-YRD-LOW = VHHPR1IW.HOME-YRD;
        VHHPDA1_CRIT.HOME-YRD-HIGH = VHHPR1IW.HOME-YRD;
    end
    if (VHHPR1IW.HOME-YRD == "CY")
        VHHPR1IW.HOME-YARD-ALPHA = "Concord";
    end
    if (VHHPR1IW.HOME-YRD == "DY")
        VHHPR1IW.HOME-YARD-ALPHA = "Daly City";
    end
    if (VHHPR1IW.HOME-YRD == "HY")
        VHHPR1IW.HOME-YARD-ALPHA = "Hayward";
    end
    if (VHHPR1IW.HOME-YRD == "RY")
        VHHPR1IW.HOME-YARD-ALPHA = "Richmond";
    end
    if (VHHPR1IW.HOME-YRD == "ALL")
        VHHPR1IW.HOME-YARD-ALPHA = "All Yards";
    end
end 

Function VHHPD2IS-GET-DATA ()
  
  
  
  
  
  
  
  

  


   
    try
        call "VHHPD2A"(XDCONTROL, VHHPD2A_CRIT, VHHPD2A_DATA);
    
    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            

        else

        
        
            VHHPR1I-TRIGGERS.BAD-YARD = "Y";
            

  
  
  
  
        end 
    end

  
    set VHHPD2IW-MTBI empty;
    CNT = 1;
    while (CNT <= XDCONTROL.UROWCNT)
        if (VHHPD2A_DATA.HRS-TO-NEXT-PM[CNT] > 0 && VHHPD2A_DATA.HRS-TO-NEXT-PM[CNT] < 50)
            VHHPD2IW-PASSVALUE.NEXT-PM-COLOR = "GREEN";
        else
            if (VHHPD2A_DATA.HRS-TO-NEXT-PM[CNT] <= 0)
                VHHPD2IW-PASSVALUE.NEXT-PM-COLOR = "RED";
                
  
  
            end
        end
        VHHPD2IW-MTBI.CAR-COUNT = VHHPD2IW-MTBI.CAR-COUNT + 1;

  
        if (VHHPD2A_DATA.WHERE-IS-CAR[CNT] == "CON")
            VHHPD2A_DATA.CURR-LOC[CNT] = VHHPD2A_DATA.CON-NO[CNT];
        end

  
  
  
  
  
  
  
   
   
  

  
        CNT = CNT + 1;
    end
end 

Function VHHPD2IS-HOME-YARD () 
    if (VHHPD2IW.CURR-LOC == "ALL")
        VHHPD2A_CRIT.CURR-LOC-LOW = "CY";
        VHHPD2A_CRIT.CURR-LOC-HIGH = "RY";
    else
        VHHPD2A_CRIT.CURR-LOC-LOW = VHHPD2IW.CURR-LOC;
        VHHPD2A_CRIT.CURR-LOC-HIGH = VHHPD2IW.CURR-LOC;
    end
    if (VHHPD2IW.CURR-LOC == "CY")
        VHHPD2IW.CURR-LOC-ALPHA = "Concord";
    end
    if (VHHPD2IW.CURR-LOC == "DY")
        VHHPD2IW.CURR-LOC-ALPHA = "Daly City";
    end
    if (VHHPD2IW.CURR-LOC == "HY")
        VHHPD2IW.CURR-LOC-ALPHA = "Hayward";
    end
    if (VHHPD2IW.CURR-LOC == "RY")
        VHHPD2IW.CURR-LOC-ALPHA = "Richmond";
    end
    if (VHHPD2IW.CURR-LOC == "ALL")
        VHHPD2IW.CURR-LOC-ALPHA = "All Yards";
    end
    VHHPD2A_CRIT.DATE-FROM = VHHPD2IW.LOW-DATE;
    VHHPD2A_CRIT.DATE-TO = VHHPD2IW.REV-DATE;
end 

Function VHHPM1I-REV-DATE ()
  
  
  
  
  
  
  
  
  
  
  
  


  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHHPM1I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHHPMA3";

    
    try
        call "VHHPMA3"(XDCONTROL, VHHPMA3_CRIT, VHHPMA3_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end

  
    if (VHHPMA3_DATA.CURRENT-TIME >= VHHPMA3_DATA.TIME-REV-START)
        VHHPM1IW.REV-DATE-DB2 = VHHPMA3_DATA.CURRENT-DATE;
    else
        VHHPM1IW.REV-DATE-DB2 = VHHPMA3_DATA.YESTERDAY;
    end


  
  
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHHPD1I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHHPMA2";

  
    try
        call "VHHPMA2"(XDCONTROL, VHHPMA2_DATA);
    
    end
    
    
    MRSCommonCode.XXA0IS-CHECK_EXT();
    
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHHPM1IW.DATE-LOW-DB2 = VHHPMA2_DATA.FROM-DATE;
             
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end

  
  
  
  
  

  
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHHPM1IW.DATE-LOW-DB2;
    MRSCommonCode.XXDATES-CONVERT();
    VHHPM1IW.DATE-LOW = XXDATEW.DATE-MM-DD-YYYY;

  
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHHPM1IW.REV-DATE-DB2;
    MRSCommonCode.XXDATES-CONVERT();
    VHHPM1IW.REV-DATE = XXDATEW.DATE-MM-DD-YYYY;
end 

Function VHHPM1IS-CLEAR ()
   
    set VHHPM1IW2 empty;
    set VHHPM1W3 empty;
    VHHPM1IW-TRIGGERS.HIDE = "Y";
    VHHPM1IW-TRIGGERS.ENABLE-DISPLAY = "Y";
end 

Function VHHPM1IS-DISPLAY () 
    if (VHHPM1IW2.HOME-YRD != "   " || VHHPM1IW2.CURR-LOC != "   ")
        if (VHHPM1IW.RPT == "1")
            VHHPM1IW-TRIGGERS.RUN-VHHPR1I = "Y";
        end
        if (VHHPM1IW.RPT == "2")
            VHHPM1IW-TRIGGERS.RUN-VHHPM2I = "Y";
        end
        if (VHHPM1IW.RPT == "3")
            VHHPM1IW-TRIGGERS.RUN-VHPMR1I = "Y";
        end
        if (VHHPM1IW.RPT == "4")
            VHHPM1IW-TRIGGERS.RUN-VHHPD1I = "Y";
        end
        if (VHHPM1IW.RPT == "5")
            VHHPM1IW-TRIGGERS.RUN-VHHPD2I = "Y";
        end
    else
        VHHPM1IW-TRIGGERS.NO-HOME-YRD = "Y";
    end
end 

Function VHHPM1IS-HARD-COPY () 
    if (PRT-IDX > 0)
        ENABLE-HARD = "Y";
        VHHPM1IS-PASSVALUE.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRT-IDX];
    else
        DISABLE-HARD = "Y";
    end
end 

