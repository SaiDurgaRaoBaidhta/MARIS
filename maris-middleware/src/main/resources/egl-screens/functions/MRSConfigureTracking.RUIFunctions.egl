    VHCF01T_CRIT_X.ON-PARM[24] = VHCF01IW-SV2.ON-PARM[24];
    VHCF01T_CRIT_X.ON-PARM[25] = VHCF01IW-SV2.ON-PARM[25];
    VHCF01T_CRIT_X.ON-PARM[26] = VHCF01IW-SV2.ON-PARM[26];
