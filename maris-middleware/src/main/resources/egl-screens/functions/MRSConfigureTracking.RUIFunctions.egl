    VHCF01K_CRIT.K2-IND1 = "N";  
    VHCF01K_CRIT.L1-IND1 = "N";    
    VHCF01K_CRIT.M1-IND1 = "N";
        
    if (VHCF01IW-SAVE.CAR-TYPE == "K1")
        VHCF01K_CRIT.K1-IND1 = "Y";
    else
    	if (VHCF01IW-SAVE.CAR-TYPE == "K2")
        	VHCF01K_CRIT.K2-IND1 = "Y";
        else
        	if (VHCF01IW-SAVE.CAR-TYPE == "L1")
        		VHCF01K_CRIT.L1-IND1 = "Y";
    		else
		    	if (VHCF01IW-SAVE.CAR-TYPE == "M1")
		        	VHCF01K_CRIT.M1-IND1 = "Y";
		        end
    		end
        end
    end
    if (VHCF01IW-SAVE.CAR-TYPE == "C1")
        VHCF01K_CRIT.C1-IND1 = "Y";
    else
        if (VHCF01IW-SAVE.CAR-TYPE == "C2")
            VHCF01K_CRIT.C2-IND1 = "Y";
        else
            if (VHCF01IW-SAVE.CAR-TYPE == "A2")
                VHCF01K_CRIT.A2-IND1 = "Y";
            else
                if (VHCF01IW-SAVE.CAR-TYPE == "B2")
                    VHCF01K_CRIT.B2-IND1 = "Y";
                else
            		if (VHCF01IW-SAVE.CAR-TYPE == "D1")
                		VHCF01K_CRIT.D1-IND1 = "Y";
            		else
                		if (VHCF01IW-SAVE.CAR-TYPE == "E1")
                    		VHCF01K_CRIT.E1-IND1 = "Y";
                		end
            		end
                end
            end
        end
    end
    try
        call "VHCF01K"(XDCONTROL, VHCF01K_CRIT, VHCF01K_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF01K_DATA.SERIAL-FOUND = "Y";
    else
        if (XDCONTROL.URC == 100)
            VHCF01K_DATA.SERIAL-FOUND = "N";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

Function VHCF01IS-CK-GEAR2 () 
    try
        call "VHCF01L"(XDCONTROL, VHCF01L_CRIT, VHCF01L_DATA);
    
    end
end 

Function VHCF01IS-CK-SEC () 
    if (VHCF01IW-SV2.EQ-PARM == "AXLE1")
        VHCF01IW-MSG.AXLE-MSG-01-6 = "1";
    else
        if (VHCF01IW-SV2.EQ-PARM == "AXLE2")
            VHCF01IW-MSG.AXLE-MSG-01-6 = "2";
        else
            if (VHCF01IW-SV2.EQ-PARM == "AXLE3") 
                VHCF01IW-MSG.AXLE-MSG-01-6 = "3";
            else
                if (VHCF01IW-SV2.EQ-PARM == "AXLE4")
                    VHCF01IW-MSG.AXLE-MSG-01-6 = "4";
                end
            end
        end
    end
    if (SERIAL-LOCATED == "SRP" ||
     SERIAL-LOCATED == "CAR")
        return;
    else
        if (VHCF01D_DATA.SERIAL-STAT == "RMV" ||
         VHCF01D_DATA.SERIAL-STAT == "STO" ||
         VHCF01D_DATA.SERIAL-STAT == "VEN" ||
         VHCF01D_DATA.SERIAL-STAT == "SRV")
            VHCF01IW-MSG.AXLE-MSG-01-1 = "Axle Serial number ";
            VHCF01IW-MSG.AXLE-MSG-01-2 = VHCF01D_CRIT.SERIAL-NO;
            VHCF01IW-MSG.AXLE-MSG-01-3 = " was not added to car ";
            VHCF01IW-MSG.AXLE-MSG-01-4 = VHCF01IW-01.CAR-NO;
            VHCF01IW-MSG.AXLE-MSG-01-5 = ", position ";
  
            VHCF01IW-MSG.AXLE-MSG-01-7 = ". Invalid Axle status = ";
            VHCF01IW-MSG.AXLE-MSG-01-8 = VHCF01D_DATA.SERIAL-STAT;
            VHCF01IW-MSG.FINAL-MESSAGE = VHCF01IW-MSG.AXLE-MSG-01;
            ERROR-CNT = 1;
            VHCF01IS-EXP();
        else
            if (VHCF01D_DATA.SERIAL-STAT != "SEC")
                VHCF01IW-MSG.AXLE-MSG-1 = "Axle Serial number ";
                VHCF01IW-MSG.AXLE-MSG-2 = VHCF01D_CRIT.SERIAL-NO;
                VHCF01IW-MSG.AXLE-MSG-3 = "is invalid.  Missing part(s)";
                VHCF01IW-MSG.FINAL-MESSAGE = VHCF01IW-MSG.AXLE-MSG;
                ERROR-CNT = 1;
                VHCF01IS-EXP();
            else
                if (VHCF01D_DATA.FINAL-COUNT != 5)
                    VHCF01IW-MSG.AXLE-MSG-1 = "Axle Serial number ";
                    VHCF01IW-MSG.AXLE-MSG-2 = VHCF01D_CRIT.SERIAL-NO;
                    VHCF01IW-MSG.AXLE-MSG-3 = "is invalid.  Missing part(s)";
                    VHCF01IW-MSG.FINAL-MESSAGE = VHCF01IW-MSG.AXLE-MSG;
                    ERROR-CNT = 1;
                    VHCF01IS-EXPX();
                end
            end
        end
    end
end 

Function VHCF01IS-CK-SER () 
    VHCF01D_CRIT.CAR-NO = VHCF01IW-01.CAR-NO;
    VHCF01IW-FLAG.SERIAL-LOCATED = "   ";
    try
        call "VHCF01D"(XDCONTROL, VHCF01D_CRIT, VHCF01D_DATA);
    
    end
    if (VHCF01D_DATA.SERIAL-FOUND == "Y")
        if (VHCF01D_DATA.SERIAL-STAT == "SRP")
            VHCF01IW-FLAG.SERIAL-LOCATED = "SRP";
        else
            if (VHCF01D_DATA.CAR-NO == "0001" || VHCF01D_DATA.CAR-NO == "  ")
                VHCF01IW-FLAG.SERIAL-LOCATED = "DB";
            else
                VHCF01IW-FLAG.SERIAL-LOCATED = "CAR";
            end
        end
    else
        if (VHCF01D_DATA.SERIAL-FOUND == "N")
            VHCF01IW-FLAG.SERIAL-LOCATED = "NO";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

Function VHCF01IS-CK-WHEEL () 
    try
        call "VHCF01H"(XDCONTROL, VHCF01H_CRIT, VHCF01H_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF01H_DATA.SERIAL-FOUND = "Y";
    else
        if (XDCONTROL.URC == 100)
            VHCF01H_DATA.SERIAL-FOUND = "N";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

