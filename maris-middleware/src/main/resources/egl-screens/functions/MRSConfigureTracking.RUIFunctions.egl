                                        VHCF01IW.GEAR-SERIAL-02 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                        VHCF01IW.GEAR-STOCK-02 = VHCF01B_DATA.STOCK-NO[X];
                                    else
                                        if (VHCF01B_DATA.POSN-CD[X] == "3 " ||
                                         (VHCF01IW-PARM.TRUCK == "Y" && VHCF01B_DATA.POSN-CD[X] == " "))
                                            VHCF01IW.GEAR-SERIAL-03 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                            VHCF01IW.GEAR-STOCK-03 = VHCF01B_DATA.STOCK-NO[X];
                                        else
                                            VHCF01IW.GEAR-SERIAL-04 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                            VHCF01IW.GEAR-STOCK-04 = VHCF01B_DATA.STOCK-NO[X];
                                        end
                                    end
                                end
                            else
                                if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "BEARING")
                                    if (VHCF01B_DATA.POSN-CD[X] == "1 ")
                                        VHCF01IW.BEAR-SERIAL-01 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                        VHCF01IW.BEAR-STOCK-01 = VHCF01B_DATA.STOCK-NO[X];
                                    else
                                        if (VHCF01B_DATA.POSN-CD[X] == "2 ")
                                            VHCF01IW.BEAR-SERIAL-02 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                            VHCF01IW.BEAR-STOCK-02 = VHCF01B_DATA.STOCK-NO[X];
                                        else
                                            if (VHCF01B_DATA.POSN-CD[X] == "3 ")
                                                VHCF01IW.BEAR-SERIAL-03 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                                VHCF01IW.BEAR-STOCK-03 = VHCF01B_DATA.STOCK-NO[X];
                                            else
                                                if (VHCF01B_DATA.POSN-CD[X] == "4 ")
                                                    VHCF01IW.BEAR-SERIAL-04 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                                    VHCF01IW.BEAR-STOCK-04 = VHCF01B_DATA.STOCK-NO[X];
                                                else
                                                    if (VHCF01B_DATA.POSN-CD[X] == "5 " ||
                                                     (VHCF01IW-PARM.TRUCK == "Y" && VHCF01B_DATA.POSN-CD[X] == "B"))
                                                        VHCF01IW.BEAR-SERIAL-05 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                                        VHCF01IW.BEAR-STOCK-05 = VHCF01B_DATA.STOCK-NO[X];
                                                    else
                                                        if (VHCF01B_DATA.POSN-CD[X] == "6 " ||
                                                         (VHCF01IW-PARM.TRUCK == "Y" && VHCF01B_DATA.POSN-CD[X] == "N"))
                                                            VHCF01IW.BEAR-SERIAL-06 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                                            VHCF01IW.BEAR-STOCK-06 = VHCF01B_DATA.STOCK-NO[X];
                                                        else
                                                            if (VHCF01B_DATA.POSN-CD[X] == "7 ")
                                                                VHCF01IW.BEAR-SERIAL-07 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                                                VHCF01IW.BEAR-STOCK-07 = VHCF01B_DATA.STOCK-NO[X];
                                                            else
                                                                VHCF01IW.BEAR-SERIAL-08 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                                                VHCF01IW.BEAR-STOCK-08 = VHCF01B_DATA.STOCK-NO[X];
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        X = X + 1;
    end
end 

Function VHCF01IS-M-DATA-X4 () 
    if (VHCF01IW-01.ACTION-DATA == "NO ACTION SELECTED" ||
     VHCF01IW-01.ACTION-DATA == " " ||
     VHCF01IW-01.ACTION-DATA == "LIST DATA")
  
        VHCF01IS-EMP-NOX();
        if (VHCF01IW.EMPL-NOX != " ")
            VHCF01IW-MSG.FINAL-MESSAGE = " Employe ID and Shop Location represent final Survey";
        end
    else
        VHCF01IW.LOCX = " ";
        VHCF01IW.EMPL-NOX = " ";
    end
    VHCF01IW-CNT.X = 1;

  
  
  

  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
    VHCF01IW.DATE-CONFIG-UPD = VHCF01B_DATA.DATE-CONFIG-UPD[X];
    VHCF01IW.TIME-CONFIG-UPD = VHCF01B_DATA.TIME-CONFIG-UPD[X];
    VHCF01IW.DATE-CONFIG-UPDX = VHCF01B_DATA.DATE-CONFIG-UPD[X];
    VHCF01IW.TIME-CONFIG-UPDX = VHCF01B_DATA.TIME-CONFIG-UPD[X];
    VHCF01IW.TERM-CONFIG-UPD = VHCF01B_DATA.TERM-CONFIG-UPD[X];
    while (VHCF01IW-CNT.X <= VHCF01IW-CNT.NUM-OF-ROW)
        if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "TRUCK")
