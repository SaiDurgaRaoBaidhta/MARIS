                            VHCF01IW-03.AXLE-CMPNT-CUM-HR-04 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                        end
                    end
                end
            else
                if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "WHEEL")
                    VHCF01IS-WHEEL-X1();
                else
                    if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "BRAKE DISC")
                        VHCF01IS-DISC();
                    else
                        if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "TRACTION MOTOR")
                            VHCF01IS-TM();
                        else
                            if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "GEAR BOX")
                                if (VHCF01B_DATA.POSN-CD[X] == "1 " ||
                                 (VHCF01IW-PARM.TRUCK == "X" && VHCF01B_DATA.POSN-CD[X] == " "))
                                    VHCF01IW.GEAR-SERIAL-01 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                    VHCF01IW.GEAR-STOCK-01 = VHCF01B_DATA.STOCK-NO[X];
