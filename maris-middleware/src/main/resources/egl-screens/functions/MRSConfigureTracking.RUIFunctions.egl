    VHCF01T_CRIT_X.ON-PARM[29] = VHCF01IW-SV2.ON-PARM[29];
    VHCF01T_CRIT_X.ON-PARM[30] = VHCF01IW-SV2.ON-PARM[30];
    VHCF01T_CRIT_X.CAR-TYPE = VHCF01A_DATA.CAR-TYPE;
    VHCF01T_CRIT_X.CONFIG-CMPNT-STAT = VHCF01A_DATA.CONFIG-CMPNT-STAT;
    VHCF01T_CRIT_X.CONFIG-CMPNT-TYPE = VHCF01A_DATA.CONFIG-CMPNT-TYPE;
    VHCF01T_CRIT.TERM-LAST-UPD = VHCF01IW-PASSVALUE.TERM-LAST-UPD;
    VHCF01T_CRIT.CURRENT-ACTION = "ON";
    if (VHCF01T_CRIT_X.ON-PARM != " ")
        try
            call "VHCF01T"(XDCONTROL, VHCF01T_CRIT_X, VHCF01T_CRIT, VHCF01T_DATA, VHCF01T_DATA_1);
        
        end
        if (VHCF01T_CRIT.DATABASE-SW != "Y")
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHCF01IS-CLEARX();
  
                VHCF01IS-S-UNEDIT();
                VHCF01IS-LIST-ON();
                VHCF01IW-FLAG.DISABLE-UPDATE = "Y";
  
  
                VHCF01IW-MSG.FINAL-MESSAGE = "COMPONTS ARE BUILT/ADDED";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        else
            VHCF01IW-MSG.FINAL-MESSAGE = "Update not made, database error - sql code xxxx";
        end
    else
        VHCF01IW-MSG.FINAL-MESSAGE = "Update not made, please verify the data";
    end
end 

