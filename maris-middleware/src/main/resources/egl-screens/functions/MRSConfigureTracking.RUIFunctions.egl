                                VHCF01IW.WHEEL-SERIAL-07 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                VHCF01IW.WHEEL-STOCK-07 = VHCF01B_DATA.STOCK-NO[X];
                                VHCF01IW.FLANGE-7 = VHCF01C_DATA.FLANGE-THICKNESS;
                                VHCF01IW.DIAMETER-7 = VHCF01C_DATA.DIAMETER;
                            else
                                if (VHCF01B_DATA.POSN-CD[X] == "8 ")
                                    VHCF01IW.WHEEL-SERIAL-08 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                    VHCF01IW.WHEEL-STOCK-08 = VHCF01B_DATA.STOCK-NO[X];
                                    VHCF01IW.FLANGE-8 = VHCF01C_DATA.FLANGE-THICKNESS;
                                    VHCF01IW.DIAMETER-8 = VHCF01C_DATA.DIAMETER;
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHCF01IS-WHEEL-X4 () 
    VHCF01C_CRIT.CMPNT-SERIAL-NO = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
    VHCF01C_CRIT.CMPNT-STOCK-NO = VHCF01B_DATA.STOCK-NO[X];
    VHCF01C_CRIT.PART-DESC = "WHEEL";
    VHCF01IS-G-DETAIL();

  
    if (VHCF01B_DATA.POSN-CD[X] == "1 ")
        VHCF01IW.WHEEL-SERIAL-01 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
        VHCF01IW.WHEEL-STOCK-01 = VHCF01B_DATA.STOCK-NO[X];
        VHCF01IW.FLANGE-1 = VHCF01C_DATA.FLANGE-THICKNESS;
        VHCF01IW.DIAMETER-1 = VHCF01C_DATA.DIAMETER;
    else
        if (VHCF01B_DATA.POSN-CD[X] == "2 ")
            VHCF01IW.WHEEL-SERIAL-02 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
            VHCF01IW.WHEEL-STOCK-02 = VHCF01B_DATA.STOCK-NO[X];
            VHCF01IW.FLANGE-2 = VHCF01C_DATA.FLANGE-THICKNESS;
            VHCF01IW.DIAMETER-2 = VHCF01C_DATA.DIAMETER;
        else
            if (VHCF01B_DATA.POSN-CD[X] == "3 ")
                VHCF01IW.WHEEL-SERIAL-03 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                VHCF01IW.WHEEL-STOCK-03 = VHCF01B_DATA.STOCK-NO[X];
                VHCF01IW.FLANGE-3 = VHCF01C_DATA.FLANGE-THICKNESS;
                VHCF01IW.DIAMETER-3 = VHCF01C_DATA.DIAMETER;
            else
                if (VHCF01B_DATA.POSN-CD[X] == "4 ")
                    VHCF01IW.WHEEL-SERIAL-04 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                    VHCF01IW.WHEEL-STOCK-04 = VHCF01B_DATA.STOCK-NO[X];
                    VHCF01IW.FLANGE-4 = VHCF01C_DATA.FLANGE-THICKNESS;
                    VHCF01IW.DIAMETER-4 = VHCF01C_DATA.DIAMETER;
                else
                    if (VHCF01B_DATA.POSN-CD[X] == "5 ")
                        VHCF01IW.WHEEL-SERIAL-05 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                        VHCF01IW.WHEEL-STOCK-05 = VHCF01B_DATA.STOCK-NO[X];
                        VHCF01IW.FLANGE-5 = VHCF01C_DATA.FLANGE-THICKNESS;
                        VHCF01IW.DIAMETER-5 = VHCF01C_DATA.DIAMETER;
                    else
                        if (VHCF01B_DATA.POSN-CD[X] == "6 ")
                            VHCF01IW.WHEEL-SERIAL-06 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                            VHCF01IW.WHEEL-STOCK-06 = VHCF01B_DATA.STOCK-NO[X];
                            VHCF01IW.FLANGE-6 = VHCF01C_DATA.FLANGE-THICKNESS;
                            VHCF01IW.DIAMETER-6 = VHCF01C_DATA.DIAMETER;
                        else
                            if (VHCF01B_DATA.POSN-CD[X] == "7 " ||
                             (VHCF01IW-PARM.TRUCK == "Y" && VHCF01B_DATA.POSN-CD[X] == "B"))
                                VHCF01IW.WHEEL-SERIAL-07 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                VHCF01IW.WHEEL-STOCK-07 = VHCF01B_DATA.STOCK-NO[X];
                                VHCF01IW.FLANGE-7 = VHCF01C_DATA.FLANGE-THICKNESS;
                                VHCF01IW.DIAMETER-7 = VHCF01C_DATA.DIAMETER;
                            else
                                if (VHCF01B_DATA.POSN-CD[X] == "8 " ||
                                 (VHCF01IW-PARM.TRUCK == "Y" && VHCF01B_DATA.POSN-CD[X] == "N"))
                                    VHCF01IW.WHEEL-SERIAL-08 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                    VHCF01IW.WHEEL-STOCK-08 = VHCF01B_DATA.STOCK-NO[X];
                                    VHCF01IW.FLANGE-8 = VHCF01C_DATA.FLANGE-THICKNESS;
                                    VHCF01IW.DIAMETER-8 = VHCF01C_DATA.DIAMETER;
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHCF01S-CK-WHEEL () 
    try
        call "VHCF01H"(XDCONTROL, VHCF01H_CRIT, VHCF01H_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF01H_DATA.SERIAL-FOUND = "Y";
    else
        if (XDCONTROL.URC == 100)
            VHCF01H_DATA.SERIAL-FOUND = "N";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 



Function VHCF05IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  

  
  
  
   
    set VHCF05A_CRIT empty;
    VHCF05A_CRIT.REPT-TYPE = VHDVS4IW-PASSVALUE.VTAM-NAME;
    VHCF05A_CRIT.CAR-NO = VHCF05IW-PASSVALUE.CAR-NO;

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCF05I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF05A";

    
    try
        call "VHCF05A"(XDCONTROL, VHCF05A_CRIT, VHCF05A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
            VHEZE7IW-TRIGGER.SUBMIT = "Y";
        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHCF06IS-AXLE () 
    VHCF06IW-TRIGGER.AXLE-CONFIGURATION-ENABLE = "Y";
    VHCF06IW-TRIGGER.AXLE-RECON-DATE-ENABLE = "Y";
    VHCF06IW-TRIGGER.HUB-DATE-ENABLE = "Y";
    VHCF06IW-TRIGGER.DATE-REBUILT-ENABLE = "Y";
    if (VHCF06IW.GEAR-BOX-SERIAL-NO == " ")
        VHCF06IW-TRIGGER.GEAR-SERIAL-ENABLE = "Y";
    else
        VHCF06IW-TRIGGER.GEAR-SERIAL-DISABLE = "Y";
    end
    if (VHCF06IW.B-SERIAL-NO != " ")
        VHCF06IW-TRIGGER.B-SERIAL-DISABLE = "Y";
    else
        VHCF06IW-TRIGGER.B-SERIAL-ENABLE = "Y";
    end
    VHCF06IW-TRIGGER.B-DATE-REBUILT-ENABLE = "Y";
    if (VHCF06IW.N-SERIAL-NO != " ")
        VHCF06IW-TRIGGER.N-SERIAL-DISABLE = "Y";
    else
        VHCF06IW-TRIGGER.N-SERIAL-ENABLE = "Y";
    end
    VHCF06IW-TRIGGER.N-DATE-REBUILT-ENABLE = "Y";
    VHCF06IW-TRIGGER.FLANGE-01-ENABLE = "Y";
    VHCF06IW-TRIGGER.FLANGE-02-ENABLE = "Y";
    VHCF06IW-TRIGGER.DIAMETER-01-ENABLE = "Y";
    VHCF06IW-TRIGGER.DIAMETER-02-ENABLE = "Y";
end 

Function VHCF06IS-B-ON () 
    if (VHCF06IW.B-SERIAL-NO != " ")
        VHCF06IW-TRIGGER.B-ON-DISABLE = "Y";
        VHCF06IW-TRIGGER.B-OFF-ENABLE = "Y";
    else
        VHCF06IW-TRIGGER.B-ON-ENABLE = "Y";
        VHCF06IW-TRIGGER.B-OFF-DISABLE = "Y";
    end
end 

Function VHCF06IS-BUTTONS ()
   
    if (VHCF06IW.AXLE-SERIAL-NO != " ")
        VHCF06IW-TRIGGER.ENABLE-AXLE-MOD = "Y";
    end
    if (VHCF06IW.GEAR-BOX-SERIAL-NO != " ")
        VHCF06IW-TRIGGER.ENABLE-GEAR-MOD = "Y";
        
  
    end
    if (VHCF06IW.B-SERIAL-NO != " ")
        VHCF06IW-TRIGGER.ENABLE-BBEAR-MOD = "Y";
    end
    if (VHCF06IW.N-SERIAL-NO != " ")
        VHCF06IW-TRIGGER.ENABLE-NBEAR-MOD = "Y";
    end
end 

Function VHCF06IS-CLEAR () 
    VHCF06IW.AXLE-SERIAL-NO = " ";
    VHCF06IW.GEAR-SERIAL-NO = " ";
    set VHCF06IW empty;
    set VHCF06IW-MESSAGE empty;
    VHCF06IS-CLEAR-X();
    VHCF06IS-AXLE();

  
    VHCF06IW-TRIGGER.DISABLE-AXLE-MOD = "Y";
    VHCF06IW-TRIGGER.DISABLE-GEAR-MOD = "Y";
    VHCF06IW-TRIGGER.DISABLE-BBEAR-MOD = "Y";
    VHCF06IW-TRIGGER.DISABLE-NBEAR-MOD = "Y";
end 

Function VHCF06IS-CLEAR-X () 
    VHCF06IW-TRIGGER.GEAR-ON-DISABLE = "Y";
    VHCF06IW-TRIGGER.GEAR-OFF-DISABLE = "Y";
    VHCF06IW-TRIGGER.B-ON-DISABLE = "Y";
    VHCF06IW-TRIGGER.B-OFF-DISABLE = "Y";
    VHCF06IW-TRIGGER.N-ON-DISABLE = "Y";
    VHCF06IW-TRIGGER.N-OFF-DISABLE = "Y";
    VHCF06IW-TRIGGER.WHEEL-01-OFF-DISABLE = "Y";
    VHCF06IW-TRIGGER.WHEEL-01-ON-DISABLE = "Y";
    VHCF06IW-TRIGGER.WHEEL-02-OFF-DISABLE = "Y";
    VHCF06IW-TRIGGER.WHEEL-02-ON-DISABLE = "Y";
end 

