Function VHCF01IS-V-TM () 
    VHCF01IW-FLAG.INVALID-IND = "N";
  
  
  
  
    if ((VHCF01IW.TM-SERIAL-01 == "  " || VHCF01IW.TM-SERIAL-02 == "  " || VHCF01IW.TM-SERIAL-03 == "  " || VHCF01IW.TM-SERIAL-04 == "  ") &&
     (VHCF01IW-01.ACTION-DATA == "NO ACTION SELECTED" || VHCF01IW-01.ACTION-DATA == "  "))
        VHCF01IW-FLAG.INVALID-IND = "Y";
        VHCF01IW-MSG.FINAL-MESSAGE = "TM Serial #s can not be blank. Please double check. ";
    else
        if (((VHCF01IW.TM-SERIAL-01 == VHCF01IW.TM-SERIAL-02 && VHCF01IW.TM-SERIAL-01 != "   ") || (VHCF01IW.TM-SERIAL-01 == VHCF01IW.TM-SERIAL-03 && VHCF01IW.TM-SERIAL-01 != "   ") || (VHCF01IW.TM-SERIAL-01 == VHCF01IW.TM-SERIAL-04 && VHCF01IW.TM-SERIAL-01 != "    ") || (VHCF01IW.TM-SERIAL-02 == VHCF01IW.TM-SERIAL-03 && VHCF01IW.TM-SERIAL-02 != "    ") || (VHCF01IW.TM-SERIAL-02 == VHCF01IW.TM-SERIAL-04 && VHCF01IW.TM-SERIAL-02 != "   ") || (VHCF01IW.TM-SERIAL-03 == VHCF01IW.TM-SERIAL-04 && VHCF01IW.TM-SERIAL-03 != "   ")))
            VHCF01IW-FLAG.INVALID-IND = "Y";
            VHCF01IW-MSG.FINAL-MESSAGE = "TM Serial #s can not be the same.  Please double check. ";
        else
            if (VHCF01IW-01.ACTION-DATA != "TRUCK,AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "TM1")
                VHCF01IS-V-TM1();
            end
            if (VHCF01IW-FLAG.INVALID-IND == "N")
                if (VHCF01IW-01.ACTION-DATA != "TRUCK,AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "TM2")
                    VHCF01IS-V-TM2();
                end
            end
            if (VHCF01IW-FLAG.INVALID-IND == "N")
                if (VHCF01IW-01.ACTION-DATA != "TRUCK,AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "TM3")
                    VHCF01IS-V-TM3();
                end
            end
            if (VHCF01IW-FLAG.INVALID-IND == "N")
                if (VHCF01IW-01.ACTION-DATA != "TRUCK,AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "TM4")
                    VHCF01IS-V-TM4();
                end
            end
        end
    end
end 

Function VHCF01IS-V-TM0 () 
    VHCF01IW-FLAG.INVALID-IND = "N";
    VHCF01IW-FLAG.TM-01-IN-TABLE = "N";
    VHCF01IW-FLAG.TM-02-IN-TABLE = "N";
    VHCF01IW-FLAG.TM-03-IN-TABLE = "N";
    VHCF01IW-FLAG.TM-04-IN-TABLE = "N";
    if ((VHCF01IW.TM-SERIAL-01 == "  " || VHCF01IW.TM-SERIAL-02 == "  " || VHCF01IW.TM-SERIAL-03 == "  " || VHCF01IW.TM-SERIAL-04 == "  ") &&
     (VHCF01IW-01.ACTION-DATA == "NO ACTION SELECTED" || VHCF01IW-01.ACTION-DATA == "  "))
        VHCF01IW-FLAG.INVALID-IND = "Y";
        VHCF01IW-MSG.FINAL-MESSAGE = "TM Serial #s can not be blank. Please double check. ";
    else
        if (((VHCF01IW.TM-SERIAL-01 == VHCF01IW.TM-SERIAL-02 && VHCF01IW.TM-SERIAL-01 != "   ") || (VHCF01IW.TM-SERIAL-01 == VHCF01IW.TM-SERIAL-03 && VHCF01IW.TM-SERIAL-01 != "   ") || (VHCF01IW.TM-SERIAL-01 == VHCF01IW.TM-SERIAL-04 && VHCF01IW.TM-SERIAL-01 != "    ") || (VHCF01IW.TM-SERIAL-02 == VHCF01IW.TM-SERIAL-03 && VHCF01IW.TM-SERIAL-02 != "    ") || (VHCF01IW.TM-SERIAL-02 == VHCF01IW.TM-SERIAL-04 && VHCF01IW.TM-SERIAL-02 != "   ") || (VHCF01IW.TM-SERIAL-03 == VHCF01IW.TM-SERIAL-04 && VHCF01IW.TM-SERIAL-03 != "   ")))
            VHCF01IW-FLAG.INVALID-IND = "Y";
            VHCF01IW-MSG.FINAL-MESSAGE = "TM Serial #s can not be the same.  Please double check. ";
        else
            if (VHCF01IW-01.ACTION-DATA != "AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "TM1")
                VHCF01IS-V-TMX1();
            end
            if (VHCF01IW-FLAG.INVALID-IND == "N")
                if (VHCF01IW-01.ACTION-DATA != "AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "TM2")
                    VHCF01IS-V-TMX2();
                end
            end
            if (VHCF01IW-FLAG.INVALID-IND == "N")
                if (VHCF01IW-01.ACTION-DATA != "AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "TM3")
                    VHCF01IS-V-TMX3();
                end
            end
            if (VHCF01IW-FLAG.INVALID-IND == "N")
                if (VHCF01IW-01.ACTION-DATA != "AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "TM4")
                    VHCF01IS-V-TMX4();
                end
            end
        end
    end
end 

