Function VHCF01IS-A-EXCEPT () 
    try
        call "VHCF01Q"(XDCONTROL, VHCF01Q_CRIT, VHCF01Q_DATA);
    
    end
end 

Function VHCF01IS-ADD () 
    VHCF01IW-MSG.ERROR-CNT = 0;
    VHCF01Q_DATA.REC-CNT = 0;
    VHCF01IW-FLAG.CMPNT-STAT = "NONE";
    
  
  
  
  
  
  
  
  
  
  
  
  
    VHCF01IS-VALID-0();
    if (VHCF01IW-MSG.ERROR-CNT == 0)
        VHCF01IS-VALID-1();
        if (VHCF01IW-MSG.ERROR-CNT == 0 && VHCF01IW-FLAG.INVALID-IND == "N")
            VHCF01IS-BUILD-1();
            VHCF01IS-CLEARX();
            if (VHCF01F_CRIT.DATABASE-SW != "Y")
  
  
  

            end
        else
            if (VHCF01IW-FLAG.INVALID-IND == "N")
                VHCF01IS-MOVE-MSG();
            end
        end
    else
        VHCF01IS-MOVE-MSG();
    end
end 

Function VHCF01IS-AXLE1 ()
  
  

  
  

   
    if (VHCF01IW-PARM.TRUCK == "X")
        if (VHCF01IW.AXLE-SERIAL-01 != " ")
            VHCF01IS-AXLE1-X();
        end
    end
    if (VHCF01IW-PARM.TRUCK == "Y")
        if (VHCF01IW.AXLE-SERIAL-03 != " ")
            VHCF01IS-AXLE3-X();
        end
    end
end 

Function VHCF01IS-AXLE1-X () 
    VHCF01X_CRIT.CMPNT-SERIAL-NO = VHCF01IW.AXLE-SERIAL-01;
    VHCF01X_CRIT.AXLE-NEW-OLD = "OLD";
    try
        call "VHCF01X"(XDCONTROL, VHCF01X_CRIT, VHCF01X_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
        move VHCF01X_DATA.DATA_ROW to VHCF01B_DATA.DATA_ROW[1] for all;
        VHCF01IS-M-DATA-X();
    else
  
        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

