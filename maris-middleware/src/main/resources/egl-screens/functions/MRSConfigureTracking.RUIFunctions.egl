                                                                VHCF01IW.BEAR-STOCK-08 = VHCF01B_DATA.STOCK-NO[X];
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        X = X + 1;
    end
end 

