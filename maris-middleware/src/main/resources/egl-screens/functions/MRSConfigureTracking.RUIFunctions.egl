    VHCF01F_CRIT_X.CURRENT-ACTION = "ON";
    VHCF01F_CRIT_Y.CURRENT-ACTION = "ON";
    set VHCF01F_CRIT_Y empty;
    try
        call "VHCF01Y"(XDCONTROL, VHCF01F_CRIT, VHCF01F_CRIT_X, VHCF01F_CRIT_Y, VHCF01F_DATA, VHCF01F_DATA_1);
    
    end
    if (VHCF01F_CRIT.DATABASE-SW != "Y")
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF01IS-CLEARX();
            VHCF01IS-LIST();
  
            VHCF01IW-MSG.FINAL-MESSAGE = "TRUCKS AND ITS COMPONENTS ARE BUILT";
