Function VHCF01IS-VALID-1 () 
    VHCF01IW-MSG.FINAL-MESSAGE = " ";
    VHCF01IW-MSG.ERROR-MESSAGE = " ";
    VHCF01IW-MSG.ERROR-CNT = 0;
    INVALID-TRUCK-X-Y = "N";
    INVALID-TRUCK-X = "N";
    INVALID-TRUCK-Y = "N";
    INVALID-AXLE-01 = "N";
    INVALID-AXLE-02 = "N";
    INVALID-AXLE-03 = "N";
    INVALID-AXLE-04 = "N";
    INVALID-DISC-01 = "N";
    INVALID-DISC-02 = "N";
    INVALID-DISC-03 = "N";
    INVALID-DISC-04 = "N";
    INVALID-TM-01 = "N";
    INVALID-TM-02 = "N";
    INVALID-TM-03 = "N";
    INVALID-TM-04 = "N";
    INVALID-IND = "N";
    

  
    VHCF01IS-V-TRUCK();
    if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
        VHCF01IS-V-AXLE();
    end
    if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
        VHCF01IS-V-DISC();
    end
    if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
        VHCF01IS-V-TM();
    end
    if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
        VHCF01IS-V-WHEEL();
    end
    if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
        VHCF01IS-V-GEAR();
    end
    if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
        VHCF01IS-V-BEAR();
    end
end 

Function VHCF01IS-WHEEL () 
    VHCF01C_CRIT.CMPNT-SERIAL-NO = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
    VHCF01C_CRIT.CMPNT-STOCK-NO = VHCF01B_DATA.STOCK-NO[X];
    VHCF01C_CRIT.PART-DESC = "WHEEL";
    VHCF01IS-G-DETAIL();

  
    if (VHCF01B_DATA.POSN-CD[X] == "1 ")
        VHCF01IW.WHEEL-SERIAL-01 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
        VHCF01IW.WHEEL-STOCK-01 = VHCF01B_DATA.STOCK-NO[X];
        VHCF01IW.FLANGE-1 = VHCF01C_DATA.FLANGE-THICKNESS;
