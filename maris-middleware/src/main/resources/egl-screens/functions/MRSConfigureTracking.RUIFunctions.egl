        end
        if (VHCF01IW.DISC-SERIAL-04 == "  ")
            ERROR-CNT = ERROR-CNT + 1;
            ERROR-MESSAGE-OCCR[ERROR-CNT] = "-DISC#4 serial is blank @ ";
        end
        if (VHCF01IW.TM-SERIAL-01 == "  ")
            ERROR-CNT = ERROR-CNT + 1;
            ERROR-MESSAGE-OCCR[ERROR-CNT] = "-TM#1 serial is blank @ ";
        end
        if (VHCF01IW.TM-SERIAL-02 == "  ")
            ERROR-CNT = ERROR-CNT + 1;
            ERROR-MESSAGE-OCCR[ERROR-CNT] = "-TM#2 serial is blank @ ";
        end
        if (VHCF01IW.TM-SERIAL-03 == "  ")
            ERROR-CNT = ERROR-CNT + 1;
            ER-SER-NO[ERROR-CNT] = VHCF01IW.TM-SERIAL-03;
            ER-DESC[ERROR-CNT] = "-TM#3 serial is blank @ ";
        end
        if (VHCF01IW.TM-SERIAL-04 == "  ")
            ERROR-CNT = ERROR-CNT + 1;
            ERROR-MESSAGE-OCCR[ERROR-CNT] = "-TM#4 serial is blank @ ";
        end
    end
    if (VHCF01IW-MSG.ERROR-CNT == 0)
        VHCF01IS-G-GEO();
    end
    if (VHCF01IW-MSG.ERROR-CNT == 0)
        VHCF01IS-V2-DISC();
    end
    if (VHCF01IW-01.ACTION-DATA == "NO ACTION SELECTED" && VHCF01IW-SAVE.AC-DC-CD == "AC")

    else
        if (VHCF01IW-MSG.ERROR-CNT == 0)
            VHCF01IS-V2-TM();
        end
    end
    if (VHCF01IW-MSG.ERROR-CNT == 0)
        VHCF01IS-V2-WHEEL();
    end
end 

