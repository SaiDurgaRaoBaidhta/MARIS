

package MRSConfigureTracking;


Function TRUCK-DISABLE-X () 
    VHCF01IW-FLAG.DISABLE-AXLE-01 = "Y";
    VHCF01IW-FLAG.DISABLE-AXLE-02 = "Y";
    VHCF01IW-FLAG.DISABLE-DISC-01 = "Y";
    VHCF01IW-FLAG.DISABLE-DISC-02 = "Y";
    VHCF01IW-FLAG.DISABLE-TM-01 = "Y";
    VHCF01IW-FLAG.DISABLE-TM-02 = "Y";
end 

