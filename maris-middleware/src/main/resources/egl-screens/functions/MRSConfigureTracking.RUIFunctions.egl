Function VHCF06IS-V-WHEEL () 
    if (VHCF06IW-PASSVALUE.WHEEL-MEASUREMENT < VHCF01P_DATA.FLANGE-VALID-FROM ||
     VHCF06IW-PASSVALUE.WHEEL-MEASUREMENT > VHCF01P_DATA.FLANGE-VALID-TO)
        VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
        VHCF06IW-MESSAGE.MESSAGE-A6-1 = "Invalid ";
        VHCF06IW-MESSAGE.MESSAGE-A6-3 = " for Wheel ";
        VHCF06IW-MESSAGE.MESSAGE-A6-5 = "Must be within ";
        VHCF06IW-MESSAGE.MESSAGE-A6-6 = VHCF01P_DATA.FLANGE-VALID-FROM;
        VHCF06IW-MESSAGE.MESSAGE-A6-7 = " and ";
        VHCF06IW-MESSAGE.MESSAGE-A6-8 = VHCF01P_DATA.FLANGE-VALID-TO;
        VHCF06IW-MESSAGE.FINAL-MESSAGE = VHCF06IW-MESSAGE.MESSAGE-A6;
    end

  
    VHCF06IW.WHEEL-HOLD = VHCF06IW-PASSVALUE.WHEEL-MEASUREMENT;
    if (VHCF06IW.WHEEL-REMAIN == "0" || VHCF06IW.WHEEL-REMAIN == "5")

    else
        VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
        VHCF06IW-MESSAGE.MESSAGE-A8-1 = "Invalid ";
        VHCF06IW-MESSAGE.MESSAGE-A8-3 = " for Wheel ";
        VHCF06IW-MESSAGE.MESSAGE-A8-5 = "ENDING VALUE MUST 0 or 5";
        VHCF06IW-MESSAGE.FINAL-MESSAGE = VHCF06IW-MESSAGE.MESSAGE-A8;
    end
end 

Function VHCF06IS-V-WHEEX () 
    if (VHCF06IW-PASSVALUE.WHEEL-MEASUREMENT < VHCF01P_DATA.DIAMETER-VALID-FROM ||
     VHCF06IW-PASSVALUE.WHEEL-MEASUREMENT > VHCF01P_DATA.DIAMETER-VALID-TO)
        VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
        VHCF06IW-MESSAGE.MESSAGE-A6-1 = "Invalid ";
        VHCF06IW-MESSAGE.MESSAGE-A6-3 = " for Wheel  ";
        VHCF06IW-MESSAGE.MESSAGE-A6-5 = "Must be within ";
        VHCF06IW-MESSAGE.MESSAGE-A6-6 = VHCF01P_DATA.DIAMETER-VALID-FROM;
        VHCF06IW-MESSAGE.MESSAGE-A6-7 = " and ";
        VHCF06IW-MESSAGE.MESSAGE-A6-8 = VHCF01P_DATA.DIAMETER-VALID-TO;
        VHCF06IW-MESSAGE.FINAL-MESSAGE = VHCF06IW-MESSAGE.MESSAGE-A6;
    end
end 

Function VHCF06IS-VALD-AXLE () 
    if (VHCF06IW.GEAR-BOX-SERIAL-NO != " ")
        if (VHCF06IW.GEAR-DATE-REBUILT == " ")
            VHCF06IW-MESSAGE.MESSAGE-A2-1 = "Date Rebuilt required for Component";
            VHCF06IW-MESSAGE.MESSAGE-A2-2 = "Gear Box";
            VHCF06IW-MESSAGE.MESSAGE-A2-3 = " Serial No ";
            VHCF06IW-MESSAGE.MESSAGE-A2-4 = VHCF06IW.GEAR-BOX-SERIAL-NO;
            VHCF06IW-MESSAGE.FINAL-MESSAGE = VHCF06IW-MESSAGE.MESSAGE-A2;
            VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
        end
    end
    if (VHCF06IW.GEAR-CHECK-ON == "1")
        if (VHCF06IW.GEAR-BOX-SERIAL-NO == " ")
            VHCF06IW-MESSAGE.MESSAGE-A3-1 = "Serial Number for Component ";
            VHCF06IW-MESSAGE.MESSAGE-A3-2 = "Gear Box";
            VHCF06IW-MESSAGE.MESSAGE-A3-3 = " is required for the 'On' action.";
            VHCF06IW-MESSAGE.FINAL-MESSAGE = VHCF06IW-MESSAGE.MESSAGE-A3;
            VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
        end
    end
    if (VHCF06IW.B-CHECK-ON == "1")
        if (VHCF06IW.B-SERIAL-NO == " ")
            VHCF06IW-MESSAGE.MESSAGE-A3-1 = "Serial Number for Component ";
            VHCF06IW-MESSAGE.MESSAGE-A3-2 = "Bearing";
            VHCF06IW-MESSAGE.MESSAGE-A3-3 = " is required for the 'On' action.";
            VHCF06IW-MESSAGE.FINAL-MESSAGE = VHCF06IW-MESSAGE.MESSAGE-A3;
            VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
        end
    end
    if (VHCF06IW.N-CHECK-ON == "1")
        if (VHCF06IW.N-SERIAL-NO == " ")
            VHCF06IW-MESSAGE.MESSAGE-A3-1 = "Serial Number for Component ";
            VHCF06IW-MESSAGE.MESSAGE-A3-2 = "Bearing";
            VHCF06IW-MESSAGE.MESSAGE-A3-3 = " is required for the 'On' action.";
            VHCF06IW-MESSAGE.FINAL-MESSAGE = VHCF06IW-MESSAGE.MESSAGE-A3;
            VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
        end
    end

  
  
  
  
  
  
  
  
  

  
  
  
  
  
  
  
  
  
    if (VHCF06IW.WHEEL-01-CHECK-ON == "1")
        if (VHCF06IW.WHEEL-01-SERIAL-NO != " ")
            if (VHCF06IW.FLANGE-01-MEASUREMENT <= 0 ||
             VHCF06IW.DIAMETER-01-MEASUREMENT <= 0)
                VHCF06IW-MESSAGE.FINAL-MESSAGE = "Flange or Diameter input required for Wheel 'On' Processing";
                VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
            end
        end
    end
    if (VHCF06IW.AXLE-REBUILT-DATE == " ")
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "Please enter axle rebuilt date";
        VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
    end
    if (VHCF06IW.AXLE-HUB-COUP-REPL-DATE == " ")
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "Please enter axle hub coupling repl date";
        VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
    end
    if (VHCF06IW.WHEEL-02-CHECK-ON == "1")
        if (VHCF06IW.WHEEL-02-SERIAL-NO != " ")
            if (VHCF06IW.FLANGE-02-MEASUREMENT < 0 ||
             VHCF06IW.DIAMETER-02-MEASUREMENT <= 0)
                VHCF06IW-MESSAGE.FINAL-MESSAGE = "Flange or Diameter input required for Wheel 'On' Processing";
                VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
            end
        end
    end
    if (VHCF06IW-SAVE.GEAR-BOX-SERIAL-NO != VHCF06IW.GEAR-BOX-SERIAL-NO)
        VHCF06IS-V-GEAR();
        if (VHCF06C_CRIT.INVALID-CMPNT == "Y")
            VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
            VHCF06IW-MESSAGE.FINAL-MESSAGE = "Gear Box Serial No invalid";
        else
            VHCF06IS-V-GEAR2(); 
        end
    end
    if (VHCF06IW-SAVE.B-SERIAL-NO != VHCF06IW.B-SERIAL-NO)
        VHCF06IS-V-BEAR();
        if (VHCF06C_CRIT.INVALID-CMPNT == "Y")
            VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
            VHCF06IW-MESSAGE.FINAL-MESSAGE = "B- Bearing Serial No invalid";
        else
            VHCF06IS-V-BEAR2();
        end 
    end
    if (VHCF06IW-SAVE.N-SERIAL-NO != VHCF06IW.N-SERIAL-NO)
        VHCF06IS-V-NEAR();
        if (VHCF06C_CRIT.INVALID-CMPNT == "Y")
            VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
            VHCF06IW-MESSAGE.FINAL-MESSAGE = "N-Bearing Serial No invalid";
        else
            VHCF06IS-V-NEAR2();
        end
    end
    if (VHCF06IW.GEAR-DATE-REBUILT != VHCF06IW-SAVE.GEAR-DATE-REBUILT)
        if (VHCF06IW.GEAR-DATE-REBUILT != " ")
            if (VHCF06IW-SAVE.GEAR-DATE-REBUILT == " ")
  
                XXDATEW.VAGen_FUNCTION = "YMD";
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.GEAR-DATE-REBUILT;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06D_CRIT.DATE-REBUILT = XXDATEW.DATE-YYYY-MM-DD;
                TESTING-DATE-YYYY = VHCF06D_CRIT.DATE-REBUILT-YYYY;
                TESTING-DATE-MM = VHCF06D_CRIT.DATE-REBUILT-MM;
                TESTING-DATE-DD = VHCF06D_CRIT.DATE-REBUILT-DD;
                VHCF06IS-V-GEAR-6Y();
                if (VHCF06D_CRIT.INVALID-DATE == "Y")
                    VHCF06IW-MESSAGE.FINAL-MESSAGE = "Historical Gear Box Date Rebuilt invalid, must be within 6 years of CURRENT_DATE";
                    VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
                end
            else
  
                XXDATEW.VAGen_FUNCTION = "YMD";
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.GEAR-DATE-REBUILT;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06D_CRIT.DATE-REBUILT = XXDATEW.DATE-YYYY-MM-DD;
                TESTING-DATE-YYYY = VHCF06D_CRIT.DATE-REBUILT-YYYY;
                TESTING-DATE-MM = VHCF06D_CRIT.DATE-REBUILT-MM;
                TESTING-DATE-DD = VHCF06D_CRIT.DATE-REBUILT-DD;
                VHCF06IS-V-GEAR-1Y();
                if (VHCF06D_CRIT.INVALID-DATE == "Y")
                    VHCF06IW-MESSAGE.FINAL-MESSAGE = "Updated Gear Box Date Rebuilt invalid, must be within 1 years of CURRENT_DATE";
                    VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
                end
            end
        end
    end
    if (VHCF06IW.AXLE-REBUILT-DATE != VHCF06IW-SAVE.AXLE-REBUILT-DATE)
        if (VHCF06IW.AXLE-REBUILT-DATE != " ")
            if (VHCF06IW-SAVE.AXLE-REBUILT-DATE == " ")
  
                XXDATEW.VAGen_FUNCTION = "YMD";
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.AXLE-REBUILT-DATE;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06D_CRIT.DATE-REBUILT = XXDATEW.DATE-YYYY-MM-DD;
                TESTING-DATE-YYYY = VHCF06D_CRIT.DATE-REBUILT-YYYY;
                TESTING-DATE-MM = VHCF06D_CRIT.DATE-REBUILT-MM;
                TESTING-DATE-DD = VHCF06D_CRIT.DATE-REBUILT-DD;
                VHCF06IS-V-GEAR-6Y();
                if (VHCF06D_CRIT.INVALID-DATE == "Y")
                    VHCF06IW-MESSAGE.FINAL-MESSAGE = "Historical Axle Date Rebuilt invalid, must be within 6 years of CURRENT_DATE";
                    VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
                end
            else
  
                XXDATEW.VAGen_FUNCTION = "YMD";
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.AXLE-REBUILT-DATE;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06D_CRIT.DATE-REBUILT = XXDATEW.DATE-YYYY-MM-DD;
                TESTING-DATE-YYYY = VHCF06D_CRIT.DATE-REBUILT-YYYY;
                TESTING-DATE-MM = VHCF06D_CRIT.DATE-REBUILT-MM;
                TESTING-DATE-DD = VHCF06D_CRIT.DATE-REBUILT-DD;
                VHCF06IS-V-GEAR-1Y();
                if (VHCF06D_CRIT.INVALID-DATE == "Y")
                    VHCF06IW-MESSAGE.FINAL-MESSAGE = "Updated Axle Date Rebuilt invalid, must be within 1 years of CURRENT_DATE";
                    VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
                end
            end
        end
    end
    if (VHCF06IW.AXLE-HUB-COUP-REPL-DATE != VHCF06IW-SAVE.AXLE-HUB-COUP-REPL-DATE || VHCF06IW.HUB-DATE-CHECK-UPDATE == "1")
        if (VHCF06IW.AXLE-HUB-COUP-REPL-DATE != " ")
            if (VHCF06IW-SAVE.AXLE-HUB-COUP-REPL-DATE == " ")
  
                XXDATEW.VAGen_FUNCTION = "YMD";
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.AXLE-HUB-COUP-REPL-DATE;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06D_CRIT.DATE-REBUILT = XXDATEW.DATE-YYYY-MM-DD;
                TESTING-DATE-YYYY = VHCF06D_CRIT.DATE-REBUILT-YYYY;
                TESTING-DATE-MM = VHCF06D_CRIT.DATE-REBUILT-MM;
                TESTING-DATE-DD = VHCF06D_CRIT.DATE-REBUILT-DD;
                VHCF06IS-V-GEAR-6Y();
                if (VHCF06D_CRIT.INVALID-DATE == "Y")
                    VHCF06IW-MESSAGE.FINAL-MESSAGE = "Historical Axle Hub Coup Repl Date invalid, must be within 6 years of CURRENT_DATE";
                    VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
                end
            else
  
                XXDATEW.VAGen_FUNCTION = "YMD";
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.AXLE-HUB-COUP-REPL-DATE;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06D_CRIT.DATE-REBUILT = XXDATEW.DATE-YYYY-MM-DD;
                TESTING-DATE-YYYY = VHCF06D_CRIT.DATE-REBUILT-YYYY;
                TESTING-DATE-MM = VHCF06D_CRIT.DATE-REBUILT-MM;
                TESTING-DATE-DD = VHCF06D_CRIT.DATE-REBUILT-DD;
                VHCF06IS-V-GEAR-1Y();
                if (VHCF06D_CRIT.INVALID-DATE == "Y")
                    VHCF06IW-MESSAGE.FINAL-MESSAGE = "Updated Axle Hub Coup Repl Date invalid, must be within 1 years of CURRENT_DATE";
                    VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
                end
            end
        end
    end

  
  
  
  
  
  
  
  
  
  
  
  
  

  
  
  
  
  
  
  
  
  
  
  
  
  

  
    if ((VHCF06IW.WHEEL-01-CHECK-ON == "1" || VHCF06IW.WHEEL-01-CHECK-OFF == "1" ||
     VHCF06IW.WHEEL-02-CHECK-ON == "1" || VHCF06IW.WHEEL-02-CHECK-OFF == "1" ||
     VHCF06IW.WHEEL-01-CHECK-UPDATE == "1" || VHCF06IW.WHEEL-02-CHECK-UPDATE == "1"))
        try
            call "VHCF01P"(XDCONTROL, VHCF01P_CRIT, VHCF01P_DATA);
        
        end

   

  
        if ((VHCF06IW.WHEEL-01-CHECK-ON == "1" || VHCF06IW.WHEEL-01-CHECK-OFF == "1" || VHCF06IW.WHEEL-01-CHECK-UPDATE == "1"))
            VHCF06IW-PASSVALUE.WHEEL-MEASUREMENT = VHCF06IW.FLANGE-01-MEASUREMENT;
            VHCF06IW-MESSAGE.MESSAGE-A6-4 = VHCF06IW.WHEEL-01-SERIAL-NO;
            VHCF06IW-MESSAGE.MESSAGE-A6-2 = "Flange 01";
            VHCF06IW-MESSAGE.MESSAGE-A8-4 = VHCF06IW.WHEEL-01-SERIAL-NO;
            VHCF06IW-MESSAGE.MESSAGE-A8-2 = "Flange 01";
            VHCF06IS-V-WHEEL();

  
            VHCF06IW-PASSVALUE.WHEEL-MEASUREMENT = VHCF06IW.DIAMETER-01-MEASUREMENT;
            VHCF06IW-MESSAGE.MESSAGE-A6-4 = VHCF06IW.WHEEL-01-SERIAL-NO;
            VHCF06IW-MESSAGE.MESSAGE-A6-2 = "Diameter 01";
            VHCF06IS-V-WHEEX();
        end
  


  
  
        if ((VHCF06IW.WHEEL-02-CHECK-ON == "1" || VHCF06IW.WHEEL-02-CHECK-OFF == "1" || VHCF06IW.WHEEL-02-CHECK-UPDATE == "1"))
            VHCF06IW-PASSVALUE.WHEEL-MEASUREMENT = VHCF06IW.FLANGE-02-MEASUREMENT;
            VHCF06IW-MESSAGE.MESSAGE-A6-4 = VHCF06IW.WHEEL-02-SERIAL-NO;
            VHCF06IW-MESSAGE.MESSAGE-A6-2 = "Flange 02";
            VHCF06IW-MESSAGE.MESSAGE-A8-4 = VHCF06IW.WHEEL-02-SERIAL-NO;
            VHCF06IW-MESSAGE.MESSAGE-A8-2 = "Flange 02";
            VHCF06IS-V-WHEEL();
  
            VHCF06IW-PASSVALUE.WHEEL-MEASUREMENT = VHCF06IW.DIAMETER-02-MEASUREMENT;
            VHCF06IW-MESSAGE.MESSAGE-A6-4 = VHCF06IW.WHEEL-02-SERIAL-NO;
            VHCF06IW-MESSAGE.MESSAGE-A6-2 = "Diameter 02";
            VHCF06IS-V-WHEEX();
        end
  

  
  
  
  
  
  

  
  
  
  
  
  

  
  
  
  
  
  
  
  
    end
end 

Function VHCF06IS-VALD-GEAR () 
    if (VHCF06IW.GEAR-BOX-SERIAL-NO != " ")
        if (VHCF06IW.GEAR-DATE-REBUILT == " ")
            VHCF06IW-MESSAGE.MESSAGE-A2-1 = "Date Rebuilt required for Component";
            VHCF06IW-MESSAGE.MESSAGE-A2-2 = "Gear Box";
            VHCF06IW-MESSAGE.MESSAGE-A2-3 = " Serial No ";
            VHCF06IW-MESSAGE.MESSAGE-A2-4 = VHCF06IW.GEAR-BOX-SERIAL-NO;
            VHCF06IW-MESSAGE.FINAL-MESSAGE = VHCF06IW-MESSAGE.MESSAGE-A2;
            VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
        end
    end
    if (VHCF06IW.GEAR-CHECK-ON == "1")
        if (VHCF06IW.GEAR-BOX-SERIAL-NO == " ")
            VHCF06IW-MESSAGE.MESSAGE-A3-1 = "Serial Number for Component ";
            VHCF06IW-MESSAGE.MESSAGE-A3-2 = "Gear Box";
            VHCF06IW-MESSAGE.MESSAGE-A3-3 = " is required for the 'On' action.";
            VHCF06IW-MESSAGE.FINAL-MESSAGE = VHCF06IW-MESSAGE.MESSAGE-A3;
            VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
        end
    end
    if (VHCF06IW.GEAR-DATE-REBUILT != VHCF06IW-SAVE.GEAR-DATE-REBUILT)
        if (VHCF06IW.GEAR-DATE-REBUILT != " ")
            if (VHCF06IW-SAVE.GEAR-DATE-REBUILT == " ")
  
                VHCF06C_CRIT.DATE-REBUILT = VHCF06IW.GEAR-DATE-REBUILT;
                XXDATEW.VAGen_FUNCTION = "YMD";
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.GEAR-DATE-REBUILT;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06D_CRIT.DATE-REBUILT = XXDATEW.DATE-YYYY-MM-DD;
                TESTING-DATE-YYYY = VHCF06D_CRIT.DATE-REBUILT-YYYY;
                TESTING-DATE-MM = VHCF06D_CRIT.DATE-REBUILT-MM;
                TESTING-DATE-DD = VHCF06D_CRIT.DATE-REBUILT-DD;
                VHCF06IS-V-GEAR-6Y();
                if (VHCF06D_CRIT.INVALID-DATE == "Y")
                    VHCF06IW-MESSAGE.FINAL-MESSAGE = "Historical Gear Box Date Rebuilt invalid, must be within 6 years of CURRENT_DATE";
                    VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
                end
            else
  
                XXDATEW.VAGen_FUNCTION = "YMD";
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.GEAR-DATE-REBUILT;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06D_CRIT.DATE-REBUILT = XXDATEW.DATE-YYYY-MM-DD;
                TESTING-DATE-YYYY = VHCF06D_CRIT.DATE-REBUILT-YYYY;
                TESTING-DATE-MM = VHCF06D_CRIT.DATE-REBUILT-MM;
                TESTING-DATE-DD = VHCF06D_CRIT.DATE-REBUILT-DD;
                VHCF06IS-V-GEAR-1Y();
                if (VHCF06D_CRIT.INVALID-DATE == "Y")
                    VHCF06IW-MESSAGE.FINAL-MESSAGE = "Updated Gear Box Date Rebuilt invalid, must be within 1 years of CURRENT_DATE";
                    VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
                end
            end
        end
    end
end 

Function VHCF06IS-VALIDATE () 
    if (VHCF06A_CRIT.AXLE-NOT-FOUND == "Y")
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "Component does not exist, please use add comonent GUI to add it";
        VHCF06IW-TRIGGER.SELECT-CRIT-ENABLE = "Y";
        VHCF06IW-TRIGGER.DISABLE-UPDATE = "Y";
        VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
        VHCF06IS-CLEAR-X();
    else
        if (VHCF06A_DATA.SERIAL-STAT[1] == "SRP")
            VHCF06IW-MESSAGE.FINAL-MESSAGE = "Component does not exist";
            VHCF06IW-TRIGGER.SELECT-CRIT-ENABLE = "Y";
            VHCF06IW-TRIGGER.DISABLE-UPDATE = "Y";
            VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
            VHCF06IS-CLEAR-X();
        else
            if (VHCF06A_DATA.SERIAL-STAT[1] == "CAR")
  
                VHCF06IW-MESSAGE.MESSAGE-A1-1 = "Update not allowed.  Component still on car";
                VHCF06IW-MESSAGE.MESSAGE-A7-1 = "SEC REPR: Axle ";
                VHCF06IW-MESSAGE.MESSAGE-A7-2 = VHCF06IW.AXLE-SERIAL-NO;
                VHCF06IW-MESSAGE.MESSAGE-A7-3 = " Is On Car No";
                VHCF06IW-MESSAGE.MESSAGE-A7-4 = VHCF06A_DATA.CAR-NO[1];
                VHCF06IS-UPEXCP();
    
  
                VHCF06IW-MESSAGE.FINAL-MESSAGE = VHCF06IW-MESSAGE.MESSAGE-A7;
                VHCF06IW-TRIGGER.SELECT-CRIT-ENABLE = "Y";
                VHCF06IW-TRIGGER.DISABLE-UPDATE = "Y";
                VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
                VHCF06IS-CLEAR-X();
            else
                if (VHCF06IW.GEAR-SERIAL-NO != " " &&
                 VHCF06A_DATA.CMPNT-SERIAL-NO[1] == " ")
                    VHCF06IW-MESSAGE.FINAL-MESSAGE = "Gear Box Serial No Not Exist";
                    VHCF06IW-TRIGGER.SELECT-CRIT-ENABLE = "Y";
                    VHCF06IW-TRIGGER.DISABLE-UPDATE = "Y";
                    VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
                    VHCF06IS-CLEAR-X();
                else 
                    VHCF06IW-TRIGGER.ENABLE-UPDATE = "Y";
                    VHCF06IW-TRIGGER.SELECT-CRIT-DISABLE = "Y";
                    VHCF06IS-M-DATA();
                    VHCF06IS-SET-ON-OF();
                end
            end
        end
    end
end
