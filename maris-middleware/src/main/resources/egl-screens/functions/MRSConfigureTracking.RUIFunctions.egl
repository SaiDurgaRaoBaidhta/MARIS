    end
    if (VHCF01IW.TM-SERIAL-01 == VHCF01IW-SAVE.SAVE-TM-SER-01 && VHCF01IW-SAVE.SAVE-TM-SER-01 != "A-EXCEPT")
        VHCF01IW-FLAG.TM-01-IN-TABLE = "Y";
        VHCF01IW-SAVE.SAVE-TM-SER-01 = "A-EXCEPT";
        VHCF01IW-FLAG.CMPNT-STAT = "INCP";
        VHCF01Q_DATA.MSG-02A = "is on another car.  ";
        VHCF01IS-EXP-TM1();
    else
        if (VHCF01IW.TM-SERIAL-01 == VHCF01IW-SAVE.SV-TM-SER-01 && VHCF01IW-SAVE.SV-TM-SER-01 != "A-EXCEPT")
            VHCF01IW-FLAG.TM-01-IN-TABLE = "Y";
            VHCF01IW-SAVE.SAVE-TM-SER-01 = "A-EXCEPT";
            VHCF01IW-FLAG.CMPNT-STAT = "INCP";
            VHCF01Q_DATA.MSG-02A = "is on another truck.  ";
            VHCF01IS-EXP-TM1();
        else
            VHCF01D_CRIT.SERIAL-NO = VHCF01IW.TM-SERIAL-01;
            VHCF01D_CRIT.CMPNT-EQUIP-TYPE = "TRACTION MOTOR";
            VHCF01D_CRIT.POSN-CD = "1";
            VHCF01IS-CK-SER();
            if (VHCF01IW.CONTINUE-CAR-TM01 == "Y" &&
             VHCF01IW.TM-SERIAL-01 == VHCF01IW-SAVEX.TM-SERIAL-01)
                return;
            else
                VHCF01IW-SAVE.SV-TM-01-STOCK-NO = VHCF01D_DATA.STOCK-NO;
                if (SERIAL-LOCATED == "SRP")
                    VHCF01IW-MSG.MSG-01 = "SERIAL#: ";
                    VHCF01IW-MSG.SERIAL-NO = VHCF01IW.TM-SERIAL-01;
                    VHCF01IW-MSG.MSG-02 = "-TM #1 serial has been scrapped.  Please re-enter the serial number";
                    INVALID-IND = "Y";
                else
                    if (SERIAL-LOCATED == "CAR")
                        VHCF01IW.SERIAL-LOCATED-TM01 = "CAR";
                        VHCF01IW.CONTINUE-CAR-TM01 = "Y";
                        VHCF01IW-FLAG.TM-01-IN-TABLE = "Y";
                        SAVE-TM-SER-01 = VHCF01IW.TM-SERIAL-01;
                        VHCF01IW-SAVEX.TM-SERIAL-01 = VHCF01IW.TM-SERIAL-01;
                        VHCF01IW-MSG.MSG-01 = "SERIAL#:";
                        VHCF01IW-MSG.SERIAL-NO = VHCF01IW.TM-SERIAL-01;
                        VHCF01IW-MSG.MSG-02 = "-TM #1 is on anther car.  Do you want to continue (Press Update again to continue)";
                        INVALID-IND = "Y";
                        VHCF01F_CRIT_X.EXCEP-CAR-NO-TM-1 = VHCF01D_DATA.CAR-NO;
                        VHCF01T_CRIT_X.EXCEP-CAR-NO-TM-1 = VHCF01D_DATA.CAR-NO;
                    else
                        if (SERIAL-LOCATED == "DB")
                            if (VHCF01D_DATA.PARENT-SERIAL-NO == "  ")
                                VHCF01IW-FLAG.TM-01-IN-TABLE = "Y";
                            else
                                if (VHCF01D_DATA.PARENT-SERIAL-NO != VHCF01IW.X-TRUCK-SERIAL ||
                                 VHCF01D_DATA.PARENT-STOCK-NO != VHCF01IW-SAVE.SV-X-STOCK-NO)
                                    SV-TM-SER-01 = VHCF01IW.TM-SERIAL-01;
                                    VHCF01IW-MSG.MSG-01 = "SERIAL#:";
                                    VHCF01IW-MSG.SERIAL-NO = VHCF01IW.TM-SERIAL-01;
                                    VHCF01IW-MSG.MSG-02 = "-TM #1 is on anther truck.  Do you want to continue (Press Update again to continue)";
                                    INVALID-IND = "Y";
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if (VHCF01IW-01.ACTION-DATA == "AXLE, MOTOR, DISC - SERIAL ON")
        if (VHCF01IW-FLAG.TM-01-IN-TABLE != "Y")
            VHCF01IW-MSG.AXLE-MSG-1 = "TM Serial number ";
            VHCF01IW-MSG.AXLE-MSG-2 = VHCF01IW.TM-SERIAL-01;
            VHCF01IW-MSG.AXLE-MSG-3 = "must already exist";
            VHCF01IW-MSG.FINAL-MESSAGE = VHCF01IW-MSG.AXLE-MSG;
            ERROR-CNT = 1;
            VHCF01IS-EXP-TM();
        end
    end
end 

