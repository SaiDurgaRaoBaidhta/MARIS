     VHCF06IW-PASSVALUE.WS-BEAR-SERIAL-NO-1 >= VHCF06E_DATA.BEAR-DATE-CCYY)
        return;
    else
        VHCF06IW-MESSAGE.MESSAGE-A5-1 = "Invalid N Bearing serial number, ";
        VHCF06IW-MESSAGE.MESSAGE-A5-2 = VHCF06IW.N-SERIAL-NO;
        VHCF06IW-MESSAGE.MESSAGE-A5-3 = " First two position must be valid year";
        VHCF06IW-MESSAGE.FINAL-MESSAGE = VHCF06IW-MESSAGE.MESSAGE-A5;
        VHCF06IW-TRIGGER.ERROR-FLAG = "Y";
    end
end 

