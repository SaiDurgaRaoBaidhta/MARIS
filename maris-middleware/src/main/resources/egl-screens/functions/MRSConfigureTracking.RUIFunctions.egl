            VHCF01IW-PASSVALUE.VALID-FROM-X = VHCF01P_DATA.READ-TIR-C-VALID-FROM;
            VHCF01IW-PASSVALUE.VALID-TO-X = VHCF01P_DATA.READ-TIR-C-VALID-TO;
            TM-MSG-2 = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.TM-MSG-2- = ".";
