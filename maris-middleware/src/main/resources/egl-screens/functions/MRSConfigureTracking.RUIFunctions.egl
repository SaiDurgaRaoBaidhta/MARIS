    if (VHCF01IW.CONTINUE-CAR-DISC03 == "Y" &&
     VHCF01IW.DISC-SERIAL-03 == VHCF01IW-SAVEX.DISC-SERIAL-03)
        return;
    else
        VHCF01IW-SAVE.SV-DISC-03-STOCK-NO = VHCF01D_DATA.STOCK-NO;
        if (SERIAL-LOCATED == "SRP")
            VHCF01IW-MSG.MSG-01 = "SERIAL#: ";
            VHCF01IW-MSG.SERIAL-NO = VHCF01IW.DISC-SERIAL-03;
            VHCF01IW-MSG.MSG-02 = "-DISC #3 serial has been scrapped.  Please re-enter the serial number";
            INVALID-IND = "Y";
        else
            if (SERIAL-LOCATED == "CAR")
                VHCF01IW.SERIAL-LOCATED-DISC03 = "CAR";
                VHCF01IW.CONTINUE-CAR-DISC03 = "Y";
                VHCF01IW-FLAG.DISC-03-IN-TABLE = "Y";
                SAVE-DISC-SER-03 = VHCF01IW.DISC-SERIAL-03;
                VHCF01IW-SAVEX.DISC-SERIAL-03 = VHCF01IW.DISC-SERIAL-03;
                VHCF01IW-MSG.MSG-01 = "SERIAL#:";
                VHCF01IW-MSG.SERIAL-NO = VHCF01IW.DISC-SERIAL-03;
                VHCF01IW-MSG.MSG-02 = "-DISC #3 is on anther car.  Do you want to continue (Press Update again to continue)";
                INVALID-IND = "Y";
                VHCF01F_CRIT_Y.EXCEP-CAR-NO-DC-3 = VHCF01D_DATA.CAR-NO;
                VHCF01T_CRIT_X.EXCEP-CAR-NO-DC-3 = VHCF01D_DATA.CAR-NO;
            else
                if (SERIAL-LOCATED == "DB")
                    if (VHCF01D_DATA.PARENT-SERIAL-NO == "  ")
                        VHCF01IW-FLAG.DISC-03-IN-TABLE = "Y";
                    else
                        if (VHCF01D_DATA.PARENT-SERIAL-NO != VHCF01IW.Y-TRUCK-SERIAL ||
                         VHCF01D_DATA.PARENT-STOCK-NO != VHCF01IW-SAVE.SV-Y-STOCK-NO)
                            SV-DISC-SER-03 = VHCF01IW.DISC-SERIAL-03;
                            VHCF01IW-MSG.MSG-01 = "SERIAL#:";
                            VHCF01IW-MSG.SERIAL-NO = VHCF01IW.DISC-SERIAL-03;
                            VHCF01IW-MSG.MSG-02 = "-DISC #3 is on anther truck.  Do you want to continue (Press Update again to continue)";
                            INVALID-IND = "Y";
                        end
                    end
                end
            end
        end
    end
end 

