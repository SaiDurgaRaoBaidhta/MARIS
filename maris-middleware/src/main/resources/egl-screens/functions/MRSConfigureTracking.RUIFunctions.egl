Function VHCF01IS-BUILD-3 () 
    VHCF01U_CRIT.CMPNT-SERIAL-NO = VHCF01IW-SV3.CMPNT-SERIAL-NO[U-CNT];
    VHCF01U_CRIT.POSN-CD = VHCF01IW-SV3.POSN-CD[U-CNT];
    VHCF01U_CRIT.GEO-DATA-NAME = VHCF01IW-SV3.GEO-DATA-NAME[U-CNT];
    VHCF01U_CRIT.MEASUREMENT = VHCF01IW-SV3.MEASUREMENT[U-CNT];
    VHCF01U_CRIT.STOCK-NO = VHCF01IW-SV3.STOCK-NO[U-CNT];
    VHCF01U_CRIT.CAR-NO = VHCF01IW-SV3.CAR-NO;
    VHCF01U_CRIT.EMPL-NO = VHCF01IW.EMPL-NO;
    VHCF01U_CRIT.CMPNT-EQUIP-TYPE = VHCF01IW-SV3.CMPNT-EQUIP-TYPE;
    VHCF01U_CRIT.TERM-LAST-UPD = VHCF01IW-PASSVALUE.TERM-LAST-UPD;
    try
        call "VHCF01U"(XDCONTROL, VHCF01U_CRIT, VHCF01U_DATA);
    
    end
end 

