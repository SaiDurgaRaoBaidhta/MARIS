                            INVALID-IND = "Y";
                        end
                    end
                end
            end
        end
    end
end 

Function VHCF01IS-V-FLANGE () 
    VHCF01IW-PASSVALUE.FLANGE-SAVE-REMAINDER = 0;
    VHCF01IW-PASSVALUE.FLANGE-SAVE = VHCF01IW-PASSVALUE.FLANGE-SAVE * 10;
    VHCF01IW-PASSVALUE.FLANGE-SAVE-REMAINDER = VHCF01IW-PASSVALUE.FLANGE-SAVE % 5;
    


  
    if (VHCF01IW-PASSVALUE.FLANGE-SAVE-REMAINDER == 0)
        return;
    else
        ERROR-CNT = ERROR-CNT + 1;
  
        VHCF01IW-MSG.FLANGE-MSG-01 = "Wheel ";
        VHCF01IW-MSG.FLANGE-MSG-03 = "-Flange should end with '.0' or '.5'";
        ER-DESC[ERROR-CNT] = VHCF01IW-MSG.FLANGE-MSG;
    end
end 

Function VHCF01IS-V-GEAR () 
    VHCF01IW-FLAG.INVALID-IND = "N";
    if (VHCF01IW-01.ACTION-DATA != "AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "AXLE1")
        VHCF01IW-FLAG.ADD-GEAR-01 = "N";
        VHCF01K_CRIT.PARENT-SERIAL-NO = VHCF01IW.AXLE-SERIAL-01;
        VHCF01K_CRIT.PARENT-STOCK-NO = VHCF01IW-SAVE.SV-AXLE-01-STOCK-NO;
        VHCF01K_CRIT.PARENT-EQUIP-TYPE = "AXLE";
        VHCF01K_CRIT.CMPNT-EQUIP-TYPE = "GEAR BOX";
        VHCF01IS-CK-GEAR();
        if (VHCF01K_DATA.SERIAL-FOUND == "Y")
            VHCF01IW.GEAR-SERIAL-01 = VHCF01K_DATA.CMPNT-SERIAL-NO;
        else
            if (VHCF01K_DATA.SERIAL-FOUND == "S")
                VHCF01IW.GEAR-SERIAL-01 = VHCF01K_DATA.CMPNT-SERIAL-NO;
                VHCF01IW-FLAG.CMPNT-STAT = "INCP";
                VHCF01Q_DATA.TEMP-POSN-CD = "1 ";
                VHCF01Q_DATA.MSG-ALL-A = "Gear box stock # is not valid for Car type of car entered.  ";
                VHCF01IS-EXP-GEAR();
            else
                VHCF01L_CRIT.AXLE-SERIAL-NO = VHCF01IW.AXLE-SERIAL-01;
                VHCF01L_CRIT.CMPNT-EQUIP-TYPE = "GEAR BOX";
                VHCF01IS-CK-GEAR2(); 
                if (VHCF01L_DATA.SERIAL-FOUND == "Y")
                    VHCF01IW.GEAR-SERIAL-01 = VHCF01L_DATA.CMPNT-SERIAL-NO;
                    VHCF01L_DATA.GEAR-STOCK-01 = VHCF01L_DATA.STOCK-NO;
