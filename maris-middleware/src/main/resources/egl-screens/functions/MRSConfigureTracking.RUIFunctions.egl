Function VHCF01IS-M-DATA () 
    if (VHCF01IW-01.ACTION-DATA == "NO ACTION SELECTED" ||
     VHCF01IW-01.ACTION-DATA == " " ||
     VHCF01IW-01.ACTION-DATA == "LIST DATA")
  
        VHCF01IS-EMP-NOX();
        if (VHCF01IW.EMPL-NOX != " ")
            VHCF01IW-MSG.FINAL-MESSAGE = " Employe ID and Shop Location represent final Survey";
        end
    else
        VHCF01IW.LOCX = " ";
        VHCF01IW.EMPL-NOX = " ";
    end
    VHCF01IW-CNT.X = 1;

  
  
  

  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
    VHCF01IW.DATE-CONFIG-UPD = VHCF01B_DATA.DATE-CONFIG-UPD[X];
    VHCF01IW.TIME-CONFIG-UPD = VHCF01B_DATA.TIME-CONFIG-UPD[X];
    VHCF01IW.DATE-CONFIG-UPDX = VHCF01B_DATA.DATE-CONFIG-UPD[X];
    VHCF01IW.TIME-CONFIG-UPDX = VHCF01B_DATA.TIME-CONFIG-UPD[X];
    VHCF01IW.TERM-CONFIG-UPD = VHCF01B_DATA.TERM-CONFIG-UPD[X];
    while (VHCF01IW-CNT.X <= VHCF01IW-CNT.NUM-OF-ROW)
        if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "TRUCK")
            if (VHCF01B_DATA.POSN-CD[X] == "X")
                VHCF01IW.X-TRUCK-SERIAL = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                VHCF01IW.X-TRUCK-STOCK = VHCF01B_DATA.STOCK-NO[X];
            else
                VHCF01IW.Y-TRUCK-SERIAL = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                VHCF01IW.Y-TRUCK-STOCK = VHCF01B_DATA.STOCK-NO[X];
            end
        else
            if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "AXLE")
                if (VHCF01B_DATA.POSN-CD[X] == "1 ")
                    VHCF01IW.AXLE-SERIAL-01 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                    VHCF01IW.AXLE-STOCK-01 = VHCF01B_DATA.STOCK-NO[X];
                    VHCF01IW-03.AXLE-PARENT-STOCK-01 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                    VHCF01IW-03.AXLE-PARENT-SERIAL-01 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
                    VHCF01IW-03.AXLE-PARENT-POSN-01 = VHCF01B_DATA.PARENT-POSN-CD[X];
                    VHCF01IW-03.AXLE-CMPNT-CUM-HR-01 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                else
                    if (VHCF01B_DATA.POSN-CD[X] == "2 ")
                        VHCF01IW.AXLE-SERIAL-02 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                        VHCF01IW.AXLE-STOCK-02 = VHCF01B_DATA.STOCK-NO[X];
                        VHCF01IW-03.AXLE-PARENT-STOCK-02 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                        VHCF01IW-03.AXLE-PARENT-SERIAL-02 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
                        VHCF01IW-03.AXLE-PARENT-POSN-02 = VHCF01B_DATA.PARENT-POSN-CD[X];
                        VHCF01IW-03.AXLE-CMPNT-CUM-HR-02 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                    else
                        if (VHCF01B_DATA.POSN-CD[X] == "3 ")
                            VHCF01IW.AXLE-SERIAL-03 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                            VHCF01IW.AXLE-STOCK-03 = VHCF01B_DATA.STOCK-NO[X];
                            VHCF01IW-03.AXLE-PARENT-STOCK-03 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                            VHCF01IW-03.AXLE-PARENT-SERIAL-03 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
                            VHCF01IW-03.AXLE-PARENT-POSN-03 = VHCF01B_DATA.PARENT-POSN-CD[X];
                            VHCF01IW-03.AXLE-CMPNT-CUM-HR-03 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                        else
                            VHCF01IW.AXLE-SERIAL-04 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                            VHCF01IW.AXLE-STOCK-04 = VHCF01B_DATA.STOCK-NO[X];
                            VHCF01IW-03.AXLE-PARENT-STOCK-04 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                            VHCF01IW-03.AXLE-PARENT-SERIAL-04 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
                            VHCF01IW-03.AXLE-PARENT-POSN-04 = VHCF01B_DATA.PARENT-POSN-CD[X];
                            VHCF01IW-03.AXLE-CMPNT-CUM-HR-04 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                        end
                    end
                end
            else
                if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "WHEEL")
                    VHCF01IS-WHEEL();
                else
                    if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "BRAKE DISC")
                        VHCF01IS-DISC();
                    else
                        if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "TRACTION MOTOR")
                            VHCF01IS-TM();
                        else
                            if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "GEAR BOX")
                                if (VHCF01B_DATA.POSN-CD[X] == "1 ")
                                    VHCF01IW.GEAR-SERIAL-01 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                    VHCF01IW.GEAR-STOCK-01 = VHCF01B_DATA.STOCK-NO[X];
                                else
                                    if (VHCF01B_DATA.POSN-CD[X] == "2 ")
                                        VHCF01IW.GEAR-SERIAL-02 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                        VHCF01IW.GEAR-STOCK-02 = VHCF01B_DATA.STOCK-NO[X];
                                    else
                                        if (VHCF01B_DATA.POSN-CD[X] == "3 ")
                                            VHCF01IW.GEAR-SERIAL-03 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                            VHCF01IW.GEAR-STOCK-03 = VHCF01B_DATA.STOCK-NO[X];
                                        else
                                            VHCF01IW.GEAR-SERIAL-04 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                            VHCF01IW.GEAR-STOCK-04 = VHCF01B_DATA.STOCK-NO[X];
                                        end
                                    end
                                end
                            else
                                if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "BEARING")
                                    if (VHCF01B_DATA.POSN-CD[X] == "1 ")
                                        VHCF01IW.BEAR-SERIAL-01 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                        VHCF01IW.BEAR-STOCK-01 = VHCF01B_DATA.STOCK-NO[X];
                                    else
                                        if (VHCF01B_DATA.POSN-CD[X] == "2 ")
                                            VHCF01IW.BEAR-SERIAL-02 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                            VHCF01IW.BEAR-STOCK-02 = VHCF01B_DATA.STOCK-NO[X];
                                        else
                                            if (VHCF01B_DATA.POSN-CD[X] == "3 ")
                                                VHCF01IW.BEAR-SERIAL-03 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                                VHCF01IW.BEAR-STOCK-03 = VHCF01B_DATA.STOCK-NO[X];
                                            else
                                                if (VHCF01B_DATA.POSN-CD[X] == "4 ")
                                                    VHCF01IW.BEAR-SERIAL-04 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                                    VHCF01IW.BEAR-STOCK-04 = VHCF01B_DATA.STOCK-NO[X];
                                                else
                                                    if (VHCF01B_DATA.POSN-CD[X] == "5 ")
                                                        VHCF01IW.BEAR-SERIAL-05 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                                        VHCF01IW.BEAR-STOCK-05 = VHCF01B_DATA.STOCK-NO[X];
                                                    else
                                                        if (VHCF01B_DATA.POSN-CD[X] == "6 ")
                                                            VHCF01IW.BEAR-SERIAL-06 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                                            VHCF01IW.BEAR-STOCK-06 = VHCF01B_DATA.STOCK-NO[X];
                                                        else
                                                            if (VHCF01B_DATA.POSN-CD[X] == "7 ")
