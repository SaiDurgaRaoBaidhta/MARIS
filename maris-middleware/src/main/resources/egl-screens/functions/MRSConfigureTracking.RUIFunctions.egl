Function VHCF01IS-SV-DA3_1 () 
    VHCF01IS-G-GEO();
    set VHCF01IW-MSG empty;
    VHCF01IW-SV3.SV3-CNT = 0;

  
  
  
  
  
  
  

  
  
  
  
   
  
  
    if (VHCF01IW.DISC-1-ANVIL != VHCF01IW-SV3.DISC-1-ANVIL)
        VHCF01IW-SV3.SV3-CNT = VHCF01IW-SV3.SV3-CNT + 1;
        VHCF01IW-SV3.CMPNT-EQUIP-TYPE = "BREAK DISC";
        VHCF01IW-SV3.GEO-DATA-NAME[SV3-CNT] = "BRK DISC ANVIL";
        VHCF01IW-SV3.MEASUREMENT[SV3-CNT] = VHCF01IW.DISC-1-ANVIL;
        VHCF01IW-SV3.POSN-CD[SV3-CNT] = "1 ";
        VHCF01IW-SV3.CMPNT-SERIAL-NO[SV3-CNT] = VHCF01IW.DISC-SERIAL-01;
        VHCF01IW-SV3.STOCK-NO[SV3-CNT] = VHCF01IW.DISC-STOCK-01;
        if (VHCF01IW.DISC-1-ANVIL < VHCF01P_DATA.ANVIL-VALID-FROM ||
         VHCF01IW.DISC-1-ANVIL > VHCF01P_DATA.ANVIL-VALID-TO)
            ERROR-CNT = ERROR-CNT + 1;
            ER-SER-NO[ERROR-CNT] = VHCF01IW.DISC-SERIAL-01;
            VHCF01IW-MSG.DISC-MSG-1 = "-DISC #1 anvil out of range: (";
            VHCF01IW-PASSVALUE.VALID-FROM-X = VHCF01P_DATA.ANVIL-VALID-FROM;
            VHCF01IW-PASSVALUE.VALID-TO-X = VHCF01P_DATA.ANVIL-VALID-TO;
            DISC-MSG-2 = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.DISC-MSG-2- = ".";
            DISC-MSG-2X = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.DISC-MSG-3 = " - ";
            VHCF01IW-MSG.DISC-MSG-4 = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.DISC-MSG-4- = ".";
            VHCF01IW-MSG.DISC-MSG-4X = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.DISC-MSG-5 = ") @";
            ER-DESC[ERROR-CNT] = VHCF01IW-MSG.DISC-MSG;
            
  
        end
    end
    if (VHCF01IW.DISC-1-PISTON != VHCF01IW-SV3.DISC-1-PISTON)
        VHCF01IW-SV3.SV3-CNT = VHCF01IW-SV3.SV3-CNT + 1;
        VHCF01IW-SV3.CMPNT-EQUIP-TYPE = "BREAK DISC";
        VHCF01IW-SV3.GEO-DATA-NAME[SV3-CNT] = "BRK DISC PISTON";
        VHCF01IW-SV3.MEASUREMENT[SV3-CNT] = VHCF01IW.DISC-1-PISTON;
        VHCF01IW-SV3.POSN-CD[SV3-CNT] = "1 ";
        VHCF01IW-SV3.CMPNT-SERIAL-NO[SV3-CNT] = VHCF01IW.DISC-SERIAL-01;
        VHCF01IW-SV3.STOCK-NO[SV3-CNT] = VHCF01IW.DISC-STOCK-01;
        if (VHCF01IW.DISC-1-PISTON < VHCF01P_DATA.PISTON-VALID-FROM ||
