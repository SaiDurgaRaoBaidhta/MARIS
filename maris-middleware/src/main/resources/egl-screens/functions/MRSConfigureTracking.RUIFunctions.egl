Function VHCF01IS-VALID () 
    VHCF01A_CRIT.CAR-NO = VHCF01IW-01.CAR-NO;
    try
        call "VHCF01A"(XDCONTROL, VHCF01A_CRIT, VHCF01A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF01IW-FLAG.CAR-IS-VALID = "Y";
        VHCF01IW-SAVE.CAR-TYPE = VHCF01A_DATA.CAR-TYPE;
        VHCF01IW-SAVE.HOME-YRD = VHCF01A_DATA.HOME-YRD;
        VHCF01IW-SAVE.CURR-SCHD-PM-NO = VHCF01A_DATA.CURR-SCHD-PM-NO;
        VHCF01IW-SAVE.AC-DC-CD = VHCF01A_DATA.AC-DC-CD;
        VHCF01IW-SAVE.CONFIG-CMPNT-STAT = VHCF01A_DATA.CONFIG-CMPNT-STAT;
    else
        if (XDCONTROL.URC == 100)
            VHCF01IW-FLAG.CAR-IS-VALID = "N";
            VHCF01IW-MSG.FINAL-MSG-1 = VHCF01A_CRIT.CAR-NO;
            VHCF01IW-MSG.FINAL-MSG-2 = " is not a valid Car No";
            VHCF01IW-MSG.FINAL-MESSAGE = VHCF01IW-MSG.FINAL-MSG-ALL;
            VHCF01IW-FLAG.CAR-SETFOCUS = "Y";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

Function VHCF01IS-VALID-0 () 
    if (VHCF01IW.X-TRUCK-SERIAL == "  ")
        ERROR-CNT = ERROR-CNT + 1;
        ERROR-MESSAGE-OCCR[ERROR-CNT] = "-X Truck serial is blank @ ";
    end
    if (VHCF01IW.Y-TRUCK-SERIAL == "  ")
        ERROR-CNT = ERROR-CNT + 1;
