Function VHCF01IS-BUILD-1 () 
    VHCF01F_CRIT_X.DATABASE-SW = "N";
    VHCF01F_CRIT_X.C1-IND2 = "Y";
    VHCF01F_CRIT_X.C2-IND2 = "Y";
    VHCF01F_CRIT_X.A2-IND2 = "Y";
    VHCF01F_CRIT_X.B2-IND2 = "Y";
    VHCF01F_CRIT_X.D1-IND2 = "Y";
    VHCF01F_CRIT_X.E1-IND2 = "Y";
    VHCF01F_CRIT_X.K1-IND2 = "Y";
    VHCF01F_CRIT_X.K2-IND2 = "Y";  
    VHCF01F_CRIT_X.L1-IND2 = "Y";
    VHCF01F_CRIT_X.M1-IND2 = "Y";  
       
    VHCF01F_CRIT_X.C1-IND1 = "N";
    VHCF01F_CRIT_X.C2-IND1 = "N";
    VHCF01F_CRIT_X.A2-IND1 = "N";
    VHCF01F_CRIT_X.B2-IND1 = "N";
    VHCF01F_CRIT_X.D1-IND1 = "N";
    VHCF01F_CRIT_X.E1-IND1 = "N";
    VHCF01F_CRIT_X.K1-IND1 = "N";
    VHCF01F_CRIT_X.K2-IND1 = "N";   
    VHCF01F_CRIT_X.L1-IND1 = "N";
    VHCF01F_CRIT_X.M1-IND1 = "N"; 
         
    if (VHCF01IW-SAVE.CAR-TYPE == "K1")
        VHCF01F_CRIT_X.K1-IND1 = "Y";
    else
	    if (VHCF01IW-SAVE.CAR-TYPE == "K2")
	        VHCF01F_CRIT_X.K2-IND1 = "Y";
		else 
		    if (VHCF01IW-SAVE.CAR-TYPE == "L1")
		        VHCF01F_CRIT_X.L1-IND1 = "Y";
		    else
			    if (VHCF01IW-SAVE.CAR-TYPE == "M1")
			        VHCF01F_CRIT_X.M1-IND1 = "Y";
			    end
		    end
		end
	end    
    if (VHCF01IW-SAVE.CAR-TYPE == "C1"  )
        VHCF01F_CRIT_X.C1-IND1 = "Y";
    else
        if (VHCF01IW-SAVE.CAR-TYPE == "C2"  )
            VHCF01F_CRIT_X.C2-IND1 = "Y";
        else
            if (VHCF01IW-SAVE.CAR-TYPE == "A2")
                VHCF01F_CRIT_X.A2-IND1 = "Y";
            else
                if (VHCF01IW-SAVE.CAR-TYPE == "B2")
                    VHCF01F_CRIT_X.B2-IND1 = "Y";
                else 
                    if (VHCF01IW-SAVE.CAR-TYPE == "D1")
                    	VHCF01F_CRIT_X.D1-IND1 = "Y";
                    else
                    	if (VHCF01IW-SAVE.CAR-TYPE == "E1")
                    		VHCF01F_CRIT_X.E1-IND1 = "Y";
                    	end
                    end
                end
            end
        end
    end

  
    VHCF01F_CRIT_X.HOME-YRD = VHCF01IW-SAVE.HOME-YRD;
    if (VHCF01IW.X-TRUCK-SERIAL != " ")
        VHCF01F_CRIT_X.TRUCK-POSN-CD = "X";
        VHCF01F_CRIT_X.AXLE-POSN-CD-FR = "1 ";
        VHCF01F_CRIT_X.AXLE-POSN-CD-TO = "2 ";
        VHCF01F_CRIT_X.TM-POSN-CD-FR = "1 ";
        VHCF01F_CRIT_X.TM-POSN-CD-TO = "2 ";
