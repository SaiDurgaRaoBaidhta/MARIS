            VHCF01IW-PASSVALUE.VALID-FROM-X = VHCF01P_DATA.DIAMETER-VALID-FROM;
            VHCF01IW-PASSVALUE.VALID-TO-X = VHCF01P_DATA.DIAMETER-VALID-TO;
            WHEELX-MSG-2 = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-2- = ".";
            WHEELX-MSG-2X = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-3 = " - ";
            VHCF01IW-MSG.WHEELX-MSG-4 = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-4- = ".";
            VHCF01IW-MSG.WHEELX-MSG-4X = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-5 = ") @";
            ER-DESC[ERROR-CNT] = VHCF01IW-MSG.WHEELX-MSG;
            
  
        end
        if (VHCF01IW.DIAMETER-8 < VHCF01P_DATA.DIAMETER-VALID-FROM ||
         VHCF01IW.DIAMETER-8 > VHCF01P_DATA.DIAMETER-VALID-TO)
            ERROR-CNT = ERROR-CNT + 1;
            ER-SER-NO[ERROR-CNT] = "WHEEL # 08";
            VHCF01IW-MSG.WHEELX-MSG-1 = "-Diameter out of range: (";
            VHCF01IW-PASSVALUE.VALID-FROM-X = VHCF01P_DATA.DIAMETER-VALID-FROM;
            VHCF01IW-PASSVALUE.VALID-TO-X = VHCF01P_DATA.DIAMETER-VALID-TO;
            WHEELX-MSG-2 = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-2- = ".";
            WHEELX-MSG-2X = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-3 = " - ";
            VHCF01IW-MSG.WHEELX-MSG-4 = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-4- = ".";
            VHCF01IW-MSG.WHEELX-MSG-4X = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-5 = ") @";
            ER-DESC[ERROR-CNT] = VHCF01IW-MSG.WHEELX-MSG;
            
  
        end


  
  
  
  
  
  

  
  
  
  
  
  
    end
    VHCF01D_CRIT.SERIAL-NO = VHCF01IW.AXLE-SERIAL-04;
    VHCF01D_CRIT.CMPNT-EQUIP-TYPE = "AXLE";
    VHCF01D_DATA.AXLE-SERIAL-NO = "  ";
    VHCF01D_CRIT.POSN-CD = "4";
    VHCF01IS-CK-SER();
    if (VHCF01IW-01.ACTION-DATA == "AXLE, MOTOR, DISC - SERIAL ON")
        VHCF01IS-CK-SEC();
    end
    if (VHCF01IW.CONTINUE-CAR-AXLE04 == "Y" &&
     VHCF01IW.AXLE-SERIAL-04 == VHCF01IW-SAVEX.AXLE-SERIAL-04)
        return;
    else
        VHCF01IW-SAVE.SV-AXLE-04-STOCK-NO = VHCF01D_DATA.STOCK-NO;
        VHCF01D_DATA.STOCK-NO = "  ";
        VHCF01IW-SAVE.DATE-BUILD-04 = VHCF01D_DATA.DATE-BUILD;
        if (SERIAL-LOCATED == "SRP")
            VHCF01IW-MSG.FINAL-MESSAGE = "AXLE#1 serial has been scrapped.  Please re-enter the Serial #.";
            INVALID-IND = "Y";
        else
            if (SERIAL-LOCATED == "CAR")
                VHCF01IW.SERIAL-LOCATED-AXLE04 = "CAR";
                VHCF01IW.CONTINUE-CAR-AXLE04 = "Y";
                VHCF01IW-FLAG.AXLE-04-IN-TABLE = "Y";
                SAVE-AXLE-SER-04 = VHCF01IW.AXLE-SERIAL-04;
                VHCF01IW-SAVEX.AXLE-SERIAL-04 = VHCF01IW.AXLE-SERIAL-04;
                VHCF01IW-MSG.MSG-01 = "SERIAL#:";
                VHCF01IW-MSG.SERIAL-NO = VHCF01IW.AXLE-SERIAL-04;
                VHCF01IW-MSG.MSG-02 = "-AXLE #4 is on anther car.  Do you want to continue (Press Update again to continue)";
                INVALID-IND = "Y";
                VHCF01F_CRIT_Y.EXCEP-CAR-NO-AXLE-4 = VHCF01D_DATA.CAR-NO;
                VHCF01T_CRIT_X.EXCEP-CAR-NO-AXLE-4 = VHCF01D_DATA.CAR-NO;
            else
                if (SERIAL-LOCATED == "DB")
                    if (VHCF01D_DATA.PARENT-SERIAL-NO == "  ")
                        VHCF01IW-FLAG.AXLE-04-IN-TABLE = "Y";
                    else
                        if (VHCF01D_DATA.PARENT-SERIAL-NO != VHCF01IW.Y-TRUCK-SERIAL ||
                         VHCF01D_DATA.PARENT-STOCK-NO != VHCF01IW-SAVE.SV-Y-STOCK-NO)
                            SV-AXLE-SER-04 = VHCF01IW.AXLE-SERIAL-04;
                            VHCF01IW-MSG.MSG-01 = "SERIAL#:";
                            VHCF01IW-MSG.SERIAL-NO = VHCF01IW.AXLE-SERIAL-04;
                            VHCF01IW-MSG.MSG-02 = "-AXLE #4 is on anther truck.  Do you want to continue (Press Update again to continue)";
                            INVALID-IND = "Y";
                        else
                            VHCF01IW-FLAG.AXLE-04-IN-TABLE = "Y";
                        end
                    end
                else
                    if (SERIAL-LOCATED == "NO")
                        if (VHCF01D_DATA.AXLE-SERIAL-NO == "   ")
                            VHCF01IW-FLAG.AXLE-04-MISSING-CON = "Y";
                            VHCF01IW-FLAG.CMPNT-STAT = "AXLE";
                            VHCF01Q_DATA.MSG-02A = "is missing it's configuration data. ";
                            VHCF01IS-EXP-AX04();
                        end
                    end
                end
            end
        end
    end
    if (VHCF01IW-01.ACTION-DATA == "AXLE, MOTOR, DISC - SERIAL ON")
        if (VHCF01IW-FLAG.AXLE-04-IN-TABLE != "Y")
            VHCF01IW-MSG.AXLE-MSG-1 = "Axle Serial number ";
            VHCF01IW-MSG.AXLE-MSG-2 = VHCF01IW.AXLE-SERIAL-04;
            VHCF01IW-MSG.AXLE-MSG-3 = "must already exist";
            VHCF01IW-MSG.FINAL-MESSAGE = VHCF01IW-MSG.AXLE-MSG;
            ERROR-CNT = 1;
            VHCF01IS-EXPX();
        end
    end
end 

Function VHCF01IS-V-BEAR () 
    VHCF01IW-FLAG.INVALID-IND = "N";
    if (VHCF01IW-01.ACTION-DATA != "AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "AXLE1")
        VHCF01IW-FLAG.ADD-BEAR-01 = "N";
        VHCF01IW-FLAG.ADD-BEAR-02 = "N";
        VHCF01N_CRIT.PARENT-SERIAL-NO = VHCF01IW.AXLE-SERIAL-01;
        VHCF01N_CRIT.PARENT-STOCK-NO = VHCF01IW-SAVE.SV-AXLE-01-STOCK-NO;
        VHCF01N_CRIT.PARENT-EQUIP-TYPE = "AXLE";
        VHCF01N_CRIT.CMPNT-EQUIP-TYPE = "BEARING";
        VHCF01N_CRIT.PARENT-POSN-CD = "1 ";
        VHCF01IS-CK-BEAR();
        if (VHCF01N_DATA.SERIAL-FOUND == "2")
            if (VHCF01N_DATA.POSN-CD[1] == "1 ")
                VHCF01IW.BEAR-SERIAL-01 = VHCF01N_DATA.CMPNT-SERIAL-NO[1];
                VHCF01IW.BEAR-SERIAL-02 = VHCF01N_DATA.CMPNT-SERIAL-NO[2];
            else
                VHCF01IW.BEAR-SERIAL-02 = VHCF01N_DATA.CMPNT-SERIAL-NO[1];
                VHCF01IW.BEAR-SERIAL-01 = VHCF01N_DATA.CMPNT-SERIAL-NO[2];
            end
        else
            if (VHCF01N_DATA.SERIAL-FOUND == "1")
                VHCF01IW-FLAG.CMPNT-STAT = "INCP";
                VHCF01Q_DATA.TEMP-POSN-CD = "1 ";
                VHCF01Q_DATA.MSG-01A = "AXLE SERIAL # ";
                VHCF01Q_DATA.MSG-SER-A = VHCF01IW.AXLE-SERIAL-01;
                VHCF01Q_DATA.MSG-02A = " only one bearing is found";
                VHCF01IS-EXP-BEAR();
                if (VHCF01N_DATA.POSN-CD[1] == "1 ")
                    VHCF01IW.BEAR-SERIAL-01 = VHCF01N_DATA.CMPNT-SERIAL-NO[1];
                else
                    VHCF01IW.BEAR-SERIAL-02 = VHCF01N_DATA.CMPNT-SERIAL-NO[1];
                end
            else
                VHCF01M_CRIT.AXLE-SERIAL-NO = VHCF01IW.AXLE-SERIAL-01;
                VHCF01M_CRIT.CMPNT-EQUIP-TYPE = "BEARING";
                VHCF01M_CRIT.PARENT-POSN-CD = "1 ";
                VHCF01IS-CK-BEAR2(); 
                if (VHCF01M_DATA.SERIAL-FOUND == "Y")
                    if (VHCF01M_DATA.POSN-CD[1] == "1 ")
                        VHCF01IW.BEAR-SERIAL-01 = VHCF01M_DATA.CMPNT-SERIAL-NO[1];
                        VHCF01M_DATA.BEAR-STOCK-01 = VHCF01M_DATA.STOCK-NO[1];
                        VHCF01M_DATA.DATE-REBUILT-BEAR-01 = VHCF01M_DATA.DATE-LAST-REBUILT[1];
                        VHCF01IW.BEAR-SERIAL-02 = VHCF01M_DATA.CMPNT-SERIAL-NO[2];
                        VHCF01M_DATA.BEAR-STOCK-02 = VHCF01M_DATA.STOCK-NO[2];
                        VHCF01M_DATA.DATE-REBUILT-BEAR-02 = VHCF01M_DATA.DATE-LAST-REBUILT[2];
                    else
                        VHCF01IW.BEAR-SERIAL-02 = VHCF01M_DATA.CMPNT-SERIAL-NO[1];
                        VHCF01M_DATA.BEAR-STOCK-02 = VHCF01M_DATA.STOCK-NO[1];
                        VHCF01M_DATA.DATE-REBUILT-BEAR-02 = VHCF01M_DATA.DATE-LAST-REBUILT[1];
                        VHCF01IW.BEAR-SERIAL-01 = VHCF01M_DATA.CMPNT-SERIAL-NO[2];
                        VHCF01M_DATA.BEAR-STOCK-01 = VHCF01M_DATA.STOCK-NO[2];
                        VHCF01M_DATA.DATE-REBUILT-BEAR-01 = VHCF01M_DATA.DATE-LAST-REBUILT[2];
                    end
                    VHCF01IW-FLAG.ADD-BEAR-01 = "Y";
                    VHCF01IW-FLAG.ADD-BEAR-02 = "Y";
                else
                    if (VHCF01M_DATA.SERIAL-FOUND == "A")
                        VHCF01IW-FLAG.ADD-BEAR-01 = "N";
                        VHCF01IW-FLAG.CMPNT-STAT = "INCP";
                        VHCF01Q_DATA.TEMP-POSN-CD = "1 ";
                        VHCF01Q_DATA.MSG-ALL-A = "Bearing is on other config Axle (Not entered Axle).  ";
                        VHCF01IS-EXP-BEAR();
                        VHCF01IW-FLAG.ADD-BEAR-01 = "N";
                        VHCF01IW-FLAG.ADD-BEAR-02 = "N";
                    else
                        VHCF01Q_DATA.TEMP-POSN-CD = "1 ";
                        VHCF01Q_DATA.MSG-01A = "AXLE SERIAL # ";
                        VHCF01Q_DATA.MSG-SER-A = VHCF01IW.AXLE-SERIAL-01;
                        VHCF01Q_DATA.MSG-02A = "-Bearing is not found";
                        VHCF01IS-EXP-BEAR(); 
