Function VHCF01IS-LIST () 
    set VHCF01IW empty;
    set VHCF01IW-MSG empty;
    set VHCF01IW-COLOR empty;
    set VHCF01IW-SV2 empty;
    if (VHCF01IW-PASSVALUE.WHICH-GUI == "VHMSRI")
        VHCF01IW-FLAG.HIDE-UPDATE = "Y";
    else
        VHCF01IW-FLAG.SHOW-UPDATE = "Y";
    end
    if (ACTION-IDX == 0)
        VHCF01IW-01.ACTION-IDX = 1;
        VHCF01IW-01.ACTION-DATA = "NO ACTION SELECTED";
    end
    VHCF05IW-PASSVALUE.CAR-NO = VHCF01IW-PASSVALUE.CAR-NO;
    VHCF01IS-VALID();
    if (CAR-IS-VALID == "Y")
        VHCF01IW-FLAG2.LIST-DISABLE = "Y";
        
  
        VHCF01IS-G-TRUCK(); 
        if (TRUCK-IS-FOUND == "N")
            if (VHCF01IW-FLAG.HIDE-UPDATE != "Y")
                VHCF01IW-FLAG.ENABLE-UPDATE = "Y";
            else
                VHCF01IW-FLAG.HIDE-UPDATE = "Y";
            end
            VHCF01IW-FLAG.TRUCK-SETFOCUS = "Y";
  
            VHCF01IW-MSG.FINAL-MESSAGE = "No data found for this Car; Please enter new data and press UPDATE Button to add";
            
  
  
  
  
  
  
        else
            if (VHCF01IW-01.ACTION-DATA == "NO ACTION SELECTED")
                VHCF01IW-FLAG.DISABLE-UPDATE = "Y";
            end
        end
    else
        VHCF01IW-FLAG.DISABLE-UPDATE = "Y";
        VHCF01IW-FLAG.DISABLE-UPDATE = "Y";
        VHCF01IW-FLAG.CAR-IS-VALID = "N";
        VHCF01IW-MSG.FINAL-MSG-1 = VHCF01A_CRIT.CAR-NO;
        VHCF01IW-MSG.FINAL-MSG-2 = " is not a valid Car No";
        VHCF01IW-MSG.FINAL-MESSAGE = VHCF01IW-MSG.FINAL-MSG-ALL;
        VHCF01IW-FLAG.CAR-SETFOCUS = "Y";
    end
    if (VHCF01IW-FLAG.TRUCK-IS-FOUND == "N" && VHCF01IW-01.ACTION-DATA == "NO ACTION SELECTED")
        VHCF01IS-SET-EDIT();
        VHCF01IW-FLAG2.TRUCK-X-SETFOCUS = "Y";
        VHCF01IW-FLAG.DISABLE-AXLE-01 = "Y";
        VHCF01IW-FLAG.DISABLE-AXLE-02 = "Y";
        VHCF01IW-FLAG.DISABLE-AXLE-03 = "Y";
        VHCF01IW-FLAG.DISABLE-AXLE-04 = "Y";
        VHCF01IW-FLAG.DISABLE-DISC-01 = "Y";
        VHCF01IW-FLAG.DISABLE-DISC-02 = "Y";
        VHCF01IW-FLAG.DISABLE-DISC-03 = "Y";
        VHCF01IW-FLAG.DISABLE-DISC-04 = "Y";
        VHCF01IW-FLAG.DISABLE-TM-01 = "Y";
        VHCF01IW-FLAG.DISABLE-TM-02 = "Y";
        VHCF01IW-FLAG.DISABLE-TM-03 = "Y";
        VHCF01IW-FLAG.DISABLE-TM-04 = "Y";
        VHCF01IW-FLAG.DISABLE-TRUCK-X = "Y";
        VHCF01IW-FLAG.DISABLE-TRUCK-Y = "Y";
        VHCF01IW-FLAG.Y-IS-SELECT = "Y";
        VHCF01IW-FLAG.X-IS-SELECT = "Y";
    else
        VHCF01IS-INIT2();
    end
end 

