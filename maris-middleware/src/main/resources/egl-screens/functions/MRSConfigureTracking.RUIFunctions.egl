Function VHCF01IS-V2-AXLE () 
    if (VHCF01IW-01.ACTION-DATA != "TRUCK,AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "AXLE1")
        if (VHCF01IW.AXLE-SERIAL-01 == VHCF01IW-SAVE.SAVE-AXLE-SER-01 && VHCF01IW-SAVE.SAVE-AXLE-SER-01 != "A-EXCEPT")
