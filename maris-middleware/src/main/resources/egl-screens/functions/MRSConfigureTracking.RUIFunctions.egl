Function VHCF06IS-GEAR-ON () 
    if (VHCF06IW.GEAR-BOX-SERIAL-NO != " ")
        VHCF06IW-TRIGGER.GEAR-ON-DISABLE = "Y";
        VHCF06IW-TRIGGER.GEAR-OFF-ENABLE = "Y";
    else
        VHCF06IW-TRIGGER.GEAR-ON-ENABLE = "Y";
        VHCF06IW-TRIGGER.GEAR-OFF-DISABLE = "Y";
    end
end 

Function VHCF06IS-GEO-DATA () 
    set VHCF06K_CRIT empty;
    set VHCF06K_DATA empty;
    VHCF06K_CRIT.STOCK-NO = VHCF06IW.WHEEL-01-STOCK-NO;
    VHCF06K_CRIT.CMPNT-SERIAL-NO = VHCF06IW.WHEEL-01-SERIAL-NO;
    try
        call "VHCF06K"(XDCONTROL, VHCF06K_CRIT, VHCF06K_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

  
        VHCF06IW.FLANGE-01-MEASUREMENT = VHCF06K_DATA.MEASUREMENT-FLANGE;
        VHCF06IW.DIAMETER-01-MEASUREMENT = VHCF06K_DATA.MEASUREMENT-DIAMETER;
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

Function VHCF06IS-GEO-DATX () 
    set VHCF06K_CRIT empty;
    set VHCF06K_DATA empty;
    VHCF06K_CRIT.STOCK-NO = VHCF06IW.WHEEL-02-STOCK-NO;
    VHCF06K_CRIT.CMPNT-SERIAL-NO = VHCF06IW.WHEEL-02-SERIAL-NO;
    try
        call "VHCF06K"(XDCONTROL, VHCF06K_CRIT, VHCF06K_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

  
        VHCF06IW.FLANGE-02-MEASUREMENT = VHCF06K_DATA.MEASUREMENT-FLANGE;
        VHCF06IW.DIAMETER-02-MEASUREMENT = VHCF06K_DATA.MEASUREMENT-DIAMETER;
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

Function VHCF06IS-ITEMCOUNT ()
   
    set VHCF06M_DATA empty;
    set VHCF06M_CRIT empty;
    VHCF06M_DATA.CMPNT-EQUIP-TYPE = "AXLE";
     
    VHCF06M_DATA.CMPNT-SERIAL-NO = VHCF06IW.AXLE-SERIAL-NO;
    VHCF06M_DATA.STOCK-NO = VHCF06IW.AXLE-STOCK-NO;
    
  
  
    VHCF06M_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
    VHCF06M_DATA.HIST-ACTION-CD = "AXL";
    VHCF06M_DATA.CAR-NO = VHCF06IW.CAR-NO;
    
  
    try
        call "VHCF06M"(XDCONTROL, VHCF06M_CRIT, VHCF06M_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "COMPONENT(S)  ARE UPDATED";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
  
  
    if (VHCF06I_CRIT.DATABASE-SW == "Y")
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "Database error, no Componet are changed";
    end
end 

Function VHCF06IS-LIST () 
    set VHCF06IW-MESSAGE empty;
    VHCF06IW.SELECTION-ERROR = " ";
    if (VHCF06IW.AXLE-SELECTION == 1 && VHCF06IW.AXLE-SERIAL-NO == " ")
        VHCF06IW.SELECTION-ERROR = "Y";
        VHCF06IW-TRIGGER.AXLE-SERIAL-CURSOR = "Y";
        VHCF06IW-TRIGGER.SELECT-CRIT-ENABLE = "Y";
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "Please enter Axle Serial No. in the selection box";
    end
    if (VHCF06IW.AXLE-SELECTION == 2 && VHCF06IW.GEAR-SERIAL-NO == " ")
        VHCF06IW.SELECTION-ERROR = "Y";
        VHCF06IW-TRIGGER.GEAR-SERIAL-CURSOR = "Y";
        VHCF06IW-TRIGGER.SELECT-CRIT-ENABLE = "Y";
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "Please enter Gear Serial No. in the selection box";
    end
    if (VHCF06IW.SELECTION-ERROR == " ")
        VHCF06IW-TRIGGER.SELECT-CRIT-DISABLE = "Y";
        VHCF06IS-LISTX();
    end
end 

Function VHCF06IS-LISTX () 
    set VHCF06A_DATA empty;
    VHCF06A_CRIT.AXLE-SERIAL-NO = VHCF06IW.AXLE-SERIAL-NO;
    VHCF06A_CRIT.GEAR-SERIAL-NO = VHCF06IW.GEAR-SERIAL-NO;
    try
        call "VHCF06A"(XDCONTROL, VHCF06A_CRIT, VHCF06A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
        VHCF06IS-VALIDATE();
    else
  
  
  
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
  

  
    VHCF06IS-BUTTONS();
end 

Function VHCF06IS-M-DATA () 
    VHCF06IW.DATE-REMOVED = VHCF06A_DATA.DATE-LAST-REMOVED[1];
    VHCF06IW.CAR-NO = VHCF06A_DATA.CAR-NO[1];
    VHCF06IW-PASSVALUE.CAR-NO-PREV = VHCF06A_DATA.CAR-NO-PREV[1];
    VHCF06IW.HOME-YRD = VHCF06A_DATA.HOME-YRD[1];
    VHCF06IW-PASSVALUE.JOB-NO = VHCF06A_DATA.JOB-NO[1];
    VHCF06IW-PASSVALUE.SSRNO-FILLER = "-";
    VHCF06IW-PASSVALUE.SUB-JOB-DOC-NO = VHCF06A_DATA.SUB-JOB-DOC-NO[1];
    VHCF06IW.SSR = VHCF06IW-PASSVALUE.SSRNO;
    VHCF06IW.AXLE-SERIAL-STAT = VHCF06A_DATA.SERIAL-STAT[1];
    VHCF06IW-PASSVALUE.COUNTER = 1;
    while (VHCF06IW-PASSVALUE.COUNTER <= VHCF06A_CRIT.LIST-COUNTER)
        if (VHCF06A_DATA.CMPNT-EQUIP-TYPE[COUNTER] == "AXLE")
            VHCF06IW.AXLE-REBUILT-DATE = VHCF06A_DATA.DATE-BUY-REBUILT[COUNTER];
            VHCF06IW.AXLE-HUB-COUP-REPL-DATE = VHCF06A_DATA.DATE-HUB-COUP-REPL[COUNTER];
            VHCF06IW.AXLE-DATE-LAST-UPD = VHCF06A_DATA.DATE-LAST-UPD[COUNTER];
            VHCF06IW.AXLE-TIME-LAST-UPD = VHCF06A_DATA.TIME-LAST-UPD[COUNTER];
            VHCF06IW.AXLE-TERM-LAST-UPD = VHCF06A_DATA.TERM-LAST-UPD[COUNTER];
            VHCF06IW.AXLE-STOCK-NO = VHCF06A_DATA.STOCK-NOX[COUNTER];
            VHCF06IW.AXLE-POSN-CD = VHCF06A_DATA.POSN-CD[COUNTER];
        else
            if (VHCF06A_DATA.CMPNT-EQUIP-TYPE[COUNTER] == "GEAR BOX")
                VHCF06IW.GEAR-BOX-SERIAL-NO = VHCF06A_DATA.CMPNT-SERIAL-NO[COUNTER];
                VHCF06IW.GEAR-DATE-REBUILT = VHCF06A_DATA.DATE-BUY-REBUILT[COUNTER];
                VHCF06IW.GEAR-DATE-LAST-UPD = VHCF06A_DATA.DATE-LAST-UPD[COUNTER];
                VHCF06IW.GEAR-TIME-LAST-UPD = VHCF06A_DATA.TIME-LAST-UPD[COUNTER];
                VHCF06IW.GEAR-TERM-LAST-UPD = VHCF06A_DATA.TERM-LAST-UPD[COUNTER];
                VHCF06IW.GEAR-BOX-STOCK-NO = VHCF06A_DATA.STOCK-NOX[COUNTER];
                VHCF06IW-PASSVALUE.PARENT-STOCK-NO = VHCF06A_DATA.PARENT-STOCK-NO[COUNTER];
                VHCF06IW-PASSVALUE.PARENT-SERIAL-NO = VHCF06A_DATA.PARENT-SERIAL-NO[COUNTER];
                VHCF06IW-PASSVALUE.PARENT-POSN-CD-GEAR = VHCF06A_DATA.PARENT-POSN-CD[COUNTER];
                VHCF06IW.GEAR-POSN-CD = VHCF06A_DATA.POSN-CD[COUNTER];
            else
                if (VHCF06A_DATA.CMPNT-EQUIP-TYPE[COUNTER] == "BEARING")
                    if (VHCF06A_DATA.POSN-CD[COUNTER] == "B")
                        VHCF06IW.B-SERIAL-NO = VHCF06A_DATA.CMPNT-SERIAL-NO[COUNTER];
                        VHCF06IW.BEAR-B-DATE-LAST-UPD = VHCF06A_DATA.DATE-LAST-UPD[COUNTER];
                        VHCF06IW.BEAR-B-TIME-LAST-UPD = VHCF06A_DATA.TIME-LAST-UPD[COUNTER];
                        VHCF06IW.BEAR-B-TERM-LAST-UPD = VHCF06A_DATA.TERM-LAST-UPD[COUNTER];
                        VHCF06IW.BEAR-B-DATE-REBUILT = VHCF06A_DATA.DATE-BUY-REBUILT[COUNTER];
                        VHCF06IW.B-STOCK-NO = VHCF06A_DATA.STOCK-NOX[COUNTER];
                        VHCF06IW-PASSVALUE.PARENT-STOCK-NO = VHCF06A_DATA.PARENT-STOCK-NO[COUNTER];
                        VHCF06IW-PASSVALUE.PARENT-SERIAL-NO = VHCF06A_DATA.PARENT-SERIAL-NO[COUNTER];
                        VHCF06IW-PASSVALUE.PARENT-POSN-CD-BEAR-B = VHCF06A_DATA.PARENT-POSN-CD[COUNTER];
                        VHCF06IW.B-POSN-CD = VHCF06A_DATA.POSN-CD[COUNTER];
                    else
                        if (VHCF06A_DATA.POSN-CD[COUNTER] == "N")
                            VHCF06IW.N-SERIAL-NO = VHCF06A_DATA.CMPNT-SERIAL-NO[COUNTER];
                            VHCF06IW.BEAR-N-DATE-LAST-UPD = VHCF06A_DATA.DATE-LAST-UPD[COUNTER];
                            VHCF06IW.BEAR-N-TIME-LAST-UPD = VHCF06A_DATA.TIME-LAST-UPD[COUNTER];
                            VHCF06IW.BEAR-N-TERM-LAST-UPD = VHCF06A_DATA.TERM-LAST-UPD[COUNTER];
                            VHCF06IW.BEAR-N-DATE-REBUILT = VHCF06A_DATA.DATE-BUY-REBUILT[COUNTER];
                            VHCF06IW.N-STOCK-NO = VHCF06A_DATA.STOCK-NOX[COUNTER];
                            VHCF06IW-PASSVALUE.PARENT-STOCK-NO = VHCF06A_DATA.PARENT-STOCK-NO[COUNTER];
                            VHCF06IW-PASSVALUE.PARENT-SERIAL-NO = VHCF06A_DATA.PARENT-SERIAL-NO[COUNTER];
                            VHCF06IW-PASSVALUE.PARENT-POSN-CD-BEAR-N = VHCF06A_DATA.PARENT-POSN-CD[COUNTER];
                            VHCF06IW.N-POSN-CD = VHCF06A_DATA.POSN-CD[COUNTER];
                        end
                    end
                else
                    if (VHCF06A_DATA.CMPNT-EQUIP-TYPE[COUNTER] == "WHEEL")
                        if (VHCF06A_DATA.POSN-CD[COUNTER] == "B")
                            VHCF06IW.WHEEL-01-SERIAL-NO = VHCF06A_DATA.CMPNT-SERIAL-NO[COUNTER];
                            VHCF06IW.WHEEL-01-DATE-LAST-UPD = VHCF06A_DATA.DATE-LAST-UPD[COUNTER];
                            VHCF06IW.WHEEL-01-TIME-LAST-UPD = VHCF06A_DATA.TIME-LAST-UPD[COUNTER];
                            VHCF06IW.WHEEL-01-TERM-LAST-UPD = VHCF06A_DATA.TERM-LAST-UPD[COUNTER];
                            VHCF06K_CRIT.CMPNT-SERIAL-NO = VHCF06IW.WHEEL-01-SERIAL-NO;
                            VHCF06K_CRIT.STOCK-NO = VHCF06A_DATA.STOCK-NOX[COUNTER];
                            VHCF06IW.WHEEL-01-STOCK-NO = VHCF06A_DATA.STOCK-NOX[COUNTER];
                            VHCF06IW-PASSVALUE.PARENT-STOCK-NO = VHCF06A_DATA.PARENT-STOCK-NO[COUNTER];
                            VHCF06IW-PASSVALUE.PARENT-SERIAL-NO = VHCF06A_DATA.PARENT-SERIAL-NO[COUNTER];
                            VHCF06IW-PASSVALUE.PARENT-POSN-CD-WHEEL-01 = VHCF06A_DATA.PARENT-POSN-CD[COUNTER];
                            VHCF06IW.WHEEL-01-POSN-CD = VHCF06A_DATA.POSN-CD[COUNTER];
                            VHCF06IS-GEO-DATA();
                        else
                            if (VHCF06A_DATA.POSN-CD[COUNTER] == "N")
                                VHCF06IW.WHEEL-02-SERIAL-NO = VHCF06A_DATA.CMPNT-SERIAL-NO[COUNTER];
                                VHCF06IW.WHEEL-02-DATE-LAST-UPD = VHCF06A_DATA.DATE-LAST-UPD[COUNTER];
                                VHCF06IW.WHEEL-02-TIME-LAST-UPD = VHCF06A_DATA.TIME-LAST-UPD[COUNTER];
                                VHCF06IW.WHEEL-02-TERM-LAST-UPD = VHCF06A_DATA.TERM-LAST-UPD[COUNTER];
                                VHCF06K_CRIT.CMPNT-SERIAL-NO = VHCF06IW.WHEEL-02-SERIAL-NO;
                                VHCF06K_CRIT.STOCK-NO = VHCF06A_DATA.STOCK-NOX[COUNTER];
                                VHCF06IW.WHEEL-02-STOCK-NO = VHCF06A_DATA.STOCK-NOX[COUNTER];
                                VHCF06IW-PASSVALUE.PARENT-STOCK-NO = VHCF06A_DATA.PARENT-STOCK-NO[COUNTER];
                                VHCF06IW-PASSVALUE.PARENT-SERIAL-NO = VHCF06A_DATA.PARENT-SERIAL-NO[COUNTER];
                                VHCF06IW-PASSVALUE.PARENT-POSN-CD-WHEEL-02 = VHCF06A_DATA.PARENT-POSN-CD[COUNTER];
                                VHCF06IW.WHEEL-02-POSN-CD = VHCF06A_DATA.POSN-CD[COUNTER];
                                VHCF06IS-GEO-DATX();
                            end
                        end
                    end
                end
            end
        end
        VHCF06IW-PASSVALUE.COUNTER = VHCF06IW-PASSVALUE.COUNTER + 1;
    end
    VHCF06IS-DATA-SAVE();
end 

Function VHCF06IS-M-GEO () 
    VHCF06IW-PASSVALUE.GEO-COUNT = 1;
    while (VHCF06IW-PASSVALUE.GEO-COUNT <= VHCF06B_CRIT.GEO-COUNTER)
        if (VHCF06B_DATA.GEO-DATA-NAME[GEO-COUNT] == "WHEEL FLNG FNGR")
  
            VHCF06IW.FLANGE-01-MEASUREMENT = VHCF06B_DATA.MEASUREMENT[GEO-COUNT];
        end
        if (VHCF06B_DATA.GEO-DATA-NAME[GEO-COUNT] == "WHEEL DIAMETER")
  
            VHCF06IW.DIAMETER-01-MEASUREMENT = VHCF06B_DATA.MEASUREMENT[GEO-COUNT];
        end
        GEO-COUNT = GEO-COUNT + 1;
    end
end 

Function VHCF06IS-M-GEO-N () 
    VHCF06IW-PASSVALUE.GEO-COUNT = 1;
    while (VHCF06IW-PASSVALUE.GEO-COUNT <= VHCF06B_CRIT.GEO-COUNTER)
        if (VHCF06B_DATA.GEO-DATA-NAME[GEO-COUNT] == "WHEEL FLNG FNGR")
            VHCF06IW.FLANGE-02-MEASUREMENT = VHCF06B_DATA.MEASUREMENT[GEO-COUNT];
        end
        if (VHCF06B_DATA.GEO-DATA-NAME[GEO-COUNT] == "WHEEL DIAMETER")
            VHCF06IW.DIAMETER-02-MEASUREMENT = VHCF06B_DATA.MEASUREMENT[GEO-COUNT];
        end
        GEO-COUNT = GEO-COUNT + 1;
    end
end 

Function VHCF06IS-MOD-AXLE () 
    VHCF06I-VHCF28I.STOCK-NO = VHCF06IW.AXLE-STOCK-NO;
    VHCF06I-VHCF28I.CMPNT-EQUIP-TYPE = "AXLE";
    VHCF06I-VHCF28I.CMPNT-SERIAL-NO = VHCF06IW.AXLE-SERIAL-NO;
    VHCF06I-VHCF28I.TERM-ID = VH01A01_DATA.TERM-ID;
end 

Function VHCF06IS-MOD-B () 
    VHCF06I-VHCF28I.STOCK-NO = VHCF06IW.B-STOCK-NO;
    VHCF06I-VHCF28I.CMPNT-EQUIP-TYPE = "B BEARING";
    VHCF06I-VHCF28I.CMPNT-SERIAL-NO = VHCF06IW.B-SERIAL-NO;
    VHCF06I-VHCF28I.TERM-ID = VH01A01_DATA.TERM-ID;
end 

Function VHCF06IS-MOD-GEAR () 
    VHCF06I-VHCF28I.STOCK-NO = VHCF06IW.GEAR-BOX-STOCK-NO;
    VHCF06I-VHCF28I.CMPNT-EQUIP-TYPE = "GEAR BOX";
    VHCF06I-VHCF28I.CMPNT-SERIAL-NO = VHCF06IW.GEAR-BOX-SERIAL-NO;
    VHCF06I-VHCF28I.TERM-ID = VH01A01_DATA.TERM-ID;
end 

Function VHCF06IS-MOD-N () 
    VHCF06I-VHCF28I.STOCK-NO = VHCF06IW.N-STOCK-NO;
    VHCF06I-VHCF28I.CMPNT-EQUIP-TYPE = "N BEARING";
    VHCF06I-VHCF28I.CMPNT-SERIAL-NO = VHCF06IW.N-SERIAL-NO;
    VHCF06I-VHCF28I.TERM-ID = VH01A01_DATA.TERM-ID;
end 

Function VHCF06IS-N-ON () 
    if (VHCF06IW.N-SERIAL-NO != " ")
        VHCF06IW-TRIGGER.N-ON-DISABLE = "Y";
        VHCF06IW-TRIGGER.N-OFF-ENABLE = "Y";
    else
        VHCF06IW-TRIGGER.N-ON-ENABLE = "Y";
        VHCF06IW-TRIGGER.N-OFF-DISABLE = "Y";
    end
end 

Function VHCF06IS-OFF () 
    VHCF06IW-PASSVALUE.OFF-CNT = 1;
    VHCF06IW-PASSVALUE.GEAR-DONE = " ";
    VHCF06IW-PASSVALUE.B-DONE = " ";
    VHCF06IW-PASSVALUE.N-DONE = " ";
    VHCF06IW-PASSVALUE.WHEEL-01-DONE = " ";
    VHCF06IW-PASSVALUE.WHEEL-02-DONE = " ";
    VHCF06IW-PASSVALUE.FINAL-COUNTER = 0;
    while (VHCF06IW-PASSVALUE.OFF-CNT < 6)
        if (VHCF06IW.GEAR-CHECK-OFF == "1" && VHCF06IW-PASSVALUE.GEAR-DONE == " ")
            VHCF06IW-PASSVALUE.GEAR-DONE = "1";
            VHCF06F_DATA.CMPNT-EQUIP-TYPE[OFF-CNT] = "GEAR BOX";
            VHCF06F_DATA.CMPNT-SERIAL-NO[OFF-CNT] = VHCF06IW.GEAR-BOX-SERIAL-NO;
            VHCF06F_DATA.STOCK-NO[OFF-CNT] = VHCF06IW.GEAR-BOX-STOCK-NO;
            VHCF06F_DATA.PARENT-STOCK-NO[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
            VHCF06F_DATA.PARENT-SERIAL-NO[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
            VHCF06F_DATA.PARENT-POSN-CD[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-POSN-CD-GEAR;
            VHCF06F_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
            XXDATEW.VAGen_FUNCTION = "YMD";
            XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.GEAR-DATE-REBUILT;
            MRSCommonCode.XXDATES-CONVERT();
            VHCF06F_DATA.DATE-BUY-REBUILT[OFF-CNT] = XXDATEW.DATE-YYYY-MM-DD;
            VHCF06A_DATA.POSN-CD[OFF-CNT] = VHCF06IW.GEAR-POSN-CD;
            VHCF06IW-PASSVALUE.FINAL-COUNTER = OFF-CNT;
        else
            if (VHCF06IW.B-CHECK-OFF == "1" && VHCF06IW-PASSVALUE.B-DONE == " ")
                VHCF06IW-PASSVALUE.B-DONE = "1";
                VHCF06F_DATA.CMPNT-EQUIP-TYPE[OFF-CNT] = "BEARING";
                VHCF06F_DATA.CMPNT-SERIAL-NO[OFF-CNT] = VHCF06IW.B-SERIAL-NO;
                VHCF06F_DATA.STOCK-NO[OFF-CNT] = VHCF06IW.B-STOCK-NO;
                VHCF06F_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                VHCF06F_DATA.PARENT-STOCK-NO[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
                VHCF06F_DATA.PARENT-SERIAL-NO[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
                VHCF06F_DATA.PARENT-POSN-CD[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-POSN-CD-BEAR-B;
                XXDATEW.VAGen_FUNCTION = "YMD";
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.BEAR-B-DATE-REBUILT;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06F_DATA.DATE-BUY-REBUILT[OFF-CNT] = XXDATEW.DATE-YYYY-MM-DD;
                VHCF06A_DATA.POSN-CD[OFF-CNT] = VHCF06IW.B-POSN-CD;
                VHCF06F_DATA.POSN-CD[OFF-CNT] = "B";
                VHCF06IW-PASSVALUE.FINAL-COUNTER = OFF-CNT;
            else
                if (VHCF06IW.N-CHECK-OFF == "1" && VHCF06IW-PASSVALUE.N-DONE == " ")
                    VHCF06IW-PASSVALUE.N-DONE = "1";
                    VHCF06F_DATA.CMPNT-EQUIP-TYPE[OFF-CNT] = "BEARING";
                    VHCF06F_DATA.CMPNT-SERIAL-NO[OFF-CNT] = VHCF06IW.N-SERIAL-NO;
                    VHCF06F_DATA.STOCK-NO[OFF-CNT] = VHCF06IW.N-STOCK-NO;
                    VHCF06F_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                    VHCF06F_DATA.PARENT-STOCK-NO[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
                    VHCF06F_DATA.PARENT-SERIAL-NO[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
                    VHCF06F_DATA.PARENT-POSN-CD[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-POSN-CD-BEAR-N;
                    XXDATEW.VAGen_FUNCTION = "YMD";
                    XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.BEAR-N-DATE-REBUILT;
                    MRSCommonCode.XXDATES-CONVERT();
                    VHCF06F_DATA.DATE-BUY-REBUILT[OFF-CNT] = XXDATEW.DATE-YYYY-MM-DD;
                    VHCF06A_DATA.POSN-CD[OFF-CNT] = VHCF06IW.N-POSN-CD;
                    VHCF06F_DATA.POSN-CD[OFF-CNT] = "N";
                    VHCF06IW-PASSVALUE.FINAL-COUNTER = OFF-CNT;
                else
                    if (VHCF06IW.WHEEL-01-CHECK-OFF == "1" && VHCF06IW-PASSVALUE.WHEEL-01-DONE == " ")
                        VHCF06IW-PASSVALUE.WHEEL-01-DONE = "1";
                        VHCF06F_DATA.CMPNT-EQUIP-TYPE[OFF-CNT] = "WHEEL";
                        VHCF06F_DATA.CMPNT-SERIAL-NO[OFF-CNT] = VHCF06IW.WHEEL-01-SERIAL-NO;
                        VHCF06F_DATA.STOCK-NO[OFF-CNT] = VHCF06IW.WHEEL-01-STOCK-NO;
                        VHCF06F_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                        VHCF06F_DATA.PARENT-STOCK-NO[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
                        VHCF06F_DATA.PARENT-SERIAL-NO[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
                        VHCF06F_DATA.PARENT-POSN-CD[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-POSN-CD-WHEEL-01;
                        VHCF06A_DATA.POSN-CD[OFF-CNT] = VHCF06IW.WHEEL-01-POSN-CD;
                        VHCF06IW-PASSVALUE.FINAL-COUNTER = OFF-CNT;
                    else
  
                        if (VHCF06IW.WHEEL-02-CHECK-OFF == "1" && VHCF06IW-PASSVALUE.WHEEL-02-DONE == " ")
                            VHCF06IW-PASSVALUE.WHEEL-02-DONE = "1";
                            VHCF06F_DATA.CMPNT-EQUIP-TYPE[OFF-CNT] = "WHEEL";
                            VHCF06F_DATA.CMPNT-SERIAL-NO[OFF-CNT] = VHCF06IW.WHEEL-02-SERIAL-NO;
                            VHCF06F_DATA.STOCK-NO[OFF-CNT] = VHCF06IW.WHEEL-02-STOCK-NO;
                            VHCF06F_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                            VHCF06F_DATA.PARENT-STOCK-NO[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
                            VHCF06F_DATA.PARENT-SERIAL-NO[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
                            VHCF06F_DATA.PARENT-POSN-CD[OFF-CNT] = VHCF06IW-PASSVALUE.PARENT-POSN-CD-WHEEL-02;
                            VHCF06A_DATA.POSN-CD[OFF-CNT] = VHCF06IW.WHEEL-02-POSN-CD;
                            VHCF06IW-PASSVALUE.FINAL-COUNTER = OFF-CNT;
                        end
                    end
                end
            end
        end
        OFF-CNT = OFF-CNT + 1;
    end

  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
    VHCF06F_DATA.S-REC-CNT = VHCF06IW-PASSVALUE.FINAL-COUNTER;
    VHCF06F_CRIT.JOB-NO = VHCF06IW-PASSVALUE.JOB-NO;
    VHCF06F_CRIT.SUB-JOB-DOC-NO = VHCF06IW-PASSVALUE.SUB-JOB-DOC-NO;
    VHCF06F_CRIT.CAR-NO = VHCF06IW.CAR-NO;
    VHCF06F_CRIT.HOME-YRD = VHCF06IW.HOME-YRD;
    if (VHCF06IW-PASSVALUE.FINAL-COUNTER > 0)
        try
            call "VHCF06F"(XDCONTROL, VHCF06F_CRIT, VHCF06F_DATA, VHCF06F_DATA_1);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
  
  
            VHCF06IW-MESSAGE.FINAL-MESSAGE = "COMPONENT(S) SELECTED ARE REMOVED";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
  
  
    end
    if (VHCF06F_CRIT.DATABASE-SW == "Y")
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "Database error, no Componet are removed";
    end
end 

Function VHCF06IS-ON () 
    VHCF06IW-PASSVALUE.ON-CNT = 1;
    VHCF06IW-PASSVALUE.GEAR-DONE = " ";
    VHCF06IW-PASSVALUE.B-DONE = " ";
    VHCF06IW-PASSVALUE.N-DONE = " ";
    VHCF06IW-PASSVALUE.WHEEL-01-DONE = " ";
    VHCF06IW-PASSVALUE.WHEEL-02-DONE = " ";
    VHCF06IW-PASSVALUE.FINAL-COUNTER = 0;
    VHCF06H_CRIT.AXLE-SERIAL-NO = VHCF06IW.AXLE-SERIAL-NO;
    VHCF06IW-PASSVALUE.AXLE-REBUILT-DATE = VHCF06IW.AXLE-REBUILT-DATE;
    VHCF06IW-PASSVALUE.PARENT-SERIAL-NO = VHCF06IW.AXLE-SERIAL-NO;
    VHCF06IW-PASSVALUE.PARENT-STOCK-NO = VHCF06IW.AXLE-STOCK-NO;
    while (VHCF06IW-PASSVALUE.ON-CNT < 6)
        if (VHCF06IW.GEAR-CHECK-ON == "1" && VHCF06IW-PASSVALUE.GEAR-DONE == " ")
            VHCF06IW-PASSVALUE.GEAR-DONE = "1";
            VHCF06H_DATA.CMPNT-EQUIP-TYPE[VHCF06IW-PASSVALUE.ON-CNT] = "GEAR BOX";
            VHCF06H_DATA.CMPNT-SERIAL-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.GEAR-BOX-SERIAL-NO;
            VHCF06H_DATA.STOCK-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.GEAR-BOX-STOCK-NO;
  
  
            VHCF06H_DATA.PARENT-STOCK-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.AXLE-STOCK-NO;
            VHCF06H_DATA.PARENT-SERIAL-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.AXLE-SERIAL-NO;
            VHCF06H_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
            XXDATEW.VAGen_FUNCTION = "YMD";
            XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.GEAR-DATE-REBUILT;
            MRSCommonCode.XXDATES-CONVERT();
            VHCF06H_DATA.DATE-BUY-REBUILT[VHCF06IW-PASSVALUE.ON-CNT] = XXDATEW.DATE-YYYY-MM-DD;
            VHCF06H_DATA.POSN-CD[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.GEAR-POSN-CD;
            VHCF06IW-PASSVALUE.FINAL-COUNTER = VHCF06IW-PASSVALUE.ON-CNT;
        else
            if (VHCF06IW.B-CHECK-ON == "1" && VHCF06IW-PASSVALUE.B-DONE == " ")
                VHCF06IW-PASSVALUE.B-DONE = "1";
                VHCF06H_DATA.CMPNT-EQUIP-TYPE[VHCF06IW-PASSVALUE.ON-CNT] = "BEARING";
                VHCF06H_DATA.CMPNT-SERIAL-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.B-SERIAL-NO;
                VHCF06H_DATA.POSN-CD[VHCF06IW-PASSVALUE.ON-CNT] = "B";
                VHCF06H_DATA.STOCK-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.B-STOCK-NO;
                VHCF06H_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
    
     
                VHCF06H_DATA.PARENT-SERIAL-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.AXLE-SERIAL-NO;
                VHCF06H_DATA.PARENT-STOCK-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.AXLE-STOCK-NO;
                VHCF06IW-PASSVALUE.BEAR-SERIAL-NO = VHCF06IW.B-SERIAL-NO;
                XXDATEW.VAGen_FUNCTION = "YMD";
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.BEAR-B-DATE-REBUILT;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE = XXDATEW.DATE-YYYY-MM-DD;
                VHCF06IS-G-BEAR();
                VHCF06H_DATA.DATE-BUY-REBUILT[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE;
                VHCF06H_DATA.POSN-CD[VHCF06IW-PASSVALUE.ON-CNT] = "B";
                VHCF06IW-PASSVALUE.FINAL-COUNTER = VHCF06IW-PASSVALUE.ON-CNT;
            else
                if (VHCF06IW.N-CHECK-ON == "1" && VHCF06IW-PASSVALUE.N-DONE == " ")
                    VHCF06IW-PASSVALUE.N-DONE = "1";
                    VHCF06H_DATA.CMPNT-EQUIP-TYPE[VHCF06IW-PASSVALUE.ON-CNT] = "BEARING";
                    VHCF06H_DATA.CMPNT-SERIAL-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.N-SERIAL-NO;
                    VHCF06H_DATA.STOCK-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.N-STOCK-NO;
                    VHCF06H_DATA.POSN-CD[VHCF06IW-PASSVALUE.ON-CNT] = "N";
                    VHCF06H_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;

  
  
                    VHCF06H_DATA.PARENT-SERIAL-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.AXLE-SERIAL-NO;
                    VHCF06H_DATA.PARENT-STOCK-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.AXLE-STOCK-NO;
                    VHCF06IW-PASSVALUE.BEAR-SERIAL-NO = VHCF06IW.N-SERIAL-NO;
                    XXDATEW.VAGen_FUNCTION = "YMD";
                    XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.BEAR-N-DATE-REBUILT;
                    MRSCommonCode.XXDATES-CONVERT();
                    VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE = XXDATEW.DATE-YYYY-MM-DD;
                    VHCF06IS-G-BEAR();
                    VHCF06H_DATA.DATE-BUY-REBUILT[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE;
                    VHCF06H_DATA.POSN-CD[VHCF06IW-PASSVALUE.ON-CNT] = "N";
                    VHCF06IW-PASSVALUE.FINAL-COUNTER = VHCF06IW-PASSVALUE.ON-CNT;
                else
                    if (VHCF06IW.WHEEL-01-CHECK-ON == "1" && VHCF06IW-PASSVALUE.WHEEL-01-DONE == " ")
                        VHCF06IW-PASSVALUE.WHEEL-01-DONE = "1";
                        VHCF06H_DATA.CMPNT-EQUIP-TYPE[VHCF06IW-PASSVALUE.ON-CNT] = "WHEEL";
                        VHCF06IS-G-WHEEL();
                        VHCF06H_DATA.CMPNT-SERIAL-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF01J_DATA.WHEEL-SERIAL-NO;
  
                        VHCF06H_DATA.STOCK-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.WHEEL-01-STOCK-NO;
                        VHCF06H_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                        VHCF06H_DATA.PARENT-STOCK-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
                        VHCF06H_DATA.PARENT-SERIAL-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
                        VHCF06H_DATA.POSN-CD[VHCF06IW-PASSVALUE.ON-CNT] = "B";
                        VHCF06H_DATA.MEASUREMENT-1[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.FLANGE-01-MEASUREMENT;
                        VHCF06H_DATA.GEO-DATA-NAME-1[VHCF06IW-PASSVALUE.ON-CNT] = "WHEEL FLNG FNGR";
                        VHCF06H_DATA.MEASUREMENT-2[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.DIAMETER-01-MEASUREMENT;
                        VHCF06H_DATA.GEO-DATA-NAME-2[VHCF06IW-PASSVALUE.ON-CNT] = "WHEEL DIAMETER";
                        VHCF06IW-PASSVALUE.FINAL-COUNTER = VHCF06IW-PASSVALUE.ON-CNT;
                    else
  
                        if (VHCF06IW.WHEEL-02-CHECK-ON == "1" && VHCF06IW-PASSVALUE.WHEEL-02-DONE == " ")
                            VHCF06IW-PASSVALUE.WHEEL-02-DONE = "1";
                            VHCF06H_DATA.CMPNT-EQUIP-TYPE[VHCF06IW-PASSVALUE.ON-CNT] = "WHEEL";
                            VHCF06IS-G-WHEEL();
                            VHCF06H_DATA.CMPNT-SERIAL-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF01J_DATA.WHEEL-SERIAL-NO;
  
                            VHCF06H_DATA.STOCK-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.WHEEL-01-STOCK-NO;
                            VHCF06H_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                            VHCF06H_DATA.PARENT-STOCK-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
                            VHCF06H_DATA.PARENT-SERIAL-NO[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
                            VHCF06H_DATA.POSN-CD[VHCF06IW-PASSVALUE.ON-CNT] = "N";
                            VHCF06H_DATA.MEASUREMENT-1[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.FLANGE-02-MEASUREMENT;
                            VHCF06H_DATA.GEO-DATA-NAME-1[VHCF06IW-PASSVALUE.ON-CNT] = "WHEEL FLNG FNGR";
                            VHCF06H_DATA.MEASUREMENT-2[VHCF06IW-PASSVALUE.ON-CNT] = VHCF06IW.DIAMETER-02-MEASUREMENT;
                            VHCF06H_DATA.GEO-DATA-NAME-2[VHCF06IW-PASSVALUE.ON-CNT] = "WHEEL DIAMETER";
                            VHCF06IW-PASSVALUE.FINAL-COUNTER = VHCF06IW-PASSVALUE.ON-CNT;
                        end
                    end
                end
            end
        end
        VHCF06IW-PASSVALUE.ON-CNT = VHCF06IW-PASSVALUE.ON-CNT + 1;
    end

  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
    VHCF06H_DATA.S-REC-CNT = VHCF06IW-PASSVALUE.FINAL-COUNTER;
    VHCF06H_CRIT.JOB-NO = VHCF06IW-PASSVALUE.JOB-NO;
    VHCF06F_CRIT.SUB-JOB-DOC-NO = VHCF06IW-PASSVALUE.SUB-JOB-DOC-NO;
    VHCF06H_CRIT.CAR-NO = VHCF06IW.CAR-NO;
    VHCF06H_CRIT.HOME-YRD = VHCF06IW.HOME-YRD;
    if (VHCF06IW-PASSVALUE.FINAL-COUNTER > 0)
        try
            call "VHCF06H"(XDCONTROL, VHCF06H_CRIT, VHCF06H_DATA, VHCF06H_DATA_1);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
            VHCF06IW-MESSAGE.FINAL-MESSAGE = "COMPONENT(S) SELECTED ARE ADDED";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
  
  
    end
    if (VHCF06H_CRIT.DATABASE-SW == "Y")
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "Database error, no Componet are Added";
    end
end 

Function VHCF06IS-PRE-UPD () 
    set VHCF06IW-MESSAGE empty;
    VHCF06IW-TRIGGER.ERROR-FLAG = " ";
end 

Function VHCF06IS-SELECTION () 
    if (VHCF06IW.AXLE-SELECTION == 1)
        VHCF06IW-TRIGGER.AXLE-SERIAL-CURSOR = "Y";
        VHCF06IW-TRIGGER.AXLE-SERIAL-ENABLE = "Y";
        VHCF06IW-TRIGGER.GEARBOX-SERIAL-DISABLE = "Y";
        VHCF06IW.AXLE-SERIAL-NO = " ";
        VHCF06IS-AXLE();
    end
    if (VHCF06IW.AXLE-SELECTION == 2)
        VHCF06IW-TRIGGER.GEAR-SERIAL-CURSOR = "Y";
        VHCF06IW-TRIGGER.AXLE-SERIAL-DISABLE = "Y";
        VHCF06IW-TRIGGER.GEARBOX-SERIAL-ENABLE = "Y";
        VHCF06IW.GEAR-SERIAL-NO = " ";
        VHCF06IS-GEAR();
    end
end 

Function VHCF06IS-SET-ON-OF () 
    if (VHCF06IW.AXLE-SERIAL-NO != " " && VHCF06IW.GEAR-SERIAL-NO == " ")
        if (VHCF06IW.GEAR-BOX-SERIAL-NO != " ")
            VHCF06IW-TRIGGER.GEAR-ON-DISABLE = "Y";
            VHCF06IW-TRIGGER.GEAR-OFF-ENABLE = "Y";
        else
            VHCF06IW-TRIGGER.GEAR-ON-ENABLE = "Y";
            VHCF06IW-TRIGGER.GEAR-OFF-DISABLE = "Y";
        end
        if (VHCF06IW.B-SERIAL-NO != " ")
            VHCF06IW-TRIGGER.B-ON-DISABLE = "Y";
            VHCF06IW-TRIGGER.B-OFF-ENABLE = "Y";
        else
            VHCF06IW-TRIGGER.B-ON-ENABLE = "Y";
            VHCF06IW-TRIGGER.B-OFF-DISABLE = "Y";
        end
        if (VHCF06IW.N-SERIAL-NO != " ")
            VHCF06IW-TRIGGER.N-ON-DISABLE = "Y";
            VHCF06IW-TRIGGER.N-OFF-ENABLE = "Y";
        else
            VHCF06IW-TRIGGER.N-ON-ENABLE = "Y";
            VHCF06IW-TRIGGER.N-OFF-DISABLE = "Y";
        end
        if (VHCF06IW.WHEEL-01-SERIAL-NO != " ")
            VHCF06IW-TRIGGER.WHEEL-01-ON-DISABLE = "Y";
            VHCF06IW-TRIGGER.WHEEL-01-OFF-ENABLE = "Y";
        else
            VHCF06IW-TRIGGER.WHEEL-01-ON-ENABLE = "Y";
            VHCF06IW-TRIGGER.WHEEL-01-OFF-DISABLE = "Y";
        end
        if (VHCF06IW.WHEEL-02-SERIAL-NO != " ")
            VHCF06IW-TRIGGER.WHEEL-02-ON-DISABLE = "Y";
            VHCF06IW-TRIGGER.WHEEL-02-OFF-ENABLE = "Y";
        else
            VHCF06IW-TRIGGER.WHEEL-02-ON-ENABLE = "Y";
            VHCF06IW-TRIGGER.WHEEL-02-OFF-DISABLE = "Y";
        end
        if (VHCF06IW.GEAR-BOX-SERIAL-NO == " ")
            VHCF06IW-TRIGGER.GEAR-SERIAL-ENABLE = "Y";
        else
            VHCF06IW-TRIGGER.GEAR-SERIAL-DISABLE = "Y";
        end
        if (VHCF06IW.B-SERIAL-NO != " ")
            VHCF06IW-TRIGGER.B-SERIAL-DISABLE = "Y";
        else
            VHCF06IW-TRIGGER.B-SERIAL-ENABLE = "Y";
        end
        VHCF06IW-TRIGGER.B-DATE-REBUILT-ENABLE = "Y";
        if (VHCF06IW.N-SERIAL-NO != " ")
            VHCF06IW-TRIGGER.N-SERIAL-DISABLE = "Y";
        else
            VHCF06IW-TRIGGER.N-SERIAL-ENABLE = "Y";
        end
    end
    if (VHCF06IW.GEAR-SERIAL-NO != " " && VHCF06IW.AXLE-SERIAL-NO == " ")
        VHCF06IW-TRIGGER.B-ON-DISABLE = "Y";
        VHCF06IW-TRIGGER.B-OFF-DISABLE = "Y";
        VHCF06IW-TRIGGER.N-ON-DISABLE = "Y";
        VHCF06IW-TRIGGER.N-OFF-DISABLE = "Y";
        VHCF06IW-TRIGGER.WHEEL-01-ON-DISABLE = "Y";
        VHCF06IW-TRIGGER.WHEEL-01-OFF-DISABLE = "Y";
        VHCF06IW-TRIGGER.WHEEL-02-ON-DISABLE = "Y";
        VHCF06IW-TRIGGER.WHEEL-02-OFF-DISABLE = "Y";
        VHCF06IW-TRIGGER.DATE-REBUILT-ENABLE = "Y";
        if (VHCF06IW.GEAR-BOX-SERIAL-NO != " ")
            VHCF06IW-TRIGGER.GEAR-SERIAL-DISABLE = "Y";
        end
    end
end 

Function VHCF06IS-UPD-AXLE ()
  
  
  
  
  
  
  
  
  
  
  
  
   
    if (VHCF06IW.AXLE-DATE-CHECK-UPDATE == "1")
        VHCF06IS-UPD-AXLED();
    end

  
    if ((VHCF06IW.WHEEL-01-CHECK-UPDATE == "1" ||
     VHCF06IW.WHEEL-02-CHECK-UPDATE == "1" ||
     VHCF06IW.HUB-DATE-CHECK-UPDATE == "1" ||
     VHCF06IW.GEAR-DATE-REBUILT-UPDATE == "1"))
        VHCF06IS-UPD-ONLY();
    end


  
    if ((VHCF06IW.GEAR-CHECK-OFF == "1" ||
     VHCF06IW.B-CHECK-OFF == "1" ||
     VHCF06IW.N-CHECK-OFF == "1" ||
     VHCF06IW.WHEEL-01-CHECK-OFF == "1" ||
     VHCF06IW.WHEEL-02-CHECK-OFF == "1"))
        VHCF06IS-OFF();
    end

  
    if ((VHCF06IW.GEAR-CHECK-ON == "1" ||
     VHCF06IW.B-CHECK-ON == "1" ||
     VHCF06IW.N-CHECK-ON == "1" ||
     VHCF06IW.WHEEL-01-CHECK-ON == "1" ||
     VHCF06IW.WHEEL-02-CHECK-ON == "1"))
        VHCF06IS-ON();
    end

  
    VHCF06IS-ITEMCOUNT();
end 

Function VHCF06IS-UPD-AXLED () 
    VHCF06IW-PASSVALUE.UPD-CNT = 1;
    VHCF06IW-PASSVALUE.GEAR-DONE = " ";
    VHCF06IW-PASSVALUE.AXLE-1-DONE = " ";
    VHCF06IW-PASSVALUE.AXLE-2-DONE = " ";
    VHCF06IW-PASSVALUE.WHEEL-01-DONE = " ";
    VHCF06IW-PASSVALUE.WHEEL-02-DONE = " ";
    VHCF06IW-PASSVALUE.BEAR-B-DONE = " ";
    VHCF06IW-PASSVALUE.BEAR-N-DONE = " ";
    VHCF06IW-PASSVALUE.FINAL-COUNTER = 0;
    set VHCF06I_DATA empty;
    VHCF06I_CRIT.AXLE-SERIAL-NO = VHCF06IW.AXLE-SERIAL-NO;
    VHCF06IW-PASSVALUE.AXLE-REBUILT-DATE = VHCF06IW.AXLE-REBUILT-DATE;
    while (VHCF06IW-PASSVALUE.UPD-CNT < 10)
        if (VHCF06IW.AXLE-REBUILT-DATE != VHCF06IW-SAVE.AXLE-REBUILT-DATE && VHCF06IW-PASSVALUE.AXLE-1-DONE == " ")
            VHCF06IW-PASSVALUE.AXLE-1-DONE = "1";
            VHCF06I_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "AXLE";
            VHCF06I_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.AXLE-SERIAL-NO;
            VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
            VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
            XXDATEW.VAGen_FUNCTION = "YMD";
            XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.AXLE-REBUILT-DATE;
            MRSCommonCode.XXDATES-CONVERT();
            VHCF06I_DATA.DATE-BUY-REBUILT[UPD-CNT] = XXDATEW.DATE-YYYY-MM-DD;
            VHCF06I_DATA.POSN-CD[UPD-CNT] = VHCF06IW.AXLE-POSN-CD;
  
  
  
  
  
            if (VHCF06IW.B-SERIAL-NO != " ")
                UPD-CNT = UPD-CNT + 1;
  
                VHCF06I_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "BEARING";
                VHCF06I_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.B-SERIAL-NO;
                VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.B-STOCK-NO;
                VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                VHCF06I_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
                VHCF06I_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
                VHCF06IW-PASSVALUE.BEAR-SERIAL-NO = VHCF06IW.B-SERIAL-NO;
                XXDATEW.VAGen_FUNCTION = "YMD";
  
                VHCF06IW.BEAR-B-DATE-REBUILT = VHCF06IW.AXLE-REBUILT-DATE;
  
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.BEAR-B-DATE-REBUILT;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE = XXDATEW.DATE-YYYY-MM-DD;
                VHCF06IS-G-BEAR();
  
                VHCF06I_DATA.DATE-BUY-REBUILT[UPD-CNT] = XXDATEW.DATE-YYYY-MM-DD;
                VHCF06I_DATA.POSN-CD[UPD-CNT] = "B";
            end
  
  
  
  
            if (VHCF06IW.N-SERIAL-NO != " ")
                UPD-CNT = UPD-CNT + 1;
  
                VHCF06I_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "BEARING";
                VHCF06I_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.N-SERIAL-NO;
                VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.N-STOCK-NO;
                VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                VHCF06I_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
                VHCF06I_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
                VHCF06IW-PASSVALUE.BEAR-SERIAL-NO = VHCF06IW.N-SERIAL-NO;
                XXDATEW.VAGen_FUNCTION = "YMD";
  
                VHCF06IW.BEAR-N-DATE-REBUILT = VHCF06IW.AXLE-REBUILT-DATE;
  
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.BEAR-N-DATE-REBUILT;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE = XXDATEW.DATE-YYYY-MM-DD;
                VHCF06IS-G-BEAR();
  
                VHCF06I_DATA.DATE-BUY-REBUILT[UPD-CNT] = XXDATEW.DATE-YYYY-MM-DD;
                VHCF06I_DATA.POSN-CD[UPD-CNT] = "N";
            end
            VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
            
  
        end 
        UPD-CNT = UPD-CNT + 1;
    end

  
    VHCF06I_DATA.S-REC-CNT = VHCF06IW-PASSVALUE.FINAL-COUNTER;
    VHCF06I_CRIT.JOB-NO = VHCF06IW-PASSVALUE.JOB-NO;
    VHCF06F_CRIT.SUB-JOB-DOC-NO = VHCF06IW-PASSVALUE.SUB-JOB-DOC-NO;
    VHCF06I_CRIT.CAR-NO = VHCF06IW.CAR-NO;
    VHCF06I_CRIT.HOME-YRD = VHCF06IW.HOME-YRD;
    if (VHCF06IW-PASSVALUE.FINAL-COUNTER > 0)
        try
            call "VHCF06I"(XDCONTROL, VHCF06I_CRIT, VHCF06I_DATA, VHCF06I_DATA_1);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
            VHCF06IW-MESSAGE.FINAL-MESSAGE = "COMPONENT(S)  ARE UPDATED";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
  
  
    end
    if (VHCF06I_CRIT.DATABASE-SW == "Y")
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "Database error, no Componet are changed";
    end
end 

Function VHCF06IS-UPD-AXLEX () 
    VHCF06IW-PASSVALUE.UPD-CNT = 1;
    VHCF06IW-PASSVALUE.GEAR-DONE = " ";
    VHCF06IW-PASSVALUE.AXLE-1-DONE = " ";
    VHCF06IW-PASSVALUE.AXLE-2-DONE = " ";
