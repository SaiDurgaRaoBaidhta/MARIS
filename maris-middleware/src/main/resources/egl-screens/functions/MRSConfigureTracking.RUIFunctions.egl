                VHCF01Q_DATA.MSG-02A = " only one bearing is found";
                VHCF01IS-EXP-BEAR();
                if (VHCF01N_DATA.POSN-CD[1] == "7 ")
                    VHCF01IW.BEAR-SERIAL-07 = VHCF01N_DATA.CMPNT-SERIAL-NO[1];
                else
                    VHCF01IW.BEAR-SERIAL-08 = VHCF01N_DATA.CMPNT-SERIAL-NO[1];
                end
            else
                VHCF01M_CRIT.AXLE-SERIAL-NO = VHCF01IW.AXLE-SERIAL-04;
                VHCF01M_CRIT.CMPNT-EQUIP-TYPE = "BEARING";
                VHCF01M_CRIT.PARENT-POSN-CD = "4 ";
                VHCF01IS-CK-BEAR2(); 
                if (VHCF01M_DATA.SERIAL-FOUND == "Y")
                    if (VHCF01M_DATA.POSN-CD[1] == "7 ")
                        VHCF01IW.BEAR-SERIAL-07 = VHCF01M_DATA.CMPNT-SERIAL-NO[1];
                        VHCF01M_DATA.BEAR-STOCK-07 = VHCF01M_DATA.STOCK-NO[1];
                        VHCF01M_DATA.DATE-REBUILT-BEAR-07 = VHCF01M_DATA.DATE-LAST-REBUILT[1];
                        VHCF01IW.BEAR-SERIAL-08 = VHCF01M_DATA.CMPNT-SERIAL-NO[2];
                        VHCF01M_DATA.BEAR-STOCK-08 = VHCF01M_DATA.STOCK-NO[2];
                        VHCF01M_DATA.DATE-REBUILT-BEAR-08 = VHCF01M_DATA.DATE-LAST-REBUILT[2];
                    else
                        VHCF01IW.BEAR-SERIAL-08 = VHCF01M_DATA.CMPNT-SERIAL-NO[1];
                        VHCF01M_DATA.BEAR-STOCK-08 = VHCF01M_DATA.STOCK-NO[1];
                        VHCF01M_DATA.DATE-REBUILT-BEAR-08 = VHCF01M_DATA.DATE-LAST-REBUILT[1];
                        VHCF01IW.BEAR-SERIAL-07 = VHCF01M_DATA.CMPNT-SERIAL-NO[2];
                        VHCF01M_DATA.BEAR-STOCK-07 = VHCF01M_DATA.STOCK-NO[2];
                        VHCF01M_DATA.DATE-REBUILT-BEAR-07 = VHCF01M_DATA.DATE-LAST-REBUILT[2];
                    end
                    VHCF01IW-FLAG.ADD-BEAR-07 = "Y";
                    VHCF01IW-FLAG.ADD-BEAR-08 = "Y";
                else
                    if (VHCF01M_DATA.SERIAL-FOUND == "A")
                        VHCF01IW-FLAG.CMPNT-STAT = "INCP";
                        VHCF01Q_DATA.TEMP-POSN-CD = "4 ";
                        VHCF01Q_DATA.MSG-ALL-A = "Bearing is on other config Axle (Not entered Axle).  ";
                        VHCF01IS-EXP-GEAR();
                        VHCF01IW-FLAG.ADD-BEAR-07 = "N";
                        VHCF01IW-FLAG.ADD-BEAR-08 = "N";
                    else
                        VHCF01Q_DATA.TEMP-POSN-CD = "4 ";
                        VHCF01Q_DATA.MSG-01A = "AXLE SERIAL # ";
                        VHCF01Q_DATA.MSG-SER-A = VHCF01IW.AXLE-SERIAL-04;
                        VHCF01Q_DATA.MSG-02A = "-Bearing is not found";
                        VHCF01IS-EXP-GEAR(); 
                        VHCF01IW-FLAG.ADD-BEAR-07 = "N";
                        VHCF01IW-FLAG.ADD-BEAR-08 = "N";
                    end
                end
            end
        end
    end
end 

Function VHCF01IS-V-DISC () 
    VHCF01IW-FLAG.INVALID-IND = "N";
  
  
  
  
    if ((VHCF01IW.DISC-SERIAL-01 == "  " || VHCF01IW.DISC-SERIAL-02 == "  " || VHCF01IW.DISC-SERIAL-03 == "  " || VHCF01IW.DISC-SERIAL-04 == "  ") &&
     (VHCF01IW-01.ACTION-DATA == "NO ACTION SELECTED" || VHCF01IW-01.ACTION-DATA == "  "))
        VHCF01IW-FLAG.INVALID-IND = "Y";
        VHCF01IW-MSG.FINAL-MESSAGE = "DISC Serial #s can not be blank. Please double check. ";
    else
        if (((VHCF01IW.DISC-SERIAL-01 == VHCF01IW.DISC-SERIAL-02 && VHCF01IW.DISC-SERIAL-01 != "   ") || (VHCF01IW.DISC-SERIAL-01 == VHCF01IW.DISC-SERIAL-03 && VHCF01IW.DISC-SERIAL-01 != "   ") || (VHCF01IW.DISC-SERIAL-01 == VHCF01IW.DISC-SERIAL-04 && VHCF01IW.DISC-SERIAL-01 != "    ") || (VHCF01IW.DISC-SERIAL-02 == VHCF01IW.DISC-SERIAL-03 && VHCF01IW.DISC-SERIAL-02 != "    ") || (VHCF01IW.DISC-SERIAL-02 == VHCF01IW.DISC-SERIAL-04 && VHCF01IW.DISC-SERIAL-02 != "   ") || (VHCF01IW.DISC-SERIAL-03 == VHCF01IW.DISC-SERIAL-04 && VHCF01IW.DISC-SERIAL-03 != "   ")))
            VHCF01IW-FLAG.INVALID-IND = "Y";
            VHCF01IW-MSG.FINAL-MESSAGE = "DISC Serial #s can not be the same.  Please double check. ";
        else
            if (VHCF01IW-01.ACTION-DATA != "TRUCK,AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "DISC1")
                VHCF01IS-V-DISC1();
            end
            if (VHCF01IW-FLAG.INVALID-IND == "N")
                if (VHCF01IW-01.ACTION-DATA != "TRUCK,AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "DISC2")
                    VHCF01IS-V-DISC2();
                end
            end
            if (VHCF01IW-FLAG.INVALID-IND == "N")
                if (VHCF01IW-01.ACTION-DATA != "TRUCK,AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "DISC3")
                    VHCF01IS-V-DISC3();
                end
            end
            if (VHCF01IW-FLAG.INVALID-IND == "N")
                if (VHCF01IW-01.ACTION-DATA != "TRUCK,AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "DISC4")
                    VHCF01IS-V-DISC4();
                end
            end
        end
    end
end 

Function VHCF01IS-V-DISC1 () 
    if (VHCF01IW-SV2.EQ-PARM == "DISC1")
        VHCF01IS-G-GEO();

  
  
  
  
  
  
        if (VHCF01IW.DISC-1-ANVIL < VHCF01P_DATA.ANVIL-VALID-FROM ||
         VHCF01IW.DISC-1-ANVIL > VHCF01P_DATA.ANVIL-VALID-TO)
            ERROR-CNT = ERROR-CNT + 1;
            ER-SER-NO[ERROR-CNT] = VHCF01IW.DISC-SERIAL-01;
            VHCF01IW-MSG.DISC-MSG-1 = "-DISC #1 anvil out of range: (";
            VHCF01IW-PASSVALUE.VALID-FROM-X = VHCF01P_DATA.ANVIL-VALID-FROM;
            VHCF01IW-PASSVALUE.VALID-TO-X = VHCF01P_DATA.ANVIL-VALID-TO;
            DISC-MSG-2 = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.DISC-MSG-2- = ".";
            DISC-MSG-2X = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.DISC-MSG-3 = " - ";
            VHCF01IW-MSG.DISC-MSG-4 = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.DISC-MSG-4- = ".";
            DISC-MSG-4X = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.DISC-MSG-5 = ") @";
            ER-DESC[ERROR-CNT] = VHCF01IW-MSG.DISC-MSG;
            
  
        end
        if (VHCF01IW.DISC-1-PISTON < VHCF01P_DATA.PISTON-VALID-FROM ||
         VHCF01IW.DISC-1-PISTON > VHCF01P_DATA.PISTON-VALID-TO)
            ERROR-CNT = ERROR-CNT + 1;
            ER-SER-NO[ERROR-CNT] = VHCF01IW.DISC-SERIAL-01;
            VHCF01IW-MSG.DISC-MSG-1 = "-DISC #1 piston out of range: (";
            VHCF01IW-PASSVALUE.VALID-FROM-X = VHCF01P_DATA.ANVIL-VALID-FROM;
            VHCF01IW-PASSVALUE.VALID-TO-X = VHCF01P_DATA.ANVIL-VALID-TO;
            DISC-MSG-2 = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.DISC-MSG-2- = ".";
            DISC-MSG-2X = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.DISC-MSG-3 = " - ";
            VHCF01IW-MSG.DISC-MSG-4 = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.DISC-MSG-4- = ".";
            DISC-MSG-4X = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.DISC-MSG-5 = ") @";
            ER-DESC[ERROR-CNT] = VHCF01IW-MSG.DISC-MSG;
            
  
        end

  
  
  
  
  
  
    end
    if (VHCF01IW.DISC-SERIAL-01 == VHCF01IW-SAVE.SAVE-DISC-SER-01 && VHCF01IW-SAVE.SAVE-DISC-SER-01 != "A-EXCEPT")
        VHCF01IW-FLAG.DISC-01-IN-TABLE = "Y";
        VHCF01IW-SAVE.SAVE-DISC-SER-01 = "A-EXCEPT";
        VHCF01IW-FLAG.CMPNT-STAT = "SURV";
        VHCF01Q_DATA.MSG-02A = "is on another car.  ";
        VHCF01IS-EXP-DISC1();
    else
        if (VHCF01IW.DISC-SERIAL-01 == VHCF01IW-SAVE.SV-DISC-SER-01 && VHCF01IW-SAVE.SV-DISC-SER-01 != "A-EXCEPT")
            VHCF01IW-FLAG.DISC-01-IN-TABLE = "Y";
            VHCF01IW-FLAG.CMPNT-STAT = "SURV";
            VHCF01Q_DATA.MSG-02A = "is on another truck.  ";
            VHCF01IS-EXP-DISC1();
  
        end
    end
    VHCF01D_CRIT.SERIAL-NO = VHCF01IW.DISC-SERIAL-01;
    VHCF01D_CRIT.CMPNT-EQUIP-TYPE = "BRAKE DISC";
    VHCF01D_CRIT.POSN-CD = "1";
    VHCF01IS-CK-SER();
    if (VHCF01IW.CONTINUE-CAR-DISC01 == "Y" &&
     VHCF01IW.DISC-SERIAL-01 == VHCF01IW-SAVEX.DISC-SERIAL-01)
        return;
    else
        VHCF01IW-SAVE.SV-DISC-01-STOCK-NO = VHCF01D_DATA.STOCK-NO;
        if (SERIAL-LOCATED == "SRP")
            VHCF01IW-MSG.MSG-01 = "SERIAL#: ";
            VHCF01IW-MSG.SERIAL-NO = VHCF01IW.DISC-SERIAL-01;
            VHCF01IW-MSG.MSG-02 = "-DISC #1 serial has been scrapped.  Please re-enter the serial number";
            INVALID-IND = "Y";
        else
            if (SERIAL-LOCATED == "CAR")
                VHCF01IW.SERIAL-LOCATED-DISC01 = "CAR";
                VHCF01IW.CONTINUE-CAR-DISC01 = "Y";
                VHCF01IW-FLAG.DISC-01-IN-TABLE = "Y";
                SAVE-DISC-SER-01 = VHCF01IW.DISC-SERIAL-01;
                VHCF01IW-SAVEX.DISC-SERIAL-01 = VHCF01IW.DISC-SERIAL-01;
                VHCF01IW-MSG.MSG-01 = "SERIAL#:";
                VHCF01IW-MSG.SERIAL-NO = VHCF01IW.DISC-SERIAL-01;
                VHCF01IW-MSG.MSG-02 = "-DISC #1 is on anther car.  Do you want to continue (Press Update again to continue)";
                INVALID-IND = "Y";
                VHCF01F_CRIT_X.EXCEP-CAR-NO-DC-1 = VHCF01D_DATA.CAR-NO;
                VHCF01T_CRIT_X.EXCEP-CAR-NO-DC-1 = VHCF01D_DATA.CAR-NO;
            else
                if (SERIAL-LOCATED == "DB")
                    if (VHCF01D_DATA.PARENT-SERIAL-NO == "  ")
                        VHCF01IW-FLAG.DISC-01-IN-TABLE = "Y";
                    else
                        if (VHCF01D_DATA.PARENT-SERIAL-NO != VHCF01IW.X-TRUCK-SERIAL ||
                         VHCF01D_DATA.PARENT-STOCK-NO != VHCF01IW-SAVE.SV-X-STOCK-NO)
                            SV-DISC-SER-01 = VHCF01IW.DISC-SERIAL-01;
                            VHCF01IW-MSG.MSG-01 = "SERIAL#:";
                            VHCF01IW-MSG.SERIAL-NO = VHCF01IW.DISC-SERIAL-01;
                            VHCF01IW-MSG.MSG-02 = "-DISC #1 is on anther truck.  Do you want to continue (Press Update again to continue)";
                            INVALID-IND = "Y";
                        end
                    end
                end
            end
        end
    end
end 

