                                            VHCF01IW.GEAR-SERIAL-03 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                                            VHCF01IW.GEAR-STOCK-03 = VHCF01B_DATA.STOCK-NO[X];
                                        else
