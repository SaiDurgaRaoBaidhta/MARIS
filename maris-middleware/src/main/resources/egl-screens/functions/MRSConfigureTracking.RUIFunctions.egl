            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    else
        VHCF01IW-MSG.FINAL-MESSAGE = "Update not made, database error - sql code xxxx";
    end
end 

