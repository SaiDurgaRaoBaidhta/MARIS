Function VHCF01IS-G-DETAIL () 
    try
        call "VHCF01C"(XDCONTROL, VHCF01C_CRIT, VHCF01C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF01IW-FLAG.DETAIL-IS-FOUND = "Y";
    else
        if (XDCONTROL.URC == 100)
            VHCF01IW-FLAG.DETAIL-IS-FOUND = "N";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

Function VHCF01IS-G-GEO () 
    try
        call "VHCF01P"(XDCONTROL, VHCF01P_CRIT, VHCF01P_DATA);
    
    end
end 

Function VHCF01IS-G-TRUCK () 
    VHCF01B_CRIT.CAR-NO = VHCF01IW-01.CAR-NO;
    try
        call "VHCF01B"(XDCONTROL, VHCF01B_CRIT, VHCF01B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF01IW-FLAG.TRUCK-IS-FOUND = "Y";
        NUM-OF-ROW = XDCONTROL.UROWCNT;
        VHCF01IS-M-DATA();
    else
        if (XDCONTROL.URC == 100)
            VHCF01IW-FLAG.TRUCK-IS-FOUND = "N";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

Function VHCF01IS-G-W-SER () 
    try
        call "VHCF01J"(XDCONTROL, VHCF01J_CRIT, VHCF01J_DATA);
    
    end
end 

Function VHCF01IS-GEO () 
    VHCF01IS-SV-DA3();
    VHCF01IW-SV3.U-CNT = 1;
    if (VHCF01IW-SV3.SV3-CNT > 0)
        if (VHCF01IW-MSG.ERROR-CNT > 0)
            VHCF01IS-MOVE-MSG();
        else
            VHCF01U_CRIT.HOME-YRD = VHCF01IW-SAVE.HOME-YRD;
            VHCF01U_CRIT.CAR-NO = VHCF01IW-01.CAR-NO;
            VHCF01U_CRIT.EMPL-NO = VHCF01IW.EMPL-NO;
            VHCF01U_CRIT.SHOP-LOC = VHCF01IW.LOC;
            if (VHCF01IW.EMPL-NO == " " || VHCF01IW.LOC == " ")
                VHCF01IW-MSG.FINAL-MESSAGE = "Employee number or Shop Loc can not be blanck ";
                VHCF01IW-FLAG.EMP-NO-SETFOCUS = "Y";
            else
                while (VHCF01IW-SV3.U-CNT <= VHCF01IW-SV3.SV3-CNT)
                    VHCF01IS-BUILD-3();
                    VHCF01IS-CLEARX();
                    VHCF01IW-SV3.U-CNT = VHCF01IW-SV3.U-CNT + 1;
                end
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHCF01IS-LIST3();
                VHCF01IW-MSG.FINAL-MESSAGE = "NEW  CHANGED GEOMETRY DATA ARE  BUILT/ADDED";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        end
    else
        VHCF01IW-MSG.FINAL-MESSAGE = "No  Geometry data is added or changed";
    end
end 

Function VHCF01IS-GRP-ACCES () 
    if ("pbtSurveyUpd" in VH01A02_DATA.PART-NAME)
        if (VH01A02_DATA.ACCESS-ALLOW[sysVar.arrayIndex] == "N")
            VHCF01IW-FLAG.HIDE-UPDATE = "Y";
        else
            VHCF01IW-FLAG.ENABLE-UPDATE = "Y";
        end
    else
        VHCF01IW-FLAG.ENABLE-UPDATE = "Y";
    end
end 

Function VHCF01IS-INIT ()
   
    set VHCF01IW-SAVE empty;
    set VHCF01IW-SV2 empty;
    set VHCF01IW-COLOR empty;
    VHCF01IW-FLAG.INVALID-IND = "N";
    VHCF01IW-01.ACTION-IDX = 1;
    set VHCF01IW empty;
    
  
  
  
  
  
    VHCF01IW-FLAG.Y-IS-SELECT = "Y";
    VHCF01IW-FLAG.X-IS-SELECT = "Y";
    try
        call "VHCF01G"(XDCONTROL, VHCF01G_CRIT, VHCF01G_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF01IW-CNT.YRD-ROW-CNT = XDCONTROL.UROWCNT;
        VHCF01IW-TRIGGER.LOAD-YRD-DATA = "Y";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    if (VHCF01IW-01.CAR-NO != "  ")
        VHCF01IW-FLAG.EXE-LIST = "Y";
    end
end 

