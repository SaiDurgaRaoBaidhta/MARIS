            VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
            VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
            XXDATEW.VAGen_FUNCTION = "YMD";
            XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.AXLE-REBUILT-DATE;
            MRSCommonCode.XXDATES-CONVERT();
            VHCF06I_DATA.DATE-BUY-REBUILT[UPD-CNT] = XXDATEW.DATE-YYYY-MM-DD;
            VHCF06I_DATA.POSN-CD[UPD-CNT] = VHCF06IW.AXLE-POSN-CD;
            VHCF06I_DATA.DATE-HUB-COUP-REPL[UPD-CNT] = " ";
            UPD-CNT = UPD-CNT + 1;
            VHCF06I_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "BEARING";
            VHCF06I_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.B-SERIAL-NO;
            VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.B-STOCK-NO;
            VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
            VHCF06I_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
            VHCF06I_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
            VHCF06IW-PASSVALUE.BEAR-SERIAL-NO = VHCF06IW.B-SERIAL-NO;
            XXDATEW.VAGen_FUNCTION = "YMD";
            if (VHCF06IW.BEAR-B-DATE-REBUILT == " ")
                VHCF06IW.BEAR-B-DATE-REBUILT = VHCF06IW.AXLE-REBUILT-DATE;
            end
            XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.BEAR-B-DATE-REBUILT;
            MRSCommonCode.XXDATES-CONVERT();
            VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE = XXDATEW.DATE-YYYY-MM-DD;
            VHCF06IS-G-BEAR();
  
            VHCF06I_DATA.DATE-BUY-REBUILT[UPD-CNT] = XXDATEW.DATE-YYYY-MM-DD;
            VHCF06I_DATA.POSN-CD[UPD-CNT] = "B";
            UPD-CNT = UPD-CNT + 1;
            VHCF06I_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.N-SERIAL-NO;
            VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.N-STOCK-NO;
            VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
            VHCF06I_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
            VHCF06I_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
            VHCF06IW-PASSVALUE.BEAR-SERIAL-NO = VHCF06IW.N-SERIAL-NO;
            XXDATEW.VAGen_FUNCTION = "YMD";
            if (VHCF06IW.BEAR-N-DATE-REBUILT == " ")
                VHCF06IW.BEAR-N-DATE-REBUILT = VHCF06IW.AXLE-REBUILT-DATE;
            end
            XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.BEAR-N-DATE-REBUILT;
            MRSCommonCode.XXDATES-CONVERT();
            VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE = XXDATEW.DATE-YYYY-MM-DD;
            VHCF06IS-G-BEAR();
  
            VHCF06I_DATA.DATE-BUY-REBUILT[UPD-CNT] = XXDATEW.DATE-YYYY-MM-DD;
            VHCF06I_DATA.POSN-CD[UPD-CNT] = "N";
            VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
        else
            if (VHCF06IW.AXLE-HUB-COUP-REPL-DATE != VHCF06IW-SAVE.AXLE-HUB-COUP-REPL-DATE && VHCF06IW-PASSVALUE.AXLE-2-DONE == " ")
                VHCF06IW-PASSVALUE.AXLE-2-DONE = "1";
                VHCF06I_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "AXLE";
                VHCF06I_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.AXLE-SERIAL-NO;
                VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
                VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                XXDATEW.VAGen_FUNCTION = "YMD";
                XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.AXLE-HUB-COUP-REPL-DATE;
                MRSCommonCode.XXDATES-CONVERT();
                VHCF06I_DATA.DATE-HUB-COUP-REPL[UPD-CNT] = XXDATEW.DATE-YYYY-MM-DD;
                VHCF06I_DATA.POSN-CD[UPD-CNT] = VHCF06IW.AXLE-POSN-CD;
                VHCF06I_DATA.DATE-BUY-REBUILT[UPD-CNT] = " ";
                VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
            else
                if (VHCF06IW.GEAR-DATE-REBUILT != VHCF06IW-SAVE.GEAR-DATE-REBUILT && VHCF06IW-PASSVALUE.GEAR-DONE == " ")
                    VHCF06IW-PASSVALUE.GEAR-DONE = "1";
                    VHCF06I_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "GEAR BOX";
                    VHCF06I_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.GEAR-BOX-SERIAL-NO;
                    VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.GEAR-BOX-STOCK-NO;
                    VHCF06I_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW.AXLE-SERIAL-NO;
                    VHCF06I_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
  
  
                    VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                    XXDATEW.VAGen_FUNCTION = "YMD";
                    XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.GEAR-DATE-REBUILT;
                    MRSCommonCode.XXDATES-CONVERT();
                    VHCF06I_DATA.DATE-BUY-REBUILT[UPD-CNT] = XXDATEW.DATE-YYYY-MM-DD;
                    VHCF06I_DATA.POSN-CD[UPD-CNT] = VHCF06IW.GEAR-POSN-CD;
                    VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
                else
                    if (VHCF06IW-SAVE.B-SERIAL-NO == " " && VHCF06IW-SAVE.B-SERIAL-NO != VHCF06IW.B-SERIAL-NO && VHCF06IW-PASSVALUE.BEAR-B-DONE == " ")
                        VHCF06IW-PASSVALUE.BEAR-B-DONE = "1";
                        VHCF06I_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "BEARING";
                        VHCF06I_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.B-SERIAL-NO;
                        VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.B-STOCK-NO;
                        VHCF06I_DATA.POSN-CD[UPD-CNT] = "B";
                        VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                        VHCF06I_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW.AXLE-SERIAL-NO;
                        VHCF06I_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
  
  
                        VHCF06IW-PASSVALUE.BEAR-SERIAL-NO = VHCF06IW.B-SERIAL-NO;
                        XXDATEW.VAGen_FUNCTION = "YMD";
                        XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.BEAR-B-DATE-REBUILT;
                        MRSCommonCode.XXDATES-CONVERT();
                        VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE = XXDATEW.DATE-YYYY-MM-DD;
                        VHCF06IS-G-BEAR();
                        VHCF06I_DATA.DATE-BUY-REBUILT[UPD-CNT] = VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE;
                        VHCF06I_DATA.POSN-CD[UPD-CNT] = "B";
                        VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
                    else
                        if (VHCF06IW-SAVE.N-SERIAL-NO == " " && VHCF06IW-SAVE.N-SERIAL-NO != VHCF06IW.N-SERIAL-NO && VHCF06IW-PASSVALUE.BEAR-N-DONE == " ")
                            VHCF06IW-PASSVALUE.BEAR-N-DONE = "1";
                            VHCF06I_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "BEARING";
                            VHCF06I_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.N-SERIAL-NO;
                            VHCF06I_DATA.POSN-CD[UPD-CNT] = "N";
                            VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.N-STOCK-NO;
                            VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                            VHCF06I_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW.AXLE-SERIAL-NO;
                            VHCF06I_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
  
  
                            VHCF06IW-PASSVALUE.BEAR-SERIAL-NO = VHCF06IW.N-SERIAL-NO;
                            XXDATEW.VAGen_FUNCTION = "YMD";
                            XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.BEAR-N-DATE-REBUILT;
                            MRSCommonCode.XXDATES-CONVERT();
                            VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE = XXDATEW.DATE-YYYY-MM-DD;
                            VHCF06IS-G-BEAR();
                            VHCF06I_DATA.DATE-BUY-REBUILT[UPD-CNT] = VHCF06IW-PASSVALUE.BEAR-SERIAL-DATE;
                            VHCF06I_DATA.POSN-CD[UPD-CNT] = "N";
                            VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
                        else
                            if ((VHCF06IW.FLANGE-01-MEASUREMENT != VHCF06IW-SAVE.FLANGE-01-MEASUREMENT ||
                             VHCF06IW.DIAMETER-01-MEASUREMENT != VHCF06IW-SAVE.DIAMETER-01-MEASUREMENT) && VHCF06IW-PASSVALUE.WHEEL-01-DONE == " ")
                                VHCF06IW-PASSVALUE.WHEEL-01-DONE = "1";
                                VHCF06I_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "WHEEL";
                                VHCF06IS-G-WHEEL();
                                VHCF06I_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF01J_DATA.WHEEL-SERIAL-NO;
  
                                VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.WHEEL-01-STOCK-NO;
                                VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                                VHCF06I_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW.AXLE-SERIAL-NO;
                                VHCF06I_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
  
  
  
                                VHCF06I_DATA.POSN-CD[UPD-CNT] = "B";
                                VHCF06I_DATA.MEASUREMENT-1[UPD-CNT] = VHCF06IW.FLANGE-01-MEASUREMENT;
                                VHCF06I_DATA.GEO-DATA-NAME-1[UPD-CNT] = "WHEEL FLNG FNGR";
                                VHCF06I_DATA.MEASUREMENT-2[UPD-CNT] = VHCF06IW.DIAMETER-01-MEASUREMENT;
                                VHCF06I_DATA.GEO-DATA-NAME-2[UPD-CNT] = "WHEEL DIAMETER";
                                VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
                            else
                                if ((VHCF06IW.FLANGE-02-MEASUREMENT != VHCF06IW-SAVE.FLANGE-02-MEASUREMENT ||
                                 VHCF06IW.DIAMETER-02-MEASUREMENT != VHCF06IW-SAVE.DIAMETER-02-MEASUREMENT) && VHCF06IW-PASSVALUE.WHEEL-02-DONE == " ")
                                    VHCF06IW-PASSVALUE.WHEEL-02-DONE = "1";
                                    VHCF06I_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "WHEEL";
                                    VHCF06IS-G-WHEEL();
                                    VHCF06I_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF01J_DATA.WHEEL-SERIAL-NO;
  
                                    VHCF06I_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.WHEEL-01-STOCK-NO;
                                    VHCF06I_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                                    VHCF06I_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW.AXLE-SERIAL-NO;
                                    VHCF06I_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
  
  
  
                                    VHCF06I_DATA.POSN-CD[UPD-CNT] = "N";
                                    VHCF06I_DATA.MEASUREMENT-1[UPD-CNT] = VHCF06IW.FLANGE-02-MEASUREMENT;
                                    VHCF06I_DATA.GEO-DATA-NAME-1[UPD-CNT] = "WHEEL FLNG FNGR";
                                    VHCF06I_DATA.MEASUREMENT-2[UPD-CNT] = VHCF06IW.DIAMETER-02-MEASUREMENT;
                                    VHCF06I_DATA.GEO-DATA-NAME-2[UPD-CNT] = "WHEEL DIAMETER";
                                    VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
                                end
                            end
                        end
                    end
                end
            end
        end
        UPD-CNT = UPD-CNT + 1;
    end

  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
    VHCF06I_DATA.S-REC-CNT = VHCF06IW-PASSVALUE.FINAL-COUNTER;
    VHCF06I_CRIT.JOB-NO = VHCF06IW-PASSVALUE.JOB-NO;
    VHCF06F_CRIT.SUB-JOB-DOC-NO = VHCF06IW-PASSVALUE.SUB-JOB-DOC-NO;
    VHCF06I_CRIT.CAR-NO = VHCF06IW.CAR-NO;
    VHCF06I_CRIT.HOME-YRD = VHCF06IW.HOME-YRD;
    if (VHCF06IW-PASSVALUE.FINAL-COUNTER > 0)
        try
            call "VHCF06I"(XDCONTROL, VHCF06I_CRIT, VHCF06I_DATA, VHCF06I_DATA_1);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
            VHCF06IW-MESSAGE.FINAL-MESSAGE = "COMPONENT(S)  ARE UPDATED";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
  
  
    end
    if (VHCF06I_CRIT.DATABASE-SW == "Y")
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "Database error, no Componet are changed";
    end
end 

Function VHCF06IS-UPD-GEAR () 
    VHCF06G_CRIT.JOB-NO = VHCF06IW-PASSVALUE.JOB-NO;
    VHCF06G_CRIT.SUB-JOB-DOC-NO = VHCF06IW-PASSVALUE.SUB-JOB-DOC-NO;
    VHCF06G_CRIT.CAR-NO = VHCF06IW.CAR-NO;
    VHCF06G_DATA.HOME-YRD = VHCF06IW.HOME-YRD;
    VHCF06G_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.GEAR-DATE-REBUILT;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF06G_DATA.DATE-BUY-REBUILT = XXDATEW.DATE-YYYY-MM-DD;
    VHCF06G_DATA.CMPNT-EQUIP-TYPE = "GEAR BOX";
    VHCF06G_DATA.CMPNT-SERIAL-NO = VHCF06IW.GEAR-BOX-SERIAL-NO;
    VHCF06G_DATA.STOCK-NO = VHCF06IW.GEAR-BOX-STOCK-NO;
    VHCF06G_DATA.PARENT-STOCK-NO = VHCF06IW-PASSVALUE.PARENT-STOCK-NO;
    VHCF06G_DATA.PARENT-SERIAL-NO = VHCF06IW-PASSVALUE.PARENT-SERIAL-NO;
    VHCF06G_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
    VHCF06G_DATA.POSN-CD = VHCF06IW.GEAR-POSN-CD;
    try
        call "VHCF06G"(XDCONTROL, VHCF06G_CRIT, VHCF06G_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "GEAR BOX IS UPDATED";
        
  
  
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

Function VHCF06IS-UPD-ONLY ()
  
  
  
  
   
    VHCF06IW-PASSVALUE.UPD-CNT = 1;
    VHCF06IW-PASSVALUE.GEAR-DONE = " ";
    
  
  
    VHCF06IW-PASSVALUE.WHEEL-01-DONE = " ";
    VHCF06IW-PASSVALUE.WHEEL-02-DONE = " ";
    
  
  
  
    set VHCF06J_DATA empty;
    if (VHCF06IW.GEAR-DATE-REBUILT-UPDATE == "1")
        VHCF06IW-PASSVALUE.GEAR-DONE = "1";
        VHCF06J_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "GEAR BOX";
        VHCF06J_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.GEAR-BOX-SERIAL-NO;
        VHCF06J_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.GEAR-BOX-STOCK-NO;
        VHCF06J_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW.AXLE-SERIAL-NO;
        VHCF06J_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
        VHCF06J_DATA.SERIAL-STAT[UPD-CNT] = VHCF06IW.AXLE-SERIAL-STAT;
  
  
        VHCF06J_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.GEAR-DATE-REBUILT;
        MRSCommonCode.XXDATES-CONVERT();
        VHCF06J_DATA.DATE-BUY-REBUILT[UPD-CNT] = XXDATEW.DATE-YYYY-MM-DD;
        VHCF06J_DATA.POSN-CD[UPD-CNT] = VHCF06IW.GEAR-POSN-CD;
        VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
        UPD-CNT = UPD-CNT + 1;
    end
  
    if (VHCF06IW.HUB-DATE-CHECK-UPDATE == "1")
  
        VHCF06J_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "AXLE";
        VHCF06J_DATA.DATE-HUB-COUP-REPL[UPD-CNT] = VHCF06IW.AXLE-HUB-COUP-REPL-DATE;
        VHCF06J_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.AXLE-SERIAL-NO;
        VHCF06J_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
        VHCF06J_DATA.SERIAL-STAT[UPD-CNT] = VHCF06IW.AXLE-SERIAL-STAT;
  
  
  
  
        VHCF06J_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHCF06IW.AXLE-HUB-COUP-REPL-DATE;
        MRSCommonCode.XXDATES-CONVERT();
        VHCF06J_DATA.DATE-HUB-COUP-REPL[UPD-CNT] = XXDATEW.DATE-YYYY-MM-DD;
        VHCF06J_DATA.POSN-CD[UPD-CNT] = VHCF06IW.AXLE-POSN-CD;
        VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
        UPD-CNT = UPD-CNT + 1;
    end
  
    if (VHCF06IW.WHEEL-01-CHECK-UPDATE == "1")
        VHCF06IW-PASSVALUE.WHEEL-01-DONE = "1";
        VHCF06J_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "WHEEL";
   
   
        VHCF06J_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.WHEEL-01-SERIAL-NO;
        VHCF06J_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.WHEEL-01-STOCK-NO;
        VHCF06J_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
        VHCF06J_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW.AXLE-SERIAL-NO;
        VHCF06J_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
  
  
  
        VHCF06J_DATA.POSN-CD[UPD-CNT] = "B";
        VHCF06J_DATA.MEASUREMENT-1[UPD-CNT] = VHCF06IW.FLANGE-01-MEASUREMENT;
        VHCF06J_DATA.GEO-DATA-NAME-1[UPD-CNT] = "WHEEL FLNG FNGR";
        VHCF06J_DATA.MEASUREMENT-2[UPD-CNT] = VHCF06IW.DIAMETER-01-MEASUREMENT;
        VHCF06J_DATA.GEO-DATA-NAME-2[UPD-CNT] = "WHEEL DIAMETER";
        VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
        UPD-CNT = UPD-CNT + 1;
    end
    if (VHCF06IW.WHEEL-02-CHECK-UPDATE == "1")
        VHCF06IW-PASSVALUE.WHEEL-02-DONE = "1";
        VHCF06J_DATA.CMPNT-EQUIP-TYPE[UPD-CNT] = "WHEEL";
  
  
        VHCF06J_DATA.CMPNT-SERIAL-NO[UPD-CNT] = VHCF06IW.WHEEL-02-SERIAL-NO;
        VHCF06J_DATA.STOCK-NO[UPD-CNT] = VHCF06IW.WHEEL-02-STOCK-NO;
        VHCF06J_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
        VHCF06J_DATA.PARENT-SERIAL-NO[UPD-CNT] = VHCF06IW.AXLE-SERIAL-NO;
        VHCF06J_DATA.PARENT-STOCK-NO[UPD-CNT] = VHCF06IW.AXLE-STOCK-NO;
  
  
  
        VHCF06J_DATA.POSN-CD[UPD-CNT] = "N";
        VHCF06J_DATA.MEASUREMENT-1[UPD-CNT] = VHCF06IW.FLANGE-02-MEASUREMENT;
        VHCF06J_DATA.GEO-DATA-NAME-1[UPD-CNT] = "WHEEL FLNG FNGR";
        VHCF06J_DATA.MEASUREMENT-2[UPD-CNT] = VHCF06IW.DIAMETER-02-MEASUREMENT;
        VHCF06J_DATA.GEO-DATA-NAME-2[UPD-CNT] = "WHEEL DIAMETER";
        VHCF06IW-PASSVALUE.FINAL-COUNTER = UPD-CNT;
        UPD-CNT = UPD-CNT + 1;
    end
    VHCF06J_DATA.S-REC-CNT = VHCF06IW-PASSVALUE.FINAL-COUNTER;
    VHCF06J_CRIT.JOB-NO = VHCF06IW-PASSVALUE.JOB-NO;
    VHCF06F_CRIT.SUB-JOB-DOC-NO = VHCF06IW-PASSVALUE.SUB-JOB-DOC-NO;
    VHCF06J_CRIT.CAR-NO = VHCF06IW.CAR-NO;
    VHCF06J_CRIT.HOME-YRD = VHCF06IW.HOME-YRD;
    if (VHCF06IW-PASSVALUE.FINAL-COUNTER > 0)
        try
            call "VHCF06J"(XDCONTROL, VHCF06J_CRIT, VHCF06J_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
            VHCF06IW-MESSAGE.FINAL-MESSAGE = "COMPONENT(S)  ARE UPDATED";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
  
  
    end
    if (VHCF06J_CRIT.DATABASE-SW == "Y")
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "Database error, no Componet are changed";
    end
end 

Function VHCF06IS-UPDATE ()
   
    set VHCF06IW-MESSAGE empty;
    OKAY-TO-RUN = "Y";
  
  
  
    if ((VHCF06IW.GEAR-CHECK-OFF == "1" ||
     VHCF06IW.GEAR-CHECK-ON == "1" ||
     VHCF06IW.AXLE-DATE-CHECK-UPDATE == "1" ||
     VHCF06IW.B-CHECK-OFF == "1" ||
     VHCF06IW.N-CHECK-OFF == "1" ||
     VHCF06IW.B-CHECK-ON == "1" ||
     VHCF06IW.N-CHECK-ON == "1" ||
     VHCF06IW.WHEEL-01-CHECK-OFF == "1" ||
     VHCF06IW.WHEEL-02-CHECK-OFF == "1" ||
     VHCF06IW.WHEEL-01-CHECK-ON == "1" ||
     VHCF06IW.WHEEL-02-CHECK-ON == "1" ||
     VHCF06IW.WHEEL-01-CHECK-UPDATE == "1" ||
     VHCF06IW.WHEEL-02-CHECK-UPDATE == "1" ||
     VHCF06IW.HUB-DATE-CHECK-UPDATE == "1" ||
     VHCF06IW.GEAR-DATE-REBUILT-UPDATE == "1"))
  
  
  
        if ((VHCF06IW.WHEEL-01-CHECK-OFF == "1" && VHCF06IW.WHEEL-01-CHECK-UPDATE == "1"))
            OKAY-TO-RUN = "N";
            VHCF06IW-MESSAGE.FINAL-MESSAGE = "YOU HAVE UPDATE AND OFF BOX BOTH CHECKED, PLEASE ONLY CHECK UPDATE OR OFF";
        end
        if ((VHCF06IW.WHEEL-02-CHECK-OFF == "1" && VHCF06IW.WHEEL-02-CHECK-UPDATE == "1"))
            VHCF06IW-MESSAGE.FINAL-MESSAGE = "YOU HAVE UPDATE AND OFF BOX BOTH CHECKED, PLEASE ONLY CHECK UPDATE OR OFF";
            OKAY-TO-RUN = "N";
        end
        if (OKAY-TO-RUN == "Y")
            VHCF06IS-PRE-UPD();
            if (VHCF06IW.AXLE-SERIAL-NO != " ")
                VHCF06IS-VALD-AXLE();
                if (VHCF06IW-TRIGGER.ERROR-FLAG != "Y")
                    VHCF06IS-UPD-AXLE();
                end
            else
                if (VHCF06IW.GEAR-SERIAL-NO != " ")
                    VHCF06IS-VALD-GEAR();
                    if (VHCF06IW-TRIGGER.ERROR-FLAG != "Y")
                        VHCF06IS-UPD-GEAR();
                    end
                end
            end
        end 
    else
        VHCF06IW-MESSAGE.FINAL-MESSAGE = "PLEASE CHECK AT LEAST ONE BOX, NO BOXES WERE CHECKED";
        OKAY-TO-RUN = "N";
    end
    if (OKAY-TO-RUN == "Y" && VHCF06IW-TRIGGER.ERROR-FLAG != "Y")
        VHCF06IW-TRIGGER.DISABLE-UPDATE = "Y";
        VHCF06IW-TRIGGER.LIST-DISABLE = "Y";
    end
end 

Function VHCF06IS-UPEXCP ()
   
    set VHCF06L_DATA empty;
    VHCF06L_DATA.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
  
  
    VHCF06L_DATA.CAR-NO = VHCF06A_DATA.CAR-NO[1];
    VHCF06L_DATA.HOME-YRD = VHCF06A_DATA.HOME-YRD[1];
    VHCF06L_DATA.CMPNT-EQUIP-TYPE = "AXLE";
    VHCF06L_DATA.CMPNT-SERIAL-NO = VHCF06A_DATA.CMPNT-SERIAL-NO[1];
    VHCF06L_DATA.STOCK-NO = VHCF06A_DATA.STOCK-NOX[1];
    VHCF06L_DATA.POSN-CD = VHCF06A_DATA.POSN-CD[1];
    VHCF06L_DATA.SERIAL-STAT = VHCF06A_DATA.SERIAL-STAT[1];
    VHCF06L_DATA.EXCEPT-TEXT = VHCF06IW-MESSAGE.MESSAGE-A7;
    try
        call "VHCF06L"(XDCONTROL, VHCF06L_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

