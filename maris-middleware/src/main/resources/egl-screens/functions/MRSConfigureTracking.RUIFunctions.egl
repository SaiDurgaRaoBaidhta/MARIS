    if (VHCF01IW-01.ACTION-DATA == "AXLE, MOTOR, DISC - SERIAL ON")
        if (VHCF01IW-FLAG.TM-04-IN-TABLE != "Y")
            VHCF01IW-MSG.AXLE-MSG-1 = "TM Serial number ";
            VHCF01IW-MSG.AXLE-MSG-2 = VHCF01IW.TM-SERIAL-04;
            VHCF01IW-MSG.AXLE-MSG-3 = "must already exist";
            VHCF01IW-MSG.FINAL-MESSAGE = VHCF01IW-MSG.AXLE-MSG;
            ERROR-CNT = 1;
            VHCF01IS-EXP-TM();
        end
    end
end 

Function VHCF01IS-V-TRUCK () 
    VHCF01IW-FLAG.INVALID-IND = "N";
    VHCF01IW-FLAG.TRUCK-X-IN-TABLE = "N";
    VHCF01IW-FLAG.TRUCK-Y-IN-TABLE = "N";
    if (VHCF01IW.X-TRUCK-SERIAL == VHCF01IW.Y-TRUCK-SERIAL)
        VHCF01IW-MSG.FINAL-MESSAGE = "Truck X  serial is same as Truck Y.   Serial #s can not be the same.";
        INVALID-IND = "Y";
    else
        if (VHCF01IW.X-TRUCK-SERIAL == VHCF01IW-SAVE.SAVE-X-TRUCK-SER && VHCF01IW-SAVE.SAVE-X-TRUCK-SER != "A-EXCEPT")
            VHCF01IW-FLAG.TRUCK-X-IN-TABLE = "Y";
            VHCF01IW-SAVE.SAVE-X-TRUCK-SER = "A-EXCEPT";
            VHCF01IW-FLAG.CMPNT-STAT = "SURV";
            VHCF01IS-EXP-TRKX();
        else
            VHCF01D_CRIT.SERIAL-NO = VHCF01IW.X-TRUCK-SERIAL;
            VHCF01D_CRIT.CMPNT-EQUIP-TYPE = "TRUCK";
            VHCF01D_CRIT.POSN-CD = "X";
            VHCF01IS-CK-SER();
            if (SERIAL-LOCATED == "SRP")
                VHCF01IW-MSG.FINAL-MESSAGE = "Truck X  serial has been scrapped.  Please re-enter the Serial #.";
                INVALID-IND = "Y";
            else
                if (SERIAL-LOCATED == "CAR")
                    VHCF01IW-MSG.FINAL-MESSAGE = "Truck X  serial is on another car.  Press update to continue or re-enter the Serial #.";
                    SAVE-X-TRUCK-SER = VHCF01IW.X-TRUCK-SERIAL;
                    SV-X-STOCK-NO = VHCF01D_DATA.STOCK-NO;
                    INVALID-IND = "Y";
                else
                    if (SERIAL-LOCATED == "DB")
                        SV-X-STOCK-NO = VHCF01D_DATA.STOCK-NO;
                        VHCF01IW-FLAG.TRUCK-X-IN-TABLE = "Y";
                    end
                end
            end
        end
        if (VHCF01IW-FLAG.INVALID-IND == "N")
            if (VHCF01IW.Y-TRUCK-SERIAL == VHCF01IW-SAVE.SAVE-Y-TRUCK-SER && VHCF01IW-SAVE.SAVE-Y-TRUCK-SER != "A-EXCEPT")
                VHCF01IW-FLAG.TRUCK-Y-IN-TABLE = "Y";
                VHCF01IW-SAVE.SAVE-Y-TRUCK-SER = "A-EXCEPT";
                VHCF01IW-FLAG.CMPNT-STAT = "SURV";
                VHCF01IS-EXP-TRKY();
            else
                VHCF01D_CRIT.SERIAL-NO = VHCF01IW.Y-TRUCK-SERIAL;
                VHCF01D_CRIT.CMPNT-EQUIP-TYPE = "TRUCK";
                VHCF01D_CRIT.POSN-CD = "Y";
                VHCF01IS-CK-SER();
                if (SERIAL-LOCATED == "SRP")
                    VHCF01IW-MSG.FINAL-MESSAGE = "Truck Y  serial has been scrapped.  Please re-enter the Serial #.";
                    INVALID-IND = "Y";
                else
                    if (SERIAL-LOCATED == "CAR")
                        VHCF01IW-MSG.FINAL-MESSAGE = "Truck Y  serial is on another car.  Press update to continue or re-enter the Serial #.";
                        SAVE-Y-TRUCK-SER = VHCF01IW.Y-TRUCK-SERIAL;
                        INVALID-IND = "Y";
                    else
                        if (SERIAL-LOCATED == "DB")
                            SV-Y-STOCK-NO = VHCF01D_DATA.STOCK-NO;
                            VHCF01IW-FLAG.TRUCK-Y-IN-TABLE = "Y";
                        end
                    end
                end
            end
        end
    end
end 

Function VHCF01IS-V-WHEEL () 
