    VHCF01IW.TIME-CONFIG-UPDX = VHCF01B_DATA.TIME-CONFIG-UPD[X];
    VHCF01IW.TERM-CONFIG-UPD = VHCF01B_DATA.TERM-CONFIG-UPD[X];
    while (VHCF01IW-CNT.X <= VHCF01IW-CNT.NUM-OF-ROW)
        if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "TRUCK")
            if (VHCF01B_DATA.POSN-CD[X] == "X")
                VHCF01IW.X-TRUCK-SERIAL = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                VHCF01IW.X-TRUCK-STOCK = VHCF01B_DATA.STOCK-NO[X];
            else
                VHCF01IW.Y-TRUCK-SERIAL = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                VHCF01IW.Y-TRUCK-STOCK = VHCF01B_DATA.STOCK-NO[X];
            end
        else
            if (VHCF01B_DATA.CMPNT-EQUIP-TYPE[X] == "AXLE")
                if (VHCF01B_DATA.POSN-CD[X] == "1 ")
                    VHCF01IW.AXLE-SERIAL-01 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                    VHCF01IW.AXLE-STOCK-01 = VHCF01B_DATA.STOCK-NO[X];
                    VHCF01IW-03.AXLE-PARENT-STOCK-01 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                    VHCF01IW-03.AXLE-PARENT-SERIAL-01 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
                    VHCF01IW-03.AXLE-PARENT-POSN-01 = VHCF01B_DATA.PARENT-POSN-CD[X];
                    VHCF01IW-03.AXLE-CMPNT-CUM-HR-01 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                else
                    if (VHCF01B_DATA.POSN-CD[X] == "2 ")
                        VHCF01IW.AXLE-SERIAL-02 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                        VHCF01IW.AXLE-STOCK-02 = VHCF01B_DATA.STOCK-NO[X];
                        VHCF01IW-03.AXLE-PARENT-STOCK-02 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                        VHCF01IW-03.AXLE-PARENT-SERIAL-02 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
                        VHCF01IW-03.AXLE-PARENT-POSN-02 = VHCF01B_DATA.PARENT-POSN-CD[X];
                        VHCF01IW-03.AXLE-CMPNT-CUM-HR-02 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                    else
                        if (VHCF01B_DATA.POSN-CD[X] == "3 ")
                            VHCF01IW.AXLE-SERIAL-03 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                            VHCF01IW.AXLE-STOCK-03 = VHCF01B_DATA.STOCK-NO[X];
                            VHCF01IW-03.AXLE-PARENT-STOCK-03 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                            VHCF01IW-03.AXLE-PARENT-SERIAL-03 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
                            VHCF01IW-03.AXLE-PARENT-POSN-03 = VHCF01B_DATA.PARENT-POSN-CD[X];
                            VHCF01IW-03.AXLE-CMPNT-CUM-HR-03 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                        else
                            VHCF01IW.AXLE-SERIAL-04 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                            VHCF01IW.AXLE-STOCK-04 = VHCF01B_DATA.STOCK-NO[X];
                            VHCF01IW-03.AXLE-PARENT-STOCK-04 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                            VHCF01IW-03.AXLE-PARENT-SERIAL-04 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
