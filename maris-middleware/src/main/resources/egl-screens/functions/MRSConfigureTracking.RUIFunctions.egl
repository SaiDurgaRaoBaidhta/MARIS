    end
    if (ERROR-CNT == 0)
        if (VHCF01IW.DISC-SERIAL-01 == "  ")
            ERROR-CNT = ERROR-CNT + 1;
            ERROR-MESSAGE-OCCR[ERROR-CNT] = "-DISC#1 serial is blank @ ";
        end
        if (VHCF01IW.DISC-SERIAL-02 == "  ")
