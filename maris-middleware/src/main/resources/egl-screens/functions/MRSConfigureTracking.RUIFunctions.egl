    VHCF01F_CRIT_Y.K1-IND1 = "N";
    VHCF01F_CRIT_Y.K2-IND1 = "N";
          
    if (VHCF01IW-SAVE.CAR-TYPE == "K1")
        VHCF01F_CRIT_Y.K1-IND1 = "Y";
