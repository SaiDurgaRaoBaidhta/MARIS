Function VHCF01IS-CLICK () 
    if (SER-PARM == "TRUCK1" && VHCF01IW.X-TRUCK-SERIAL != " ")
        if (TRUCK1-CLICK == 1)
            TRUCK1-CLICK = 2;
            TRUCK1-COLOR = "GRAY";
            TRUCK-ENABLE-X();
        else
            TRUCK1-CLICK = 1;
            TRUCK1-COLOR = "YELLOW";
            TRUCK-DISABLE-X();
        end
    else
        if (SER-PARM == "TRUCK2" && VHCF01IW.Y-TRUCK-SERIAL != " ")
            if (TRUCK2-CLICK == 1)
                TRUCK2-CLICK = 2;
                TRUCK2-COLOR = "GRAY";
                TRUCK-ENABLE-Y();
            else
                TRUCK2-CLICK = 1;
                TRUCK2-COLOR = "YELLOW";
                TRUCK-DISABLE-Y();
            end
        end
    end
    if (SER-PARM == "AXLE1" && VHCF01IW.AXLE-SERIAL-01 != " ")
        if (AXLE1-CLICK == 1)
            AXLE1-CLICK = 2;
            AXLE1-COLOR = "GRAY";
        else
            AXLE1-CLICK = 1;
            AXLE1-COLOR = "YELLOW";
        end
    else
        if (SER-PARM == "AXLE2" && VHCF01IW.AXLE-SERIAL-02 != " ")
            if (AXLE2-CLICK == 1)
                AXLE2-CLICK = 2;
                AXLE2-COLOR = "GRAY";
            else
                AXLE2-CLICK = 1;
                AXLE2-COLOR = "YELLOW";
            end
        else
            if (SER-PARM == "AXLE3" && VHCF01IW.AXLE-SERIAL-03 != " ")
                if (AXLE3-CLICK == 1)
                    AXLE3-CLICK = 2;
                    AXLE3-COLOR = "GRAY";
                else
                    AXLE3-CLICK = 1;
                    AXLE3-COLOR = "YELLOW";
                end
            else
                if (SER-PARM == "AXLE4" && VHCF01IW.AXLE-SERIAL-04 != " ")
                    if (AXLE4-CLICK == 1)
                        AXLE4-CLICK = 2;
                        AXLE4-COLOR = "GRAY";
                    else
                        AXLE4-CLICK = 1;
                        AXLE4-COLOR = "YELLOW";
                    end
                else
                    if (SER-PARM == "DISC1" && VHCF01IW.DISC-SERIAL-01 != " ")
                        if (DISC1-CLICK == 1)
                            DISC1-CLICK = 2;
                            DISC1-COLOR = "GRAY";
                        else
                            DISC1-CLICK = 1;
                            DISC1-COLOR = "YELLOW";
                        end
                    else
                        if (SER-PARM == "DISC2" && VHCF01IW.DISC-SERIAL-02 != " ")
                            if (DISC2-CLICK == 1)
                                DISC2-CLICK = 2;
                                DISC2-COLOR = "GRAY";
                            else
                                DISC2-CLICK = 1;
                                DISC2-COLOR = "YELLOW";
                            end
                        else
                            if (SER-PARM == "DISC3" && VHCF01IW.DISC-SERIAL-03 != " ")
                                if (DISC3-CLICK == 1)
                                    DISC3-CLICK = 2;
                                    DISC3-COLOR = "GRAY";
                                else
                                    DISC3-CLICK = 1;
                                    DISC3-COLOR = "YELLOW";
                                end
                            else
                                if (SER-PARM == "DISC4" && VHCF01IW.DISC-SERIAL-04 != " ")
                                    if (DISC4-CLICK == 1)
                                        DISC4-CLICK = 2;
                                        DISC4-COLOR = "GRAY";
                                    else
                                        DISC4-CLICK = 1;
                                        DISC4-COLOR = "YELLOW";
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if (SER-PARM == "TM1" && VHCF01IW.TM-SERIAL-01 != " ")
        if (TM1-CLICK == 1)
            TM1-CLICK = 2;
            TM1-COLOR = "GRAY";
        else
            TM1-CLICK = 1;
            TM1-COLOR = "YELLOW";
        end
    else
        if (SER-PARM == "TM2" && VHCF01IW.TM-SERIAL-02 != " ")
            if (TM2-CLICK == 1)
                TM2-COLOR = "GRAY";
                TM2-CLICK = 2;
            else
                TM2-CLICK = 1;
                TM2-COLOR = "YELLOW";
            end
        else
            if (SER-PARM == "TM3" && VHCF01IW.TM-SERIAL-03 != " ")
                if (TM3-CLICK == 1)
                    TM3-CLICK = 2;
                    TM3-COLOR = "GRAY";
                else
                    TM3-CLICK = 1;
                    TM3-COLOR = "YELLOW";
                end
            else
                if (SER-PARM == "TM4" && VHCF01IW.TM-SERIAL-04 != " ")
                    if (TM4-CLICK == 1)
                        TM4-COLOR = "GRAY";
                        TM4-CLICK = 2;
                    else
                        TM4-CLICK = 1;
                        TM4-COLOR = "YELLOW";
                    end
                end
            end
        end
    end
    VHCF01IW-FLAG.ENABLE-UPDATE = "Y";
end 

Function VHCF01IS-DISC () 
    VHCF01C_CRIT.CMPNT-SERIAL-NO = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
    VHCF01C_CRIT.CMPNT-STOCK-NO = VHCF01B_DATA.STOCK-NO[X];
    VHCF01C_CRIT.PART-DESC = "DISC";
    VHCF01IS-G-DETAIL();

  
    if (VHCF01B_DATA.POSN-CD[X] == "1 ")
        VHCF01IW.DISC-SERIAL-01 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
        VHCF01IW.DISC-STOCK-01 = VHCF01B_DATA.STOCK-NO[X];
        VHCF01IW-03.DISC-PARENT-STOCK-01 = VHCF01B_DATA.PARENT-STOCK-NO[X];
        VHCF01IW-03.DISC-PARENT-SERIAL-01 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
        VHCF01IW-03.DISC-PARENT-POSN-01 = VHCF01B_DATA.PARENT-POSN-CD[X];
        VHCF01IW-03.DISC-CMPNT-CUM-HR-01 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
        VHCF01IW.DISC-1-WALL = VHCF01C_DATA.WALL;
        VHCF01IW.DISC-1-OVERALL = VHCF01C_DATA.OVERALL;
        VHCF01IW.DISC-1-ANVIL = VHCF01C_DATA.ANVIL;
        VHCF01IW.DISC-1-PISTON = VHCF01C_DATA.PISTON;
    else
        if (VHCF01B_DATA.POSN-CD[X] == "2 ")
            VHCF01IW.DISC-SERIAL-02 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
            VHCF01IW.DISC-STOCK-02 = VHCF01B_DATA.STOCK-NO[X];
            VHCF01IW-03.DISC-PARENT-STOCK-02 = VHCF01B_DATA.PARENT-STOCK-NO[X];
            VHCF01IW-03.DISC-PARENT-SERIAL-02 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
            VHCF01IW-03.DISC-PARENT-POSN-02 = VHCF01B_DATA.PARENT-POSN-CD[X];
            VHCF01IW-03.DISC-CMPNT-CUM-HR-02 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
            VHCF01IW.DISC-2-WALL = VHCF01C_DATA.WALL;
            VHCF01IW.DISC-2-OVERALL = VHCF01C_DATA.OVERALL;
            VHCF01IW.DISC-2-ANVIL = VHCF01C_DATA.ANVIL;
            VHCF01IW.DISC-2-PISTON = VHCF01C_DATA.PISTON;
        else
            if (VHCF01B_DATA.POSN-CD[X] == "3 ")
                VHCF01IW.DISC-SERIAL-03 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                VHCF01IW.DISC-STOCK-03 = VHCF01B_DATA.STOCK-NO[X];
                VHCF01IW-03.DISC-PARENT-STOCK-03 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                VHCF01IW-03.DISC-PARENT-SERIAL-03 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
                VHCF01IW-03.DISC-PARENT-POSN-03 = VHCF01B_DATA.PARENT-POSN-CD[X];
                VHCF01IW-03.DISC-CMPNT-CUM-HR-03 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                VHCF01IW.DISC-3-WALL = VHCF01C_DATA.WALL;
                VHCF01IW.DISC-3-OVERALL = VHCF01C_DATA.OVERALL;
                VHCF01IW.DISC-3-ANVIL = VHCF01C_DATA.ANVIL;
                VHCF01IW.DISC-3-PISTON = VHCF01C_DATA.PISTON;
            else
                if (VHCF01B_DATA.POSN-CD[X] == "4 ")
                    VHCF01IW.DISC-SERIAL-04 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                    VHCF01IW.DISC-STOCK-04 = VHCF01B_DATA.STOCK-NO[X];
                    VHCF01IW-03.DISC-PARENT-STOCK-04 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                    VHCF01IW-03.DISC-PARENT-SERIAL-04 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
                    VHCF01IW-03.DISC-PARENT-POSN-04 = VHCF01B_DATA.PARENT-POSN-CD[X];
                    VHCF01IW-03.DISC-CMPNT-CUM-HR-04 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                    VHCF01IW.DISC-4-WALL = VHCF01C_DATA.WALL;
                    VHCF01IW.DISC-4-OVERALL = VHCF01C_DATA.OVERALL;
                    VHCF01IW.DISC-4-ANVIL = VHCF01C_DATA.ANVIL;
                    VHCF01IW.DISC-4-PISTON = VHCF01C_DATA.PISTON;
                end
            end
        end
    end
end 

Function VHCF01IS-EMP-NO () 
    VHCF01IW-PASSVALUE.SAME-EMPL = "N";
    VHCF01IW-CNT.X = 1;
    VHCF01IW-CNT.Y = 2;
    while (VHCF01IW-CNT.Y <= VHCF01B_CRIT.COUNTER)
        if (VHCF01B_DATA.EMPL-NO[X] != VHCF01B_DATA.EMPL-NO[Y])
            VHCF01IW.EMPL-NOX = " ";
            VHCF01IW.EMPL-NO = " ";
            VHCF01IW.LOC-IDX = 0;
            VHCF01IW-PASSVALUE.SAME-EMPL = "Y";
            VHCF01IW-CNT.Y = VHCF01B_CRIT.COUNTER;
        end
        VHCF01IW-CNT.X = VHCF01IW-CNT.X + 1;
        VHCF01IW-CNT.Y = VHCF01IW-CNT.Y + 1;
    end
    if (VHCF01IW-PASSVALUE.SAME-EMPL != "Y")
        if (VHCF01IW.EMPL-NO == " ")
            VHCF01IW.EMPL-NO = VHCF01B_DATA.EMPL-NO[X];
            VHCF01IW.EMPL-NOX = VHCF01IW.EMPL-NO;
        end
        if (VHCF01IW.LOC == " ")
            VHCF01IW.LOC = VHCF01B_DATA.SHOP-LOC[X];
            VHCF01IW.LOCX = VHCF01IW.LOC;
        end
        if (VHCF01B_DATA.SHOP-LOC[X] == "CY")
            VHCF01IW.LOC-IDX = 1;
        end
        if (VHCF01B_DATA.SHOP-LOC[X] == "DY")
            VHCF01IW.LOC-IDX = 2;
        end
        if (VHCF01B_DATA.SHOP-LOC[X] == "HY")
            VHCF01IW.LOC-IDX = 3;
        end
        if (VHCF01B_DATA.SHOP-LOC[X] == "RY")
            VHCF01IW.LOC-IDX = 4;
        end
    end
end 

Function VHCF01IS-EMP-NOX () 
    VHCF01IW.EMPL-NO = VHCF01B_DATA.FINAL-EMPL-NO;
    VHCF01IW.EMPL-NOX = VHCF01IW.EMPL-NO;
    if (VHCF01IW.LOC == " ")
        VHCF01IW.LOC = VHCF01B_DATA.FINAL-SHOP-LOC;
        VHCF01IW.LOCX = VHCF01IW.LOC;
    end
    if (VHCF01B_DATA.FINAL-SHOP-LOC == "CY")
        VHCF01IW.LOC-IDX = 1;
    end
    if (VHCF01B_DATA.FINAL-SHOP-LOC == "DY")
        VHCF01IW.LOC-IDX = 2;
    end
    if (VHCF01B_DATA.FINAL-SHOP-LOC == "HY")
        VHCF01IW.LOC-IDX = 3;
    end
    if (VHCF01B_DATA.FINAL-SHOP-LOC == "RY")
        VHCF01IW.LOC-IDX = 4;
    end
end 

Function VHCF01IS-EXP () 
    if (VHCF01IW-SV2.EQ-PARM == "AXLE1")
        VHCF01Q_DATA.POSN-CD[1] = "1";
    else
        if (VHCF01IW-SV2.EQ-PARM == "AXLE2")
            VHCF01Q_DATA.POSN-CD[1] = "2";
        else
            if (VHCF01IW-SV2.EQ-PARM == "AXLE3") 
                VHCF01Q_DATA.POSN-CD[1] = "3";
            else
                if (VHCF01IW-SV2.EQ-PARM == "AXLE4")
                    VHCF01Q_DATA.POSN-CD[1] = "4";
                     
                end
            end
        end
    end
    VHCF01IW-MSG.AXLE-EXCP-MSG = " ";
    VHCF01Q_DATA.EXCEPT-TYPE[1] = "AXLENOTSEC";
    VHCF01Q_DATA.EXCEPT-STAT[1] = "ACTIVE";
    VHCF01Q_DATA.CAR-NO[1] = VHCF01IW-01.CAR-NO;
    VHCF01Q_DATA.HOME-YRD[1] = VHCF01IW-SAVE.HOME-YRD;
    VHCF01Q_DATA.CMPNT-EQUIP-TYPE[1] = "AXLE";
    VHCF01Q_DATA.STOCK-NO[1] = VHCF01D_DATA.STOCK-NO;
    VHCF01Q_DATA.CMPNT-SERIAL-NO[1] = VHCF01D_CRIT.SERIAL-NO;
  
    VHCF01Q_DATA.SERIAL-STAT[1] = VHCF01D_DATA.SERIAL-STAT;
    VHCF01Q_DATA.EMPL-NO[1] = VHCF01IW.EMPL-NO;
    VHCF01Q_DATA.SHOP-LOC[1] = VHCF01IW.LOC;
    VHCF01Q_DATA.CONFIG-CMPNT-STAT[1] = " ";
    VHCF01IW-MSG.EXCP-MSG-1 = "Axle Serial number ";
    VHCF01IW-MSG.EXCP-MSG-2 = VHCF01D_CRIT.SERIAL-NO;
    VHCF01IW-MSG.EXCP-MSG-3 = "was not added to car ";
    VHCF01IW-MSG.EXCP-MSG-4 = VHCF01IW-01.CAR-NO;
    VHCF01IW-MSG.EXCP-MSG-5 = ", position ";
    VHCF01IW-MSG.EXCP-MSG-6 = VHCF01IW-MSG.AXLE-MSG-01-6;
    VHCF01IW-MSG.EXCP-MSG-6 = VHCF01Q_DATA.POSN-CD[1];
  
  
    VHCF01Q_DATA.EXCEP-TEXT[1] = VHCF01IW-MSG.AXLE-EXCP-MSG;
    VHCF01Q_DATA.TERM-LAST-UPD[1] = VHCF01IW-PASSVALUE.TERM-LAST-UPD;


  
    VHCF01Q_DATA.REC-CNT = 1;
    try
        call "VHCF01Q"(XDCONTROL, VHCF01Q_CRIT, VHCF01Q_DATA);
    
    end
end 

