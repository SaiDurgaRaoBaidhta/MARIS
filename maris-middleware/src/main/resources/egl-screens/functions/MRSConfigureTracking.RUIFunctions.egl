            else
                if (VHCF01IW.AXLE-SERIAL-03 == VHCF01IW-SAVE.SV-AXLE-SER-02 && VHCF01IW-SAVE.SV-AXLE-SER-03 != "A-EXCEPT")
                    VHCF01IW-FLAG.AXLE-03-IN-TABLE = "Y";
                    VHCF01IW-SAVE.SV-AXLE-SER-03 = "A-EXCEPT";
                    VHCF01IW-FLAG.CMPNT-STAT = "SURV";
                    VHCF01Q_DATA.MSG-02A = "is on another truck.  ";
                    VHCF01IS-EXP-AX03();
                else
                    VHCF01IS-V-AXLE3();
                end
            end
        end
    end
    if (VHCF01IW-01.ACTION-DATA != "TRUCK,AXLE, MOTOR, DISC - SERIAL ON" || VHCF01IW-SV2.EQ-PARM == "AXLE4")
        if (VHCF01IW-FLAG.INVALID-IND == "N")
            if (VHCF01IW.AXLE-SERIAL-04 == VHCF01IW-SAVE.SAVE-AXLE-SER-04 && VHCF01IW-SAVE.SAVE-AXLE-SER-04 != "A-EXCEPT")
                VHCF01IW-FLAG.AXLE-04-IN-TABLE = "Y";
                VHCF01IW-SAVE.SAVE-AXLE-SER-04 = "A-EXCEPT";
                VHCF01IW-FLAG.CMPNT-STAT = "SURV";
                VHCF01Q_DATA.MSG-02A = "is on another car.  ";
                VHCF01IS-EXP-AX04();
            else
                if (VHCF01IW.AXLE-SERIAL-04 == VHCF01IW-SAVE.SV-AXLE-SER-04 && VHCF01IW-SAVE.SV-AXLE-SER-04 != "A-EXCEPT")
                    VHCF01IW-FLAG.AXLE-04-IN-TABLE = "Y";
                    VHCF01IW-SAVE.SV-AXLE-SER-04 = "A-EXCEPT";
                    VHCF01IW-FLAG.CMPNT-STAT = "SURV";
                    VHCF01Q_DATA.MSG-02A = "is on another truck.  ";
                    VHCF01IS-EXP-AX04();
                else
                    VHCF01IS-V-AXLE4();
                end
            end
        end
    end
end 

