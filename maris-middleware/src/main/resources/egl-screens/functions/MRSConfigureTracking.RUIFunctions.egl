                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        X = X + 1;
    end
end 

Function VHCF01IS-MOVE-MSG () 
    ERROR-LOOP-INDEX = 1;
    FINAL-INDEX = 0;
    FINAL-ERROR-MSG = " ";
    TEMP-ERROR-MSG = " ";
    VHCF01IW-FLAG2.ERROR-SETFOCUS = "Y";
    if (ERROR-CNT > 0)
        while (((ERROR-LOOP-INDEX <= 10) &&
         (ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX] != " ")))
            CHAR-CNT = 1;
            TEMP-ERROR-MSG = ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX];
            while ((CHAR-CNT < 90))
                if (TEMP-MSG[CHAR-CNT] != "@")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = TEMP-MSG[CHAR-CNT];
                else
                    if (TEMP-MSG[CHAR-CNT] == "@")
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = ",";
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = " ";
                        CHAR-CNT = 82;
                    end
                end
                CHAR-CNT = CHAR-CNT + 1;
            end
            ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
        end
        if (FINAL-INDEX != 0)
            FINAL-INDEX = FINAL-INDEX - 1;
            FINAL-MSG[FINAL-INDEX] = " ";
            move FINAL-ERROR-MSG to FINAL-MESSAGE withV60Compat;
        end
    end
end 

Function VHCF01IS-MVE-TRK () 
    move VHCF01W_DATA.DATA_ROW to VHCF01B_DATA.DATA_ROW[1] for all;
end 

Function VHCF01IS-OFF () 
    VHCF01IS-SV-DATA();
    if (VHCF01IW-SV2.SV2-CNT > 1)
        move VHCF01IW-SV2.DATA_ROW to VHCF01S_DATA.DATA_ROW[1] for all;
        VHCF01S_DATA.S-REC-CNT = VHCF01IW-SV2.SV2-CNT;
        VHCF01S_CRIT.CAR-NO = VHCF01IW-SV2.CAR-NO;
        VHCF01S_CRIT.TERM-LAST-UPD = VHCF01IW-PASSVALUE.TERM-LAST-UPD;
        VHCF01S_CRIT.SHOP-LOC = VHCF01IW.LOC;
        VHCF01S_CRIT.EMPL-NO = VHCF01IW.EMPL-NO;
        VHCF01S_DATA.CURR-SCHD-PM-NO = VHCF01IW-SAVE.CURR-SCHD-PM-NO;
        VHCF01S_DATA.HOME-YRD = VHCF01IW-SAVE.HOME-YRD;
        VHCF01S_CRIT.HOME-YRD = VHCF01A_DATA.HOME-YRD;
        VHCF01S_CRIT.CURRENT-ACTION = "OFF";
        VHCF01S_CRIT.CONFIG-CMPNT-STAT = VHCF01A_DATA.CONFIG-CMPNT-STAT;
        VHCF01S_CRIT.CONFIG-CMPNT-TYPE = VHCF01A_DATA.CONFIG-CMPNT-TYPE;
        try
            call "VHCF01S"(XDCONTROL, VHCF01S_CRIT, VHCF01S_DATA, VHCF01S_DATA_1);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
            VHCF01IS-CLEARX();
  
            VHCF01IS-LIST-ON();
            VHCF01IW-FLAG.DISABLE-UPDATE = "Y";
            VHCF01IW-MSG.FINAL-MESSAGE = "COMPONENT(S) SELECTED ARE REMOVED";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    else
        VHCF01IW-MSG.FINAL-MESSAGE = "No Component is Selected to Remove";
    end
end 

Function VHCF01IS-ON () 
    VHCF01IW-MSG.FINAL-MESSAGE = " ";
    
  
    VHCF01IS-SV-DA2();
    if (VHCF01IW-SV2.SV2-CNT > 0)
        VHCF01T_CRIT.C1-IND2 = "Y";
        VHCF01T_CRIT.C2-IND2 = "Y";
        VHCF01T_CRIT.A2-IND2 = "Y";
        VHCF01T_CRIT.B2-IND2 = "Y";
        VHCF01T_CRIT.D1-IND2 = "Y";
        VHCF01T_CRIT.E1-IND2 = "Y";
        VHCF01T_CRIT.K1-IND2 = "Y";   
        VHCF01T_CRIT.K2-IND2 = "Y"; 
        VHCF01T_CRIT.L1-IND2 = "Y";   
        VHCF01T_CRIT.M1-IND2 = "Y"; 
                      
        VHCF01T_CRIT.C1-IND1 = "N";
        VHCF01T_CRIT.C2-IND1 = "N";
        VHCF01T_CRIT.A2-IND1 = "N";
        VHCF01T_CRIT.B2-IND1 = "N";
        VHCF01T_CRIT.D1-IND1 = "N";
        VHCF01T_CRIT.E1-IND1 = "N";
        VHCF01T_CRIT.K1-IND1 = "N";
        VHCF01T_CRIT.K2-IND1 = "N";    
        VHCF01T_CRIT.L1-IND1 = "N";
        VHCF01T_CRIT.M1-IND1 = "N"; 
                            
        if (VHCF01IW-SAVE.CAR-TYPE == "K1")
            VHCF01T_CRIT.K1-IND1 = "Y";
        else
            if (VHCF01IW-SAVE.CAR-TYPE == "K2")
            	VHCF01T_CRIT.K2-IND1 = "Y";
            else
            	if (VHCF01IW-SAVE.CAR-TYPE == "L1")
			        VHCF01T_CRIT.L1-IND1 = "Y";
			    else
			        if (VHCF01IW-SAVE.CAR-TYPE == "M1")
			          	VHCF01T_CRIT.M1-IND1 = "Y";
			        end	
			    end
            end	
        end
                
        if (VHCF01IW-SAVE.CAR-TYPE == "C1")
            VHCF01T_CRIT.C1-IND1 = "Y";
        else
            if (VHCF01IW-SAVE.CAR-TYPE == "C2")
                VHCF01T_CRIT.C2-IND1 = "Y";
            else
                if (VHCF01IW-SAVE.CAR-TYPE == "A2")
                    VHCF01T_CRIT.A2-IND1 = "Y";
                else
                    if (VHCF01IW-SAVE.CAR-TYPE == "B2")
                        VHCF01T_CRIT.B2-IND1 = "Y";
                    else
                       if (VHCF01IW-SAVE.CAR-TYPE == "D1")
                    		VHCF01T_CRIT.D1-IND1 = "Y";
                       else
                    		if (VHCF01IW-SAVE.CAR-TYPE == "E1")
                        		VHCF01T_CRIT.E1-IND1 = "Y";
                    		end
                       end
                    end
                end
            end
        end
        VHCF01T_CRIT.HOME-YRD = VHCF01IW-SAVE.HOME-YRD;
        VHCF01T_CRIT.CAR-NO = VHCF01IW-01.CAR-NO;
        VHCF01T_CRIT.EMPL-NO = VHCF01IW.EMPL-NO;
        VHCF01T_CRIT.SHOP-LOC = VHCF01IW.LOC;
        VHCF01T_CRIT.CURR-SCHD-PM-NO = VHCF01IW-SAVE.CURR-SCHD-PM-NO;
        VHCF01IW-SV2.T-CNT = 1;
        if (VHCF01IW.EMPL-NO == " " || VHCF01IW.LOC == " ")
            VHCF01IW-MSG.FINAL-MESSAGE = "Employee number or Shop Loc can not be blanck ";
            VHCF01IW-FLAG.EMP-NO-SETFOCUS = "Y";
        else
            while (VHCF01IW-SV2.T-CNT <= VHCF01IW-SV2.SV2-CNT)
                if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
                    VHCF01IW-SV2.EQ-PARM = VHCF01IW-SV2.ON-PARM[T-CNT];
                    if (VHCF01IW-SV2.EQ-PARM-A == "AX")
                        VHCF01IS-V-AXLE();
                        if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
                            VHCF01IS-V-GEAR();
                        end
                        if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
                            VHCF01IS-V-BEAR();
                        end
                        if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
                            VHCF01IS-V-WHEEL2();
                        end
                    else
                        if (VHCF01IW-SV2.EQ-PARM-A == "DI")
                            VHCF01IS-V-DISC();
                        else
                            if (VHCF01IW-SV2.EQ-PARM-A == "TM")
                                if (VHCF01T_CRIT.A2-IND1 == "Y" ||
                                 VHCF01T_CRIT.B2-IND1 == "Y")
                                    VHCF01IS-V-TM0();
                                else
                                    VHCF01IS-V-TM();
                                end
                            end
                        end
                    end
 
                    if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
                        VHCF01IS-BUILD-2();
                    else
                        if (VHCF01IW-FLAG.INVALID-IND == "N")
                            VHCF01IS-MOVE-MSG();
                        end
                    end
                else
                    VHCF01IW-SV2.SV2-CNT = 0;
                end
                VHCF01IW-SV2.T-CNT = VHCF01IW-SV2.T-CNT + 1;
            end
        end
    else
        ERROR-CNT = 1;
        VHCF01IW-MSG.FINAL-MESSAGE = "No data is entered for Serial On. ";
    end
    if (VHCF01IW-FLAG.INVALID-IND == "N" && ERROR-CNT == 0)
        VHCF01T_CRIT_X.SV-CNT = VHCF01IW-SV2.SV2-CNT;
        VHCF01IS-SER-ON-X();
    end
end 

Function VHCF01IS-ON-TRUCK () 
    if (VHCF01IW.EMPL-NO == " " || VHCF01IW.LOC == " ")
        VHCF01IW-MSG.FINAL-MESSAGE = "Employee number or Shop Loc can not be blanck ";
        VHCF01IW-FLAG.EMP-NO-SETFOCUS = "Y";
    else
        if (VHCF01IW-PARM.TRUCK == "X")
            VHCF01IS-VALID-0X();
            if (VHCF01IW-MSG.ERROR-CNT == 0)
                VHCF01IS-BUILD-1X();
                VHCF01IS-CLEARX();
            end
        else
            if (VHCF01IW-PARM.TRUCK == "Y")
                VHCF01IS-VALID-0Y();
                if (VHCF01IW-MSG.ERROR-CNT == 0)
                    VHCF01IS-BUILD-1Y();
                    VHCF01IS-CLEARX();
                end
            end
        end
    end
end 

Function VHCF01IS-PRE-ON () 
    if (VHCF01IW-PARM.TRUCK == " ")
        VHCF01IS-ON();
    else
        VHCF01IS-ON-TRUCK();
    end
end 

Function VHCF01IS-PRINT () 
    VHCF05IW-PASSVALUE.CAR-NO = VHCF01IW-PASSVALUE.CAR-NO;
end 

