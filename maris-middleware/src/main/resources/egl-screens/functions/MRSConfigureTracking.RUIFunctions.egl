    VHCF06IW-SAVE.AXLE-REBUILT-DATE = VHCF06IW.AXLE-REBUILT-DATE;
    VHCF06IW-SAVE.AXLE-HUB-COUP-REPL-DATE = VHCF06IW.AXLE-HUB-COUP-REPL-DATE;
