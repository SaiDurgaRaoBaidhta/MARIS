        VHCF01IW-SV2.CMPNT-EQUIP-TYPE[SV2-CNT] = "TRACTION MOTOR";
        VHCF01IW-SV2.POSN-CD[SV2-CNT] = "4 ";
        VHCF01IW-SV2.STOCK-NO[SV2-CNT] = VHCF01IW.TM-STOCK-04;
        VHCF01IW-SV2.PARENT-STOCK-NO[SV2-CNT] = VHCF01IW-03.TM-PARENT-STOCK-04;
        VHCF01IW-SV2.PARENT-SERIAL-NO[SV2-CNT] = VHCF01IW-03.TM-PARENT-SERIAL-04;
        VHCF01IW-SV2.PARENT-POSN-CD[SV2-CNT] = VHCF01IW-03.TM-PARENT-POSN-04;
        VHCF01IW-SV2.CMPNT-CUM-HRS[SV2-CNT] = VHCF01IW-03.TM-CMPNT-CUM-HR-04;
        VHCF01IW-SV2.SV2-CNT = VHCF01IW-SV2.SV2-CNT + 1;
    end
    VHCF01IW-SV2.CAR-NO = VHCF01IW-01.CAR-NO;
end 

Function VHCF01IS-TM () 
    VHCF01C_CRIT.CMPNT-SERIAL-NO = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
    VHCF01C_CRIT.CMPNT-STOCK-NO = VHCF01B_DATA.STOCK-NO[X];
    VHCF01C_CRIT.PART-DESC = "TM";
    VHCF01IS-G-DETAIL();
    VHCF01C_DATA.DC-READING-TIR-A = VHCF01C_DATA.DC-READING-TIR-A * 1000;
    VHCF01C_DATA.DC-READING-TIR-B = VHCF01C_DATA.DC-READING-TIR-B * 1000;
    VHCF01C_DATA.DC-READING-TIR-C = VHCF01C_DATA.DC-READING-TIR-C * 1000;
    VHCF01C_DATA.DC-READING-MTBT-A = VHCF01C_DATA.DC-READING-MTBT-A * 1000;
    VHCF01C_DATA.DC-READING-MTBT-B = VHCF01C_DATA.DC-READING-MTBT-B * 1000;
    VHCF01C_DATA.DC-READING-MTBT-C = VHCF01C_DATA.DC-READING-MTBT-C * 1000;

  
    if (VHCF01B_DATA.POSN-CD[X] == "1 ")
        VHCF01IW.TM-SERIAL-01 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
        VHCF01IW.TM-STOCK-01 = VHCF01B_DATA.STOCK-NO[X];
        VHCF01IW-03.TM-PARENT-STOCK-01 = VHCF01B_DATA.PARENT-STOCK-NO[X];
        VHCF01IW-03.TM-PARENT-SERIAL-01 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
        VHCF01IW-03.TM-PARENT-POSN-01 = VHCF01B_DATA.PARENT-POSN-CD[X];
        VHCF01IW-03.TM-CMPNT-CUM-HR-01 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
        VHCF01IW.DC-READING-TIR-1A = VHCF01C_DATA.DC-READING-TIR-A;
        VHCF01IW.DC-READING-TIR-1B = VHCF01C_DATA.DC-READING-TIR-B;
        VHCF01IW.DC-READING-TIR-1C = VHCF01C_DATA.DC-READING-TIR-C;
        VHCF01IW.DC-READING-MTBT-1A = VHCF01C_DATA.DC-READING-MTBT-A;
        VHCF01IW.DC-READING-MTBT-1B = VHCF01C_DATA.DC-READING-MTBT-B;
        VHCF01IW.DC-READING-MTBT-1C = VHCF01C_DATA.DC-READING-MTBT-C;
    else
        if (VHCF01B_DATA.POSN-CD[X] == "2 ")
            VHCF01IW.TM-SERIAL-02 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
            VHCF01IW.TM-STOCK-02 = VHCF01B_DATA.STOCK-NO[X];
            VHCF01IW-03.TM-PARENT-STOCK-02 = VHCF01B_DATA.PARENT-STOCK-NO[X];
            VHCF01IW-03.TM-PARENT-SERIAL-02 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
            VHCF01IW-03.TM-PARENT-POSN-02 = VHCF01B_DATA.PARENT-POSN-CD[X];
            VHCF01IW-03.TM-CMPNT-CUM-HR-02 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
            VHCF01IW.DC-READING-TIR-2A = VHCF01C_DATA.DC-READING-TIR-A;
            VHCF01IW.DC-READING-TIR-2B = VHCF01C_DATA.DC-READING-TIR-B;
            VHCF01IW.DC-READING-TIR-2C = VHCF01C_DATA.DC-READING-TIR-C;
            VHCF01IW.DC-READING-MTBT-2A = VHCF01C_DATA.DC-READING-MTBT-A;
            VHCF01IW.DC-READING-MTBT-2B = VHCF01C_DATA.DC-READING-MTBT-B;
            VHCF01IW.DC-READING-MTBT-2C = VHCF01C_DATA.DC-READING-MTBT-C;
        else
            if (VHCF01B_DATA.POSN-CD[X] == "3 ")
                VHCF01IW.TM-SERIAL-03 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                VHCF01IW.TM-STOCK-03 = VHCF01B_DATA.STOCK-NO[X];
                VHCF01IW-03.TM-PARENT-STOCK-03 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                VHCF01IW-03.TM-PARENT-SERIAL-03 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
                VHCF01IW-03.TM-PARENT-POSN-03 = VHCF01B_DATA.PARENT-POSN-CD[X];
                VHCF01IW-03.TM-CMPNT-CUM-HR-03 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                VHCF01IW.DC-READING-TIR-3A = VHCF01C_DATA.DC-READING-TIR-A;
                VHCF01IW.DC-READING-TIR-3B = VHCF01C_DATA.DC-READING-TIR-B;
                VHCF01IW.DC-READING-TIR-3C = VHCF01C_DATA.DC-READING-TIR-C;
                VHCF01IW.DC-READING-MTBT-3A = VHCF01C_DATA.DC-READING-MTBT-A;
                VHCF01IW.DC-READING-MTBT-3B = VHCF01C_DATA.DC-READING-MTBT-B;
                VHCF01IW.DC-READING-MTBT-3C = VHCF01C_DATA.DC-READING-MTBT-C;
            else
                VHCF01IW.TM-SERIAL-04 = VHCF01B_DATA.CMPNT-SERIAL-NO[X];
                VHCF01IW.TM-STOCK-04 = VHCF01B_DATA.STOCK-NO[X];
                VHCF01IW-03.TM-PARENT-STOCK-04 = VHCF01B_DATA.PARENT-STOCK-NO[X];
                VHCF01IW-03.TM-PARENT-SERIAL-04 = VHCF01B_DATA.PARENT-SERIAL-NO[X];
                VHCF01IW-03.TM-PARENT-POSN-04 = VHCF01B_DATA.PARENT-POSN-CD[X];
                VHCF01IW-03.TM-CMPNT-CUM-HR-04 = VHCF01B_DATA.CMPNT-CUM-HRS[X];
                VHCF01IW.DC-READING-TIR-4A = VHCF01C_DATA.DC-READING-TIR-A;
                VHCF01IW.DC-READING-TIR-4B = VHCF01C_DATA.DC-READING-TIR-B;
                VHCF01IW.DC-READING-TIR-4C = VHCF01C_DATA.DC-READING-TIR-C;
                VHCF01IW.DC-READING-MTBT-4A = VHCF01C_DATA.DC-READING-MTBT-A;
                VHCF01IW.DC-READING-MTBT-4B = VHCF01C_DATA.DC-READING-MTBT-B;
                VHCF01IW.DC-READING-MTBT-4C = VHCF01C_DATA.DC-READING-MTBT-C;
            end
        end
    end
end 

Function VHCF01IS-TRUCK () 
    if (VHCF01IW-PARM.TRUCK == "X")
        if (VHCF01IW.X-TRUCK-SERIAL != " ")
            VHCF01W_CRIT.CMPNT-SERIAL-NO = VHCF01IW.X-TRUCK-SERIAL;
            try
                call "VHCF01W"(XDCONTROL, VHCF01W_CRIT, VHCF01W_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHCF01IW-FLAG.TRUCK-IS-FOUND = "Y";
                NUM-OF-ROW = XDCONTROL.UROWCNT;
                if ((VHCF01W_CRIT.TRUCK-STOCK-NO == "173588520" ||
                 VHCF01W_CRIT.TRUCK-STOCK-NO == "193588603" ||
                 VHCF01W_CRIT.TRUCK-STOCK-NO == "203588610") ||
                 (VHCF01W_CRIT.PREV-TRK-STOCK-NO == "173588520" ||
                 VHCF01W_CRIT.PREV-TRK-STOCK-NO == "193588603" ||
                 VHCF01W_CRIT.PREV-TRK-STOCK-NO == "203588610"))
                    VHCF01IS-MVE-TRK();
                    VHCF01IS-M-DATA();
                    VHCF01IS-AXLE1();
                    VHCF01IS-AXLE2();
                    ENABLE-UPDATE = "Y";
                else
                    VHCF01IW-MSG.FINAL-MESSAGE = "THE TRUCK SERIAL NO IS NOT VALID FOR X TRUCK";
                    VHCF01IS-CLEAR-X();
                    DISABLE-UPDATE = "Y";
                end
            end
        end
    else
        if (VHCF01IW-PARM.TRUCK == "Y")
            if (VHCF01IW.Y-TRUCK-SERIAL != " ")
                VHCF01W_CRIT.CMPNT-SERIAL-NO = VHCF01IW.Y-TRUCK-SERIAL;
                try
                    call "VHCF01W"(XDCONTROL, VHCF01W_CRIT, VHCF01W_DATA);
                
                end
                VHCF01IS-MVE-TRK();
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    VHCF01IW-FLAG.TRUCK-IS-FOUND = "Y";
                    NUM-OF-ROW = XDCONTROL.UROWCNT;
                    if (VHCF01W_CRIT.TRUCK-STOCK-NO == "173588515" ||
                     VHCF01W_CRIT.TRUCK-STOCK-NO == "173588525" ||
                     VHCF01W_CRIT.TRUCK-STOCK-NO == "193588618" ||
                     VHCF01W_CRIT.TRUCK-STOCK-NO == "203588611")
                        VHCF01IS-MVE-TRK();
                        VHCF01IS-M-DATA();
                        VHCF01IS-AXLE1();
                        VHCF01IS-AXLE2();
                        ENABLE-UPDATE = "Y";
                    else
                        VHCF01IW-MSG.FINAL-MESSAGE = "THE TRUCK SERIAL NO IS NOT VALID FOR Y TRUCK";
                        VHCF01IS-CLEAR-Y();
                        DISABLE-UPDATE = "Y";
                    end
                else
                    if (XDCONTROL.URC == 100)
                        VHCF01IW-FLAG.TRUCK-IS-FOUND = "N";
                    else
                        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                        return;
                    end
                end
            end
        end
    end
end 

Function VHCF01IS-U-VEH () 
    VHCF01V_CRIT.CAR-NO = VHCF01IW-01.CAR-NO;
    VHCF01V_CRIT.TERM-LAST-UPD = VHCF01IW-PASSVALUE.TERM-LAST-UPD;
    try
        call "VHCF01V"(XDCONTROL, VHCF01V_CRIT, VHCF01V_DATA);
    
    end
end 

Function VHCF01IS-UPDATE () 
    set VHCF01IW-MSG empty;
    ERROR-CNT = 0;

  
  
    if (VHCF01IW.EMPL-NO == " " || VHCF01IW.LOC == " ")
        VHCF01IW-MSG.FINAL-MESSAGE = "PLEASE ENTER EMPLOYEE NO AND/OR  LOCATION";
    else
        if ((VHCF01IW-01.ACTION-DATA == "NO ACTION SELECTED" && TRUCK-IS-FOUND == "N") ||
         (VHCF01IW-01.ACTION-DATA == "        " && TRUCK-IS-FOUND == "N"))
  
            VHCF01IS-ADD();
        else
            if (VHCF01IW-01.ACTION-DATA == "NO ACTION SELECTED" && TRUCK-IS-FOUND == "Y")
                VHCF01IW-MSG.FINAL-MESSAGE = "CAR already has its components.  Please select another action option to update";
                VHCF01IW-FLAG.DISABLE-UPDATE = "Y";
            else
                if (VHCF01IW-01.ACTION-DATA == "TRUCK,AXLE, MOTOR, DISC - SERIAL OFF")
                    VHCF01IS-OFF();
                else
                    if (VHCF01IW-01.ACTION-DATA == "TRUCK,AXLE, MOTOR, DISC - SERIAL ON")
                        VHCF01IS-PRE-ON();
                    else
                        if (VHCF01IW-01.ACTION-DATA == "GEOMETRY DATA")
                            VHCF01IS-GEO();
                        end
                    end
                end
            end
        end
    end
end 

Function VHCF01IS-V-AXLE () 
    VHCF01IW-FLAG.INVALID-IND = "N";
  
  
  
  
    if ((VHCF01IW.AXLE-SERIAL-01 == "  " || VHCF01IW.AXLE-SERIAL-02 == "  " || VHCF01IW.AXLE-SERIAL-03 == "  " || VHCF01IW.AXLE-SERIAL-04 == "  ") &&
     (VHCF01IW-01.ACTION-DATA == "NO ACTION SELECTED" || VHCF01IW-01.ACTION-DATA == "  "))
        VHCF01IW-FLAG.INVALID-IND = "Y";
        VHCF01IW-MSG.FINAL-MESSAGE = "AXLE Serial #s can not be blank. Please double check. ";
    else
        if (((VHCF01IW.AXLE-SERIAL-01 == VHCF01IW.AXLE-SERIAL-02 && VHCF01IW.AXLE-SERIAL-01 != "   ") || (VHCF01IW.AXLE-SERIAL-01 == VHCF01IW.AXLE-SERIAL-03 && VHCF01IW.AXLE-SERIAL-01 != "   ") || (VHCF01IW.AXLE-SERIAL-01 == VHCF01IW.AXLE-SERIAL-04 && VHCF01IW.AXLE-SERIAL-01 != "    ") || (VHCF01IW.AXLE-SERIAL-02 == VHCF01IW.AXLE-SERIAL-03 && VHCF01IW.AXLE-SERIAL-02 != "    ") || (VHCF01IW.AXLE-SERIAL-02 == VHCF01IW.AXLE-SERIAL-04 && VHCF01IW.AXLE-SERIAL-02 != "   ") || (VHCF01IW.AXLE-SERIAL-03 == VHCF01IW.AXLE-SERIAL-04 && VHCF01IW.AXLE-SERIAL-03 != "   ")))
            VHCF01IW-FLAG.INVALID-IND = "Y";
            VHCF01IW-MSG.FINAL-MESSAGE = "AXLE Serial #s can not be the same.  Please double check. ";
        else
            VHCF01IS-V2-AXLE();
        end
    end
end 

Function VHCF01IS-V-AXLE1 () 
    if (VHCF01IW-SV2.EQ-PARM == "AXLE1")
        VHCF01IS-G-GEO();
        if (VHCF01IW.FLANGE-1 < VHCF01P_DATA.FLANGE-VALID-FROM ||
         VHCF01IW.FLANGE-1 > VHCF01P_DATA.FLANGE-VALID-TO)
            ERROR-CNT = ERROR-CNT + 1;
            ER-SER-NO[ERROR-CNT] = "WHEEL # 01";
            VHCF01IW-MSG.WHEELX-MSG-1 = "-Flange out of range: (";
            VHCF01IW-PASSVALUE.VALID-FROM-X = VHCF01P_DATA.FLANGE-VALID-FROM;
            VHCF01IW-PASSVALUE.VALID-TO-X = VHCF01P_DATA.FLANGE-VALID-TO;
            WHEELX-MSG-2 = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-2- = ".";
            WHEELX-MSG-2X = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-3 = " - ";
            VHCF01IW-MSG.WHEELX-MSG-4 = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-4- = ".";
            VHCF01IW-MSG.WHEELX-MSG-4X = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-5 = ") @";
            ER-DESC[ERROR-CNT] = VHCF01IW-MSG.WHEELX-MSG;
            
  
        end
        if (VHCF01IW.FLANGE-2 < VHCF01P_DATA.FLANGE-VALID-FROM ||
         VHCF01IW.FLANGE-2 > VHCF01P_DATA.FLANGE-VALID-TO)
            ERROR-CNT = ERROR-CNT + 1;
            ER-SER-NO[ERROR-CNT] = "WHEEL # 02";
            VHCF01IW-MSG.WHEELX-MSG-1 = "-Flange out of range: (";
            VHCF01IW-PASSVALUE.VALID-FROM-X = VHCF01P_DATA.FLANGE-VALID-FROM;
            VHCF01IW-PASSVALUE.VALID-TO-X = VHCF01P_DATA.FLANGE-VALID-TO;
            WHEELX-MSG-2 = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-2- = ".";
            WHEELX-MSG-2X = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-3 = " - ";
            VHCF01IW-MSG.WHEELX-MSG-4 = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-4- = ".";
            VHCF01IW-MSG.WHEELX-MSG-4X = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-5 = ") @";
            ER-DESC[ERROR-CNT] = VHCF01IW-MSG.WHEELX-MSG;
            
  
        end

  
  
  
  
  
  

  
  
  
  
  
  
        if (VHCF01IW.DIAMETER-1 < VHCF01P_DATA.DIAMETER-VALID-FROM ||
         VHCF01IW.DIAMETER-1 > VHCF01P_DATA.DIAMETER-VALID-TO)
            ERROR-CNT = ERROR-CNT + 1;
            ER-SER-NO[ERROR-CNT] = "WHEEL # 01";
            VHCF01IW-MSG.WHEELX-MSG-1 = "-Diameter out of range: (";
            VHCF01IW-PASSVALUE.VALID-FROM-X = VHCF01P_DATA.DIAMETER-VALID-FROM;
            VHCF01IW-PASSVALUE.VALID-TO-X = VHCF01P_DATA.DIAMETER-VALID-TO;
            WHEELX-MSG-2 = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-2- = ".";
            WHEELX-MSG-2X = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-3 = " - ";
            VHCF01IW-MSG.WHEELX-MSG-4 = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-4- = ".";
            VHCF01IW-MSG.WHEELX-MSG-4X = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-5 = ") @";
            ER-DESC[ERROR-CNT] = VHCF01IW-MSG.WHEELX-MSG;
            
  
        end
        if (VHCF01IW.DIAMETER-2 < VHCF01P_DATA.DIAMETER-VALID-FROM ||
         VHCF01IW.DIAMETER-2 > VHCF01P_DATA.DIAMETER-VALID-TO)
            ERROR-CNT = ERROR-CNT + 1;
            ER-SER-NO[ERROR-CNT] = "WHEEL # 02";
            VHCF01IW-MSG.WHEELX-MSG-1 = "-Diameter out of range: (";
            VHCF01IW-PASSVALUE.VALID-FROM-X = VHCF01P_DATA.DIAMETER-VALID-FROM;
            VHCF01IW-PASSVALUE.VALID-TO-X = VHCF01P_DATA.DIAMETER-VALID-TO;
            WHEELX-MSG-2 = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-2- = ".";
            WHEELX-MSG-2X = VHCF01IW-PASSVALUE.VALID-FROM-X;
            VHCF01IW-MSG.WHEELX-MSG-3 = " - ";
            VHCF01IW-MSG.WHEELX-MSG-4 = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-4- = ".";
            VHCF01IW-MSG.WHEELX-MSG-4X = VHCF01IW-PASSVALUE.VALID-TO-X;
            VHCF01IW-MSG.WHEELX-MSG-5 = ") @";
            ER-DESC[ERROR-CNT] = VHCF01IW-MSG.WHEELX-MSG;
            
  
        end

  
  
  
  
  
  


  
  
  
  
  
  
    end
    VHCF01D_CRIT.SERIAL-NO = VHCF01IW.AXLE-SERIAL-01;
    VHCF01D_CRIT.CMPNT-EQUIP-TYPE = "AXLE";
    VHCF01D_DATA.AXLE-SERIAL-NO = "  ";
    VHCF01D_CRIT.POSN-CD = "1";
    VHCF01IS-CK-SER();
    if (VHCF01IW-01.ACTION-DATA == "AXLE, MOTOR, DISC - SERIAL ON")
        VHCF01IS-CK-SEC();
    end
    if (VHCF01IW.CONTINUE-CAR-AXLE01 == "Y" &&
     VHCF01IW.AXLE-SERIAL-01 == VHCF01IW-SAVEX.AXLE-SERIAL-01)
        return;
    else
        VHCF01IW-SAVE.SV-AXLE-01-STOCK-NO = VHCF01D_DATA.STOCK-NO;
        VHCF01D_DATA.STOCK-NO = "  ";
        VHCF01IW-SAVE.DATE-BUILD-01 = VHCF01D_DATA.DATE-BUILD;
        if (SERIAL-LOCATED == "SRP")
            VHCF01IW-MSG.FINAL-MESSAGE = "AXLE#1 serial has been scrapped.  Please re-enter the Serial #.";
            INVALID-IND = "Y";
        else
            if (SERIAL-LOCATED == "CAR")
                VHCF01IW.SERIAL-LOCATED-AXLE01 = "CAR";
                VHCF01IW.CONTINUE-CAR-AXLE01 = "Y";
                VHCF01IW-FLAG.AXLE-01-IN-TABLE = "Y";
                VHCF01IW-SAVE.SAVE-AXLE-SER-01 = VHCF01IW.AXLE-SERIAL-01;
                VHCF01IW-SAVEX.AXLE-SERIAL-01 = VHCF01IW.AXLE-SERIAL-01;
                VHCF01IW-MSG.MSG-01 = "SERIAL#:";
                VHCF01IW-MSG.SERIAL-NO = VHCF01IW.AXLE-SERIAL-01;
                VHCF01IW-MSG.MSG-02 = "-AXLE #1 is on anther car.  Do you want to continue (Press Update again to continue)";
                INVALID-IND = "Y";
                VHCF01F_CRIT_X.EXCEP-CAR-NO-AXLE-1 = VHCF01D_DATA.CAR-NO;
                VHCF01T_CRIT_X.EXCEP-CAR-NO-AXLE-1 = VHCF01D_DATA.CAR-NO;
            else
                if (SERIAL-LOCATED == "DB")
                    if (VHCF01D_DATA.PARENT-SERIAL-NO == "  ")
                        VHCF01IW-FLAG.AXLE-01-IN-TABLE = "Y";
                    else
                        if (VHCF01D_DATA.PARENT-SERIAL-NO != VHCF01IW.X-TRUCK-SERIAL ||
                         VHCF01D_DATA.PARENT-STOCK-NO != VHCF01IW-SAVE.SV-X-STOCK-NO)
                            SV-AXLE-SER-01 = VHCF01IW.AXLE-SERIAL-01;
                            VHCF01IW-MSG.MSG-01 = "SERIAL#:";
                            VHCF01IW-MSG.SERIAL-NO = VHCF01IW.AXLE-SERIAL-01;
                            VHCF01IW-MSG.MSG-02 = "-AXLE #1 is on anther truck.  Do you want to continue (Press Update again to continue)";
                            INVALID-IND = "Y";
                        else
                            VHCF01IW-FLAG.AXLE-01-IN-TABLE = "Y";
                        end
                    end
                else
                    if (SERIAL-LOCATED == "NO")
                        if (VHCF01D_DATA.AXLE-SERIAL-NO == "   ")
                            VHCF01IW-FLAG.AXLE-01-MISSING-CON = "Y";
                            VHCF01IW-FLAG.CMPNT-STAT = "AXLE";
                            VHCF01Q_DATA.MSG-02A = "is missing it's configuration data. ";
