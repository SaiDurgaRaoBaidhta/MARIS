        VHCF01F_CRIT_X.CAR-NO = VHCF01IW-01.CAR-NO;
        VHCF01F_CRIT_X.EMPL-NO = VHCF01IW.EMPL-NO;
        VHCF01F_CRIT_X.SHOP-LOC = VHCF01IW.LOC;
