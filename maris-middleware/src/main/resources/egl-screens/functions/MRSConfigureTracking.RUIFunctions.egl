Function VHCF01IS-EXP-BEAR () 
    if ((VHCF01Q_DATA.TEMP-POSN-CD == "1 " && VHCF01IW.EXCEPT-AXLE01 != "Y") ||
     (VHCF01Q_DATA.TEMP-POSN-CD == "2 " && VHCF01IW.EXCEPT-AXLE02 != "Y") ||
     (VHCF01Q_DATA.TEMP-POSN-CD == "3 " && VHCF01IW.EXCEPT-AXLE03 != "Y") ||
     (VHCF01Q_DATA.TEMP-POSN-CD == "4 " && VHCF01IW.EXCEPT-AXLE04 != "Y"))
        VHCF01Q_DATA.REC-CNT = VHCF01Q_DATA.REC-CNT + 1;
        VHCF01Q_DATA.EXCEPT-TYPE[REC-CNT] = "SURVEY-ADD";
        VHCF01Q_DATA.EXCEPT-STAT[REC-CNT] = "ACTIVE";
        VHCF01Q_DATA.CAR-NO[REC-CNT] = VHCF01IW-01.CAR-NO;
        VHCF01Q_DATA.HOME-YRD[REC-CNT] = VHCF01IW-SAVE.HOME-YRD;
        VHCF01Q_DATA.CMPNT-EQUIP-TYPE[REC-CNT] = "BEARING";
        VHCF01Q_DATA.STOCK-NO[REC-CNT] = "     ";
        VHCF01Q_DATA.CMPNT-SERIAL-NO[REC-CNT] = VHCF01N_DATA.CMPNT-SERIAL-NO;
        VHCF01Q_DATA.POSN-CD[REC-CNT] = VHCF01Q_DATA.TEMP-POSN-CD;
        VHCF01Q_DATA.SERIAL-STAT[REC-CNT] = VHCF01D_DATA.SERIAL-STAT;
        VHCF01Q_DATA.EMPL-NO[REC-CNT] = VHCF01IW.EMPL-NO;
        VHCF01Q_DATA.SHOP-LOC[REC-CNT] = VHCF01IW.LOC;
        VHCF01Q_DATA.CONFIG-CMPNT-STAT[REC-CNT] = "SURVEY";
        VHCF01Q_DATA.TERM-LAST-UPD[REC-CNT] = "VHCF01Q";
        VHCF01Q_DATA.EXCEPT-TEXT[REC-CNT] = VHCF01Q_DATA.MSG-ALL-A;
    end
end 

