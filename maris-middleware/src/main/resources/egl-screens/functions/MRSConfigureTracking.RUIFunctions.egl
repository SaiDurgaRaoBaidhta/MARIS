        VHCF01F_CRIT_X.WHEEL-POSN-CD-TO = "4 ";
        VHCF01F_CRIT_X.GEAR-POSN-CD-FR = "1 ";
        VHCF01F_CRIT_X.GEAR-POSN-CD-TO = "2 ";
        VHCF01F_CRIT_X.BEAR-POSN-CD-FR = "1 ";
        VHCF01F_CRIT_X.BEAR-POSN-CD-TO = "4 ";
