    DISABLE-FIELDS = "Y";
    DISABLE-NARR-DET = "Y";
    DISABLE-PREV-DET = "Y";
    DISABLE-PREV = "Y";
    DISABLE-NEXT = "Y";
    DISABLE-ADDREPR = "Y";
    DISABLE-ADDNARR = "Y";
    DISABLE-CLOSEINCD = "Y";
    VHRV03IW.REPR-DOC-NO = 0;
    VHRV03IW.DATE-REPR = " ";
    VHRV03IW.DISP-TIME-REPR = " ";
    VHRV03IW.DISP-CON-DASH = " ";
    VHRV03IW.TEMP-TIME-REPR = " ";
    VHRV03IW-TRIGGER.TEMP-MESSAGE = " ";
