Function VHINC01IS-CLRAFTDB () 
    VHINC01IW.DISCV-DUR = "1";
    VHINC01IW.INCD-NO = " ";
    VHINC01IW.DASH-NO-CHAR = " ";
    VHINC01IW.CON-DASH-FILLER = " ";
    VHINC01IW.CONSIST-NO = " ";
    VHINC01IW.SYMP-CD = " ";
    VHINC01IW.DATE-INCD-OCCR = " ";
    VHINC01IW.TIME-INCD-OCCR = " ";
    VHINC01IW.SPEED = " ";
    VHINC01IW.CON-DIRECTION = " ";
    VHINC01IW.INCD-LOC = " ";
    VHINC01IW.NARR-NO = 1;
    VHINC01IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHINC01IW.TIME-NARR = VGVar.currentFormattedTime;
    VHINC01IW.TIME-NARR-FILLER-1 = ":";
    VHINC01IW.TIME-NARR-FILLER-2 = " ";
    VHINC01IW.DISP-TIME-INCD-OCCR = " ";
    VHINC01IW.INCD-NARR = " ";

  
    set VHINC1D_CRIT empty;
    set VHINC1D_DATA empty;
    VHINC01IW.USER-GRP = VHINC01IW.STORE-USER-GRP;
    

  
  
  
  
  
    VHINC01IS-REV-TIME();
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        TEMP-DATE = VHXREVC_DATA.REVENUE-DATE;
        VHINC01IW.DATE-INCD-OCCR = TEMP-DATE;
        VHINC01IW.DATE-FILLER-1 = "-";
        VHINC01IW.DATE-FILLER-2 = "-";
        VHINC01IW.TIME-INCD-OCCR = VGVar.currentFormattedTime;
        VHINC01IW.TIME-INCD-OCCR-FILLER-1 = ":";
        VHINC01IW.TIME-INCD-OCCR-FILLER-2 = " ";
        DISP-TIME-INCD-OCCR-HR = VHINC01IW.TIME-INCD-OCCR-HR;
        DISP-TIME-INCD-OCCR-MIN = VHINC01IW.TIME-INCD-OCCR-MIN;
        VHXREVA_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    else

    end
    DISABLE-PREV = "Y";
    DISABLE-NEXT = "Y";
    if (CHECK-ENTRY == 1) 
        DISABLE-ADDNARR = "Y";
        ENABLE-INCDNARR = "Y";
        DISABLE-INCDNO = "Y";
        ENABLE-SYMPCD = "Y";
        ENABLE-SPEED = "Y";
        ENABLE-CONDIRECTION = "Y";
        ENABLE-INCDLOC = "Y";
        ENABLE-FIELDS = "Y";
        ENABLE-INCDDET = "Y";
        VHINC01IW.NARR-NO = 1;
        VHINC01IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
        VHINC01IW.TIME-NARR = VGVar.currentFormattedTime;
        VHINC01IW.TIME-NARR-FILLER-1 = ":";
        VHINC01IW.TIME-NARR-FILLER-2 = " ";
        ENABLE-CREATE = "Y";
        DISABLE-CHANGE = "Y";
        BUTTON-CAPTION = "Create";
        CONNO-SETFOCUS = "Y";
    else
        if (CHECK-ENTRY == 2) 
            DISABLE-INCDDET = "Y";
            ENABLE-INCDNO = "Y";
            DISABLE-FIELDS = "Y";
            DISABLE-SYMPCD = "Y";
            DISABLE-SPEED = "Y";
            DISABLE-CONDIRECTION = "Y";
            DISABLE-INCDLOC = "Y";
            DISABLE-ADDNARR = "Y";
            DISABLE-CREATE = "Y";
            DISABLE-CHANGE = "Y";
            BUTTON-CAPTION = "Change";
            INCDNO-SETFOCUS = "Y";
        end
    end
end 

