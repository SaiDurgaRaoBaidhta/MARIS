    VHINC08IW-TRIGGER.SUCCESS-MESSAGE = " ";
    VHINC08IW.INCD-NO = " ";
    VHINC08IW.CAR-NO = " ";
    VHINC08IW.SYMP-CD = " ";

  
    try
        call "VHINCXA"(XDCONTROL, VHINCXA_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else

    end
    VHINC08IW.DATE-INCD-OCCR = " ";
    VHINC08IW.TIME-INCD-OCCR = " ";
    VHINC08IW.DISP-TIME-INCD-OCCR = " ";
    VHINC08IW.INCD-LOC = " ";
    VHINC08IW.INCD-NARR = " ";
  

  
    set VHINC1D_CRIT empty;
    set VHINC1D_DATA empty;
    set VHINCY_DATA empty;
    VHINCY_DATA.INCD-NO = " ";
end 

Function VHINC08IS-CLRAFTDB () 
    VHINC08IW.INCD-NO = " ";
    VHINC08IW.CAR-NO = " ";
    VHINC08IW.SYMP-CD = " ";

  
    try
        call "VHINCXA"(XDCONTROL, VHINCXA_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else

    end
