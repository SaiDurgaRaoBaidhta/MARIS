Function VHINC06IS-DATE-CHK () 
    if (JULIAN-DATE-1-CCYY == JULIAN-DATE-2-CCYY)
        if (JULIAN-DATE-2-DDD > JULIAN-DATE-1-DDD)
            ERROR-COUNT = ERROR-COUNT + 1;
            DISP-ERR-MSG = "Y";
             
        else
            JULIAN-DAYS-DIFF = JULIAN-DATE-1 - JULIAN-DATE-2;
            if (JULIAN-DAYS-DIFF > 5)
                ERROR-COUNT = ERROR-COUNT + 1;
                DAYS-GR-05 = "Y";
            end
        end
    else
        if (JULIAN-DATE-1-CCYY > JULIAN-DATE-2-CCYY)
            JULIAN-DATE-YR-DIFF = JULIAN-DATE-1-CCYY - JULIAN-DATE-2-CCYY;
        else
            JULIAN-DATE-YR-DIFF = JULIAN-DATE-2-CCYY - JULIAN-DATE-1-CCYY;
        end
        if (JULIAN-DATE-YR-DIFF > 1)
            ERROR-COUNT = ERROR-COUNT + 1;
            DAYS-GR-05 = "Y";
        else
      
            if (JULIAN-DATE-1-CCYY > JULIAN-DATE-2-CCYY)
                JULIAN-DATE-QUOT = JULIAN-DATE-2-CCYY / 4;
                JULIAN-DATE-REM = JULIAN-DATE-2-CCYY - (JULIAN-DATE-QUOT * 4);
                if (JULIAN-DATE-REM > 0)
                    JULIAN-DATE-1-DDD = JULIAN-DATE-1-DDD + 365;
                else
                    JULIAN-DATE-1-DDD = JULIAN-DATE-1-DDD + 366;
                end
                JULIAN-DAYS-DIFF = JULIAN-DATE-1-DDD - JULIAN-DATE-2-DDD;
                if (JULIAN-DAYS-DIFF > 5)
                    ERROR-COUNT = ERROR-COUNT + 1;
                    DAYS-GR-05 = "Y";
                end
            else
                ERROR-COUNT = ERROR-COUNT + 1;
                DISP-ERR-MSG = "Y";
                 
            end
        end
    end
end 

Function VHINC06IS-ENTRY () 
    VHINC06IS-CLR-FLDS();
    VHINC06IW.STORE-USER-GRP = VHINC06IW.USER-GRP;
    

  
  
  
  
  
    VHINC01IS-REV-TIME();
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        TEMP-DATE = VHXREVC_DATA.REVENUE-DATE;
        VHINC06IW.DATE-INCD-OCCR = TEMP-DATE;
        VHINC06IW.DATE-FILLER-1 = "-";
        VHINC06IW.DATE-FILLER-2 = "-";
        VHINC06IW.TIME-INCD-OCCR-FILLER-1 = ":";
        VHINC06IW.TIME-INCD-OCCR-FILLER-2 = " ";
        VHXREVA_DATA.SYSTEM-TIME = VHCI02G_CRIT.CURRENT-TIME;
        VHINCE_DATA.SYSTEM-TIME = VHCI02G_CRIT.CURRENT-TIME;
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    DISABLE-PREV = "Y";
    DISABLE-NEXT = "Y";
    ENABLE-INCDDET = "Y";
    DISABLE-ADDNARR = "Y";
    ENABLE-INCDNARR = "Y";
    ENABLE-SYMPCD = "Y";
    ENABLE-SPEED = "Y";
    ENABLE-CONDIRECTION = "Y";
    ENABLE-INCDLOC = "Y";
    ENABLE-FIELDS = "Y";
    VHINC06IW.NARR-NO = 1;
    VHINC06IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHINC06IW.TIME-NARR = VGVar.currentFormattedTime;
    VHINC06IW.TIME-NARR-FILLER-1 = ":";
    VHINC06IW.TIME-NARR-FILLER-2 = " ";
    ENABLE-CREATE = "Y";
    BUTTON-CAPTION = "Create";
    CARNO-SETFOCUS = "Y";
end 

Function VHINC06IS-MOVE-MSG () 
    VHINC06IW.ERROR-LOOP-INDEX = 1;
    VHINC06IW.FINAL-INDEX = 0;
    VHINC06IW.FINAL-ERROR-MSG = " ";
    VHINC06IW-TRIGGER.SUCCESS-MESSAGE = " ";
    VHINC06IW.TEMP-ERROR-MSG = " ";
    if (ERROR-INDEX > 0)
        while (((ERROR-LOOP-INDEX <= 6) &&
         (ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX] != " ")))
            ERROR-INDEX = 1;
            TEMP-ERROR-MSG = ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX];
            while ((ERROR-INDEX <= 40))
                if (TEMP-MSG[ERROR-INDEX] != ".")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = TEMP-MSG[ERROR-INDEX];
                else
                    if (TEMP-MSG[ERROR-INDEX] == ".")
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = ",";
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = " ";
                        ERROR-INDEX = 40;
                    end
                end
                ERROR-INDEX = ERROR-INDEX + 1;
            end
            ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
        end
        FINAL-INDEX = FINAL-INDEX - 1;
        FINAL-MSG[FINAL-INDEX] = " ";
        VHINC06IW-TRIGGER.SUCCESS-MESSAGE = FINAL-ERROR-MSG;
        EXECUTE-SETFOCUS = "Y";
    end
end 

