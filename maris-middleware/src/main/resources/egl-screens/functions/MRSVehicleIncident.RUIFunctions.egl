            VHCI01IW.SCR-VEH-STAT = VHCI01IW-TEMP-MI.NEW-VEH-STAT;
            VHCI01IW.SCR-VEH-STAT-DESC = VHCI01IW-TEMP-MI.NEW-VEH-STAT-DESC;
            if (VHCI01IW-TEMP-MI.INTO-SHOP-UPD == "Y")
                VHCI01IS-SHOP-STAT();
            end
        end
        VHCI01IW.FINAL-ERROR-MESSAGE-1 = "Status of car ";
        VHCI01IW.FINAL-ERROR-MESSAGE-2 = VHCI01IW.CAR-NO;
