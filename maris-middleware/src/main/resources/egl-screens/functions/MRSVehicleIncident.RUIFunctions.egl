    VHINC10IW.CON-NO = VHINC1D_DATA.CON-NO;
    if (VHINC1D_DATA.DASH-NO != 0)
        VHINC10IW.CON-FILLER = "-";
    else
        VHINC10IW.CON-FILLER = " ";
    end
    VHINC10IW.DASH-NO = VHINC1D_DATA.DASH-NO;
    VHINC10IW.INCD-TYPE = VHINC1D_DATA.INCD-TYPE;
    VHINC10IW.SYMP-CD = VHINC1D_DATA.SYMP-CD;
    VHINC10IW.DISCV-DUR = VHINC1D_DATA.DISCV-DUR;
    VHINC10IW.DATE-INCD-OCCR = VHINC1D_DATA.DATE-INCD-OCCR;
    VHINC10IW.TIME-INCD-OCCR = VHINC1D_DATA.TIME-INCD-OCCR;
    VHINC10IW.TIME-INCD-OCCR-FILLER-1 = ":";
    VHINC10IW.TIME-INCD-OCCR-FILLER-2 = " ";
