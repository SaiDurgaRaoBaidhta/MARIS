    ENABLE-ADDNARR = "Y";
    ENABLE-CHANGE = "Y";
    DISABLE-CREATE = "Y";
    SYMPCD-SETFOCUS = "Y";
end 

Function VHINC01IS-MOVE-MSG () 
    VHINC01IW.ERROR-LOOP-INDEX = 1;
    VHINC01IW.FINAL-INDEX = 0;
    VHINC01IW.FINAL-ERROR-MSG = " ";
    VHINC01IW-TRIGGER.SUCCESS-MESSAGE = " ";
    VHINC01IW.TEMP-ERROR-MSG = " ";
    if (ERROR-INDEX > 0)
        while (((ERROR-LOOP-INDEX <= 6) &&
         (ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX] != " ")))
            ERROR-INDEX = 1;
            TEMP-ERROR-MSG = ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX];
            while ((ERROR-INDEX <= 40))
                if (TEMP-MSG[ERROR-INDEX] != ".")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = TEMP-MSG[ERROR-INDEX];
                else
                    if (TEMP-MSG[ERROR-INDEX] == ".")
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = ",";
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = " ";
                        ERROR-INDEX = 40;
                    end
                end
                ERROR-INDEX = ERROR-INDEX + 1;
            end
            ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
        end
        FINAL-INDEX = FINAL-INDEX - 1;
        FINAL-MSG[FINAL-INDEX] = " ";
        VHINC01IW-TRIGGER.SUCCESS-MESSAGE = FINAL-ERROR-MSG;
        EXECUTE-SETFOCUS = "Y";
    end
end 

Function VHINC01IS-MOVE-RE2 () 
    VHINC1F_DATA.CAR-NO = "0095"; 
    VHINC1F_CRIT.CON-NO = VHINC01IW.CONSIST-NO;
    VHINC1F_DATA.CON-NO = VHINC01IW.CONSIST-NO;
    VHINC1F_DATA.DISCV-DUR = "1";
    VHINC1F_DATA.INCD-LOC = VHINC01IW.INCD-LOC;
    VHINC1F_DATA.SYMP-CD = VHINC01IW.SYMP-CD;
    VHINC1F_DATA.CON-DIRECTION = VHINC01IW.CON-DIRECTION;
    VHINC1F_DATA.SPEED = VHINC01IW.SPEED;
    VHINC1F_DATA.TERM-LAST-UPD = VHINC01IW.TERM-LAST-UPD;
    VHINC01IW.TIME-INCD-OCCR-HR = VHINC01IW.DISP-TIME-INCD-OCCR-HR;
    VHINC01IW.TIME-INCD-OCCR-FILLER-1 = ":";
    VHINC01IW.TIME-INCD-OCCR-MIN = VHINC01IW.DISP-TIME-INCD-OCCR-MIN;
    VHINC01IW.TIME-INCD-OCCR-FILLER-2 = ":";
    VHINC01IW.TIME-INCD-OCCR-SEC = "00";
    VHINC1F_DATA.DATE-INCD-OCCR-REV = VHINC01IW.DATE-INCD-OCCR;
    XXDATEW.DATE-MM-DD-YYYY = VHINC01IW.DATE-INCD-OCCR;
    XXDATEW.VAGen_FUNCTION = "YMD";
    MRSCommonCode.XXDATES-CONVERT();
    VHINVC_CRIT.INPUT-DATE = XXDATEW.DATE-YYYY-MM-DD;
    VHINVC_CRIT.INPUT-TIME = VHINC01IW.TIME-INCD-OCCR;
    VHINVC_CRIT.USER-TERM-ID = VHINC01IW.TERM-LAST-UPD;
    try
        call "VHINVC"(XDCONTROL, VHINVC_DATA, VHINVC_CRIT);
    
    end
    VHINC01IW.TIME-INCD-OCCR-FILLER-1 = ":";
    VHINC01IW.TIME-INCD-OCCR-FILLER-2 = ":";
    VHINC1F_DATA.TIME-INCD-OCCR = VHINC01IW.TIME-INCD-OCCR;

  
    VHINC1F_DATA.USER-GRP = VHINC01IW.USER-GRP;
    VHINC1F_DATA.DATE-NARR = VHINC01IW.DATE-NARR;
    VHINC01IW.TIME-NARR-FILLER-1 = ":";
    VHINC01IW.TIME-NARR-FILLER-2 = ":";
    VHINC1F_DATA.TIME-NARR = VHINC01IW.TIME-NARR;
    VHINC1F_DATA.NARR = VHINC01IW.INCD-NARR;
end 

Function VHINC01IS-MOVE-REC () 
    VHINC1F_DATA.CAR-NO = "0095"; 
    VHINC1F_CRIT.CON-NO = VHINC01IW.CONSIST-NO;
    VHINC1F_DATA.CON-NO = VHINC01IW.CONSIST-NO;
    VHINC1F_DATA.DISCV-DUR = "1";
    VHINC1F_DATA.INCD-LOC = VHINC01IW.INCD-LOC;
    VHINC1F_DATA.SYMP-CD = VHINC01IW.SYMP-CD;
    VHINC1F_DATA.CON-DIRECTION = VHINC01IW.CON-DIRECTION;
    VHINC1F_DATA.SPEED = VHINC01IW.SPEED;
    VHINC1F_DATA.TERM-LAST-UPD = VHINC01IW.TERM-LAST-UPD;
    VHINC1F_DATA.DATE-INCD-OCCR-REV = VHINC01IW.TEMP-DATE;

  
  
    VHINCE_CRIT.REVENUE-DATE = VHINC01IW.TEMP-DATE;
    VHINCE_CRIT.REVENUE-TIME-HR = VHINC01IW.DISP-TIME-INCD-OCCR-HR;
    VHINCE_CRIT.REVENUE-TIME-MIN = VHINC01IW.DISP-TIME-INCD-OCCR-MIN;
    VHINCE_CRIT.REVENUE-TIME-SEC = "00";
    VHINCE_CRIT.REVENUE-TIME-FILLER-1 = ":";
    VHINCE_CRIT.REVENUE-TIME-FILLER-2 = ":";
    try
        call "VHINCE"(XDCONTROL, VHINCE_CRIT, VHINCE_DATA);
    
    end
