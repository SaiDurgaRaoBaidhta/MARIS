    VHINCX_DATA.USER-GRP = VHINC06IW.USER-GRP;
    VHINCX_DATA.DATE-NARR = VHINC06IW.DATE-NARR;
    VHINC06IW.TIME-NARR-FILLER-1 = ":";
    VHINC06IW.TIME-NARR-FILLER-2 = ":";
    VHINCX_DATA.TIME-NARR = VHINC06IW.TIME-NARR;
    VHINCX_DATA.NARR = VHINC06IW.INCD-NARR;
