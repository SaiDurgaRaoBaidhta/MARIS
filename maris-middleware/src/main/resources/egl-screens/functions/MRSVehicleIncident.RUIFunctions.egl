    VHINCX_DATA.TERM-LAST-UPD = VHINC06IW.TERM-LAST-UPD;
    VHINCX_DATA.DATE-INCD-OCCR-REV = VHINC06IW.DATE-INCD-OCCR;
    VHINC06IW.TIME-INCD-OCCR-HR = VHINC06IW.DISP-TIME-INCD-OCCR-HR;
    VHINC06IW.TIME-INCD-OCCR-FILLER-1 = ":";
    VHINC06IW.TIME-INCD-OCCR-MIN = VHINC06IW.DISP-TIME-INCD-OCCR-MIN;
    VHINC06IW.TIME-INCD-OCCR-FILLER-2 = ":";
    VHINC06IW.TIME-INCD-OCCR-SEC = "00";
    XXDATEW.DATE-MM-DD-YYYY = VHINC06IW.DATE-INCD-OCCR;
    XXDATEW.VAGen_FUNCTION = "YMD";
    MRSCommonCode.XXDATES-CONVERT();
    VHINVC_CRIT.INPUT-DATE = XXDATEW.DATE-YYYY-MM-DD;
    VHINVC_CRIT.INPUT-TIME = VHINC06IW.TIME-INCD-OCCR;
