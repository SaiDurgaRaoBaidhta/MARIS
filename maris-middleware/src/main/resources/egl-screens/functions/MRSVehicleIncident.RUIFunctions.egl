Function VHINC09IS-MOVE-MSG () 
    VHINC09IW.ERROR-LOOP-INDEX = 1;
    VHINC09IW.FINAL-INDEX = 0;
    VHINC09IW.FINAL-ERROR-MSG = " ";
    VHINC09IW.FINAL-MESSAGE = " ";
    VHINC09IW.TEMP-ERROR-MSG = " ";
    if (ERROR-INDEX > 0)
        while (((ERROR-LOOP-INDEX <= 6) &&
         (ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX] != " ")))
            ERROR-INDEX = 1;
            TEMP-ERROR-MSG = ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX];
            while ((ERROR-INDEX <= 30))
                if (TEMP-MSG[ERROR-INDEX] != ".")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = TEMP-MSG[ERROR-INDEX];
                else
                    if (TEMP-MSG[ERROR-INDEX] == ".")
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = ",";
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = " ";
                        ERROR-INDEX = 30;
                    end
                end
                ERROR-INDEX = ERROR-INDEX + 1;
            end
            ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
        end
        FINAL-INDEX = FINAL-INDEX - 1;
        FINAL-MSG[FINAL-INDEX] = " ";
        VHINC09IW.FINAL-MESSAGE = FINAL-ERROR-MSG;
        EXECUTE-SETFOCUS = "Y";
    end
end 

Function VHINC09IS-NARR-DET () 
    NARR-INDEX = 1;
    VHINC09IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC09IW.TEMP-INCD-NARR = VHINC09IW.INCD-NARR;
    VHINC09IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC09IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC09IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC09IW.TIME-NARR-FILLER-1 = ":";
    VHINC09IW.TIME-NARR-FILLER-2 = ":";
    VHINC09IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
    if (NARR-COUNT > 1)
        DISABLE-PREV = "Y";
        ENABLE-NEXT = "Y";
    else
        DISABLE-PREV = "Y";
        DISABLE-NEXT = "Y";
    end
end 

Function VHINC09IS-PRVNXT () 
    if (BUTTON-CLICK == "PREV")
        VHINC09IW.NARR-INDEX = VHINC09IW.NARR-INDEX - 1;
        if (VHINC09IW.NARR-INDEX <= 1)
            VHINC09IW.NARR-INDEX = 1;
            DISABLE-PREV = "Y";
        else
            ENABLE-PREV = "Y";
        end
        ENABLE-NEXT = "Y";
    else
        if (BUTTON-CLICK == "NEXT")
            VHINC09IW.NARR-INDEX = VHINC09IW.NARR-INDEX + 1;
            ENABLE-PREV = "Y";
            if (VHINC09IW.NARR-INDEX >= VHINC09IW.NARR-COUNT)
                VHINC09IW.NARR-INDEX = VHINC09IW.NARR-COUNT;
                DISABLE-NEXT = "Y";
            else
                ENABLE-NEXT = "Y";
            end
        end
    end
    VHINC09IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC09IW.TEMP-INCD-NARR = VHINC09IW.INCD-NARR;
    VHINC09IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC09IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC09IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC09IW.TIME-NARR-FILLER-1 = ":";
    VHINC09IW.TIME-NARR-FILLER-2 = ":";
    VHINC09IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
end 

Function VHINC09IS-RET-INCD () 
    INCD-MESSAGE = " ";
    FINAL-MESSAGE = " ";

  
    set VHINC1D_CRIT empty;
    set VHINC1D_DATA empty;
    set VHINC9A_DATA empty;
    DISP-DET = " "; 
    VHINC09IW.INCD-NO = VHINC09IW.STORE-INCD-NO;
    if (VHINC09IW.INCD-NO != " ")
        VHINC09IW.NARR-COUNT = 0;
        VHINC1D_CRIT.INCD-NO = VHINC09IW.INCD-NO;
        VHINC1D_CRIT.RET-CHECK = "BOTH";
        try
            call "VHINC1D"(XDCONTROL, VHINC1D_CRIT, VHINC1D_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHINC09IW.NARR-COUNT = XDCONTROL.UROWCNT;
            VHINC09IW.DISP-CUM-HRS = VHINC1D_DATA.CUM-HRS;
            VHINC09IW.DISP-CUM-MIN = VHINC1D_DATA.CUM-MIN;
            if (VHINC1D_DATA.INCD-TYPE == "EVT" ||
             VHINC1D_DATA.INCD-TYPE == "MSC" ||
             VHINC1D_DATA.INCD-TYPE == "REV" ||
             VHINC1D_DATA.INCD-TYPE == "SHN" ||
             VHINC1D_DATA.INCD-TYPE == "SHP" ||
             VHINC1D_DATA.INCD-TYPE == "YRD")
                if (VHINC1D_DATA.CAR-NO == "0095")
                    FINAL-MESSAGE = "Train Incident - use train incident function to Update";
                    ENABLE-INCDNO = "Y";
                    INCDNO-SETFOCUS = "Y";
                else
                    VHINC09IS-INCD-DET();
                end
            else
                if (VHINC09IW.INCD-NO-1 == "H" &&
                 VHINC1D_DATA.VEH-INCD-STAT != "CLO")
                    VHINC09IS-H-INCDS(); 
                else
                    INCD-MESSAGE-1 = "Incident type ";
                    INCD-MESSAGE-2 = VHINC1D_DATA.INCD-TYPE;
                    INCD-MESSAGE-3 = " cannot be changed";
                    move INCD-MESSAGE to FINAL-MESSAGE withV60Compat;
                    INCDNO-SETFOCUS = "Y";
                end
            end
        else
  
            FINAL-MESSAGE = "Incident No not found in the database.";
            INCDNO-SETFOCUS = "Y";
        end
    else
        FINAL-MESSAGE = "Invalid Incident No.";
        INCDNO-SETFOCUS = "Y";
    end
end 

Function VHINC09IS-SETFOCUS () 
    if (INVALID-SYMP-CD == "Y" ||
     INVALID-SYMPCD-VAL == "Y")
        SYMPCD-SETFOCUS = "Y";
    else
        if (VHINC1D_DATA.INCD-TYPE == "REV")
            if (INVALID-SPEED == "Y" ||
             INVALID-SPEED-VAL == "Y") 
                SPEED-SETFOCUS = "Y";
            else
                if (INVALID-DIRECTION == "Y")
                    DIRECTION-SETFOCUS = "Y";
                end
            end
        end
        if (INVALID-DISCV-DUR == "Y") 
            DISCVDUR-SETFOCUS = "Y";
        else
            if (INVALID-INCD-LOC == "Y") 
                LOC-SETFOCUS = "Y";
            else
                if (INVALID-INCD-NARR == "Y")
                    NARR-SETFOCUS = "Y";
                end
            end
        end
    end
end 

Function VHINC09IS-STORE-DB ()
   
    
    VHINC1C_CRIT.NARR-CHG = "N";
    VHINC1C_CRIT.INCD-NO = VHINC09IW.INCD-NO;
    VHINC1C_DATA.SPEED = VHINC09IW.SPEED;
    VHINC1C_DATA.SYMP-CD = VHINC09IW.SYMP-CD;
    VHINC1C_DATA.CON-DIRECTION = VHINC09IW.CON-DIRECTION;
    VHINC1C_DATA.INCD-LOC = VHINC09IW.INCD-LOC;
    VHINC1C_DATA.TERM-LAST-UPD = VHINC09IW.TERM-LAST-UPD;
    VHINC1C_DATA.USER-GRP = VHINC09IW.USER-GRP;
    if (VHINC09IW.TEMP-INCD-NARR != VHINC09IW.INCD-NARR)
        VHINC1C_CRIT.NARR-CHG = "Y";
    else
        VHINC1C_CRIT.NARR-CHG = "N";
    end
    try
        call "VHINC1C"(XDCONTROL, VHINC1C_CRIT, VHINC1C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        FINAL-MESSAGE-1 = "Incident ";
        FINAL-MESSAGE-2 = VHINC09IW.INCD-NO;
        FINAL-MESSAGE-3 = " updated successfully.";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC10IS-AFT-NAR () 
    VHINC10IW.NARR-COUNT = 0;
    VHINC1D_CRIT.INCD-NO = VHINC10IW.INCD-NO;
    VHINC1D_CRIT.RET-CHECK = "NARR";
    try
        call "VHINC1D"(XDCONTROL, VHINC1D_CRIT, VHINC1D_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHINC10IW.NARR-COUNT = XDCONTROL.UROWCNT;
        VHINC10IS-NARR-DET();
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC10IS-CHK-DATA ()
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  

  
  
  
  
  
  
  
  
  
  
  
  
  
  

   
    if (VHINC10IW.VEH-INCD-STAT not blanks)
        VHINC10IS-MOVE(); 
    else
        VHINC10IS-ERROR.STATUS-ERR = "Y";
    end
end 

Function VHINC10IS-CLEAR () 
    VHINC10IS-CLR-FLDS();
    VHINC10IW.USER-GRP = VHINC10IW.PASSVALUE-USER-GRP;


  
  
  
    VHXREVA_CRIT.SEL-IDX = 3;
    try
        call "VHXREVA"(XDCONTROL, VHXREVA_CRIT, VHXREVA_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        TEMP-DATE = VHXREVA_DATA.REVENUE-DATE;
        VHINC10IW.DATE-INCD-OCCR = TEMP-DATE;
        VHINC10IW.DATE-FILLER-1 = "-";
        VHINC10IW.DATE-FILLER-2 = "-";
        VHINC10IW.TIME-INCD-OCCR = VGVar.currentFormattedTime;
        VHINC10IW.TIME-INCD-OCCR-FILLER-1 = ":";
        VHINC10IW.TIME-INCD-OCCR-FILLER-2 = ":";
        VHXREVA_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    else

    end
    DISABLE-PREV = "Y";
    DISABLE-NEXT = "Y";
    ENABLE-INCDNO = "Y";
    DISABLE-FIELDS = "Y";
    DISABLE-SYMPCD = "Y";
    DISABLE-SPEED = "Y";
    DISABLE-CONDIRECTION = "Y";
    DISABLE-INCDLOC = "Y";
    DISABLE-ADDNARR = "Y";
    DISABLE-CHANGE = "Y";
    BUTTON-CAPTION = "Update";
    INCDNO-SETFOCUS = "Y";
    set VHINC10IW-HRS empty;
end 

Function VHINC10IS-CLR-FLDS () 
    VHINC10IW.DISCV-DUR-ARRAY = " ";
    VHINC10IW.DISCV-DUR = " ";
    VHINC10IW.DISCV-DUR-ARRAY[1] = "1";
    VHINC10IW.DISCV-DUR-ARRAY[2] = "2";
    VHINC10IW.DISCV-DUR-ARRAY[3] = "3";
    VHINC10IW.DISCV-DUR-ARRAY[4] = "4";
    VHINC10IW.DISCV-DUR-ARRAY[5] = "5";
    VHINC10IW.DISP-DET = " ";
    VHINC10IW.VEH-INCD-STAT = " ";
    VHINC10IW.INCD-TYPE = " ";
    VHINC10IW.DISP-CUM-HRS-MIN = " ";
    VHINC10IW.DISP-CUM-HRS = 0;
    VHINC10IW.DISP-CUM-MIN = 0;
    VHINC10IW.NARR-NO = 1;
    VHINC10IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHINC10IW.TIME-NARR = VGVar.currentFormattedTime;
    VHINC10IW.TIME-NARR-FILLER-1 = ":";
    VHINC10IW.TIME-NARR-FILLER-2 = ":";

  
    set VHINC1D_CRIT empty;
    set VHINC1D_DATA empty;
    set VHINC9A_DATA empty;
end 

Function VHINC10IS-ENTRY () 
    VHINC10IS-CLR-FLDS();
    VHINC10IW.STORE-USER-GRP = VHINC10IW.PASSVALUE-USER-GRP;
    VHINC10IW.USER-GRP = VHINC10IW.PASSVALUE-USER-GRP;


  
  
  
    VHXREVA_CRIT.SEL-IDX = 3;
    try
        call "VHXREVA"(XDCONTROL, VHXREVA_CRIT, VHXREVA_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        TEMP-DATE = VHXREVA_DATA.REVENUE-DATE;
        VHINC10IW.DATE-INCD-OCCR = TEMP-DATE;
        VHINC10IW.DATE-FILLER-1 = "-";
        VHINC10IW.DATE-FILLER-2 = "-";
        VHINC10IW.TIME-INCD-OCCR = VGVar.currentFormattedTime;
        VHINC10IW.TIME-INCD-OCCR-FILLER-1 = ":";
        VHINC10IW.TIME-INCD-OCCR-FILLER-2 = ":";
        VHXREVA_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    else

    end
    DISABLE-PREV = "Y";
    DISABLE-NEXT = "Y";
    ENABLE-INCDNO = "Y";
    DISABLE-FIELDS = "Y";
    DISABLE-SYMPCD = "Y";
    DISABLE-SPEED = "Y";
    DISABLE-CONDIRECTION = "Y";
    DISABLE-INCDLOC = "Y";
    DISABLE-ADDNARR = "Y";
    DISABLE-CHANGE = "Y";
    BUTTON-CAPTION = "Update";
    INCDNO-SETFOCUS = "Y";
end 

Function VHINC10IS-INCD-DET () 
    VHINC10IW.DISCV-DUR-ARRAY = " ";
    VHINC10IW.DISCV-DUR-ARRAY[1] = "1";
    VHINC10IW.DISCV-DUR-ARRAY[2] = "2";
    VHINC10IW.DISCV-DUR-ARRAY[3] = "3";
    VHINC10IW.DISCV-DUR-ARRAY[4] = "4";
    VHINC10IW.DISCV-DUR-ARRAY[5] = "5";
