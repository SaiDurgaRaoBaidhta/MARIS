Function VHINC03IS-DATE-CHK () 
    if (JULIAN-DATE-1-CCYY == JULIAN-DATE-2-CCYY)
        if (JULIAN-DATE-2-DDD > JULIAN-DATE-1-DDD)
            ERROR-COUNT = ERROR-COUNT + 1;
            DISP-ERR-MSG = "Y";
             
        else
            JULIAN-DAYS-DIFF = JULIAN-DATE-1 - JULIAN-DATE-2;
            if (VHINCZ_CRIT.TYPE-IND == "EVT") 
  
                if (JULIAN-DAYS-DIFF > 1095)
                    ERROR-COUNT = ERROR-COUNT + 1;
                    DAYS-GR-30 = "Y";
                end
            else
  
                if (JULIAN-DAYS-DIFF > 1095) 
                    ERROR-COUNT = ERROR-COUNT + 1;
                    DAYS-GR-210 = "Y";
                end
            end
        end
    else
        if (JULIAN-DATE-1-CCYY > JULIAN-DATE-2-CCYY)
            JULIAN-DATE-YR-DIFF = JULIAN-DATE-1-CCYY - JULIAN-DATE-2-CCYY;
        else
            JULIAN-DATE-YR-DIFF = JULIAN-DATE-2-CCYY - JULIAN-DATE-1-CCYY;
        end
        if (JULIAN-DATE-YR-DIFF > 3)
            if (VHINCZ_CRIT.TYPE-IND == "EVT") 
                ERROR-COUNT = ERROR-COUNT + 1;
                DAYS-GR-30 = "Y";
            else
        
                ERROR-COUNT = ERROR-COUNT + 1;
                DAYS-GR-210 = "Y";
            end
        else
      
            if (JULIAN-DATE-1-CCYY > JULIAN-DATE-2-CCYY)
                JULIAN-DATE-QUOT = JULIAN-DATE-2-CCYY / 4;
                JULIAN-DATE-REM = JULIAN-DATE-2-CCYY - (JULIAN-DATE-QUOT * 4);
                if (JULIAN-DATE-REM > 0)
                    JULIAN-DATE-1-DDD = JULIAN-DATE-1-DDD + 365;
                else
                    JULIAN-DATE-1-DDD = JULIAN-DATE-1-DDD + 366;
                end
                JULIAN-DAYS-DIFF = JULIAN-DATE-1-DDD - JULIAN-DATE-2-DDD;
                if (VHINCZ_CRIT.TYPE-IND == "EVT") 
  
                    if (JULIAN-DAYS-DIFF > 1095)
                        ERROR-COUNT = ERROR-COUNT + 1;
                        DAYS-GR-30 = "Y";
                    end
                else
  
                    if (JULIAN-DAYS-DIFF > 1095) 
                        ERROR-COUNT = ERROR-COUNT + 1;
                        DAYS-GR-210 = "Y";
                    end
                end
            else
                ERROR-COUNT = ERROR-COUNT + 1;
                DISP-ERR-MSG = "Y";
                 
            end
        end
    end
end 

Function VHINC03IS-ENTRY () 
    VHINC03IW.MARIS-FUNC = "VHINC";
    VHINC03IW.STORE-USER-GRP = VHINC03IW.USER-GRP;
    if (VHINCZ_CRIT.TYPE-IND == "EVT") 
        VHINC03IW.GUI-TITLE = "VHINC03I - Vehicle Tracking (Incident Veh - Event)";
    else
        if (VHINCZ_CRIT.TYPE-IND == "SHN") 
            VHINC03IW.GUI-TITLE = "VHINC03I - Vehicle Tracking (Incident Veh - Shop)";
        else
            if (VHINCZ_CRIT.TYPE-IND == "MSC") 
                VHINC03IW.GUI-TITLE = "VHINC03I - Vehicle Tracking (Incident Veh - Miscellaneous)";
            end
        end
    end

  
    try
        call "VHCI02G"(XDCONTROL, VHCI02G_CRIT, VHCI02G_DATA);
    
    end
    if (XDCONTROL.UROWCNT == 1)
        TEMP-DATE = VHCI02G_CRIT.CURRENT-DATE;
        VHXREVA_DATA.SYSTEM-TIME = VHCI02G_CRIT.CURRENT-TIME;
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    VHINC03IS-CLR-FLDS();
  
    VHINC03IW.DATE-INCD-OCCR = TEMP-DATE;
    VHINC03IW.DATE-FILLER-1 = "-";
    VHINC03IW.DATE-FILLER-2 = "-";
    VHINC03IW.TIME-INCD-OCCR = " ";
    VHINC03IW.TIME-INCD-OCCR-FILLER-1 = ":";
    VHINC03IW.TIME-INCD-OCCR-FILLER-2 = " ";
    
  
    DISABLE-PREV = "Y";
    DISABLE-NEXT = "Y";
    ENABLE-INCDDET = "Y";
    DISABLE-ADDNARR = "Y";
    ENABLE-INCDNARR = "Y";
    ENABLE-SYMPCD = "Y";
    ENABLE-INCDLOC = "Y";
    ENABLE-FIELDS = "Y";
    VHINC03IW.NARR-NO = 1;
    VHINC03IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHINC03IW.TIME-NARR = VGVar.currentFormattedTime;
    VHINC03IW.TIME-NARR-FILLER-1 = ":";
    VHINC03IW.TIME-NARR-FILLER-2 = " ";
    ENABLE-CREATE = "Y";
    BUTTON-CAPTION = "Create";
    CAR-SETFOCUS = "Y";
end 

Function VHINC03IS-MOVE-MSG () 
    VHINC03IW.ERROR-LOOP-INDEX = 1;
    VHINC03IW.FINAL-INDEX = 0;
    VHINC03IW.FINAL-ERROR-MSG = " ";
    VHINC03IW-TRIGGER.SUCCESS-MESSAGE = " ";
    VHINC03IW.TEMP-ERROR-MSG = " ";
    if (ERROR-INDEX > 0)
        while (((ERROR-LOOP-INDEX <= 6) &&
         (ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX] != " ")))
            ERROR-INDEX = 1;
            TEMP-ERROR-MSG = ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX];
            while ((ERROR-INDEX <= 30))
                if (TEMP-MSG[ERROR-INDEX] != ".")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = TEMP-MSG[ERROR-INDEX];
                else
                    if (TEMP-MSG[ERROR-INDEX] == ".")
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = ",";
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = " ";
                        ERROR-INDEX = 30;
                    end
                end
                ERROR-INDEX = ERROR-INDEX + 1;
            end
            ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
        end
        FINAL-INDEX = FINAL-INDEX - 1;
        FINAL-MSG[FINAL-INDEX] = " ";
        VHINC03IW-TRIGGER.SUCCESS-MESSAGE = FINAL-ERROR-MSG;
        EXECUTE-SETFOCUS = "Y";
    end
end 

