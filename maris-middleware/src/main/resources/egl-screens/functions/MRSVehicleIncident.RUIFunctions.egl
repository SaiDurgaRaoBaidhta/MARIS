    VHINCY_DATA.USER-GRP = VHINC08IW.USER-GRP;
    VHINCY_DATA.DATE-NARR = VHINC08IW.DATE-NARR;
    VHINC08IW.TIME-NARR-FILLER-1 = ":";
    VHINC08IW.TIME-NARR-FILLER-2 = ":";
