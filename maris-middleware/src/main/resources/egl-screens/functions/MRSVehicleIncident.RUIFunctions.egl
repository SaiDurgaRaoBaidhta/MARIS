    VHINC09IW.TIME-NARR-FILLER-2 = ":";
    VHINC09IW.DATE-INCD-OCCR = " ";
    VHINC09IW.TIME-INCD-OCCR = " ";

  
    set VHINC1D_CRIT empty;
    set VHINC1D_DATA empty;
    set VHINC9A_DATA empty;
end 

