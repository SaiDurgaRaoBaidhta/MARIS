    end
    if (VHINC09IW.CON-NO != " " &&
     VHINC09IW.DASH-NO > 0)
        VHINC9A_CRIT.CON-NO = VHINC09IW.CON-NO;
        VHINC9A_CRIT.DASH-NO = VHINC09IW.DASH-NO;
  
        try
            call "VHINC9A"(XDCONTROL, VHINC9A_CRIT, VHINC9A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        else
            VHINC9A_DATA.DISP-DATA-ROW = " ";
        end
    end
    DISABLE-INCDNO = "Y";
    DISABLE-INCDDET = "Y";
    ENABLE-ADDNARR = "Y";
    DISABLE-CHANGE = "Y";
    ADDNARR-SETFOCUS = "Y";
end 

