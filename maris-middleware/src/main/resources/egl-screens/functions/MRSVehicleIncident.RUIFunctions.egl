Function VHCI01IS-SHOP-STAT () 
    VHINXD_CRIT.CAR-NO = VHCI01IW.CAR-NO;
    VHINXD_DATA.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
    try
        call "VHINXD"(XDCONTROL, VHINXD_CRIT, VHINXD_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHCI01IS-UD () 
    set VHCI01IW-TEMP-MI empty;
    VHCI01IW-TEMP-MI.ERR-FOUND = "N";
    DISP-ERR-MSG = " ";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    CAR-ERROR = "N";
    LOOP-INDEX = 1;
    STORE-INDEX = 1;
    TEMP-INDEX = 0;
    move CI-COUNT to STORE-INCDS-COUNT withV60Compat;

  
    while ((LOOP-INDEX <= STORE-INCDS-COUNT))
        if (VHCI01D_DATA.CHANGE[LOOP-INDEX] != "YES" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "Y" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "NO" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "N" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != " ")
            CAR-ERROR = "Y";
            DISP-ERR-MSG-1 = "Invalid Response for";
            DISP-ERR-MSG-2 = VHCI01D_DATA.INCD-NO[LOOP-INDEX];
            DISP-ERR-MSG-3 = " ";
            move DISP-ERR-MSG to FINAL-ERROR-MESSAGE withV60Compat;
            INCDINFO-SETFOCUS = "Y";
            move STORE-INCDS-COUNT to LOOP-INDEX withV60Compat;
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
    LOOP-INDEX = 1;
    if (CAR-ERROR == "N")
        while ((LOOP-INDEX <= VHCI01IW.CI-COUNT))
            if (VHCI01D_DATA.CHANGE[LOOP-INDEX] == "Y" ||
             VHCI01D_DATA.CHANGE[LOOP-INDEX] == "YES")
                TEMP-INDEX = TEMP-INDEX + 1;
                VHCI01IW-TEMP-MI.DATA_ROW[TEMP-INDEX] = VHCI01D_DATA.DATA_ROW[LOOP-INDEX];
            end
            LOOP-INDEX = LOOP-INDEX + 1;
        end
        TEMP-INDEX = TEMP-INDEX + 1;
        if (TEMP-INDEX > 1)
            VHCI01IW-TEMP-MI.CHANGE[TEMP-INDEX] = VHCI01IW.CAR-NO;
            VHCI01IW-TEMP-MI.INCD-NO[TEMP-INDEX] = " ";
            VHCI01IW-TEMP-MI.DATE-STAT-CHG = VHCI01IW.DATE-STAT-CHG;
            VHCI01IW.TIME-STAT-CHG-HR = VHCI01IW.DISP-TIME-STAT-CHG-HR;
            VHCI01IW.TIME-STAT-CHG-FILLER1 = ":";
            VHCI01IW.TIME-STAT-CHG-MIN = VHCI01IW.DISP-TIME-STAT-CHG-MIN;
            VHCI01IW.TIME-STAT-CHG-FILLER2 = ":";
            VHCI01IW.TIME-STAT-CHG-SEC = 00;
            VHCI01IW-TEMP-MI.TIME-STAT-CHG = VHCI01IW.TIME-STAT-CHG;
            VHCI01IW-TEMP-MI.STORE-NARR-CI = "CI / ACTION- ";
            VHCI01IW-TEMP-MI.STORE-NARR-ACTION = "UD ";
            VHCI01IW-TEMP-MI.STORE-NARR-DATE = VGVar.currentFormattedGregorianDate;
            VHCI01IW-TEMP-MI.STORE-NARR-TIME = VGVar.currentFormattedTime;
            VHCI01IW-TEMP-MI.USER-GRP = VHCI01IW.USER-GRP;
            VHCI01IW-TEMP-MI.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
            VHCI01IW-TEMP-MI.NARR = VHCI01IW.NARR;
            VHCI01IW-TEMP-MI.ROW-COUNT = TEMP-INDEX;

      
            VHXREVA_CRIT.SEL-IDX = 1;
            VHXREVA_CRIT.SYSTEM-DATE = VHCI01IW-TEMP-MI.DATE-STAT-CHG;
            VHXREVA_CRIT.SYSTEM-TIME = VHCI01IW-TEMP-MI.TIME-STAT-CHG;
            try
                call "VHXREVA"(XDCONTROL, VHXREVA_CRIT, VHXREVA_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                XXDATEW.DATE-MM-DD-YYYY = VHXREVA_DATA.REVENUE-DATE;
                XXDATEW.VAGen_FUNCTION = "YMD";
                MRSCommonCode.XXDATES-CONVERT();
                VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = XXDATEW.DATE-YYYY-MM-DD;
            else
                VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = " ";
            end
            try
                call "VHCIT"(XDCONTROL, VHCI01IW-TEMP-MI);
            
            end
            if (VHCI01IW-TEMP-MI.ERR-FOUND == "N")
                VHCI01IS-MOVE-REC();
                VHCI01IW-TRIGGER-X.LOAD-UD = "Y";
                if (VHCI01IW-TEMP-MI.DISP-MOVE-MSG == "Y")
                    VHCI01IW.STORE-ERR-MSG[1] = "Modify counts as needed for DVS Report. Incidents changed, !";
                else
                    VHCI01IW.STORE-ERR-MSG[1] = "Incidents changed, !";
                end
                if (VHCI01IW-TEMP-MI.STATUS-UPD == "Y")
                    VHCI01IS-CICS-MSG(); 
                    VHCI01IW.SCR-VEH-STAT = VHCI01IW-TEMP-MI.NEW-VEH-STAT;
                    VHCI01IW.SCR-VEH-STAT-DESC = VHCI01IW-TEMP-MI.NEW-VEH-STAT-DESC;
                    VHCI02IS-STAT(); 
                end
                if (VHCI01IW-TEMP-MI.FINAL-INCD-COUNT > 0)
                    VHCI01IW.STORE-ERR-MSG[4] = "Open Incidents remain!";
                else
                    VHCI01IW.STORE-ERR-MSG[4] = "!";
                end
                VHCI01IS-ERR-MSG(); 
                VHCI01IS-CLR-AFTDB(); 
                                   
            else
                DISABLE-CHANGE = "Y";
                DISABLE-INCDINFO = "Y";
                VHCI01IW-TRIGGER-X.LOAD-UD = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

