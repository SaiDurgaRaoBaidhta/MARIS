    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
  

        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHINC03IS-CHK-DATA ()
   
    ERROR-MESSAGE = " ";
    ERROR-INDEX = 0;
    ERROR-COUNT = 0;
    TOTAL-MIN-DIFF = 0;
    JULIAN-DATE-QUOT = 0;
    JULIAN-DATE-REM = 0;
    JULIAN-DATE-YR-DIFF = 0;
    JULIAN-DATE-1 = 0;
    JULIAN-DATE-2 = 0;
    INVALID-CAR-NO = "N"; 
    INVALID-INCD-NARR = "N"; 
    INVALID-SYMP-CD = "N"; 
    INVALID-DISCV-DUR = "N"; 
    INVALID-DATE-INCD = "N"; 
    INVALID-TIME-INCD = "N"; 
    INVALID-INCD-LOC = "N"; 
    INVALID-DATE = "N"; 
    DAYS-GR-210 = "N"; 
    DAYS-GR-30 = "N"; 
    DISP-ERR-MSG = "N"; 
    DISP-INVALID-TIME = "N"; 
    DISP-TIME-ERRMSG = "N"; 
    INVALID-SYMPCD-VAL = "N"; 
    DISPLAY-INVALID-CAR-NO = "N"; 
    DISPLAY-IN-USE = "N"; 
    DISCV-DUR-FOUND = "N"; 
    VHINC03IW.CAR-NO = VHINC03IW.CAR-NO-NUM;
    if (VHINC03IW.CAR-NO == "0000")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-CAR-NO = "Y";
    end
    if (VHINC03IW.SYMP-CD == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-SYMP-CD = "Y";
    end
    if (VHINC03IW.DISCV-DUR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-DISCV-DUR = "Y";
    else
        LOOP-INDEX = 1;
        while ((LOOP-INDEX <= VHINCXA_DATA.DISCV-DUR-COUNT))
            if (VHINC03IW.DISCV-DUR == VHINCXA_DATA.DISCV-DUR[LOOP-INDEX])
                DISCV-DUR-FOUND = "Y";
                LOOP-INDEX = VHINCXA_DATA.DISCV-DUR-COUNT;
            end
            LOOP-INDEX = LOOP-INDEX + 1;
        end
        if (DISCV-DUR-FOUND == "N")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-DISCV-DUR = "Y";
        end
    end
    if (VHINC03IW.DATE-INCD-OCCR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-DATE-INCD = "Y";
    end
    if (VHINC03IW.DISP-TIME-INCD-OCCR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-TIME-INCD = "Y";
    end
    if (VHINC03IW.INCD-LOC == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-LOC = "Y";
    end
    if (VHINC03IW.INCD-NARR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-NARR = "Y";
    end

  
    TEMP-DATE-MON = VHINC03IW.DATE-INCD-OCCR-MON;
    TEMP-DATE-FILLER-1 = "-";
    TEMP-DATE-DAY = VHINC03IW.DATE-INCD-OCCR-DAY;
    TEMP-DATE-FILLER-2 = "-";
    TEMP-DATE-YR = VHINC03IW.DATE-INCD-OCCR-YR;
    AFCXVLD_CRIT.FORM-DATE = TEMP-DATE;
    MRSCommonCode.AFCXVLD-VALIDATE();
    if (AFCXVLDW.INCORRECT-DATE == "Y")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-DATE = "Y";
    else
        if (AFCXVLDW.SQL-ERROR == "Y")
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        else
            if (AFCXVLDW.NO-ERROR == "Y")
                XDATECON-W2.WS-GREG-IN-FLAG = "R";
                XDATECON-W2.WS-RPT-GREG-IN = VGVar.currentFormattedGregorianDate;
                MRSCommonCode.XDATECON-LOAD-TBL();
                MRSCommonCode.XDATECON-GREG2JUL();
                JULIAN-DATE-1 = XDATECON-W1.WS-DATES-CYDDD;
                XDATECON-W2.WS-GREG-IN-FLAG = "R";
                XDATECON-W2.WS-RPT-GREG-IN = TEMP-DATE;
                MRSCommonCode.XDATECON-LOAD-TBL();
                MRSCommonCode.XDATECON-GREG2JUL();
                JULIAN-DATE-2 = XDATECON-W1.WS-DATES-CYDDD;
                VHINC03IS-DATE-CHK();
            end
        end
    end
    if (VHINC03IW.DISP-TIME-INCD-OCCR not numeric)
        ERROR-COUNT = ERROR-COUNT + 1;
        DISP-INVALID-TIME = "Y";
    else
        VHINC03IW.TIME-INCD-OCCR-HR = VHINC03IW.DISP-TIME-INCD-OCCR-HR;
        VHINC03IW.TIME-INCD-OCCR-MIN = VHINC03IW.DISP-TIME-INCD-OCCR-MIN;
        if ((TIME-INCD-OCCR-HR-NUM > 24) ||
         (TIME-INCD-OCCR-HR-NUM == 24 && TIME-INCD-OCCR-MIN-NUM >
         00) ||
         (TIME-INCD-OCCR-HR-NUM >= 0 && TIME-INCD-OCCR-MIN-NUM >
         59))
            ERROR-COUNT = ERROR-COUNT + 1;
            DISP-INVALID-TIME = "Y";
        else
            VHINC03IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
            if ((VHINC03IW.DATE-INCD-OCCR-YR == VHINC03IW.SYSTEM-DATE-YR &&
             VHINC03IW.DATE-INCD-OCCR-MON == VHINC03IW.SYSTEM-DATE-MON &&
             VHINC03IW.DATE-INCD-OCCR-DAY == VHINC03IW.SYSTEM-DATE-DAY))
                VHINC1A_CRIT.REVENUE-TIME = VHINC03IW.TIME-INCD-OCCR;
                VHINC1A_CRIT.VAGen_COUNT = 0;
                VHINC1A_CRIT.SYMP-CD = VHINC03IW.SYMP-CD;
                VHINC1A_CRIT.ALLOW-TIME = VGVar.currentFormattedTime;
                TOTAL-REV-MIN = (VHINC1A_CRIT.REVENUE-TIME-HR-NUM * 60) + VHINC1A_CRIT.REVENUE-TIME-MIN-NUM;
                TOTAL-ALLOW-MIN = (VHINC1A_CRIT.ALLOW-TIME-HR-NUM * 60) + VHINC1A_CRIT.ALLOW-TIME-MIN-NUM;
                TOTAL-MIN-DIFF = TOTAL-REV-MIN - TOTAL-ALLOW-MIN;
                if (TOTAL-MIN-DIFF > 60)
                    ERROR-COUNT = ERROR-COUNT + 1;
            
                    DISP-TIME-ERRMSG = "Y";
                end
            end
        end
    end
    if (VHINC03IW.SYMP-CD != " ")
        VHINC1A_CRIT.VAGen_COUNT = 0;
        VHINC1A_CRIT.SYMP-CD = VHINC03IW.SYMP-CD;
        try
            call "VHINC1A"(XDCONTROL, VHINC1A_CRIT);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHINC1A_CRIT.VAGen_COUNT == 0)
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-SYMPCD-VAL = "Y";
            end
        end
    end
    if (VHINC03IW.CAR-NO != " ")
  
        VHINC6A_CRIT.CAR-NO = VHINC03IW.CAR-NO;
        try
            call "VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        
            if (XDCONTROL.UROWCNT == 0 ||
             (VHINCZ_CRIT.TYPE-IND == "MSC" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "A" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "B" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "C" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "D" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "E" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "L" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "M" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "K" ))
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                if (XDCONTROL.UROWCNT == 0 ||
                 (VHINCZ_CRIT.TYPE-IND != "MSC" &&
                 VHINC6A_DATA.CAR-TYPE-OCCR[1] != "A" &&
                 VHINC6A_DATA.CAR-TYPE-OCCR[1] != "B" &&
                 VHINC6A_DATA.CAR-TYPE-OCCR[1] != "C" &&
                 VHINC6A_DATA.CAR-TYPE-OCCR[1] != "D" &&
                 VHINC6A_DATA.CAR-TYPE-OCCR[1] != "E" &&
                 VHINC6A_DATA.CAR-TYPE-OCCR[1] != "L" &&
                 VHINC6A_DATA.CAR-TYPE-OCCR[1] != "M" &&
                 VHINC6A_DATA.CAR-TYPE-OCCR[1] != "K"))
                    ERROR-COUNT = ERROR-COUNT + 1;
                    DISPLAY-INVALID-CAR-NO = "Y";
                end
            end
        else
            if (XDCONTROL.URC == 100)
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
    if (ERROR-COUNT > 0)
        VHINC03IS-BLD-MSG(); 
    else
        VHINC03IS-STORE-DB(); 
    end
end 

Function VHINC03IS-CLEAR () 
    VHINC03IW.MARIS-FUNC = "VHINC";
    VHINC03IW.USER-GRP = VHINC03IW.STORE-USER-GRP;
    if (VHINCZ_CRIT.TYPE-IND == "EVT") 
        VHINC03IW.GUI-TITLE = "VHINC03I - Vehicle Tracking (Incident Veh - Event)";
    else
        if (VHINCZ_CRIT.TYPE-IND == "SHN") 
            VHINC03IW.GUI-TITLE = "VHINC03I - Vehicle Tracking (Incident Veh - Shop)";
        else
            if (VHINCZ_CRIT.TYPE-IND == "MSC") 
                VHINC03IW.GUI-TITLE = "VHINC03I - Vehicle Tracking (Incident Veh - Miscellaneous)";
            end
        end
    end
    VHINC03IS-CLR-FLDS();
    TEMP-DATE = VGVar.currentFormattedGregorianDate; 
    VHINC03IW.DATE-INCD-OCCR = TEMP-DATE;
    VHINC03IW.DATE-FILLER-1 = "-";
    VHINC03IW.DATE-FILLER-2 = "-";
    VHINC03IW.TIME-INCD-OCCR = " ";
    VHINC03IW.TIME-INCD-OCCR-FILLER-1 = ":";
    VHINC03IW.TIME-INCD-OCCR-FILLER-2 = " ";
    VHXREVA_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    DISABLE-PREV = "Y";
    DISABLE-NEXT = "Y";
    ENABLE-INCDDET = "Y";
    DISABLE-ADDNARR = "Y";
    ENABLE-INCDNARR = "Y";
    ENABLE-SYMPCD = "Y";
    ENABLE-INCDLOC = "Y";
    ENABLE-FIELDS = "Y";
    VHINC03IW.NARR-NO = 1;
    VHINC03IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHINC03IW.TIME-NARR = VGVar.currentFormattedTime;
    VHINC03IW.TIME-NARR-FILLER-1 = ":";
    VHINC03IW.TIME-NARR-FILLER-2 = " ";
    ENABLE-CREATE = "Y";
    BUTTON-CAPTION = "Create";
    CAR-SETFOCUS = "Y";
end 

Function VHINC03IS-CLEAR-DB () 
    VHINC03IW.MARIS-FUNC = "VHINC";
    VHINC03IW.USER-GRP = VHINC03IW.STORE-USER-GRP;
    if (VHINCZ_CRIT.TYPE-IND == "EVT") 
        VHINC03IW.GUI-TITLE = "VHINC03I - Vehicle Tracking (Incident Veh - Event)";
    else
        if (VHINCZ_CRIT.TYPE-IND == "SHN") 
            VHINC03IW.GUI-TITLE = "VHINC03I - Vehicle Tracking (Incident Veh - Shop)";
        else
            if (VHINCZ_CRIT.TYPE-IND == "MSC") 
                VHINC03IW.GUI-TITLE = "VHINC03I - Vehicle Tracking (Incident Veh - Miscellaneous)";
            end
        end
    end
    VHINC03IS-CLRAFTDB();
    TEMP-DATE = VGVar.currentFormattedGregorianDate; 
    VHINC03IW.DATE-INCD-OCCR = TEMP-DATE;
    VHINC03IW.DATE-FILLER-1 = "-";
    VHINC03IW.DATE-FILLER-2 = "-";
    VHINC03IW.TIME-INCD-OCCR = " ";
    VHINC03IW.TIME-INCD-OCCR-FILLER-1 = ":";
    VHINC03IW.TIME-INCD-OCCR-FILLER-2 = " ";
    VHXREVA_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    VHINC03IW.NARR-NO = 1;
    VHINC03IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
