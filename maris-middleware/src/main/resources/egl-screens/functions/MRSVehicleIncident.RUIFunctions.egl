    VHINC08IW.TIME-INCD-OCCR-FILLER-2 = ":";
    VHINC08IW.TIME-INCD-OCCR-SEC = "00";


  
  
  
  
  
  
  
  
  
  
  
  
  
  
  

  
  
  
  
  
  
  
  
  
  
  
  
  
  
  

  
  
  
  
  
  
  
  
  
    XXDATEW.DATE-MM-DD-YYYY = VHINC08IW.DATE-INCD-OCCR;
