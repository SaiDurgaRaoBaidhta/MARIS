    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        TEMP-DATE = VHXREVC_DATA.REVENUE-DATE;
        VHINC06IW.DATE-INCD-OCCR = TEMP-DATE;
        VHINC06IW.DATE-FILLER-1 = "-";
        VHINC06IW.DATE-FILLER-2 = "-";
        VHINC06IW.TIME-INCD-OCCR-FILLER-1 = ":";
        VHINC06IW.TIME-INCD-OCCR-FILLER-2 = " ";
