Function VHCI01IS-ACT-MOVE () 
    ERROR-MSG = "N";
    set VHCI01IW-TEMP-MI empty;
    set VHCI01A_DATA empty;
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    DISP-ERR-MSG = " ";
    VHCI01IW.MOVE-INCDS-COUNT = 0;
    if (ERROR-MSG == "N")
  
  
        VHCI01B_DATA.CAR-NO = VHCI01IW.CAR-NO;
        try
            call "VHCI01B"(XDCONTROL, VHCI01B_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCI01IW.SCR-DISP-VEH-STAT = VHCI01B_DATA.DISP-VEH-STAT;
            VHCI01IW.CON-NO = VHCI01B_DATA.CON-NO;
            if (VHCI01B_DATA.WHERE-IS-CAR == "CON")
                ERROR-MSG = "Y";
                DISABLE-CHANGE = "Y";
                VHCI01IW.FINAL-ERROR-MESSAGE = "Car In Use.";
                CAR-ON-CONSIST = "Y";
            else
                if (VHCI01B_DATA.CAR-TYPE-1 == "D")
                    ERROR-MSG = "Y";
                    DISABLE-CHANGE = "Y";
                    VHCI01IW.FINAL-ERROR-MESSAGE = "Not valid for Dummy cars.";
                    DUMMY-CAR = "Y";
                else
                    if (VHCI01IW.CAR-NO == "0095" &&
                     VHCI01B_DATA.CAR-TYPE-1 == "T" &&
                     VHCI01IW.ACTION-OPT != 7)
                        VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid Action for Car.";
                        INVALID-ACTION = "Y";
                        ERROR-MSG = "Y";
                        DISABLE-CHANGE = "Y";
                        LOAD-MOVE-INCDS = "Y";
                    end
                end
            end
        else
            if (XDCONTROL.URC == 100)
                ERROR-MSG = "Y";
                DISABLE-CHANGE = "Y";
                VHCI01IW.FINAL-ERROR-MESSAGE = "Car not found in the database.";
                CAR-NOT-FOUND = "Y";
            else
                ERROR-MSG = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
    if (ERROR-MSG == "N")
        ENABLE-INCDINFO = "Y";

    
        if (VHCI01IW.ACTION-OPT == 7)
            VHCI01IW.COL-HEADING = "Move to Car No";
            VHCI01A_CRIT.CAR-NO = VHCI01IW.CAR-NO;
            try
                call "VHCI01A"(XDCONTROL, VHCI01A_CRIT, VHCI01A_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                MOVE-INCDS-COUNT = XDCONTROL.UROWCNT;
                ENABLE-CHANGE = "Y";
                VHCI01IW-TRIGGER-X.LOAD-MOVE-INCDS = "Y";
                VHCI01IW-TRIGGER.DATE-SETFOCUS = "Y";
            else
                if (XDCONTROL.URC == 100)
                    set VHCI01A_DATA empty;
                    if (VHCI01B_DATA.VEH-STAT == "USABLE")
                        VHCI01IW.FINAL-ERROR-MESSAGE = "No Unsent Incidents on file for this vehicle.";
                        NO-INCDS-FOUND-1 = "Y";
                    else
                        VHCI01IW.FINAL-ERROR-MESSAGE = "No Incidents on file for this vehicle.";
                        NO-INCDS-FOUND-2 = "Y";
                    end
                    DISABLE-INCDINFO = "Y";
                    LOAD-MOVE-INCDS = "Y";
                else
                    DISABLE-INCDINFO = "Y";
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end
            move VHCI01A_DATA.DATA_ROW to VHCI01IW-STORE-MI.DATA_ROW[1] for all;
        end
    end
end 

