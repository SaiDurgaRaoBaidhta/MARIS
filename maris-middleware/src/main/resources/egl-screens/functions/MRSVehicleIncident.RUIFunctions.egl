            VHCI02IS-PSEUDO(); 
            VHCI01IW-TRIGGER-X.LOAD-UD = "Y";
            VHCI01IW-TRIGGER.DATE-SETFOCUS = "Y";
        else
            if (XDCONTROL.URC == 100)
                set VHCI01D_DATA empty;
                VHCI01IW.FINAL-ERROR-MESSAGE = "No Incidents on file for this vehicle.";
                NO-INCDS-FOUND-2 = "Y";
                VHCI01IW-TRIGGER-X.LOAD-UD = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
        move VHCI01D_DATA.DATA_ROW to VHCI01IW-STORE-MI.DATA_ROW[1] for all;
    end
end 

Function VHCI01IS-BLD-MSG () 
    if (INVALID-DATE == "Y")
        FINAL-ERROR-MESSAGE = "Invalid Date";
        DATE-SETFOCUS = "Y";
        return;
    else
        if (INVALID-DATE-FUTURE == "Y")
            FINAL-ERROR-MESSAGE = "Future Date not allowed.";
            DATE-SETFOCUS = "Y";
            return;
        else
            if (INVALID-DATE-OLD == "Y")
                FINAL-ERROR-MESSAGE = "Date more than 1 year ago.";
                DATE-SETFOCUS = "Y";
                return;
            end
        end
    end
    if (INVALID-TIME == "Y")
        FINAL-ERROR-MESSAGE = "Invalid Time.";
        TIME-SETFOCUS = "Y";
        return;
    else
        if (INVALID-TIME-FUTURE == "Y")
            FINAL-ERROR-MESSAGE = "Future Time not allowed.";
            TIME-SETFOCUS = "Y";
            return;
        end
    end
    if (INVALID-PMLOC == "Y")
        FINAL-ERROR-MESSAGE = "Invalid Location.";
        PMLOC-SETFOCUS = "Y";
        return;
    end
    if (INVALID-NARR == "Y")
        FINAL-ERROR-MESSAGE = "Narrative required.";
        NARR-SETFOCUS = "Y";
    end
end 

Function VHCI01IS-CAR-STAT () 
    VHCI01IW.STATUS = " ";
    VHCI01IW.NARR = " ";
    VHCI01IW.PM-LOC = " ";
    VHCI01IW.SCR-DISP-VEH-STAT = " ";
    if (VHCI01IW.ACTION-OPT == 1) 
        VHCI01IW-TRIGGER.SHOW-STATUS = "Y";
        if (VHCI01IW.USER-GRP == "VEHSUPR")
            VHCI01IW.STATUS = "USABLE";
        else
            VHCI01IW.STATUS = "GO";
        end
    else
        VHCI01IW-TRIGGER.HIDE-STATUS = "Y";
        VHCI01IW.STATUS = " ";
    end
    if (VHCI01IW.ACTION-OPT == 3 ||
     VHCI01IW.ACTION-OPT == 7)
        DISABLE-NARR = "Y";
        DISABLE-PMLOC = "Y";
    else
        ENABLE-NARR = "Y";
        ENABLE-PMLOC = "Y";
    end

  
  
  
  
  
  
  
    if (VHCI01IW.ACTION-OPT == 7) 
        VHCI01IW.COL-HEADING = "Move to Car No";
    else
        if (VHCI01IW.ACTION-OPT == 2) 
            VHCI01IW.COL-HEADING = "Def Priority A/B/C";
        else
            VHCI01IW.COL-HEADING = "Change - Yes/No";
        end
    end
    VHCI02IS-CLR-LIST();
end 

Function VHCI01IS-CHG-LOC () 
    VHCI02IW-YRD-TRK.CAR-NO = " ";
    VHYT10IW-PASSVALUE.YRD-TRKG-YRD = VHYT03IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT10IW-PASSVALUE.YRD-SUB-LOC = VHYT03IW-PASSVALUE.YRD-SUB-LOC;
    VHYT03IW-PASSVALUE.WHICH-GUI-FROM-X = "VHCI02I";
    VHYTM5IW-PASSVALUE.EXEC-GUI = "VHYT03I";
  
    VHYT10IW-PASSVALUE.CAR-NO = VHCI01IW.CAR-NO-NUM;
end 

Function VHCI01IS-CHK-PM () 
    if (VHCI01IW.STATUS == "PM" ||
     VHCI01IW.STATUS == "GO")
        ENABLE-PMLOC = "Y";
        ENABLE-PMTEAM = "Y";
    else
        DISABLE-PMLOC = "Y";
        DISABLE-PMTEAM = "Y";
    end
    VHCI02IS-CLR-LIST();
end 

Function VHCI01IS-CICS-MSG () 
    VHCI01E_CRIT.CON-CAR-1 = VHCI01IW-TEMP-MI.CHANGE[ROW-COUNT];
    VHCI01E_CRIT.REPT-ID = "CI";
    VHCI01E_CRIT.USER-GROUP = VHCI01IW-TEMP-MI.USER-GRP;
    VHCI01E_CRIT.TERM-ID = VHCI01IW-TEMP-MI.TERM-LAST-UPD;

  
    VHCI01E_CRIT.REPT-TYPE = VHCI01IW.SCR-VEH-STAT;

  
    VHCI01E_CRIT.REPT-MISC = VHCI01IW-TEMP-MI.NEW-VEH-STAT;
    try
        call "VHCI01E"(XDCONTROL, VHCI01E_CRIT, VHCI01E_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else

    end
end 

Function VHCI01IS-CLEAR () 
    VHCI01IW.CAR-NO = " ";
    VHCI01IW.PM-LOC = " ";
    VHCI01IW.PM-TEAM = " ";
    VHCI01IW.STORE-STATUS = " ";
    VHCI01IW.SCR-DISP-VEH-STAT = " ";
    VHCI01IW.INCD-NO = " ";
    VHCI01IW.SELECTION-INDEX = 0;
    VHCI01IW.DISP-AREA-MSG = " ";
    VHCI01IW-TEMP-MI.NARR = " ";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    DISP-ERR-MSG = " ";
    set VHCI01B_DATA empty;
    VHCI01IW.DATE-STAT-CHG = VGVar.currentFormattedGregorianDate;
    VHCI01IW.TIME-STAT-CHG = VGVar.currentFormattedTime;
    VHCI01IW.DISP-TIME-STAT-CHG-HR = VHCI01IW.TIME-STAT-CHG-HR;
    VHCI01IW.DISP-TIME-STAT-CHG-MIN = VHCI01IW.TIME-STAT-CHG-MIN;
    if (ACTION-OPT == 1) 
        set VHCI01D_DATA empty;
        VHCI01IW.CAR-STATUS-COUNT = 0;
        LOAD-CAR-STATUS = "Y";
    else
        if (ACTION-OPT == 2) 
            set VHCI01A_DATA empty;
            VHCI01IW.CI-COUNT = 0;
            LOAD-DF = "Y";
        else
            if (ACTION-OPT == 3) 
                set VHCI01A_DATA empty;
                VHCI01IW.CI-COUNT = 0;
                LOAD-DI = "Y";
            else
                if (ACTION-OPT == 5) 
                    set VHCI01A_DATA empty;
                    VHCI01IW.CI-COUNT = 0;
                    LOAD-UD = "Y";
                else
                    if (ACTION-OPT == 6) 
                        set VHCI01A_DATA empty;
                        VHCI01IW.CI-COUNT = 0;
                        LOAD-FC = "Y";
                    else
                        if (ACTION-OPT == 7) 
                            set VHCI01A_DATA empty;
                            VHCI01IW.MOVE-INCDS-COUNT = 0;
                            LOAD-MOVE-INCDS = "Y";
                        end
                    end
                end
            end
        end
    end
    ENABLE-INCDLIST = "Y";
    DISABLE-CHANGE = "Y";
    ENABLE-INCDINFO = "Y";
    ENABLE-PMLOC = "Y";
    ENABLE-PMTEAM = "Y";
    ENABLE-NARR = "Y";
    ACTION-OPT = 1;
    VHCI01IW-TRIGGER.SHOW-STATUS = "Y";
    if (VHCI01IW.USER-GRP == "VEHSUPR")
        VHCI01IW.STATUS = "USABLE";
    else
        VHCI01IW.STATUS = "GO";
    end
    

  
    VHCI02IS-YRD-TRK();
    CARNO-SETFOCUS = "Y";
end 

Function VHCI01IS-CLR-AFTDB () 
    VHCI01IW.CAR-NO = " ";
    VHCI01IW.PM-LOC = " ";
  
    VHCI01IW.STORE-STATUS = " ";
    VHCI01IW.SCR-DISP-VEH-STAT = " ";
    VHCI01IW.INCD-NO = " ";
    VHCI01IW.SELECTION-INDEX = 0;
    VHCI01IW-TEMP-MI.NARR = " ";
    DISP-ERR-MSG = " ";
    VHCI01IW.PM-TEAM = " ";
    set VHCI01B_DATA empty;
    VHCI01IW.DATE-STAT-CHG = VGVar.currentFormattedGregorianDate;
    VHCI01IW.TIME-STAT-CHG = VGVar.currentFormattedTime;
    VHCI01IW.DISP-TIME-STAT-CHG-HR = VHCI01IW.TIME-STAT-CHG-HR;
    VHCI01IW.DISP-TIME-STAT-CHG-MIN = VHCI01IW.TIME-STAT-CHG-MIN;
    if (ACTION-OPT == 1) 
        set VHCI01D_DATA empty;
        VHCI01IW.CAR-STATUS-COUNT = 0;
        LOAD-CAR-STATUS = "Y";
    else
        if (ACTION-OPT == 2) 
            set VHCI01A_DATA empty;
            VHCI01IW.CI-COUNT = 0;
            LOAD-DF = "Y";
        else
            if (ACTION-OPT == 3) 
                set VHCI01A_DATA empty;
                VHCI01IW.CI-COUNT = 0;
                LOAD-DI = "Y";
            else
                if (ACTION-OPT == 5) 
                    set VHCI01A_DATA empty;
                    VHCI01IW.CI-COUNT = 0;
                    LOAD-UD = "Y";
                else
                    if (ACTION-OPT == 6) 
                        set VHCI01A_DATA empty;
                        VHCI01IW.CI-COUNT = 0;
                        LOAD-FC = "Y";
                    else
                        if (ACTION-OPT == 7) 
                            set VHCI01A_DATA empty;
                            VHCI01IW.MOVE-INCDS-COUNT = 0;
                            LOAD-MOVE-INCDS = "Y";
                        end
                    end
                end
            end
        end
    end
    ENABLE-INCDLIST = "Y";
    DISABLE-CHANGE = "Y";
    ENABLE-INCDINFO = "Y";
    ENABLE-PMLOC = "Y";
    ENABLE-NARR = "Y";
  
    ACTION-OPT = 1;
    VHCI01IW-TRIGGER.SHOW-STATUS = "Y";
    if (VHCI01IW.USER-GRP == "VEHSUPR")
        VHCI01IW.STATUS = "USABLE";
    else
        VHCI01IW.STATUS = "GO";
    end
    CARNO-SETFOCUS = "Y";
end 

Function VHCI01IS-CONFIG () 
    VHCI01F_CRIT.CAR-NO = VHCI01IW.CAR-NO;
    try
        call "VHCI01F"(XDCONTROL, VHCI01F_CRIT, VHCI01F_DATA);
    
    end
end 

Function VHCI01IS-CONFIG1 () 
    LOOP-INDEX = 1;
    move CAR-STATUS-COUNT to STORE-INCDS-COUNT withV60Compat;
    CONF-ERR-SW = " ";

  
    while ((LOOP-INDEX <= STORE-INCDS-COUNT))
        if (VHCI01D_DATA.CHANGE[LOOP-INDEX] == "YES" ||
         VHCI01D_DATA.CHANGE[LOOP-INDEX] == "Y")
            LOOP-INDEX = LOOP-INDEX + 1;
        else
            if (VHCI01D_DATA.WORST-CASE-RANK[LOOP-INDEX] >= 60)
                LOOP-INDEX = LOOP-INDEX + 1;
                CONF-ERR-SW = "Y";
            else
                CONF-ERR-SW = "Y";
                LOOP-INDEX = STORE-INCDS-COUNT + 1;
            end
        end
    end
    if (CONF-ERR-SW == " ")
        CONF-ERR-SW = "Y";
    end
end 

Function VHCI01IS-DF () 
    set VHCI01IW-TEMP-MI empty;
    VHCI01IW-TEMP-MI.ERR-FOUND = "N";
    VHCI01IW.DISP-AREA-MSG = " ";
    DISP-ERR-MSG = " ";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    CAR-ERROR = "N";
    LOOP-INDEX = 1;
    STORE-INDEX = 1;
    TEMP-INDEX = 0;
    move CI-COUNT to STORE-INCDS-COUNT withV60Compat;

  
    while ((LOOP-INDEX <= STORE-INCDS-COUNT))
        if (VHCI01D_DATA.CHANGE[LOOP-INDEX] != "A" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "B" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "C" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "D" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "E" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != " ")
            CAR-ERROR = "Y";
            DISP-ERR-MSG-1 = "Invalid Response for";
            DISP-ERR-MSG-2 = VHCI01D_DATA.INCD-NO[LOOP-INDEX];
            DISP-ERR-MSG-3 = " ";
            move DISP-ERR-MSG to FINAL-ERROR-MESSAGE withV60Compat;
            INCDINFO-SETFOCUS = "Y";
            move STORE-INCDS-COUNT to LOOP-INDEX withV60Compat;
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
    LOOP-INDEX = 1;
    if (CAR-ERROR == "N")
        while ((LOOP-INDEX <= VHCI01IW.CI-COUNT))
            if (VHCI01D_DATA.CHANGE[LOOP-INDEX] == "A" ||
             VHCI01D_DATA.CHANGE[LOOP-INDEX] == "B" ||
             VHCI01D_DATA.CHANGE[LOOP-INDEX] == "C"||
             VHCI01D_DATA.CHANGE[LOOP-INDEX] == "D" ||
             VHCI01D_DATA.CHANGE[LOOP-INDEX] == "E" )
                TEMP-INDEX = TEMP-INDEX + 1;
                VHCI01IW-TEMP-MI.DATA_ROW[TEMP-INDEX] = VHCI01D_DATA.DATA_ROW[LOOP-INDEX];
            end
            LOOP-INDEX = LOOP-INDEX + 1;
        end
        TEMP-INDEX = TEMP-INDEX + 1;
        if (TEMP-INDEX > 1)
            VHCI01IW-TEMP-MI.CHANGE[TEMP-INDEX] = VHCI01IW.CAR-NO;
            VHCI01IW-TEMP-MI.INCD-NO[TEMP-INDEX] = " ";
            VHCI01IW-TEMP-MI.DATE-STAT-CHG = VHCI01IW.DATE-STAT-CHG;
            VHCI01IW.TIME-STAT-CHG-HR = VHCI01IW.DISP-TIME-STAT-CHG-HR;
            VHCI01IW.TIME-STAT-CHG-FILLER1 = ":";
            VHCI01IW.TIME-STAT-CHG-MIN = VHCI01IW.DISP-TIME-STAT-CHG-MIN;
            VHCI01IW.TIME-STAT-CHG-FILLER2 = ":";
            VHCI01IW.TIME-STAT-CHG-SEC = 00;
            VHCI01IW-TEMP-MI.TIME-STAT-CHG = VHCI01IW.TIME-STAT-CHG;
            VHCI01IW-TEMP-MI.STORE-NARR-CI = "CI / ACTION- ";
            VHCI01IW-TEMP-MI.STORE-NARR-ACTION = "DF ";
            VHCI01IW-TEMP-MI.STORE-NARR-DATE = VGVar.currentFormattedGregorianDate;
            VHCI01IW-TEMP-MI.STORE-NARR-TIME = VGVar.currentFormattedTime;
            VHCI01IW-TEMP-MI.USER-GRP = VHCI01IW.USER-GRP;
            VHCI01IW-TEMP-MI.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
            VHCI01IW-TEMP-MI.NARR = VHCI01IW.NARR;
            VHCI01IW-TEMP-MI.ROW-COUNT = TEMP-INDEX;

      
            VHXREVA_CRIT.SEL-IDX = 1;
            VHXREVA_CRIT.SYSTEM-DATE = VHCI01IW-TEMP-MI.DATE-STAT-CHG;
            VHXREVA_CRIT.SYSTEM-TIME = VHCI01IW-TEMP-MI.TIME-STAT-CHG;
            try
                call "VHXREVA"(XDCONTROL, VHXREVA_CRIT, VHXREVA_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                XXDATEW.DATE-MM-DD-YYYY = VHXREVA_DATA.REVENUE-DATE;
                XXDATEW.VAGen_FUNCTION = "YMD";
                MRSCommonCode.XXDATES-CONVERT();
                VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = XXDATEW.DATE-YYYY-MM-DD;
            else
                VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = " ";
            end
            try
                call "VHCIR"(XDCONTROL, VHCI01IW-TEMP-MI);
            
            end
            if (VHCI01IW-TEMP-MI.ERR-FOUND == "N")
                VHCI01IS-MOVE-REC();
                VHCI01IW-TRIGGER-X.LOAD-DF = "Y";
                VHCI01IW.STORE-ERR-MSG[1] = "Incidents changed, !";
                if (VHCI01IW-TEMP-MI.STATUS-UPD == "Y")
                    VHCI01IS-CICS-MSG(); 
                    VHCI01IW.SCR-VEH-STAT = VHCI01IW-TEMP-MI.NEW-VEH-STAT;
                    VHCI01IW.SCR-VEH-STAT-DESC = VHCI01IW-TEMP-MI.NEW-VEH-STAT-DESC;
                    VHCI02IS-STAT(); 
                end
                if (VHCI01IW-TEMP-MI.FINAL-INCD-COUNT > 0)
                    VHCI01IW.STORE-ERR-MSG[4] = "Open Incidents remain!";
                else
                    VHCI01IW.STORE-ERR-MSG[4] = "!";
                end
                VHCI01IS-ERR-MSG(); 
                VHCI01IS-CLR-AFTDB(); 
                                   
            else
                DISABLE-CHANGE = "Y";
                DISABLE-INCDINFO = "Y";
                VHCI01IW-TRIGGER-X.LOAD-DF = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

Function VHCI01IS-DI () 
    set VHCI01IW-TEMP-MI empty;
    VHCI01IW-TEMP-MI.ERR-FOUND = "N";
    DISP-ERR-MSG = " ";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    CAR-ERROR = "N";
    LOOP-INDEX = 1;
    STORE-INDEX = 1;
    TEMP-INDEX = 0;
    move CI-COUNT to STORE-INCDS-COUNT withV60Compat;

  
    while ((LOOP-INDEX <= STORE-INCDS-COUNT))
        if (VHCI01D_DATA.CHANGE[LOOP-INDEX] != "YES" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "Y" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "NO" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "N" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != " ")
            CAR-ERROR = "Y";
            DISP-ERR-MSG-1 = "Invalid Response for";
            DISP-ERR-MSG-2 = VHCI01D_DATA.INCD-NO[LOOP-INDEX];
            DISP-ERR-MSG-3 = " ";
            move DISP-ERR-MSG to FINAL-ERROR-MESSAGE withV60Compat;
            INCDINFO-SETFOCUS = "Y";
            move STORE-INCDS-COUNT to LOOP-INDEX withV60Compat;
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
    LOOP-INDEX = 1;
    if (CAR-ERROR == "N")
        while ((LOOP-INDEX <= VHCI01IW.CI-COUNT))
            if (VHCI01D_DATA.CHANGE[LOOP-INDEX] == "Y" ||
             VHCI01D_DATA.CHANGE[LOOP-INDEX] == "YES")
                TEMP-INDEX = TEMP-INDEX + 1;
                VHCI01IW-TEMP-MI.DATA_ROW[TEMP-INDEX] = VHCI01D_DATA.DATA_ROW[LOOP-INDEX];
            end
            LOOP-INDEX = LOOP-INDEX + 1;
        end
        TEMP-INDEX = TEMP-INDEX + 1;
        if (TEMP-INDEX > 1)
            VHCI01IW-TEMP-MI.CHANGE[TEMP-INDEX] = VHCI01IW.CAR-NO;
            VHCI01IW-TEMP-MI.INCD-NO[TEMP-INDEX] = " ";
            VHCI01IW-TEMP-MI.DATE-STAT-CHG = VHCI01IW.DATE-STAT-CHG;
            VHCI01IW.TIME-STAT-CHG-HR = VHCI01IW.DISP-TIME-STAT-CHG-HR;
            VHCI01IW.TIME-STAT-CHG-FILLER1 = ":";
            VHCI01IW.TIME-STAT-CHG-MIN = VHCI01IW.DISP-TIME-STAT-CHG-MIN;
            VHCI01IW.TIME-STAT-CHG-FILLER2 = ":";
            VHCI01IW.TIME-STAT-CHG-SEC = 00;
            VHCI01IW-TEMP-MI.TIME-STAT-CHG = VHCI01IW.TIME-STAT-CHG;
            VHCI01IW-TEMP-MI.STORE-NARR-CI = "CI / ACTION- ";
            VHCI01IW-TEMP-MI.STORE-NARR-ACTION = "DI ";
            VHCI01IW-TEMP-MI.STORE-NARR-DATE = VGVar.currentFormattedGregorianDate;
            VHCI01IW-TEMP-MI.STORE-NARR-TIME = VGVar.currentFormattedTime;
            VHCI01IW-TEMP-MI.USER-GRP = VHCI01IW.USER-GRP;
            VHCI01IW-TEMP-MI.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
            VHCI01IW-TEMP-MI.NARR = " ";
            VHCI01IW-TEMP-MI.ROW-COUNT = TEMP-INDEX;

      
            VHXREVA_CRIT.SEL-IDX = 1;
            VHXREVA_CRIT.SYSTEM-DATE = VHCI01IW-TEMP-MI.DATE-STAT-CHG;
            VHXREVA_CRIT.SYSTEM-TIME = VHCI01IW-TEMP-MI.TIME-STAT-CHG;
            try
                call "VHXREVA"(XDCONTROL, VHXREVA_CRIT, VHXREVA_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                XXDATEW.DATE-MM-DD-YYYY = VHXREVA_DATA.REVENUE-DATE;
                XXDATEW.VAGen_FUNCTION = "YMD";
                MRSCommonCode.XXDATES-CONVERT();
                VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = XXDATEW.DATE-YYYY-MM-DD;
            else
                VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = " ";
            end
            try
                call "VHCIU"(XDCONTROL, VHCI01IW-TEMP-MI);
            
            end
            if (VHCI01IW-TEMP-MI.ERR-FOUND == "N")
                VHCI01IS-MOVE-REC();
                VHCI01IW-TRIGGER-X.LOAD-DI = "Y";
                if (VHCI01IW-TEMP-MI.DISP-MOVE-MSG == "Y")
                    VHCI01IW.STORE-ERR-MSG[1] = "Modify counts as needed for DVS Report. Incidents changed, !";
                else
                    VHCI01IW.STORE-ERR-MSG[1] = "Incidents changed, !";
                end
                if (VHCI01IW-TEMP-MI.STATUS-UPD == "Y")
                    VHCI01IS-CICS-MSG(); 
                    VHCI01IW.SCR-VEH-STAT = VHCI01IW-TEMP-MI.NEW-VEH-STAT;
                    VHCI01IW.SCR-VEH-STAT-DESC = VHCI01IW-TEMP-MI.NEW-VEH-STAT-DESC;
                    VHCI02IS-STAT(); 
                end
                VHCI02D_CRIT.UPDATE-FLAG = "DI";
                VHCI02IS-UPD-TRK();
                if (VHCI01IW-TEMP-MI.FINAL-INCD-COUNT > 0)
                    VHCI01IW.STORE-ERR-MSG[4] = "Open Incidents remain!";
                else
                    VHCI01IW.STORE-ERR-MSG[4] = "!";
                end
                VHCI01IS-ERR-MSG(); 
                VHCI01IS-CLR-AFTDB(); 
                                   
            else
                DISABLE-CHANGE = "Y";
                DISABLE-INCDINFO = "Y";
                VHCI01IW-TRIGGER-X.LOAD-DI = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

Function VHCI01IS-ERR () 
    set VHCI01IW-TEMP-MI empty;
    VHCI01IW-TEMP-MI.ERR-FOUND = "N";
    DISP-ERR-MSG = " ";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    CAR-ERROR = "N";
    LOOP-INDEX = 1;
    STORE-INDEX = 1;
    TEMP-INDEX = 1;
    VHCI01IW-TEMP-MI.CHANGE[1] = VHCI01IW.CAR-NO;
    VHCI01IW-TEMP-MI.INCD-NO[1] = " ";
    VHCI01IW-TEMP-MI.DATE-STAT-CHG = VHCI01IW.DATE-STAT-CHG;
    VHCI01IW.TIME-STAT-CHG-HR = VHCI01IW.DISP-TIME-STAT-CHG-HR;
    VHCI01IW.TIME-STAT-CHG-FILLER1 = ":";
    VHCI01IW.TIME-STAT-CHG-MIN = VHCI01IW.DISP-TIME-STAT-CHG-MIN;
    VHCI01IW.TIME-STAT-CHG-FILLER2 = ":";
    VHCI01IW.TIME-STAT-CHG-SEC = 00;
    VHCI01IW-TEMP-MI.TIME-STAT-CHG = VHCI01IW.TIME-STAT-CHG;
    VHCI01IW-TEMP-MI.STORE-NARR-CI = "CI / ACTION- ";
    VHCI01IW-TEMP-MI.STORE-NARR-ACTION = "ER ";
    VHCI01IW-TEMP-MI.STORE-NARR-DATE = VGVar.currentFormattedGregorianDate;
    VHCI01IW-TEMP-MI.STORE-NARR-TIME = VGVar.currentFormattedTime;
    VHCI01IW-TEMP-MI.USER-GRP = VHCI01IW.USER-GRP;
    VHCI01IW-TEMP-MI.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
    VHCI01IW-TEMP-MI.PM-LOC = " ";
    VHCI01IW-TEMP-MI.NARR = VHCI01IW.NARR;
    VHCI01IW-TEMP-MI.CAR-STATUS = VHCI01IW.STATUS;
    VHCI01IW-TEMP-MI.ROW-COUNT = TEMP-INDEX;

  
    VHXREVA_CRIT.SEL-IDX = 1;
    VHXREVA_CRIT.SYSTEM-DATE = VHCI01IW-TEMP-MI.DATE-STAT-CHG;
    VHXREVA_CRIT.SYSTEM-TIME = VHCI01IW-TEMP-MI.TIME-STAT-CHG;
    try
        call "VHXREVA"(XDCONTROL, VHXREVA_CRIT, VHXREVA_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        XXDATEW.DATE-MM-DD-YYYY = VHXREVA_DATA.REVENUE-DATE;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = XXDATEW.DATE-YYYY-MM-DD;
    else
        VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = " ";
    end

  
    try
        call "VHCIS"(XDCONTROL, VHCI01IW-TEMP-MI);
    
    end
    if (VHCI01IW-TEMP-MI.ERR-FOUND == "N")
        VHCI01IW.STORE-ERR-MSG[1] = " ";
        if (VHCI01IW-TEMP-MI.STATUS-UPD == "Y")
            VHCI01IS-CICS-MSG(); 
            VHCI01IW.SCR-VEH-STAT = VHCI01IW-TEMP-MI.NEW-VEH-STAT;
            VHCI01IW.SCR-VEH-STAT-DESC = VHCI01IW-TEMP-MI.NEW-VEH-STAT-DESC;
            VHCI02IS-STAT(); 
        end
        if (VHCI01IW-TEMP-MI.FINAL-INCD-COUNT > 0)
            VHCI01IW.STORE-ERR-MSG[4] = "Open Incidents remain!";
        else
            VHCI01IW.STORE-ERR-MSG[4] = "!";
        end
        VHCI01IS-ERR-MSG(); 
        VHCI01IS-CLR-AFTDB(); 
                                   
    else
        DISABLE-CHANGE = "Y";
        DISABLE-INCDINFO = "Y";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHCI01IS-ERR-MSG () 
    OUTER-INDEX = 1;
    CONCAT-INDEX = 0;
    CONCAT-MESSAGE = " ";
    while ((OUTER-INDEX <= 4 && STORE-ERR-MSG[OUTER-INDEX] != " "))
        TEMP-ERROR-MESSAGE = STORE-ERR-MSG[OUTER-INDEX];
        INNER-INDEX = 1;
        while ((TEMP-ERROR-MESSAGE-1[INNER-INDEX] != "!"))
            CONCAT-INDEX = CONCAT-INDEX + 1;
            CONCAT-ERR-MSG[CONCAT-INDEX] = TEMP-ERROR-MESSAGE-1[INNER-INDEX];
            INNER-INDEX = INNER-INDEX + 1;
        end
        TEMP-ERROR-MESSAGE = " ";
        OUTER-INDEX = OUTER-INDEX + 1;
    end
    move CONCAT-MESSAGE to FINAL-ERROR-MESSAGE withV60Compat;
end 

Function VHCI01IS-FC () 
    set VHCI01IW-TEMP-MI empty;
    VHCI01IW-TEMP-MI.ERR-FOUND = "N";
    DISP-ERR-MSG = " ";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    CAR-ERROR = "N";
    LOOP-INDEX = 1;
    STORE-INDEX = 1;
    TEMP-INDEX = 0;
    move CI-COUNT to STORE-INCDS-COUNT withV60Compat;

  
    while ((LOOP-INDEX <= STORE-INCDS-COUNT))
        if (VHCI01D_DATA.CHANGE[LOOP-INDEX] != "YES" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "Y" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "NO" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "N" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != " ")
            CAR-ERROR = "Y";
            DISP-ERR-MSG-1 = "Invalid Response for";
            DISP-ERR-MSG-2 = VHCI01D_DATA.INCD-NO[LOOP-INDEX];
            DISP-ERR-MSG-3 = " ";
            move DISP-ERR-MSG to FINAL-ERROR-MESSAGE withV60Compat;
            INCDINFO-SETFOCUS = "Y";
            move STORE-INCDS-COUNT to LOOP-INDEX withV60Compat;
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
    LOOP-INDEX = 1;
    if (CAR-ERROR == "N")
        while ((LOOP-INDEX <= VHCI01IW.CI-COUNT))
            if (VHCI01D_DATA.CHANGE[LOOP-INDEX] == "Y" ||
             VHCI01D_DATA.CHANGE[LOOP-INDEX] == "YES")
                TEMP-INDEX = TEMP-INDEX + 1;
                VHCI01IW-TEMP-MI.DATA_ROW[TEMP-INDEX] = VHCI01D_DATA.DATA_ROW[LOOP-INDEX];
            end
            LOOP-INDEX = LOOP-INDEX + 1;
        end
        TEMP-INDEX = TEMP-INDEX + 1;
        if (TEMP-INDEX > 1)
            VHCI01IW-TEMP-MI.CHANGE[TEMP-INDEX] = VHCI01IW.CAR-NO;
            VHCI01IW-TEMP-MI.INCD-NO[TEMP-INDEX] = " ";
            VHCI01IW-TEMP-MI.DATE-STAT-CHG = VHCI01IW.DATE-STAT-CHG;
            VHCI01IW.TIME-STAT-CHG-HR = VHCI01IW.DISP-TIME-STAT-CHG-HR;
            VHCI01IW.TIME-STAT-CHG-FILLER1 = ":";
            VHCI01IW.TIME-STAT-CHG-MIN = VHCI01IW.DISP-TIME-STAT-CHG-MIN;
            VHCI01IW.TIME-STAT-CHG-FILLER2 = ":";
            VHCI01IW.TIME-STAT-CHG-SEC = 00;
            VHCI01IW-TEMP-MI.TIME-STAT-CHG = VHCI01IW.TIME-STAT-CHG;
            VHCI01IW-TEMP-MI.STORE-NARR-CI = "CI / ACTION- ";
            VHCI01IW-TEMP-MI.STORE-NARR-ACTION = "FC ";
            VHCI01IW-TEMP-MI.STORE-NARR-DATE = VGVar.currentFormattedGregorianDate;
            VHCI01IW-TEMP-MI.STORE-NARR-TIME = VGVar.currentFormattedTime;
            VHCI01IW-TEMP-MI.USER-GRP = VHCI01IW.USER-GRP;
            VHCI01IW-TEMP-MI.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
            VHCI01IW-TEMP-MI.NARR = VHCI01IW.NARR;
            VHCI01IW-TEMP-MI.ROW-COUNT = TEMP-INDEX;

      
            VHXREVA_CRIT.SEL-IDX = 1;
            VHXREVA_CRIT.SYSTEM-DATE = VHCI01IW-TEMP-MI.DATE-STAT-CHG;
            VHXREVA_CRIT.SYSTEM-TIME = VHCI01IW-TEMP-MI.TIME-STAT-CHG;
            try
                call "VHXREVA"(XDCONTROL, VHXREVA_CRIT, VHXREVA_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                XXDATEW.DATE-MM-DD-YYYY = VHXREVA_DATA.REVENUE-DATE;
                XXDATEW.VAGen_FUNCTION = "YMD";
                MRSCommonCode.XXDATES-CONVERT();
                VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = XXDATEW.DATE-YYYY-MM-DD;
            else
                VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = " ";
            end
            try
                call "VHCIP"(XDCONTROL, VHCI01IW-TEMP-MI);
            
            end
            if (VHCI01IW-TEMP-MI.ERR-FOUND == "N")
                VHCI01IS-MOVE-REC();
                VHCI01IW-TRIGGER-X.LOAD-FC = "Y";
                VHCI01IW.STORE-ERR-MSG[1] = "Incidents changed, !";
                if (VHCI01IW-TEMP-MI.STATUS-UPD == "Y")
                    VHCI01IS-CICS-MSG(); 
                    VHCI01IW.SCR-VEH-STAT = VHCI01IW-TEMP-MI.NEW-VEH-STAT;
                    VHCI01IW.SCR-VEH-STAT-DESC = VHCI01IW-TEMP-MI.NEW-VEH-STAT-DESC;
                    VHCI02IS-STAT(); 
                end
                if (VHCI01IW-TEMP-MI.FINAL-INCD-COUNT > 0)
                    VHCI01IW.STORE-ERR-MSG[4] = "Open Incidents remain!";
                else
                    VHCI01IW.STORE-ERR-MSG[4] = "!";
                end
                VHCI01IS-ERR-MSG(); 
                VHCI01IS-CLR-AFTDB(); 
                                   
            else
                DISABLE-CHANGE = "Y";
                DISABLE-INCDINFO = "Y";
                VHCI01IW-TRIGGER-X.LOAD-FC = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

Function VHCI01IS-GO-STATU2 () 
    set VHCI01IW-TEMP-MI empty;
    VHCI01IW-TEMP-MI.ERR-FOUND = "N";
    DISP-ERR-MSG = " ";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    CAR-ERROR = "N";
    LOOP-INDEX = 1;
    STORE-INDEX = 1;
    TEMP-INDEX = 0;
    move CAR-STATUS-COUNT to STORE-INCDS-COUNT withV60Compat;

  
    while ((LOOP-INDEX <= STORE-INCDS-COUNT))
        if (VHCI01D_DATA.CHANGE[LOOP-INDEX] != "YES" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "Y" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "NO" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "N" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != " ")
            CAR-ERROR = "Y";
            DISP-ERR-MSG-1 = "Invalid Response for";
            DISP-ERR-MSG-2 = VHCI01D_DATA.INCD-NO[LOOP-INDEX];
            DISP-ERR-MSG-3 = " ";
            move DISP-ERR-MSG to FINAL-ERROR-MESSAGE withV60Compat;
            INCDINFO-SETFOCUS = "Y";
            move STORE-INCDS-COUNT to LOOP-INDEX withV60Compat;
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
    LOOP-INDEX = 1;
    if (CAR-ERROR == "N")
        while ((LOOP-INDEX <= VHCI01IW.CAR-STATUS-COUNT))
            if (VHCI01D_DATA.CHANGE[LOOP-INDEX] == "Y" ||
             VHCI01D_DATA.CHANGE[LOOP-INDEX] == "YES")
                TEMP-INDEX = TEMP-INDEX + 1;
                VHCI01IW-TEMP-MI.DATA_ROW[TEMP-INDEX] = VHCI01D_DATA.DATA_ROW[LOOP-INDEX];
            end
            LOOP-INDEX = LOOP-INDEX + 1;
        end
        VHCI01IW.TOTAL-INCD = TEMP-INDEX;
        TEMP-INDEX = TEMP-INDEX + 1;
        if (TEMP-INDEX > 1)
            VHCI01IW-TEMP-MI.CHANGE[TEMP-INDEX] = VHCI01IW.CAR-NO;
            VHCI01IW-TEMP-MI.INCD-NO[TEMP-INDEX] = " ";
            VHCI01IW-TEMP-MI.DATE-STAT-CHG = VHCI01IW.DATE-STAT-CHG;
            VHCI01IW.TIME-STAT-CHG-HR = VHCI01IW.DISP-TIME-STAT-CHG-HR;
            VHCI01IW.TIME-STAT-CHG-FILLER1 = ":";
            VHCI01IW.TIME-STAT-CHG-MIN = VHCI01IW.DISP-TIME-STAT-CHG-MIN;
            VHCI01IW.TIME-STAT-CHG-FILLER2 = ":";
            VHCI01IW.TIME-STAT-CHG-SEC = 00;
            VHCI01IW-TEMP-MI.TIME-STAT-CHG = VHCI01IW.TIME-STAT-CHG;
            VHCI01IW-TEMP-MI.STORE-NARR-CI = "CI / ACTION- ";
            VHCI01IW-TEMP-MI.STORE-NARR-ACTION = "GO ";
            VHCI01IW-TEMP-MI.STORE-NARR-DATE = VGVar.currentFormattedGregorianDate;
            VHCI01IW-TEMP-MI.STORE-NARR-TIME = VGVar.currentFormattedTime;
            VHCI01IW-TEMP-MI.USER-GRP = VHCI01IW.USER-GRP;
            VHCI01IW-TEMP-MI.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
            VHCI01IW-TEMP-MI.NARR = VHCI01IW.NARR;
            VHCI01IW-TEMP-MI.ROW-COUNT = TEMP-INDEX;

      
            XXDATEW.DATE-MM-DD-YYYY = VHCI01IW-TEMP-MI.DATE-STAT-CHG;
            XXDATEW.VAGen_FUNCTION = "YMD";
            MRSCommonCode.XXDATES-CONVERT();
            VHINVB_CRIT.INPUT-DATE = XXDATEW.DATE-YYYY-MM-DD;
            VHINVB_CRIT.INPUT-TIME = VHCI01IW-TEMP-MI.TIME-STAT-CHG;
            VHINVB_CRIT.USER-TERM-ID = VHCI01IW.TERM-LAST-UPD;
            try
                call "VHINVB"(XDCONTROL, VHINVB_DATA, VHINVB_CRIT);
            
            end
            VHCI01IW-TEMP-MI.YRD-TRKG-YRD = VHCI02IW-YRD-TRK.YRD-TRKG-YRD;
            VHCIY_CRIT_X.PM-TEAM = VHCI01IW.PM-TEAM;
            try
                call "VHCIY"(XDCONTROL, VHCI01IW-TEMP-MI, VHCIY_CRIT_X);
            
            end
            if (VHCI01IW-TEMP-MI.ERR-FOUND == "N")
                VHCI01IS-MOVE-REC();
                VHCI01IW-TRIGGER-X.LOAD-CAR-STATUS = "Y";
                if (VHCI01IW-TEMP-MI.DISP-MOVE-MSG == "Y")
                    VHCI01IW.STORE-ERR-MSG[1] = "Modify counts as needed for DVS Report. Incidents changed, !";
                else
                    VHCI01IW.STORE-ERR-MSG[1] = "Incidents changed, !";
                end
                if (VHCI01IW-TEMP-MI.STATUS-UPD == "Y")
                    VHCI01IS-CICS-MSG(); 
                    VHCI01IW.SCR-VEH-STAT = VHCI01IW-TEMP-MI.NEW-VEH-STAT;
                    VHCI01IW.SCR-VEH-STAT-DESC = VHCI01IW-TEMP-MI.NEW-VEH-STAT-DESC;
                    VHCI02IS-STAT(); 
                    VHCI02D_CRIT.UPDATE-FLAG = "GO";
                    VHCI02IS-UPD-TRK();
                    if (VHCI01IW-TEMP-MI.INTO-SHOP-UPD == "Y")
                        VHCI01IS-SHOP-STAT();
                    end
                end
                if (VHCI01IW-TEMP-MI.FINAL-INCD-COUNT > 0)
                    VHCI01IW.STORE-ERR-MSG[4] = "Open Incidents remain!";
                else
                    VHCI01IW.STORE-ERR-MSG[4] = "!";
                end
                VHCI01IS-ERR-MSG(); 
                VHCI01IS-CLR-AFTDB(); 
                                   
            else
                DISABLE-CHANGE = "Y";
                DISABLE-INCDINFO = "Y";
                VHCI01IW-TRIGGER-X.LOAD-CAR-STATUS = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

