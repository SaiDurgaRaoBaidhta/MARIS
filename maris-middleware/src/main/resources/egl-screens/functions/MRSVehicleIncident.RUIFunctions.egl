

package MRSVehicleIncident;


Function VH001IS-ACCE-RFX () 
    if ("pbtRevenueFixIncident" in VH01A02_DATA.PART-NAME)
        if (VH01A02_DATA.ACCESS-ALLOW[sysVar.arrayIndex] == "N")
            VH001IW-BUTTOM.DISABLE-REV-FIX-INCIDENT = "Y";
            VH001IS-MESSAGEX();
        else
            VH001IW-BUTTOM.ENABLE-REV-FIX-INCIDENT = "Y";
            VH001IW-PASSVALUE.FIX-IND = "REV";
            VH001IW-BUTTOM.OPEN-REV-FIX-INCIDENT = "Y";
        end
    else
        VH001IW-BUTTOM.ENABLE-REV-FIX-INCIDENT = "Y";
        VH001IW-PASSVALUE.FIX-IND = "REV";
        VH001IW-BUTTOM.OPEN-REV-FIX-INCIDENT = "Y";
    end
end 

Function VH001IS-ACCE-RIX () 
    if ("pbtRevenueIncident" in VH01A02_DATA.PART-NAME)
