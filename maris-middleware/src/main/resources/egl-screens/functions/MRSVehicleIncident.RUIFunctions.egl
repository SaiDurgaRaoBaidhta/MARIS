    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    DISABLE-PREV = "Y";
    DISABLE-NEXT = "Y";
    ENABLE-INCDDET = "Y";
    DISABLE-ADDNARR = "Y";
    ENABLE-INCDNARR = "Y";
    ENABLE-SYMPCD = "Y";
    ENABLE-SPEED = "Y";
    ENABLE-CONDIRECTION = "Y";
    ENABLE-INCDLOC = "Y";
    ENABLE-FIELDS = "Y";
    VHINC06IW.NARR-NO = 1;
    VHINC06IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHINC06IW.TIME-NARR = VGVar.currentFormattedTime;
    VHINC06IW.TIME-NARR-FILLER-1 = ":";
    VHINC06IW.TIME-NARR-FILLER-2 = " ";
    ENABLE-CREATE = "Y";
    BUTTON-CAPTION = "Create";
    CARNO-SETFOCUS = "Y";
end 

