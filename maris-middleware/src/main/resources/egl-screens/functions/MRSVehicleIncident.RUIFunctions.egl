Function VHCI01IS-ACT-ERR () 
    ERROR-MSG = "N";
    set VHCI01IW-TEMP-MI empty;
    set VHCI01D_DATA empty;
    VHCI01IW.CI-COUNT = 0;
    VHCI01IW.MOVE-INCDS-COUNT = 0;
    VHCI01IW.CAR-STATUS-COUNT = 0;
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    DISP-ERR-MSG = " ";
    ENABLE-INCDINFO = "Y";
    if (ERROR-MSG == "N")
  
  
        VHCI01B_DATA.CAR-NO = VHCI01IW.CAR-NO;
        try
            call "VHCI01B"(XDCONTROL, VHCI01B_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCI01IW.SCR-DISP-VEH-STAT = VHCI01B_DATA.DISP-VEH-STAT;
            VHCI01IW.CON-NO = VHCI01B_DATA.CON-NO;
            if (VHCI01B_DATA.WHERE-IS-CAR == "CON")
                ERROR-MSG = "Y";
                DISABLE-CHANGE = "Y";
                VHCI01IW.FINAL-ERROR-MESSAGE = "Car In Use.";
                CAR-ON-CONSIST = "Y";
            else
                if (VHCI01B_DATA.CAR-TYPE-1 == "D")
                    ERROR-MSG = "Y";
                    DISABLE-CHANGE = "Y";
                    VHCI01IW.FINAL-ERROR-MESSAGE = "Not valid for Dummy cars.";
                    DUMMY-CAR = "Y";
                else
                    if (VHCI01IW.CAR-NO == "0095" &&
                     VHCI01B_DATA.CAR-TYPE-1 == "T" &&
                     VHCI01IW.ACTION-OPT != 7)
                        VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid Action for Car.";
                        INVALID-ACTION = "Y";
                        ERROR-MSG = "Y";
                        DISABLE-CHANGE = "Y";
                        LOAD-MOVE-INCDS = "Y";
                    else
                        if (VHCI01B_DATA.VEH-STAT == "GO" ||
                         VHCI01B_DATA.VEH-STAT == "USABLE")
                            ERROR-MSG = "Y";
                            DISP-ERR-MSG = "Car not No Go";
                        else
                            if (VHCI01B_DATA.VEH-STAT == "ERROR")
                                DISP-ERR-MSG = "Invalid Action for Car";
                                ERROR-MSG = "Y";
                            end
                        end
                        if (ERROR-MSG == "Y")
                            VHCI01IW.FINAL-ERROR-MESSAGE = DISP-ERR-MSG;
                            DISABLE-CHANGE = "Y";
                            CARNO-SETFOCUS = "Y";
                            LOAD-MOVE-INCDS = "Y";
                            LOAD-CAR-STATUS = "Y";
                            LOAD-DI = "Y";
                            LOAD-UD = "Y";
                        else
                            ENABLE-CHANGE = "Y";
                        end
                    end
                end
            end
        else
            if (XDCONTROL.URC == 100)
                ERROR-MSG = "Y";
                DISABLE-CHANGE = "Y";
                VHCI01IW.FINAL-ERROR-MESSAGE = "Car not found in the database.";
                CAR-NOT-FOUND = "Y";
            else
                ERROR-MSG = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

