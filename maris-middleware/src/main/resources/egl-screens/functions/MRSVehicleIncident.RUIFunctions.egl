    VHVM11IW-PASS-DATA.EVENT-TYPE = VHCI01IW-TEMP-MI.SAVE-INCD-TYPE;
    VHCI01IW-TEMP-MI.DATE-INIT-YYYY = VHCI01IW-TEMP-MI.DATE-INCD-YYYY;
    VHCI01IW-TEMP-MI.DATE-INIT-MM = VHCI01IW-TEMP-MI.DATE-INCD-MM;
    VHCI01IW-TEMP-MI.DATE-INIT-DD = VHCI01IW-TEMP-MI.DATE-INCD-DD;
