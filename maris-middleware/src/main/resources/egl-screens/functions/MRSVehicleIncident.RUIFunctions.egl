Function VHCI01IS-INIT ()
    
    try
        call "VHCI02G"(XDCONTROL, VHCI02G_CRIT, VHCI02G_DATA);
    
    end
    if (XDCONTROL.UROWCNT == 1)
        VHCI01IW.DATE-STAT-CHG = VHCI02G_CRIT.CURRENT-DATE;
        VHCI01IW.TIME-STAT-CHG = VHCI02G_CRIT.CURRENT-TIME;
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    VHCI01IW.DISP-TIME-STAT-CHG-HR = VHCI01IW.TIME-STAT-CHG-HR;
    VHCI01IW.DISP-TIME-STAT-CHG-MIN = VHCI01IW.TIME-STAT-CHG-MIN;
    MRSCommonCode.XDATECON-LOAD-TBL();
    DISABLE-CHANGE = "Y";
    DISABLE-MAINT-ACT = "Y";
    DISABLE-INCDINFO = "Y";
    ENABLE-INCDLIST = "Y";
    ENABLE-NARR = "Y";
    ENABLE-PMLOC = "Y";
    
  
    VHCI01IW.DISP-AREA-MSG = " ";
    VHCI01IW.CAR-NO = " ";
    VHCI01IW.PM-LOC = " ";
    VHCI01IW.NARR = " ";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    VHCI01IW.SCR-DISP-VEH-STAT = " ";
    VHCI01IW-TEMP-MI.NARR = " ";
    MOVE-INCDS-COUNT = 0;
    CAR-STATUS-COUNT = 0;
    CI-COUNT = 0;
    LOAD-MOVE-INCDS = "Y";
    LOAD-CAR-STATUS = "Y";
    LOAD-DI = "Y";
    LOAD-UD = "Y";
    


  
    if (VHCI02IW-YRD-TRK.WHICH-GUI == "VHYT10I")
        if (VHYT03IW-PASSVALUE.CAR-NO != " ")
            VHCI02IW-YRD-TRK.CAR-NO = VHYT03IW-PASSVALUE.CAR-NO;
        end
        VHCI02IW-YRD-TRK.YRD-TRKG-YRD = VHYT10IW-PASSVALUE.YRD-TRKG-YRD;
    else
        if (VHCI02IW-YRD-TRK.WHICH-GUI == "VHYT03I")
            if (VHYT03IW-PASSVALUE.CAR-NO != " ")
                VHCI02IW-YRD-TRK.CAR-NO = VHYT03IW-PASSVALUE.CAR-NO;
            end
            VHCI02IW-YRD-TRK.YRD-TRKG-YRD = VHYT03IW-PASSVALUE.YRD-TRKG-YRD;
        end
    end


  
    VHCI01IW.CAR-NO = VHCI02IW-YRD-TRK.CAR-NO;
    
  
   
  
    VHCI02IS-YRD-TRK();
end 

Function VHCI01IS-LIST () 
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    DISP-AREA-MSG = " ";
    VHCI01IW.CAR-NO = VHCI01IW.CAR-NO-NUM;
    VHCI01IW-SAVE.SAVE-CAR-NO = VHCI01IW.CAR-NO;
    if (VHCI01IW.CAR-NO == "0000")
        VHCI01IW.FINAL-ERROR-MESSAGE = "Please enter a valid car no.";
        VHCI01IW.CAR-NO = " ";
        INVALID-CAR-NO = "Y";
    else
        if (VHCI01IW.CAR-NO not numeric)
            VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid car no.";
            VHCI01IW.CAR-NO = " ";
            INVALID-CAR-NO = "Y";
        else
      
            VHINC6A_CRIT.CAR-NO = VHCI01IW.CAR-NO;
            try
                call "VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
            
            end
            if (XDCONTROL.UROWCNT == 1)

            else
                if (XDCONTROL.URC == 100)
                    VHCI01IW.FINAL-ERROR-MESSAGE = "Entered car no. does not exist in the database.";
                    INVALID-CAR-NO = "Y";
                    return;
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                end
            end
        end
        if (VHCI01IW.ACTION-OPT == 0)
            VHCI01IW.FINAL-ERROR-MESSAGE = "Please select an action option.";
            SELECT-OPTION = "Y";
        else
            VHCI01IW.STORE-STATUS = VHCI01IW.STATUS;
            if (VHCI01IW.ACTION-OPT == 1) 
                if (VHCI01IW.STATUS == " ")
                    VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid car status.";
                    INVALID-STATUS = "Y";
                else
                    VHCI01IW-TRIGGER.ACTION-CARSTATUS = "Y";
                end
            else
                if (VHCI01IW.ACTION-OPT == 2) 
                    VHCI01IW-TRIGGER.ACTION-DF = "Y";
                else
                    if (VHCI01IW.ACTION-OPT == 3) 
                        VHCI01IW-TRIGGER.ACTION-DI = "Y";
                    else
                        if (VHCI01IW.ACTION-OPT == 4) 
                            VHCI01IW-TRIGGER.ACTION-ERR = "Y";
                        else
                            if (VHCI01IW.ACTION-OPT == 5) 
                                VHCI01IW-TRIGGER.ACTION-UD = "Y";
                            else
                                if (VHCI01IW.ACTION-OPT == 6) 
                                    VHCI01IW-TRIGGER.ACTION-FC = "Y";
                                else
                                    if (VHCI01IW.ACTION-OPT == 7) 
                                        VHCI01IW-TRIGGER.ACTION-MOVE = "Y";
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHCI01IS-MOVE () 
    set VHCI01IW-TEMP-MI empty;
    VHCI01IW-TEMP-MI.ERR-FOUND = "N";
    SAME-CAR-NO = "N";
    LOOP-INDEX = 1;
    STORE-INDEX = 1;
    TEMP-INDEX = 0;
    move MOVE-INCDS-COUNT to STORE-INCDS-COUNT withV60Compat;
    VHCI01IW.ERROR-MESSAGE = " ";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    DISP-ERR-MSG = " ";
    while ((STORE-INDEX <= VHCI01IW.STORE-INCDS-COUNT))
        LOOP-INDEX = 1;
        while ((LOOP-INDEX <= VHCI01IW.MOVE-INCDS-COUNT))
            if (VHCI01A_DATA.INCD-NO[LOOP-INDEX] ==
             VHCI01IW-STORE-MI.INCD-NO[STORE-INDEX])
                if (VHCI01A_DATA.CHANGE[LOOP-INDEX] !=
                 VHCI01IW-STORE-MI.CHANGE[STORE-INDEX])
                    TEMP-INDEX = TEMP-INDEX + 1;
                    VHCI01IW-TEMP-MI.DATA_ROW[TEMP-INDEX] = VHCI01A_DATA.DATA_ROW[LOOP-INDEX];
                end
                move MOVE-INCDS-COUNT to LOOP-INDEX withV60Compat;
            end
            LOOP-INDEX = LOOP-INDEX + 1;
        end
        STORE-INDEX = STORE-INDEX + 1;
    end
    LOOP-INDEX = 1;
    
    while ((LOOP-INDEX <= TEMP-INDEX))
        if (VHCI01IW.CAR-NO == VHCI01IW-TEMP-MI.CHANGE[LOOP-INDEX])
            SAME-CAR-NO = "Y";
      
            FINAL-ERROR-MESSAGE = "Illogical Move";
            INCDINFO-SETFOCUS = "Y";
            move TEMP-INDEX to LOOP-INDEX withV60Compat;
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
    if (SAME-CAR-NO == "N")

    
        CAR-ERROR = "N";
        LOOP-INDEX = 1;
        while ((LOOP-INDEX <= TEMP-INDEX))
            VHCI01B_DATA.CAR-NO = VHCI01IW-TEMP-MI.CHANGE[LOOP-INDEX];
            try
                call "VHCI01B"(XDCONTROL, VHCI01B_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                if (VHCI01B_DATA.WHERE-IS-CAR == "CON")
                    CAR-ERROR = "Y";
                    move TEMP-INDEX to LOOP-INDEX withV60Compat;
                    DISP-ERR-MSG-1 = "Invalid - Car ";
                    DISP-ERR-MSG-2 = VHCI01B_DATA.CAR-NO;
                    DISP-ERR-MSG-3 = " In Use";
                    move DISP-ERR-MSG to FINAL-ERROR-MESSAGE withV60Compat;
                    INCDINFO-SETFOCUS = "Y";
                else
                    if (VHCI01B_DATA.CAR-TYPE-1 == "A" ||
                     VHCI01B_DATA.CAR-TYPE-1 == "B" ||
                     VHCI01B_DATA.CAR-TYPE-1 == "C" ||
                     VHCI01B_DATA.CAR-TYPE-1 == "D" ||
                     VHCI01B_DATA.CAR-TYPE-1 == "E" ||
                     VHCI01B_DATA.CAR-TYPE-1 == "K" ||                    
                     VHCI01B_DATA.CAR-TYPE-1 == "L" || VHCI01B_DATA.CAR-TYPE-1 == "M")

                    else
                        ERROR-MSG-1 = "Invalid car type for Car No ";
                        ERROR-MSG-2 = VHCI01IW-TEMP-MI.CHANGE[LOOP-INDEX];
                        ERROR-MSG-3 = " with Incd No. ";
                        ERROR-MSG-4 = VHCI01IW-TEMP-MI.INCD-NO[LOOP-INDEX];
                        move ERROR-MESSAGE to FINAL-ERROR-MESSAGE withV60Compat;
                        CAR-ERROR = "Y";
                        INVALID-CHANGE = "Y";
                        move TEMP-INDEX to LOOP-INDEX withV60Compat;
                    end
                end
            else
                if (XDCONTROL.URC == 100)
                    ERROR-MSG-1 = "Invalid Car no ";
                    ERROR-MSG-2 = VHCI01IW-TEMP-MI.CHANGE[LOOP-INDEX];
                    ERROR-MSG-3 = " for Incd No. ";
                    ERROR-MSG-4 = VHCI01IW-TEMP-MI.INCD-NO[LOOP-INDEX];
                    move ERROR-MESSAGE to FINAL-ERROR-MESSAGE withV60Compat;
                    CAR-ERROR = "Y";
                    INVALID-CHANGE = "Y";
                    move TEMP-INDEX to LOOP-INDEX withV60Compat;
                else
                    move TEMP-INDEX to LOOP-INDEX withV60Compat;
                    CAR-ERROR = "Y";
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end
            LOOP-INDEX = LOOP-INDEX + 1;
        end
        if (CAR-ERROR == "N" && VHCI01IW.CAR-NO == "0095")
         
         
            LOOP-INDEX = 1;
            while ((LOOP-INDEX <= TEMP-INDEX))
                VHCI01C_CRIT.CAR-ROW-COUNT = 0;
                VHCI01C_CRIT.INCD-NO = VHCI01IW-TEMP-MI.INCD-NO[LOOP-INDEX];
                VHCI01C_CRIT.CAR-NO = VHCI01IW-TEMP-MI.CHANGE[LOOP-INDEX];
                if (VHCI01C_CRIT.CAR-NO != "0099")
                    try
                        call "VHCI01C"(XDCONTROL, VHCI01C_CRIT);
                    
                    end
                    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                        if (VHCI01C_CRIT.CAR-ROW-COUNT == 1)

                        else
                            DISP-ERR-MSG-1 = "Car no";
                            DISP-ERR-MSG-2 = VHCI01C_CRIT.CAR-NO;
                            DISP-ERR-MSG-3 = " Invalid - Not same consist";
                            move DISP-ERR-MSG to FINAL-ERROR-MESSAGE withV60Compat;
                            CAR-ERROR = "Y";
                            INCDINFO-SETFOCUS = "Y";
                            move TEMP-INDEX to LOOP-INDEX withV60Compat;
                        end
                    end
                end
                LOOP-INDEX = LOOP-INDEX + 1;
            end
        else
            if (CAR-ERROR == "N")
         
         
                LOOP-INDEX = 1;
                while ((LOOP-INDEX <= TEMP-INDEX))
                    VHCI01C_CRIT.CAR-ROW-COUNT = 0;
                    if (VHCI01IW-TEMP-MI.INCD-TYPE[LOOP-INDEX] == "REV")
                        VHCI01C_CRIT.INCD-NO = VHCI01IW-TEMP-MI.INCD-NO[LOOP-INDEX];
                        VHCI01C_CRIT.CAR-NO = VHCI01IW-TEMP-MI.CHANGE[LOOP-INDEX];
                        if (VHCI01C_CRIT.CAR-NO != "0099")
                            try
                                call "VHCI01C"(XDCONTROL, VHCI01C_CRIT);
                            
                            end
                            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                                if (VHCI01C_CRIT.CAR-ROW-COUNT == 1)

                                else
                                    DISP-ERR-MSG-1 = "Car no";
                                    DISP-ERR-MSG-2 = VHCI01C_CRIT.CAR-NO;
                                    DISP-ERR-MSG-3 = " Invalid - Not same consist";
                                    move DISP-ERR-MSG to FINAL-ERROR-MESSAGE withV60Compat;
                                    CAR-ERROR = "Y";
                                    INCDINFO-SETFOCUS = "Y";
                                    move TEMP-INDEX to LOOP-INDEX withV60Compat;
                                end
                            end
                        end
                    end
                    LOOP-INDEX = LOOP-INDEX + 1;
                end
            end
        end
        if (CAR-ERROR == "N") 
            TEMP-INDEX = TEMP-INDEX + 1;
            VHCI01IW-TEMP-MI.CHANGE[TEMP-INDEX] = VHCI01IW.CAR-NO;
            VHCI01IW-TEMP-MI.INCD-NO[TEMP-INDEX] = " ";
            VHCI01IW-TEMP-MI.DATE-STAT-CHG = VHCI01IW.DATE-STAT-CHG;
            VHCI01IW.TIME-STAT-CHG-HR = VHCI01IW.DISP-TIME-STAT-CHG-HR;
            VHCI01IW.TIME-STAT-CHG-FILLER1 = ":";
            VHCI01IW.TIME-STAT-CHG-MIN = VHCI01IW.DISP-TIME-STAT-CHG-MIN;
            VHCI01IW.TIME-STAT-CHG-FILLER2 = ":";
            VHCI01IW.TIME-STAT-CHG-SEC = 00;
            VHCI01IW-TEMP-MI.TIME-STAT-CHG = VHCI01IW.TIME-STAT-CHG;
            VHCI01IW-TEMP-MI.ROW-COUNT = TEMP-INDEX;

      
  
  
  
  
  
  
  
  
  
  
  
  
            XXDATEW.DATE-MM-DD-YYYY = VHCI01IW-TEMP-MI.DATE-STAT-CHG;
            XXDATEW.VAGen_FUNCTION = "YMD";
            MRSCommonCode.XXDATES-CONVERT();
            VHINVB_CRIT.INPUT-DATE = XXDATEW.DATE-YYYY-MM-DD;
            VHINVB_CRIT.INPUT-TIME = VHCI01IW-TEMP-MI.TIME-STAT-CHG;
            VHINVB_CRIT.USER-TERM-ID = VHCI01IW.TERM-LAST-UPD;
            try
                call "VHINVB"(XDCONTROL, VHINVB_DATA, VHINVB_CRIT);
            
            end
            VHCI01IW-TEMP-MI.USER-GRP = VHCI01IW.USER-GRP;
            VHCI01IW-TEMP-MI.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
            try
                call "VHCIX"(XDCONTROL, VHCI01IW-TEMP-MI);
            
            end
            if (VHCI01IW-TEMP-MI.ERR-FOUND == "N")
                VHCI01IS-MOVE-REC();
                VHCI01IW-TRIGGER-X.LOAD-MOVE-INCDS = "Y";
                VHCI01IW.STORE-ERR-MSG[1] = "Incidents changed, !";
                if (VHCI01IW-TEMP-MI.STATUS-UPD == "Y")
                    VHCI01IS-CICS-MSG(); 
                    VHCI01IW.SCR-VEH-STAT = VHCI01IW-TEMP-MI.NEW-VEH-STAT;
                    VHCI01IW.SCR-VEH-STAT-DESC = VHCI01IW-TEMP-MI.NEW-VEH-STAT-DESC;
                    VHCI02IS-STAT(); 
                end
                VHCI01IS-ERR-MSG(); 
                VHCI01IS-CLR-AFTDB(); 
                                   
            else
                DISABLE-CHANGE = "Y";
                DISABLE-INCDINFO = "Y";
                VHCI01IW-TRIGGER-X.LOAD-MOVE-INCDS = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

Function VHCI01IS-MOVE-REC ()
  
  

  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
   

