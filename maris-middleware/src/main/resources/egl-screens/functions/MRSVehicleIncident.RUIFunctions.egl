Function VHINC06IS-CHK-DATA ()
   
    ERROR-MESSAGE = " ";
    ERROR-INDEX = 0;
    ERROR-COUNT = 0;
    TOTAL-MIN-DIFF = 0;
    JULIAN-DATE-QUOT = 0;
    JULIAN-DATE-REM = 0;
    JULIAN-DATE-YR-DIFF = 0;
    JULIAN-DATE-1 = 0;
    JULIAN-DATE-2 = 0;
    INVALID-CAR-NO = "N"; 
    INVALID-INCD-NARR = "N"; 
    INVALID-SYMP-CD = "N"; 
    INVALID-DATE-INCD = "N"; 
    INVALID-TIME-INCD = "N"; 
    INVALID-SPEED = "N"; 
    INVALID-SPEED-VAL = "N"; 
    INVALID-DIRECTION = "N"; 
    INVALID-INCD-LOC = "N"; 
    INVALID-DATE = "N"; 
    DAYS-GR-05 = "N"; 
    DISP-ERR-MSG = "N"; 
    DISP-INVALID-TIME = "N"; 
    DISP-TIME-ERRMSG = "N"; 
    INVALID-SYMPCD-VAL = "N"; 
    DISPLAY-INVALID-CAR-NO = "N"; 
    DISPLAY-NOT-IN-SVC = "N"; 
    VHINC06IW.CAR-NO = VHINC06IW.CAR-NO-NUM;
    if (VHINC06IW.CAR-NO == "0000")
        ERROR-COUNT = ERROR-COUNT + 1;
        VHINC06IW.CAR-NO = " ";
        INVALID-CAR-NO = "Y";
    end
    if (VHINC06IW.SYMP-CD == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-SYMP-CD = "Y";
    end
    if (VHINC06IW.DATE-INCD-OCCR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-DATE-INCD = "Y";
    else
        AFCXVLD_CRIT.FORM-DATE = VHINC06IW.DATE-INCD-OCCR;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-DATE-INCD = "Y";
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            else
                if (AFCXVLDW.NO-ERROR == "Y")
                    MRSCommonCode.XDATECON-LOAD-TBL();
                    XDATECON-W2.WS-GREG-IN-FLAG = "R";
         
         
         
                    VHXREVC_CRIT.SEL-IDX = 3;
                    try
                        call "VHXREVC"(XDCONTROL, VHXREVC_CRIT, VHXREVC_DATA);
                    
                    end
                    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                        XDATECON-W2.WS-RPT-GREG-IN = VHXREVC_DATA.REVENUE-DATE;
                    else
                        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    end
                    

          
                    MRSCommonCode.XDATECON-GREG2JUL();
                    VHINC06IW.JULIAN-DATE-1 = XDATECON-W1.WS-DATES-CYDDD;
                    XDATECON-W2.WS-GREG-IN-FLAG = "R";
                    XDATECON-W2.WS-RPT-GREG-IN = VHINC06IW.DATE-INCD-OCCR;
                    MRSCommonCode.XDATECON-GREG2JUL();
                    VHINC06IW.JULIAN-DATE-2 = XDATECON-W1.WS-DATES-CYDDD;
                    
  
  
                    VHINC06IS-DATE-CHK();
                end
            end
        end
    end
    if (VHINC06IW.DISP-TIME-INCD-OCCR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-TIME-INCD = "Y";
    end
    if (VHINC06IW.SPEED == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-SPEED = "Y";
    end
    if (VHINC06IW.CON-DIRECTION == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-DIRECTION = "Y";
    else
        if (VHINC06IW.CON-DIRECTION == "E" ||
         VHINC06IW.CON-DIRECTION == "W" ||
         VHINC06IW.CON-DIRECTION == "N" ||
         VHINC06IW.CON-DIRECTION == "S" ||
         VHINC06IW.CON-DIRECTION == "A")

        else
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-DIRECTION = "Y";
        end
    end
    if (VHINC06IW.INCD-LOC == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-LOC = "Y";
    end
    if (VHINC06IW.INCD-NARR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-NARR = "Y";
    end
    if (VHINC06IW.SPEED != " ")
        if (VHINC06IW.SPEED != "ALL")
            LOOP-INDEX = 1;
            VHINC06IW.TEMP-SPEED-CHAR = VHINC06IW.SPEED;
            while ((LOOP-INDEX <= 3))
                TEMP-SPEED-CHK-CHAR = TEMP-SPEED-OCCR-CHAR[LOOP-INDEX];
                if (TEMP-SPEED-CHK-CHAR != " ")
                    if (TEMP-SPEED-CHK-CHAR != "0" &&
                     TEMP-SPEED-CHK-CHAR != "1" &&
                     TEMP-SPEED-CHK-CHAR != "2" &&
                     TEMP-SPEED-CHK-CHAR != "3" &&
                     TEMP-SPEED-CHK-CHAR != "4" &&
                     TEMP-SPEED-CHK-CHAR != "5" &&
                     TEMP-SPEED-CHK-CHAR != "6" &&
                     TEMP-SPEED-CHK-CHAR != "7" &&
                     TEMP-SPEED-CHK-CHAR != "8" &&
                     TEMP-SPEED-CHK-CHAR != "9")
                        ERROR-COUNT = ERROR-COUNT + 1;
                        INVALID-SPEED-VAL = "Y"; 
                        LOOP-INDEX = 4;
                    else

                    end
                end
                LOOP-INDEX = LOOP-INDEX + 1;
            end
        end
    end
    if (VHINC06IW.DISP-TIME-INCD-OCCR != " ")
        if (VHINC06IW.DISP-TIME-INCD-OCCR not numeric)
            ERROR-COUNT = ERROR-COUNT + 1;
            DISP-INVALID-TIME = "Y";
        else
            if (DISP-TIME-INCD-OCCR-HR > 24 ||
             (DISP-TIME-INCD-OCCR-HR == 24 && DISP-TIME-INCD-OCCR-MIN > 0) ||
             (DISP-TIME-INCD-OCCR-HR == 0 && DISP-TIME-INCD-OCCR-MIN == 0) ||
             (DISP-TIME-INCD-OCCR-MIN > 59))
                ERROR-COUNT = ERROR-COUNT + 1;
                DISP-INVALID-TIME = "Y";
            else
                if (JULIAN-DAYS-DIFF == 0)
                    VHINC1A_CRIT.REVENUE-TIME-HR-NUM = VHINC06IW.DISP-TIME-INCD-OCCR-HR;
                    VHINC1A_CRIT.REVENUE-TIME-MIN-NUM = VHINC06IW.DISP-TIME-INCD-OCCR-MIN;
                    VHINC1A_CRIT.VAGen_COUNT = 0;
                    VHINC1A_CRIT.ALLOW-TIME = VGVar.currentFormattedTime;
                    TOTAL-REV-MIN = (VHINC1A_CRIT.REVENUE-TIME-HR-NUM * 60) + VHINC1A_CRIT.REVENUE-TIME-MIN-NUM;
                    TOTAL-ALLOW-MIN = (VHINC1A_CRIT.ALLOW-TIME-HR-NUM * 60) + VHINC1A_CRIT.ALLOW-TIME-MIN-NUM;
                    TOTAL-MIN-DIFF = TOTAL-REV-MIN - TOTAL-ALLOW-MIN;
                    if (VHINC1A_CRIT.REVENUE-TIME-HR-NUM <= 23 &&
                     (VHINC1A_CRIT.ALLOW-TIME-HR-NUM >= 0 &&
                     VHINC1A_CRIT.ALLOW-TIME-HR-NUM <= 3))
          

                    else
                        if (TOTAL-MIN-DIFF > 60)
                            ERROR-COUNT = ERROR-COUNT + 1;
            
                            DISP-TIME-ERRMSG = "Y";
                        end
                    end
                end
            end
        end
    end
    if (VHINC06IW.SYMP-CD != " ")
        VHINC1A_CRIT.VAGen_COUNT = 0;
        VHINC1A_CRIT.SYMP-CD = VHINC06IW.SYMP-CD;
        try
            call "VHINC1A"(XDCONTROL, VHINC1A_CRIT);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHINC1A_CRIT.VAGen_COUNT == 0)
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-SYMPCD-VAL = "Y";
            end
        end
    end
    if (VHINC06IW.CAR-NO != " ")
  
        VHINC6A_CRIT.CAR-NO = VHINC06IW.CAR-NO;
        try
            call "VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        
            if (XDCONTROL.UROWCNT == 0 ||
             (VHINC6A_DATA.CAR-TYPE-OCCR[1] != "A" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "B" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "C" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "D" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "E" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "L" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "M" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "K") )
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                if (VHINC6A_DATA.WHERE-IS-CAR != "CON")
                    ERROR-COUNT = ERROR-COUNT + 1;
                    DISPLAY-NOT-IN-SVC = "Y";
                end
            end
        else
            if (XDCONTROL.URC == 100)
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
    if (ERROR-COUNT > 0)
        VHINC06IS-BLD-MSG(); 
    else
  
        VHINC06IS-STORE-DB(); 
    end
end 

Function VHINC06IS-CLEAR () 
    set VH001IW-MESSAGEX empty;
    VHINC06IS-CLR-FLDS();
    VHINC06IW.USER-GRP = VHINC06IW.STORE-USER-GRP;
    

  
  
  
  
  
