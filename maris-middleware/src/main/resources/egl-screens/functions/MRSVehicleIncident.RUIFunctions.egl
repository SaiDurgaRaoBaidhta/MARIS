    VHINC08IW.INCD-NARR = " ";
    VHINC08IW.DISCV-DUR = " ";

  
    set VHINC1D_CRIT empty;
    set VHINC1D_DATA empty;
    set VHINCY_DATA empty;
    VHINCY_DATA.INCD-NO = " ";
end 

Function VHINC08IS-ENTRY () 
    VHINC08IW.MARIS-FUNC = "VHINC";
    if (VHINCY_CRIT.TYPE-IND == "YRD") 
        VHINC08IW.GUI-TITLE = "VHINC08I - Vehicle Tracking (Incident Veh - Yard)";
        ENABLE-DISCVDUR = "Y";
    else
        if (VHINCY_CRIT.TYPE-IND == "SHP") 
            VHINC08IW.GUI-TITLE = "VHINC08I - Vehicle Tracking (Incident Veh - Shop NoGo)";
            ENABLE-DISCVDUR = "Y";
        else
            if (VHINCY_CRIT.TYPE-IND == "REV") 
                VHINC08IW.GUI-TITLE = "VHINC08I - Vehicle Tracking (Incident Veh - Problem Fix)";
                VHINC08IW.DISCV-DUR = "1";
                ENABLE-DISCVDUR = "Y";
            end
        end
    end

   
    try
        call "VHCI02G"(XDCONTROL, VHCI02G_CRIT, VHCI02G_DATA);
    
    end
    if (XDCONTROL.UROWCNT == 1)
        VHINC08IW.SYSTEM-DATE = VHCI02G_CRIT.CURRENT-DATE;
        VHXREVA_DATA.SYSTEM-TIME = VHCI02G_CRIT.CURRENT-TIME;
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    VHINC08IS-CLR-FLDS();
    VHINC08IW.STORE-USER-GRP = VHINC08IW.USER-GRP;
    TEMP-DATE = VHINC08IW.SYSTEM-DATE;
     
    VHINC08IW.DATE-INCD-OCCR = TEMP-DATE;
    VHINC08IW.DATE-FILLER-1 = "-";
    VHINC08IW.DATE-FILLER-2 = "-";
    VHINC08IW.TIME-INCD-OCCR = " ";
    VHINC08IW.TIME-INCD-OCCR-FILLER-1 = ":";
    VHINC08IW.TIME-INCD-OCCR-FILLER-2 = " ";
    
  
  

  
  

  
  
  
  
  
  
    VHINC08IW.NARR-NO = 1;
    VHINC08IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHINC08IW.TIME-NARR = VGVar.currentFormattedTime;
    VHINC08IW.TIME-NARR-FILLER-1 = ":";
    VHINC08IW.TIME-NARR-FILLER-2 = " ";
    
  
  
    CAR-SETFOCUS = "Y";
end 

Function VHINC08IS-MOVE-MSG () 
    VHINC08IW.ERROR-LOOP-INDEX = 1;
    VHINC08IW.FINAL-INDEX = 0;
    VHINC08IW.FINAL-ERROR-MSG = " ";
    VHINC08IW-TRIGGER.SUCCESS-MESSAGE = " ";
    VHINC08IW.TEMP-ERROR-MSG = " ";
    if (ERROR-INDEX > 0)
        while (((ERROR-LOOP-INDEX <= 6) &&
         (ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX] != " ")))
            ERROR-INDEX = 1;
            TEMP-ERROR-MSG = ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX];
            while ((ERROR-INDEX <= 40))
                if (TEMP-MSG[ERROR-INDEX] != ".")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = TEMP-MSG[ERROR-INDEX];
                else
                    if (TEMP-MSG[ERROR-INDEX] == ".")
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = ",";
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = " ";
                        ERROR-INDEX = 40;
                    end
                end
                ERROR-INDEX = ERROR-INDEX + 1;
            end
            ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
        end
        FINAL-INDEX = FINAL-INDEX - 1;
        FINAL-MSG[FINAL-INDEX] = " ";
        VHINC08IW-TRIGGER.SUCCESS-MESSAGE = FINAL-ERROR-MSG;
        EXECUTE-SETFOCUS = "Y";
    end
end 

