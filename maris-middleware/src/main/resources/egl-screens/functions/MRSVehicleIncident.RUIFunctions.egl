    VHINCY_DATA.NARR = VHINC08IW.INCD-NARR;
    VHINCY_DATA.MARIS-FUNC = VHINC08IW.MARIS-FUNC;
end 

Function VHINC08IS-NARR-DET () 
    NARR-INDEX = 1;
    VHINC08IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC08IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC08IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC08IW.DATE-NARR-FILLER1 = "-";
    VHINC08IW.DATE-NARR-FILLER2 = "-";
    VHINC08IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC08IW.TIME-NARR-FILLER-1 = ":";
    VHINC08IW.TIME-NARR-FILLER-2 = " ";
    VHINC08IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
    if (NARR-COUNT > 1)
        DISABLE-PREV = "Y";
        ENABLE-NEXT = "Y";
    else
        DISABLE-PREV = "Y";
        DISABLE-NEXT = "Y";
    end
end 

Function VHINC08IS-PRVNXT () 
    if (BUTTON-CLICK == "PREV")
        VHINC08IW.NARR-INDEX = VHINC08IW.NARR-INDEX - 1;
        if (VHINC08IW.NARR-INDEX <= 1)
            VHINC08IW.NARR-INDEX = 1;
            DISABLE-PREV = "Y";
        else
            ENABLE-PREV = "Y";
        end
        ENABLE-NEXT = "Y";
    else
        if (BUTTON-CLICK == "NEXT")
            VHINC08IW.NARR-INDEX = VHINC08IW.NARR-INDEX + 1;
            ENABLE-PREV = "Y";
            if (VHINC08IW.NARR-INDEX >= VHINC08IW.NARR-COUNT)
                VHINC08IW.NARR-INDEX = VHINC08IW.NARR-COUNT;
                DISABLE-NEXT = "Y";
            else
                ENABLE-NEXT = "Y";
            end
        end
    end
    VHINC08IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC08IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC08IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC08IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC08IW.TIME-NARR-FILLER-1 = ":";
    VHINC08IW.TIME-NARR-FILLER-2 = " ";
    VHINC08IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
end 

Function VHINC08IS-PSEUDO () 
    CAR-IN-CON = "N";
    set VHINXA_DATA empty;
    VHINXA_CRIT.CAR-NO = VHINC08IW.CAR-NO;
    try
        call "VHINXA"(XDCONTROL, VHINXA_CRIT, VHINXA_DATA);
    
    end
    
    
    MRSCommonCode.XXA0IS-CHECK_EXT();
    
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            CAR-IN-CON = "Y";
        else
        
        
      
      
      
      

        end 
    end
    if (CAR-IN-CON == "Y")
        VHINXB_CRIT.CON-NO = VHINXA_DATA.CON-NO;
        VHINXB_DATA.TERM-LAST-UPD = VHINC08IW.TERM-LAST-UPD;
        VHINXB_DATA.USER-GROUP = VHINC08IW.USER-GRP;
        CAR-CNT = 1;
        while (CAR-CNT <= 10)
            VHINXB_DATA.CAR-NUM[CAR-CNT] = VHINXA_DATA.CAR-NO[CAR-CNT];
            VHINXB_DATA.CON-NUM[CAR-CNT] = VHINXA_DATA.CON-NO[CAR-CNT];
            CAR-CNT = CAR-CNT + 1;
        end
        VHINXB_CRIT.YRD-SUB-LOC = VHINXA_DATA.YRD-SUB-LOC[1];
        try
            call "VHINXB"(XDCONTROL, VHINXB_CRIT, VHINXB_DATA);
        
        end
        
    
        MRSCommonCode.XXA0IS-CHECK_EXT();
    
        if (XXEXT_CALL_Level77Items.URC == 0)
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHINC3A_CRIT.SEND-RESET-MSG = "Y";
            else
        
        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

Function VHINC08IS-REV-CAL ()
   
    VHXREVA_CRIT.SEL-IDX = 1;
    VHXREVA_CRIT.SYSTEM-DATE = VHINC08IW.TEMP-DATE;
    VHXREVA_CRIT.SYSTEM-TIME = VHINC08IW.TIME-INCD-OCCR;
    VHXREVA_CRIT.SYSTEM-TIME-FILLER-1 = ":";
    VHXREVA_CRIT.SYSTEM-TIME-FILLER-2 = ":";
