Function VHINC08IS-CHK-DATA ()
   
    ERROR-MESSAGE = " ";
    ERROR-INDEX = 0;
    ERROR-COUNT = 0;
    TOTAL-MIN-DIFF = 0;
    JULIAN-DATE-QUOT = 0;
    JULIAN-DATE-REM = 0;
    JULIAN-DATE-YR-DIFF = 0;
    JULIAN-DATE-1 = 0;
    JULIAN-DATE-2 = 0;
    INVALID-CAR-NO = "N"; 
    INVALID-INCD-NARR = "N"; 
    INVALID-SYMP-CD = "N"; 
    INVALID-DISCV-DUR = "N"; 
    INVALID-DATE-INCD = "N"; 
    INVALID-TIME-INCD = "N"; 
    INVALID-INCD-LOC = "N"; 
    INVALID-DATE = "N"; 
    DAYS-GR-45 = "N"; 
    DAYS-GR-7 = "N"; 
    DISP-ERR-MSG = "N"; 
    DISP-INVALID-TIME = "N"; 
    DISP-TIME-ERRMSG = "N"; 
    INVALID-SYMPCD-VAL = "N"; 
    DISPLAY-INVALID-CAR-NO = "N"; 
    DISPLAY-IN-USE = "N"; 
    DISCV-DUR-FOUND = "N"; 
    VHINC08IW.CAR-NO = VHINC08IW.CAR-NO-NUM;
    if (VHINC08IW.CAR-NO == "0000")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-CAR-NO = "Y";
    end
    if (VHINC08IW.SYMP-CD == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-SYMP-CD = "Y";
    end
    if (VHINC08IW.DISCV-DUR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-DISCV-DUR = "Y";
    else
        if (VHINCY_CRIT.TYPE-IND == "YRD" ||  
         VHINCY_CRIT.TYPE-IND == "SHP")        
            if (VHINC08IW.DISCV-DUR == "1")
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-DISCV-DUR = "Y";
            else
                LOOP-INDEX = 1;
                while ((LOOP-INDEX <= VHINCXA_DATA.DISCV-DUR-COUNT))
                    if (VHINC08IW.DISCV-DUR == VHINCXA_DATA.DISCV-DUR[LOOP-INDEX])
                        DISCV-DUR-FOUND = "Y";
                        LOOP-INDEX = VHINCXA_DATA.DISCV-DUR-COUNT;
                    end
                    LOOP-INDEX = LOOP-INDEX + 1;
                end
                if (DISCV-DUR-FOUND == "N")
                    ERROR-COUNT = ERROR-COUNT + 1;
                    INVALID-DISCV-DUR = "Y";
                end
            end
        end
    end
    if (VHINC08IW.DATE-INCD-OCCR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-DATE-INCD = "Y";
    end
    if (VHINC08IW.DISP-TIME-INCD-OCCR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-TIME-INCD = "Y";
    end
    if (VHINC08IW.INCD-LOC == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-LOC = "Y";
    end
    if (VHINC08IW.INCD-NARR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-NARR = "Y";
    end

  
    TEMP-DATE-MON = VHINC08IW.DATE-INCD-OCCR-MON;
    TEMP-DATE-FILLER-1 = "-";
    TEMP-DATE-DAY = VHINC08IW.DATE-INCD-OCCR-DAY;
    TEMP-DATE-FILLER-2 = "-";
    TEMP-DATE-YR = VHINC08IW.DATE-INCD-OCCR-YR;
    AFCXVLD_CRIT.FORM-DATE = TEMP-DATE;
    MRSCommonCode.AFCXVLD-VALIDATE();
    if (AFCXVLDW.INCORRECT-DATE == "Y")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-DATE = "Y";
    else
        if (AFCXVLDW.SQL-ERROR == "Y")
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        else
            if (AFCXVLDW.NO-ERROR == "Y")
                XDATECON-W2.WS-GREG-IN-FLAG = "R";
                XDATECON-W2.WS-RPT-GREG-IN = VGVar.currentFormattedGregorianDate;
                MRSCommonCode.XDATECON-LOAD-TBL();
                MRSCommonCode.XDATECON-GREG2JUL();
                JULIAN-DATE-1 = XDATECON-W1.WS-DATES-CYDDD;
                XDATECON-W2.WS-GREG-IN-FLAG = "R";
                XDATECON-W2.WS-RPT-GREG-IN = TEMP-DATE;
                MRSCommonCode.XDATECON-LOAD-TBL();
                MRSCommonCode.XDATECON-GREG2JUL();
                JULIAN-DATE-2 = XDATECON-W1.WS-DATES-CYDDD;
                if (JULIAN-DATE-1-CCYY == JULIAN-DATE-2-CCYY)
                    if (JULIAN-DATE-2-DDD > JULIAN-DATE-1-DDD)
                        ERROR-COUNT = ERROR-COUNT + 1;
                        DISP-ERR-MSG = "Y";
                         
                    else
                        JULIAN-DAYS-DIFF = JULIAN-DATE-1 - JULIAN-DATE-2;
                        if (VHINCY_CRIT.TYPE-IND == "REV") 
                                   
  
                            if ((JULIAN-DAYS-DIFF > 1095))
                                ERROR-COUNT = ERROR-COUNT + 1;
                                DAYS-GR-7 = "Y";
                            end
                        else
  
                            if ((JULIAN-DAYS-DIFF > 1095)) 
                                ERROR-COUNT = ERROR-COUNT + 1;
                                DAYS-GR-45 = "Y";
                            end
                        end
                    end
                else
                    if (JULIAN-DATE-1-CCYY > JULIAN-DATE-2-CCYY)
                        JULIAN-DATE-YR-DIFF = JULIAN-DATE-1-CCYY - JULIAN-DATE-2-CCYY;
                    else
                        JULIAN-DATE-YR-DIFF = JULIAN-DATE-2-CCYY - JULIAN-DATE-1-CCYY;
                    end
                    if (JULIAN-DATE-YR-DIFF > 3)
                        if (VHINCY_CRIT.TYPE-IND == "REV") 
                                   
                            ERROR-COUNT = ERROR-COUNT + 1;
                            DAYS-GR-7 = "Y";
                        else
              
                            ERROR-COUNT = ERROR-COUNT + 1;
                            DAYS-GR-45 = "Y";
                        end
                    else
            
                        if (JULIAN-DATE-1-CCYY > JULIAN-DATE-2-CCYY)
                            JULIAN-DATE-QUOT = JULIAN-DATE-2-CCYY / 4;
                            JULIAN-DATE-REM = JULIAN-DATE-2-CCYY - (JULIAN-DATE-QUOT * 4);
                            if (JULIAN-DATE-REM > 0)
                                JULIAN-DATE-1-DDD = JULIAN-DATE-1-DDD + 365;
                            else
                                JULIAN-DATE-1-DDD = JULIAN-DATE-1-DDD + 366;
                            end
                            JULIAN-DAYS-DIFF = JULIAN-DATE-1-DDD - JULIAN-DATE-2-DDD;
                            if (VHINCY_CRIT.TYPE-IND == "REV") 
                                   
  
                                if (JULIAN-DAYS-DIFF > 1095)
                                    ERROR-COUNT = ERROR-COUNT + 1;
                                    DAYS-GR-7 = "Y";
                                end
                            else
  
                                if (JULIAN-DAYS-DIFF > 1095) 
                                    ERROR-COUNT = ERROR-COUNT + 1;
                                    DAYS-GR-45 = "Y";
                                end
                            end
                        else
                            if (JULIAN-DATE-2-CCYY > JULIAN-DATE-1-CCYY)
                                ERROR-COUNT = ERROR-COUNT + 1;
                                DISP-ERR-MSG = "Y";
                                 
                            end
                        end
                    end
                end
            end
        end
    end
    if (VHINC08IW.DISP-TIME-INCD-OCCR not numeric)
        ERROR-COUNT = ERROR-COUNT + 1;
        DISP-INVALID-TIME = "Y";
    else
        VHINC08IW.TIME-INCD-OCCR-HR = VHINC08IW.DISP-TIME-INCD-OCCR-HR;
        VHINC08IW.TIME-INCD-OCCR-MIN = VHINC08IW.DISP-TIME-INCD-OCCR-MIN;
        if ((TIME-INCD-OCCR-HR-NUM > 24) ||
         (TIME-INCD-OCCR-HR-NUM == 24 && TIME-INCD-OCCR-MIN-NUM >
         00) ||
         (TIME-INCD-OCCR-HR-NUM >= 0 && TIME-INCD-OCCR-MIN-NUM >
         59))
            ERROR-COUNT = ERROR-COUNT + 1;
            DISP-INVALID-TIME = "Y";
        else
            if ((VHINC08IW.DATE-INCD-OCCR-YR == VHINC08IW.SYSTEM-DATE-YR &&
             VHINC08IW.DATE-INCD-OCCR-MON == VHINC08IW.SYSTEM-DATE-MON &&
             VHINC08IW.DATE-INCD-OCCR-DAY == VHINC08IW.SYSTEM-DATE-DAY))
                VHINC1A_CRIT.REVENUE-TIME = VHINC08IW.TIME-INCD-OCCR;
                VHINC1A_CRIT.VAGen_COUNT = 0;
                VHINC1A_CRIT.SYMP-CD = VHINC08IW.SYMP-CD;
                VHINC1A_CRIT.ALLOW-TIME = VGVar.currentFormattedTime;
                TOTAL-REV-MIN = (VHINC1A_CRIT.REVENUE-TIME-HR-NUM * 60) + VHINC1A_CRIT.REVENUE-TIME-MIN-NUM;
                TOTAL-ALLOW-MIN = (VHINC1A_CRIT.ALLOW-TIME-HR-NUM * 60) + VHINC1A_CRIT.ALLOW-TIME-MIN-NUM;
                TOTAL-MIN-DIFF = TOTAL-REV-MIN - TOTAL-ALLOW-MIN;
                if (TOTAL-MIN-DIFF > 60)
                    ERROR-COUNT = ERROR-COUNT + 1;
            
                    DISP-TIME-ERRMSG = "Y";
                end
            end
        end
    end
    if (VHINC08IW.SYMP-CD != " ")
        VHINC1A_CRIT.VAGen_COUNT = 0;
        VHINC1A_CRIT.SYMP-CD = VHINC08IW.SYMP-CD;
        try
            call "VHINC1A"(XDCONTROL, VHINC1A_CRIT);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHINC1A_CRIT.VAGen_COUNT == 0)
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-SYMPCD-VAL = "Y";
            end
        end
    end
    if (VHINC08IW.CAR-NO != " ")
  
        VHINC6A_CRIT.CAR-NO = VHINC08IW.CAR-NO;
        try
            call "VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        
            if (XDCONTROL.UROWCNT == 0 ||
             (VHINC6A_DATA.CAR-TYPE-OCCR[1] != "A" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "B" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "C" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "D" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "E" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "L" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "M" && 
             	VHINC6A_DATA.CAR-TYPE-OCCR[1] != "K"))
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                if (VHINCY_CRIT.TYPE-IND == "YRD" ||
                 VHINCY_CRIT.TYPE-IND == "SHP" ||
                 VHINCY_CRIT.TYPE-IND == "REV")
                    if (VHINC6A_DATA.WHERE-IS-CAR == "CON")
                        ERROR-COUNT = ERROR-COUNT + 1;
                        DISPLAY-IN-USE = "Y";
                    end
                end
            end
        else
            if (XDCONTROL.URC == 100)
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
    if (ERROR-COUNT > 0)
        VHINC08IS-BLD-MSG(); 
    else
        VHINC08IS-STORE-DB();
    end
end 

Function VHINC08IS-CK-DATA2 ()
   
    set VHINC3A_CRIT empty;
    ERROR-MESSAGE = " ";
    ERROR-INDEX = 0;
    ERROR-COUNT = 0;
    INVALID-CAR-NO = "N"; 
    INVALID-INCD-NARR = "N"; 
    INVALID-SYMP-CD = "N"; 
    INVALID-DISCV-DUR = "N"; 
    INVALID-INCD-LOC = "N"; 
    INVALID-DATE-TIME = "N"; 
    DAYS-GR-45 = "N"; 
    DAYS-GR-7 = "N"; 
    FUTURE-DATE = "N"; 
    FUTURE-TIME = "N"; 
    INVALID-SYMPCD-VAL = "N"; 
    DISPLAY-INVALID-CAR-NO = "N"; 
    DISPLAY-IN-USE = "N"; 
    DISCV-DUR-FOUND = "N"; 
    VHINC3A_CRIT.SEND-RESET-MSG = "N";
    VHINC08IW.CAR-NO = VHINC08IW.CAR-NO-NUM;
    if (VHINC08IW.CAR-NO == "0000")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-CAR-NO = "Y";
    end
    if (VHINC08IW.SYMP-CD == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-SYMP-CD = "Y";
    end
    if (VHINC08IW.DISCV-DUR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-DISCV-DUR = "Y";
    else
        if (VHINCY_CRIT.TYPE-IND == "YRD" ||  
         VHINCY_CRIT.TYPE-IND == "SHP")        
            if (VHINC08IW.DISCV-DUR == "1")
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-DISCV-DUR = "Y";
            else
                LOOP-INDEX = 1;
                while ((LOOP-INDEX <= VHINCXA_DATA.DISCV-DUR-COUNT))
                    if (VHINC08IW.DISCV-DUR == VHINCXA_DATA.DISCV-DUR[LOOP-INDEX])
                        DISCV-DUR-FOUND = "Y";
                        LOOP-INDEX = VHINCXA_DATA.DISCV-DUR-COUNT;
                    end
                    LOOP-INDEX = LOOP-INDEX + 1;
                end
                if (DISCV-DUR-FOUND == "N")
                    ERROR-COUNT = ERROR-COUNT + 1;
                    INVALID-DISCV-DUR = "Y";
                end
            end
        end
    end

  
  
   
  
  
  
  
  
    if (VHINC08IW.INCD-LOC == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-LOC = "Y";
    end
    if (VHINC08IW.INCD-NARR == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-NARR = "Y";
    end

  
    VHINC08IW.WS-DATE = VHINC08IW.DATE-INCD-OCCR;
    if (VHINC08IW.DISP-TIME-INCD-OCCR != " ")
        VHINC08IW.WS-HR = VHINC08IW.DISP-TIME-INCD-OCCR-HR;
        VHINC08IW.WS-MIN = VHINC08IW.DISP-TIME-INCD-OCCR-MIN;
        VHINC08IW.WS-SEC = "00";
        VHINC08IW.TIME-SEP1 = ":";
        VHINC08IW.TIME-SEP2 = ":";
        VHINC8E_CRIT.TIME-WORK = VHINC08IW.WS-TIME;
    else
        VHINC08IW.WS-TIME = " ";
    end
    if (VHINC08IW.WS-1 == "-")
        VHINC8E_CRIT.DATE-WORK = VHINC08IW.WS-DATE;
    else
        XXDATEW.DATE-MM-DD-YYYY = VHINC08IW.WS-DATE;
        move MONTH-MM-DD-YYYY to MONTH-YYYY-MM-DD withV60Compat;
        move DAY-MM-DD-YYYY to DAY-YYYY-MM-DD withV60Compat;
        move YEAR-MM-DD-YYYY to YEAR-YYYY-MM-DD withV60Compat;
        SEP1-YYYY-MM-DD = "-";
        SEP2-YYYY-MM-DD = "-";
        VHINC8E_CRIT.DATE-WORK = XXDATEW.DATE-YYYY-MM-DD;
        VHINC08IW.WS-DATE = XXDATEW.DATE-YYYY-MM-DD;
    end
    try
        call "VHINC8E"(XDCONTROL, VHINC8E_CRIT, VHINC8E_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHINC08IW.DAYS-DIFF = VHINC8E_DATA.DAYS-DIFF;
        VHINC08IW.TIME-DIFF = VHINC8E_DATA.TIME-DIFF;
        VHINC08IW.INVALID-DATE-TIME = "N";
    else
        ERROR-COUNT = ERROR-COUNT + 1;
        VHINC08IW.INVALID-DATE-TIME = "Y";
    end
    if (VHINC08IW.INVALID-DATE-TIME == "N")
        if (VHINC08IW.DAYS-DIFF < 0)
            ERROR-COUNT = ERROR-COUNT + 1;
            VHINC08IW.FUTURE-DATE = "Y";
             
        else
            if (VHINC08IW.DAYS-DIFF == 0)
                if (VHINC08IW.TIME-DIFF < 0)
                    ERROR-COUNT = ERROR-COUNT + 1;
                    VHINC08IW.FUTURE-TIME = "Y";
                     
                end
            end
        end
        if (VHINC08IW.FUTURE-TIME == "N" && VHINC08IW.FUTURE-DATE == "N")
            if (VHINCY_CRIT.TYPE-IND == "REV") 
                if ((VHINC08IW.DAYS-DIFF > 1095))
                    ERROR-COUNT = ERROR-COUNT + 1;
                    DAYS-GR-7 = "Y";
                end
            else
          
                if ((VHINC08IW.DAYS-DIFF > 1095)) 
                    ERROR-COUNT = ERROR-COUNT + 1;
                    DAYS-GR-45 = "Y";
                end
            end
        end
    end
    if (VHINC08IW.SYMP-CD != " ")
        VHINC1A_CRIT.VAGen_COUNT = 0;
        VHINC1A_CRIT.SYMP-CD = VHINC08IW.SYMP-CD;
        try
            call "VHINC1A"(XDCONTROL, VHINC1A_CRIT);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHINC1A_CRIT.VAGen_COUNT == 0)
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-SYMPCD-VAL = "Y";
            end
        end
    end
    if (VHINC08IW.CAR-NO != " ")
  
        VHINC6A_CRIT.CAR-NO = VHINC08IW.CAR-NO;
        try
            call "VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        
            if (XDCONTROL.UROWCNT == 0 ||
             (VHINC6A_DATA.CAR-TYPE-OCCR[1] != "A" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "B" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "C" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "D" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "E"  &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "L" &&
             VHINC6A_DATA.CAR-TYPE-OCCR[1] != "M" && 
               VHINC6A_DATA.CAR-TYPE-OCCR[1] != "K"))
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                if (VHINCY_CRIT.TYPE-IND == "YRD" ||
                 VHINCY_CRIT.TYPE-IND == "SHP" ||
                 VHINCY_CRIT.TYPE-IND == "REV")
                    if (VHINC6A_DATA.WHERE-IS-CAR == "CON")
                        ERROR-COUNT = ERROR-COUNT + 1;
                        DISPLAY-IN-USE = "Y";
                    end
                end
            end
        else
            if (XDCONTROL.URC == 100)
                ERROR-COUNT = ERROR-COUNT + 1;
                DISPLAY-INVALID-CAR-NO = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
    if (ERROR-COUNT > 0)
        VHINC08IS-BLD-MSG2(); 
   
    else
   
   
   
   
        VHINC08IS-PSEUDO(); 
        VHINC08IS-STORE-DB(); 
    end
end 

Function VHINC08IS-CLEAR () 
    VHINC08IW.MARIS-FUNC = "VHINC";
    if (VHINCY_CRIT.TYPE-IND == "YRD") 
        VHINC08IW.GUI-TITLE = "VHINC08I - Vehicle Tracking (Incident Veh - Yard)";
    else
        if (VHINCY_CRIT.TYPE-IND == "SHP") 
            VHINC08IW.GUI-TITLE = "VHINC08I - Vehicle Tracking (Incident Veh - Shop NoGo)";
        else
            if (VHINCY_CRIT.TYPE-IND == "REV") 
                VHINC08IW.GUI-TITLE = "VHINC08I - Vehicle Tracking (Incident Veh - Problem Fix)";
                VHINC08IW.DISCV-DUR = "1";
                
        
            end
        end
    end
    VHINC08IS-CLR-FLDS();
    VHINC08IW.USER-GRP = VHINC08IW.STORE-USER-GRP;
    TEMP-DATE = VGVar.currentFormattedGregorianDate; 
    VHINC08IW.DATE-INCD-OCCR = TEMP-DATE;
    VHINC08IW.DATE-FILLER-1 = "-";
    VHINC08IW.DATE-FILLER-2 = "-";
    VHINC08IW.TIME-INCD-OCCR = " ";
    VHINC08IW.TIME-INCD-OCCR-FILLER-1 = ":";
    VHINC08IW.TIME-INCD-OCCR-FILLER-2 = " ";
    VHXREVA_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    VHINC08IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;

  
  

  
  
  
  
  
  
    VHINC08IW.NARR-NO = 1;
    VHINC08IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHINC08IW.TIME-NARR = VGVar.currentFormattedTime;
    VHINC08IW.TIME-NARR-FILLER-1 = ":";
    VHINC08IW.TIME-NARR-FILLER-2 = " ";
  
  
    CAR-SETFOCUS = "Y";
end 

Function VHINC08IS-CLEAR-DB () 
    VHINC08IW.MARIS-FUNC = "VHINC";
    if (VHINCY_CRIT.TYPE-IND == "YRD") 
        VHINC08IW.GUI-TITLE = "VHINC08I - Vehicle Tracking (Incident Veh - Yard)";
    else
        if (VHINCY_CRIT.TYPE-IND == "SHP") 
            VHINC08IW.GUI-TITLE = "VHINC08I - Vehicle Tracking (Incident Veh - Shop NoGo)";
        else
            if (VHINCY_CRIT.TYPE-IND == "REV") 
                VHINC08IW.GUI-TITLE = "VHINC08I - Vehicle Tracking (Incident Veh - Problem Fix)";
                VHINC08IW.DISCV-DUR = "1";
                
        
            end
        end
    end
    VHINC08IS-CLRAFTDB();
    VHINC08IW.USER-GRP = VHINC08IW.STORE-USER-GRP;
    TEMP-DATE = VGVar.currentFormattedGregorianDate; 
    VHINC08IW.DATE-INCD-OCCR = TEMP-DATE;
    VHINC08IW.DATE-FILLER-1 = "-";
    VHINC08IW.DATE-FILLER-2 = "-";
    VHINC08IW.TIME-INCD-OCCR = " ";
    VHINC08IW.TIME-INCD-OCCR-FILLER-1 = ":";
    VHINC08IW.TIME-INCD-OCCR-FILLER-2 = " ";
    VHXREVA_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    VHINC08IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;

  
  

  
  
  
  
  
  
    VHINC08IW.NARR-NO = 1;
    VHINC08IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHINC08IW.TIME-NARR = VGVar.currentFormattedTime;
    VHINC08IW.TIME-NARR-FILLER-1 = ":";
    VHINC08IW.TIME-NARR-FILLER-2 = " ";
  
  
    CAR-SETFOCUS = "Y";
end 

