        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHINCY_DATA.DATE-INCD-OCCR-REV = XXDATEW.DATE-YYYY-MM-DD;
    else
        VHINCY_DATA.DATE-INCD-OCCR-REV = " ";
    end
end 

Function VHINC08IS-SETFOCU2 () 
    if (INVALID-CAR-NO == "Y" ||
     DISPLAY-INVALID-CAR-NO == "Y" ||
     DISPLAY-IN-USE == "Y")
        CAR-SETFOCUS = "Y";
    else
        if (INVALID-SYMP-CD == "Y" ||
         INVALID-SYMPCD-VAL == "Y")
            SYMPCD-SETFOCUS = "Y";
        else
            if (INVALID-DISCV-DUR == "Y") 
                DISCVDUR-SETFOCUS = "Y";
            else
                if (INVALID-DATE-TIME == "Y" ||
                 DAYS-GR-45 == "Y" ||
                 DAYS-GR-7 == "Y" ||
                 FUTURE-DATE == "Y")
                    DATE-SETFOCUS = "Y";
                else
                    if (FUTURE-TIME == "Y")
                        TIME-SETFOCUS = "Y";
                    else
                        if (INVALID-INCD-LOC == "Y") 
                            LOC-SETFOCUS = "Y";
                        else
                            if (INVALID-INCD-NARR == "Y")
                                NARR-SETFOCUS = "Y";
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHINC08IS-SETFOCUS () 
    if (INVALID-CAR-NO == "Y" ||
     DISPLAY-INVALID-CAR-NO == "Y" ||
     DISPLAY-IN-USE == "Y")
        CAR-SETFOCUS = "Y";
    else
        if (INVALID-SYMP-CD == "Y" ||
         INVALID-SYMPCD-VAL == "Y")
            SYMPCD-SETFOCUS = "Y";
        else
            if (INVALID-DISCV-DUR == "Y") 
                DISCVDUR-SETFOCUS = "Y";
            else
                if (INVALID-DATE == "Y" ||
                 INVALID-DATE-INCD == "Y" ||
                 DAYS-GR-45 == "Y" ||
                 DAYS-GR-7 == "Y" ||
                 DISP-ERR-MSG == "Y")
                    DATE-SETFOCUS = "Y";
                else
                    if (INVALID-TIME-INCD == "Y" ||
                     DISP-INVALID-TIME == "Y" ||
                     DISP-TIME-ERRMSG == "Y")
                        TIME-SETFOCUS = "Y";
                    else
                        if (INVALID-INCD-LOC == "Y") 
                            LOC-SETFOCUS = "Y";
                        else
                            if (INVALID-INCD-NARR == "Y")
                                NARR-SETFOCUS = "Y";
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHINC08IS-STORE-DB ()
  
   
    SUCCESS-MESSAGE = " ";
    VHINC08IW.MARIS-FUNC = "VHINC";
    VHINC08IS-MOVE-REC();
  
    if (VHINCY_CRIT.TYPE-IND == "YRD") 
        VHINCY_CRIT.INCD-PFX = "A";
        VHINCY_CRIT.INCD-TYPE = "YRD";
        VHINCY_CRIT.INCIDENT-NAME = "IVY";
    else
        if (VHINCY_CRIT.TYPE-IND == "SHP") 
            VHINCY_CRIT.INCD-PFX = "J";
            VHINCY_CRIT.INCD-TYPE = "SHP";
            VHINCY_CRIT.INCIDENT-NAME = "IVD";
        else
            if (VHINCY_CRIT.TYPE-IND == "REV") 
                VHINCY_CRIT.INCD-PFX = "G";
                VHINCY_CRIT.INCD-TYPE = "REV";
                VHINCY_CRIT.INCIDENT-NAME = "IVH";
            end
        end
    end
    VHINCY_DATA.INCD-TYPE = VHINCY_CRIT.INCD-TYPE;
    try
        call "VHINCY"(XDCONTROL, VHINCY_CRIT, VHINCY_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHINC08IW.INCD-NO = VHINCY_DATA.INCD-NO;
        VHINC08IW.NARR-COUNT = 1;
        SUCCESS-MESSAGE-1 = "Incd No ";
        SUCCESS-MESSAGE-2 = VHINCY_DATA.INCD-NO;
        SUCCESS-MESSAGE-3 = " for Car ";
        SUCCESS-MESSAGE-4 = VHINC08IW.CAR-NO;
        SUCCESS-MESSAGE-5 = " was filed succesfully";
        
  
  
  
  
  
        VHINC08IS-UPD-STAT();
        VHINC08IS-CA-CICS();
        VHINC08IS-CLEAR-DB();
    else
        EXECUTE-CLEAR = "Y";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC08IS-UPD-STAT () 
    VHINXC_CRIT.CAR-NO = VHINC08IW.CAR-NO;
    VHINXC_DATA.TERM-LAST-UPD = VHINC08IW.TERM-LAST-UPD;
    try
        call "VHINXC"(XDCONTROL, VHINXC_CRIT, VHINXC_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

    else
        EXECUTE-CLEAR = "Y";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC09IS-AFT-NAR () 
    VHINC09IW.NARR-COUNT = 0;
    VHINC1D_CRIT.INCD-NO = VHINC09IW.INCD-NO;
    VHINC1D_CRIT.RET-CHECK = "NARR";
    try
        call "VHINC1D"(XDCONTROL, VHINC1D_CRIT, VHINC1D_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHINC09IW.NARR-COUNT = XDCONTROL.UROWCNT;
        VHINC09IS-NARR-DET();
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC09IS-BLD-MSG ()
   
    ERROR-INDEX = 0;
    ERROR-MESSAGE = " ";
    if (VHINC09IW.SYMP-CD == " ")
        if (INVALID-SYMP-CD == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid symp cd.";
        end
    else
        if (INVALID-SYMPCD-VAL == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Symp cd does not exist.";
        end
    end
    if (VHINC1D_DATA.INCD-TYPE == "REV")
        if (VHINC09IW.SPEED == " ")
            if (INVALID-SPEED == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid speed.";
            end
        else
            if (INVALID-SPEED-VAL == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Speed does not have a valid value.";
            end
        end
        if (INVALID-DIRECTION == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid direction.";
        end
    end
    if (ERROR-INDEX == 6)
        VHINC09IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-LOC == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid location.";
    end
    if (ERROR-INDEX == 6)
        VHINC09IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-NARR == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid narr.";
    end
    if (ERROR-INDEX == 6)
        VHINC09IS-MOVE-MSG();
        return;
    end
    VHINC09IS-MOVE-MSG();
end 

Function VHINC09IS-CHK-DATA () 
    FINAL-MESSAGE = " ";
    ERROR-COUNT = 0;
    INVALID-SYMP-CD = "N";
    INVALID-SPEED = "N";
    INVALID-SPEED-VAL = "N";
    INVALID-DIRECTION = "N";
    INVALID-INCD-LOC = "N";
    INVALID-SYMPCD-VAL = "N";
    if (VHINC09IW.SYMP-CD == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-SYMP-CD = "Y";
    end
    if (VHINC1D_DATA.INCD-TYPE == "REV")
        if (VHINC09IW.SPEED == " ")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-SPEED = "Y";
        else
            if (VHINC09IW.SPEED != " ")
                if (VHINC09IW.SPEED != "ALL")
                    LOOP-INDEX = 1;
                    VHINC09IW.TEMP-SPEED-CHAR = VHINC09IW.SPEED;
                    while ((LOOP-INDEX <= 3))
                        TEMP-SPEED-CHK-CHAR = TEMP-SPEED-OCCR-CHAR[LOOP-INDEX];
                        if (TEMP-SPEED-CHK-CHAR != " ")
                            if (TEMP-SPEED-CHK-CHAR != "0" &&
                             TEMP-SPEED-CHK-CHAR != "1" &&
                             TEMP-SPEED-CHK-CHAR != "2" &&
                             TEMP-SPEED-CHK-CHAR != "3" &&
                             TEMP-SPEED-CHK-CHAR != "4" &&
                             TEMP-SPEED-CHK-CHAR != "5" &&
                             TEMP-SPEED-CHK-CHAR != "6" &&
                             TEMP-SPEED-CHK-CHAR != "7" &&
                             TEMP-SPEED-CHK-CHAR != "8" &&
                             TEMP-SPEED-CHK-CHAR != "9")
                                ERROR-COUNT = ERROR-COUNT + 1;
                                INVALID-SPEED-VAL = "Y"; 
                                LOOP-INDEX = 4;
                            end
                        end
                        LOOP-INDEX = LOOP-INDEX + 1;
                    end
                end
            end
        end
        if (VHINC09IW.CON-DIRECTION == " ")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-DIRECTION = "Y";
        end
    end
    if (VHINC09IW.INCD-LOC == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        INVALID-INCD-LOC = "Y";
    end
    if (VHINC09IW.SYMP-CD != " ")
        VHINC1A_CRIT.VAGen_COUNT = 0;
        VHINC1A_CRIT.SYMP-CD = VHINC09IW.SYMP-CD;
        try
            call "VHINC1A"(XDCONTROL, VHINC1A_CRIT);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHINC1A_CRIT.VAGen_COUNT == 0)
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-SYMPCD-VAL = "Y";
            end
        end
    end
    if (ERROR-COUNT > 0)
        VHINC09IS-BLD-MSG(); 
    else
        VHINC09IS-STORE-DB(); 
    end
end 

Function VHINC09IS-CLEAR () 
    VHINC09IS-CLR-FLDS();
    VHINC09IW.PASSVALUE-USER-GRP = VHINC09IW.STORE-USER-GRP;
    VHINC09IW.USER-GRP = VHINC09IW.PASSVALUE-USER-GRP;


  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
    DISABLE-PREV = "Y";
    DISABLE-NEXT = "Y";
    ENABLE-INCDNO = "Y";
    ENABLE-INCDDET = "Y";
    DISABLE-FIELDS = "Y";
    DISABLE-SYMPCD = "Y";
    DISABLE-SPEED = "Y";
    DISABLE-CONDIRECTION = "Y";
    DISABLE-INCDLOC = "Y";
    DISABLE-ADDNARR = "Y";
    DISABLE-CHANGE = "Y";
    BUTTON-CAPTION = "Update";
    INCDNO-SETFOCUS = "Y";
end 

Function VHINC09IS-CLR-FLDS () 
    move " " to VHINC09IW.DISCV-DUR-ARRAY[1] for all;
    FINAL-MESSAGE = " ";
    VHINC09IW.DISCV-DUR = " ";
    if (VHINC09IW.TYPE-IND == "REV")
        VHINC09IW.DISCV-DUR-ARRAY[1] = "1";
        VHINC09IW.DISCV-DUR = "1";
        DISABLE-DISCVDUR = "Y";
    else
        if (VHINC09IW.TYPE-IND == "SHN")
            VHINC09IW.DISCV-DUR = "4";
            VHINC09IW.DISCV-DUR-ARRAY[1] = "4";
            DISABLE-DISCVDUR = "Y";
        else
            if (VHINC09IW.TYPE-IND == "EVT" ||
             VHINC09IW.TYPE-IND == "MSC")
                VHINC09IW.DISCV-DUR-ARRAY[1] = "1";
                VHINC09IW.DISCV-DUR-ARRAY[2] = "2";
                VHINC09IW.DISCV-DUR-ARRAY[3] = "3";
                VHINC09IW.DISCV-DUR-ARRAY[4] = "4";
                VHINC09IW.DISCV-DUR-ARRAY[5] = "5";
            else
                if (VHINC09IW.TYPE-IND == "SHP" ||
                 VHINC09IW.TYPE-IND == "YRD")
                    VHINC09IW.DISCV-DUR-ARRAY[1] = "2";
                    VHINC09IW.DISCV-DUR-ARRAY[2] = "3";
                    VHINC09IW.DISCV-DUR-ARRAY[3] = "4";
                    VHINC09IW.DISCV-DUR-ARRAY[4] = "5";
                end
            end
            ENABLE-DISCVDUR = "Y";
        end
    end
    VHINC09IW.DISP-DET = " ";
    VHINC09IW.DISP-CUM-HRS-MIN = " ";
    VHINC09IW.DISP-CUM-HRS = 0;
    VHINC09IW.DISP-CUM-MIN = 0;
    VHINC09IW.NARR-NO = 1;
    VHINC09IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHINC09IW.TIME-NARR = VGVar.currentFormattedTime;
