Function VHCI03IS-PSEUDO () 
    VHCI01IW.CAR-IN-CON-X = "N";
    set VHINXA_DATA empty;
    VHINXA_CRIT.CAR-NO = VHCI01IW.CAR-NO;
    try
        call "VHINXA"(XDCONTROL, VHINXA_CRIT, VHINXA_DATA);
    
    end
    
    
    MRSCommonCode.XXA0IS-CHECK_EXT();
    
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCI01IW.CAR-IN-CON-X = "Y";
        else
        
        
      
      
      
      

        end 
    end
    if (VHCI01IW.CAR-IN-CON-X == "Y")
        VHINXB_CRIT.CON-NO = VHINXA_DATA.CON-NO;
        VHINXB_DATA.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
        VHINXB_DATA.USER-GROUP = VHCI01IW.USER-GRP;
        VHCI01IW.CAR-CNT-X = 1;
        while (VHCI01IW.CAR-CNT-X <= 10)
            VHINXB_DATA.CAR-NUM[VHCI01IW.CAR-CNT-X] = VHINXA_DATA.CAR-NO[VHCI01IW.CAR-CNT-X];
            VHINXB_DATA.CON-NUM[VHCI01IW.CAR-CNT-X] = VHINXA_DATA.CON-NO[VHCI01IW.CAR-CNT-X];
            VHCI01IW.CAR-CNT-X = VHCI01IW.CAR-CNT-X + 1;
        end
        VHINXB_CRIT.YRD-SUB-LOC = VHINXA_DATA.YRD-SUB-LOC[1];
        try
            call "VHINXB"(XDCONTROL, VHINXB_CRIT, VHINXB_DATA);
        
        end
        
    
        MRSCommonCode.XXA0IS-CHECK_EXT();
    
        if (XXEXT_CALL_Level77Items.URC == 0)
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHCI01E_CRIT.SEND-RESET-MSG = "Y";
            else
        
        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

Function VHCI03IS-VALIDATE () 
    VHCI01E_CRIT.SEND-RESET-MSG = "N";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    VHCI01IW.CAR-NO = VHCI01IW.CAR-NO-NUM;
    if (VHCI01IW.CAR-NO == "0000")
        VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid Car No.";
        VHCI01IW.CAR-NO = " ";
        INVALID-CAR-NO = "Y";
    else
        if (VHCI01IW.CAR-NO not numeric)
            VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid car no";
            INVALID-CAR-NO = "Y";
        else
            if (VHCI01IW.STATUS == " ")
                VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid car status.";
                INVALID-STATUS = "Y";
            else
                VHCI03IS-ACT-STAT(); 
                if (ERROR-MSG == "N")
          
                    INVALID-DATE = "N";
                    INVALID-TIME = "N";
                    INVALID-NARR = "N";
                    INVALID-DATE-FUTURE = "N";
                    INVALID-TIME-FUTURE = "N";
                    INVALID-DATE-OLD = "N";
                    ERROR-IND = "N";
                    if (VHCI01IW.DATE-STAT-CHG == " ")
                        ERROR-IND = "Y";
                        INVALID-DATE = "Y";
                    else
                        AFCXVLD_CRIT.FORM-DATE = VHCI01IW.DATE-STAT-CHG;
                        MRSCommonCode.AFCXVLD-VALIDATE();
                        if (AFCXVLDW.INCORRECT-DATE == "Y")
                            ERROR-IND = "Y";
                            INVALID-DATE = "Y";
                        else
                            if (AFCXVLDW.SQL-ERROR == "Y")
                                ERROR-IND = "Y";
                                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                            else
                                if (AFCXVLDW.NO-ERROR == "Y")
                                    VHCI01IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
                                    if (((VHCI01IW.DATE-STAT-CHG-YEAR >
                                     VHCI01IW.SYSTEM-DATE-YEAR) ||
                                     ((VHCI01IW.DATE-STAT-CHG-YEAR ==
                                     VHCI01IW.SYSTEM-DATE-YEAR) &&
                                     (VHCI01IW.DATE-STAT-CHG-MON > VHCI01IW.SYSTEM-DATE-MON)) ||
                                     ((VHCI01IW.DATE-STAT-CHG-YEAR ==
                                     VHCI01IW.SYSTEM-DATE-YEAR) &&
                                     (VHCI01IW.DATE-STAT-CHG-MON == VHCI01IW.SYSTEM-DATE-MON) &&
                                     (VHCI01IW.DATE-STAT-CHG-DAY > VHCI01IW.SYSTEM-DATE-DAY))))
                                        ERROR-IND = "Y";
                                        INVALID-DATE-FUTURE = "Y";
                                    else
                                        JULIAN-DATE-1 = VGVar.currentJulianDate;
                                        XDATECON-W2.WS-GREG-IN-FLAG = "R";
                                        XDATECON-W2.WS-RPT-GREG-IN = VHCI01IW.DATE-STAT-CHG;
                                        MRSCommonCode.XDATECON-GREG2JUL();
                                        JULIAN-DATE-2 = XDATECON-W1.WS-DATES-CYDDD;
                                        JULIAN-DATE-DIFF = JULIAN-DATE-1 - JULIAN-DATE-2;
                                        if (JULIAN-DATE-DIFF > 365)
                                            ERROR-IND = "Y";
                                            INVALID-DATE-OLD = "Y";
                                        end
                                    end
                                end
                            end
                            if (ERROR-IND == "N")
                                if (VHCI01IW.DISP-TIME-STAT-CHG == " ")
                                    ERROR-IND = "Y";
                                    INVALID-TIME = "Y";
                                else
                                    if (VHCI01IW.DISP-TIME-STAT-CHG not numeric)
                                        ERROR-IND = "Y";
                                        INVALID-TIME = "Y";
                                    else
                                        if (DISP-TIME-STAT-CHG-HR > 24 ||
                                         (DISP-TIME-STAT-CHG-HR == 24 &&
                                         DISP-TIME-STAT-CHG-MIN > 0) ||
                                         (DISP-TIME-STAT-CHG-HR == 0 && DISP-TIME-STAT-CHG-MIN == 0) || DISP-TIME-STAT-CHG-MIN > 59)
                                            ERROR-IND = "Y";
                                            INVALID-TIME = "Y";
                                        else
                                            if (VHCI01IW.DATE-STAT-CHG == VHCI01IW.SYSTEM-DATE)
                                                VHCI01IW.SYSTEM-TIME = VGVar.currentFormattedTime;
                                                if (((VHCI01IW.DISP-TIME-STAT-CHG-HR >
                                                 VHCI01IW.SYSTEM-TIME-HR) ||
                                                 (VHCI01IW.DISP-TIME-STAT-CHG-HR ==
                                                 VHCI01IW.SYSTEM-TIME-HR &&
                                                 VHCI01IW.DISP-TIME-STAT-CHG-MIN >
                                                 VHCI01IW.SYSTEM-TIME-MIN)))
                                                    ERROR-IND = "Y";
                                                    INVALID-TIME-FUTURE = "Y";
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                            if (ERROR-IND == "N")
                                if (VHCI01IW.NARR == " ")
                                    ERROR-IND = "Y";
                                    INVALID-NARR = "Y";
                                else

                                end
                            end
                            if (ERROR-IND == "Y")
                                VHCI01IS-BLD-MSG();
                            else
                                VHCI03IS-NG-STATUS(); 
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHCI03IS-VALIDATE2 () 
    VHCI01E_CRIT.SEND-RESET-MSG = "N";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    VHCI01IW.CAR-NO = VHCI01IW.CAR-NO-NUM;
    if (VHCI01IW.CAR-NO == "0000")
        VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid Car No.";
        VHCI01IW.CAR-NO = " ";
        INVALID-CAR-NO = "Y";
    else
        if (VHCI01IW.CAR-NO not numeric)
            VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid car no";
            INVALID-CAR-NO = "Y";
        else
            if (VHCI01IW.STATUS == " ")
                VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid car status.";
                INVALID-STATUS = "Y";
            else
                VHCI03IS-ACT-STAT(); 
                if (ERROR-MSG == "N")
          
                    INVALID-DATE = "N";
                    INVALID-TIME = "N";
                    INVALID-NARR = "N";
                    INVALID-DATE-FUTURE = "N";
                    INVALID-TIME-FUTURE = "N";
                    INVALID-DATE-OLD = "N";
                    ERROR-IND = "N";
                    if (VHCI01IW.DATE-STAT-CHG == " ")
                        ERROR-IND = "Y";
                        INVALID-DATE = "Y";
                    else
                        AFCXVLD_CRIT.FORM-DATE = VHCI01IW.DATE-STAT-CHG;
                        MRSCommonCode.AFCXVLD-VALIDATE();
                        if (AFCXVLDW.INCORRECT-DATE == "Y")
                            ERROR-IND = "Y";
                            INVALID-DATE = "Y";
                        else
                            if (AFCXVLDW.SQL-ERROR == "Y")
                                ERROR-IND = "Y";
                                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                            else
                                if (AFCXVLDW.NO-ERROR == "Y")
                                    VHCI01IW.SYSTEM-DATE = VHCI02G_CRIT.CURRENT-DATE;
                                    if (((VHCI01IW.DATE-STAT-CHG-YEAR >
                                     VHCI01IW.SYSTEM-DATE-YEAR) ||
                                     ((VHCI01IW.DATE-STAT-CHG-YEAR ==
                                     VHCI01IW.SYSTEM-DATE-YEAR) &&
                                     (VHCI01IW.DATE-STAT-CHG-MON > VHCI01IW.SYSTEM-DATE-MON)) ||
                                     ((VHCI01IW.DATE-STAT-CHG-YEAR ==
                                     VHCI01IW.SYSTEM-DATE-YEAR) &&
                                     (VHCI01IW.DATE-STAT-CHG-MON == VHCI01IW.SYSTEM-DATE-MON) &&
                                     (VHCI01IW.DATE-STAT-CHG-DAY > VHCI01IW.SYSTEM-DATE-DAY))))
                                        ERROR-IND = "Y";
                                        INVALID-DATE-FUTURE = "Y";
                                    else
                                        if (VHCI01IW.DATE-STAT-CHG > VHCI02G_CRIT.CURRENT-DATE)
                                            ERROR-IND = "Y";
                                            INVALID-DATE-FUTURE = "Y";
                                        else
                                            JULIAN-DATE-1 = VGVar.currentJulianDate;
                                            XDATECON-W2.WS-GREG-IN-FLAG = "R";
                                            XDATECON-W2.WS-RPT-GREG-IN = VHCI01IW.DATE-STAT-CHG;
                                            MRSCommonCode.XDATECON-GREG2JUL();
                                            JULIAN-DATE-2 = XDATECON-W1.WS-DATES-CYDDD;
                                            JULIAN-DATE-DIFF = JULIAN-DATE-1 - JULIAN-DATE-2;
                                            if (JULIAN-DATE-DIFF > 365)
                                                ERROR-IND = "Y";
                                                INVALID-DATE-OLD = "Y";
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        if (ERROR-IND == "N")
                            if (VHCI01IW.DISP-TIME-STAT-CHG == " ")
                                ERROR-IND = "Y";
                                INVALID-TIME = "Y";
                            else
                                if (VHCI01IW.DISP-TIME-STAT-CHG not numeric)
                                    ERROR-IND = "Y";
                                    INVALID-TIME = "Y";
                                else
                                    if (DISP-TIME-STAT-CHG-HR > 24 ||
                                     (DISP-TIME-STAT-CHG-HR == 24 &&
                                     DISP-TIME-STAT-CHG-MIN > 0) ||
                                     (DISP-TIME-STAT-CHG-HR == 0 && DISP-TIME-STAT-CHG-MIN == 0) || DISP-TIME-STAT-CHG-MIN > 59)
                                        ERROR-IND = "Y";
                                        INVALID-TIME = "Y";
                                    else
                                        if (VHCI01IW.DATE-STAT-CHG == VHCI02G_CRIT.CURRENT-DATE)
                                            VHCI01IW.SYSTEM-TIME = VHCI02G_CRIT.CURRENT-TIME;
                                            if (((VHCI01IW.DISP-TIME-STAT-CHG-HR >
                                             VHCI01IW.SYSTEM-TIME-HR) ||
                                             (VHCI01IW.DISP-TIME-STAT-CHG-HR ==
                                             VHCI01IW.SYSTEM-TIME-HR &&
                                             VHCI01IW.DISP-TIME-STAT-CHG-MIN >
                                             VHCI01IW.SYSTEM-TIME-MIN)))
                                                ERROR-IND = "Y";
                                                INVALID-TIME-FUTURE = "Y";
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        if (ERROR-IND == "N")
                            if (VHCI01IW.NARR == " ")
                                ERROR-IND = "Y";
                                INVALID-NARR = "Y";
                            else

                            end
                        end
                        if (ERROR-IND == "Y")
                            VHCI01IS-BLD-MSG();
                        else
                            VHCI03IS-NG-STATU2(); 
                        end
                    end
                end
            end
        end
    end
end 

Function VHINC01IS-ADD () 
    VHINC01IS-CLR-FLDS();
    VHINC01IW.STORE-USER-GRP = VHINC01IW.USER-GRP;
    

  
  
  
  
  
    VHINC01IS-REV-TIME();
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        TEMP-DATE = VHXREVC_DATA.REVENUE-DATE;
        VHINC01IW.DATE-INCD-OCCR = TEMP-DATE;
        VHINC01IW.DATE-FILLER-1 = "-";
        VHINC01IW.DATE-FILLER-2 = "-";
        VHINC01IW.TIME-INCD-OCCR = VGVar.currentFormattedTime;
        VHINC01IW.TIME-INCD-OCCR-FILLER-1 = ":";
        VHINC01IW.TIME-INCD-OCCR-FILLER-2 = " ";
        DISP-TIME-INCD-OCCR-HR = VHINC01IW.TIME-INCD-OCCR-HR;
        DISP-TIME-INCD-OCCR-MIN = VHINC01IW.TIME-INCD-OCCR-MIN;
        VHXREVA_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
        VHINCE_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    else

    end
    DISABLE-PREV = "Y";
    DISABLE-NEXT = "Y";
    DISABLE-ADDNARR = "Y";
    ENABLE-INCDNARR = "Y";
    DISABLE-INCDNO = "Y";
    ENABLE-SYMPCD = "Y";
    ENABLE-SPEED = "Y";
    ENABLE-CONDIRECTION = "Y";
    ENABLE-INCDLOC = "Y";
    ENABLE-FIELDS = "Y";
    ENABLE-INCDDET = "Y";
    VHINC01IW.NARR-NO = 1;
    VHINC01IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHINC01IW.TIME-NARR = VGVar.currentFormattedTime;
    VHINC01IW.TIME-NARR-FILLER-1 = ":";
    VHINC01IW.TIME-NARR-FILLER-2 = " ";
    ENABLE-CREATE = "Y";
    DISABLE-CHANGE = "Y";
    BUTTON-CAPTION = "Create";
    CONNO-SETFOCUS = "Y";
end 

Function VHINC01IS-AFT-NAR () 
    VHINC01IW.NARR-COUNT = 0;
    VHINC1D_CRIT.INCD-NO = VHINC01IW.INCD-NO;
    VHINC1D_CRIT.RET-CHECK = "NARR";
    try
        call "VHINC1D"(XDCONTROL, VHINC1D_CRIT, VHINC1D_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHINC01IW.NARR-COUNT = XDCONTROL.UROWCNT;
        VHINC01IS-NARR-DET();
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC01IS-BLD-MSG ()
   
    ERROR-INDEX = 0;
    ERROR-MESSAGE = " ";
    if (VHINC01IW.CONSIST-NO == " ")
        if (INVALID-CON-NO == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid consist no.";
        end
    else
        if (DISPLAY-INVALID-CON-NO == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Consist No not found.";
        end
        if (DISPLAY-NOT-IN-SVC == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Consist not in service.";
        end
        if (NO-CAR-IN-CON == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Consist has no car.";
        end
    end
    if (VHINC01IW.SYMP-CD == " ")
        if (INVALID-SYMP-CD == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid symp cd.";
        end
    else
        if (INVALID-SYMPCD-VAL == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Symp cd does not exist.";
        end
    end
    if (INVALID-DATE-INCD == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date of incident.";
    else
        if (DAYS-GR-30 == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Date cannot be older than 30 days.";
        end
        if (DISP-ERR-MSG == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future date not allowed.";
        end
    end
    if (INVALID-TIME-INCD == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid time of incident.";
    else
        if (DISP-INVALID-TIME == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid time.";
        else
            if (DISP-TIME-ERRMSG == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future time not allowed.";
            end
        end
    end
    if (VHINC01IW.SPEED == " ")
        if (INVALID-SPEED == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid speed.";
        end
    else
        if (INVALID-SPEED-VAL == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Speed does not have a valid value.";
        end
    end
    if (VHINC01IW.CON-DIRECTION == " " &&  
     INVALID-DIRECTION == "Y")
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid direction.";
    else
        if (VHINC01IW.CON-DIRECTION != " " &&
         INVALID-DIRECTION == "Y")
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid direction.";
        end
    end
    if (ERROR-INDEX == 6)
        VHINC01IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-LOC == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid location.";
    end
    if (ERROR-INDEX == 6)
        VHINC01IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-NARR == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid incident narr.";
    end
    if (ERROR-INDEX == 6)
        VHINC01IS-MOVE-MSG();
        return;
    end
    if (INVALID-DATE == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date.";
    end
    VHINC01IS-MOVE-MSG();
end 

Function VHINC01IS-CHK-DATA ()
   
    ERROR-MESSAGE = " ";
    ERROR-INDEX = 0;
    ERROR-COUNT = 0;
    TOTAL-MIN-DIFF = 0;
    INVALID-CON-NO = "N"; 
    INVALID-INCD-NARR = "N"; 
    INVALID-SYMP-CD = "N"; 
    INVALID-DATE-INCD = "N"; 
    INVALID-TIME-INCD = "N"; 
    INVALID-SPEED = "N"; 
    INVALID-SPEED-VAL = "N"; 
    INVALID-DIRECTION = "N"; 
    INVALID-INCD-LOC = "N"; 
    INVALID-DATE = "N"; 
    DAYS-GR-30 = "N"; 
    DISP-ERR-MSG = "N"; 
    DISP-INVALID-TIME = "N"; 
    DISP-TIME-ERRMSG = "N"; 
    INVALID-SYMPCD-VAL = "N"; 
    DISPLAY-INVALID-CON-NO = "N"; 
    DISPLAY-NOT-IN-SVC = "N"; 
    NO-CAR-IN-CON = "N"; 

  
    if (CHECK-ENTRY == 1)
        if (VHINC01IW.CONSIST-NO == " ")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-CON-NO = "Y";
        end
        if (VHINC01IW.SYMP-CD == " ")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-SYMP-CD = "Y";
        end
        if (VHINC01IW.DATE-INCD-OCCR == " ")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-DATE-INCD = "Y";
        end
        if (VHINC01IW.TIME-INCD-OCCR-HR == " " &&
         VHINC01IW.TIME-INCD-OCCR-MIN == " ")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-TIME-INCD = "Y";
        end
        if (VHINC01IW.SPEED == " ")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-SPEED = "Y";
        end
        if (VHINC01IW.CON-DIRECTION == " ")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-DIRECTION = "Y";
        else
            if (VHINC01IW.CON-DIRECTION == "A" ||
             VHINC01IW.CON-DIRECTION == "N" ||
             VHINC01IW.CON-DIRECTION == "E" ||
             VHINC01IW.CON-DIRECTION == "W" ||
             VHINC01IW.CON-DIRECTION == "S")

            else
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-DIRECTION = "Y";
            end
        end
        if (VHINC01IW.INCD-LOC == " ")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-INCD-LOC = "Y";
        end
        if (VHINC01IW.INCD-NARR == " ")
            ERROR-COUNT = ERROR-COUNT + 1;
            INVALID-INCD-NARR = "Y";
        end
        if (VHINC01IW.SPEED != " ")
            if (VHINC01IW.SPEED != "ALL")
                LOOP-INDEX = 1;
                VHINC01IW.TEMP-SPEED-CHAR = VHINC01IW.SPEED;
                while ((LOOP-INDEX <= 3))
                    TEMP-SPEED-CHK-CHAR = TEMP-SPEED-OCCR-CHAR[LOOP-INDEX];
                    if (TEMP-SPEED-CHK-CHAR != " ")
                        if (TEMP-SPEED-CHK-CHAR != "0" &&
                         TEMP-SPEED-CHK-CHAR != "1" &&
                         TEMP-SPEED-CHK-CHAR != "2" &&
                         TEMP-SPEED-CHK-CHAR != "3" &&
                         TEMP-SPEED-CHK-CHAR != "4" &&
                         TEMP-SPEED-CHK-CHAR != "5" &&
                         TEMP-SPEED-CHK-CHAR != "6" &&
                         TEMP-SPEED-CHK-CHAR != "7" &&
                         TEMP-SPEED-CHK-CHAR != "8" &&
                         TEMP-SPEED-CHK-CHAR != "9")
                            ERROR-COUNT = ERROR-COUNT + 1;
                            INVALID-SPEED-VAL = "Y"; 
                            LOOP-INDEX = 4;
                        else

                        end
                    end
                    LOOP-INDEX = LOOP-INDEX + 1;
                end
            end
        end
        if (VHINC01IW.DISP-TIME-INCD-OCCR-HR != " " ||
         VHINC01IW.DISP-TIME-INCD-OCCR-MIN != " ")
            if (DISP-TIME-INCD-OCCR is numeric)
                if ((DISP-TIME-INCD-OCCR-HR-NUM > 24) ||
                 (DISP-TIME-INCD-OCCR-HR-NUM == 24 && DISP-TIME-INCD-OCCR-MIN-NUM >
                 0) ||
                 (DISP-TIME-INCD-OCCR-HR-NUM >= 0 && DISP-TIME-INCD-OCCR-MIN-NUM >
                 59) ||
                 (DISP-TIME-INCD-OCCR-HR-NUM == 0 && DISP-TIME-INCD-OCCR-MIN-NUM ==
                 0))
                    ERROR-COUNT = ERROR-COUNT + 1;
                    DISP-TIME-ERRMSG = "Y";
                    DISP-INVALID-TIME = "Y";
                end
            else
                ERROR-COUNT = ERROR-COUNT + 1;
                DISP-INVALID-TIME = "Y";
                DISP-TIME-ERRMSG = "Y";
            end
            if (DISP-TIME-ERRMSG == "N")
                VHINC1A_CRIT.REVENUE-TIME-HR = VHINC01IW.DISP-TIME-INCD-OCCR-HR;
                VHINC1A_CRIT.REVENUE-TIME-MIN = VHINC01IW.DISP-TIME-INCD-OCCR-MIN;
                VHINC1A_CRIT.VAGen_COUNT = 0;
                VHINC1A_CRIT.SYMP-CD = VHINC01IW.SYMP-CD;
                VHINC1A_CRIT.ALLOW-TIME = VGVar.currentFormattedTime;
                TOTAL-REV-MIN = (VHINC1A_CRIT.REVENUE-TIME-HR-NUM * 60) + VHINC1A_CRIT.REVENUE-TIME-MIN-NUM;
                TOTAL-ALLOW-MIN = (VHINC1A_CRIT.ALLOW-TIME-HR-NUM * 60) + VHINC1A_CRIT.ALLOW-TIME-MIN-NUM;
                TOTAL-MIN-DIFF = TOTAL-REV-MIN - TOTAL-ALLOW-MIN;
                if (VHINC1A_CRIT.REVENUE-TIME-HR-NUM <= 23 &&
                 (VHINC1A_CRIT.ALLOW-TIME-HR-NUM >= 0 &&
                 VHINC1A_CRIT.ALLOW-TIME-HR-NUM <= 3))

                else
                    if (TOTAL-MIN-DIFF > 60)
                        ERROR-COUNT = ERROR-COUNT + 1;
            
                        DISP-TIME-ERRMSG = "Y";
                    end
                end
            end
        end
        if (VHINC01IW.SYMP-CD != " ")
            VHINC1A_CRIT.VAGen_COUNT = 0;
            VHINC1A_CRIT.SYMP-CD = VHINC01IW.SYMP-CD;
            try
                call "VHINC1A"(XDCONTROL, VHINC1A_CRIT);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                if (VHINC1A_CRIT.VAGen_COUNT == 0)
                    ERROR-COUNT = ERROR-COUNT + 1;
                    INVALID-SYMPCD-VAL = "Y";
                end
            end
        end
        if (VHINC01IW.CONSIST-NO != " ")
  
            VHINC1B_DATA.CON-NO = VHINC01IW.CONSIST-NO;
            try
                call "VHINC1B"(XDCONTROL, VHINC1B_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                if (XDCONTROL.UROWCNT == 0)
                    ERROR-COUNT = ERROR-COUNT + 1;
                    DISPLAY-INVALID-CON-NO = "Y";
                else
                    if (VHINC1B_DATA.IN-USE-IND != "Y")
                        ERROR-COUNT = ERROR-COUNT + 1;
                        DISPLAY-NOT-IN-SVC = "Y";
                    else
                        if (VHINC1B_DATA.NO-CARS-IND == "Y")
                            ERROR-COUNT = ERROR-COUNT + 1;
                            NO-CAR-IN-CON = "Y";
                        end
                    end
                end
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
        if (ERROR-COUNT > 0)
            VHINC01IS-BLD-MSG(); 
        else
            VHINC01IS-STORE-DB(); 
            CONNO-SETFOCUS = "Y";
        end
    else
  
        if (CHECK-ENTRY == 2)
            if (VHINC01IW.SYMP-CD == " ")
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-SYMP-CD = "Y";
            end
            if (VHINC01IW.SPEED == " ")
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-SPEED = "Y";
            end
            if (VHINC01IW.CON-DIRECTION == " ")
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-DIRECTION = "Y";
            end
            if (VHINC01IW.INCD-LOC == " ")
                ERROR-COUNT = ERROR-COUNT + 1;
                INVALID-INCD-LOC = "Y";
            end
            if (VHINC01IW.SPEED != " ")
                if (VHINC01IW.SPEED != "ALL")
                    LOOP-INDEX = 1;
                    VHINC01IW.TEMP-SPEED-CHAR = VHINC01IW.SPEED;
                    while ((LOOP-INDEX <= 3))
                        TEMP-SPEED-CHK-CHAR = TEMP-SPEED-OCCR-CHAR[LOOP-INDEX];
                        if (TEMP-SPEED-CHK-CHAR != " ")
                            if (TEMP-SPEED-CHK-CHAR != "0" &&
                             TEMP-SPEED-CHK-CHAR != "1" &&
                             TEMP-SPEED-CHK-CHAR != "2" &&
                             TEMP-SPEED-CHK-CHAR != "3" &&
                             TEMP-SPEED-CHK-CHAR != "4" &&
                             TEMP-SPEED-CHK-CHAR != "5" &&
                             TEMP-SPEED-CHK-CHAR != "6" &&
                             TEMP-SPEED-CHK-CHAR != "7" &&
                             TEMP-SPEED-CHK-CHAR != "8" &&
                             TEMP-SPEED-CHK-CHAR != "9")
                                ERROR-COUNT = ERROR-COUNT + 1;
                                INVALID-SPEED-VAL = "Y"; 
                                LOOP-INDEX = 4;
                            end
                        end
                        LOOP-INDEX = LOOP-INDEX + 1;
                    end
                end
            end
            if (VHINC01IW.SYMP-CD != " ")
                VHINC1A_CRIT.VAGen_COUNT = 0;
                VHINC1A_CRIT.SYMP-CD = VHINC01IW.SYMP-CD;
                try
                    call "VHINC1A"(XDCONTROL, VHINC1A_CRIT);
                
                end
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    if (VHINC1A_CRIT.VAGen_COUNT == 0)
                        ERROR-COUNT = ERROR-COUNT + 1;
                        INVALID-SYMPCD-VAL = "Y";
                    end
                end
            end
            if (ERROR-COUNT > 0)
                VHINC01IS-BLD-MSG(); 
            else
                VHINC01IS-STORE-DB(); 
            end
        end
    end
end 

Function VHINC01IS-CLEAR () 
    set VH001IW-MESSAGEX empty;
    VHINC01IS-CLR-FLDS();
    VHINC01IW.USER-GRP = VHINC01IW.STORE-USER-GRP;
    

  
  
  
  
  
    VHINC01IS-REV-TIME();
    VHXREVA_DATA.REVENUE-DATE = VHXREVC_DATA.REVENUE-DATE;
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        TEMP-DATE = VHXREVA_DATA.REVENUE-DATE;
        VHINC01IW.DATE-INCD-OCCR = TEMP-DATE;
        VHINC01IW.DATE-FILLER-1 = "-";
        VHINC01IW.DATE-FILLER-2 = "-";
        VHINC01IW.TIME-INCD-OCCR = VGVar.currentFormattedTime;
        VHINC01IW.TIME-INCD-OCCR-FILLER-1 = ":";
        VHINC01IW.TIME-INCD-OCCR-FILLER-2 = " ";
        DISP-TIME-INCD-OCCR-HR = VHINC01IW.TIME-INCD-OCCR-HR;
        DISP-TIME-INCD-OCCR-MIN = VHINC01IW.TIME-INCD-OCCR-MIN;
        VHXREVA_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    else

    end
    DISABLE-PREV = "Y";
    DISABLE-NEXT = "Y";
    if (CHECK-ENTRY == 1) 
        DISABLE-ADDNARR = "Y";
        ENABLE-INCDNARR = "Y";
        DISABLE-INCDNO = "Y";
        ENABLE-SYMPCD = "Y";
        ENABLE-SPEED = "Y";
        ENABLE-CONDIRECTION = "Y";
        ENABLE-INCDLOC = "Y";
        ENABLE-FIELDS = "Y";
        ENABLE-INCDDET = "Y";
        VHINC01IW.NARR-NO = 1;
        VHINC01IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
        VHINC01IW.TIME-NARR = VGVar.currentFormattedTime;
        VHINC01IW.TIME-NARR-FILLER-1 = ":";
        VHINC01IW.TIME-NARR-FILLER-2 = " ";
        ENABLE-CREATE = "Y";
        DISABLE-CHANGE = "Y";
        BUTTON-CAPTION = "Create";
        CONNO-SETFOCUS = "Y";
    else
        if (CHECK-ENTRY == 2) 
            DISABLE-INCDDET = "Y";
            ENABLE-INCDNO = "Y";
            DISABLE-FIELDS = "Y";
            DISABLE-SYMPCD = "Y";
            DISABLE-SPEED = "Y";
            DISABLE-CONDIRECTION = "Y";
            DISABLE-INCDLOC = "Y";
            DISABLE-ADDNARR = "Y";
            DISABLE-CREATE = "Y";
            DISABLE-CHANGE = "Y";
            BUTTON-CAPTION = "Change";
            INCDNO-SETFOCUS = "Y";
        end
    end
end 

Function VHINC01IS-CLR-FLDS () 
    SUCCESS-MESSAGE = " ";
