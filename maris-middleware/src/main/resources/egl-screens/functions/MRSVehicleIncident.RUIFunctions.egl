Function VHINC03IS-NARR-DET () 
    NARR-INDEX = 1;
    VHINC03IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC03IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC03IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC03IW.DATE-NARR-FILLER1 = "-";
    VHINC03IW.DATE-NARR-FILLER2 = "-";
    VHINC03IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC03IW.TIME-NARR-FILLER-1 = ":";
    VHINC03IW.TIME-NARR-FILLER-2 = " ";
    VHINC03IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
    if (NARR-COUNT > 1)
        DISABLE-PREV = "Y";
        ENABLE-NEXT = "Y";
    else
        DISABLE-PREV = "Y";
        DISABLE-NEXT = "Y";
    end
end 

Function VHINC03IS-PRVNXT () 
    if (BUTTON-CLICK == "PREV")
        VHINC03IW.NARR-INDEX = VHINC03IW.NARR-INDEX - 1;
        if (VHINC03IW.NARR-INDEX <= 1)
            VHINC03IW.NARR-INDEX = 1;
            DISABLE-PREV = "Y";
        else
            ENABLE-PREV = "Y";
        end
        ENABLE-NEXT = "Y";
    else
        if (BUTTON-CLICK == "NEXT")
            VHINC03IW.NARR-INDEX = VHINC03IW.NARR-INDEX + 1;
            ENABLE-PREV = "Y";
            if (VHINC03IW.NARR-INDEX >= VHINC03IW.NARR-COUNT)
                VHINC03IW.NARR-INDEX = VHINC03IW.NARR-COUNT;
                DISABLE-NEXT = "Y";
            else
                ENABLE-NEXT = "Y";
            end
        end
    end
    VHINC03IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC03IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC03IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC03IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC03IW.TIME-NARR-FILLER-1 = ":";
    VHINC03IW.TIME-NARR-FILLER-2 = " ";
    VHINC03IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
end 

Function VHINC03IS-REV-TIME () 
    try
        call "VHINCD"(XDCONTROL, VHINCD_DATA);
    
    end
    VHXREVC_DATA.DB-REVENUE-DATE = VHINCD_DATA.REVENUE-DATE;
    
  
    VHXREVC_DATA.END-TIME-DAY = "24.00.00";
    

  
  
    VHXREVC_DATA.TIME-REV-START = "03.00.00";
    VHXREVC_DATA.TIME-REV-END = "02.59.59";
    

  
  
  
  
  

  
  

  
    try
        call "VHCI02G"(XDCONTROL, VHCI02G_CRIT, VHCI02G_DATA);
    
    end
    if (XDCONTROL.UROWCNT == 1)
        VHXREVC_DATA.SYSTEM-DATE = VHCI02G_CRIT.CURRENT-DATE;
        VHXREVC_DATA.SYSTEM-TIME = VHCI02G_CRIT.CURRENT-TIME;
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    VHXREVC_DATA.SYS-MINUTES = (VHXREVC_DATA.SYSTEM-TIME-HR-NUM * 60) + VHXREVC_DATA.SYSTEM-TIME-MIN-NUM;
    if (VHXREVC_DATA.SYS-MINUTES < 180)
  
  
        XXDATEW.DATE-YYYY-MM-DD = VHXREVC_DATA.DB-REVENUE-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHXREVC_DATA.REVENUE-DATE = XXDATEW.DATE-MM-DD-YYYY;
    else
        VHXREVC_DATA.REVENUE-DATE = VHXREVC_DATA.SYSTEM-DATE;
    end
    VHXREVA_DATA.REVENUE-DATE = VHXREVC_DATA.REVENUE-DATE;
end 

Function VHINC03IS-SETFOCUS () 
    if (INVALID-CAR-NO == "Y" ||
     DISPLAY-INVALID-CAR-NO == "Y" ||
     DISPLAY-IN-USE == "Y")
        CAR-SETFOCUS = "Y";
    else
        if (INVALID-SYMP-CD == "Y" ||
         INVALID-SYMPCD-VAL == "Y")
            SYMPCD-SETFOCUS = "Y";
        else
            if (INVALID-DISCV-DUR == "Y") 
                DISCVDUR-SETFOCUS = "Y";
            else
                if (INVALID-DATE == "Y" ||
                 INVALID-DATE-INCD == "Y" ||
                 DAYS-GR-210 == "Y" ||
                 DAYS-GR-30 == "Y" ||
                 DISP-ERR-MSG == "Y")
                    DATE-SETFOCUS = "Y";
                else
                    if (INVALID-TIME-INCD == "Y" ||
                     DISP-INVALID-TIME == "Y" ||
                     DISP-TIME-ERRMSG == "Y")
                        TIME-SETFOCUS = "Y";
                    else
                        if (INVALID-INCD-LOC == "Y") 
                            LOC-SETFOCUS = "Y";
                        else
                            if (INVALID-INCD-NARR == "Y")
                                NARR-SETFOCUS = "Y";
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHINC03IS-STORE-DB ()
  
   
    SUCCESS-MESSAGE = " ";
    VHINC03IW.MARIS-FUNC = "VHINC";
    VHINC03IS-MOVE-RE2();
    if (VHINCZ_CRIT.TYPE-IND == "SHN") 
        VHINCZ_CRIT.INCD-PFX = "U";
        VHINCZ_CRIT.INCD-TYPE = "SHN";
        VHINCZ_CRIT.INCIDENT-NAME = "IVS";
    else
        if (VHINCZ_CRIT.TYPE-IND == "MSC") 
            VHINCZ_CRIT.INCD-PFX = "D";
            VHINCZ_CRIT.INCD-TYPE = "MSC";
            VHINCZ_CRIT.INCIDENT-NAME = "IVM";
        else
            if (VHINCZ_CRIT.TYPE-IND == "EVT") 
                VHINCZ_CRIT.INCD-PFX = "E";
                VHINCZ_CRIT.INCD-TYPE = "EVT";
                VHINCZ_CRIT.INCIDENT-NAME = "IVE";
            end
        end
    end
    VHINCZ_DATA.INCD-TYPE = VHINCZ_CRIT.INCD-TYPE;
    try
        call "VHINCZ"(XDCONTROL, VHINCZ_CRIT, VHINCZ_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHINC03IW.INCD-NO = VHINCZ_DATA.INCD-NO;
        VHINC03IW.NARR-COUNT = 1;
        SUCCESS-MESSAGE-1 = "Incd No ";
        SUCCESS-MESSAGE-2 = VHINCZ_DATA.INCD-NO;
        SUCCESS-MESSAGE-3 = " for Car ";
        SUCCESS-MESSAGE-4 = VHINC03IW.CAR-NO;
        SUCCESS-MESSAGE-5 = " was filed succesfully";
        
  
  
  
  
  
        VHINC03IS-CA-CICS();
        VHINC03IS-CLEAR-DB(); 
                                   
    else
        EXECUTE-CLEAR = "Y";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC03IS-SYMP-CD () 
    if (VHINC03IW.SYMP-CD != " ")
        VHINC3B_CRIT.SYMP-CD = VHINC03IW.SYMP-CD;
        try
            call "VHINC3B"(XDCONTROL, VHINC3B_CRIT);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHINC03IW.INCD-NARR = VHINC3B_CRIT.SYMP-CD-NARR;
        else
            VHINC03IW.INCD-NARR = " ";
        end
    end
end 

Function VHINC06IS-123 () 
    CREATE-SW = CREATE-SW + 1;
    if (CREATE-SW == 1)
        VHINC06IS-CHK-DATA();
    end
end 

Function VHINC06IS-AFT-NAR () 
    VHINC06IW.NARR-COUNT = 0;
    VHINC1D_CRIT.INCD-NO = VHINC06IW.INCD-NO;
    VHINC1D_CRIT.RET-CHECK = "NARR";
    try
        call "VHINC1D"(XDCONTROL, VHINC1D_CRIT, VHINC1D_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHINC06IW.NARR-COUNT = XDCONTROL.UROWCNT;
        VHINC06IS-NARR-DET();
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC06IS-BLD-MSG ()
   
    ERROR-INDEX = 0;
    ERROR-MESSAGE = " ";
    if (VHINC06IW.CAR-NO == "0000")
        if (INVALID-CAR-NO == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid car no.";
            VHINC06IW.CAR-NO = " ";
        end
    else
        if (DISPLAY-INVALID-CAR-NO == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid car no.";
            VHINC06IW.CAR-NO = " ";
        end
        if (DISPLAY-NOT-IN-SVC == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Car not in use.";
        end
    end
    if (VHINC06IW.SYMP-CD == " ")
        if (INVALID-SYMP-CD == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid symp cd.";
        end
    else
        if (INVALID-SYMPCD-VAL == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Symp cd does not exist.";
        end
    end
    if (INVALID-DATE-INCD == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date of incident.";
    else
        if (DAYS-GR-05 == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Date cannot be older than 5 days.";
        else
            if (DISP-ERR-MSG == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future date not allowed.";
            end
        end
    end
    if (INVALID-TIME-INCD == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid time of incident.";
    else
        if (DISP-INVALID-TIME == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid time.";
        else
            if (DISP-TIME-ERRMSG == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future time not allowed.";
            end
        end
    end
    if (VHINC06IW.SPEED == " ")
        if (INVALID-SPEED == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid speed.";
        end
    else
        if (INVALID-SPEED-VAL == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Speed does not have a valid value.";
        end
    end
    if (INVALID-DIRECTION == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid direction.";
    end
    if (ERROR-INDEX == 6)
        VHINC06IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-LOC == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid location.";
    end
    if (ERROR-INDEX == 6)
        VHINC06IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-NARR == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid incident narr.";
    end
    if (ERROR-INDEX == 6)
        VHINC06IS-MOVE-MSG();
        return;
    end
    if (INVALID-DATE == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date.";
    end
    VHINC06IS-MOVE-MSG();
end 



