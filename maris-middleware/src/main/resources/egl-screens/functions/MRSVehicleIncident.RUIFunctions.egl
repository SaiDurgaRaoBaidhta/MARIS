    VHINC10IW.CON-DIRECTION = VHINC1D_DATA.CON-DIRECTION;
    VHINC10IW.INCD-LOC = VHINC1D_DATA.INCD-LOC;
    VHINC10IW.DEFERRED-PRIORITY = VHINC1D_DATA.DEFERRED-PRIORITY;
    VHINC10IW.INCD-TYPE = VHINC1D_DATA.INCD-TYPE;
    VHINC10IW.TIME-LAST-UPD = VHINC1D_DATA.TIME-LAST-UPD;
    if (VHINC10IW.TIME-LAST-UPD == " ")
        VHINC10IW.TIME-LAST-FILLER-1 = " ";
        VHINC10IW.TIME-LAST-FILLER-2 = " ";
    else
        VHINC10IW.TIME-LAST-FILLER-1 = ":";
        VHINC10IW.TIME-LAST-FILLER-2 = ":";
    end
  
    VHINC1D_DATA.TIME-LAST-UPD = VHINC10IW.TIME-LAST-UPD;
    VHINC10IW.TIME-MAINT-UPD = VHINC1D_DATA.TIME-MAINT-UPD;
    if (VHINC10IW.TIME-MAINT-UPD == " ")
        VHINC10IW.TIME-MAINT-FILLER-1 = " ";
        VHINC10IW.TIME-MAINT-FILLER-2 = " ";
    else
        VHINC10IW.TIME-MAINT-FILLER-1 = ":";
        VHINC10IW.TIME-MAINT-FILLER-2 = ":";
    end
    VHINC1D_DATA.TIME-MAINT-UPD = VHINC10IW.TIME-MAINT-UPD;
    VHINC10IS-NARR-DET();

  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  

  
  
  
  
  
    if (VHINC10IW.CON-NO != " " &&
     VHINC10IW.DASH-NO > 0)
        VHINC9A_CRIT.CON-NO = VHINC10IW.CON-NO;
        VHINC9A_CRIT.DASH-NO = VHINC10IW.DASH-NO;
        VHINC9A_CRIT.DATE-INSRV-REV = VHINC1D_DATA.DATE-INSRV-REV;
        VHINC9A_CRIT.DATE-INSRV = VHINC1D_DATA.DATE-INSRV;
        VHINC9A_CRIT.TIME-INSRV = VHINC1D_DATA.TIME-INSRV;
  
        try
            call "VHINC9A"(XDCONTROL, VHINC9A_CRIT, VHINC9A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        else
            VHINC9A_DATA.DISP-DATA-ROW = " ";
        end
    end
    ENABLE-INCDDET = "Y";
    DISABLE-FIELDS = "Y";
    ENABLE-SYMPCD = "Y";
    ENABLE-INCDLOC = "Y";
    ENABLE-INCDNARR = "Y";
    ENABLE-ADDNARR = "Y";
    ENABLE-CHANGE = "Y";
    SYMPCD-SETFOCUS = "Y";
end 

Function VHINC10IS-INIT () 
    try
        call "MRSVehicleMenu.VH01A01"(XDCONTROL, VH01A01_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else

        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC10IS-MOVE ()
   
    
    VHINCXC_CRIT.NARR-CHG = "N";
    VHINCXC_CRIT.INCD-NO = VHINC10IW.INCD-NO;
    VHINCXC_DATA.SPEED = VHINC10IW.SPEED;
    VHINCXC_DATA.SYMP-CD = VHINC10IW.SYMP-CD;
    VHINCXC_DATA.CON-DIRECTION = VHINC10IW.CON-DIRECTION;
    VHINCXC_DATA.INCD-LOC = VHINC10IW.INCD-LOC;
    VHINCXC_DATA.TERM-LAST-UPD = VHINC10IW.TERM-LAST-UPD;
    VHINCXC_DATA.USER-GRP = VHINC10IW.USER-GRP;
    VHINCXC_DATA.VEH-INCD-STAT = VHINC10IW.VEH-INCD-STAT;
    VHINCXC_DATA.INCD-TYPE = VHINC10IW.INCD-TYPE;
    VHINCXC_DATA.DEFERRED-PRIORITY = VHINC10IW.DEFERRED-PRIORITY;
    VHINCXC_DATA.DISCV-DUR = VHINC10IW.DISCV-DUR;
    VHINCXC_DATA.CUM-HRS = VHINC10IW-HRS.CUM-HRS;
    VHINCXC_DATA.CUM-MIN = VHINC10IW-HRS.CUM-MIN;
    if (VHINC10IW.TEMP-INCD-NARR != VHINC10IW.INCD-NARR)
        VHINCXC_CRIT.NARR-CHG = "Y";
    else
        VHINCXC_CRIT.NARR-CHG = "N";
    end
    try
        call "VHINCXC"(XDCONTROL, VHINCXC_CRIT, VHINCXC_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        DISABLE-CHANGE = "Y";
        UPDATE-MSG = "Y";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC10IS-NARR-DET () 
    NARR-INDEX = 1;
    VHINC10IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC10IW.TEMP-INCD-NARR = VHINC10IW.INCD-NARR;
    VHINC10IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC10IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC10IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC10IW.TIME-NARR-FILLER-1 = ":";
    VHINC10IW.TIME-NARR-FILLER-2 = ":";
    VHINC10IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
    if (NARR-COUNT > 1)
        DISABLE-PREV = "Y";
        ENABLE-NEXT = "Y";
    else
        DISABLE-PREV = "Y";
        DISABLE-NEXT = "Y";
    end
end 

Function VHINC10IS-PRVNXT () 
    if (BUTTON-CLICK == "PREV")
        VHINC10IW.NARR-INDEX = VHINC10IW.NARR-INDEX - 1;
        if (VHINC10IW.NARR-INDEX <= 1)
            VHINC10IW.NARR-INDEX = 1;
            DISABLE-PREV = "Y";
        else
            ENABLE-PREV = "Y";
        end
        ENABLE-NEXT = "Y";
    else
        if (BUTTON-CLICK == "NEXT")
            VHINC10IW.NARR-INDEX = VHINC10IW.NARR-INDEX + 1;
            ENABLE-PREV = "Y";
            if (VHINC10IW.NARR-INDEX >= VHINC10IW.NARR-COUNT)
                VHINC10IW.NARR-INDEX = VHINC10IW.NARR-COUNT;
                DISABLE-NEXT = "Y";
            else
                ENABLE-NEXT = "Y";
            end
        end
    end
    VHINC10IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC10IW.TEMP-INCD-NARR = VHINC10IW.INCD-NARR;
    VHINC10IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC10IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC10IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC10IW.TIME-NARR-FILLER-1 = ":";
    VHINC10IW.TIME-NARR-FILLER-2 = ":";
    VHINC10IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
end 

Function VHINC10IS-RET-INCD () 
    INCD-MESSAGE = " ";
    if (VHINC10IW.INCD-NO != " ")
        VHINC10IW.NARR-COUNT = 0;
        VHINC1D_CRIT.INCD-NO = VHINC10IW.INCD-NO;
        VHINC1D_CRIT.RET-CHECK = "BOTH";
        try
            call "VHINC1D"(XDCONTROL, VHINC1D_CRIT, VHINC1D_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHINC10IW.NARR-COUNT = XDCONTROL.UROWCNT;
            VHINC10IW.DISP-CUM-HRS = VHINC1D_DATA.CUM-HRS;
            VHINC10IW.DISP-CUM-MIN = VHINC1D_DATA.CUM-MIN;
            

  
  
  
  
  
  
  
  
  
  
  
            VHINC10IS-INCD-DET();
  
  
  
  
  
  
  
        else
            EXECUTE-CLEAR = "Y";
            INCD-NOT-FOUND = "Y";
        end
    else
  

    end
end 

Function VHINC10IS-SETFOCUS () 
    if (INVALID-SYMP-CD == "Y" ||
     INVALID-SYMPCD-VAL == "Y")
        SYMPCD-SETFOCUS = "Y";
    else
        if (VHINC1D_DATA.INCD-TYPE == "REV")
            if (INVALID-SPEED == "Y" ||
             INVALID-SPEED-VAL == "Y") 
                SPEED-SETFOCUS = "Y";
            else
                if (INVALID-DIRECTION == "Y")
                    DIRECTION-SETFOCUS = "Y";
                end
            end
        end
        if (INVALID-DISCV-DUR == "Y") 
            DISCVDUR-SETFOCUS = "Y";
        else
            if (INVALID-INCD-LOC == "Y") 
                LOC-SETFOCUS = "Y";
            else
                if (INVALID-INCD-NARR == "Y")
                    NARR-SETFOCUS = "Y";
                end
            end
        end
    end
end 

Function VHINC10IS-STORE-DB ()
   
    
    VHINCXB_CRIT.NARR-CHG = "N";
    VHINCXB_CRIT.INCD-NO = VHINC10IW.INCD-NO;
    VHINCXB_DATA.SPEED = VHINC10IW.SPEED;
    VHINCXB_DATA.SYMP-CD = VHINC10IW.SYMP-CD;
    VHINCXB_DATA.CON-DIRECTION = VHINC10IW.CON-DIRECTION;
    VHINCXB_DATA.INCD-LOC = VHINC10IW.INCD-LOC;
    VHINCXB_DATA.TERM-LAST-UPD = VHINC10IW.TERM-LAST-UPD;
    VHINCXB_DATA.USER-GRP = VHINC10IW.USER-GRP;
    VHINCXB_DATA.VEH-INCD-STAT = VHINC10IW.VEH-INCD-STAT;
    VHINCXB_DATA.INCD-TYPE = VHINC10IW.INCD-TYPE;
    VHINCXB_DATA.DEFERRED-PRIORITY = VHINC10IW.DEFERRED-PRIORITY;
    VHINCXB_DATA.DISCV-DUR = VHINC10IW.DISCV-DUR;
    if (VHINC10IW.TEMP-INCD-NARR != VHINC10IW.INCD-NARR)
        VHINCXB_CRIT.NARR-CHG = "Y";
    else
        VHINCXB_CRIT.NARR-CHG = "N";
    end
    try
        call "VHINCXB"(XDCONTROL, VHINCXB_CRIT, VHINCXB_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        DISABLE-CHANGE = "Y";
        UPDATE-MSG = "Y";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end
