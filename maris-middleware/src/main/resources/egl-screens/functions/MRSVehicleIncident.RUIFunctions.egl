Function VHINC06IS-NARR-DET () 
    NARR-INDEX = 1;
    VHINC06IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC06IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC06IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC06IW.DATE-NARR-FILLER1 = "-";
    VHINC06IW.DATE-NARR-FILLER2 = "-";
    VHINC06IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC06IW.TIME-NARR-FILLER-1 = ":";
    VHINC06IW.TIME-NARR-FILLER-2 = " ";
    VHINC06IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
    if (NARR-COUNT > 1)
        DISABLE-PREV = "Y";
        ENABLE-NEXT = "Y";
    else
        DISABLE-PREV = "Y";
        DISABLE-NEXT = "Y";
    end
end 

Function VHINC06IS-PRVNXT () 
    if (BUTTON-CLICK == "PREV")
        VHINC06IW.NARR-INDEX = VHINC06IW.NARR-INDEX - 1;
        if (VHINC06IW.NARR-INDEX <= 1)
            VHINC06IW.NARR-INDEX = 1;
            DISABLE-PREV = "Y";
        else
            ENABLE-PREV = "Y";
        end
        ENABLE-NEXT = "Y";
    else
        if (BUTTON-CLICK == "NEXT")
            VHINC06IW.NARR-INDEX = VHINC06IW.NARR-INDEX + 1;
            ENABLE-PREV = "Y";
            if (VHINC06IW.NARR-INDEX >= VHINC06IW.NARR-COUNT)
                VHINC06IW.NARR-INDEX = VHINC06IW.NARR-COUNT;
                DISABLE-NEXT = "Y";
            else
                ENABLE-NEXT = "Y";
            end
        end
    end
    VHINC06IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC06IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC06IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC06IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC06IW.TIME-NARR-FILLER-1 = ":";
    VHINC06IW.TIME-NARR-FILLER-2 = " ";
    VHINC06IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
end 

Function VHINC06IS-SETFOCUS () 
    CREATE-SW = 0;
    if (INVALID-CAR-NO == "Y" ||
     DISPLAY-INVALID-CAR-NO == "Y" ||
     DISPLAY-NOT-IN-SVC == "Y")
        CARNO-SETFOCUS = "Y";
    else
        if (INVALID-SYMP-CD == "Y" ||
         INVALID-SYMPCD-VAL == "Y")
            SYMPCD-SETFOCUS = "Y";
        else
            if (INVALID-DATE-INCD == "Y" ||
             DAYS-GR-05 == "Y" ||
             DISP-ERR-MSG == "Y" ||
             INVALID-DATE == "Y")
                INCDDATE-SETFOCUS = "Y";
            else
                if (INVALID-TIME-INCD == "Y" ||
                 DISP-INVALID-TIME == "Y" ||
                 DISP-TIME-ERRMSG == "Y")
                    INCDTIME-SETFOCUS = "Y";
                else
                    if (INVALID-SPEED == "Y" ||
                     INVALID-SPEED-VAL == "Y")
                        SPEED-SETFOCUS = "Y";
                    else
                        if (INVALID-DIRECTION == "Y")
                            DIRECTION-SETFOCUS = "Y";
                        else
                            if (INVALID-INCD-LOC == "Y")
                                INCDLOC-SETFOCUS = "Y";
                            else
                                if (INVALID-INCD-NARR == "Y")
                                    NARR-SETFOCUS = "Y";
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHINC06IS-STORE-DB ()
  
  
   
    SUCCESS-MESSAGE = " ";
    VHINC06IW.MARIS-FUNC = "VHINC";
    
  
    VHINC06IS-MOVE-RE2();
    VHINCX_CRIT.INCD-PFX = "G";
    VHINCX_CRIT.INCD-TYPE = "REV";
    VHINCX_CRIT.INCIDENT-NAME = "IVR";
    VHINCX_DATA.TERM-LAST-UPD = VHINC06IW.TERM-LAST-UPD;
    VHINCX_DATA.INCD-TYPE = VHINCX_CRIT.INCD-TYPE;
    try
        call "VHINCX"(XDCONTROL, VHINCX_CRIT, VHINCX_DATA);
    
    end
    if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
     VHINCX_CRIT.ERR-FOUND == "N")
        VHINC06IW.INCD-NO = VHINCX_DATA.INCD-NO;
        VHINC06IW.NARR-COUNT = 1;
        SUCCESS-MESSAGE-1 = "Incd No ";
        SUCCESS-MESSAGE-2 = VHINCX_DATA.INCD-NO;
        SUCCESS-MESSAGE-3 = " for Car ";
        SUCCESS-MESSAGE-4 = VHINC06IW.CAR-NO;
        SUCCESS-MESSAGE-5 = " was filed succesfully";
        
  
  
  
  
  
  
        VHINC06IS-CA-CIC2();
        VHINC06IS-CLEAR-DB(); 
                                   
    else
        EXECUTE-CLEAR = "Y";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC08IS-AFT-NAR () 
    VHINC08IW.NARR-COUNT = 0;
    VHINC1D_CRIT.INCD-NO = VHINC08IW.INCD-NO;
    VHINC1D_CRIT.RET-CHECK = "NARR";
    try
        call "VHINC1D"(XDCONTROL, VHINC1D_CRIT, VHINC1D_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHINC08IW.NARR-COUNT = XDCONTROL.UROWCNT;
        VHINC08IS-NARR-DET();
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHINC08IS-BLD-MSG ()
   
    ERROR-INDEX = 0;
    ERROR-MESSAGE = " ";
    if (VHINC08IW.CAR-NO == "0000")
        if (INVALID-CAR-NO == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid car no.";
            VHINC08IW.CAR-NO = " ";
        end
    else
        if (DISPLAY-INVALID-CAR-NO == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Car no does not exist.";
        end
        if (VHINCY_CRIT.TYPE-IND == "YRD" ||
         VHINCY_CRIT.TYPE-IND == "SHP" ||
         VHINCY_CRIT.TYPE-IND == "REV")
            if (DISPLAY-IN-USE == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Car in use.";
            end
        end
    end
    if (VHINC08IW.SYMP-CD == " ")
        if (INVALID-SYMP-CD == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid symp cd.";
        end
    else
        if (INVALID-SYMPCD-VAL == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Symp cd does not exist.";
        end
    end
    if (INVALID-DISCV-DUR == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid discovered dur.";
    end
    if (INVALID-DATE == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date or time.";
    else
        if (INVALID-DATE-INCD == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid date of incident.";
        else
            if (VHINCY_CRIT.TYPE-IND == "YRD" ||
             VHINCY_CRIT.TYPE-IND == "SHP")
                if (DAYS-GR-45 == "Y") 
                    ERROR-INDEX = ERROR-INDEX + 1;
   
                    ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Date too old (over 1095 days).";
                end
            else
                if (VHINCY_CRIT.TYPE-IND == "REV") 
                    if (DAYS-GR-7 == "Y") 
                        ERROR-INDEX = ERROR-INDEX + 1;
   
                        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Date too old (over 1095 days).";
                    end
                end
            end
            if (DISP-ERR-MSG == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future date or time not allowed.";
            end
        end
    end
    if (INVALID-TIME-INCD == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid time of incident.";
    else
        if (DISP-INVALID-TIME == "Y") 
            ERROR-INDEX = ERROR-INDEX + 1;
            ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid time.";
        else
            if (DISP-TIME-ERRMSG == "Y") 
                ERROR-INDEX = ERROR-INDEX + 1;
                ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Future time not allowed.";
            end
        end
    end
    if (ERROR-INDEX == 6)
        VHINC08IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-LOC == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid location.";
    end
    if (ERROR-INDEX == 6)
        VHINC08IS-MOVE-MSG();
        return;
    end
    if (INVALID-INCD-NARR == "Y") 
        ERROR-INDEX = ERROR-INDEX + 1;
        ERROR-MESSAGE-OCCR[ERROR-INDEX] = "Invalid incident narr.";
    end
    VHINC08IS-MOVE-MSG();
end 

