        while ((LOOP-INDEX <= VHCI01IW.CAR-STATUS-COUNT))
            if (VHCI01D_DATA.CHANGE[LOOP-INDEX] == "Y" ||
             VHCI01D_DATA.CHANGE[LOOP-INDEX] == "YES")
                TEMP-INDEX = TEMP-INDEX + 1;
                VHCI01IW-TEMP-MI.DATA_ROW[TEMP-INDEX] = VHCI01D_DATA.DATA_ROW[LOOP-INDEX];
            end
            LOOP-INDEX = LOOP-INDEX + 1;
        end
        TEMP-INDEX = TEMP-INDEX + 1;
        if (TEMP-INDEX > 1)
            VHCI01IW-TEMP-MI.CHANGE[TEMP-INDEX] = VHCI01IW.CAR-NO;
            VHCI01IW-TEMP-MI.INCD-NO[TEMP-INDEX] = " ";
            VHCI01IW-TEMP-MI.DATE-STAT-CHG = VHCI01IW.DATE-STAT-CHG;
            VHCI01IW.TIME-STAT-CHG-HR = VHCI01IW.DISP-TIME-STAT-CHG-HR;
            VHCI01IW.TIME-STAT-CHG-FILLER1 = ":";
            VHCI01IW.TIME-STAT-CHG-MIN = VHCI01IW.DISP-TIME-STAT-CHG-MIN;
            VHCI01IW.TIME-STAT-CHG-FILLER2 = ":";
            VHCI01IW.TIME-STAT-CHG-SEC = 00;
            VHCI01IW-TEMP-MI.TIME-STAT-CHG = VHCI01IW.TIME-STAT-CHG;
            VHCI01IW-TEMP-MI.STORE-NARR-CI = "CI / ACTION- ";
            VHCI01IW-TEMP-MI.STORE-NARR-ACTION = "US ";
            VHCI01IW-TEMP-MI.STORE-NARR-DATE = VGVar.currentFormattedGregorianDate;
            VHCI01IW-TEMP-MI.STORE-NARR-TIME = VGVar.currentFormattedTime;
            VHCI01IW-TEMP-MI.USER-GRP = VHCI01IW.USER-GRP;
            VHCI01IW-TEMP-MI.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
            VHCI01IW-TEMP-MI.NARR = VHCI01IW.NARR;
            VHCI01IW-TEMP-MI.ROW-COUNT = TEMP-INDEX;

      
            VHINVA_CRIT.USER-TERM-ID = VHCI01IW.TERM-LAST-UPD;
            VHINVA_CRIT.USER-GRP = "VEHICLE";
            try
                call "VHINVA"(XDCONTROL, VHINVA_DATA, VHINVA_CRIT);
            
            end
            VHCI01IW-TEMP-MI.YRD-TRKG-YRD = VHCI02IW-YRD-TRK.YRD-TRKG-YRD;
            try
                call "VHCIW"(XDCONTROL, VHCI01IW-TEMP-MI);
            
            end
            if (VHCI01IW-TEMP-MI.ERR-FOUND == "N")
                VHCI01IS-MOVE-REC();
                VHCI01IW-TRIGGER-X.LOAD-CAR-STATUS = "Y";
                VHCI01IW.STORE-ERR-MSG[1] = "Incidents changed, !";
                if (VHCI01IW-TEMP-MI.STATUS-UPD == "Y")
                    VHCI01IS-CICS-MSG(); 
                    VHCI01IW.SCR-VEH-STAT = VHCI01IW-TEMP-MI.NEW-VEH-STAT;
                    VHCI01IW.SCR-VEH-STAT-DESC = VHCI01IW-TEMP-MI.NEW-VEH-STAT-DESC;
                    VHCI02IS-STAT(); 
                    if (VHCI01IW-TEMP-MI.INTO-SHOP-UPD == "Y")
                        VHCI01IS-SHOP-STAT();
                    end
                end
                if (VHCI01IW-TEMP-MI.FINAL-INCD-COUNT > 0)
                    VHCI01IW.STORE-ERR-MSG[4] = "Open Incidents remain!";
                else
                    VHCI01IW.STORE-ERR-MSG[4] = "!";
                end
                VHCI01IS-ERR-MSG(); 
                VHCI01IS-CLR-AFTDB(); 
                                   
            else
                DISABLE-CHANGE = "Y";
                DISABLE-INCDINFO = "Y";
                VHCI01IW-TRIGGER-X.LOAD-CAR-STATUS = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

Function VHCI01IS-US-STATUS () 
    set VHCI01IW-TEMP-MI empty;
    VHCI01IW-TEMP-MI.ERR-FOUND = "N";
    DISP-ERR-MSG = " ";
    VHCI01IW.DISP-AREA-MSG = " ";
    FINAL-ERROR-MESSAGE = " ";
    CAR-ERROR = "N";
    LOOP-INDEX = 1;
    STORE-INDEX = 1;
    TEMP-INDEX = 0;
    move CAR-STATUS-COUNT to STORE-INCDS-COUNT withV60Compat;

  
    while ((LOOP-INDEX <= STORE-INCDS-COUNT))
        if (VHCI01D_DATA.CHANGE[LOOP-INDEX] != "YES" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "Y" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "NO" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != "N" &&
         VHCI01D_DATA.CHANGE[LOOP-INDEX] != " ")
            CAR-ERROR = "Y";
            DISP-ERR-MSG-1 = "Invalid Response for";
            DISP-ERR-MSG-2 = VHCI01D_DATA.INCD-NO[LOOP-INDEX];
            DISP-ERR-MSG-3 = " ";
            move DISP-ERR-MSG to FINAL-ERROR-MESSAGE withV60Compat;
            INCDINFO-SETFOCUS = "Y";
            move STORE-INCDS-COUNT to LOOP-INDEX withV60Compat;
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
    LOOP-INDEX = 1;
    if (CAR-ERROR == "N")
        while ((LOOP-INDEX <= VHCI01IW.CAR-STATUS-COUNT))
            if (VHCI01D_DATA.CHANGE[LOOP-INDEX] == "Y" ||
             VHCI01D_DATA.CHANGE[LOOP-INDEX] == "YES")
                TEMP-INDEX = TEMP-INDEX + 1;
                VHCI01IW-TEMP-MI.DATA_ROW[TEMP-INDEX] = VHCI01D_DATA.DATA_ROW[LOOP-INDEX];
            end
            LOOP-INDEX = LOOP-INDEX + 1;
        end
        TEMP-INDEX = TEMP-INDEX + 1;
        if (TEMP-INDEX > 1)
            VHCI01IW-TEMP-MI.CHANGE[TEMP-INDEX] = VHCI01IW.CAR-NO;
            VHCI01IW-TEMP-MI.INCD-NO[TEMP-INDEX] = " ";
            VHCI01IW-TEMP-MI.DATE-STAT-CHG = VHCI01IW.DATE-STAT-CHG;
            VHCI01IW.TIME-STAT-CHG-HR = VHCI01IW.DISP-TIME-STAT-CHG-HR;
            VHCI01IW.TIME-STAT-CHG-FILLER1 = ":";
            VHCI01IW.TIME-STAT-CHG-MIN = VHCI01IW.DISP-TIME-STAT-CHG-MIN;
            VHCI01IW.TIME-STAT-CHG-FILLER2 = ":";
            VHCI01IW.TIME-STAT-CHG-SEC = 00;
            VHCI01IW-TEMP-MI.TIME-STAT-CHG = VHCI01IW.TIME-STAT-CHG;
            VHCI01IW-TEMP-MI.STORE-NARR-CI = "CI / ACTION- ";
            VHCI01IW-TEMP-MI.STORE-NARR-ACTION = "US ";
            VHCI01IW-TEMP-MI.STORE-NARR-DATE = VGVar.currentFormattedGregorianDate;
            VHCI01IW-TEMP-MI.STORE-NARR-TIME = VGVar.currentFormattedTime;
            VHCI01IW-TEMP-MI.USER-GRP = VHCI01IW.USER-GRP;
            VHCI01IW-TEMP-MI.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
            VHCI01IW-TEMP-MI.NARR = VHCI01IW.NARR;
            VHCI01IW-TEMP-MI.ROW-COUNT = TEMP-INDEX;

      
  
            VHXREVA_CRIT.SYSTEM-DATE = VHCI01IW-TEMP-MI.DATE-STAT-CHG;
            VHXREVA_CRIT.SYSTEM-TIME = VHCI01IW-TEMP-MI.TIME-STAT-CHG;
            
  
            VHCI02IS-REV-TIME();
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                XXDATEW.DATE-MM-DD-YYYY = VHXREVA_DATA.REVENUE-DATE;
                XXDATEW.VAGen_FUNCTION = "YMD";
                MRSCommonCode.XXDATES-CONVERT();
                VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = XXDATEW.DATE-YYYY-MM-DD;
            else
                VHCI01IW-TEMP-MI.DATE-STAT-CHG-REV = " ";
            end
            VHCI01IW-TEMP-MI.YRD-TRKG-YRD = VHCI02IW-YRD-TRK.YRD-TRKG-YRD;
            try
                call "VHCIW"(XDCONTROL, VHCI01IW-TEMP-MI);
            
            end
            if (VHCI01IW-TEMP-MI.ERR-FOUND == "N")
                VHCI01IS-MOVE-REC();
                VHCI01IW-TRIGGER-X.LOAD-CAR-STATUS = "Y";
                VHCI01IW.STORE-ERR-MSG[1] = "Incidents changed, !";
                if (VHCI01IW-TEMP-MI.STATUS-UPD == "Y")
                    VHCI01IS-CICS-MSG(); 
                    VHCI01IW.SCR-VEH-STAT = VHCI01IW-TEMP-MI.NEW-VEH-STAT;
                    VHCI01IW.SCR-VEH-STAT-DESC = VHCI01IW-TEMP-MI.NEW-VEH-STAT-DESC;
                    VHCI02IS-STAT(); 
                    if (VHCI01IW-TEMP-MI.INTO-SHOP-UPD == "Y")
                        VHCI01IS-SHOP-STAT();
                    end
                end
                if (VHCI01IW-TEMP-MI.FINAL-INCD-COUNT > 0)
                    VHCI01IW.STORE-ERR-MSG[4] = "Open Incidents remain!";
                else
                    VHCI01IW.STORE-ERR-MSG[4] = "!";
                end
                VHCI01IS-ERR-MSG(); 
                VHCI01IS-CLR-AFTDB(); 
                                   
            else
                DISABLE-CHANGE = "Y";
                DISABLE-INCDINFO = "Y";
                VHCI01IW-TRIGGER-X.LOAD-CAR-STATUS = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

Function VHCI02I-PM-TEAM ()
  
   
    if (VHCI01IW.PM-TEAM == "0" ||
     VHCI01IW.PM-TEAM == "1" ||
     VHCI01IW.PM-TEAM == "2" ||
     VHCI01IW.PM-TEAM == "3" ||
     VHCI01IW.PM-TEAM == "4" ||
     VHCI01IW.PM-TEAM == "5" ||
     VHCI01IW.PM-TEAM == "6" ||
     VHCI01IW.PM-TEAM == "7" ||
     VHCI01IW.PM-TEAM == "8" ||
     VHCI01IW.PM-TEAM == "9")
        ERROR-IND = "Y";
        VHCI01IW-TEMP-WS.PM-TEAM-ERR = "Y";
    else
        if (VHCI01IW.PM-TEAM == "A" ||
         VHCI01IW.PM-TEAM == "B" ||
         VHCI01IW.PM-TEAM == "C" ||
         VHCI01IW.PM-TEAM == "D" ||
         VHCI01IW.PM-TEAM == "E" ||
         VHCI01IW.PM-TEAM == "F" ||
         VHCI01IW.PM-TEAM == "S" ||
         VHCI01IW.PM-TEAM == "G" ||
         VHCI01IW.PM-TEAM == "N")
            return;
        else
            ERROR-IND = "Y";
            VHCI01IW-TEMP-WS.PM-TEAM-ERR = "Y";
        end
    end
end 

Function VHCI02I-PM-TEAMX () 
    if (VHCI01IW.PM-TEAM == " ")

    else
        if (VHCI01IW.PM-TEAM == "0" ||
         VHCI01IW.PM-TEAM == "1" ||
         VHCI01IW.PM-TEAM == "2" ||
         VHCI01IW.PM-TEAM == "3" ||
         VHCI01IW.PM-TEAM == "4" ||
         VHCI01IW.PM-TEAM == "5" ||
         VHCI01IW.PM-TEAM == "6" ||
         VHCI01IW.PM-TEAM == "7" ||
         VHCI01IW.PM-TEAM == "8" ||
         VHCI01IW.PM-TEAM == "9")
            ERROR-IND = "Y";
            VHCI01IW-TEMP-WS.PM-TEAM-ERR = "Y";
        else
            if (VHCI01IW.PM-TEAM == "A" ||
             VHCI01IW.PM-TEAM == "B" ||
             VHCI01IW.PM-TEAM == "C" ||
             VHCI01IW.PM-TEAM == "D" ||
             VHCI01IW.PM-TEAM == "E" ||
             VHCI01IW.PM-TEAM == "F" ||
             VHCI01IW.PM-TEAM == "S" ||
             VHCI01IW.PM-TEAM == "G" ||
             VHCI01IW.PM-TEAM == "N")
                return;
            else
                ERROR-IND = "Y";
                VHCI01IW-TEMP-WS.PM-TEAM-ERR = "Y";
            end
        end
    end
end 

Function VHCI02IS-ACT-STAT () 
    ERROR-MSG = "N";
    set VHCI01IW-TEMP-MI empty;
    set VHCI01D_DATA empty;
    VHCI01IW.CAR-STATUS-COUNT = 0;
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    DISP-ERR-MSG = " ";
    ENABLE-INCDINFO = "Y";
    if (ERROR-MSG == "N")
  
  
        VHCI01B_DATA.CAR-NO = VHCI01IW.CAR-NO;
        try
            call "VHCI01B"(XDCONTROL, VHCI01B_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCI01IW.SCR-DISP-VEH-STAT = VHCI01B_DATA.DISP-VEH-STAT;
            VHCI01IW.CON-NO = VHCI01B_DATA.CON-NO;
            if (VHCI01B_DATA.WHERE-IS-CAR == "CON")
                ERROR-MSG = "Y";
                DISABLE-CHANGE = "Y";
                VHCI01IW.FINAL-ERROR-MESSAGE = "Car In Use.";
                CAR-ON-CONSIST = "Y";
            else
                if (VHCI01B_DATA.CAR-TYPE-1 == "D")
                    ERROR-MSG = "Y";
                    DISABLE-CHANGE = "Y";
                    VHCI01IW.FINAL-ERROR-MESSAGE = "Not valid for Dummy cars.";
                    DUMMY-CAR = "Y";
                else
                    if (VHCI01IW.CAR-NO == "0095" &&
                     VHCI01B_DATA.CAR-TYPE-1 == "T" &&
                     VHCI01IW.ACTION-OPT != 7)
                        VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid Action for Car.";
                        INVALID-ACTION = "Y";
                        ERROR-MSG = "Y";
                        DISABLE-CHANGE = "Y";
                        LOAD-MOVE-INCDS = "Y";
                    else
                        if (VHCI01B_DATA.VEH-STAT == "ERROR" &&
                         (VHCI01IW.STATUS == "GO" || VHCI01IW.STATUS == "NO GO"))
                            ERROR-MSG = "Y";
                            DISP-ERR-MSG = "Invalid Action - Error NO GO";
                        else
                            if (VHCI01B_DATA.VEH-STAT == "NO GO" &&
                             VHCI01IW.STATUS == "NO GO")
                                ERROR-MSG = "Y";
                                DISP-ERR-MSG = "Invalid Action for car";
                            else
                                if (VHCI01B_DATA.VEH-STAT == "GO" &&
                                 VHCI01IW.STATUS == "GO")
                                    ERROR-MSG = "Y";
                                    DISP-ERR-MSG = "Invalid Action for Car";
                                else
                                    if (VHCI01IW.STATUS == "USABLE" &&
                                     (VHCI01B_DATA.VEH-STAT == "GO" ||
                                     VHCI01B_DATA.VEH-STAT == "USABLE"))
                                        ERROR-MSG = "Y";
                                        DISP-ERR-MSG = "Invalid Action for car";
                                    else
                                        if (VHCI01IW.STATUS == "PM")
                                            if (VHCI01B_DATA.WORST-CASE-RANK < 80)
                                                if (VHCI01B_DATA.TRAIN-INCD-IND == "N")
                                                    if (VHCI01IW.STATUS == "PM")
                                                        if (VHCI01B_DATA.CURR-SCHD-PM-NO == 0)
                                                            ERROR-MSG = "Y";
                                                            DISP-ERR-MSG = "Not Scheduled";
                                                        end
                                                    end
                                                else
                                                    ERROR-MSG = "Y";
                                                    DISP-ERR-MSG = "Invalid Action - train incd";
                                                end
                                            else
                                                ERROR-MSG = "Y";
                                                DISP-ERR-MSG = "Invalid Action for Car";
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        VHCI01IW.FINAL-ERROR-MESSAGE = DISP-ERR-MSG;
                    end
                end
            end
            if (ERROR-MSG == "Y")
   
                DISABLE-CHANGE = "Y";
                CARNO-SETFOCUS = "Y";
                LOAD-MOVE-INCDS = "Y";
                LOAD-CAR-STATUS = "Y";
            end
        else
            if (XDCONTROL.URC == 100)
                ERROR-MSG = "Y";
                DISABLE-CHANGE = "Y";
                DISABLE-MAINT-ACT = "Y";
                VHCI01IW.FINAL-ERROR-MESSAGE = "Car not found in the database.";
                CAR-NOT-FOUND = "Y";
            else
                ERROR-MSG = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
    if (ERROR-MSG == "N")
      
        if (VHCI01IW.ACTION-OPT == 1 && VHCI01IW.STATUS == "GO")
            VHCI01D_CRIT.CAR-STATUS = "GO";
        else
      
            if (VHCI01IW.ACTION-OPT == 1 && VHCI01IW.STATUS == "PM")
                VHCI01D_CRIT.CAR-STATUS = "PM";
            else
                if (VHCI01IW.ACTION-OPT == 1 && VHCI01IW.STATUS == "USABLE")
                    VHCI01D_CRIT.CAR-STATUS = "USABLE";
                else
                    if (VHCI01IW.ACTION-OPT == 1 && VHCI01IW.STATUS == "NO GO")
                        VHCI01D_CRIT.CAR-STATUS = "NO GO";
                    end
                end
            end
        end
        VHCI01IW.COL-HEADING = "Change - Yes/No";
        VHCI01D_CRIT.CAR-NO = VHCI01IW.CAR-NO;
        try
            call "VHCI01D"(XDCONTROL, VHCI01D_CRIT, VHCI01D_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            CAR-STATUS-COUNT = XDCONTROL.UROWCNT;
            ENABLE-CHANGE = "Y";
            ENABLE-MAINT-ACT = "Y";
            VHCI01IW-TRIGGER-X.LOAD-CAR-STATUS = "Y";
            VHCI01IW-TRIGGER.DATE-SETFOCUS = "Y";
        else
            if (XDCONTROL.URC == 100)
                set VHCI01D_DATA empty;
                VHCI01IW.FINAL-ERROR-MESSAGE = "No Incidents on file for this vehicle.";
                NO-INCDS-FOUND-2 = "Y";
                VHCI01IW-TRIGGER-X.LOAD-CAR-STATUS = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
        move VHCI01D_DATA.DATA_ROW to VHCI01IW-STORE-MI.DATA_ROW[1] for all;
    end
end 

Function VHCI02IS-CLR-LIST () 
    if (ACTION-OPT == 1) 
        set VHCI01D_DATA empty;
        VHCI01IW.CAR-STATUS-COUNT = 0;
        LOAD-CAR-STATUS = "Y";
        DISABLE-CHANGE = "Y";
    else
        if (ACTION-OPT == 2) 
            set VHCI01A_DATA empty;
            VHCI01IW.CI-COUNT = 0;
            LOAD-DF = "Y";
            DISABLE-CHANGE = "Y";
        else
            if (ACTION-OPT == 3) 
                set VHCI01A_DATA empty;
                VHCI01IW.CI-COUNT = 0;
                LOAD-DI = "Y";
                DISABLE-CHANGE = "Y";
            else
                if (ACTION-OPT == 4) 
                    VHCI01IW.CI-COUNT = 0;
                    VHCI01IW.CAR-STATUS-COUNT = 0;
                    LOAD-DF = "Y";
                    LOAD-DI = "Y";
                    LOAD-UD = "Y";
                    LOAD-FC = "Y";
                    LOAD-CAR-STATUS = "Y";
                    VHCI01IW.MOVE-INCDS-COUNT = 0;
                    LOAD-MOVE-INCDS = "Y";
                    DISABLE-CHANGE = "Y";
                else
                    if (ACTION-OPT == 5) 
                        set VHCI01A_DATA empty;
                        VHCI01IW.CI-COUNT = 0;
                        LOAD-UD = "Y";
                        DISABLE-CHANGE = "Y";
                    else
                        if (ACTION-OPT == 6) 
                            set VHCI01A_DATA empty;
                            VHCI01IW.CI-COUNT = 0;
                            LOAD-FC = "Y";
                            DISABLE-CHANGE = "Y";
                        else
                            if (ACTION-OPT == 7) 
                                set VHCI01A_DATA empty;
                                VHCI01IW.MOVE-INCDS-COUNT = 0;
                                LOAD-MOVE-INCDS = "Y";
                                DISABLE-CHANGE = "Y";
                            else
                                set VHCI01A_DATA empty;
                                DISABLE-CHANGE = "Y";
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHCI02IS-NARRATIVE () 
    VHCI01IW.INCD-NO = VHCI01D_DATA.INCD-NO[SELECTION-INDEX];
    VHCI02IW-TRIGGER.OPEN-NARR = "Y";
end 

Function VHCI02IS-OPN-VM () 
    VHVM11IW-PASS-DATA.CAR-NO = VHCI01IW-SAVE.SAVE-CAR-NO;
    VHVM11IW-PASS-DATA.PASS-FROM-GUI = "VHCI02";
end 

Function VHCI02IS-PMTEAM () 
    VHCI02I-PASSVALUE.INCD-NO = VHCI01D_DATA.INCD-NO[SELECTION-INDEX];

  
    VHCI01IW-TEMP-WS.PM-TEAM-ERR = "N";
    if (VHCI02I-PASSVALUE.INCD-NO-1 == "H" && VHCI01IW.STATUS == "GO")
        VHCI02I-PM-TEAM();
    else
        VHCI02I-PM-TEAMX();
    end
end 

Function VHCI02IS-PSEUDO () 
    VHCI01IW.CAR-IN-CON-X = "N";
    set VHINXA_DATA empty;
    VHINXA_CRIT.CAR-NO = VHCI01IW.CAR-NO;
    try
        call "VHINXA"(XDCONTROL, VHINXA_CRIT, VHINXA_DATA);
    
    end
    
    
    MRSCommonCode.XXA0IS-CHECK_EXT();
    
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCI01IW.CAR-IN-CON-X = "Y";
        else
        
        
      
      
      
      

        end 
    end
    if (VHCI01IW.CAR-IN-CON-X == "Y")
        VHINXB_CRIT.CON-NO = VHINXA_DATA.CON-NO;
        VHINXB_DATA.TERM-LAST-UPD = VHCI01IW.TERM-LAST-UPD;
        VHINXB_DATA.USER-GROUP = VHCI01IW.USER-GRP;
        VHCI01IW.CAR-CNT-X = 1;
        while (VHCI01IW.CAR-CNT-X <= 10)
            VHINXB_DATA.CAR-NUM[VHCI01IW.CAR-CNT-X] = VHINXA_DATA.CAR-NO[VHCI01IW.CAR-CNT-X];
            VHINXB_DATA.CON-NUM[VHCI01IW.CAR-CNT-X] = VHINXA_DATA.CON-NO[VHCI01IW.CAR-CNT-X];
            VHCI01IW.CAR-CNT-X = VHCI01IW.CAR-CNT-X + 1;
        end
        VHINXB_CRIT.YRD-SUB-LOC = VHINXA_DATA.YRD-SUB-LOC[1];
        try
            call "VHINXB"(XDCONTROL, VHINXB_CRIT, VHINXB_DATA);
        
        end
        
    
        MRSCommonCode.XXA0IS-CHECK_EXT();
    
        if (XXEXT_CALL_Level77Items.URC == 0)
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHCI01E_CRIT.SEND-RESET-MSG = "Y";
            else
        
        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

Function VHCI02IS-REV-TIM2 () 
    try
        call "VHINCD"(XDCONTROL, VHINCD_DATA);
    
    end
    VHXREVC_DATA.DB-REVENUE-DATE = VHINCD_DATA.REVENUE-DATE;

  
    VHXREVC_DATA.END-TIME-DAY = "24.00.00";
    VHXREVC_DATA.TIME-REV-START = "03.00.00";
    VHXREVC_DATA.TIME-REV-END = "02.59.59";
    VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    VHXREVC_DATA.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    VHXREVC_DATA.SYS-MINUTES = (VHXREVC_DATA.SYSTEM-TIME-HR-NUM * 60) + VHXREVC_DATA.SYSTEM-TIME-MIN-NUM;
    if (VHXREVC_DATA.SYS-MINUTES < 180)
        XXDATEW.DATE-YYYY-MM-DD = VHXREVC_DATA.DB-REVENUE-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHXREVC_DATA.REVENUE-DATE = XXDATEW.DATE-MM-DD-YYYY;
    else
        VHXREVC_DATA.REVENUE-DATE = VHXREVC_DATA.SYSTEM-DATE;
    end
    VHXREVA_DATA.REVENUE-DATE = VHXREVC_DATA.REVENUE-DATE;
end 

Function VHCI02IS-REV-TIME () 
    try
        call "VHINCD"(XDCONTROL, VHINCD_DATA);
    
    end
    VHXREVC_DATA.DB-REVENUE-DATE = VHINCD_DATA.REVENUE-DATE;
  
    VHXREVC_DATA.END-TIME-DAY = "24.00.00";

  
  
    VHXREVC_DATA.TIME-REV-START = "03.00.00";
    VHXREVC_DATA.TIME-REV-END = "02.59.59";

  
  
  
  
  
    VHXREVC_DATA.SYSTEM-TIME = VGVar.currentFormattedTime;
    VHXREVC_DATA.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    VHXREVC_DATA.SYS-MINUTES = (VHXREVC_DATA.SYSTEM-TIME-HR-NUM * 60) + VHXREVC_DATA.SYSTEM-TIME-MIN-NUM;
    if (VHXREVC_DATA.SYS-MINUTES < 180)
  
  
        XXDATEW.DATE-YYYY-MM-DD = VHXREVC_DATA.DB-REVENUE-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHXREVC_DATA.REVENUE-DATE = XXDATEW.DATE-MM-DD-YYYY;
    else
        VHXREVC_DATA.REVENUE-DATE = VHXREVC_DATA.SYSTEM-DATE;
    end
    VHXREVA_DATA.REVENUE-DATE = VHXREVC_DATA.REVENUE-DATE;
end 

Function VHCI02IS-STAT () 
    VHCI01IW.STORE-ERR-MSG[2] = "Status changed to !";
    VHCI01IW.TEMP-STAT = " ";
    TEMP-STAT-1 = VHCI01IW.SCR-VEH-STAT;
    TEMP-STAT-2 = " !";
    VHCI01IW.STORE-ERR-MSG[3] = VHCI01IW.TEMP-STAT;
end 

Function VHCI02IS-UPD-TRK () 
    VHCI01IW.INCD-INDEX = 1;
    VHCI02D_CRIT.CAR-NO = VHCI01IW.CAR-NO;
    VHCI02D_DATA.TERM-LAST-UPD = VHCI01IW-TEMP-MI.TERM-LAST-UPD;
    while ((VHCI01IW.INCD-INDEX <= VHCI01IW.TOTAL-INCD))
        VHCI02D_CRIT.INCD-NO = VHCI01IW-TEMP-MI.INCD-NO[INCD-INDEX];
        try
            call "VHCI02D"(XDCONTROL, VHCI02D_DATA, VHCI02D_CRIT);
        
        end
        if (VHCI02D_CRIT.UPD-TRK == "Y")
            VHCI01IW.INCD-INDEX = VHCI01IW.INCD-INDEX + 1;
        else
            VHCI01IW.INCD-INDEX = 999;
        end
    end
end 

Function VHCI02IS-VALIDAT2 ()
   
    VHCI02IS-PMTEAM();
    if (VHCI01IW-TEMP-WS.PM-TEAM-ERR == "Y")
        VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid PM TEAM";
    else
        VHCI02IS-VALIDAT3();
    end
end 

Function VHCI02IS-VALIDAT3 ()
   
    VHCI01E_CRIT.SEND-RESET-MSG = "N";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    VHCI01IW.STORE-ERR-MSG[1] = " ";
    VHCI01IW.STORE-ERR-MSG[2] = " ";
    VHCI01IW.STORE-ERR-MSG[3] = " ";
    VHCI01IW.STORE-ERR-MSG[4] = " ";
    VHCI01IW.STORE-ERR-MSG[5] = " ";
    DISP-ERR-MSG = " ";
    INVALID-DATE = "N";
    INVALID-TIME = "N";
    INVALID-NARR = "N";
    INVALID-DATE-FUTURE = "N";
    INVALID-TIME-FUTURE = "N";
    INVALID-DATE-OLD = "N";
    INVALID-PMLOC = "N";
    ERROR-IND = "N";
    if (VHCI01IW.DATE-STAT-CHG == " ")
        ERROR-IND = "Y";
        INVALID-DATE = "Y";
    else
        AFCXVLD_CRIT.FORM-DATE = VHCI01IW.DATE-STAT-CHG;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            ERROR-IND = "Y";
            INVALID-DATE = "Y";
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                ERROR-IND = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            else
                if (AFCXVLDW.NO-ERROR == "Y")
                    VHCI01IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
                    if (((VHCI01IW.DATE-STAT-CHG-YEAR > VHCI01IW.SYSTEM-DATE-YEAR) ||
                     ((VHCI01IW.DATE-STAT-CHG-YEAR == VHCI01IW.SYSTEM-DATE-YEAR) &&
                     (VHCI01IW.DATE-STAT-CHG-MON > VHCI01IW.SYSTEM-DATE-MON)) ||
                     ((VHCI01IW.DATE-STAT-CHG-YEAR == VHCI01IW.SYSTEM-DATE-YEAR) &&
                     (VHCI01IW.DATE-STAT-CHG-MON == VHCI01IW.SYSTEM-DATE-MON) &&
                     (VHCI01IW.DATE-STAT-CHG-DAY > VHCI01IW.SYSTEM-DATE-DAY))))
                        ERROR-IND = "Y";
                        INVALID-DATE-FUTURE = "Y";
                    else
                        if (VHCI01IW.DATE-STAT-CHG > VHCI02G_CRIT.CURRENT-DATE)
                            ERROR-IND = "Y";
                            INVALID-DATE-FUTURE = "Y";
                        else
                            JULIAN-DATE-1 = VGVar.currentJulianDate;
                            XDATECON-W2.WS-GREG-IN-FLAG = "R";
                            XDATECON-W2.WS-RPT-GREG-IN = VHCI01IW.DATE-STAT-CHG;
                            MRSCommonCode.XDATECON-GREG2JUL();
                            JULIAN-DATE-2 = XDATECON-W1.WS-DATES-CYDDD;
                            JULIAN-DATE-DIFF = JULIAN-DATE-1 - JULIAN-DATE-2;
                            if (JULIAN-DATE-DIFF > 365)
                                ERROR-IND = "Y";
                                INVALID-DATE-OLD = "Y";
                            end
                        end
                    end
                end
            end
        end
    end
    if (ERROR-IND == "N")
        if (VHCI01IW.DISP-TIME-STAT-CHG == " ")
            ERROR-IND = "Y";
            INVALID-TIME = "Y";
        else
            if (VHCI01IW.DISP-TIME-STAT-CHG not numeric)
                ERROR-IND = "Y";
                INVALID-TIME = "Y";
            else
                if (DISP-TIME-STAT-CHG-HR > 24 ||
                 (DISP-TIME-STAT-CHG-HR == 24 && DISP-TIME-STAT-CHG-MIN > 0) ||
                 (DISP-TIME-STAT-CHG-HR == 0 && DISP-TIME-STAT-CHG-MIN == 0) ||
                 DISP-TIME-STAT-CHG-MIN > 59)
                    ERROR-IND = "Y";
                    INVALID-TIME = "Y";
                else
                    if (VHCI01IW.DATE-STAT-CHG == VHCI01IW.SYSTEM-DATE)
                        VHCI01IW.SYSTEM-TIME = VGVar.currentFormattedTime;
                        if (((VHCI01IW.DISP-TIME-STAT-CHG-HR >
                         VHCI01IW.SYSTEM-TIME-HR) ||
                         (VHCI01IW.DISP-TIME-STAT-CHG-HR ==
                         VHCI01IW.SYSTEM-TIME-HR &&
                         VHCI01IW.DISP-TIME-STAT-CHG-MIN >
                         VHCI01IW.SYSTEM-TIME-MIN)))
                            ERROR-IND = "Y";
                            INVALID-TIME-FUTURE = "Y";
                        end
                    end
                end
            end
        end
    end
    if (ERROR-IND == "N")
        if (VHCI01IW.STATUS == "PM")
            if (VHCI01IW.PM-LOC == " ")
                ERROR-IND = "Y";
                INVALID-PMLOC = "Y";
            else
                if (VHCI01IW.PM-LOC != "CY" &&
                 VHCI01IW.PM-LOC != "DY" &&
                 VHCI01IW.PM-LOC != "HY" &&
                 VHCI01IW.PM-LOC != "RY")
                    ERROR-IND = "Y";
                    INVALID-PMLOC = "Y";
                else
                    if (VHCI01IW.NARR == " " &&
                     VHCI01IW.ACTION-OPT == 1) 
                        ERROR-IND = "Y";
                        INVALID-NARR = "Y";
                    end
                end
            end
        end
    end
    if (ERROR-IND == "Y")
        VHCI01IS-BLD-MSG();
    else
        if (VHCI01IW.ACTION-OPT == 1) 
            if (VHCI01IW.STATUS == "GO")
  
                VHCI01IS-CONFIG();
                if (VHCI01F_CRIT.VALID-SW != "N")
                    VHCI01IS-GO-STATU2();
                else
  
  
  
                    VHCI01IW.CONF-MSG-1 = "GO/Usable action not allowed.  Car configuration is incomplete - missing ";
                    VHCI01IW.CONF-MSG-2 = VHCI01F_DATA.CONFIG-CMPNT-TYPE;
                    VHCI01IW.FINAL-ERROR-MESSAGE = VHCI01IW.ERROR-CONF-MSG;
                    return;
                end
  
            else
                if (VHCI01IW.STATUS == "PM")
                    VHCI01IS-PM-STATU2();
                else
                    if (VHCI01IW.STATUS == "USABLE")
  
                        VHCI01IS-CONFIG();
  
                        if (VHCI01F_CRIT.VALID-SW != "N")
                            VHCI01IS-US-STATUS();
                        else
  
  
  
                            VHCI01IW.CONF-MSG-1 = "GO/Usable action not allowed.  Car configuration is incomplete - missing ";
                            VHCI01IW.CONF-MSG-2 = VHCI01F_DATA.CONFIG-CMPNT-TYPE;
                            VHCI01IW.FINAL-ERROR-MESSAGE = VHCI01IW.ERROR-CONF-MSG;
                            return;
                        end
  
                    else
                        if (VHCI01IW.STATUS == "NO GO")
                            VHCI01IS-NO-STATU2();
  
  
                        end
                    end
                end
            end
        else
            if (VHCI01IW.ACTION-OPT == 2) 
                VHCI01IS-DF();
            else
                if (VHCI01IW.ACTION-OPT == 3) 
                    VHCI01IS-DI();
                else
                    if (VHCI01IW.ACTION-OPT == 4) 
                        VHCI01IS-ERR();
                    else
                        if (VHCI01IW.ACTION-OPT == 5) 
                            VHCI01IS-UD();
                        else
                            if (VHCI01IW.ACTION-OPT == 6) 
                                VHCI01IS-FC();
                            else
                                if (VHCI01IW.ACTION-OPT == 7) 
                                    VHCI01IS-MOVE();
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHCI02IS-VALIDATE ()
   
    VHCI01E_CRIT.SEND-RESET-MSG = "N";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    VHCI01IW.STORE-ERR-MSG[1] = " ";
    VHCI01IW.STORE-ERR-MSG[2] = " ";
    VHCI01IW.STORE-ERR-MSG[3] = " ";
    VHCI01IW.STORE-ERR-MSG[4] = " ";
    VHCI01IW.STORE-ERR-MSG[5] = " ";
    DISP-ERR-MSG = " ";
    INVALID-DATE = "N";
    INVALID-TIME = "N";
    INVALID-NARR = "N";
    INVALID-DATE-FUTURE = "N";
    INVALID-TIME-FUTURE = "N";
    INVALID-DATE-OLD = "N";
    INVALID-PMLOC = "N";
    ERROR-IND = "N";
    if (VHCI01IW.DATE-STAT-CHG == " ")
        ERROR-IND = "Y";
        INVALID-DATE = "Y";
    else
        AFCXVLD_CRIT.FORM-DATE = VHCI01IW.DATE-STAT-CHG;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            ERROR-IND = "Y";
            INVALID-DATE = "Y";
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                ERROR-IND = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            else
                if (AFCXVLDW.NO-ERROR == "Y")
                    VHCI01IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
                    if (((VHCI01IW.DATE-STAT-CHG-YEAR > VHCI01IW.SYSTEM-DATE-YEAR) ||
                     ((VHCI01IW.DATE-STAT-CHG-YEAR == VHCI01IW.SYSTEM-DATE-YEAR) &&
                     (VHCI01IW.DATE-STAT-CHG-MON > VHCI01IW.SYSTEM-DATE-MON)) ||
                     ((VHCI01IW.DATE-STAT-CHG-YEAR == VHCI01IW.SYSTEM-DATE-YEAR) &&
                     (VHCI01IW.DATE-STAT-CHG-MON == VHCI01IW.SYSTEM-DATE-MON) &&
                     (VHCI01IW.DATE-STAT-CHG-DAY > VHCI01IW.SYSTEM-DATE-DAY))))
                        ERROR-IND = "Y";
                        INVALID-DATE-FUTURE = "Y";
                    else
                        JULIAN-DATE-1 = VGVar.currentJulianDate;
                        XDATECON-W2.WS-GREG-IN-FLAG = "R";
                        XDATECON-W2.WS-RPT-GREG-IN = VHCI01IW.DATE-STAT-CHG;
                        MRSCommonCode.XDATECON-GREG2JUL();
                        JULIAN-DATE-2 = XDATECON-W1.WS-DATES-CYDDD;
                        JULIAN-DATE-DIFF = JULIAN-DATE-1 - JULIAN-DATE-2;
                        if (JULIAN-DATE-DIFF > 365)
                            ERROR-IND = "Y";
                            INVALID-DATE-OLD = "Y";
                        end
                    end
                end
            end
        end
    end
    if (ERROR-IND == "N")
        if (VHCI01IW.DISP-TIME-STAT-CHG == " ")
            ERROR-IND = "Y";
            INVALID-TIME = "Y";
        else
            if (VHCI01IW.DISP-TIME-STAT-CHG not numeric)
                ERROR-IND = "Y";
                INVALID-TIME = "Y";
            else
                if (DISP-TIME-STAT-CHG-HR > 24 ||
                 (DISP-TIME-STAT-CHG-HR == 24 && DISP-TIME-STAT-CHG-MIN > 0) ||
                 (DISP-TIME-STAT-CHG-HR == 0 && DISP-TIME-STAT-CHG-MIN == 0) ||
                 DISP-TIME-STAT-CHG-MIN > 59)
                    ERROR-IND = "Y";
                    INVALID-TIME = "Y";
                else
                    if (VHCI01IW.DATE-STAT-CHG == VHCI01IW.SYSTEM-DATE)
                        VHCI01IW.SYSTEM-TIME = VGVar.currentFormattedTime;
                        if (((VHCI01IW.DISP-TIME-STAT-CHG-HR >
                         VHCI01IW.SYSTEM-TIME-HR) ||
                         (VHCI01IW.DISP-TIME-STAT-CHG-HR ==
                         VHCI01IW.SYSTEM-TIME-HR &&
                         VHCI01IW.DISP-TIME-STAT-CHG-MIN >
                         VHCI01IW.SYSTEM-TIME-MIN)))
                            ERROR-IND = "Y";
                            INVALID-TIME-FUTURE = "Y";
                        end
                    end
                end
            end
        end
    end
    if (ERROR-IND == "N")
        if (VHCI01IW.STATUS == "PM")
            if (VHCI01IW.PM-LOC == " ")
                ERROR-IND = "Y";
                INVALID-PMLOC = "Y";
            else
                if (VHCI01IW.PM-LOC != "CY" &&
                 VHCI01IW.PM-LOC != "DY" &&
                 VHCI01IW.PM-LOC != "HY" &&
                 VHCI01IW.PM-LOC != "RY")
                    ERROR-IND = "Y";
                    INVALID-PMLOC = "Y";
                else
                    if (VHCI01IW.NARR == " " &&
                     VHCI01IW.ACTION-OPT == 1) 
                        ERROR-IND = "Y";
                        INVALID-NARR = "Y";
                    end
                end
            end
        end
    end
    if (ERROR-IND == "Y")
        VHCI01IS-BLD-MSG();
    else
        if (VHCI01IW.ACTION-OPT == 1) 
            if (VHCI01IW.STATUS == "GO")
                VHCI01IS-GO-STATUS();
            else
                if (VHCI01IW.STATUS == "PM")
                    VHCI01IS-PM-STATUS();
                else
                    if (VHCI01IW.STATUS == "USABLE")
  
                        VHCI01IS-US-STATUS();
                    else
                        if (VHCI01IW.STATUS == "NO GO")
                            VHCI01IS-NO-STATUS();
  
  
                        end
                    end
                end
            end
        else
            if (VHCI01IW.ACTION-OPT == 2) 
                VHCI01IS-DF();
            else
                if (VHCI01IW.ACTION-OPT == 3) 
                    VHCI01IS-DI();
                else
                    if (VHCI01IW.ACTION-OPT == 4) 
                        VHCI01IS-ERR();
                    else
                        if (VHCI01IW.ACTION-OPT == 5) 
                            VHCI01IS-UD();
                        else
                            if (VHCI01IW.ACTION-OPT == 6) 
                                VHCI01IS-FC();
                            else
                                if (VHCI01IW.ACTION-OPT == 7) 
                                    VHCI01IS-MOVE();
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHCI02IS-YRD-TRK ()
  
  
  
  
  
  
  
  

   
    VHCI01IW-TEMP-MI.YRD-TRKG-YRD = VHCI02IW-YRD-TRK.YRD-TRKG-YRD;
    VHCI02B_CRIT.USER-GRP = VHCI01IW.USER-GRP;
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCI02I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCI02B";

    
    try
        call "VHCI02B"(XDCONTROL, VHCI02B_CRIT, VHCI02B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCI02I-TRIGGER.ENABLE-CHANGE-LOCATION = "Y";
            VHCI02I-TRIGGER.ENABLE-CI-NEVER-GO = "Y";
        else
            VHCI02I-TRIGGER.DISABLE-CHANGE-LOCATION = "Y";
            VHCI02I-TRIGGER.DISABLE-CI-NEVER-GO = "Y";
            

        
        
        end 
    end
end 

Function VHCI03IS-ACT-STAT () 
    ERROR-MSG = "N";
    DISP-ERR-MSG = " ";
    FINAL-ERROR-MESSAGE = " ";
    set VHCI01IW-TEMP-MI empty;
    set VHCI01D_DATA empty;

  
  
    VHCI01B_DATA.CAR-NO = VHCI01IW.CAR-NO;
    try
        call "VHCI01B"(XDCONTROL, VHCI01B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCI01IW.SCR-DISP-VEH-STAT = VHCI01B_DATA.DISP-VEH-STAT;
        VHCI01IW.CON-NO = VHCI01B_DATA.CON-NO;
        if (VHCI01B_DATA.WHERE-IS-CAR == "CON")
            ERROR-MSG = "Y";
            VHCI01IW.FINAL-ERROR-MESSAGE = "Car In Use.";
            CAR-ON-CONSIST = "Y";
        else
            if (VHCI01B_DATA.CAR-TYPE-1 == "D")
                ERROR-MSG = "Y";
                VHCI01IW.FINAL-ERROR-MESSAGE = "Not valid for Dummy cars.";
                DUMMY-CAR = "Y";
            else
                if (VHCI01IW.CAR-NO == "0095" &&
                 VHCI01B_DATA.CAR-TYPE-1 == "T")
                    VHCI01IW.FINAL-ERROR-MESSAGE = "Invalid Action for Car.";
                    INVALID-ACTION = "Y";
                    ERROR-MSG = "Y";
                else
                    if ((VHCI01IW.STATUS == "ACIDNT" ||
                     VHCI01IW.STATUS == "AWPART" ||
                     VHCI01IW.STATUS == "ENGHLD" ||
                     VHCI01IW.STATUS == "MISC" ||
                     VHCI01IW.STATUS == "MODHLD" ||
                     VHCI01IW.STATUS == "RHB" ||
                     VHCI01IW.STATUS == "SAFETY" ||
                     VHCI01IW.STATUS == "STOR" ||
                     VHCI01IW.STATUS == "TEST"))
                        if (VHCI01B_DATA.WORST-CASE-RANK < 80)
                            if (VHCI01B_DATA.TRAIN-INCD-IND == "N")

                            else
                                ERROR-MSG = "Y";
                                DISP-ERR-MSG = "Invalid Action - train incd";
                            end
                        else
                            ERROR-MSG = "Y";
                            DISP-ERR-MSG = "Invalid Action for Car";
                        end
                    end
                    VHCI01IW.FINAL-ERROR-MESSAGE = DISP-ERR-MSG;
                end
            end
        end
        if (ERROR-MSG == "Y")
            CARNO-SETFOCUS = "Y";
            LOAD-CAR-STATUS = "Y";
        end
    else
        if (XDCONTROL.URC == 100)
            ERROR-MSG = "Y";
            VHCI01IW.FINAL-ERROR-MESSAGE = "Car not found in the database.";
            CAR-NOT-FOUND = "Y";
        else
            ERROR-MSG = "Y";
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHCI03IS-CAR-STAT () 
    VHCI01IW.STATUS = " ";
    VHCI01IW.NARR = " ";
    VHCI01IW.PM-LOC = " ";
    VHCI01IW.SCR-DISP-VEH-STAT = " ";
    if (VHCI01IW.ACTION-OPT == 1) 
        VHCI01IW-TRIGGER.SHOW-STATUS = "Y";
    else
        VHCI01IW-TRIGGER.HIDE-STATUS = "Y";
    end
    ENABLE-NARR = "Y";
    DISABLE-PMLOC = "Y";
    VHCI01IW.COL-HEADING = "Change * ";
end 

Function VHCI03IS-CLEAR () 
    VHCI01IW.CAR-NO = " ";
    VHCI01IW.STATUS = " ";
    VHCI01IW.SCR-DISP-VEH-STAT = " ";
    VHCI01IW.DISP-AREA-MSG = " ";
    VHCI01IW-TEMP-MI.NARR = " ";
    VHCI01IW.FINAL-ERROR-MESSAGE = " ";
    set VHCI01B_DATA empty;
    VHCI01IW.DATE-STAT-CHG = VGVar.currentFormattedGregorianDate;
    VHCI01IW.TIME-STAT-CHG = VGVar.currentFormattedTime;
    VHCI01IW.DISP-TIME-STAT-CHG-HR = VHCI01IW.TIME-STAT-CHG-HR;
    VHCI01IW.DISP-TIME-STAT-CHG-MIN = VHCI01IW.TIME-STAT-CHG-MIN;
    set VHCI01D_DATA empty;
