    VHINC01IW.TIME-INCD-OCCR-FILLER-1 = ":";
    VHINC01IW.TIME-INCD-OCCR-FILLER-2 = ":";
    VHINC1F_DATA.TIME-INCD-OCCR = VHINC01IW.TIME-INCD-OCCR;

  
    VHINC1F_DATA.USER-GRP = VHINC01IW.USER-GRP;
    VHINC1F_DATA.DATE-NARR = VHINC01IW.DATE-NARR;
    VHINC01IW.TIME-NARR-FILLER-1 = ":";
    VHINC01IW.TIME-NARR-FILLER-2 = ":";
    VHINC1F_DATA.TIME-NARR = VHINC01IW.TIME-NARR;
    VHINC1F_DATA.NARR = VHINC01IW.INCD-NARR;
end 

Function VHINC01IS-NARR-DET () 
    NARR-INDEX = 1;
    VHINC01IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC01IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC01IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC01IW.DATE-NARR-FILLER1 = "-";
    VHINC01IW.DATE-NARR-FILLER2 = "-";
    VHINC01IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC01IW.TIME-NARR-FILLER-1 = ":";
    VHINC01IW.TIME-NARR-FILLER-2 = " ";
    VHINC01IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
    if (NARR-COUNT > 1)
        DISABLE-PREV = "Y";
        ENABLE-NEXT = "Y";
    else
        DISABLE-PREV = "Y";
        DISABLE-NEXT = "Y";
    end
end 

Function VHINC01IS-PRVNXT () 
    if (BUTTON-CLICK == "PREV")
        VHINC01IW.NARR-INDEX = VHINC01IW.NARR-INDEX - 1;
        if (VHINC01IW.NARR-INDEX <= 1)
            VHINC01IW.NARR-INDEX = 1;
            DISABLE-PREV = "Y";
        else
            ENABLE-PREV = "Y";
        end
        ENABLE-NEXT = "Y";
    else
        if (BUTTON-CLICK == "NEXT")
            VHINC01IW.NARR-INDEX = VHINC01IW.NARR-INDEX + 1;
            ENABLE-PREV = "Y";
            if (VHINC01IW.NARR-INDEX >= VHINC01IW.NARR-COUNT)
                VHINC01IW.NARR-INDEX = VHINC01IW.NARR-COUNT;
                DISABLE-NEXT = "Y";
            else
                ENABLE-NEXT = "Y";
            end
        end
    end
    VHINC01IW.INCD-NARR = VHINC1D_DATA.NARR[NARR-INDEX];
    VHINC01IW.NARR-NO = VHINC1D_DATA.NARR-NO[NARR-INDEX];
    VHINC01IW.DATE-NARR = VHINC1D_DATA.DATE-NARR[NARR-INDEX];
    VHINC01IW.TIME-NARR = VHINC1D_DATA.TIME-NARR[NARR-INDEX];
    VHINC01IW.TIME-NARR-FILLER-1 = ":";
    VHINC01IW.TIME-NARR-FILLER-2 = " ";
    VHINC01IW.USER-GRP = VHINC1D_DATA.USER-GRP[NARR-INDEX];
end 

Function VHINC01IS-RET-INCD () 
    if (VHINC01IW.INCD-NO != " ")
        VHINC01IW.NARR-COUNT = 0;
        VHINC1D_CRIT.INCD-NO = VHINC01IW.INCD-NO;
        VHINC1D_CRIT.RET-CHECK = "BOTH";
        try
            call "VHINC1D"(XDCONTROL, VHINC1D_CRIT, VHINC1D_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            ENABLE-INCDDET = "Y";
            VHINC01IW.NARR-COUNT = XDCONTROL.UROWCNT;
            VHINC01IS-INCD-DET();
        else
            if (XDCONTROL.URC == 100)
                SUCCESS-MESSAGE = "Incident record not found.";
                
        
                VHINC01IS-CLRAFTLS(); 
                                   
            else
                EXECUTE-CLEAR = "Y";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    else
  
  
  
        SUCCESS-MESSAGE = "Invalid Incident No.";
        VHINC01IS-CLRAFTLS(); 
                                   
    end
end 

Function VHINC01IS-REV-TIME () 
    try
        call "VHINCD"(XDCONTROL, VHINCD_DATA);
    
    end
    VHXREVC_DATA.DB-REVENUE-DATE = VHINCD_DATA.REVENUE-DATE;
    
  
    VHXREVC_DATA.END-TIME-DAY = "24.00.00";
    

  
  
    VHXREVC_DATA.TIME-REV-START = "03.00.00";
    VHXREVC_DATA.TIME-REV-END = "02.59.59";
    

  
  
  
  
  

  
  

   
    try
        call "VHCI02G"(XDCONTROL, VHCI02G_CRIT, VHCI02G_DATA);
    
    end
    if (XDCONTROL.UROWCNT == 1)
        VHXREVC_DATA.SYSTEM-DATE = VHCI02G_CRIT.CURRENT-DATE;
        VHXREVC_DATA.SYSTEM-TIME = VHCI02G_CRIT.CURRENT-TIME;
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    VHXREVC_DATA.SYS-MINUTES = (VHXREVC_DATA.SYSTEM-TIME-HR-NUM * 60) + VHXREVC_DATA.SYSTEM-TIME-MIN-NUM;
    if (VHXREVC_DATA.SYS-MINUTES < 180)
  
  
        XXDATEW.DATE-YYYY-MM-DD = VHXREVC_DATA.DB-REVENUE-DATE;
        XXDATEW.VAGen_FUNCTION = "MDY";
        MRSCommonCode.XXDATES-CONVERT();
        VHXREVC_DATA.REVENUE-DATE = XXDATEW.DATE-MM-DD-YYYY;
    else
        VHXREVC_DATA.REVENUE-DATE = VHXREVC_DATA.SYSTEM-DATE;
    end
end 

Function VHINC01IS-SETFOCUS () 
    if (INVALID-CON-NO == "Y" ||
     DISPLAY-INVALID-CON-NO == "Y" ||
     DISPLAY-NOT-IN-SVC == "Y")
        CONNO-SETFOCUS = "Y";
    else
        if (INVALID-SYMP-CD == "Y" ||
         INVALID-SYMPCD-VAL == "Y")
            SYMPCD-SETFOCUS = "Y";
        else
            if (INVALID-TIME-INCD == "Y" ||
             DISP-INVALID-TIME == "Y" ||
             DISP-TIME-ERRMSG == "Y")
                TIMEINCD-SETFOCUS = "Y";
            else
                if (INVALID-SPEED == "Y" ||
                 INVALID-SPEED-VAL == "Y")
                    SPEED-SETFOCUS = "Y";
                else
                    if (INVALID-DIRECTION == "Y")
                        CONDIRECTION-SETFOCUS = "Y";
                    else
                        if (INVALID-INCD-LOC == "Y")
                            INCDLOC-SETFOCUS = "Y";
                        else
                            if (INVALID-INCD-NARR == "Y")
                                INCDNARR-SETFOCUS = "Y";
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHINC01IS-STORE-DB () 
    if (CHECK-ENTRY == 1) 

  
  
  
  
        SUCCESS-MESSAGE = " ";
        
   
        VHINC01IS-MOVE-RE2();
        try
            call "VHINC1F"(XDCONTROL, VHINC1F_CRIT, VHINC1F_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            SUCCESS-MESSAGE-1 = "Incd No ";
            SUCCESS-MESSAGE-2 = VHINC1F_DATA.INCD-NO;
            SUCCESS-MESSAGE-3 = " for Consist ";
            SUCCESS-MESSAGE-4 = VHINC01IW.CONSIST-NO;
            SUCCESS-MESSAGE-5 = " was generated successfully";
            VHINC01IW.NARR-COUNT = 1;
            VHINC01IW.INCD-NO = VHINC1F_DATA.INCD-NO;
            VHINC01IS-CLRAFTDB(); 
                                   
            ENABLE-INCDDET = "Y";
            DISABLE-ADDNARR = "Y";
            DISABLE-CHANGE = "Y";
            ENABLE-CREATE = "Y";
            CONNO-SETFOCUS = "Y";
            
  
        else
            EXECUTE-CLEAR = "Y";
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    else
        if (CHECK-ENTRY == 2) 
    
    
            VHINC1C_CRIT.INCD-NO = VHINC01IW.INCD-NO;
            VHINC1C_DATA.SPEED = VHINC01IW.SPEED;
            VHINC1C_DATA.SYMP-CD = VHINC01IW.SYMP-CD;
            VHINC1C_DATA.CON-DIRECTION = VHINC01IW.CON-DIRECTION;
            VHINC1C_DATA.INCD-LOC = VHINC01IW.INCD-LOC;
            VHINC1C_DATA.USER-GRP = VHINC01IW.USER-GRP;
            VHINC1C_DATA.TERM-LAST-UPD = VHINC01IW.TERM-LAST-UPD;
            try
                call "VHINC1C"(XDCONTROL, VHINC1C_CRIT, VHINC1C_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                SUCCESS-MESSAGE-1 = "Incd No ";
                SUCCESS-MESSAGE-2 = VHINC1C_CRIT.INCD-NO;
                SUCCESS-MESSAGE-3 = " for Consist ";
                SUCCESS-MESSAGE-4 = VHINC01IW.CONSIST-NO;
                SUCCESS-MESSAGE-5 = " was updated successfully.";
                ENABLE-INCDDET = "Y";
                DISABLE-FIELDS = "Y";
                ENABLE-SYMPCD = "Y";
                ENABLE-SPEED = "Y";
                ENABLE-CONDIRECTION = "Y";
                ENABLE-INCDLOC = "Y";
                ENABLE-ADDNARR = "Y";
                ENABLE-CHANGE = "Y";
                DISABLE-CREATE = "Y";
                ADDNARR-SETFOCUS = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

Function VHINC01IS-UPD () 
    SUCCESS-MESSAGE = " ";
    VHINC01IW.DISCV-DUR = "1";
    VHINC01IW.INCD-NO = " ";
    VHINC01IW.DASH-NO-CHAR = " ";
