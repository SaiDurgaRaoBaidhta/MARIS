Function VHYT61IS-CK-RM-1 () 
    if (VHYT61IW-TRIGGER.CLICK-ONE == " ")
        VHYT61IW-TRIGGER.CLICK-ONE = "Y";
  
        VHYT61IW-PASSVALUE.CLICK-RM-1 = "Y";
        VHYT10IW-PASSVALUE.CAR-NO = VHYT61IW-RM-1.CAR-1;
        VHYT10IW-PASSVALUE.YRD-SUB-LOC = "RM-1";
        VHYT10IW-PASSVALUE.POSN-NO-FROM = 1;
        
  
    else
        if (VHYT61IW-TRIGGER.CLICK-TWO == " ")
            VHYT61IW-TRIGGER.CLICK-TWO = "Y";
            if (VHYT61IW-PASSVALUE.CLICK-RM-1 == " ")
                VHYT61IW-PASSVALUE.CLICK-RM-1 = "Y";
                VHYT10IW-PASSVALUE.NEW-YRD-LOC = "RM-1";
                VHYT10IW-PASSVALUE.CAR-NO-2 = VHYT61IW-RM-1.CAR-1;
                VHYT61IW-TRIGGER.OPEN-YT03I = "Y";
            else
                VHYT61IW-PASSVALUE.CLICK-RM-1 = " ";
                VHYT61IW-TRIGGER.CLICK-ONE = " ";
                VHYT61IW-TRIGGER.CLICK-TWO = " ";
            end
        else
            VHYT61IW-TRIGGER.CLICK-ONE = " ";
            VHYT61IW-TRIGGER.CLICK-TWO = " ";
            VHYT61IW-PASSVALUE.CLICK-RM-1 = "Y";
            VHYT61IW-MESSAGE.TOO-MANY-CLICK = "TOO MANY CLICK......";
        end
    end
    if (VHYT61IW-RM-1.CAR-1 != " ")
        VHYT61IW-TRIGGER.ENABLE-SVHV = "Y";
    else
        VHYT61IW-TRIGGER.DISABLE-SVHV = "Y";
    end
