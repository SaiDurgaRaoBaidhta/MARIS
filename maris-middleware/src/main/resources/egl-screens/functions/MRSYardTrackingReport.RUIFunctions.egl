Function VHYT53IS-MOVE-CAR () 
    VHYT53IW-MSG.FINAL-MESSAGE = "  ";
    if (SELECT-CAR > 0 && VHYT53IW-MOVE.YRD-SUB-LOC != "   ")
        VHYT53H_CRIT.YRD-SUB-LOC = VHYT53IW-MOVE.YRD-SUB-LOC;
        VHYT53H_CRIT.CAR-NO = VHYT53IW-MOVE.CAR-NO;
        VHYT53H_CRIT.YRD-TRKG-YRD = VHYT53IW.YRD-TRKG-YRD;
        VHYT53H_DATA.TERM-LAST-UPD = VHYT53IW-PASSVALUE.TERM-LAST-UPD;
        VHYT53H_DATA.USER-GROUP = VHYT53IW-PASSVALUE.USER-GROUP;
        try
            call "VHYT53H"(XDCONTROL, VHYT53H_CRIT, VHYT53H_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHYT53H_DATA.MOVE-SAME-TRK == "Y")
                VHYT53IS-C-NEW();
                VHYT53IW-MSG.FINAL-MSG-1 = VHYT53H_CRIT.CAR-NO;
                VHYT53IW-MSG.FINAL-MSG-2 = " car is moved back to the track it was in before.";
                VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.FINAL-MSG-ALL;
            else
                VHYT53IS-C-NEW();
                VHYT53IW-MSG.FINAL-MSG-1 = VHYT53H_CRIT.CAR-NO;
                VHYT53IW-MSG.FINAL-MSG-2 = " car is moved. ";
                VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.FINAL-MSG-ALL;
            end
        else
            if (VHYT53H_DATA.TRK-IS-FULL == "Y")
                VHYT53IW-MSG.TEMP-MSG-1 = " Car can not be moved. Please select another track. No room on Track ";
                VHYT53IW-MSG.TEMP-MSG-2 = VHYT53H_CRIT.YRD-SUB-LOC;
                VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.TEMP-MESSAGE;
                VHYT53IW-MSG.TEMP-MESSAGE = "  ";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        end
        set VHYT53IW-MOVE empty;
        set VHYT53IW-CLICK empty;
        VHYT53IW-NEW-CON.SELECT-CAR = 0;
        VHYT53IW-NEW-CON.COLOR-B-1 = "GREY";
        VHYT53IW-NEW-CON.COLOR-B-2 = "GREY";
        VHYT53IW-NEW-CON.COLOR-B-3 = "GREY";
        VHYT53IW-NEW-CON.COLOR-B-4 = "GREY";
        VHYT53IW-NEW-CON.COLOR-B-5 = "GREY";
        VHYT53IW-NEW-CON.COLOR-B-6 = "GREY";
        VHYT53IW-NEW-CON.COLOR-B-7 = "GREY";
        VHYT53IW-NEW-CON.COLOR-B-8 = "GREY";
        VHYT53IW-NEW-CON.COLOR-B-9 = "GREY";
        VHYT53IW-NEW-CON.COLOR-B-10 = "GREY";
    else
        VHYT53IW-MSG.FINAL-MESSAGE = "No car/track selected.  Please select a car/track before press MOVE button";
        if (VHYT53IW-MOVE.YRD-SUB-LOC == " ")
            VHYT53IW-TRIGGER.MOVE-TRK-SETFOCUS = "Y";
        end
    end
    VHYT53IW-TRIGGER.DISABLE-RESET = "Y";
end 

Function VHYT53IS-MOVE-DATA () 
    X = 1;
    Y1 = 1;
    while (X <= VHYT53IW-CNT.CON-ROW-CNT)
        if (VHYT53B_DATA.CON-NO[X] == VHYT53C_DATA.CON-NO[Y1])
            VHYT53B_DATA.CON-NO-D[X] = VHYT53B_DATA.CON-NO[X];
            if (VHYT53B_DATA.DASH-NO[X] == 0)
                if (VHYT53B_DATA.CON-IND[X] == "C")
                    VHYT53B_DATA.DASH-NO-D[X] = "X ";
                    VHYT53B_DATA.DASH[X] = "-";
                else
                    VHYT53B_DATA.DASH-NO-D[X] = " ";
                    VHYT53B_DATA.DASH[X] = " ";
                end
            else
                VHYT53B_DATA.DASH-NO-D[X] = VHYT53B_DATA.DASH-NO[X];
                VHYT53B_DATA.DASH[X] = "-";
            end
            Y2 = Y1 + 1;
            Y3 = Y2 + 1;
            Y4 = Y3 + 1;
            Y5 = Y4 + 1;
            Y6 = Y5 + 1;
            Y7 = Y6 + 1;
            Y8 = Y7 + 1;
            Y9 = Y8 + 1;
            Y10 = Y9 + 1;
            if (MAX-POSN-NO[X] == 1)
                VHYT53B_DATA.CAR-NO-1[X] = VHYT53C_DATA.CAR-NO-X[Y1];
                VHYT53B_DATA.HOME-YRD-1[X] = VHYT53C_DATA.HOME-YRD[Y1];
                VHYT53B_DATA.CAR-TYPE-1[X] = VHYT53C_DATA.CAR-TYPE[Y1];
                VHYT53B_DATA.TRAIN-INCD-IND-1[X] = VHYT53C_DATA.TRAIN-INCD-IND[Y1];
                VHYT53B_DATA.ATO-PRESENT-IND-1[X] = VHYT53C_DATA.ATO-PRESENT-IND[Y1];
            else
                if (MAX-POSN-NO[X] == 2)
                    VHYT53B_DATA.CAR-NO-1[X] = VHYT53C_DATA.CAR-NO-X[Y1];
                    VHYT53B_DATA.CAR-NO-2[X] = VHYT53C_DATA.CAR-NO-X[Y2];
                    VHYT53B_DATA.HOME-YRD-1[X] = VHYT53C_DATA.HOME-YRD[Y1];
                    VHYT53B_DATA.HOME-YRD-2[X] = VHYT53C_DATA.HOME-YRD[Y2];
                    VHYT53B_DATA.CAR-TYPE-1[X] = VHYT53C_DATA.CAR-TYPE[Y1];
                    VHYT53B_DATA.CAR-TYPE-2[X] = VHYT53C_DATA.CAR-TYPE[Y2];
                    VHYT53B_DATA.TRAIN-INCD-IND-1[X] = VHYT53C_DATA.TRAIN-INCD-IND[Y1];
                    VHYT53B_DATA.TRAIN-INCD-IND-2[X] = VHYT53C_DATA.TRAIN-INCD-IND[Y2];
                    VHYT53B_DATA.ATO-PRESENT-IND-1[X] = VHYT53C_DATA.ATO-PRESENT-IND[Y1];
                    VHYT53B_DATA.ATO-PRESENT-IND-2[X] = VHYT53C_DATA.ATO-PRESENT-IND[Y2];
                    VHYT53B_DATA.VEH-STAT-1[X] = VHYT53C_DATA.VEH-STAT[Y1];
                    VHYT53B_DATA.VEH-STAT-2[X] = VHYT53C_DATA.VEH-STAT[Y2];
                else
                    if (MAX-POSN-NO[X] == 3)
                        VHYT53B_DATA.CAR-NO-1[X] = VHYT53C_DATA.CAR-NO-X[Y1];
                        VHYT53B_DATA.CAR-NO-2[X] = VHYT53C_DATA.CAR-NO-X[Y2];
                        VHYT53B_DATA.CAR-NO-3[X] = VHYT53C_DATA.CAR-NO-X[Y3];
                        VHYT53B_DATA.HOME-YRD-1[X] = VHYT53C_DATA.HOME-YRD[Y1];
                        VHYT53B_DATA.HOME-YRD-2[X] = VHYT53C_DATA.HOME-YRD[Y2];
                        VHYT53B_DATA.HOME-YRD-3[X] = VHYT53C_DATA.HOME-YRD[Y3];
                        VHYT53B_DATA.CAR-TYPE-1[X] = VHYT53C_DATA.CAR-TYPE[Y1];
                        VHYT53B_DATA.CAR-TYPE-2[X] = VHYT53C_DATA.CAR-TYPE[Y2];
                        VHYT53B_DATA.CAR-TYPE-3[X] = VHYT53C_DATA.CAR-TYPE[Y3];
                        VHYT53B_DATA.TRAIN-INCD-IND-1[X] = VHYT53C_DATA.TRAIN-INCD-IND[Y1];
                        VHYT53B_DATA.TRAIN-INCD-IND-2[X] = VHYT53C_DATA.TRAIN-INCD-IND[Y2];
                        VHYT53B_DATA.TRAIN-INCD-IND-3[X] = VHYT53C_DATA.TRAIN-INCD-IND[Y3];
                        VHYT53B_DATA.ATO-PRESENT-IND-1[X] = VHYT53C_DATA.ATO-PRESENT-IND[Y1];
                        VHYT53B_DATA.ATO-PRESENT-IND-2[X] = VHYT53C_DATA.ATO-PRESENT-IND[Y2];
                        VHYT53B_DATA.ATO-PRESENT-IND-3[X] = VHYT53C_DATA.ATO-PRESENT-IND[Y3];
                        VHYT53B_DATA.VEH-STAT-1[X] = VHYT53C_DATA.VEH-STAT[Y1];
                        VHYT53B_DATA.VEH-STAT-2[X] = VHYT53C_DATA.VEH-STAT[Y2];
                        VHYT53B_DATA.VEH-STAT-3[X] = VHYT53C_DATA.VEH-STAT[Y3];
                    else
                        if (MAX-POSN-NO[X] == 4)
                            VHYT53B_DATA.CAR-NO-1[X] = VHYT53C_DATA.CAR-NO-X[Y1];
                            VHYT53B_DATA.CAR-NO-2[X] = VHYT53C_DATA.CAR-NO-X[Y2];
                            VHYT53B_DATA.CAR-NO-3[X] = VHYT53C_DATA.CAR-NO-X[Y3];
