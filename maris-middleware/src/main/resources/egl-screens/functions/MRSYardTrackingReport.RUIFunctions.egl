Function VHYT91IS-DETAIL () 
    VHYT91IW-PASSVALUE.YRD-TRKG-YRD = "RY";
    VHYT91IW-PASSVALUE.FROM-YRD-SUB-LOC = VHYT91IW-PARM-T.TRACK-LOC;
end 

Function VHYT91IS-INIT () 
    VHYT91IS-CLEAR-1();
    set VHYT91IW-MOVE empty;
    VHYT91IW-MOVE.CLICKED = 0;
    set VHYT91IW-PASSVALUE empty;
    VHYT91IW-PASSVALUE.YRD-TRKG-YRD = "RY";
    VHYT90A_CRIT.YRD-TRKG-YRD = "RY";
    VH01A02_CRIT.GUI-NAME = "VHYT91";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT90I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT90A";

    
    try
        call "VHYT90A"(XDCONTROL, VHYT90A_CRIT, VHYT90A_DATA);
    
    end
    

   
    MRSCommonCode.XXA0IS-CHECK_EXT();

   
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT91IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHYT91IS-LOAD ()  
    move VHYT90A_DATA.DATA_ROW to VHYT91A_DATA.DATA_ROW[1] for all;
    COUNTER = 1;
    while (VHYT91IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "RR-01")
            VHYT91IS-RR-01();
        else
            if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "RR-02")
                VHYT91IS-RR-02();
            else
                if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "RR-03")
                    VHYT91IS-RR-03();
                else
                    if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "RT-91")
                        VHYT91IS-RT-91();
                    else
                        if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "RT-92")
                            VHYT91IS-RT-92();
                        else
                            if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-06")
                                VHYT91IS-ST-06();
                            else
                                if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-07")
                                    VHYT91IS-ST-07();
                                else
                                    if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-08")
                                        VHYT91IS-ST-08();
                                    else
                                        if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-09")
                                            VHYT91IS-ST-09();
                                        else
                                            if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-10")
                                                VHYT91IS-ST-10();
                                            else
                                                if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-11")
                                                    VHYT91IS-ST-11();
                                                else
                                                    if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-12")
                                                        VHYT91IS-ST-12();
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-13")
                VHYT91IS-ST-13();
            else
                if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-14")
                    VHYT91IS-ST-14();
                else
                    if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-15")
                        VHYT91IS-ST-15();
                    else
                        if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-16")
                            VHYT91IS-ST-16();
                        else
                            if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-17")
                                VHYT91IS-ST-17();
                            else
                                if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "TF-01")
                                    VHYT91IS-TF-01();
                                else
                                    if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "TF-02")
                                        VHYT91IS-TF-02();
                                    else
                                        if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "TF-03")
                                            VHYT91IS-TF-03();
                                        else
                                            if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "TF-04")
                                                VHYT91IS-TF-04();
                                            else
                                                if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "TF-05")
                                                    VHYT91IS-TF-05();
                                                else
                                                    if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "ST-18")
                                                        VHYT91IS-ST-18();
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "S-1")
            VHYT91IS-S-1();
        else
            if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "S-2")
                VHYT91IS-S-2();
            else
                if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "S-3")
                    VHYT91IS-S-3();
                else
                    if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "TR-1")
                        VHYT91IS-TR-1();
                    else
                    	if (VHYT91A_DATA.YRD-SUB-LOC[COUNTER] == "YT")
                        	VHYT91IS-YT();
                       	end
                    
                    end
                end
            end
        end
        COUNTER = COUNTER + 1;
    end
end 

