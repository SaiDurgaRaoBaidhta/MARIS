Function VHYT105IS-CLICK () 
    VHYT105IW-PASSVAL.YRD-SUB-LOC = VHYT105IS-PARM.YRD-SUB-LOC;
    VHYT105IW-PASSVAL.YRD-TRKG-YRD = "DY";
end

Function VHYT105IS-COLOR () 
    if (VHYT105A_DATA.HOME-YRD[COUNTER] == "HY")
        VHYT105IW-PASSVAL.CAR-COLOR = "GREEN";
        VHYT105IW-PASSVAL.CAR-COLOR-B = "GREY90";
    else
        if (VHYT105A_DATA.HOME-YRD[COUNTER] == "RY")
            VHYT105IW-PASSVAL.CAR-COLOR = "BROWN";
            VHYT105IW-PASSVAL.CAR-COLOR-B = "GREY90";
        else
            if (VHYT105A_DATA.HOME-YRD[COUNTER] == "CY")
                VHYT105IW-PASSVAL.CAR-COLOR = "BLUE";
                VHYT105IW-PASSVAL.CAR-COLOR-B = "GREY90";
            else
                if (VHYT105A_DATA.HOME-YRD[COUNTER] == "DY")
                    VHYT105IW-PASSVAL.CAR-COLOR = "RED";
                    VHYT105IW-PASSVAL.CAR-COLOR-B = "GREY90";
                else
                    VHYT105IW-PASSVAL.CAR-COLOR = "BLACK";
                    VHYT105IW-PASSVAL.CAR-COLOR-B = "GREY90";
                end
            end
        end
    end
end 

