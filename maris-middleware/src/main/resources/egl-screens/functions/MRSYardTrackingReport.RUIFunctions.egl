

package MRSYardTrackingReport;

Function GiveAColor(VEHSTAT char(6) const in , TRAININCD char(1) const in, HIGHPMHR SMALLINT const in) returns (String)
	aColor string;
	if ( strLib.clip(VEHSTAT, 2) == "GO"  && TRAININCD != "Y" )
	    if (HIGHPMHR == 1 ) 
	    	aColor =  "BROWN";
		else 
			aColor = "BLACK";
		end	    
	else 
		if ( strLib.clip(VEHSTAT, 2) == "USABLE" && TRAININCD != "Y" )
	    	aColor = "BLUE";
		else 
			aColor = "RED"; 
	    end
	end	
	return (aColor);
end

Function dy100Color ( HOME_YARD char(3) const in ) returns (String)
    theColor string;
    
    if (HOME_YARD == "HY") 
        theColor = "GREEN";
    else
        if (HOME_YARD == "RY")
            theColor = "BROWN";
        else
            if (HOME_YARD == "CY")
                theColor = "BLUE";                
            else
                if (HOME_YARD == "DY")
                    theColor = "RED";                    
                else
                    theColor = "BLACK";
                end
            end
        end
    end
    return (theColor);
end 


