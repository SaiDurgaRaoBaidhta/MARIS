Function VHYT53IS-VALID2 () 
    VHYT53IW-MSG.FINAL-MESSAGE = " ";
    ERROR-CNT = 0;
    if (VHYT53IW-NEW-CON.LAST-POSN < 1)
        ERROR-CNT = ERROR-CNT + 1;
        VHYT53IW-MSG.FINAL-MESSAGE = "Pseudo has no Car.  Please Add more car";
    else
        if (VHYT53IW-NEW-CON.CON-NO is numeric)
            if (VHYT53IW-NEW-CON.CON-NO-N > 99 &&
             VHYT53IW-NEW-CON.CON-NO-N < 1000)
                VHYT53L_CRIT.CON-NO = VHYT53IW-NEW-CON.CON-NO;
                VHYT53L_CRIT.YRD-TRKG-YRD = VHYT53IW.YRD-TRKG-YRD;
                VHYT53L_DATA.VALID-IND = "P";
                try
                    call "VHYT53L"(XDCONTROL, VHYT53L_CRIT, VHYT53L_DATA);
                
                end
                if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
                    if (VHYT53L_DATA.CON-ERR == "Y")
                        VHYT53IW-MSG.PROMPT-MSG-A = " ";
                        VHYT53IW-MSG.PROMPT-MSG-A-1 = "  Train ";
                        VHYT53IW-MSG.PROMPT-MSG-A-2 = VHYT53IW-NEW-CON.CON-NO;
                        VHYT53IW-MSG.PROMPT-MSG-A-3 = " already exists in ";
                        VHYT53IW-MSG.PROMPT-MSG-A-4 = VHYT53L_DATA.YRD-TRKG-YRD;
                        VHYT53IW-MSG.PROMPT-MSG-A-5 = " yard.";
                        VHYT53IW-MSG.PROMPT-MSG-A-6 = "Please enter another train number.";
                        VHYT53IW-TRIGGER.CON-NO-SETFOCUS = "Y";
                        ERROR-CNT = ERROR-CNT + 1;
                        VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.PROMPT-MSG-A;
                    end
                else
                    if (XDCONTROL.URC == 100)
                        if (VHYT53L_DATA.CON-ERR == "N")
                            VHYT53IS-VALID-CR2();
                        end
                    else
     
        
                        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    end
                end
            else
  
                ERROR-CNT = ERROR-CNT + 1;
                ER-CAR-NO[ERROR-CNT] = VHYT53IW-NEW-CON.CON-NO;
                ER-DESC[ERROR-CNT] = "-Con No out of range.";
                VHYT53IW-TRIGGER.CON-ERROR = "Y";
                VHYT53IS-MOVE-MSG();
            end
        else
            ERROR-CNT = ERROR-CNT + 1;
            ER-CAR-NO[ERROR-CNT] = VHYT53IW-NEW-CON.CON-NO;
            ER-DESC[ERROR-CNT] = "-Con No is not numeric.";
            VHYT53IW-TRIGGER.CON-ERROR = "Y";
            VHYT53IS-MOVE-MSG();
        end
    end
end 

Function VHYT61IS-1A () 
    if (VHYT61A-DATA.POSN-NO[CNT] == 1)
    	VHYT61IW-1A.COLOR-01 = VHYT61A-DATA.FCOLOR[CNT];
    	VHYT61IW-1A.CAR-1 = VHYT61A-DATA.CAR-NO[CNT]; 
        if (VHYT61A-DATA.VAGen_ORIENTATION[CNT] == VHYT61A-DATA.LFT-ORIENTATION-CD[CNT])
            VHYT61IW-1A.LFT-OR-1 = VHYT61A-DATA.VAGen_ORIENTATION[CNT];
        else
            VHYT61IW-1A.RGT-OR-1 = VHYT61A-DATA.VAGen_ORIENTATION[CNT];
        end
        VHYT61IW-1A.BUTTONTXT01 = VHYT61A-DATA.BUTTONTXT[CNT];
