        VHYT90IW-TR-1.CAR-1-COLOR = VHYT90IW-PASSVALUE.CAR-COLOR;
        VHYT90IW-TR-1.CAR-1-COLOR-B = VHYT90IW-PASSVALUE.CAR-COLOR-B;
