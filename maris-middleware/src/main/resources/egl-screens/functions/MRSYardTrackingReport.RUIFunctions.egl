                                                                VHYT90IW-TF-05.CAR-NO-15 = VHYT90A_DATA.CAR-NO[COUNTER];
                                                                VHYT90IS-COLOR();
                                                                VHYT90IW-TF-05.CAR-15-COLOR = VHYT90IW-PASSVALUE.CAR-COLOR;
                                                                VHYT90IW-TF-05.CAR-15-COLOR-B = VHYT90IW-PASSVALUE.CAR-COLOR-B;
                                                                VHYT90IW-TF-05.BUTTON-15 = strLib.clip(txt, 0);
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if (VHYT90A_DATA.POSN-NO[COUNTER] == 16)
        VHYT90IW-TF-05.ORIENTATION-16 = VHYT90A_DATA.VAGen_ORIENTATION[COUNTER];
        VHYT90IW-TF-05.CAR-NO-16 = VHYT90A_DATA.CAR-NO[COUNTER];
        VHYT90IS-COLOR();
        VHYT90IW-TF-05.CAR-16-COLOR = VHYT90IW-PASSVALUE.CAR-COLOR;
        VHYT90IW-TF-05.CAR-16-COLOR-B = VHYT90IW-PASSVALUE.CAR-COLOR-B;
        VHYT90IW-TF-05.BUTTON-16 = strLib.clip(txt, 0);
    end
end 

Function VHYT90IS-TR-1 () 
	txt char(6) = getButton (VHYT90A_DATA.VAGen_ORIENTATION[COUNTER] ,VHYT90A_DATA.CAR-NO[COUNTER],VHYT90A_DATA.SOFTVER[COUNTER] ) ;
    if (VHYT90A_DATA.POSN-NO[COUNTER] == 1)
        VHYT90IW-TR-1.ORIENTATION-1 = VHYT90A_DATA.VAGen_ORIENTATION[COUNTER];
        VHYT90IW-TR-1.CAR-NO-1 = VHYT90A_DATA.CAR-NO[COUNTER];
