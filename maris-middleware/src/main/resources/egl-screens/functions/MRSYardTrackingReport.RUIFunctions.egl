                                            else
                                                if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "WT-3A")
                                                    VHYT101IS-LOAD-CAR();
                                                    VHYT101IW-WT-3A.BUTTON-1 = VHYT101IW.BUTTON-1;
                                                    VHYT101IW-WT-3A.BUTTONTXT = VHYT101IW.BUTTONTXT;
                                                    VHYT101IW-WT-3A.COLOR = VHYT101A-DATA.FCOLOR[CNT];
                                                else
                                                    if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "WT-3B")
                                                        VHYT101IS-LOAD-CAR();
                                                        VHYT101IW-WT-3B.BUTTON-1 = VHYT101IW.BUTTON-1;
                                                        VHYT101IW-WT-3B.BUTTONTXT = VHYT101IW.BUTTONTXT;
                                                        VHYT101IW-WT-3B.COLOR = VHYT101A-DATA.FCOLOR[CNT];
                                                    else
                                                        if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "WT-3C")
                                                            VHYT101IS-LOAD-CAR();
                                                            VHYT101IW-WT-3C.BUTTON-1 = VHYT101IW.BUTTON-1;
                                                            VHYT101IW-WT-3C.BUTTONTXT = VHYT101IW.BUTTONTXT;
                                                            VHYT101IW-WT-3C.COLOR = VHYT101A-DATA.FCOLOR[CNT];
                                                        else
                                                            if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "WT-1")
                                                                VHYT101IS-LOAD-CAR();
                                                                VHYT101IW-WT-1.BUTTON-1 = VHYT101IW.BUTTON-1;
                                                                VHYT101IW-WT-1.BUTTONTXT = VHYT101IW.BUTTONTXT;
                                                                VHYT101IW-WT-1.COLOR = VHYT101A-DATA.FCOLOR[CNT];
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "SS-06")
            VHYT101IS-SS-06();
        else
            if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "RR-1A")
                VHYT101IS-RR-1A();
            else
                if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "RR-1B")
                    VHYT101IS-LOAD-CAR();
                    VHYT101IW-RR-1B.BUTTON-1 = VHYT101IW.BUTTON-1;
                    VHYT101IW-RR-1B.BUTTONTXT = VHYT101IW.BUTTONTXT;
                    VHYT101IW-RR-1B.COLOR = VHYT101A-DATA.FCOLOR[CNT];
                else
                    if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "RR-2A")
                        VHYT101IS-LOAD-CAR();
                        VHYT101IW-RR-2A.BUTTON-1 = VHYT101IW.BUTTON-1;
                        VHYT101IW-RR-2A.BUTTONTXT = VHYT101IW.BUTTONTXT;
                        VHYT101IW-RR-2A.COLOR = VHYT101A-DATA.FCOLOR[CNT];
                    else
                        if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "RR-2B")
                            VHYT101IS-LOAD-CAR();
                            VHYT101IW-RR-2B.BUTTON-1 = VHYT101IW.BUTTON-1;
                            VHYT101IW-RR-2B.BUTTONTXT = VHYT101IW.BUTTONTXT;
                            VHYT101IW-RR-2B.COLOR = VHYT101A-DATA.FCOLOR[CNT];
                        else
                            if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "RR-3A")
                                VHYT101IS-LOAD-CAR();
                                VHYT101IW-RR-3A.BUTTON-1 = VHYT101IW.BUTTON-1;
                                VHYT101IW-RR-3A.BUTTONTXT = VHYT101IW.BUTTONTXT;
                                VHYT101IW-RR-3A.COLOR = VHYT101A-DATA.FCOLOR[CNT];
                            else
                                if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "RR-3B")
                                    VHYT101IS-LOAD-CAR();
                                    VHYT101IW-RR-3B.BUTTON-1 = VHYT101IW.BUTTON-1;
                                    VHYT101IW-RR-3B.BUTTONTXT = VHYT101IW.BUTTONTXT;
                                    VHYT101IW-RR-3B.COLOR = VHYT101A-DATA.FCOLOR[CNT];
                                end
                            end
                        end
                    end
                end
            end
        end
        CNT = CNT + 1;
    end
end 

Function VHYT101IS-LOAD-CAR () 
    VHYT101IW.BUTTON-1 = " "; 
    if (VHYT101A-DATA.POSN-NO[CNT] == 1)
    	VHYT101IW.CAR-1 = VHYT101A-DATA.CAR-NO[CNT];
        if (VHYT101A-DATA.VAGen_ORIENTATION[CNT] == VHYT101A-DATA.LFT-ORIENTATION-CD[CNT])
            VHYT101IW.LFT-OR-1 = VHYT101A-DATA.VAGen_ORIENTATION[CNT];            
        else
            VHYT101IW.RGT-OR-1 = VHYT101A-DATA.VAGen_ORIENTATION[CNT];           
        end
        VHYT101IW.BUTTONTXT = VHYT101A-DATA.BUTTONTXT[CNT];
    end
end 

