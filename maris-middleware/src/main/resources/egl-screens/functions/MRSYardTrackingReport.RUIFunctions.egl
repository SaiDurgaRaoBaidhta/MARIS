Function VHYT100IS-INIT-S ()
  
  
  
  
  
  
  
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYTX0I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYX0A";

    
    try
        call "VHYTX0A"(XDCONTROL, VHYT100A-CRIT, VHYT100A-DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT100IS-LOAD();
        else
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHYT100IS-INIT-TRK () 
    set VHYT100IW-RR-1A empty;
    set VHYT100IW-RR-1B empty;
    set VHYT100IW-SS-06 empty;
    set VHYT100IW-RR-2A empty;
    set VHYT100IW-RR-2B empty;
    set VHYT100IW-RR-3A empty;
    set VHYT100IW-RR-3B empty;
    set VHYT100IW-ST-13 empty;
    set VHYT100IW-RR-1BP empty;
    set VHYT100IW-RR-2BP empty;
    set VHYT100IW-S-1A empty;
    set VHYT100IW-S-1B empty;
    set VHYT100IW-S-1WP empty;
    set VHYT100IW-S-2A empty;
    set VHYT100IW-S-2B empty;
    set VHYT100IW-S-2WP empty;
    set VHYT100IW-S-3A empty;
    set VHYT100IW-S-3B empty;
    set VHYT100IW-S-3N empty;
    set VHYT100IW-SS-2A empty;
    set VHYT100IW-SS-2B empty;
    set VHYT100IW-SS-3A empty;
    set VHYT100IW-SS-3B empty;
    set VHYT100IW-SS-4A empty;
    set VHYT100IW-SS-4B empty;
    set VHYT100IW-SS-5A empty;
    set VHYT100IW-SS-5B empty;
    set VHYT100IW-SS-5C empty;
    set VHYT100IW-SS-5D empty;
    set VHYT100IW-WT-3A empty;
    set VHYT100IW-WT-3B empty;
    set VHYT100IW-WT-3C empty;
    set VHYT100IW-WT-1 empty;
    
    set VHYT100IW-B-PIT-01 empty;
    set VHYT100IW-B-PIT-02 empty;
    set VHYT100IW-B-PIT-03 empty;
    set VHYT100IW-B-PIT-04 empty;
    set VHYT100IW-B-PIT-05 empty;
    set VHYT100IW-B-PIT-06 empty;
    
    VHYT100IS-INIT-S();
end 

Function VHYT100IS-LOAD () 
    CNT = 1;
    while (VHYT100IW.CNT <= XDCONTROL.UROWCNT)
    	VHYT100A-DATA.FCOLOR[CNT] = dy100Color (VHYT100A-DATA.HOME-YRD[CNT]);
    	
    	if (strLib.characterLen(VHYT100A-DATA.SOFTVER[CNT])>1 ) 
	    	if (VHYT100A-DATA.VAGen_ORIENTATION[CNT] == VHYT100A-DATA.LFT-ORIENTATION-CD[CNT])
	    		VHYT100A-DATA.BUTTONTXT[CNT] = "$" + VHYT100A-DATA.VAGen_ORIENTATION[CNT] + VHYT100A-DATA.CAR-NO[CNT];
	    	else
	    		VHYT100A-DATA.BUTTONTXT[CNT] = "$" + VHYT100A-DATA.CAR-NO[CNT] + VHYT100A-DATA.VAGen_ORIENTATION[CNT];
	    	end
		else
			if (VHYT100A-DATA.VAGen_ORIENTATION[CNT] == VHYT100A-DATA.LFT-ORIENTATION-CD[CNT])
	    		VHYT100A-DATA.BUTTONTXT[CNT] = VHYT100A-DATA.VAGen_ORIENTATION[CNT]+ VHYT100A-DATA.CAR-NO[CNT];
	    	else
	    		VHYT100A-DATA.BUTTONTXT[CNT] = VHYT100A-DATA.CAR-NO[CNT] + VHYT100A-DATA.VAGen_ORIENTATION[CNT];
	    	end
		end
	
    	if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-01")
              
              VHYT100IS-B-PIT-01();
              
        else
            if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-02")
	            
	            VHYT100IS-B-PIT-02();
              	
	        else     	
	        	if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-03")
		            
		             VHYT100IS-B-PIT-03();
              		
		        else
		            if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-04")
			            
			            VHYT100IS-B-PIT-04();
              			
			        else     	
			        	if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-05")
				            
				            VHYT100IS-B-PIT-05();
              				
				        else
				            if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-06")
					            
					            VHYT100IS-B-PIT-06();
              					
					        end
					    end
					end
				end
		 	end
		end
	    	
        if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "ST-13")
            VHYT100IS-ST-13();
        else
            if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "RR-1BP")
                VHYT100IS-LOAD-CAR();
                VHYT100IW-RR-1BP.BUTTON-1 = VHYT100IW.BUTTON-1;
                VHYT100IW-RR-1BP.BUTTONTXT = VHYT100IW.BUTTONTXT;
                VHYT100IW-RR-1BP.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
        		VHYT100IW-RR-1BP.CAR-COLOR-B = "GREY80";
            else
            	if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "RR-2BP")
	                VHYT100IS-LOAD-CAR();
	                VHYT100IW-RR-2BP.BUTTON-1 = VHYT100IW.BUTTON-1;
	                VHYT100IW-RR-2BP.BUTTONTXT = VHYT100IW.BUTTONTXT;
	                VHYT100IW-RR-2BP.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
	        		VHYT100IW-RR-2BP.CAR-COLOR-B = "GREY80";
	            else
	                if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "S-1A")
	                    VHYT100IS-LOAD-CAR();
	                    VHYT100IW-S-1A.BUTTON-1 = VHYT100IW.BUTTON-1;
	                    VHYT100IW-S-1A.BUTTONTXT = VHYT100IW.BUTTONTXT;
	                    VHYT100IW-S-1A.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
	        			VHYT100IW-S-1A.CAR-COLOR-B = "GREY80";
	                else
	                    if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "S-1B")
	                        VHYT100IS-LOAD-CAR();
	                        VHYT100IW-S-1B.BUTTON-1 = VHYT100IW.BUTTON-1;
	                        VHYT100IW-S-1B.BUTTONTXT = VHYT100IW.BUTTONTXT;
	                        VHYT100IW-S-1B.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
	        			    VHYT100IW-S-1B.CAR-COLOR-B = "GREY80";
	        			else
	        				if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "S-1WP")
		                        VHYT100IS-LOAD-CAR();
		                        VHYT100IW-S-1WP.BUTTON-1 = VHYT100IW.BUTTON-1;
		                        VHYT100IW-S-1WP.BUTTONTXT = VHYT100IW.BUTTONTXT;
		                        VHYT100IW-S-1WP.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
		        			    VHYT100IW-S-1WP.CAR-COLOR-B = "GREY80";
		                    else
		                        if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "S-2A")
		                            VHYT100IS-LOAD-CAR();
		                            VHYT100IW-S-2A.BUTTON-1 = VHYT100IW.BUTTON-1;
		                            VHYT100IW-S-2A.BUTTONTXT = VHYT100IW.BUTTONTXT;
		                            VHYT100IW-S-2A.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
		        			    	VHYT100IW-S-2A.CAR-COLOR-B = "GREY80";
		                        else
		                            if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "S-2B")
		                                VHYT100IS-LOAD-CAR();
		                                VHYT100IW-S-2B.BUTTON-1 = VHYT100IW.BUTTON-1;
		                                VHYT100IW-S-2B.BUTTONTXT = VHYT100IW.BUTTONTXT;
		                                VHYT100IW-S-2B.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
		        			    		VHYT100IW-S-2B.CAR-COLOR-B = "GREY80";
		                            else
		                            	if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "S-2WP")
			                                VHYT100IS-LOAD-CAR();
			                                VHYT100IW-S-2WP.BUTTON-1 = VHYT100IW.BUTTON-1;
			                                VHYT100IW-S-2WP.BUTTONTXT = VHYT100IW.BUTTONTXT;
			                                VHYT100IW-S-2WP.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
			        			    		VHYT100IW-S-2WP.CAR-COLOR-B = "GREY80";
			                            else		                            	
			                                if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "S-3A")
			                                    VHYT100IS-LOAD-CAR();
			                                    VHYT100IW-S-3A.BUTTON-1 = VHYT100IW.BUTTON-1;
			                                    VHYT100IW-S-3A.BUTTONTXT = VHYT100IW.BUTTONTXT;
			                                    VHYT100IW-S-3A.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
			        			    			VHYT100IW-S-3A.CAR-COLOR-B = "GREY80";
			                                else
			                                    if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "S-3B")
			                                        VHYT100IS-LOAD-CAR();
			                                        VHYT100IW-S-3B.BUTTON-1 = VHYT100IW.BUTTON-1;
			                                        VHYT100IW-S-3B.BUTTONTXT = VHYT100IW.BUTTONTXT;
			                                        VHYT100IW-S-3B.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
			        			    			    VHYT100IW-S-3B.CAR-COLOR-B = "GREY80";
			                                    else
			                                        if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "S-3N")
			                                            VHYT100IS-LOAD-CAR();
			                                            VHYT100IW-S-3N.BUTTON-1 = VHYT100IW.BUTTON-1;
			                                            VHYT100IW-S-3N.BUTTONTXT = VHYT100IW.BUTTONTXT;
			                                            VHYT100IW-S-3N.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
			        			    			    	VHYT100IW-S-3N.CAR-COLOR-B = "GREY80";
			                                        end
			                                    end
			                                end
			                            end
		                            end
		                        end
	                        end
	                    end
	                end
	           end
            end
        end
        if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "SS-2A")
            VHYT100IS-LOAD-CAR();
            VHYT100IW-SS-2A.BUTTON-1 = VHYT100IW.BUTTON-1;
            VHYT100IW-SS-2A.BUTTONTXT = VHYT100IW.BUTTONTXT;
            VHYT100IW-SS-2A.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
        	VHYT100IW-SS-2A.CAR-COLOR-B = "GREY80";
        else
            if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "SS-2B")
                VHYT100IS-LOAD-CAR();
                VHYT100IW-SS-2B.BUTTON-1 = VHYT100IW.BUTTON-1;
                VHYT100IW-SS-2B.BUTTONTXT = VHYT100IW.BUTTONTXT;
                VHYT100IW-SS-2B.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
        		VHYT100IW-SS-2B.CAR-COLOR-B = "GREY80";
            else
                if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "SS-4A")
                    VHYT100IS-LOAD-CAR();
                    VHYT100IW-SS-4A.BUTTON-1 = VHYT100IW.BUTTON-1;
                    VHYT100IW-SS-4A.BUTTONTXT = VHYT100IW.BUTTONTXT;
                    VHYT100IW-SS-4A.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
        			VHYT100IW-SS-4A.CAR-COLOR-B = "GREY80";
                else
                    if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "SS-4B")
                        VHYT100IS-LOAD-CAR();
                        VHYT100IW-SS-4B.BUTTON-1 = VHYT100IW.BUTTON-1;
			VHYT100IW-SS-4B.BUTTONTXT = VHYT100IW.BUTTONTXT;
                        VHYT100IW-SS-4B.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
        				VHYT100IW-SS-4B.CAR-COLOR-B = "GREY80";
                    else
                        if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "SS-3A")
                            VHYT100IS-LOAD-CAR();
                            VHYT100IW-SS-3A.BUTTON-1 = VHYT100IW.BUTTON-1;
                            VHYT100IW-SS-3A.BUTTONTXT = VHYT100IW.BUTTONTXT;
                            VHYT100IW-SS-3A.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
        				    VHYT100IW-SS-3A.CAR-COLOR-B = "GREY80";
                        else
                            if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "SS-3B")
