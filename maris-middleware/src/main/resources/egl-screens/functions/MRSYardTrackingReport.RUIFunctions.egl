            VHYT53IW-INCLUDE.VEH-STAT-X[5] = VHYT53B_DATA.VEH-STAT-5[SELECTION-IDX];
            VHYT53IW-INCLUDE.VEH-STAT-X[6] = VHYT53B_DATA.VEH-STAT-6[SELECTION-IDX];
            VHYT53IW-INCLUDE.VEH-STAT-X[7] = VHYT53B_DATA.VEH-STAT-7[SELECTION-IDX];
            VHYT53IW-INCLUDE.VEH-STAT-X[8] = VHYT53B_DATA.VEH-STAT-8[SELECTION-IDX];
            VHYT53IW-INCLUDE.VEH-STAT-X[9] = VHYT53B_DATA.VEH-STAT-9[SELECTION-IDX];
            VHYT53IW-INCLUDE.VEH-STAT-X[10] = VHYT53B_DATA.VEH-STAT-10[SELECTION-IDX];
            if (VHYT53IW-INCLUDE.CON-IND == "C" || VHYT53IW-INCLUDE.CON-IND == "D")
                VHYT53IW-TRIGGER.ENABLE-RESET = "Y";
            else
                VHYT53IW-TRIGGER.DISABLE-RESET = "Y";
            end
            if (VHYT53IW-INCLUDE.TRAIN-INCD-IND-X[1] == "Y")
                VHYT53IW-MSG.FINAL-MESSAGE = "Train has incident.  Press INCLUDE if you still want this train  ";
                VHYT53IW-TRIGGER.DISABLE-INCLUDE = "Y";
            else
                VHYT53IW-TRIGGER.ENABLE-INCLUDE = "Y";
                VHYT53IW-TRIGGER.INCLUDE-SETFOCUS = "Y";
            end
            VHYT53IW.ROW-INDEX = VHYT53IW.SELECTION-IDX;
            LOAD-CAR-DATA2 = "Y";
        else
            if (VHYT53IW.SELECTION-IDX == 0)
                VHYT53IW.TEMP-SEL = 0;
                VHYT53IW.ROW-INDEX = 1;
            end
        end
    else
        VHYT53IW-TRIGGER.NEW-WIDGET = "N";
    end
end 

Function VHYT53IS-VALID () 
    VHYT53IW-MSG.FINAL-MESSAGE = " ";
    ERROR-CNT = 0;
    if (VHYT53IW-NEW-CON.LAST-POSN < 2)
        ERROR-CNT = ERROR-CNT + 1;
        VHYT53IW-MSG.FINAL-MESSAGE = "Pseudo has less than 2 Car.  Please Add more car";
    else
        if (VHYT53IW-NEW-CON.CON-NO is numeric)
            if (VHYT53IW-NEW-CON.CON-NO-N > 99 &&
             VHYT53IW-NEW-CON.CON-NO-N < 1000)
                VHYT53L_CRIT.CON-NO = VHYT53IW-NEW-CON.CON-NO;
                VHYT53L_DATA.VALID-IND = "C";
                try
                    call "VHYT53L"(XDCONTROL, VHYT53L_CRIT, VHYT53L_DATA);
                
                end
                if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
                    if (VHYT53L_DATA.CON-ERR == "Y")
                        VHYT53IW-MSG.PROMPT-MSG-A = " ";
                        VHYT53IW-MSG.PROMPT-MSG-A-1 = "  Train ";
                        VHYT53IW-MSG.PROMPT-MSG-A-2 = VHYT53IW-NEW-CON.CON-NO;
                        VHYT53IW-MSG.PROMPT-MSG-A-3 = " already exists in ";
                        VHYT53IW-MSG.PROMPT-MSG-A-4 = VHYT53L_DATA.YRD-TRKG-YRD;
                        VHYT53IW-MSG.PROMPT-MSG-A-5 = " yard.";
                        VHYT53IW-MSG.PROMPT-MSG-A-6 = "Please enter another train number.";
                        VHYT53IW-TRIGGER.CON-NO-SETFOCUS = "Y";
                        VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.PROMPT-MSG-A;
                        ERROR-CNT = ERROR-CNT + 1;
                    end
                else
                    if ((XDCONTROL.URC == 100))
                        if (VHYT53L_DATA.CON-ERR == "N")
                            VHYT53IS-VALID-CRS();
                        end
                    else
     
        
                        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    end
                end
            else
  
                ERROR-CNT = ERROR-CNT + 1;
                ER-CAR-NO[ERROR-CNT] = VHYT53IW-NEW-CON.CON-NO;
                ER-DESC[ERROR-CNT] = "-Con No out of range.";
                VHYT53IW-TRIGGER.CON-ERROR = "Y";
                VHYT53IS-MOVE-MSG();
            end
        else
            ERROR-CNT = ERROR-CNT + 1;
            ER-CAR-NO[ERROR-CNT] = VHYT53IW-NEW-CON.CON-NO;
            ER-DESC[ERROR-CNT] = "-Con No is not numeric.";
            VHYT53IW-TRIGGER.CON-ERROR = "Y";
            VHYT53IS-MOVE-MSG();
        end
    end
end 

Function VHYT53IS-VALID-CR2 () 
    ERROR-CNT = 0;
    VHYT53IW-CNT.XX = 1;
    while (VHYT53IW-CNT.XX <= VHYT53IW-NEW-CON.LAST-POSN)
        VHYT53IW-VALID.CAR-NO = VHYT53IW-NEW-CON.CAR-NO[XX];
        VHYT53IW-VALID.VAGen_COLOR = VHYT53IW-NEW-CON.COLOR-N[XX];
        VHYT53IW-VALID.CAR-TYPE = VHYT53IW-NEW-CON.CAR-TYPE-N[XX];
        VHYT53IW-VALID.ATO-PRESENT-IND = VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[XX];
        if (VHYT53IW-CNT.XX == 1 || VHYT53IW-CNT.XX == VHYT53IW-NEW-CON.LAST-POSN)

        else
            VHYT53IS-VALID-MI2();
        end
        VHYT53IW-CNT.XX = VHYT53IW-CNT.XX + 1;
    end
end 

Function VHYT53IS-VALID-CRS () 
    ERROR-CNT = 0;
    VHYT53IW-CNT.XX = 1;
    while (VHYT53IW-CNT.XX <= VHYT53IW-NEW-CON.LAST-POSN)
        VHYT53IW-VALID.CAR-NO = VHYT53IW-NEW-CON.CAR-NO[XX];
        VHYT53IW-VALID.VAGen_COLOR = VHYT53IW-NEW-CON.COLOR-N[XX];
        VHYT53IW-VALID.CAR-TYPE = VHYT53IW-NEW-CON.CAR-TYPE-N[XX];
        VHYT53IW-VALID.ATO-PRESENT-IND = VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[XX];
        VHYT53IW-VALID.TRAIN-INCD-IND = VHYT53IW-NEW-CON.TRAIN-INCD-IND-N[XX];
        if (VHYT53IW-CNT.XX == 1 || VHYT53IW-CNT.XX == VHYT53IW-NEW-CON.LAST-POSN)
            if (VHYT53IW-CNT.XX == 1)
                VHYT53IW-VALID.VAGen_ORIENTATION = VHYT53IW-NEW-CON.LFT-OR[XX];
            else
                VHYT53IW-VALID.VAGen_ORIENTATION = VHYT53IW-NEW-CON.RGT-OR[XX];
            end
            VHYT53IS-VALID-END();
        else
            VHYT53IS-VALID-MID();
        end
        VHYT53IW-CNT.XX = VHYT53IW-CNT.XX + 1;
    end
end 

Function VHYT53IS-VALID-END ()
   

    if (VHYT53IW-VALID.CAR-TYPE != "A1" &&
     VHYT53IW-VALID.CAR-TYPE != "A2" &&
     VHYT53IW-VALID.CAR-TYPE != "C1" &&
     VHYT53IW-VALID.CAR-TYPE != "C2" &&
     VHYT53IW-VALID.CAR-TYPE != "D1" &&
     VHYT53IW-VALID.CAR-TYPE != "L1")
        ERROR-CNT = ERROR-CNT + 1;
        ER-CAR-NO[ERROR-CNT] = VHYT53IW-VALID.CAR-NO;
        ER-DESC[ERROR-CNT] = "-Invalid type for end car.";
    else
        if ((VHYT53IW-VALID.CAR-TYPE == "C1" ||
         VHYT53IW-VALID.CAR-TYPE == "C2" ||
		     VHYT53IW-VALID.CAR-TYPE == "D1" ||
		     VHYT53IW-VALID.CAR-TYPE == "L1") &&
         (VHYT53IW-VALID.ATO-PRESENT-IND != "Y"))
            ERROR-CNT = ERROR-CNT + 1;
            ER-CAR-NO[ERROR-CNT] = VHYT53IW-VALID.CAR-NO;
            ER-DESC[ERROR-CNT] = "-Invalid type for end car.";
        else
            if (VHYT53IW-VALID.TRAIN-INCD-IND == "Y")
                ERROR-CNT = ERROR-CNT + 1;
                ER-CAR-NO[ERROR-CNT] = VHYT53IW-VALID.CAR-NO;
                ER-DESC[ERROR-CNT] = "-Train Incident.";
            else
                if (VHYT53IW-VALID.VAGen_COLOR == "RED")
                    ERROR-CNT = ERROR-CNT + 1;
                    ER-CAR-NO[ERROR-CNT] = VHYT53IW-VALID.CAR-NO;
                    ER-DESC[ERROR-CNT] = "-Not servicable.";
                else
                    if (VHYT53IW-VALID.VAGen_ORIENTATION == " ")
                        ERROR-CNT = ERROR-CNT + 1;
                        ER-CAR-NO[ERROR-CNT] = VHYT53IW-VALID.CAR-NO;
                        ER-DESC[ERROR-CNT] = "-Invalid orientation.";
                    end
                end
            end
        end
    end
end 

Function VHYT53IS-VALID-MI2 ()
   

    if (VHYT53IW-VALID.CAR-TYPE != "B1" &&
     VHYT53IW-VALID.CAR-TYPE != "B2" &&
     VHYT53IW-VALID.CAR-TYPE != "C1" &&
     VHYT53IW-VALID.CAR-TYPE != "C2" &&
     VHYT53IW-VALID.CAR-TYPE != "D1" &&
     VHYT53IW-VALID.CAR-TYPE != "E1" &&
     VHYT53IW-VALID.CAR-TYPE != "L1" &&
     VHYT53IW-VALID.CAR-TYPE != "M1" &&     
     VHYT53IW-VALID.CAR-TYPE != "K1" &&
     VHYT53IW-VALID.CAR-TYPE != "K2")
        ERROR-CNT = ERROR-CNT + 1;
        ER-CAR-NO[ERROR-CNT] = VHYT53IW-VALID.CAR-NO;
        ER-DESC[ERROR-CNT] = "-Invalid car type.";
    end
end 

