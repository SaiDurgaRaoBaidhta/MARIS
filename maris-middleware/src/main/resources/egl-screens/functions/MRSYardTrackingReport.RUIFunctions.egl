Function VHIC02IS-CLICK () 
    VHIC02IW-MOVE.CLICKED = VHIC02IW-MOVE.CLICKED + 1;
    if (VHIC02IW-MOVE.CLICKED == 1)
        VHIC02IW-MOVE.FIRST-CLICK = VHIC02IW-PARM.TRACK-NO;
        VHIC02IW-PASSVALUE.FROM-CAR-POSN = VHIC02IW-PARM.POSN;
        VHIC02IW-PASSVALUE.TO-CAR-POSN = VHIC02IW-PARM.POSN;
        VHIC02IW-PASSVALUE.FROM-YRD-SUB-LOC = VHIC02IW-PARM.TRACK-NO;
    else
        if (VHIC02IW-MOVE.CLICKED == 2)
            VHIC02IW-MOVE.SECOND-CLICK = VHIC02IW-PARM.TRACK-NO;
            if (VHIC02IW-MOVE.FIRST-CLICK == VHIC02IW-MOVE.SECOND-CLICK)
                VHIC02IW-PASSVALUE.TO-CAR-POSN = VHIC02IW-PARM.POSN;
            end
        else
            if (VHIC02IW-MOVE.CLICKED == 3)
                VHIC02IW-MOVE.THIRD-CLICK = VHIC02IW-PARM.TRACK-NO;
                VHIC02IW-PASSVALUE.TO-YRD-SUB-LOC = VHIC02IW-PARM.TRACK-NO;
                VHIC02IW-TRIGGER.OPEN-DETAIL = "Y";
            end
        end
    end
end 

Function VHIC02IS-DETAIL () 
    VHIC02IW-PASSVALUE.YRD-TRKG-YRD = "SVB";
    VHIC02IW-PASSVALUE.FROM-YRD-SUB-LOC = VHIC02IW-PARM.TRACK-LOC;
end 

Function VHIC02IS-INIT () 
    VHIC02IS-CLEAR-OR();
    set VHIC02IW-MOVE empty;
    VHIC02IW-MOVE.CLICKED = 0;
    set VHIC02IW-PASSVALUE empty;
    VHIC02IW-PASSVALUE.YRD-TRKG-YRD = "SVB";
    VHIC01A_CRIT.YRD-TRKG-YRD = VHIC02IW-PASSVALUE.YRD-TRKG-YRD;
    VH01A02_CRIT.GUI-NAME = "VHIC02";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIC01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIC01A";

    
    try
        call "VHIC01A"(XDCONTROL, VHIC01A_CRIT, VHIC01A_DATA);
    
    end
    

   
    MRSCommonCode.XXA0IS-CHECK_EXT();

   
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHIC02IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHIC02IS-LOAD () 
    move VHIC01A_DATA.DATA_ROW to VHIC02A_DATA.DATA_ROW[1] for all;
    COUNTER = 1;
    while (VHIC02IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if (VHIC02A_DATA.YRD-SUB-LOC[COUNTER] == "S-1")
            VHIC02IS-S1();
        else
            if (VHIC02A_DATA.YRD-SUB-LOC[COUNTER] == "S-2")
                VHIC02IS-S2();
            else
	            if (VHIC02A_DATA.YRD-SUB-LOC[COUNTER] == "SSTOR1")
	                VHIC02IS-SSTOR1();
	            else
		            if (VHIC02A_DATA.YRD-SUB-LOC[COUNTER] == "SSTOR2")
		                VHIC02IS-SSTOR2();
		            else
			            if (VHIC02A_DATA.YRD-SUB-LOC[COUNTER] == "SSTOR3")
			                VHIC02IS-SSTOR3();
		            	else
				            if (VHIC02A_DATA.YRD-SUB-LOC[COUNTER] == "TM3")
				                VHIC02IS-TM3();
				            else
					            if (VHIC02A_DATA.YRD-SUB-LOC[COUNTER] == "TM4")
					                VHIC02IS-TM4();
					            end
					        end
					    end
					end
				end
			end
        end    	
    	







        COUNTER = COUNTER + 1;
    end
end 

Function VHIC02IS-MAINT () 
    VH01A02_CRIT.GUI-NAME = "VHIC02";
    MRSYardTracking.VHYT01IS-INIT-Y();
end 

Function VHIC02IS-PRINT () 
    VHIC02IW-PASSVALUE.YRD-TRKG-YRD = "SVB";
end 

Function VHIC02IS-PSEUDO () 
    set VHIC02IW-PASSVALUE empty;
    VHIC02IW-PASSVALUE.FROM-YRD-SUB-LOC = "T-95";
    VHIC02IW-PASSVALUE.YRD-TRKG-YRD = "SVB";
end 

