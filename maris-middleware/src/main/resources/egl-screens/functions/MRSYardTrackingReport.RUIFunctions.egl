                            VHYT100IW-RR-2B.BUTTONTXT = VHYT100IW.BUTTONTXT;
                            VHYT100IW-RR-2B.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
        					VHYT100IW-RR-2B.CAR-COLOR-B = "GREY80";
                        else
