     VHYT53C_DATA.VEH-STAT[Y3] != "USABLE")
        VHYT53B_DATA.COLOR-3[X] = "RED";
    else
        VHYT53B_DATA.COLOR-3[X] = "BLACK";
    end
    if (VHYT53C_DATA.VEH-STAT[Y4] != "GO    " &&
     VHYT53C_DATA.VEH-STAT[Y4] != "USABLE")
        VHYT53B_DATA.COLOR-4[X] = "RED";
    else
        VHYT53B_DATA.COLOR-4[X] = "BLACK";
    end
    if (VHYT53C_DATA.VEH-STAT[Y5] != "GO    " &&
     VHYT53C_DATA.VEH-STAT[Y5] != "USABLE")
        VHYT53B_DATA.COLOR-5[X] = "RED";
    else
        VHYT53B_DATA.COLOR-5[X] = "BLACK";
    end
    if (VHYT53C_DATA.VEH-STAT[Y6] != "GO    " &&
     VHYT53C_DATA.VEH-STAT[Y6] != "USABLE")
        VHYT53B_DATA.COLOR-6[X] = "RED";
    else
        VHYT53B_DATA.COLOR-6[X] = "BLACK";
    end
    if (VHYT53C_DATA.VEH-STAT[Y7] != "GO    " &&
     VHYT53C_DATA.VEH-STAT[Y7] != "USABLE")
        VHYT53B_DATA.COLOR-7[X] = "RED";
    else
        VHYT53B_DATA.COLOR-7[X] = "BLACK";
    end
    if (VHYT53C_DATA.VEH-STAT[Y8] != "GO    " &&
     VHYT53C_DATA.VEH-STAT[Y8] != "USABLE")
        VHYT53B_DATA.COLOR-8[X] = "RED";
    else
        VHYT53B_DATA.COLOR-8[X] = "BLACK";
    end
    if (VHYT53C_DATA.VEH-STAT[Y9] != "GO    " &&
     VHYT53C_DATA.VEH-STAT[Y9] != "USABLE")
        VHYT53B_DATA.COLOR-9[X] = "RED";
    else
        VHYT53B_DATA.COLOR-9[X] = "BLACK";
    end
    if (VHYT53C_DATA.VEH-STAT[Y10] != "GO    " &&
     VHYT53C_DATA.VEH-STAT[Y10] != "USABLE")
        VHYT53B_DATA.COLOR-10[X] = "RED";
    else
        VHYT53B_DATA.COLOR-10[X] = "BLACK";
    end
end 

Function VHYT53IS-CREATE-C () 
    set VHYT53IW-MSG empty;
    VHYT53F_CRIT.CAR-NO-ROW = VHYT53IW-NEW-CON.CAR-NO-ROW;
    VHYT53F_CRIT.YRD-TRKG-YRD = VHYT53IW.YRD-TRKG-YRD;
    VHYT53F_DATA.NUM-OF-CAR = VHYT53IW-NEW-CON.MAX-NUM-CAR;
    if (VHYT53IW-NEW-CON.CON-NO == " ")
        VHYT53IW-MSG.FINAL-MESSAGE = " Please Enter new CON NO before create a Pseudo";
        VHYT53IW-TRIGGER.CON-NO-SETFOCUS = "Y";
    else
        VHYT53IS-VALID();
        if (ERROR-CNT == 0)
            VHYT53F_DATA.NEW-CON-NO = VHYT53IW-NEW-CON.CON-NO;
            VHYT53F_DATA.TERM-LAST-UPD = VHYT53IW-PASSVALUE.TERM-LAST-UPD;
            VHYT53F_DATA.USER-GROUP = VHYT53IW-PASSVALUE.USER-GROUP;
            try
                call "VHYT53F"(XDCONTROL, VHYT53F_CRIT, VHYT53F_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHYT53IW-TRIGGER.CREATED = "Y";
                VHYT53IW-MSG.FINAL-MSG-1 = VHYT53F_DATA.NEW-CON-NO;
                VHYT53IW-MSG.FINAL-MSG-2 = " pseudo consist is created";
                VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.FINAL-MSG-ALL;
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
            VHYT53IW-TRIGGER.REFRESH = "Y";
        else
            VHYT53IS-MOVE-MSG();
            VHYT53IW-TRIGGER.MOVE-MSG = "Y";
        end
    end
end 

Function VHYT53IS-CREATE-P () 
    set VHYT53IW-MSG empty;
    VHYT53G_CRIT.CAR-NO-ROW = VHYT53IW-NEW-CON.CAR-NO-ROW;
    VHYT53G_CRIT.YRD-TRKG-YRD = VHYT53IW.YRD-TRKG-YRD;
    VHYT53G_DATA.NUM-OF-CAR = VHYT53IW-NEW-CON.MAX-NUM-CAR;
    if (VHYT53IW-NEW-CON.CON-NO == " ")
        VHYT53IW-MSG.FINAL-MESSAGE = " Please Enter new CON NO before create a partial Pseudo";
        VHYT53IW-TRIGGER.CON-NO-SETFOCUS = "Y";
    else
        VHYT53IS-VALID2();
        if (ERROR-CNT == 0)
            VHYT53G_DATA.NEW-CON-NO = VHYT53IW-NEW-CON.CON-NO;
            VHYT53G_DATA.TERM-LAST-UPD = VHYT53IW-PASSVALUE.TERM-LAST-UPD;
            VHYT53G_DATA.USER-GROUP = VHYT53IW-PASSVALUE.USER-GROUP;
            try
                call "VHYT53G"(XDCONTROL, VHYT53G_CRIT, VHYT53G_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHYT53IW-TRIGGER.CREATED = "P";
                VHYT53IW-MSG.FINAL-MSG-1 = VHYT53G_DATA.NEW-CON-NO;
                VHYT53IW-MSG.FINAL-MSG-2 = " partial pseudo consist is created";
                VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.FINAL-MSG-ALL;
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
            VHYT53IW-TRIGGER.REFRESH = "Y";
        else
            VHYT53IS-MOVE-MSG();
            VHYT53IW-TRIGGER.MOVE-MSG = "Y";
        end
    end
end 

Function VHYT53IS-GET-CARS () 
    set VHYT53C_DATA empty;
    

  
  
  
  
  
    VHYT53C_CRIT.FR-YRD-TRKG-YRD = VHYT53B_CRIT.FR-YRD-TRKG-YRD;
    VHYT53C_CRIT.TO-YRD-TRKG-YRD = VHYT53B_CRIT.TO-YRD-TRKG-YRD;
    try
        call "VHYT53C"(XDCONTROL, VHYT53C_CRIT, VHYT53C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else
        if (XDCONTROL.URC == 100)
            VHYT53IW-MSG.FINAL-MSG-1 = VHYT53C_CRIT.FR-YRD-TRKG-YRD;
            VHYT53IW-MSG.FINAL-MSG-2 = " Yard has no consist";
            VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.FINAL-MSG-ALL;
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

Function VHYT53IS-GET-DATA () 
    set VHYT53B_DATA empty;
    set VHYT53IW-MSG empty;
    VHYT53IW-TRIGGER.DATA-MOVED = "N";
    VHYT53B_CRIT.FR-YRD-TRKG-YRD = VHYT53IW.YRD-TRKG-YRD;
    VHYT53B_CRIT.TO-YRD-TRKG-YRD = VHYT53IW.YRD-TRKG-YRD;
    try
        call "VHYT53B"(XDCONTROL, VHYT53B_CRIT, VHYT53B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT53IW-CNT.CON-ROW-CNT = XDCONTROL.UROWCNT;
        VHYT53IS-GET-CARS();
        VHYT53IS-MOVE-DATA();
        if (VHYT53IW-TRIGGER.DATA-MOVED == "Y")
            if (VHYT53IW-TRIGGER.CREATED == "Y")
                VHYT53IW-MSG.FINAL-MSG-1 = VHYT53F_DATA.NEW-CON-NO;
                VHYT53IW-MSG.FINAL-MSG-2 = " Pseudo Consist is created";
                VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.FINAL-MSG-ALL;
                VHYT53IW-TRIGGER.CREATED = "N";
            else
                if (VHYT53IW-TRIGGER.CREATED == "P")
                    VHYT53IW-MSG.FINAL-MSG-1 = VHYT53G_DATA.NEW-CON-NO;
                    VHYT53IW-MSG.FINAL-MSG-2 = " Partial Pseudo Consist is created";
                    VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.FINAL-MSG-ALL;
                    VHYT53IW-TRIGGER.CREATED = "N";
                else
                    VHYT53IW-MSG.FINAL-MSG-1 = VHYT53IW.YRD-TRKG-YRD;
                    VHYT53IW-MSG.FINAL-MSG-2 = " Yard is selected. Please enter new Pseudo ";
                    VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.FINAL-MSG-ALL;
                end
            end
        end
    else
        if (XDCONTROL.URC == 100)
            VHYT53IW-MSG.FINAL-MSG-1 = VHYT53B_CRIT.FR-YRD-TRKG-YRD;
            VHYT53IW-MSG.FINAL-MSG-2 = " Yard has no consist.  Please select car from track";
            VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.FINAL-MSG-ALL;
            set VHYT53IW-CNT empty;
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

Function VHYT53IS-INCLUDE () 
    VHYT53IW-MSG.FINAL-MESSAGE = " ";
    if (VHYT53IW.CAR-INDEX == 0)
        VHYT53IW.CAR-INDEX = 1;
    end
    VHYT53IW-CNT.Z = VHYT53IW.CAR-INDEX;
    VHYT53IW-INCLUDE.LAST-CAR-POSN = VHYT53IW-INCLUDE.NUM-OF-CARS + (VHYT53IW.CAR-INDEX - 1);
    if (VHYT53IW-INCLUDE.LAST-CAR-POSN > VHYT53B_DATA.MAX-POSN-NO[ROW-INDEX])
        VHYT53IW-MSG.FINAL-MESSAGE = "Num of cars requested exceeds the length of Pseudo train selected";
    else
        VHYT53IW-NEW-CON.SAVE-NUM = VHYT53IW-NEW-CON.MAX-NUM-CAR;
        VHYT53IW-NEW-CON.MAX-NUM-CAR = VHYT53IW-NEW-CON.MAX-NUM-CAR + VHYT53IW-INCLUDE.NUM-OF-CARS;
        VHYT53IW-NEW-CON.LAST-POSN = LAST-POSN + 1;
        if (MAX-NUM-CAR > 10)
            VHYT53IW-MSG.FINAL-MESSAGE = "New Pseudo has more than 10 cars.  Please re-select car(s)";
            VHYT53IW-NEW-CON.MAX-NUM-CAR = VHYT53IW-NEW-CON.SAVE-NUM;
            VHYT53IW-TRIGGER.NUM-CAR-SETFOCUS = "Y";
        else
            VHYT53IS-CHK-CAR();
            if (VHYT53IW.CAR-EXIST == "Y")
                FINAL-MESSAGE = "Car(s) already exist in the new pseudo train. Please check and re-select";
                VHYT53IW-NEW-CON.MAX-NUM-CAR = VHYT53IW-NEW-CON.SAVE-NUM;
                VHYT53IW-TRIGGER.INCLUDE-CAR-SETFOCUS = "Y";
            else
                while (Z <= VHYT53IW-INCLUDE.LAST-CAR-POSN)
                    VHYT53IW-NEW-CON.CAR-NO-N[LAST-POSN] = VHYT53IW-INCLUDE.CAR-NO-X[Z];
                    VHYT53IW-NEW-CON.COLOR-N[LAST-POSN] = VHYT53IW-INCLUDE.COLOR-X[Z];
                    VHYT53IW-NEW-CON.CAR-TYPE-N[LAST-POSN] = VHYT53IW-INCLUDE.CAR-TYPE-X[Z];
                    VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[LAST-POSN] = VHYT53IW-INCLUDE.ATO-PRESENT-IND-X[Z];
                    VHYT53IW-NEW-CON.TRAIN-INCD-IND-N[LAST-POSN] = VHYT53IW-INCLUDE.TRAIN-INCD-IND-X[Z];
                    VHYT53IW-NEW-CON.VEH-STAT-N[LAST-POSN] = VHYT53IW-INCLUDE.VEH-STAT-X[Z];
                    Z = Z + 1;
                    LAST-POSN = LAST-POSN + 1;
                end
                VHYT53IW-NEW-CON.CAR-NO-1 = VHYT53IW-NEW-CON.CAR-NO-N[1];
                VHYT53IW-NEW-CON.CAR-NO-2 = VHYT53IW-NEW-CON.CAR-NO-N[2];
                VHYT53IW-NEW-CON.CAR-NO-3 = VHYT53IW-NEW-CON.CAR-NO-N[3];
                VHYT53IW-NEW-CON.CAR-NO-4 = VHYT53IW-NEW-CON.CAR-NO-N[4];
                VHYT53IW-NEW-CON.CAR-NO-5 = VHYT53IW-NEW-CON.CAR-NO-N[5];
                VHYT53IW-NEW-CON.CAR-NO-6 = VHYT53IW-NEW-CON.CAR-NO-N[6];
                VHYT53IW-NEW-CON.CAR-NO-7 = VHYT53IW-NEW-CON.CAR-NO-N[7];
                VHYT53IW-NEW-CON.CAR-NO-8 = VHYT53IW-NEW-CON.CAR-NO-N[8];
                VHYT53IW-NEW-CON.CAR-NO-9 = VHYT53IW-NEW-CON.CAR-NO-N[9];
                VHYT53IW-NEW-CON.CAR-NO-10 = VHYT53IW-NEW-CON.CAR-NO-N[10];
                VHYT53IW-NEW-CON.COLOR-1 = VHYT53IW-NEW-CON.COLOR-N[1];
                VHYT53IW-NEW-CON.COLOR-2 = VHYT53IW-NEW-CON.COLOR-N[2];
                VHYT53IW-NEW-CON.COLOR-3 = VHYT53IW-NEW-CON.COLOR-N[3];
                VHYT53IW-NEW-CON.COLOR-4 = VHYT53IW-NEW-CON.COLOR-N[4];
                VHYT53IW-NEW-CON.COLOR-5 = VHYT53IW-NEW-CON.COLOR-N[5];
                VHYT53IW-NEW-CON.COLOR-6 = VHYT53IW-NEW-CON.COLOR-N[6];
                VHYT53IW-NEW-CON.COLOR-7 = VHYT53IW-NEW-CON.COLOR-N[7];
                VHYT53IW-NEW-CON.COLOR-8 = VHYT53IW-NEW-CON.COLOR-N[8];
                VHYT53IW-NEW-CON.COLOR-9 = VHYT53IW-NEW-CON.COLOR-N[9];
                VHYT53IW-NEW-CON.COLOR-10 = VHYT53IW-NEW-CON.COLOR-N[10];
                VHYT53IW-NEW-CON.COLOR-B-1 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-2 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-3 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-4 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-5 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-6 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-7 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-8 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-9 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-10 = "GREY";
            end
        end
    end
    move MAX-NUM-CAR to LAST-POSN withV60Compat;
    set VHYT53IW-INCLUDE empty;
    CAR-ROW-CNT2 = 0;
    LOAD-CAR-DATA2 = "Y";
    VHYT53IW.CAR-INDEX = 0;
end 

Function VHYT53IS-INIT () 
    set VHYT53IW-MSG empty;
    set VHYT53IW empty;
    set VHYT53IW-CNT empty;
    set VHYT53IW-NEW-CON empty;
    set VHYT53IW-INCLUDE empty;
    set VHYT53IW-ADD empty;
    set VHYT53IW-CLICK empty;
    set VHYT53IW-MOVE empty;
    VHYT53IW.BEFORE-AFTER = 0;

  
    LOAD-CAR-DATA2 = "Y";
    DISABLE-RESET = "Y";
    NEW-PSEUDO-SETFOCUS = "Y";

  

  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
    if (VHYT53IW-PASSVALUE.YRD-TRKG-YRD != "  ")
        VHYT53IW.YRD-TRKG-YRD = VHYT53IW-PASSVALUE.YRD-TRKG-YRD;
        VHYT53IS-INIT2();
        VHYT53IW-TRIGGER.GET-DATA = "Y";
    end
end 

Function VHYT53IS-INIT2 () 
    VHYT53D_CRIT.YRD-TRKG-YRD = VHYT53IW.YRD-TRKG-YRD;
    try
        call "VHYT53D"(XDCONTROL, VHYT53D_CRIT, VHYT53D_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT53IW-CNT.TRKG-ROW-CNT = XDCONTROL.UROWCNT + 1;
        VHYT53D_DATA.YRD-SUB-LOC[TRKG-ROW-CNT] = "ALL";
        VHYT53IW-TRIGGER.LOAD-TRKG-DATA = "Y";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

Function VHYT53IS-INIT3 () 
    if (VHYT53IW.YRD-SUB-LOC == "ALL")
        VHYT53E_CRIT.FR-YRD-SUB-LOC = "           ";
        VHYT53E_CRIT.TO-YRD-SUB-LOC = "9999999999";
    else
        VHYT53E_CRIT.FR-YRD-SUB-LOC = VHYT53IW.YRD-SUB-LOC;
        VHYT53E_CRIT.TO-YRD-SUB-LOC = VHYT53IW.YRD-SUB-LOC;
    end
    VHYT53E_CRIT.YRD-TRKG-YRD = VHYT53IW.YRD-TRKG-YRD;
    
  
    try
        call "VHYT53E"(XDCONTROL, VHYT53E_CRIT, VHYT53E_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT53IW-CNT.CAR-ROW-CNT = XDCONTROL.UROWCNT;
        VHYT53IW-TRIGGER.LOAD-CAR-DATA = "Y";
        VHYT53IW.CAR-INDEX2 = 1;
    else
        if (XDCONTROL.URC == 100)
            VHYT53IW-CNT.CAR-ROW-CNT = 0;
            VHYT53IW-TRIGGER.LOAD-CAR-DATA = "Y";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
    VHYT53IW-ADD.NUM-OF-CARS = VHYT53IW-CNT.CAR-ROW-CNT;
    VHYT53IW-TRIGGER.ADD-SETFOCUS = "Y";
end 

Function VHYT53IS-INIT4 () 
    if (VHYT53IW.YRD-SUB-LOC1 == "ALL")
        VHYT53M_CRIT.FR-YRD-SUB-LOC = "           ";
        VHYT53M_CRIT.TO-YRD-SUB-LOC = "9999999999";
    else
        VHYT53M_CRIT.FR-YRD-SUB-LOC = VHYT53IW.YRD-SUB-LOC1;
        VHYT53M_CRIT.TO-YRD-SUB-LOC = VHYT53IW.YRD-SUB-LOC1;
    end
    VHYT53M_CRIT.YRD-TRKG-YRD = VHYT53IW.YRD-TRKG-YRD;
    
  
    try
        call "VHYT53M"(XDCONTROL, VHYT53M_CRIT, VHYT53M_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT53IW-CNT.CAR-ROW-CNT3 = XDCONTROL.UROWCNT;
        VHYT53IW-TRIGGER.LOAD-CAR-DATA3 = "Y";
        VHYT53IW.CAR-INDEX3 = 1;
    else
        if (XDCONTROL.URC == 100)
            VHYT53IW-CNT.CAR-ROW-CNT3 = 0;
            VHYT53IW-TRIGGER.LOAD-CAR-DATA3 = "Y";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
    VHYT53IW-ADD.NUM-OF-CARS = VHYT53IW-CNT.CAR-ROW-CNT;
    VHYT53IW-TRIGGER.ADD-SETFOCUS = "Y";
end 

Function VHYT53IS-INSERT () 
    VHYT53IW-MSG.FINAL-MESSAGE = "  ";
    if (VHYT53IW.CAR-INDEX3 == 0)
        VHYT53IW.CAR-INDEX3 = 1;
    end
    VHYT53IW-CNT.Z = VHYT53IW.CAR-INDEX3;
    if (VHYT53M_DATA.CAR-AND-OR[Z] in VHYT53IW-NEW-CON.CAR-NO-N)
        VHYT53IW-MSG.FINAL-MESSAGE = "Car already exits in the New Con.  Please select another Car to insert. ";
    else
        if (MAX-NUM-CAR <= 9)
            if (SELECT-CAR > 0)
                if (VHYT53IW.BEFORE-AFTER == 1)
                    VHYT53IS-INSERT-B();
                    VHYT53IS-INSERT-X();
                else
                    if (VHYT53IW.BEFORE-AFTER == 2)
                        VHYT53IS-INSERT-A();
                        VHYT53IS-INSERT-X();
                    else
                        VHYT53IW-MSG.FINAL-MESSAGE = " Please Click before or after radio button before insert a car ";
                    end
                end
            else
                VHYT53IW-MSG.FINAL-MESSAGE = "No car selected.  Please select a car that you want to insert a new car before or after it";
            end
        else
            VHYT53IW-MSG.FINAL-MESSAGE = "New Consist already has 10 cars.  Car can not be inserted ";
        end
    end
end 

Function VHYT53IS-INSERT-A () 
    VHYT53IW-INSERT.INSERT-POSN = SELECT-CAR + 1;
    move MAX-NUM-CAR to XX withV60Compat;
    VHYT53IW-CNT.Z = VHYT53IW.CAR-INDEX3;
    while (XX >= INSERT-POSN)
        XY = XX + 1;
        VHYT53IW-NEW-CON.CAR-NO-N[XY] = VHYT53IW-NEW-CON.CAR-NO-N[XX];
        VHYT53IW-NEW-CON.CAR-TYPE-N[XY] = VHYT53IW-NEW-CON.CAR-TYPE-N[XX];
        VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[XY] = VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[XX];
        VHYT53IW-NEW-CON.TRAIN-INCD-IND-N[XY] = VHYT53IW-NEW-CON.TRAIN-INCD-IND-N[XX];
        VHYT53IW-NEW-CON.VEH-STAT-N[XY] = VHYT53IW-NEW-CON.VEH-STAT-N[XX];
        VHYT53IW-NEW-CON.COLOR-N[XY] = VHYT53IW-NEW-CON.COLOR-N[XX];
        XX = XX - 1;
    end
    VHYT53IW-NEW-CON.CAR-NO-N[INSERT-POSN] = VHYT53M_DATA.CAR-AND-OR[Z];
    VHYT53IW-NEW-CON.CAR-TYPE-N[INSERT-POSN] = VHYT53M_DATA.CAR-TYPE[Z];
    VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[INSERT-POSN] = VHYT53M_DATA.ATO-PRESENT-IND[Z];
    VHYT53IW-NEW-CON.TRAIN-INCD-IND-N[INSERT-POSN] = VHYT53M_DATA.TRAIN-INCD-IND[Z];
    VHYT53IW-NEW-CON.VEH-STAT-N[INSERT-POSN] = VHYT53M_DATA.VEH-STAT[Z];
    if (VHYT53M_DATA.VEH-STAT[Z] != "GO    " &&
     VHYT53M_DATA.VEH-STAT[Z] != "USABLE")
        VHYT53IW-NEW-CON.COLOR-N[INSERT-POSN] = "RED";
    else
        VHYT53IW-NEW-CON.COLOR-N[INSERT-POSN] = "BLACK";
    end
    MAX-NUM-CAR = MAX-NUM-CAR + 1;
end 

Function VHYT53IS-INSERT-B () 
    VHYT53IW-INSERT.INSERT-POSN = SELECT-CAR;
    move MAX-NUM-CAR to XX withV60Compat;
    VHYT53IW-CNT.Z = VHYT53IW.CAR-INDEX3;
    while (XX >= SELECT-CAR)
        XY = XX + 1;
        VHYT53IW-NEW-CON.CAR-NO-N[XY] = VHYT53IW-NEW-CON.CAR-NO-N[XX];
        VHYT53IW-NEW-CON.CAR-TYPE-N[XY] = VHYT53IW-NEW-CON.CAR-TYPE-N[XX];
        VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[XY] = VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[XX];
        VHYT53IW-NEW-CON.TRAIN-INCD-IND-N[XY] = VHYT53IW-NEW-CON.TRAIN-INCD-IND-N[XX];
        VHYT53IW-NEW-CON.VEH-STAT-N[XY] = VHYT53IW-NEW-CON.VEH-STAT-N[XX];
        VHYT53IW-NEW-CON.COLOR-N[XY] = VHYT53IW-NEW-CON.COLOR-N[XX];
        XX = XX - 1;
    end
    VHYT53IW-NEW-CON.CAR-NO-N[INSERT-POSN] = VHYT53M_DATA.CAR-AND-OR[Z];
    VHYT53IW-NEW-CON.CAR-TYPE-N[INSERT-POSN] = VHYT53M_DATA.CAR-TYPE[Z];
    VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[INSERT-POSN] = VHYT53M_DATA.ATO-PRESENT-IND[Z];
    VHYT53IW-NEW-CON.TRAIN-INCD-IND-N[INSERT-POSN] = VHYT53M_DATA.TRAIN-INCD-IND[Z];
    VHYT53IW-NEW-CON.VEH-STAT-N[INSERT-POSN] = VHYT53M_DATA.VEH-STAT[Z];
    if (VHYT53M_DATA.VEH-STAT[Z] != "GO    " &&
     VHYT53M_DATA.VEH-STAT[Z] != "USABLE")
        VHYT53IW-NEW-CON.COLOR-N[INSERT-POSN] = "RED";
    else
        VHYT53IW-NEW-CON.COLOR-N[INSERT-POSN] = "BLACK";
    end
    MAX-NUM-CAR = MAX-NUM-CAR + 1;
end 

Function VHYT53IS-INSERT-X () 
    set VHYT53IW-CLICK empty;
    set VHYT53IW-MOVE empty;
    VHYT53IW-NEW-CON.SELECT-CAR = 0;
    VHYT53IW.CAR-INDEX3 = 1;
