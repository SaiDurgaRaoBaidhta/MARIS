Function VHYT53IS-MOVE-MS2 ()
  
   
    if (ERROR-CNT > 0)
        VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG2.FINAL-MESSAGE-02;
    end
end 

Function VHYT53IS-MOVE-MSG () 
    ERROR-LOOP-INDEX = 1;
    FINAL-INDEX = 0;
    FINAL-ERROR-MSG = " ";
    TEMP-ERROR-MSG = " ";
    if (ERROR-CNT > 0)
        while (((ERROR-LOOP-INDEX <= 10) &&
         (ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX] != " ")))
            CHAR-CNT = 1;
            TEMP-ERROR-MSG = ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX];
            while ((CHAR-CNT < 32))
                if (TEMP-MSG[CHAR-CNT] != ".")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = TEMP-MSG[CHAR-CNT];
                else
                    if (TEMP-MSG[CHAR-CNT] == ".")
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = ",";
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = " ";
                        CHAR-CNT = 32;
                    end
                end
                CHAR-CNT = CHAR-CNT + 1;
            end
            ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
        end
        if (FINAL-INDEX != 0)
            FINAL-INDEX = FINAL-INDEX - 1;
            FINAL-MSG[FINAL-INDEX] = " ";
            move FINAL-ERROR-MSG to FINAL-MESSAGE withV60Compat;
        end
        if (VHYT53L_DATA.CON-ERR == "Y")
            CON-NO-SETFOCUS = "Y";
        end
    end
end 

