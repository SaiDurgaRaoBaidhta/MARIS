                                VHYT100IW-RR-3A.BUTTON-1 = VHYT100IW.BUTTON-1;
                                VHYT100IW-RR-3A.BUTTONTXT = VHYT100IW.BUTTONTXT;
                                VHYT100IW-RR-3A.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
