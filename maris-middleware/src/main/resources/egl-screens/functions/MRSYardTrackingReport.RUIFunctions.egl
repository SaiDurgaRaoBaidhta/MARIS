Function VHIC01IS-CLEAR () 
























end 

Function VHIC01IS-CLICK () 
    VHIC01IW-PASSVALUE.YRD-SUB-LOC = VHIC01IS-PARM.YRD-SUB-LOC;
    VHIC01IW-PASSVALUE.YRD-TRKG-YRD = "SVB";
end 

Function VHIC01IS-COLOR () 
    if (VHIC01A_DATA.HOME-YRD[COUNTER] == "HY")
        VHIC01IW-PASSVALUE.CAR-COLOR = "GREEN";
        VHIC01IW-PASSVALUE.CAR-COLOR-B = "GREY55";
    else
        if (VHIC01A_DATA.HOME-YRD[COUNTER] == "RY")
            VHIC01IW-PASSVALUE.CAR-COLOR = "DARK ORANGE";
            VHIC01IW-PASSVALUE.CAR-COLOR-B = "LIGHT YELLOW";
        else
            if (VHIC01A_DATA.HOME-YRD[COUNTER] == "CY")
                VHIC01IW-PASSVALUE.CAR-COLOR = "YELLOW";
                VHIC01IW-PASSVALUE.CAR-COLOR-B = "GREY55";
            else
                if (VHIC01A_DATA.HOME-YRD[COUNTER] == "DY")
                    VHIC01IW-PASSVALUE.CAR-COLOR = "RED";
                    VHIC01IW-PASSVALUE.CAR-COLOR-B = "LIGHT YELLOW";
                else
                    VHIC01IW-PASSVALUE.CAR-COLOR = "BLACK";
                    VHIC01IW-PASSVALUE.CAR-COLOR-B = "GREY80";
                end
            end
        end
    end
end 

Function VHIC01IS-INIT () 
    VHIC01IS-CLEAR();
    VHIC01IW-PASSVALUE.YRD-TRKG-YRD = "SVB";
    VHIC01A_CRIT.YRD-TRKG-YRD = "SVB";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHIC01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIC01A";

    
    try
        call "VHIC01A"(XDCONTROL, VHIC01A_CRIT, VHIC01A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

  
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHIC01IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHIC01IS-LOAD () 
    COUNTER = 1;
    while (VHIC01IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if (VHIC01A_DATA.YRD-SUB-LOC[COUNTER] == "S-1")
            VHIC01IS-S1();
        else
            if (VHIC01A_DATA.YRD-SUB-LOC[COUNTER] == "S-2")
                VHIC01IS-S2();
            else
	            if (VHIC01A_DATA.YRD-SUB-LOC[COUNTER] == "TM4")
	                VHIC01IS-TM4();
	            else
		            if (VHIC01A_DATA.YRD-SUB-LOC[COUNTER] == "TM3")
		                VHIC01IS-TM3();
		             else
			            if (VHIC01A_DATA.YRD-SUB-LOC[COUNTER] == "SSTOR1")
			                VHIC01IS-SSTOR1();
						else
				            if (VHIC01A_DATA.YRD-SUB-LOC[COUNTER] == "SSTOR2")
				                VHIC01IS-SSTOR2();
				            else
					            if (VHIC01A_DATA.YRD-SUB-LOC[COUNTER] == "SSTOR3")
					                VHIC01IS-SSTOR3();
						        end
						    end
						end
					end
				end
            end
        end
        COUNTER = COUNTER + 1;
    end
end 

Function VHIC01IS-PRINT () 
    VHIC01IW-PASSVALUE.YRD-TRKG-YRD = "SVB";
end 

Function VHIC01IS-PSEUDO () 
    VHIC01IW-PASSVALUE.YRD-SUB-LOC = "T-95";
end 




















































 

