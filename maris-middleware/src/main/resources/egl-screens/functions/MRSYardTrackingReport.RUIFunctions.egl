Function VHYT53IS-CAR-CN2 () 
    VHYT53IW-ADD.TOTAL-CARS = VHYT53IW-CNT.CAR-ROW-CNT;
    if (VHYT53IW.CAR-INDEX2 == 0)
        VHYT53IW.CAR-INDEX2 = 1;
    end
    VHYT53IW-ADD.NUM-OF-CARS = VHYT53IW-ADD.TOTAL-CARS - VHYT53IW.CAR-INDEX2 + 1;
    if (VHYT53E_DATA.TRAIN-INCD-IND[CAR-INDEX2] == "Y")
        VHYT53IW-MSG.FINAL-MSG-1 = VHYT53E_DATA.CAR-NO[CAR-INDEX2];
        VHYT53IW-MSG.FINAL-MSG-2 = " has train incident.  Press Add if you still want this car";
        VHYT53IW-MSG.FINAL-MESSAGE = VHYT53IW-MSG.FINAL-MSG-ALL;
    end
end 

Function VHYT53IS-CAR-CNT () 
    VHYT53IW-INCLUDE.TOTAL-CARS = VHYT53IW-CNT.CAR-ROW-CNT2;
    if (VHYT53IW.CAR-INDEX == 0)
        VHYT53IW.CAR-INDEX = 1;
    end
    VHYT53IW-INCLUDE.NUM-OF-CARS = VHYT53IW-INCLUDE.TOTAL-CARS - VHYT53IW.CAR-INDEX + 1;
end 

Function VHYT53IS-CHK-CAR () 
    VHYT53IW.CAR-EXIST = "N";
    VHYT53IW-CNT.XY = VHYT53IW.CAR-INDEX;
    while (XY <= VHYT53IW-INCLUDE.LAST-CAR-POSN)
        if (VHYT53IW-INCLUDE.CAR-NO-X[XY] in VHYT53IW-NEW-CON.CAR-NO-N)
            VHYT53IW.CAR-EXIST = "Y";
            XY = 99;
        else
            XY = XY + 1;
        end
    end
end 

Function VHYT53IS-CHK-CAR2 () 
    VHYT53IW.CAR-EXIST = "N";
    VHYT53IW-CNT.XY = VHYT53IW.CAR-INDEX2;
    while (XY <= VHYT53IW-ADD.LAST-CAR-POSN)
        if (VHYT53E_DATA.CAR-AND-OR[XY] in VHYT53IW-NEW-CON.CAR-NO-N)
            VHYT53IW.CAR-EXIST = "Y";
            XY = 99;
        else
            XY = XY + 1;
        end
    end
end 

Function VHYT53IS-CLR-NEW () 
    set VHYT53IW-NEW-CON empty;
    VHYT53IW-NEW-CON.CON-NO = " ";
    set VHYT53IW-ADD empty;
    set VHYT53IW-INCLUDE empty;
    set VHYT53IW-MSG empty;
    set VHYT53IW-MOVE empty;
    set VHYT53IW-CNT empty;
    VHYT53IW-TRIGGER.DISABLE-RESET = "Y";
    LOAD-CAR-DATA2 = "Y";
    LOAD-CAR-DATA3 = "Y";
end 

Function VHYT53IS-COLOR () 
    if (VHYT53C_DATA.VEH-STAT[Y1] != "GO    " &&
     VHYT53C_DATA.VEH-STAT[Y1] != "USABLE")
        VHYT53B_DATA.COLOR-1[X] = "RED";
    else
        VHYT53B_DATA.COLOR-1[X] = "BLACK";
    end
    if (VHYT53C_DATA.VEH-STAT[Y2] != "GO    " &&
     VHYT53C_DATA.VEH-STAT[Y2] != "USABLE")
        VHYT53B_DATA.COLOR-2[X] = "RED";
    else
        VHYT53B_DATA.COLOR-2[X] = "BLACK";
    end
