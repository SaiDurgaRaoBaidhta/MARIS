                    VHYT90IW-TR-1.BUTTON-4 = strLib.clip(txt, 0);
                end
            end
        end
    end
end 

Function VHYT91IS-CLEAR () 
    set VHYT91IW-MOVE empty;
    VHYT91IW-MOVE.CLICKED = 0;
    VHYT91IW-PASSVALUE.FROM-YRD-SUB-LOC = " ";
    VHYT91IW-PASSVALUE.TO-YRD-SUB-LOC = " ";
    VHYT91IW-PASSVALUE.TO-CAR-POSN = 0;
    VHYT91IW-PASSVALUE.FROM-CAR-POSN = 0;
end 

