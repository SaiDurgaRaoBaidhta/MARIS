Function VHYT91IS-CLICK () 
    VHYT91IW-MOVE.CLICKED = VHYT91IW-MOVE.CLICKED + 1;
    if (VHYT91IW-MOVE.CLICKED == 1)
        VHYT91IW-MOVE.FIRST-CLICK = VHYT91IW-PARM.TRACK-NO;
        VHYT91IW-PASSVALUE.FROM-CAR-POSN = VHYT91IW-PARM.POSN;
        VHYT91IW-PASSVALUE.TO-CAR-POSN = VHYT91IW-PARM.POSN;
        VHYT91IW-PASSVALUE.FROM-YRD-SUB-LOC = VHYT91IW-PARM.TRACK-NO;
    else
        if (VHYT91IW-MOVE.CLICKED == 2)
            VHYT91IW-MOVE.SECOND-CLICK = VHYT91IW-PARM.TRACK-NO;
            if (VHYT91IW-MOVE.FIRST-CLICK == VHYT91IW-MOVE.SECOND-CLICK)
                VHYT91IW-PASSVALUE.TO-CAR-POSN = VHYT91IW-PARM.POSN;
            end
        else
            if (VHYT91IW-MOVE.CLICKED == 3)
                VHYT91IW-MOVE.THIRD-CLICK = VHYT91IW-PARM.TRACK-NO;
                VHYT91IW-PASSVALUE.TO-YRD-SUB-LOC = VHYT91IW-PARM.TRACK-NO;
                VHYT91IW-TRIGGER.OPEN-DETAIL = "Y";
            end
        end
    end
end 

Function VHYT91IS-CLICK-1 () 
    VHYT91IW-MOVE.CLICKED = VHYT91IW-MOVE.CLICKED + 1;
