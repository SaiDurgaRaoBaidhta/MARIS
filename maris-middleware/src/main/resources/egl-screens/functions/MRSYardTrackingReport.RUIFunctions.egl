                                VHYT100IW-SS-3B.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
        				    	VHYT100IW-SS-3B.CAR-COLOR-B = "GREY80";
                            else
                                if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "SS-5A")
                                    VHYT100IS-LOAD-CAR();
                                    VHYT100IW-SS-5A.BUTTON-1 = VHYT100IW.BUTTON-1;
                                    VHYT100IW-SS-5A.BUTTONTXT = VHYT100IW.BUTTONTXT;
                                    VHYT100IW-SS-5A.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
