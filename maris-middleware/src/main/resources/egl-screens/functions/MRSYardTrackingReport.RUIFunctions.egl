Function VHYT90IS-CLICK () 
    VHYT90IW-PASSVALUE.YRD-SUB-LOC = VHYT90IS-PARM.YRD-SUB-LOC;
    VHYT90IW-PASSVALUE.YRD-TRKG-YRD = "RY";
end 

Function VHYT90IS-COLOR () 
    if (VHYT90A_DATA.HOME-YRD[COUNTER] == "HY")
        VHYT90IW-PASSVALUE.CAR-COLOR = "GREEN";
        VHYT90IW-PASSVALUE.CAR-COLOR-B = "GREY80";
    else
        if (VHYT90A_DATA.HOME-YRD[COUNTER] == "RY")
            VHYT90IW-PASSVALUE.CAR-COLOR = "BROWN";
            VHYT90IW-PASSVALUE.CAR-COLOR-B = "GREY80";
        else
            if (VHYT90A_DATA.HOME-YRD[COUNTER] == "CY")
                VHYT90IW-PASSVALUE.CAR-COLOR = "BLUE";
                VHYT90IW-PASSVALUE.CAR-COLOR-B = "GREY80";
            else
                if (VHYT90A_DATA.HOME-YRD[COUNTER] == "DY")
                    VHYT90IW-PASSVALUE.CAR-COLOR = "RED";
                    VHYT90IW-PASSVALUE.CAR-COLOR-B = "GREY80";
                else
                    VHYT90IW-PASSVALUE.CAR-COLOR = "BLACK";
                    VHYT90IW-PASSVALUE.CAR-COLOR-B = "GREY80";
                end
            end
        end
    end
end 

Function VHYT90IS-INIT () 
    VHYT90IS-CLEAR();
    VHYT90IW-PASSVALUE.YRD-TRKG-YRD = "RY";
    VHYT90A_CRIT.YRD-TRKG-YRD = "RY";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT90I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT90A";

    
    try
        call "VHYT90A"(XDCONTROL, VHYT90A_CRIT, VHYT90A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

  
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT90IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHYT90IS-LOAD () 
    COUNTER = 1;
    while (VHYT90IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "RR-01")
            VHYT90IS-RR-01();
        else
            if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "RR-02")
                VHYT90IS-RR-02();
            else
                if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "RR-03")
                    VHYT90IS-RR-03();
                else
                    if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "RT-91")
                        VHYT90IS-RT-91();
                    else
                        if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "RT-92")
                            VHYT90IS-RT-92();
                        else
                            if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-06")
                                VHYT90IS-ST-06();
                            else
                                if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-07")
                                    VHYT90IS-ST-07();
                                else
                                    if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-08")
                                        VHYT90IS-ST-08();
                                    else
                                        if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-09")
                                            VHYT90IS-ST-09();
                                        else
                                            if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-10")
                                                VHYT90IS-ST-10();
                                            else
                                                if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-11")
                                                    VHYT90IS-ST-11();
                                                else
                                                    if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-12")
                                                        VHYT90IS-ST-12();
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-13")
            VHYT90IS-ST-13();
        else
            if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-14")
                VHYT90IS-ST-14();
            else
                if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-15")
                    VHYT90IS-ST-15();
                else
                    if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-16")
                        VHYT90IS-ST-16();
                    else
                        if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-17")
                            VHYT90IS-ST-17();
                        else
                            if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "ST-18")
                                VHYT90IS-ST-18();
                            else 
	                            if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "TF-01")
	                                VHYT90IS-TF-01();
	                            else
	                                if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "TF-02")
	                                    VHYT90IS-TF-02();
	                                else
	                                    if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "TF-03")
	                                        VHYT90IS-TF-03();
	                                    else
	                                        if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "TF-04")
	                                            VHYT90IS-TF-04();
	                                        else
	                                            if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "TF-05")
	                                                VHYT90IS-TF-05();
	                                            end
	                                        end
	                                    end
	                                end
	                           end
                            end
                        end
                    end
                end
            end
        end
        if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "TR-1")
            VHYT90IS-TR-1();
        else
            if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "S-1")
                VHYT90IS-S-1();
            else
                if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "S-2")
                    VHYT90IS-S-2();
                else
                    if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "S-3")
                        VHYT90IS-S-3();                    
                    else
	                    if (VHYT90A_DATA.YRD-SUB-LOC[COUNTER] == "YT")
	                        VHYT90IS-YT();
	                    end
	                end
                end
            end
        end
        COUNTER = COUNTER + 1;
    end
end 

Function VHYT90IS-PRINT () 
    VHYT90IW-PASSVALUE.YRD-TRKG-YRD = "RY";
end 

Function VHYT90IS-PSEUDO () 
    VHYT90IW-PASSVALUE.YRD-SUB-LOC = "T-95";
end 

Function getButton(ORIENTAION char(1) const in , CARNO char(4) const in, SOFTVER char(4) in) returns (String)
	button string;
	isleft boolean = strLib.indexOf("<O({vblm",ORIENTAION )>0;
	txt char(6) = "      ";
	if(isleft ) txt = ORIENTAION + CARNO;
	else txt = CARNO + ORIENTAION;
	end
	if( SOFTVER != null && strLib.indexOf(SOFTVER, "$" )>0) 
		txt = "$" +strLib.clip(txt, 0);
	else 
		txt = strLib.clip(txt, 0);
	end
	return (txt);
end

