Function VHYT81IS-CLICK () 
    VHYT81IW-MOVE.CLICKED = VHYT81IW-MOVE.CLICKED + 1;
    if (VHYT81IW-MOVE.CLICKED == 1)
        VHYT81IW-MOVE.FIRST-CLICK = VHYT81IW-PARM.TRACK-NO;
        VHYT81IW-PASSVALUE.FROM-CAR-POSN = VHYT81IW-PARM.POSN;
        VHYT81IW-PASSVALUE.TO-CAR-POSN = VHYT81IW-PARM.POSN;
        VHYT81IW-PASSVALUE.FROM-YRD-SUB-LOC = VHYT81IW-PARM.TRACK-NO;
    else
        if (VHYT81IW-MOVE.CLICKED == 2)
            VHYT81IW-MOVE.SECOND-CLICK = VHYT81IW-PARM.TRACK-NO;
            if (VHYT81IW-MOVE.FIRST-CLICK == VHYT81IW-MOVE.SECOND-CLICK)
                VHYT81IW-PASSVALUE.TO-CAR-POSN = VHYT81IW-PARM.POSN;
            end
        else
            if (VHYT81IW-MOVE.CLICKED == 3)
                VHYT81IW-MOVE.THIRD-CLICK = VHYT81IW-PARM.TRACK-NO;
                VHYT81IW-PASSVALUE.TO-YRD-SUB-LOC = VHYT81IW-PARM.TRACK-NO;
                VHYT81IW-TRIGGER.OPEN-DETAIL = "Y";
            end
        end
    end
end 

Function VHYT81IS-DETAIL () 
    VHYT81IW-PASSVALUE.YRD-TRKG-YRD = "MBX";
    VHYT81IW-PASSVALUE.FROM-YRD-SUB-LOC = VHYT81IW-PARM.TRACK-LOC;
end 

Function VHYT81IS-INIT () 
    VHYT81IS-CLEAR-OR();
    set VHYT81IW-MOVE empty;
    VHYT81IW-MOVE.CLICKED = 0;
    set VHYT81IW-PASSVALUE empty;
    VHYT81IW-PASSVALUE.YRD-TRKG-YRD = "MBX";
    VHYT80A_CRIT.YRD-TRKG-YRD = VHYT81IW-PASSVALUE.YRD-TRKG-YRD;
    VH01A02_CRIT.GUI-NAME = "VHYT81";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYTX5I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYTX5A";

    
    try
        call "VHYT80A"(XDCONTROL, VHYT80A_CRIT, VHYT80A_DATA);
    
    end
    

   
    MRSCommonCode.XXA0IS-CHECK_EXT();

   
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT81IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHYT81IS-LOAD () 
    move VHYT80A_DATA.DATA_ROW to VHYT81A_DATA.DATA_ROW[1] for all;
    COUNTER = 1;
    while (VHYT81IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if (VHYT81A_DATA.YRD-SUB-LOC[COUNTER] == "TM5")
            VHYT81IS-MSTOR1();
        else
            if (VHYT81A_DATA.YRD-SUB-LOC[COUNTER] == "TM7")
                VHYT81IS-MSTOR2();
            else
                if (VHYT81A_DATA.YRD-SUB-LOC[COUNTER] == "TM4")
                    VHYT81IS-MSTOR3();
                else
                    if (VHYT81A_DATA.YRD-SUB-LOC[COUNTER] == "TM6")
                        VHYT81IS-MSTOR4();
                    else
                        if (VHYT81A_DATA.YRD-SUB-LOC[COUNTER] == "W-1")
                            VHYT81IS-W-1();
                        else
                            if (VHYT81A_DATA.YRD-SUB-LOC[COUNTER] == "W-2")
                                VHYT81IS-W-2();
                            else
                                if (VHYT81A_DATA.YRD-SUB-LOC[COUNTER] == "W-3")
                                    VHYT81IS-W-3();
                                else
                                    if (VHYT81A_DATA.YRD-SUB-LOC[COUNTER] == "Y-1")
                                        VHYT81IS-Y-1();
                                    else
                                        if (VHYT81A_DATA.YRD-SUB-LOC[COUNTER] == "Y-2")
                                            VHYT81IS-Y-2();
                                        else
                                            if (VHYT81A_DATA.YRD-SUB-LOC[COUNTER] == "Y-3")
                                                VHYT81IS-Y-3();
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        COUNTER = COUNTER + 1;
    end
end 

Function VHYT81IS-MAINT () 
    VH01A02_CRIT.GUI-NAME = "VHYT81";
    MRSYardTracking.VHYT01IS-INIT-Y();
end 

Function VHYT81IS-MAINTX () 
    VH01A02_CRIT.GUI-NAME = "VHYT91";
