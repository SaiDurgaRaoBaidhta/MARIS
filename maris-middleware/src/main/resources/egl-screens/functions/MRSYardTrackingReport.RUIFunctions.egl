Function VHYT80IS-CLICK () 
    VHYT80IW-PASSVALUE.YRD-SUB-LOC = VHYT80IS-PARM.YRD-SUB-LOC;
    VHYT80IW-PASSVALUE.YRD-TRKG-YRD = "MBX";
end 

Function VHYT80IS-COLOR () 
    if (VHYT80A_DATA.HOME-YRD[COUNTER] == "HY")
        VHYT80IW-PASSVALUE.CAR-COLOR = "GREEN";
        VHYT80IW-PASSVALUE.CAR-COLOR-B = "GREY55";
    else
        if (VHYT80A_DATA.HOME-YRD[COUNTER] == "RY")
            VHYT80IW-PASSVALUE.CAR-COLOR = "DARK ORANGE";
            VHYT80IW-PASSVALUE.CAR-COLOR-B = "LIGHT YELLOW";
        else
            if (VHYT80A_DATA.HOME-YRD[COUNTER] == "CY")
                VHYT80IW-PASSVALUE.CAR-COLOR = "YELLOW";
                VHYT80IW-PASSVALUE.CAR-COLOR-B = "GREY55";
            else
                if (VHYT80A_DATA.HOME-YRD[COUNTER] == "DY")
                    VHYT80IW-PASSVALUE.CAR-COLOR = "RED";
                    VHYT80IW-PASSVALUE.CAR-COLOR-B = "LIGHT YELLOW";
                else
                    VHYT80IW-PASSVALUE.CAR-COLOR = "BLACK";
                    VHYT80IW-PASSVALUE.CAR-COLOR-B = "GREY80";
                end
            end
        end
    end
end 

Function VHYT80IS-INIT () 
    VHYT80IS-CLEAR();
    VHYT80IW-PASSVALUE.YRD-TRKG-YRD = "MBX";
    VHYT80A_CRIT.YRD-TRKG-YRD = "MBX";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT80I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT80A";

    
    try
        call "VHYT80A"(XDCONTROL, VHYT80A_CRIT, VHYT80A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

  
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT80IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHYT80IS-LOAD () 
    COUNTER = 1;
    while (VHYT80IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if (VHYT80A_DATA.YRD-SUB-LOC[COUNTER] == "TM5")
            VHYT80IS-MSTOR1();
        else
            if (VHYT80A_DATA.YRD-SUB-LOC[COUNTER] == "TM7")
                VHYT80IS-MSTOR2();
            else
                if (VHYT80A_DATA.YRD-SUB-LOC[COUNTER] == "TM4")
                    VHYT80IS-MSTOR3();
                else
                    if (VHYT80A_DATA.YRD-SUB-LOC[COUNTER] == "TM6")
                        VHYT80IS-MSTOR4();
                    else
                        if (VHYT80A_DATA.YRD-SUB-LOC[COUNTER] == "W-3")
                            VHYT80IS-W3();
                        else
                            if (VHYT80A_DATA.YRD-SUB-LOC[COUNTER] == "W-1")
                                VHYT80IS-W1();
                            else
                                if (VHYT80A_DATA.YRD-SUB-LOC[COUNTER] == "W-2")
                                    VHYT80IS-W2();
                                else
                                    if (VHYT80A_DATA.YRD-SUB-LOC[COUNTER] == "Y-3")
                                        VHYT80IS-Y-3();
                                    else
                                        if (VHYT80A_DATA.YRD-SUB-LOC[COUNTER] == "Y-1")
                                            VHYT80IS-Y-1();
                                        else
                                            if (VHYT80A_DATA.YRD-SUB-LOC[COUNTER] == "Y-2")
                                                VHYT80IS-Y-2();
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        COUNTER = COUNTER + 1;
    end
end 

Function VHYT80IS-MSTOR1 () 
    if (VHYT80A_DATA.POSN-NO[COUNTER] == 1)
