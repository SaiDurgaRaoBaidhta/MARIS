                            VHYT53B_DATA.CAR-TYPE-3[X] = VHYT53C_DATA.CAR-TYPE[Y3];
                            VHYT53B_DATA.CAR-TYPE-4[X] = VHYT53C_DATA.CAR-TYPE[Y4];
                            VHYT53B_DATA.TRAIN-INCD-IND-1[X] = VHYT53C_DATA.TRAIN-INCD-IND[Y1];
                            VHYT53B_DATA.TRAIN-INCD-IND-2[X] = VHYT53C_DATA.TRAIN-INCD-IND[Y2];
