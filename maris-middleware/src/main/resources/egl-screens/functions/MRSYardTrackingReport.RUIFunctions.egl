Function VHYT101IS-LOAD () 
    move VHYT100A-DATA.DATA_ROW to VHYT101A-DATA.DATA_ROW[1] for all;
    CNT = 1; 
    while (VHYT101IW.CNT <= XDCONTROL.UROWCNT)   
        VHYT101A-DATA.FCOLOR[CNT] = dy100Color (VHYT101A-DATA.HOME-YRD[CNT]);
        
        
        
	    if (strLib.characterLen(VHYT101A-DATA.SOFTVER[CNT])>1 ) 
		    if (VHYT101A-DATA.VAGen_ORIENTATION[CNT] == VHYT101A-DATA.LFT-ORIENTATION-CD[CNT])
		    	VHYT101A-DATA.BUTTONTXT[CNT] = "$" + VHYT101A-DATA.VAGen_ORIENTATION[CNT] + VHYT101A-DATA.CAR-NO[CNT];
		    else
		    	VHYT101A-DATA.BUTTONTXT[CNT] = "$" + VHYT101A-DATA.CAR-NO[CNT] + VHYT101A-DATA.VAGen_ORIENTATION[CNT];
		    end
		else
			if (VHYT101A-DATA.VAGen_ORIENTATION[CNT] == VHYT101A-DATA.LFT-ORIENTATION-CD[CNT])
		    	VHYT101A-DATA.BUTTONTXT[CNT] = VHYT101A-DATA.VAGen_ORIENTATION[CNT]+ VHYT101A-DATA.CAR-NO[CNT];
		    else
		    	VHYT101A-DATA.BUTTONTXT[CNT] = VHYT101A-DATA.CAR-NO[CNT] + VHYT101A-DATA.VAGen_ORIENTATION[CNT];
		    end
		end	

        if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-01")
            
            VHYT101IS-B-PIT-01();
            
        else
        	if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-02")
            	
            	VHYT101IS-B-PIT-02();
            	
        	else 
	        	if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-03")
	            	
	            	VHYT101IS-B-PIT-03();
            		
	        	else
	        		if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-04")
	            		
	            		VHYT101IS-B-PIT-04();
            			
		        	else
		        		if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-05")
			            	
			            	VHYT101IS-B-PIT-05();
            				
			        	else
			        		if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-06")
				            	
				            	VHYT101IS-B-PIT-06();
            					
				        	end
				        end
				    end
				end
			end
	 	end	   	
    	
        if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "ST-13")
            VHYT101IS-ST-13();
        else
            if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "RR-1BP")
                VHYT101IS-LOAD-CAR();
                VHYT101IW-RR-1BP.BUTTON-1 = VHYT101IW.BUTTON-1;
                VHYT101IW-RR-1BP.BUTTONTXT = VHYT101IW.BUTTONTXT;
                VHYT101IW-RR-1BP.COLOR = VHYT101A-DATA.FCOLOR[CNT];
            else
            	if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "RR-2BP")
	                VHYT101IS-LOAD-CAR();
	                VHYT101IW-RR-2BP.BUTTON-1 = VHYT101IW.BUTTON-1;
	                VHYT101IW-RR-2BP.BUTTONTXT = VHYT101IW.BUTTONTXT;
	                VHYT101IW-RR-2BP.COLOR = VHYT101A-DATA.FCOLOR[CNT];
	            else
	                if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "S-1A")
	                    VHYT101IS-LOAD-CAR();
	                    
	                    VHYT101IW-S-1A.BUTTON-1 = VHYT101IW.BUTTON-1;
	                    VHYT101IW-S-1A.BUTTONTXT = VHYT101IW.BUTTONTXT;
	                    VHYT101IW-S-1A.COLOR = VHYT101A-DATA.FCOLOR[CNT];
	                else
	                    if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "S-1B")
	                        VHYT101IS-LOAD-CAR();
	                        
	                        VHYT101IW-S-1B.BUTTON-1 = VHYT101IW.BUTTON-1;
	                        VHYT101IW-S-1B.BUTTONTXT = VHYT101IW.BUTTONTXT;
	                        VHYT101IW-S-1B.COLOR = VHYT101A-DATA.FCOLOR[CNT];
	                    else
	                    	if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "S-1WP")
		                        VHYT101IS-LOAD-CAR();
		                        
		                        VHYT101IW-S-1WP.BUTTON-1 = VHYT101IW.BUTTON-1;
		                        VHYT101IW-S-1WP.BUTTONTXT = VHYT101IW.BUTTONTXT;
		                        VHYT101IW-S-1WP.COLOR = VHYT101A-DATA.FCOLOR[CNT];
		                    else
		                        if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "S-2A")
		                            VHYT101IS-LOAD-CAR();
		                            VHYT101IW-S-2A.BUTTON-1 = VHYT101IW.BUTTON-1;
		                            VHYT101IW-S-2A.BUTTONTXT = VHYT101IW.BUTTONTXT;
		                            VHYT101IW-S-2A.COLOR = VHYT101A-DATA.FCOLOR[CNT];
		                        else
		                            if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "S-2B")
		                                VHYT101IS-LOAD-CAR();
		                                VHYT101IW-S-2B.BUTTON-1 = VHYT101IW.BUTTON-1;
		                                VHYT101IW-S-2B.BUTTONTXT = VHYT101IW.BUTTONTXT;
		                                VHYT101IW-S-2B.COLOR = VHYT101A-DATA.FCOLOR[CNT];
		                            else
		                            	if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "S-2WP")
			                                VHYT101IS-LOAD-CAR();
			                                VHYT101IW-S-2WP.BUTTON-1 = VHYT101IW.BUTTON-1;
			                                VHYT101IW-S-2WP.BUTTONTXT = VHYT101IW.BUTTONTXT;
			                                VHYT101IW-S-2WP.COLOR = VHYT101A-DATA.FCOLOR[CNT];
			                            else
			                                if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "S-3A")
			                                    VHYT101IS-LOAD-CAR();
			                                    VHYT101IW-S-3A.BUTTON-1 = VHYT101IW.BUTTON-1;
			                                    VHYT101IW-S-3A.BUTTONTXT = VHYT101IW.BUTTONTXT;
			                                    VHYT101IW-S-3A.COLOR = VHYT101A-DATA.FCOLOR[CNT];
			                                else
			                                    if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "S-3B")
			                                        VHYT101IS-LOAD-CAR();
			                                        VHYT101IW-S-3B.BUTTON-1 = VHYT101IW.BUTTON-1;
			                                        VHYT101IW-S-3B.BUTTONTXT = VHYT101IW.BUTTONTXT;
			                                        VHYT101IW-S-3B.COLOR = VHYT101A-DATA.FCOLOR[CNT];
			                                    else
			                                        if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "S-3N")
			                                            VHYT101IS-LOAD-CAR();
			                                            VHYT101IW-S-3N.BUTTON-1 = VHYT101IW.BUTTON-1;
			                                            VHYT101IW-S-3N.BUTTONTXT = VHYT101IW.BUTTONTXT;
			                                            VHYT101IW-S-3N.COLOR = VHYT101A-DATA.FCOLOR[CNT];
			                                        end
			                                    end
			                                end
			                           end
		                           end
	                            end
	                        end
	                    end
	                end
	            end
	       end
        end
        if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "SS-2A")
            VHYT101IS-LOAD-CAR();
            VHYT101IW-SS-2A.BUTTON-1 = VHYT101IW.BUTTON-1;
            VHYT101IW-SS-2A.BUTTONTXT = VHYT101IW.BUTTONTXT;
            VHYT101IW-SS-2A.COLOR = VHYT101A-DATA.FCOLOR[CNT];
