Function VHYT106IS-TRACK () 
    set VHYT106IW-PASSVAL empty;
    VHYT106IW-PASSVAL.FROM-YRD-SUB-LOC = VHYT106IW-PARM.TRACK-LOC;
    VHYT106IW-PASSVAL.YRD-TRKG-YRD = "DY";
    VHYT106IW-MOVE.CLICKED = 0;
end 

Function VHYT53IS-ADD () 
    VHYT53IW-MSG.FINAL-MESSAGE = " ";
    if (VHYT53IW.CAR-INDEX2 == 0)
        VHYT53IW.CAR-INDEX2 = 1;
    end
    VHYT53IW-CNT.Z = VHYT53IW.CAR-INDEX2;
    VHYT53IW-ADD.TOTAL-CARS = VHYT53IW-CNT.CAR-ROW-CNT;
    VHYT53IW-ADD.LAST-CAR-POSN = VHYT53IW-ADD.NUM-OF-CARS + (VHYT53IW.CAR-INDEX2 - 1);
    if (VHYT53IW-ADD.LAST-CAR-POSN > VHYT53IW-ADD.TOTAL-CARS)
        VHYT53IW-MSG.FINAL-MESSAGE = "Num of cars requested exceeds the length of Pseudo train selected";
    else
        VHYT53IW-NEW-CON.SAVE-NUM = VHYT53IW-NEW-CON.MAX-NUM-CAR;
        VHYT53IW-NEW-CON.MAX-NUM-CAR = VHYT53IW-NEW-CON.MAX-NUM-CAR + VHYT53IW-ADD.NUM-OF-CARS;
        VHYT53IW-NEW-CON.LAST-POSN = LAST-POSN + 1;
        if (MAX-NUM-CAR > 10)
            VHYT53IW-MSG.FINAL-MESSAGE = "New Pseudo has more than 10 cars.  Please re-select car(s)";
            VHYT53IW-NEW-CON.MAX-NUM-CAR = VHYT53IW-NEW-CON.SAVE-NUM;
            VHYT53IW-TRIGGER.NUM-CAR2-SETFOCUS = "Y";
        else
            VHYT53IS-CHK-CAR2();
            if (VHYT53IW.CAR-EXIST == "Y")
                FINAL-MESSAGE = "Car(s) already exist in the new pseudo train. Please check and re-select";
                VHYT53IW-NEW-CON.MAX-NUM-CAR = VHYT53IW-NEW-CON.SAVE-NUM;
                VHYT53IW-TRIGGER.ADD-CAR-SETFOCUS = "Y";
            else
                while (Z <= VHYT53IW-ADD.LAST-CAR-POSN)
                    VHYT53IW-NEW-CON.CAR-NO-N[LAST-POSN] = VHYT53E_DATA.CAR-AND-OR[Z];
                    VHYT53IW-NEW-CON.CAR-TYPE-N[LAST-POSN] = VHYT53E_DATA.CAR-TYPE[Z];
                    VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[LAST-POSN] = VHYT53E_DATA.ATO-PRESENT-IND[Z];
                    VHYT53IW-NEW-CON.TRAIN-INCD-IND-N[LAST-POSN] = VHYT53E_DATA.TRAIN-INCD-IND[Z];
                    VHYT53IW-NEW-CON.VEH-STAT-N[LAST-POSN] = VHYT53E_DATA.VEH-STAT[Z];
                    if (VHYT53E_DATA.VEH-STAT[Z] != "GO    " &&
                     VHYT53E_DATA.VEH-STAT[Z] != "USABLE")
                        VHYT53IW-NEW-CON.COLOR-N[LAST-POSN] = "RED";
                    else
                        VHYT53IW-NEW-CON.COLOR-N[LAST-POSN] = "BLACK";
                    end
                    Z = Z + 1;
                    LAST-POSN = LAST-POSN + 1;
                end
                move MAX-NUM-CAR to LAST-POSN withV60Compat;
                VHYT53IW-NEW-CON.CAR-NO-1 = VHYT53IW-NEW-CON.CAR-NO-N[1];
                VHYT53IW-NEW-CON.CAR-NO-2 = VHYT53IW-NEW-CON.CAR-NO-N[2];
                VHYT53IW-NEW-CON.CAR-NO-3 = VHYT53IW-NEW-CON.CAR-NO-N[3];
                VHYT53IW-NEW-CON.CAR-NO-4 = VHYT53IW-NEW-CON.CAR-NO-N[4];
                VHYT53IW-NEW-CON.CAR-NO-5 = VHYT53IW-NEW-CON.CAR-NO-N[5];
                VHYT53IW-NEW-CON.CAR-NO-6 = VHYT53IW-NEW-CON.CAR-NO-N[6];
                VHYT53IW-NEW-CON.CAR-NO-7 = VHYT53IW-NEW-CON.CAR-NO-N[7];
                VHYT53IW-NEW-CON.CAR-NO-8 = VHYT53IW-NEW-CON.CAR-NO-N[8];
                VHYT53IW-NEW-CON.CAR-NO-9 = VHYT53IW-NEW-CON.CAR-NO-N[9];
                VHYT53IW-NEW-CON.CAR-NO-10 = VHYT53IW-NEW-CON.CAR-NO-N[10];
                VHYT53IW-NEW-CON.COLOR-1 = VHYT53IW-NEW-CON.COLOR-N[1];
                VHYT53IW-NEW-CON.COLOR-2 = VHYT53IW-NEW-CON.COLOR-N[2];
                VHYT53IW-NEW-CON.COLOR-3 = VHYT53IW-NEW-CON.COLOR-N[3];
                VHYT53IW-NEW-CON.COLOR-4 = VHYT53IW-NEW-CON.COLOR-N[4];
                VHYT53IW-NEW-CON.COLOR-5 = VHYT53IW-NEW-CON.COLOR-N[5];
                VHYT53IW-NEW-CON.COLOR-6 = VHYT53IW-NEW-CON.COLOR-N[6];
                VHYT53IW-NEW-CON.COLOR-7 = VHYT53IW-NEW-CON.COLOR-N[7];
                VHYT53IW-NEW-CON.COLOR-8 = VHYT53IW-NEW-CON.COLOR-N[8];
                VHYT53IW-NEW-CON.COLOR-9 = VHYT53IW-NEW-CON.COLOR-N[9];
                VHYT53IW-NEW-CON.COLOR-10 = VHYT53IW-NEW-CON.COLOR-N[10];
                VHYT53IW-NEW-CON.COLOR-B-1 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-2 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-3 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-4 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-5 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-6 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-7 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-8 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-9 = "GREY";
                VHYT53IW-NEW-CON.COLOR-B-10 = "GREY";
            end
        end
    end
    move MAX-NUM-CAR to LAST-POSN withV60Compat;
    VHYT53IW.CAR-INDEX2 = 1;
end 

Function VHYT53IS-C-NEW () 
    VHYT53IW-CNT.YX = 1;
    VHYT53IW-CNT.YZ = 1;
    while (YX <= VHYT53IW-NEW-CON.MAX-NUM-CAR)
        if (VHYT53IW-NEW-CON.SELECT-CAR != YX)
            VHYT53IW-NEW-CON.CAR-NO-N[YZ] = VHYT53IW-NEW-CON.CAR-NO-N[YX];
            VHYT53IW-NEW-CON.COLOR-N[YZ] = VHYT53IW-NEW-CON.COLOR-N[YX];
            VHYT53IW-NEW-CON.CAR-TYPE-N[YZ] = VHYT53IW-NEW-CON.CAR-TYPE-N[YX];
            VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[YZ] = VHYT53IW-NEW-CON.ATO-PRESENT-IND-N[YX];
            YX = YX + 1;
            YZ = YZ + 1;
        else
            YX = YX + 1;
        end
    end
    VHYT53IW-NEW-CON.CAR-NO-N[MAX-NUM-CAR] = " ";
    VHYT53IW-NEW-CON.MAX-NUM-CAR = VHYT53IW-NEW-CON.MAX-NUM-CAR - 1;
    VHYT53IW-NEW-CON.LAST-POSN = VHYT53IW-NEW-CON.MAX-NUM-CAR;
    VHYT53IW-NEW-CON.CAR-NO-1 = VHYT53IW-NEW-CON.CAR-NO-N[1];
    VHYT53IW-NEW-CON.CAR-NO-2 = VHYT53IW-NEW-CON.CAR-NO-N[2];
    VHYT53IW-NEW-CON.CAR-NO-3 = VHYT53IW-NEW-CON.CAR-NO-N[3];
    VHYT53IW-NEW-CON.CAR-NO-4 = VHYT53IW-NEW-CON.CAR-NO-N[4];
    VHYT53IW-NEW-CON.CAR-NO-5 = VHYT53IW-NEW-CON.CAR-NO-N[5];
    VHYT53IW-NEW-CON.CAR-NO-6 = VHYT53IW-NEW-CON.CAR-NO-N[6];
    VHYT53IW-NEW-CON.CAR-NO-7 = VHYT53IW-NEW-CON.CAR-NO-N[7];
    VHYT53IW-NEW-CON.CAR-NO-8 = VHYT53IW-NEW-CON.CAR-NO-N[8];
    VHYT53IW-NEW-CON.CAR-NO-9 = VHYT53IW-NEW-CON.CAR-NO-N[9];
    VHYT53IW-NEW-CON.CAR-NO-10 = VHYT53IW-NEW-CON.CAR-NO-N[10];
    VHYT53IW-NEW-CON.COLOR-1 = VHYT53IW-NEW-CON.COLOR-N[1];
    VHYT53IW-NEW-CON.COLOR-2 = VHYT53IW-NEW-CON.COLOR-N[2];
    VHYT53IW-NEW-CON.COLOR-3 = VHYT53IW-NEW-CON.COLOR-N[3];
    VHYT53IW-NEW-CON.COLOR-4 = VHYT53IW-NEW-CON.COLOR-N[4];
    VHYT53IW-NEW-CON.COLOR-5 = VHYT53IW-NEW-CON.COLOR-N[5];
    VHYT53IW-NEW-CON.COLOR-6 = VHYT53IW-NEW-CON.COLOR-N[6];
    VHYT53IW-NEW-CON.COLOR-7 = VHYT53IW-NEW-CON.COLOR-N[7];
    VHYT53IW-NEW-CON.COLOR-8 = VHYT53IW-NEW-CON.COLOR-N[8];
    VHYT53IW-NEW-CON.COLOR-9 = VHYT53IW-NEW-CON.COLOR-N[9];
    VHYT53IW-NEW-CON.COLOR-10 = VHYT53IW-NEW-CON.COLOR-N[10];
end 

Function VHYT53IS-CAR-01 () 
    VHYT53IW-MOVE.CAR-NO-M = VHYT53IW-NEW-CON.CAR-NO-1;
    VHYT53IW-MOVE.CAR-NO-I = VHYT53IW-NEW-CON.CAR-NO-1;
    VHYT53IW-CLICK.CAR-01-CLICK = CAR-01-CLICK + 1;
    VHYT53IW-NEW-CON.SELECT-CAR = 1;
    if (VHYT53IW-CLICK.CAR-01-CLICK == 1)
        VHYT53IW-NEW-CON.COLOR-B-1 = "YELLOW";
        VHYT53IS-RE-COLOR();
    else
        if (VHYT53IW-CLICK.CAR-01-CLICK == 2)
            VHYT53IW-NEW-CON.COLOR-B-1 = "GREY";
            VHYT53IW-CLICK.CAR-01-CLICK = 0;
        end
    end
end 

