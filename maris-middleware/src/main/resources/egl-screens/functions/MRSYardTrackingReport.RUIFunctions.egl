            else
                if (VHYT90A_DATA.POSN-NO[COUNTER] == 4)
                    VHYT90IW-TR-1.ORIENTATION-4 = VHYT90A_DATA.VAGen_ORIENTATION[COUNTER];
                    VHYT90IW-TR-1.CAR-NO-4 = VHYT90A_DATA.CAR-NO[COUNTER];
