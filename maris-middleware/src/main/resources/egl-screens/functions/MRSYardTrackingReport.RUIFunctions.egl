Function VHYT71IS-CLEAR-2 () 
    set VHYT71IW-MOVE empty;
    VHYT71IW-MOVE.CLICKED = 0;
    VHYT71IW-PASSVALUE.FROM-YRD-SUB-LOC = " ";
    VHYT71IW-PASSVALUE.TO-YRD-SUB-LOC = " ";
    VHYT71IW-PASSVALUE.TO-CAR-POSN = 0;
    VHYT71IW-PASSVALUE.FROM-CAR-POSN = 0;
end 

Function VHYT71IS-CLICK () 
    VHYT71IW-MOVE.CLICKED = VHYT71IW-MOVE.CLICKED + 1;
    if (VHYT71IW-MOVE.CLICKED == 1)
        VHYT71IW-MOVE.FIRST-CLICK = VHYT71IW-PARM.TRACK-NO;
        VHYT71IW-PASSVALUE.FROM-CAR-POSN = VHYT71IW-PARM.POSN;
        VHYT71IW-PASSVALUE.TO-CAR-POSN = VHYT71IW-PARM.POSN;
        VHYT71IW-PASSVALUE.FROM-YRD-SUB-LOC = VHYT71IW-PARM.TRACK-NO;
    else
        if (VHYT71IW-MOVE.CLICKED == 2)
            VHYT71IW-MOVE.SECOND-CLICK = VHYT71IW-PARM.TRACK-NO;
            if (VHYT71IW-MOVE.FIRST-CLICK == VHYT71IW-MOVE.SECOND-CLICK)
                VHYT71IW-PASSVALUE.TO-CAR-POSN = VHYT71IW-PARM.POSN;
            end
        else
            if (VHYT71IW-MOVE.CLICKED == 3)
                VHYT71IW-MOVE.THIRD-CLICK = VHYT71IW-PARM.TRACK-NO;
                VHYT71IW-PASSVALUE.TO-YRD-SUB-LOC = VHYT71IW-PARM.TRACK-NO;
                VHYT71IW-TRIGGER.OPEN-DETAIL = "Y";
            end
        end
    end
end 

Function VHYT71IS-INIT () 
    VHYT71IS-CLEAR-1();
    set VHYT71IW-MOVE empty;
    VHYT71IW-MOVE.CLICKED = 0;
    set VHYT71IW-PASSVALUE empty;
    VHYT71IW-PASSVALUE.YRD-TRKG-YRD = "CY";
    VHYT70A_CRIT.YRD-TRKG-YRD = "CY";
    VH01A02_CRIT.GUI-NAME = "VHYT71";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT70I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT70A";
    
    try
        call "VHYT70A"(XDCONTROL, VHYT70A_CRIT, VHYT70A_DATA);
    
    end    

   
    MRSCommonCode.XXA0IS-CHECK_EXT();

   
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT71IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHYT71IS-LOAD () 
    move VHYT70A_DATA.DATA_ROW to VHYT71A_DATA.DATA_ROW[1] for all;
    COUNTER = 1;
    while (VHYT71IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "TF-01")
            VHYT71IS-TF01();
        else
            if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "TF-02")
                VHYT71IS-TF02();
            else
                if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "TF-03")
                    VHYT71IS-TF03();
                else
                    if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "TF-04")
                        VHYT71IS-TF04();
                    else
                        if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "TF-05")
                            VHYT71IS-TF05();
                        else
                            if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "TF-06")
                                VHYT71IS-TF06();
                            else
                                if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "TF-07")
                                    VHYT71IS-TF07();
                                else
                                    if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "RR-01")
                                        VHYT71IS-RR01();
                                    else
                                        if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "RR-02")
                                            VHYT71IS-RR02();
                                        else
                                            if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "RR-03")
                                                VHYT71IS-RR03();
                                            else
                                                if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "R-90")
                                                    VHYT71IS-R90();
                                                else
                                                    if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "R-91")
                                                        VHYT71IS-R91();
                                                    else
                                                        if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "R-92")
                                                            VHYT71IS-R92();
                                                        else
                                                            if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "R-93")
                                                                VHYT71IS-R93();
                                                            else
                                                            	if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "YT")
                                                                	VHYT71IS-YT();
                                                                end
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-07")
            VHYT71IS-ST07();
        else
            if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-08")
                VHYT71IS-ST08();
            else
                if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-09")
                    VHYT71IS-ST09();
                else
                    if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-10")
                        VHYT71IS-ST10();
                    else
                        if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-11")
                            VHYT71IS-ST11();
                        else
                            if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-12")
                                VHYT71IS-ST12();
                            else
                                if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-13")
                                    VHYT71IS-ST13();
                                else
                                    if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-14")
                                        VHYT71IS-ST14();
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-15")
            VHYT71IS-ST15();
        else
            if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-16")
                VHYT71IS-ST16();
            else
                if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-17")
                    VHYT71IS-ST17();
                else
                    if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-18")
                        VHYT71IS-ST18();
                    else
                        if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-19")
                            VHYT71IS-ST19();
                        else
                            if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-20")
                                VHYT71IS-ST20();
                            else
                                if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-21")
                                    VHYT71IS-ST21();
                                else
                                    if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-22")
                                        VHYT71IS-ST22();
                                    else
                                        if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-23")
                                            VHYT71IS-ST23();
                                        else
                                            if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-24")
                                                VHYT71IS-ST24();
                                            else
                                                if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-25")
                                                    VHYT71IS-ST25();
                                                else
                                                    if (VHYT71A_DATA.YRD-SUB-LOC[COUNTER] == "ST-26")
                                                        VHYT71IS-ST26();
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        COUNTER = COUNTER + 1;
    end
end 

Function VHYT71IS-MAINT () 
    VH01A02_CRIT.GUI-NAME = "VHYT71";
    MRSYardTracking.VHYT01IS-INIT-Y();
end 

Function VHYT71IS-R90 () 
	isleft boolean = strLib.indexOf("<O({vblm",VHYT71A_DATA.VAGen_ORIENTATION[COUNTER])>0;
	txt char(6) = "      ";
	if(isleft ) txt = VHYT71A_DATA.VAGen_ORIENTATION[COUNTER] + VHYT71A_DATA.CAR-NO[COUNTER];
	else txt = VHYT71A_DATA.CAR-NO[COUNTER] + VHYT71A_DATA.VAGen_ORIENTATION[COUNTER];
	end
	if(strLib.characterLen(strLib.clip(VHYT71A_DATA.SOFTVER[COUNTER], 0)) > 0)
        txt = "$" + strLib.clip( txt, 0);
    end
	aColor String = GiveAColor(VHYT71A_DATA.VEH-STAT[COUNTER], VHYT71A_DATA.TRAIN_INCD_IND[COUNTER], VHYT71A_DATA.HPMHRS[COUNTER]);
    
    if (VHYT71A_DATA.POSN-NO[COUNTER] == 1)
        VHYT71IW-R90.ORIENTATION-1 = VHYT71A_DATA.VAGen_ORIENTATION[COUNTER];
        VHYT71IW-R90.CAR-NO-1 = VHYT71A_DATA.CAR-NO[COUNTER];
        VHYT71IW-R90.BUTTON-1 = strLib.clip(txt, 0);
        VHYT71IW-R90.CAR-1-COLOR = strLib.clip(aColor,2);
    else
        if (VHYT71A_DATA.POSN-NO[COUNTER] == 2)
            VHYT71IW-R90.ORIENTATION-2 = VHYT71A_DATA.VAGen_ORIENTATION[COUNTER];
            VHYT71IW-R90.CAR-NO-2 = VHYT71A_DATA.CAR-NO[COUNTER];
            VHYT71IW-R90.BUTTON-2 = strLib.clip(txt, 0);
        	VHYT71IW-R90.CAR-2-COLOR = strLib.clip(aColor,2);
        else
            if (VHYT71A_DATA.POSN-NO[COUNTER] == 3)
                VHYT71IW-R90.ORIENTATION-3 = VHYT71A_DATA.VAGen_ORIENTATION[COUNTER];
                VHYT71IW-R90.CAR-NO-3 = VHYT71A_DATA.CAR-NO[COUNTER];
                VHYT71IW-R90.BUTTON-3 = strLib.clip(txt, 0);
        		VHYT71IW-R90.CAR-3-COLOR = strLib.clip(aColor,2);
            else
                if (VHYT71A_DATA.POSN-NO[COUNTER] == 4)
                    VHYT71IW-R90.ORIENTATION-4 = VHYT71A_DATA.VAGen_ORIENTATION[COUNTER];
                    VHYT71IW-R90.CAR-NO-4 = VHYT71A_DATA.CAR-NO[COUNTER];
			 		VHYT71IW-R90.BUTTON-4 = strLib.clip(txt, 0);
			        VHYT71IW-R90.CAR-4-COLOR = strLib.clip(aColor,2);                    
                else
                    if (VHYT71A_DATA.POSN-NO[COUNTER] == 5)
                        VHYT71IW-R90.ORIENTATION-5 = VHYT71A_DATA.VAGen_ORIENTATION[COUNTER];
                        VHYT71IW-R90.CAR-NO-5 = VHYT71A_DATA.CAR-NO[COUNTER];
                        VHYT71IW-R90.BUTTON-5 = strLib.clip(txt, 0);
        				VHYT71IW-R90.CAR-5-COLOR = strLib.clip(aColor,2);
