end 

Function VHIC02IS-TRACK () 
    set VHIC02IW-PASSVALUE empty;
    VHIC02IW-PASSVALUE.FROM-YRD-SUB-LOC = VHIC02IW-PARM.TRACK-LOC;
    VHIC02IW-PASSVALUE.YRD-TRKG-YRD = "SVB";
    VHIC02IW-MOVE.CLICKED = 0;
end 

Function VHIC03IS-CLEAR () 
    VHIC03IW-MESSAGE.MSG = " ";
    VHIC03IW-MESSAGE.MSG-Y = " ";
end 

Function VHIC03IS-INIT () 
    try
        call "VHYT09A"(XDCONTROL, VHYT09A_CRIT, VHYT09A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHIC03IS-INITX();
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

Function VHIC03IS-INITX ()
   
    VHIC03IW-MESSAGE.MSGX-1 = "Move selected cars ";
    VHIC03IW-MESSAGE.MSGX-3 = "to Yard - - -";
end 

Function VHIC03IS-MOVE () 
    if (VHIC03IW-PASSVALUE.FROM-YRD-TRKG-YRD == VHIC03IW-PASSVALUE.TO-YRD-TRKG-YRD)
        VHIC03IW-MESSAGE.MSG = "Cars or consists can not be moved from the same yard. ";
    else
        if (VHIC03IW-PASSVALUE.TO-YRD-TRKG-YRD == " ")
            VHIC03IW-MESSAGE.MSG = "Please select yard for the car to move";
        else
            VHIC03IS-MOVEX();
        end
    end
end 

Function VHIC03IS-MOVEX () 
    VHIC03A_CRIT.TO-YRD-TRKG-YRD = VHIC03IW-PASSVALUE.TO-YRD-TRKG-YRD;
    VHIC03A_CRIT.FROM-POSN-NO = VHIC03IW-PASSVALUE.FROM-POSN-NO;
    VHIC03A_CRIT.TO-POSN-NO = VHIC03IW-PASSVALUE.TO-POSN-NO;
    VHIC03A_CRIT.FROM-YRD-TRKG-YRD = VHIC03IW-PASSVALUE.FROM-YRD-TRKG-YRD;
    VHIC03A_CRIT.TERM-ID = VH01A01_DATA.TERM-ID;
    VHIC03A_CRIT.USER-GROUP = VH01A01_DATA.USER-GROUP;
    try
        call "VHIC03A"(XDCONTROL, VHIC03A_CRIT, VHIC03A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if (VHIC03A_CRIT.ERROR-SW != "Y")
            VHIC03IW-MESSAGE.MSGY-1 = "Cars are successfully moved from ";
            VHIC03IW-MESSAGE.MSGY-2 = VHIC03IW-PASSVALUE.FROM-YRD-TRKG-YRD;
            VHIC03IW-MESSAGE.MSGY-3 = ",  to  ";
            VHIC03IW-MESSAGE.MSGY-5 = VHIC03IW-PASSVALUE.TO-YRD-TRKG-YRD;
        else
            VHIC03IW-MESSAGE.MSG = "No room for the cars move to the new yard T-95";
        end
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

Function VHSW01IS-CLEAR () 
    set VHSW01IW empty;
end 

Function VHSW01IS-INIT () 
    VHSW01IS-CLEAR();
  
  
    set VHSW01IW-PASSVALUE empty;
    VHSW01IW-PASSVALUE.YRD-TRKG-YRD = "SW";
    VHSW01A_CRIT.YRD-TRKG-YRD = VHSW01IW-PASSVALUE.YRD-TRKG-YRD;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYTX5I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYTX5A";

    
    try
        call "VHSW01A"(XDCONTROL, VHSW01A_CRIT, VHSW01A_DATA);
    
    end
    

   
    MRSCommonCode.XXA0IS-CHECK_EXT();

   
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHSW01IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHSW01IS-LOAD ()
   
    COUNTER = 1;
    while (VHSW01IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if (VHSW01A_DATA.YRD-SUB-LOC[COUNTER] == "MACART")
            VHSW01IS-MSTOR1();
        else
            if (VHSW01A_DATA.YRD-SUB-LOC[COUNTER] == "BAYFAIR")
                VHSW01IS-MSTOR2();
            else
                if (VHSW01A_DATA.YRD-SUB-LOC[COUNTER] == "M90")
                    VHSW01IS-MSTOR3();
                else
                    if (VHSW01A_DATA.YRD-SUB-LOC[COUNTER] == "OKS")
                        VHSW01IS-MSTOR4();
                    end
                end
            end
        end
        COUNTER = COUNTER + 1;
    end
end 

Function VHSW01IS-MSTOR1 () 
    VHSW01IW.MACART = "T";
end 

Function VHSW01IS-MSTOR2 () 
    VHSW01IW.BAYFAIR = "T";
end 

Function VHSW01IS-MSTOR3 () 
    VHSW01IW.M90 = "T";
end 

Function VHSW01IS-MSTOR4 () 
    VHSW01IW.OKS = "T";
end 

Function VHSW01IS-PRINT ()
   
    VHSW01IW-PASSVALUE.YRD-TRKG-YRD = "SW";
end 

Function VHSW01IS-PSEUDO () 
    set VHSW01IW-PASSVALUE empty;
    VHSW01IW-PASSVALUE.FROM-YRD-SUB-LOC = "T-95";
    VHSW01IW-PASSVALUE.YRD-TRKG-YRD = "SW";
end 

Function VHSW01IS-TRACK () 
    set VHSW01IW-PASSVALUE empty;
    VHSW01IW-PASSVALUE.FROM-YRD-SUB-LOC = VHSW01IW-PARM.TRACK-LOC;
    VHSW01IW-PASSVALUE.YRD-TRKG-YRD = "SW";
end 

