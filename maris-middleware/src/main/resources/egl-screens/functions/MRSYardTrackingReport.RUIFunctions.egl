Function VHYT106IS-CLICK () 
    VHYT106IW-MOVE.CLICKED = VHYT106IW-MOVE.CLICKED + 1;
    if (VHYT106IW-MOVE.CLICKED == 1)
        VHYT106IW-MOVE.FIRST-CLICK = VHYT106IW-PARM.TRACK-NO;
        VHYT106IW-PASSVAL.FROM-CAR-POSN = VHYT106IW-PARM.POSN;
        VHYT106IW-PASSVAL.TO-CAR-POSN = VHYT106IW-PARM.POSN;
        VHYT106IW-PASSVAL.FROM-YRD-SUB-LOC = VHYT106IW-PARM.TRACK-NO;
    else
        if (VHYT106IW-MOVE.CLICKED == 2)
            VHYT106IW-MOVE.SECOND-CLICK = VHYT106IW-PARM.TRACK-NO;
            if (VHYT106IW-MOVE.FIRST-CLICK == VHYT106IW-MOVE.SECOND-CLICK)
                VHYT106IW-PASSVAL.TO-CAR-POSN = VHYT106IW-PARM.POSN;
            end
        else
            if (VHYT106IW-MOVE.CLICKED == 3)
                VHYT106IW-MOVE.THIRD-CLICK = VHYT106IW-PARM.TRACK-NO;
                VHYT106IW-PASSVAL.TO-YRD-SUB-LOC = VHYT106IW-PARM.TRACK-NO;
                VHYT106IW-TRIGGER.OPEN-DETAIL = "Y";
            end
        end
    end
end 

Function VHYT106IS-DETAIL () 
    VHYT106IW-PASSVAL.YRD-TRKG-YRD = "DY";
    VHYT106IW-PASSVAL.FROM-YRD-SUB-LOC = VHYT106IW-PARM.TRACK-LOC;
end 

