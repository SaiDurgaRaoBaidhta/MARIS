Function VHYT53IS-RESET () 
    VHYT53K_CRIT.CON-NO = VHYT53IW-INCLUDE.CON-NO;
    VHYT53K_CRIT.YRD-SUB-LOC = VHYT53IW-INCLUDE.YRD-SUB-LOC;
    VHYT53K_CRIT.YRD-TRKG-YRD = VHYT53IW.YRD-TRKG-YRD;
    VHYT53K_CRIT.CON-IND = VHYT53IW-INCLUDE.CON-IND;
    VHYT53K_DATA.TERM-LAST-UPD = VHYT53IW-PASSVALUE.TERM-LAST-UPD;
    VHYT53K_DATA.USER-GROUP = VHYT53IW-PASSVALUE.USER-GROUP;
    try
        call "VHYT53K"(XDCONTROL, VHYT53K_CRIT, VHYT53K_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT53IW-TRIGGER.DISABLE-RESET = "Y";
        VHYT53IW-TRIGGER.REFRESH = "Y";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

Function VHYT53IS-SEL () 
    VHYT53IW.CAR-INDEX = 1;
    if (VHYT53IW-NEW-CON.CON-NO == "000")
        VHYT53IW-NEW-CON.CON-NO = "  ";
    end
    if (TEMP-SEL != SELECTION-IDX)
        if (VHYT53IW.SELECTION-IDX > 0)
            VHYT53IW-MSG.FINAL-MESSAGE = " ";
            VHYT53IW.TEMP-SEL = VHYT53IW.SELECTION-IDX;
