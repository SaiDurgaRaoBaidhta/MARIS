Function VHYT70IS-COLOR () 
    if (VHYT70A_DATA.HOME-YRD[COUNTER] == "HY")
        VHYT70IW-PASSVALUE.CAR-COLOR = "GREEN";
        VHYT70IW-PASSVALUE.CAR-COLOR-B = "GREY80";
    else
        if (VHYT70A_DATA.HOME-YRD[COUNTER] == "RY")
            VHYT70IW-PASSVALUE.CAR-COLOR = "BROWN";
            VHYT70IW-PASSVALUE.CAR-COLOR-B = "GREY80";
        else
            if (VHYT70A_DATA.HOME-YRD[COUNTER] == "CY")
                VHYT70IW-PASSVALUE.CAR-COLOR = "BLUE";
                VHYT70IW-PASSVALUE.CAR-COLOR-B = "GREY80";
            else
                if (VHYT70A_DATA.HOME-YRD[COUNTER] == "DY")
                    VHYT70IW-PASSVALUE.CAR-COLOR = "RED";
                    VHYT70IW-PASSVALUE.CAR-COLOR-B = "GREY80";
                else
                    VHYT70IW-PASSVALUE.CAR-COLOR = "BLACK";
                    VHYT70IW-PASSVALUE.CAR-COLOR-B = "GREY80";
                end
            end
        end
    end    
end 

Function VHYT70IS-INIT () 
    VHYT70IS-CLEAR();
    VHYT70IW-PASSVALUE.YRD-TRKG-YRD = "CY";
    VHYT70A_CRIT.YRD-TRKG-YRD = "CY";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT70I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT70A";

    
    try
        call "VHYT70A"(XDCONTROL, VHYT70A_CRIT, VHYT70A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

  
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT70IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHYT70IS-LOAD () 
    COUNTER = 1;
    while (VHYT70IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "TF-01")
            VHYT70IS-TF01();
        else
            if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "TF-02")
                VHYT70IS-TF02();
            else
                if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "TF-03")
                    VHYT70IS-TF03();
                else
                    if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "TF-04")
                        VHYT70IS-TF04();
                    else
                        if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "TF-05")
                            VHYT70IS-TF05();
                        else
                            if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "TF-06")
                                VHYT70IS-TF06();
                            else
                                if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "TF-07")
                                    VHYT70IS-TF07();
                                else
                                    if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "RR-01")
                                        VHYT70IS-RR01();
                                    else
                                        if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "RR-02")
                                            VHYT70IS-RR02();
                                        else
                                            if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "RR-03")
                                                VHYT70IS-RR03();
                                            else
                                                if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "R-90")
                                                    VHYT70IS-R90();
                                                else
                                                    if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "R-91")
                                                        VHYT70IS-R91();
                                                    else
                                                        if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "R-92")
                                                            VHYT70IS-R92();
                                                        else
                                                            if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "R-93")
                                                                VHYT70IS-R93();
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-07")
            VHYT70IS-ST07();
        else
            if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-08")
                VHYT70IS-ST08();
            else
                if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-09")
                    VHYT70IS-ST09();
                else
                    if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-10")
                        VHYT70IS-ST10();
                    else
                        if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-11")
                            VHYT70IS-ST11();
                        else
                            if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-12")
                                VHYT70IS-ST12();
                            else
                                if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-13")
                                    VHYT70IS-ST13();
                                else
                                    if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-14")
                                        VHYT70IS-ST14();
                                     else
                                     	if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "YT")
                                        	VHYT70IS-YT();
                                     	end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-15")
            VHYT70IS-ST15();
        else
            if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-16")
                VHYT70IS-ST16();
            else
                if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-17")
                    VHYT70IS-ST17();
                else
                    if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-18")
                        VHYT70IS-ST18();
                    else
                        if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-19")
                            VHYT70IS-ST19();
                        else
                            if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-20")
                                VHYT70IS-ST20();
                            else
                                if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-21")
                                    VHYT70IS-ST21();
                                else
                                    if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-22")
                                        VHYT70IS-ST22();
                                    else
                                        if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-23")
                                            VHYT70IS-ST23();
                                        else
                                            if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-24")
                                                VHYT70IS-ST24();
                                            else
                                                if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-25")
                                                    VHYT70IS-ST25();
                                                else
                                                    if (VHYT70A_DATA.YRD-SUB-LOC[COUNTER] == "ST-26")
                                                        VHYT70IS-ST26();
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        COUNTER = COUNTER + 1;
    end
end 

Function VHYT70IS-PRINT () 
    VHYT70IW-PASSVALUE.YRD-TRKG-YRD = "CY";
end 

Function VHYT70IS-PSEUDO () 
    VHYT70IW-PASSVALUE.YRD-SUB-LOC = "T-95";
    VHYT70IW-PASSVALUE.YRD-TRKG-YRD = "CY";
    VHYT70A_CRIT.YRD-TRKG-YRD = "CY";
end 

Function VHYT70IS-R90 ()  
	isleft boolean = strLib.indexOf("<O({vblm",VHYT70A_DATA.VAGen_ORIENTATION[COUNTER])>0;
	txt char(6) = "      ";
	if(isleft ) txt = VHYT70A_DATA.VAGen_ORIENTATION[COUNTER] + VHYT70A_DATA.CAR-NO[COUNTER];
	else txt = VHYT70A_DATA.CAR-NO[COUNTER] + VHYT70A_DATA.VAGen_ORIENTATION[COUNTER];
	end
    if(strLib.characterLen(strLib.clip(VHYT70A_DATA.SOFTVER[COUNTER], 0)) > 0)
        txt = "$" + strLib.clip( txt, 0);
    end	
    if (VHYT70A_DATA.POSN-NO[COUNTER] == 1)
        VHYT70IW-R90.ORIENTATION-1 = VHYT70A_DATA.VAGen_ORIENTATION[COUNTER];
        VHYT70IW-R90.CAR-NO-1 = VHYT70A_DATA.CAR-NO[COUNTER];
        VHYT70IS-COLOR();
        VHYT70IW-R90.CAR-1-COLOR = VHYT70IW-PASSVALUE.CAR-COLOR;
        VHYT70IW-R90.CAR-1-COLOR-B = VHYT70IW-PASSVALUE.CAR-COLOR-B;
        VHYT70IW-R90.BUTTON-1 = txt;
    end
    if (VHYT70A_DATA.POSN-NO[COUNTER] == 2)
        VHYT70IW-R90.ORIENTATION-2 = VHYT70A_DATA.VAGen_ORIENTATION[COUNTER];
        VHYT70IW-R90.CAR-NO-2 = VHYT70A_DATA.CAR-NO[COUNTER];
        VHYT70IS-COLOR();
        VHYT70IW-R90.CAR-2-COLOR = VHYT70IW-PASSVALUE.CAR-COLOR;
        VHYT70IW-R90.CAR-2-COLOR-B = VHYT70IW-PASSVALUE.CAR-COLOR-B;
        VHYT70IW-R90.BUTTON-2 = txt;
    end
    if (VHYT70A_DATA.POSN-NO[COUNTER] == 3)
        VHYT70IW-R90.ORIENTATION-3 = VHYT70A_DATA.VAGen_ORIENTATION[COUNTER];
        VHYT70IW-R90.CAR-NO-3 = VHYT70A_DATA.CAR-NO[COUNTER];
        VHYT70IS-COLOR();
        VHYT70IW-R90.CAR-3-COLOR = VHYT70IW-PASSVALUE.CAR-COLOR;
        VHYT70IW-R90.CAR-3-COLOR-B = VHYT70IW-PASSVALUE.CAR-COLOR-B;
        VHYT70IW-R90.BUTTON-3 = txt;
    end
    if (VHYT70A_DATA.POSN-NO[COUNTER] == 4)
        VHYT70IW-R90.ORIENTATION-4 = VHYT70A_DATA.VAGen_ORIENTATION[COUNTER];
        VHYT70IW-R90.CAR-NO-4 = VHYT70A_DATA.CAR-NO[COUNTER];
        VHYT70IS-COLOR();
        VHYT70IW-R90.CAR-4-COLOR = VHYT70IW-PASSVALUE.CAR-COLOR;
        VHYT70IW-R90.CAR-4-COLOR-B = VHYT70IW-PASSVALUE.CAR-COLOR-B;
        VHYT70IW-R90.BUTTON-4 = txt;
    end
    if (VHYT70A_DATA.POSN-NO[COUNTER] == 5)
        VHYT70IW-R90.ORIENTATION-5 = VHYT70A_DATA.VAGen_ORIENTATION[COUNTER];
        VHYT70IW-R90.CAR-NO-5 = VHYT70A_DATA.CAR-NO[COUNTER];
        VHYT70IS-COLOR();
        VHYT70IW-R90.CAR-5-COLOR = VHYT70IW-PASSVALUE.CAR-COLOR;
        VHYT70IW-R90.CAR-5-COLOR-B = VHYT70IW-PASSVALUE.CAR-COLOR-B;
        VHYT70IW-R90.BUTTON-5 = txt;
