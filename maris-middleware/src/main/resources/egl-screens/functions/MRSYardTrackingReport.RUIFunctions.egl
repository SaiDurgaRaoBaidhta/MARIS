Function VHYT106IS-INIT () 
    VHYT106IS-CLEAR-OR();
    set VHYT106IW-MOVE empty;
    VHYT106IW-MOVE.CLICKED = 0;
    set VHYT106IW-PASSVAL empty;
    VHYT106IW-PASSVAL.YRD-TRKG-YRD = "DY";
    VHYT105A_CRIT.YRD-TRKG-YRD = VHYT106IW-PASSVAL.YRD-TRKG-YRD;
    VH01A02_CRIT.GUI-NAME = "VHY106";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYTX5I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYTX5A";

    
    try
        call "VHYTX5A"(XDCONTROL, VHYT105A_CRIT, VHYT105A_DATA);
    
    end
    

   
    MRSCommonCode.XXA0IS-CHECK_EXT();

   
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT106IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHYT106IS-LOAD () 
    move VHYT105A_DATA.DATA_ROW to VHYT106A_DATA.DATA_ROW[1] for all;
    COUNTER = 1;
    while (VHYT106IW-PASSVAL.COUNTER <= XDCONTROL.UROWCNT)
        if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "DTF-01")
            VHYT106IS-DTF-01();
        else
            if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "DTF-02")
                VHYT106IS-DTF-02();
            else
            	if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "DTF-03")
                    VHYT106IS-DTF-03();
                else
	                if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "DTF-04")
	                    VHYT106IS-DTF-04();
	                else
	                    if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "RR-1A")
	                        VHYT106IS-RR-1A();
	                    else
	                        if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "RT-1")
	                            VHYT106IS-RT-1();
	                        else
	                            if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "RT-2")
	                                VHYT106IS-RT-2();
	                            else
		                            if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "YT")
		                                VHYT106IS-YT();
		                            end
		                        end
	                        end
	                    end
	                end
	             end
            end
        end
        if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "ST-03")
            VHYT106IS-ST-03();
        else
            if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "ST-04")
                VHYT106IS-ST-04();
            else
                if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "ST-05")
                    VHYT106IS-ST-05();
                else
                    if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "ST-06")
                        VHYT106IS-ST-06();
                    else
                        if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "ST-07")
                            VHYT106IS-ST-07();
                        else
                            if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "ST-08")
                                VHYT106IS-ST-08();
                            else
                                if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "ST-09")
                                    VHYT106IS-ST-09();
                                else
                                    if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "ST-10")
                                        VHYT106IS-ST-10();
                                    else
                                        if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "ST-11")
                                            VHYT106IS-ST-11();
                                        else
                                            if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "ST-12")
                                                VHYT106IS-ST-12();
                                            else
                                                if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "ST-13")
                                                    VHYT106IS-ST-13();
                                                else
                                                    if (VHYT106A_DATA.YRD-SUB-LOC[COUNTER] == "SS-06")
                                                        VHYT106IS-SS-06();
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        COUNTER = COUNTER + 1;
    end
end 

Function VHYT106IS-MAINT () 
    VH01A02_CRIT.GUI-NAME = "VHY106";
    MRSYardTracking.VHYT01IS-INIT-Y();
end 

Function VHYT106IS-PRINT () 
    VHYT106IW-PASSVAL.YRD-TRKG-YRD = "DY";
end 

