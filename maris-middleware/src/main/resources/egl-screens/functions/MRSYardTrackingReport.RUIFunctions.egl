            VHYT90IW-TR-1.BUTTON-2 = strLib.clip(txt, 0);
        else
            if (VHYT90A_DATA.POSN-NO[COUNTER] == 3)
                VHYT90IW-TR-1.ORIENTATION-3 = VHYT90A_DATA.VAGen_ORIENTATION[COUNTER];
                VHYT90IW-TR-1.CAR-NO-3 = VHYT90A_DATA.CAR-NO[COUNTER];
