Function VHYT61IS-LOAD () 
    move VHYT60A-DATA.DATA_ROW to VHYT61A-DATA.DATA_ROW[1] for all;
    CNT = 1;
    while (VHYT61IW.CNT <= XDCONTROL.UROWCNT)
    	VHYT61A-DATA.FCOLOR[CNT] = dy100Color (VHYT61A-DATA.HOME-YRD[CNT]);
        
	    if (strLib.characterLen(VHYT61A-DATA.SOFTVER[CNT])>1 ) 
		    if (VHYT61A-DATA.VAGen_ORIENTATION[CNT] == VHYT61A-DATA.LFT-ORIENTATION-CD[CNT])
		    	VHYT61A-DATA.BUTTONTXT[CNT] = "$" + VHYT61A-DATA.VAGen_ORIENTATION[CNT] + VHYT61A-DATA.CAR-NO[CNT];
		    else
		    	VHYT61A-DATA.BUTTONTXT[CNT] = "$" + VHYT61A-DATA.CAR-NO[CNT] + VHYT61A-DATA.VAGen_ORIENTATION[CNT];
		    end
		else
			if (VHYT61A-DATA.VAGen_ORIENTATION[CNT] == VHYT61A-DATA.LFT-ORIENTATION-CD[CNT])
		    	VHYT61A-DATA.BUTTONTXT[CNT] = VHYT61A-DATA.VAGen_ORIENTATION[CNT]+ VHYT61A-DATA.CAR-NO[CNT];
		    else
		    	VHYT61A-DATA.BUTTONTXT[CNT] = VHYT61A-DATA.CAR-NO[CNT] + VHYT61A-DATA.VAGen_ORIENTATION[CNT];
		    end
		end    	
    	
    	if (VHYT61A-DATA.YRD-SUB-LOC[CNT][1:5] == "B-PIT")
    		if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-01")
            	VHYT61IS-B-PIT-01();
            	
            else
            	if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-02")
	            	VHYT61IS-B-PIT-02();
	            	
	            else
	            	if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-03")
		            	VHYT61IS-B-PIT-03();
		            	
		            else
		            	if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-04")
			            	VHYT61IS-B-PIT-04();
			            else
			            	if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-05")
				            	VHYT61IS-B-PIT-05();
				            	
				            else
				            	if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-06")
					            	VHYT61IS-B-PIT-06();
					            	
					            end
					        end
					    end
					end
				end
			end
    	else  
    	    if (VHYT61A-DATA.YRD-SUB-LOC[CNT][1:2] == "RR")  	
		        if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "RR-01")
		            VHYT61IS-RR01();
		            
		        else
		            if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "RR-02")
		                VHYT61IS-RR02();
		                
		            else
		                if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "RR-03")
		                    VHYT61IS-RR03();
		                    
		                else
	                         if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "RRBP-2")
	                             VHYT61IS-RRBP-2();
	                             
		                     else 
						          if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "RRBP-3")
						            	VHYT61IS-RRBP-3();
						            	
						          else   
						        	  	if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "RRBP-2B")
		                                	VHYT61IS-RRBP-2B();
		                                	
		                            	else
			                                if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "RRBP-3B")
			                                    VHYT61IS-RRBP-3B();
			                                    
			                                end
			                            end
			                       end
		                     end
		            	end
		            end 
		        end
            else           
                 if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "1A")
                        VHYT61IS-1A();
                        
                 else
                     if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "1B")
                            VHYT61IS-1B();
                            
                     else
                        if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "2A")
                            VHYT61IS-2A();
                            
                        else
                            if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "2B")
                                VHYT61IS-2B();
                                
                            else
                                if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "2C")
                                    VHYT61IS-2C();
                                    
                                else
                                    if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "2D")
                                        VHYT61IS-2D();
                                        
                                    else
                                        if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "3A")
                                            VHYT61IS-3A();
                                            
                                        else
                                            if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "3B")
                                                VHYT61IS-3B();
                                                
                                            else
                                                if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "3C")
                                                    VHYT61IS-3C();
                                                    
                                                else
                                                    if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "3D")
                                                        VHYT61IS-3D();
                                                        
                                                    else
                                                        if (VHYT61A-DATA.YRD-SUB-LOC[CNT] == "S7-1")
                                                            VHYT61IS-S7-1();
                                                            
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                     end
                 end
            end
        end

