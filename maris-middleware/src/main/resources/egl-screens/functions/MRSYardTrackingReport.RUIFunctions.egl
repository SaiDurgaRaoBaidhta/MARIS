                VHYT101IW-SS-2B.COLOR = VHYT101A-DATA.FCOLOR[CNT];
            else
                if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "SS-3A")
                    VHYT101IS-LOAD-CAR();
                    VHYT101IW-SS-3A.BUTTON-1 = VHYT101IW.BUTTON-1;
                    VHYT101IW-SS-3A.BUTTONTXT= VHYT101IW.BUTTONTXT;
                    VHYT101IW-SS-3A.COLOR = VHYT101A-DATA.FCOLOR[CNT];
                else
                    if (VHYT101A-DATA.YRD-SUB-LOC[CNT] == "SS-3B")
                        VHYT101IS-LOAD-CAR();
                        VHYT101IW-SS-3B.BUTTON-1 = VHYT101IW.BUTTON-1;
                        VHYT101IW-SS-3B.BUTTONTXT = VHYT101IW.BUTTONTXT;
