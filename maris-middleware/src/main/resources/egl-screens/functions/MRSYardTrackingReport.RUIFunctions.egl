Function VHYT105IS-INIT () 
    VHYT105IS-CLEAR();
    VHYT105IW-PASSVAL.YRD-TRKG-YRD = "DY";
    VHYT105A_CRIT.YRD-TRKG-YRD = "DY";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYTX5I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT105A";

    
    try
        call "VHYTX5A"(XDCONTROL, VHYT105A_CRIT, VHYT105A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

  
    if (XXEXT_CALL_Level77Items.URC == 0)  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT105IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHYT105IS-LOAD () 
    COUNTER = 1;
    while (VHYT105IW-PASSVAL.COUNTER <= XDCONTROL.UROWCNT)
        if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "DTF-01")
            VHYT105IS-DTF-01();
        else
            if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "DTF-02")
                VHYT105IS-DTF-02();
            else
                if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "DTF-03")
                    VHYT105IS-DTF-03();
                else
	                if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "DTF-04")
	                    VHYT105IS-DTF-04();
	                else
	                    if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "RR-1A")
	                        VHYT105IS-RR-1A();
	                    else
	                        if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "SS-06")
	                            VHYT105IS-SS-06();
	                        else
	                            if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "RT-1")
	                                VHYT105IS-RT-1();
	                            else
	                                if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "RT-2")
	                                    VHYT105IS-RT-2();
	                                else
		                                if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "YT")
		                                    VHYT105IS-YT();
		                                end
	                                end
	                            end
	                        end
	                    end
                    end
                end
            end
        end
        if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "ST-03")
            VHYT105IS-ST-03();
        else
            if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "ST-04")
                VHYT105IS-ST-04();
            else
                if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "ST-05")
                    VHYT105IS-ST-05();
                else
                    if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "ST-06")
                        VHYT105IS-ST-06();
                    else
                        if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "ST-07")
                            VHYT105IS-ST-07();
                        else
                            if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "ST-08")
                                VHYT105IS-ST-08();
                            else
                                if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "ST-09")
                                    VHYT105IS-ST-09();
                                else
                                    if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "ST-10")
                                        VHYT105IS-ST-10();
                                    else
                                        if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "ST-11")
                                            VHYT105IS-ST-11();
                                        else
                                            if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "ST-12")
                                                VHYT105IS-ST-12();
                                            else
                                                if (VHYT105A_DATA.YRD-SUB-LOC[COUNTER] == "ST-13")
                                                    VHYT105IS-ST-13();
                                                end
