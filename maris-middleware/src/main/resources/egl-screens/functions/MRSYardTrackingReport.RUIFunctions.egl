        							VHYT100IW-RR-3B.CAR-COLOR-B = "GREY80";
                                end
                            end
                        end
                    end
                end
            end
        end
        CNT = CNT + 1;
    end
end 

Function VHYT100IS-LOAD-CAR () 
    VHYT100IW.BUTTON-1 = " ";
    if (VHYT100A-DATA.POSN-NO[CNT] == 1)
    	VHYT100IW.CAR-1 = VHYT100A-DATA.CAR-NO[CNT];
        if (VHYT100A-DATA.VAGen_ORIENTATION[CNT] == VHYT100A-DATA.LFT-ORIENTATION-CD[CNT])
            VHYT100IW.LFT-OR-1 = VHYT100A-DATA.VAGen_ORIENTATION[CNT];
            
    		
    		
        else
            VHYT100IW.RGT-OR-1 = VHYT100A-DATA.VAGen_ORIENTATION[CNT];
            
        end   
        VHYT100IW.BUTTONTXT = VHYT100A-DATA.BUTTONTXT[CNT];   	
    end
end 


