                        end
                    end
                end
            end
        end
        if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "RR-1A")
            VHYT100IS-RR-1A();
        else
            if (VHYT100A-DATA.YRD-SUB-LOC[CNT] == "RR-1B")
