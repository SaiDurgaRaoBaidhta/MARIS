                                        VHYT100IW-SS-5B.BUTTON-1 = VHYT100IW.BUTTON-1;
                                        VHYT100IW-SS-5B.BUTTONTXT = VHYT100IW.BUTTONTXT;
                                        VHYT100IW-SS-5B.CAR-COLOR = VHYT100A-DATA.FCOLOR[CNT];
        				    			VHYT100IW-SS-5B.CAR-COLOR-B = "GREY80";
                                    else
