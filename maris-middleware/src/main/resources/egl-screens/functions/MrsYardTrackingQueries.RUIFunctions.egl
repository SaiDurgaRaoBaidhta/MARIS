

package MrsYardTrackingQueries;


Function VHYT25IS-FINALCT ()
   
    ICT = 1;
    SHOPCOUNT = 0;
    while (ICT <= VHYT30IW.CARCOUNT)
        if (VHYT30IW-ARRAY.SUB-LOC[ICT] == "SHOP  ")
            SHOPCOUNT = SHOPCOUNT + 1;
        end
        ICT = ICT + 1;
    end
    VHYT25IW.GRAND_TOTAL_CARS = VHYT25IW.CARCT + VHYT30IW.SHOPCOUNT;
end 

Function VHYT25IS-GET-DATA ()
  
  
  
  
  
  
  
   
    VHYT25A_CRIT.YRD-TRKG-YRD = VHYT25W_PASSVALUE.YRD-TRKG-YRD;


  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT25A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT25I";
    set VHYT25A_DATA empty;
    set VHYT25IW-ARRAY empty;
    VHYT25IW.NUMCT = 0;
    VHYT25IW.CARCT = 0;
    VHYT25IW.AVERAGE_TIME = " ";


    
    try
        call "VHYT25A"(XDCONTROL, VHYT25A_CRIT, VHYT25A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHYT25IW.NUMCT = XDCONTROL.UROWCNT;
            VHYT25IW-TRIGGERS.REFORMAT = "Y";
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
  
  
   
    end
end 

Function VHYT25IS-INITIAL ()
  
   
    VHYT25IW.RUN_DATE = VGVar.currentFormattedGregorianDate;
    VHYT25IW.SHOP = "HAYWARD SHOP";
    if (VHYT25W_PASSVALUE.YRD-TRKG-YRD == "HY")
        VHYT25IW.SHOP = "HAYWARD SHOP";
    end
    if (VHYT25W_PASSVALUE.YRD-TRKG-YRD == "CY")
        VHYT25IW.SHOP = "CONCORD SHOP";
    end
    if (VHYT25W_PASSVALUE.YRD-TRKG-YRD == "RY")
        VHYT25IW.SHOP = "RICHMOND SHOP";
    end
    if (VHYT25W_PASSVALUE.YRD-TRKG-YRD == "DY")
        VHYT25IW.SHOP = "DALY CITY SHOP";
    end
    if (VHYT25W_PASSVALUE.YRD-TRKG-YRD == "DPX")
        VHYT25IW.SHOP = "DUBLIN/PLEASANTON";
    end
    if (VHYT25W_PASSVALUE.YRD-TRKG-YRD == "PBX")
        VHYT25IW.SHOP = "PITTSBURG/BAYPOINT";
    end
    if (VHYT25W_PASSVALUE.YRD-TRKG-YRD == "MBX")
        VHYT25IW.SHOP = "MILLBRAE STORAGE";
    end
    if (VHYT25W_PASSVALUE.YRD-TRKG-YRD == "SVB")
        VHYT25IW.SHOP = "BERRYESSA STORAGE";  
    end
end 

Function VHYT25IS-REFORMAT ()
  
  
  
  
  
  
   
    if (VHYT25A_CRIT.YRD-TRKG-YRD == "HY")
        VHYT30IW.TRANSFER-TRACK = "T-24 T-23A";
    end
    set VHYT25IW-ARRAY empty;
    VHYT25IW.GRAND-TOTAL-HRS = 0;
    VHYT25IW.GRAND-TOTAL-MINS = 0;

  
    VHYT25IW.RUN_TIME = VHYT25A_DATA.CURRENT-TIME[1];
  
    VHYT25IW.RUN_TIME_TOTAL_MIN = (VHYT25IW.RHRS-IN * 60) + VHYT25IW.RMIN-IN;
    CARCT = 0;
    ICT = 1;
    T24CT = 0;
    while (ICT <= XDCONTROL.UROWCNT)
  
        VHYT25IW-ARRAY.SUB-LOC[ICT] = VHYT25A_DATA.YRD-SUB-LOC[ICT];
        VHYT25IW-ARRAY.POS[ICT] = VHYT25A_DATA.POSN-NO[ICT];

   
  
        VHYT25IW-ARRAY.STATUS1[ICT] = VHYT25A_DATA.VEH-STAT[ICT];
        if (VHYT25A_DATA.TRAIN-INCD-IND[ICT] == "Y")
            VHYT25IW-ARRAY.TI[ICT] = "TI";
        else
            VHYT25IW-ARRAY.TI[ICT] = " ";
        end
        VHYT25IW-ARRAY.DATE_IN_SHOP[ICT] = VHYT25A_DATA.DATE-IN-SHOP[ICT];
  
        VHYT25IW-ARRAY.TIME_IN_SHOP[ICT] = VHYT25A_DATA.TIME-IN-HHMM[ICT];
  
        VHYT25IW-ARRAY.REASON[ICT] = VHYT25A_DATA.MOVE-REASON-DSC[ICT];
        VHYT25IW-ARRAY.CAR[ICT] = VHYT25A_DATA.CAR-NO[ICT];

  
        if (VHYT25A_DATA.CAR-LETTER[ICT] != "Z")
  
            if (VHYT25A_DATA.VAGen_ORIENTATION[ICT] == VHYT25A_DATA.RGT-ORIENT-CD[ICT])
                VHYT25IW-ARRAY.ORIENT2[ICT] = VHYT25A_DATA.RGT-ORIENT-CD[ICT];
                VHYT25IW-ARRAY.ORIENT1[ICT] = " ";
            end
  
            if (VHYT25A_DATA.VAGen_ORIENTATION[ICT] == VHYT25A_DATA.LFT-ORIENT-CD[ICT])
                VHYT25IW-ARRAY.ORIENT1[ICT] = VHYT25A_DATA.LFT-ORIENT-CD[ICT];
                VHYT25IW-ARRAY.ORIENT2[ICT] = " ";
            end
        else
            VHYT25IW-ARRAY.ORIENT1[ICT] = " ";
            VHYT25IW-ARRAY.ORIENT2[ICT] = " ";
        end

  
  
  
        if (VHYT25A_DATA.YRD-SUB-LOC[ICT] != "T-24      ")

  

  
  
  
  
            VHYT25IWORK.EDAYS-IN = VHYT25A_DATA.TS-DD[ICT] + (VHYT25A_DATA.TS-MO[ICT] * 30) + (VHYT25A_DATA.TS-YR[ICT] * 365);
            VHYT25IWORK.EHRS-IN = VHYT25A_DATA.TS-HH[ICT];
            VHYT25IWORK.EMIN-IN = VHYT25A_DATA.TS-MM[ICT];
  
  
            VHYT25IWORK.TOTAL-ELAP-MINS = (VHYT25IWORK.EDAYS-IN * 1440) + (VHYT25IWORK.EHRS-IN * 60) + VHYT25IWORK.EMIN-IN;

  
            if (VHYT25IWORK.EMIN-IN > 30)
                VHYT25IWORK.EHRS-IN = VHYT25IWORK.EHRS-IN + 1;
            end
  
            if (VHYT25IWORK.EHRS-IN == 24)
                VHYT25IWORK.EHRS-IN = 0;
                VHYT25IWORK.EDAYS-IN = VHYT25IWORK.EDAYS-IN + 1;
            end


  
   

  
            VHYT25IW.GRAND-TOTAL-HRS = VHYT25IW.GRAND-TOTAL-HRS + ((VHYT25IWORK.EDAYS-IN * 24) + VHYT25IWORK.EHRS-IN);

  
  
            VHYT25IWORK.ECOLON1 = "-Days ";
  
  

  
            VHYT25IWORK.ECOLON2 = "-Hrs";
  
  
            VHYT25IWORK.EDAYS-IN2 = VHYT25IWORK.EDAYS-IN;
            VHYT25IWORK.ECOLON12 = VHYT25IWORK.ECOLON1;
            VHYT25IWORK.EHRS-IN2 = VHYT25IWORK.EHRS-IN;
            VHYT25IWORK.ECOLON22 = VHYT25IWORK.ECOLON2;
            VHYT25IW-ARRAY.ELAPSED-TIME[ICT] = VHYT25IWORK.ELAP-TIME2;

  
            CARCT = CARCT + 1;
        else 
            T24CT = T24CT + 1;
             
        end
        ICT = ICT + 1;
    end

  
  
  

  
    VHYT25IW.TOTAL_AVG_HRS = VHYT25IW.GRAND-TOTAL-HRS / CARCT;


  
    VHYT25IW.AVG_DAYS = VHYT25IW.TOTAL_AVG_HRS / 24;
    VHYT25IW.AVG_HRS = VHYT25IW.TOTAL_AVG_HRS - (VHYT25IW.AVG_DAYS * 24);
  

  
    VHYT25IW.AVG_DOT1 = "-Days ";
  
  
  
  
    VHYT25IW.AVG_DOT2 = "-Hrs";
  


  
    CARCT = CARCT + T24CT;

  
    VHYT25IW-TRIGGERS.PUSH-DATA = "Y";
end 

Function VHYT26IS-CALREASON ()
  
   
    ICT = 1;
    while (ICT <= RCT) 
        VHYT26IW-REASON.CODE[ICT] = VHYT26B_DATA.MOVE-REASON-CD[ICT];
        VHYT26IW-REASON.REASON[ICT] = VHYT26B_DATA.MOVE-REASON-DSC[ICT];
        VHYT26IW-REASON.TOTAL_CARS[ICT] = 0; 
        ICT = ICT + 1;
    end

  
    TOTCT = RCT + 1; 
    VHYT26IW-REASON.OUT_OF_SERVICE[TOTCT] = "          Cars Out of Service Grand Totals:";

  
    ICT = 1;
    while (ICT <= CARCT) 
        XCT = 1; 
        while (XCT <= RCT)
            if (VHYT26IW-REASON.CODE[XCT] == VHYT26IW-ARRAY.CODE[ICT])
                VHYT26IW-REASON.TOTAL_CARS[XCT] = VHYT26IW-REASON.TOTAL_CARS[XCT] + 1;
  				
  				
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "A")
                    VHYT26IW-REASON.TOTAL_ACARS[XCT] = VHYT26IW-REASON.TOTAL_ACARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "B")
                    VHYT26IW-REASON.TOTAL_BCARS[XCT] = VHYT26IW-REASON.TOTAL_BCARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "C")
                    VHYT26IW-REASON.TOTAL_CCARS[XCT] = VHYT26IW-REASON.TOTAL_CCARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "D")
                    VHYT26IW-REASON.TOTAL_DCARS[XCT] = VHYT26IW-REASON.TOTAL_DCARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "E")
                    VHYT26IW-REASON.TOTAL_ECARS[XCT] = VHYT26IW-REASON.TOTAL_ECARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "L")
                    VHYT26IW-REASON.TOTAL_LCARS[XCT] = VHYT26IW-REASON.TOTAL_LCARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "M")
                    VHYT26IW-REASON.TOTAL_MCARS[XCT] = VHYT26IW-REASON.TOTAL_MCARS[XCT] + 1;
                end                
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "K")
                    VHYT26IW-REASON.TOTAL_KCARS[XCT] = VHYT26IW-REASON.TOTAL_KCARS[XCT] + 1;
                end
            end
            XCT = XCT + 1;
        end 
        ICT = ICT + 1;
    end 

  
  
    XCT = 1; 
    while (XCT <= RCT)
        VHYT26IW-REASON.TOTAL_ACARS[TOTCT] = VHYT26IW-REASON.TOTAL_ACARS[TOTCT] + VHYT26IW-REASON.TOTAL_ACARS[XCT];
        VHYT26IW-REASON.TOTAL_BCARS[TOTCT] = VHYT26IW-REASON.TOTAL_BCARS[TOTCT] + VHYT26IW-REASON.TOTAL_BCARS[XCT];
        VHYT26IW-REASON.TOTAL_CCARS[TOTCT] = VHYT26IW-REASON.TOTAL_CCARS[TOTCT] + VHYT26IW-REASON.TOTAL_CCARS[XCT];
        VHYT26IW-REASON.TOTAL_DCARS[TOTCT] = VHYT26IW-REASON.TOTAL_DCARS[TOTCT] + VHYT26IW-REASON.TOTAL_DCARS[XCT];
        VHYT26IW-REASON.TOTAL_ECARS[TOTCT] = VHYT26IW-REASON.TOTAL_ECARS[TOTCT] + VHYT26IW-REASON.TOTAL_ECARS[XCT];
        
        VHYT26IW-REASON.TOTAL_CARS[TOTCT] = VHYT26IW-REASON.TOTAL_CARS[TOTCT] + VHYT26IW-REASON.TOTAL_CARS[XCT];
        XCT = XCT + 1;
    end
  
  
    VHYT26-HYSUM.CAR_TYPE[1] = "A CARS ";
    VHYT26-HYSUM.TOTAL_CY[1] = VHYT26-HYARD.CY-A;
    VHYT26-HYSUM.TOTAL_DY[1] = VHYT26-HYARD.DY-A;
    VHYT26-HYSUM.TOTAL_HY[1] = VHYT26-HYARD.HY-A;
    VHYT26-HYSUM.TOTAL_RY[1] = VHYT26-HYARD.RY-A;
    VHYT26-HYSUM.TOTAL[1] = VHYT26-HYARD.CY-A + VHYT26-HYARD.DY-A + VHYT26-HYARD.HY-A + VHYT26-HYARD.RY-A;
    VHYT26-HYSUM.CAR_TYPE[2] = "B CARS ";
    VHYT26-HYSUM.TOTAL_CY[2] = VHYT26-HYARD.CY-B;
    VHYT26-HYSUM.TOTAL_DY[2] = VHYT26-HYARD.DY-B;
    VHYT26-HYSUM.TOTAL_HY[2] = VHYT26-HYARD.HY-B;
    VHYT26-HYSUM.TOTAL_RY[2] = VHYT26-HYARD.RY-B;
    VHYT26-HYSUM.TOTAL[2] = VHYT26-HYARD.CY-B + VHYT26-HYARD.DY-B + VHYT26-HYARD.HY-B + VHYT26-HYARD.RY-B;
    VHYT26-HYSUM.CAR_TYPE[3] = "C CARS ";
    VHYT26-HYSUM.TOTAL_CY[3] = VHYT26-HYARD.CY-C;
    VHYT26-HYSUM.TOTAL_DY[3] = VHYT26-HYARD.DY-C;
    VHYT26-HYSUM.TOTAL_HY[3] = VHYT26-HYARD.HY-C;
    VHYT26-HYSUM.TOTAL_RY[3] = VHYT26-HYARD.RY-C;
    VHYT26-HYSUM.TOTAL[3] = VHYT26-HYARD.CY-C + VHYT26-HYARD.DY-C + VHYT26-HYARD.HY-C + VHYT26-HYARD.RY-C;
    VHYT26-HYSUM.CAR_TYPE[4] = "D CARS ";
    VHYT26-HYSUM.TOTAL_CY[4] = VHYT26-HYARD.CY-D;
    VHYT26-HYSUM.TOTAL_DY[4] = VHYT26-HYARD.DY-D;
    VHYT26-HYSUM.TOTAL_HY[4] = VHYT26-HYARD.HY-D;
    VHYT26-HYSUM.TOTAL_RY[4] = VHYT26-HYARD.RY-D;
    VHYT26-HYSUM.TOTAL[4] = VHYT26-HYARD.CY-D + VHYT26-HYARD.DY-D + VHYT26-HYARD.HY-D + VHYT26-HYARD.RY-D;
    VHYT26-HYSUM.CAR_TYPE[5] = "E CARS ";
    VHYT26-HYSUM.TOTAL_CY[5] = VHYT26-HYARD.CY-E;
    VHYT26-HYSUM.TOTAL_DY[5] = VHYT26-HYARD.DY-E;
    VHYT26-HYSUM.TOTAL_HY[5] = VHYT26-HYARD.HY-E;
    VHYT26-HYSUM.TOTAL_RY[5] = VHYT26-HYARD.RY-E;
    VHYT26-HYSUM.TOTAL[5] = VHYT26-HYARD.CY-E + VHYT26-HYARD.DY-E + VHYT26-HYARD.HY-E + VHYT26-HYARD.RY-E;

    VHYT26-HYSUM.CAR_TYPE[6] = "l CARS ";
    VHYT26-HYSUM.TOTAL_CY[6] = VHYT26-HYARD.CY-L;
    VHYT26-HYSUM.TOTAL_DY[6] = VHYT26-HYARD.DY-L;
    VHYT26-HYSUM.TOTAL_HY[6] = VHYT26-HYARD.HY-L;
    VHYT26-HYSUM.TOTAL_RY[6] = VHYT26-HYARD.RY-L;
    VHYT26-HYSUM.TOTAL[6] = VHYT26-HYARD.CY-L + VHYT26-HYARD.DY-L + VHYT26-HYARD.HY-L + VHYT26-HYARD.RY-L;
    VHYT26-HYSUM.CAR_TYPE[7] = "M CARS ";
    VHYT26-HYSUM.TOTAL_CY[7] = VHYT26-HYARD.CY-M;
    VHYT26-HYSUM.TOTAL_DY[7] = VHYT26-HYARD.DY-M;
    VHYT26-HYSUM.TOTAL_HY[7] = VHYT26-HYARD.HY-M;
    VHYT26-HYSUM.TOTAL_RY[7] = VHYT26-HYARD.RY-M;
    VHYT26-HYSUM.TOTAL[7] = VHYT26-HYARD.CY-M + VHYT26-HYARD.DY-M + VHYT26-HYARD.HY-M + VHYT26-HYARD.RY-M;
    VHYT26-HYSUM.CAR_TYPE[8] = "K CARS ";
    VHYT26-HYSUM.TOTAL_CY[8] = VHYT26-HYARD.CY-K;
    VHYT26-HYSUM.TOTAL_DY[8] = VHYT26-HYARD.DY-K;
    VHYT26-HYSUM.TOTAL_HY[8] = VHYT26-HYARD.HY-K;
    VHYT26-HYSUM.TOTAL_RY[8] = VHYT26-HYARD.RY-K;
    VHYT26-HYSUM.TOTAL[8] = VHYT26-HYARD.CY-K + VHYT26-HYARD.DY-K + VHYT26-HYARD.HY-K + VHYT26-HYARD.RY-K;
             
    VHYT26-HYSUM.CAR_TYPE[9] = "TOTAL CARS BY HOME YARD";
    VHYT26-HYSUM.TOTAL_CY[9] = VHYT26-HYSUM.TOTAL_CY[1] + VHYT26-HYSUM.TOTAL_CY[2] + VHYT26-HYSUM.TOTAL_CY[3]+ VHYT26-HYSUM.TOTAL_CY[4] + 
    	VHYT26-HYSUM.TOTAL_CY[5] + VHYT26-HYSUM.TOTAL_CY[6] + VHYT26-HYSUM.TOTAL_CY[7] + VHYT26-HYSUM.TOTAL_CY[8];
    VHYT26-HYSUM.TOTAL_DY[9] = VHYT26-HYSUM.TOTAL_DY[1] + VHYT26-HYSUM.TOTAL_DY[2] + VHYT26-HYSUM.TOTAL_DY[3]+ VHYT26-HYSUM.TOTAL_DY[4] + 
    	VHYT26-HYSUM.TOTAL_DY[5] + VHYT26-HYSUM.TOTAL_DY[6] + VHYT26-HYSUM.TOTAL_DY[7] + VHYT26-HYSUM.TOTAL_DY[8];
    VHYT26-HYSUM.TOTAL_HY[9] = VHYT26-HYSUM.TOTAL_HY[1] + VHYT26-HYSUM.TOTAL_HY[2] + VHYT26-HYSUM.TOTAL_HY[3]+ VHYT26-HYSUM.TOTAL_HY[4] + 
    	VHYT26-HYSUM.TOTAL_HY[5] + VHYT26-HYSUM.TOTAL_HY[6] + VHYT26-HYSUM.TOTAL_HY[7] + VHYT26-HYSUM.TOTAL_HY[8];
    VHYT26-HYSUM.TOTAL_RY[9] = VHYT26-HYSUM.TOTAL_RY[1] + VHYT26-HYSUM.TOTAL_RY[2] + VHYT26-HYSUM.TOTAL_RY[3]+ VHYT26-HYSUM.TOTAL_RY[4] + 
    	VHYT26-HYSUM.TOTAL_RY[5] + VHYT26-HYSUM.TOTAL_RY[6] + VHYT26-HYSUM.TOTAL_RY[7] + VHYT26-HYSUM.TOTAL_RY[8];
    VHYT26-HYSUM.TOTAL[9] = VHYT26-HYSUM.TOTAL_CY[9] + VHYT26-HYSUM.TOTAL_DY[9] + VHYT26-HYSUM.TOTAL_HY[9] + VHYT26-HYSUM.TOTAL_RY[9];
  
  
    VHYT26IW-TRIGGERS.PUSH-DATA-2 = "Y";
end 

Function VHYT26IS-COPYARRAY ()
  

  
  
   
    XCT = 1;
    ICT = 1;
    while (ICT <= NUMCT) 
        if (VHYT26IW-ARRAY.SUB-LOC[ICT] != VHYT30IW.TRANSFER-TRACK)
            VHYT26IW-COPY.SUB-LOC[XCT] = VHYT26IW-ARRAY.SUB-LOC[ICT];
            VHYT26IW-COPY.POS[XCT] = VHYT26IW-ARRAY.POS[ICT];
            VHYT26IW-COPY.STATUS[XCT] = VHYT26IW-ARRAY.STATUS[ICT];
            VHYT26IW-COPY.DATE_IN_YRD[XCT] = VHYT26IW-ARRAY.DATE_IN_YRD[ICT];
  
            VHYT26IW-COPY.TIME_IN_YRD[XCT] = VHYT26IW-ARRAY.TIME_IN_YRD[ICT];
  
            VHYT26IW-COPY.OUT_OF_SERVICE[XCT] = VHYT26IW-ARRAY.REASON[ICT];
            VHYT26IW-COPY.CAR_INFO[XCT] = VHYT26IW-ARRAY.CAR_INFO[ICT];
            VHYT26IW-COPY.HOME_YRD[XCT] = VHYT26IW-ARRAY.HOME_YRD[ICT];
            VHYT26IW-COPY.ELAPSED-TIME[XCT] = VHYT26IW-ARRAY.ELAPSED-TIME[ICT];
  
            if (VHYT26IW-COPY.EDAYS-IN-ONE[XCT] == "0")
                VHYT26IW-COPY.EDAYS-IN-ONE[XCT] = " ";
            end
            if (VHYT26IW-COPY.EDAYS-IN-TWO[XCT] == "0")
                VHYT26IW-COPY.EDAYS-IN-TWO[XCT] = " ";
            end
            if (VHYT26IW-COPY.EDAYS-IN-THREE[XCT] == "0")
                VHYT26IW-COPY.EDAYS-IN-THREE[XCT] = " ";
            end
            XCT = XCT + 1;
        end
        ICT = ICT + 1;
    end

  
    VHYT26IW-TRIGGERS.PUSH-DATA = "Y";
end 

Function VHYT26IS-EXIT () 
    set VHYT26-HYSUM empty;
    set VHYT26C_DATA empty;
end 

Function VHYT26IS-GET-DATA ()
  
  
  
  
  
  
  
   
    VHYT26A_CRIT.YRD-TRKG-YRD = VHYT26W_PASSVALUE.YRD-TRKG-YRD;


  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT26A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT26I";
    set VHYT26A_DATA empty;
    set VHYT26-HYSUM empty;
    set VHYT26IW-COPY empty;
    set VHYT26IW-REASON empty;
    set VHYT26IW-ARRAY empty;
    VHYT26IW.NUMCT = 0;
    VHYT26IW.CARCT = 0;
    VHYT26IW.AVERAGE_TIME = " ";

    
    try
        call "VHYT26A"(XDCONTROL, VHYT26A_CRIT, VHYT26A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHYT26IW.NUMCT = XDCONTROL.UROWCNT;
            VHYT26IW-TRIGGERS.REFORMAT = "Y";
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
  
  
   
    end
end 

Function VHYT26IS-HYCOUNT ()
  
  

   
    if (VHYT26W_PASSVALUE.YRD-TRKG-YRD != "CY")
        if (VHYT26A_DATA.HOME-YRD[ICT] == "CY" && VHYT26A_DATA.CAR-LETTER[ICT] == "A")
