Function VHYT30IS-REFORMAT ()
  
  
  
  
  
  
   
    if (VHYT30IW.NUMCOUNT > 0)
        set VHYT30IW-ARRAY empty;
  
        VHYT30IW.RUN_TIME = VHYT30A_DATA.CURRENT-TIME[1];
  
        VHYT30IW.RUN_TIME_TOTAL_MIN = (VHYT30IW.RHRS-IN * 60) + VHYT30IW.RMIN-IN;
        CARCOUNT = 0;
        ICOUNT = 1;
        T24COUNT = 0;
        while (ICOUNT <= XDCONTROL.UROWCNT)
  
            VHYT30IW-ARRAY.SUB-LOC[ICOUNT] = VHYT30A_DATA.YRD-SUB-LOC[ICOUNT];
            VHYT30IW-ARRAY.POS[ICOUNT] = VHYT30A_DATA.POSN-NO[ICOUNT];
  

  
            VHYT30IW-ARRAY.STATUS1[ICOUNT] = VHYT30A_DATA.VEH-STAT[ICOUNT];
            if (VHYT30A_DATA.TRAIN-INCD-IND[ICOUNT] == "Y")
                VHYT30IW-ARRAY.TI[ICOUNT] = "TI";
            else
                VHYT30IW-ARRAY.TI[ICOUNT] = " ";
            end

  
  
  
  

  
  

  
            if (VHYT30A_DATA.TSY-DT[ICOUNT] < VHYT30A_DATA.TS-DT[ICOUNT] || VHYT30A_DATA.TS-DT[ICOUNT] == 0)
                VHYT30IW-ARRAY.DATE_IN_SHOP[ICOUNT] = VHYT30A_DATA.DATE-OUT-YRD[ICOUNT];
                VHYT30IW-ARRAY.TIME_IN_SHOP[ICOUNT] = VHYT30A_DATA.Y-TIME-OUT-HHMM[ICOUNT];
  
                VHYT30IW-ARRAY.ORIGIN[ICOUNT] = "YARD";
  
  
                VHYT30IWORK.EDAYS-IN = VHYT30A_DATA.TSY-DD[ICOUNT] + (VHYT30A_DATA.TSY-MO[ICOUNT] * 30) + (VHYT30A_DATA.TSY-YR[ICOUNT] * 365);
                VHYT30IWORK.EHRS-IN = VHYT30A_DATA.TSY-HH[ICOUNT];
                VHYT30IWORK.EMIN-IN = VHYT30A_DATA.TSY-MM[ICOUNT];
            else
                VHYT30IW-ARRAY.DATE_IN_SHOP[ICOUNT] = VHYT30A_DATA.DATE-OUT-SHOP[ICOUNT];
                VHYT30IW-ARRAY.TIME_IN_SHOP[ICOUNT] = VHYT30A_DATA.TIME-OUT-HHMM[ICOUNT];
                VHYT30IW-ARRAY.ORIGIN[ICOUNT] = "SHOP";
  
  
                VHYT30IWORK.EDAYS-IN = VHYT30A_DATA.TS-DD[ICOUNT] + (VHYT30A_DATA.TS-MO[ICOUNT] * 30) + (VHYT30A_DATA.TS-YR[ICOUNT] * 365);
                VHYT30IWORK.EHRS-IN = VHYT30A_DATA.TS-HH[ICOUNT];
                VHYT30IWORK.EMIN-IN = VHYT30A_DATA.TS-MM[ICOUNT];
            end

  
            VHYT30IW-ARRAY.REASON[ICOUNT] = VHYT30A_DATA.MOVE-REASON-DSC[ICOUNT];
            VHYT30IW-ARRAY.CAR[ICOUNT] = VHYT30A_DATA.CAR-NO[ICOUNT];

  
            if (VHYT30A_DATA.CAR-LETTER[ICOUNT] != "Z")
  
                if (VHYT30A_DATA.VAGen_ORIENTATION[ICOUNT] == VHYT30A_DATA.RGT-ORIENT-CD[ICOUNT])
                    VHYT30IW-ARRAY.ORIENT2[ICOUNT] = VHYT30A_DATA.RGT-ORIENT-CD[ICOUNT];
                    VHYT30IW-ARRAY.ORIENT1[ICOUNT] = " ";
                end
  
                if (VHYT30A_DATA.VAGen_ORIENTATION[ICOUNT] == VHYT30A_DATA.LFT-ORIENT-CD[ICOUNT])
                    VHYT30IW-ARRAY.ORIENT1[ICOUNT] = VHYT30A_DATA.LFT-ORIENT-CD[ICOUNT];
                    VHYT30IW-ARRAY.ORIENT2[ICOUNT] = " ";
                end
            else
                VHYT30IW-ARRAY.ORIENT1[ICOUNT] = " ";
                VHYT30IW-ARRAY.ORIENT2[ICOUNT] = " ";
            end

  

  
  

  
  
            VHYT30IWORK.TOTAL-ELAP-MINS = (VHYT30IWORK.EDAYS-IN * 1440) + (VHYT30IWORK.EHRS-IN * 60) + VHYT30IWORK.EMIN-IN;

  
  
  
  
  
  
  
  
  


  
   

  
            VHYT30IW.GRAND-TOTAL-HRS = VHYT30IW.GRAND-TOTAL-HRS + ((VHYT30IWORK.EDAYS-IN * 24) + VHYT30IWORK.EHRS-IN);

  
  
            VHYT30IWORK.ECOLON1 = "-Day ";
  
  

  
            VHYT30IWORK.ECOLON2 = "-Hrs";
            VHYT30IWORK.ECOLON3 = "-Min";

  
  
  
  
  
  
  

  
  
            VHYT30IW-ARRAY.ELAPSED-TIME[ICOUNT] = VHYT30IWORK.ELAP-TIME;
  
            CARCOUNT = CARCOUNT + 1;
            ICOUNT = ICOUNT + 1;
        end

  
  
  

  
        VHYT30IW.TOTAL_AVG_HRS = VHYT30IW.GRAND-TOTAL-HRS / CARCOUNT;


  
        VHYT30IW.AVG_DAYS = VHYT30IW.TOTAL_AVG_HRS / 24;
        VHYT30IW.AVG_HRS = VHYT30IW.TOTAL_AVG_HRS - (VHYT30IW.AVG_DAYS * 24);
  
        if (VHYT30IW.AVG_DAYS >= 1)
            VHYT30IW.AVG_DOT1 = "-Day ";
        else
            VHYT30IW.AVG_DOT1 = "   ";
            VHYT30IW.AVG_DAYS_CHAR = "  ";
        end
        VHYT30IW.AVG_DOT2 = "-Hrs";
  


  
        CARCOUNT = CARCOUNT + T24COUNT;


  
        VHYT30IW-TRIGGERS.PUSH-DATA = "Y";
    end
end 

