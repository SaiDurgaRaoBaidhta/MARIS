Function VHYT27IS-TEST-DATE ()
  
   
    VHYT27IW.DATE-OK = "Y";
    if (VHYT27IW.REPORT-INDEX == 3 || VHYT27IW.REPORT-INDEX == 4 || VHYT27IW.REPORT-INDEX == 8)
  
        if (VHYT27IW.FROM-MONTH < 1 || VHYT27IW.FROM-MONTH > 12 || VHYT27IW.FROM-DAY < 1 || VHYT27IW.FROM-DAY > 31 || VHYT27IW.FROM-YEAR < 2001)
            VHYT27IW.DATE-OK = "N";
        end
        if (VHYT27IW.TO-MONTH < 1 || VHYT27IW.TO-MONTH > 12 || VHYT27IW.TO-DAY < 1 || VHYT27IW.TO-DAY > 31 || VHYT27IW.TO-YEAR < 2001)
            VHYT27IW.DATE-OK = "N";
        end
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHYT27IW.FROM-DATE;
        MRSCommonCode.XXDATES-CONVERT();
        VHYT27IW.FROM-DATE-DB2 = XXDATEW.DATE-YYYY-MM-DD;
        XXDATEW.DATE-MM-DD-YYYY = VHYT27IW.TO-DATE;
        MRSCommonCode.XXDATES-CONVERT();
        VHYT27IW.TO-DATE-DB2 = XXDATEW.DATE-YYYY-MM-DD;

  
        if (VHYT27IW.FROM-DATE-DB2 <= VHYT27IW.TO-DATE-DB2)
      

        else
            VHYT27IW.DATE-OK = "N";
        end
        if (VHYT27IW.DATE-OK == "N")
            VHYT27IW-TRIGGERS.DATE-ERROR = "Y";
        else
            VHYT27IW-TRIGGERS.RUN-SUBMIT = "Y";
        end
        

  
    else
        VHYT27IW-TRIGGERS.RUN-SUBMIT = "Y";
    end
end 

Function VHYT29IS-CHECK () 
    if (ICOUNT >= 324)
        VHYT29IW.MAX-ROWS = "Y";
    end
end 

Function VHYT29IS-GET-DATA ()
  
  
  
  
  
  
  
   
    set VHYT29A_CRIT empty;
    set VHYT29A_DATA empty;
