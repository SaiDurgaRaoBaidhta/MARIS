    end


  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT29A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT29I";
    set VHYT29A_DATA empty;

    
    try
        call "VHYT29A"(XDCONTROL, VHYT29A_CRIT, VHYT29A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHYT29IW.NUMCOUNT = XDCONTROL.UROWCNT;
            VHYT30IW-TRIGGERS.REFORMAT = "Y";
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
  
  
   
    end
end 

Function VHYT29IS-INITIAL ()
   
    VHYT29IW.RUN_TIME = VGVar.currentFormattedTime;
    VHYT29IW.RUN_DATE = VGVar.currentFormattedGregorianDate;
    VHYT29IW.SHOP = "HAYWARD SHOP";
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "HY")
        VHYT29IW.SHOP = "HAYWARD SHOP";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "CY")
        VHYT29IW.SHOP = "CONCORD SHOP";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "RY")
        VHYT29IW.SHOP = "RICHMOND SHOP";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "DY")
        VHYT29IW.SHOP = "DALY CITY SHOP";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "DPX")
        VHYT29IW.SHOP = "DUBLIN/PLEASANTON";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "PBX")
        VHYT29IW.SHOP = "PITTSBURG/BAYPOINT";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "MBX")
        VHYT29IW.SHOP = "MILLBRAE STORAGE";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "SVB")   
        VHYT29IW.SHOP = "BERRYESSA STORAGE";
    end 
  
    VHYT29IW.MESSAGE1 = "CAR RANGE: ";
    VHYT29IW.MESSAGE2 = " TO ";
    if (VHYT29W_PASSVALUE.FROM-CAR != "    ")
        if (VHYT29W_PASSVALUE.TO-CAR == "    ") 
            VHYT29IW.F-CAR = VHYT29W_PASSVALUE.FROM-CAR;
            VHYT29IW.T-CAR = VHYT29W_PASSVALUE.FROM-CAR;
        end
        if (VHYT29W_PASSVALUE.TO-CAR != "    ") 
            VHYT29IW.F-CAR = VHYT29W_PASSVALUE.FROM-CAR;
            VHYT29IW.T-CAR = VHYT29W_PASSVALUE.TO-CAR;
        end
    else 
        VHYT29IW.F-CAR = "0300";
        VHYT29IW.T-CAR = "2499";
    end
end 

Function VHYT29IS-REFORMAT ()
  
  
  
  
  
  


  
  
  
   
    set VHYT29IW-ARRAY empty;
    ICOUNT = 1;
    CARCOUNT = 0;
    while (ICOUNT <= XDCONTROL.UROWCNT)

  
        if (ICOUNT == 1)
            H-CAR-NO = VHYT29A_DATA.CAR-NO[ICOUNT];
            VHYT29IW-ARRAY.CAR-NO[ICOUNT] = VHYT29A_DATA.CAR-NO[ICOUNT];
        end
        if (ICOUNT > 1)
            if (H-CAR-NO != VHYT29A_DATA.CAR-NO[ICOUNT])
                H-CAR-NO = VHYT29A_DATA.CAR-NO[ICOUNT];
                VHYT29IW-ARRAY.CAR-NO[ICOUNT] = VHYT29A_DATA.CAR-NO[ICOUNT];
            else
                VHYT29IW-ARRAY.CAR-NO[ICOUNT] = " ";
            end
        end
        VHYT29IW-ARRAY.SUB-LOC[ICOUNT] = VHYT29A_DATA.YRD-SUB-LOC[ICOUNT];
        VHYT29IW-ARRAY.POS[ICOUNT] = VHYT29A_DATA.POSN-NO[ICOUNT];
        VHYT29IW-ARRAY.STATUS[ICOUNT] = VHYT29A_DATA.VEH-STAT[ICOUNT];
        VHYT29IW-ARRAY.VAGen_ORIENTATION[ICOUNT] = VHYT29A_DATA.VAGen_ORIENTATION[ICOUNT];
        VHYT29IW-ARRAY.DATE-USER-MOVED[ICOUNT] = VHYT29A_DATA.DATE-USER-MOVED[ICOUNT];
        VHYT29IW-ARRAY.TIME-USER-MOVED[ICOUNT] = VHYT29A_DATA.TIME-USER-MOVED[ICOUNT];
        VHYT29IW-ARRAY.YRD-SUB-LOC-PREV[ICOUNT] = VHYT29A_DATA.YRD-SUB-LOC-PREV[ICOUNT];
  
        if (VHYT29IW-ARRAY.YRD-SUB-LOC-PREV[ICOUNT] == "    ")
            VHYT29IW-ARRAY.YRD-SUB-LOC-PREV[ICOUNT] = VHYT29A_DATA.MOVE-REASON-CD-PRV[ICOUNT];
        end 
        VHYT29IW-ARRAY.POSN-NO-PREV[ICOUNT] = VHYT29A_DATA.POSN-NO-PREV[ICOUNT];
        VHYT29IW-ARRAY.REASON-DESC[ICOUNT] = VHYT29A_DATA.MOVE-REASON-DESC[ICOUNT];
        VHYT29IW-ARRAY.REASON-CD[ICOUNT] = VHYT29A_DATA.MOVE-REASON-CD-NEW[ICOUNT];

  
        CARCOUNT = CARCOUNT + 1;
        ICOUNT = ICOUNT + 1;
    end
  
    VHYT30IW-TRIGGERS.PUSH-DATA = "Y";
end 

