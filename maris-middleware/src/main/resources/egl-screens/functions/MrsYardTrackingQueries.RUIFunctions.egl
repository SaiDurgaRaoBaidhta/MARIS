Function VHYT26IS-INITIAL ()
  
   
    VHYT26IW.RUN_DATE = VGVar.currentFormattedGregorianDate;
    VHYT26IW.SHOP = "HAYWARD YARD";

  
  
    if (VHYT26W_PASSVALUE.YRD-TRKG-YRD == "HY")
        VHYT26IW.SHOP = "HAYWARD YARD";
        VHYT26IW-TRIGGERS.INC-TEST-TRACK = "Y";
    end
    if (VHYT26W_PASSVALUE.YRD-TRKG-YRD == "CY")
        VHYT26IW.SHOP = "CONCORD YARD";
    end
    if (VHYT26W_PASSVALUE.YRD-TRKG-YRD == "RY")
        VHYT26IW.SHOP = "RICHMOND YARD";
    end
    if (VHYT26W_PASSVALUE.YRD-TRKG-YRD == "DY")
        VHYT26IW.SHOP = "DALY CITY YARD";
    end
    if (VHYT26W_PASSVALUE.YRD-TRKG-YRD == "DPX")
        VHYT26IW.SHOP = "DUBLIN/PLEASANTON";
    end
    if (VHYT26W_PASSVALUE.YRD-TRKG-YRD == "PBX")
        VHYT26IW.SHOP = "PITTSBURG/BAYPOINT";
    end
    if (VHYT26W_PASSVALUE.YRD-TRKG-YRD == "MBX")
        VHYT26IW.SHOP = "MILLBRAE STORAGE";
    end   
    if (VHYT26W_PASSVALUE.YRD-TRKG-YRD == "SVB")   
        VHYT26IW.SHOP = "BERRYESSA STORAGE";
    end 
end 

Function VHYT26IS-REASON ()
  
  

  

  
  
  
  
  
  
  
   
    VHYT26B_CRIT.YRD-TRKG-YRD = VHYT26W_PASSVALUE.YRD-TRKG-YRD;

  


  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT26A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT26I";
    set VHYT26B_DATA empty;
    set VHYT26IW-REASON empty;

    
    try
        call "VHYT26B"(XDCONTROL, VHYT26B_CRIT, VHYT26B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHYT26IW.RCT = XDCONTROL.UROWCNT;
        else


  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end
end 

Function VHYT26IS-REFORMAT ()
  
  
   
    if (VHYT26A_CRIT.YRD-TRKG-YRD == "HY")
        VHYT30IW.TRANSFER-TRACK = "T-24 T-23A";
    end
    set VHYT26IW-ARRAY empty;
    set VHYT26-HYARD empty;
    CODECT = 1; 

  
    VHYT26IW.RUN_TIME = VHYT26A_DATA.CURRENT-TIME[1];
  
    VHYT26IW.RUN_TIME_TOTAL_MIN = (VHYT26IW.RHRS-IN * 60) + VHYT26IW.RMIN-IN;
    CARCT = 0;
    ICT = 1;
    T24CT = 0;
    while (ICT <= XDCONTROL.UROWCNT)

  
        VHYT26IW-ARRAY.SUB-LOC[ICT] = VHYT26A_DATA.YRD-SUB-LOC[ICT];
        VHYT26IW-ARRAY.POS[ICT] = VHYT26A_DATA.POSN-NO[ICT];

  
        VHYT26IW-ARRAY.STATUS1[ICT] = VHYT26A_DATA.VEH-STAT[ICT];
        if (VHYT26A_DATA.TRAIN-INCD-IND[ICT] == "Y")
            VHYT26IW-ARRAY.TI[ICT] = "TI";
        else
            VHYT26IW-ARRAY.TI[ICT] = " ";
        end
        VHYT26IW-ARRAY.DATE_IN_YRD[ICT] = VHYT26A_DATA.DATE-IN-YRD[ICT];
  
        VHYT26IW-ARRAY.TIME_IN_YRD[ICT] = VHYT26A_DATA.TIME-IN-HHMM[ICT];
  
        VHYT26IW-ARRAY.CODE[ICT] = VHYT26A_DATA.MOVE-REASON-CD[ICT];
        VHYT26IW-ARRAY.REASON[ICT] = VHYT26A_DATA.MOVE-REASON-DSC[ICT];
        VHYT26IW-ARRAY.CAR[ICT] = VHYT26A_DATA.CAR-NO[ICT];
        VHYT26IW-ARRAY.HOME_YRD[ICT] = VHYT26A_DATA.HOME-YRD[ICT];
        VHYT26IW-ARRAY.CAR-TYPE[ICT] = VHYT26A_DATA.CAR-TYPE[ICT];

  
        if (VHYT26A_DATA.CAR-LETTER[ICT] != "Z")
  
            if (VHYT26A_DATA.VAGen_ORIENTATION[ICT] == VHYT26A_DATA.RGT-ORIENT-CD[ICT])
                VHYT26IW-ARRAY.ORIENT2[ICT] = VHYT26A_DATA.RGT-ORIENT-CD[ICT];
                VHYT26IW-ARRAY.ORIENT1[ICT] = " ";
            end
  
            if (VHYT26A_DATA.VAGen_ORIENTATION[ICT] == VHYT26A_DATA.LFT-ORIENT-CD[ICT])
                VHYT26IW-ARRAY.ORIENT1[ICT] = VHYT26A_DATA.LFT-ORIENT-CD[ICT];
                VHYT26IW-ARRAY.ORIENT2[ICT] = " ";
            end
        else
            VHYT26IW-ARRAY.ORIENT1[ICT] = " ";
            VHYT26IW-ARRAY.ORIENT2[ICT] = " ";
        end
  
  
  
        if (VHYT26A_DATA.YRD-SUB-LOC[ICT] != "T-24      " &&
         VHYT26A_DATA.TIME-IN-YRD[ICT] != "        ")


  
  
  
  
            VHYT26IWORK.EDAYS-IN = VHYT26A_DATA.TS-DD[ICT] + (VHYT26A_DATA.TS-MO[ICT] * 30) + (VHYT26A_DATA.TS-YR[ICT] * 365);
            VHYT26IWORK.EHRS-IN = VHYT26A_DATA.TS-HH[ICT];
            VHYT26IWORK.EMIN-IN = VHYT26A_DATA.TS-MM[ICT];
  
  
            VHYT26IWORK.TOTAL-ELAP-MINS = (VHYT26IWORK.EDAYS-IN * 1440) + (VHYT26IWORK.EHRS-IN * 60) + VHYT26IWORK.EMIN-IN;

  
            VHYT26IW.GRAND-TOTAL-MINS = VHYT26IW.GRAND-TOTAL-MINS + VHYT26IWORK.TOTAL-ELAP-MINS;

  
  
            if (VHYT26IWORK.EMIN-IN > 30)
                VHYT26IWORK.EHRS-IN = VHYT26IWORK.EHRS-IN + 1;
            end
  
            if (VHYT26IWORK.EHRS-IN == 24)
                VHYT26IWORK.EHRS-IN = 0;
                VHYT26IWORK.EDAYS-IN = VHYT26IWORK.EDAYS-IN + 1;
            end

  
   

  
            VHYT26IW.GRAND-TOTAL-HRS = VHYT26IW.GRAND-TOTAL-HRS + ((VHYT26IWORK.EDAYS-IN * 24) + VHYT26IWORK.EHRS-IN);

  
            if (VHYT26IWORK.EDAYS-IN >= 1)
                VHYT26IWORK.ECOLON1 = "-Days ";
            else
                VHYT26IWORK.ECOLON1 = "      ";
            end
            VHYT26IWORK.ECOLON2 = "-Hrs";
  
  
            VHYT26IWORK.EDAYS-IN2 = VHYT26IWORK.EDAYS-IN;
            VHYT26IWORK.ECOLON12 = VHYT26IWORK.ECOLON1;
            VHYT26IWORK.EHRS-IN2 = VHYT26IWORK.EHRS-IN;
            VHYT26IWORK.ECOLON22 = VHYT26IWORK.ECOLON2;
            VHYT26IW-ARRAY.ELAPSED-TIME[ICT] = VHYT26IWORK.ELAP-TIME2;

  

  
            CARCT = CARCT + 1;
        else 
            T24CT = T24CT + 1;
             
        end
        

  
        VHYT26IS-HYCOUNT();
        ICT = ICT + 1;
    end

  
  
    VHYT26IW.TOTAL_AVG_MINS = VHYT26IW.GRAND-TOTAL-MINS / CARCT;

  
    VHYT26IW.AVG_DAYS = VHYT26IW.TOTAL_AVG_MINS / 1440;
    VHYT26IW.AVG_HRS = (VHYT26IW.TOTAL_AVG_MINS - (VHYT26IW.AVG_DAYS * 1440)) / 60;
    VHYT26IW.AVG_MIN = VHYT26IW.TOTAL_AVG_MINS - ((VHYT26IW.AVG_DAYS * 1440) + (VHYT26IW.AVG_HRS * 60));
    if (VHYT26IW.AVG_DAYS >= 1)
        VHYT26IW.AVG_DOT1 = "d ";
    else
        VHYT26IW.AVG_DOT1 = "   ";
    end
    VHYT26IW.AVG_DOT2 = "h ";
    VHYT26IW.AVG_DOT3 = "m";


  
  

  
    VHYT26IW-TRIGGERS.DO-NEWTEST = "Y";
end 

Function VHYT26IS-SORT ()
  
   
    VHYT26C_CRIT.MARIS-SUBSYS = "VEHICLE";
  
    VHYT26C_CRIT.TERM-ID = VHYT26W_PASSVALUE.TERM-ID;
    VHYT26C_CRIT.USER-GRP = "TEST";
    VHYT26C_CRIT.GUI-NAME = "VHYT26";
  
    VHYT26C_CRIT.NUM-OF-ROWS = VHYT26IW.TOTCT;
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT26C";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT32I";
    set VHYT26C_DATA empty;

    
    try
        call "VHYT26C"(XDCONTROL, VHYT26IW-REASON, VHYT26C_CRIT, VHYT26C_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  		
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
		  
		   
		    

        else
		  
		        
		        
		  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end

  
    VHYT26C_DATA.CODE[TOTCT] = "    ";
end 

Function VHYT26IS-TOTCARS ()
   
    ICT = 1;
    YARDCOUNT = 0;
    while (ICT <= VHYT30IW.CARCOUNT)
        if (VHYT30IW-ARRAY.SUB-LOC[ICT] == "YARD  ")
            YARDCOUNT = YARDCOUNT + 1;
        end
        ICT = ICT + 1;
    end
    VHYT26IW.GRAND-TOTAL-CARS = VHYT26IW.NUMCT + VHYT30IW.YARDCOUNT;
end 

Function VHYT26IS-TT-MSG () 
    if (VHYT26W_PASSVALUE.YRD-TRKG-YRD == "HY")
  
        VHYT26IW-TRIGGERS.INC-TEST-TRACK = "Y";
    end
end 

Function VHYT26IW-NEWTEST ()
  
   
    set VHYT26IW-REASON empty;
    IDX = 1;
    CODECT = 1;
    while (IDX <= CARCT)
        if (VHYT26A_DATA.MOVE-REASON-CD[IDX] != "GO " && VHYT26A_DATA.MOVE-REASON-CD[IDX] != "50 ")
            FLAG = "N";
            ZCT = 1;
            while (ZCT <= CODECT)
                if (VHYT26IW-REASON.CODE[ZCT] == VHYT26A_DATA.MOVE-REASON-CD[IDX])
                    FLAG = "Y";
                end
                ZCT = ZCT + 1;
            end
            if (FLAG == "N") 
                VHYT26IW-REASON.CODE[CODECT] = VHYT26A_DATA.MOVE-REASON-CD[IDX];
                VHYT26IW-REASON.REASON[CODECT] = VHYT26A_DATA.MOVE-REASON-DSC[IDX];
                CODECT = CODECT + 1;
            end
        end 
        IDX = IDX + 1;
    end 
    RCT = CODECT - 1;

  
  
    TOTCT = RCT + 1; 
    VHYT26IW-REASON.OUT_OF_SERVICE[TOTCT] = "9999** Cars Out of Service Grand Totals:";

  
    ICT = 1;
    while (ICT <= CARCT) 
        XCT = 1; 
        while (XCT <= RCT)
            if (VHYT26IW-REASON.CODE[XCT] == VHYT26IW-ARRAY.CODE[ICT])
                VHYT26IW-REASON.TOTAL_CARS[XCT] = VHYT26IW-REASON.TOTAL_CARS[XCT] + 1;
  
  
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "A")
                    VHYT26IW-REASON.TOTAL_ACARS[XCT] = VHYT26IW-REASON.TOTAL_ACARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "B")
                    VHYT26IW-REASON.TOTAL_BCARS[XCT] = VHYT26IW-REASON.TOTAL_BCARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "C")
                    VHYT26IW-REASON.TOTAL_CCARS[XCT] = VHYT26IW-REASON.TOTAL_CCARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "D")
                    VHYT26IW-REASON.TOTAL_DCARS[XCT] = VHYT26IW-REASON.TOTAL_DCARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "E")
                    VHYT26IW-REASON.TOTAL_ECARS[XCT] = VHYT26IW-REASON.TOTAL_ECARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "L")
                    VHYT26IW-REASON.TOTAL_LCARS[XCT] = VHYT26IW-REASON.TOTAL_LCARS[XCT] + 1;
                end
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "M")
                    VHYT26IW-REASON.TOTAL_MCARS[XCT] = VHYT26IW-REASON.TOTAL_MCARS[XCT] + 1;
                end 
                if (VHYT26IW-ARRAY.CAR-LETTER[ICT] == "K")
                    VHYT26IW-REASON.TOTAL_KCARS[XCT] = VHYT26IW-REASON.TOTAL_KCARS[XCT] + 1;
                end
            end
            XCT = XCT + 1;
        end 
        ICT = ICT + 1;
    end 

  
  
    XCT = 1; 
    while (XCT <= RCT)
        VHYT26IW-REASON.TOTAL_ACARS[TOTCT] = VHYT26IW-REASON.TOTAL_ACARS[TOTCT] + VHYT26IW-REASON.TOTAL_ACARS[XCT];
        VHYT26IW-REASON.TOTAL_BCARS[TOTCT] = VHYT26IW-REASON.TOTAL_BCARS[TOTCT] + VHYT26IW-REASON.TOTAL_BCARS[XCT];
        VHYT26IW-REASON.TOTAL_CCARS[TOTCT] = VHYT26IW-REASON.TOTAL_CCARS[TOTCT] + VHYT26IW-REASON.TOTAL_CCARS[XCT];
        VHYT26IW-REASON.TOTAL_DCARS[TOTCT] = VHYT26IW-REASON.TOTAL_DCARS[TOTCT] + VHYT26IW-REASON.TOTAL_DCARS[XCT];
        VHYT26IW-REASON.TOTAL_ECARS[TOTCT] = VHYT26IW-REASON.TOTAL_ECARS[TOTCT] + VHYT26IW-REASON.TOTAL_ECARS[XCT];
        VHYT26IW-REASON.TOTAL_LCARS[TOTCT] = VHYT26IW-REASON.TOTAL_LCARS[TOTCT] + VHYT26IW-REASON.TOTAL_LCARS[XCT];
        VHYT26IW-REASON.TOTAL_MCARS[TOTCT] = VHYT26IW-REASON.TOTAL_MCARS[TOTCT] + VHYT26IW-REASON.TOTAL_MCARS[XCT];
        VHYT26IW-REASON.TOTAL_KCARS[TOTCT] = VHYT26IW-REASON.TOTAL_KCARS[TOTCT] + VHYT26IW-REASON.TOTAL_KCARS[XCT];
        VHYT26IW-REASON.TOTAL_CARS[TOTCT] = VHYT26IW-REASON.TOTAL_CARS[TOTCT] + VHYT26IW-REASON.TOTAL_CARS[XCT];
        XCT = XCT + 1;
    end
  
  
    VHYT26-HYSUM.CAR_TYPE[1] = "A CARS ";
    VHYT26-HYSUM.TOTAL_CY[1] = VHYT26-HYARD.CY-A;
    VHYT26-HYSUM.TOTAL_DY[1] = VHYT26-HYARD.DY-A;
    VHYT26-HYSUM.TOTAL_HY[1] = VHYT26-HYARD.HY-A;
    VHYT26-HYSUM.TOTAL_RY[1] = VHYT26-HYARD.RY-A;
    VHYT26-HYSUM.TOTAL[1] = VHYT26-HYARD.CY-A + VHYT26-HYARD.DY-A + VHYT26-HYARD.HY-A + VHYT26-HYARD.RY-A;
    VHYT26-HYSUM.CAR_TYPE[2] = "B CARS ";
    VHYT26-HYSUM.TOTAL_CY[2] = VHYT26-HYARD.CY-B;
    VHYT26-HYSUM.TOTAL_DY[2] = VHYT26-HYARD.DY-B;
    VHYT26-HYSUM.TOTAL_HY[2] = VHYT26-HYARD.HY-B;
    VHYT26-HYSUM.TOTAL_RY[2] = VHYT26-HYARD.RY-B;
    VHYT26-HYSUM.TOTAL[2] = VHYT26-HYARD.CY-B + VHYT26-HYARD.DY-B + VHYT26-HYARD.HY-B + VHYT26-HYARD.RY-B;
    VHYT26-HYSUM.CAR_TYPE[3] = "C CARS ";
    VHYT26-HYSUM.TOTAL_CY[3] = VHYT26-HYARD.CY-C;
    VHYT26-HYSUM.TOTAL_DY[3] = VHYT26-HYARD.DY-C;
    VHYT26-HYSUM.TOTAL_HY[3] = VHYT26-HYARD.HY-C;
    VHYT26-HYSUM.TOTAL_RY[3] = VHYT26-HYARD.RY-C;
    VHYT26-HYSUM.TOTAL[3] = VHYT26-HYARD.CY-C + VHYT26-HYARD.DY-C + VHYT26-HYARD.HY-C + VHYT26-HYARD.RY-C;
    VHYT26-HYSUM.CAR_TYPE[4] = "D CARS ";
    VHYT26-HYSUM.TOTAL_CY[4] = VHYT26-HYARD.CY-D;
    VHYT26-HYSUM.TOTAL_DY[4] = VHYT26-HYARD.DY-D;
    VHYT26-HYSUM.TOTAL_HY[4] = VHYT26-HYARD.HY-D;
    VHYT26-HYSUM.TOTAL_RY[4] = VHYT26-HYARD.RY-D;
    VHYT26-HYSUM.TOTAL[4] = VHYT26-HYARD.CY-D + VHYT26-HYARD.DY-D + VHYT26-HYARD.HY-D + VHYT26-HYARD.RY-D;
    VHYT26-HYSUM.CAR_TYPE[5] = "E CARS ";
    VHYT26-HYSUM.TOTAL_CY[5] = VHYT26-HYARD.CY-E;
    VHYT26-HYSUM.TOTAL_DY[5] = VHYT26-HYARD.DY-E;
    VHYT26-HYSUM.TOTAL_HY[5] = VHYT26-HYARD.HY-E;
    VHYT26-HYSUM.TOTAL_RY[5] = VHYT26-HYARD.RY-E;
    VHYT26-HYSUM.TOTAL[5] = VHYT26-HYARD.CY-E + VHYT26-HYARD.DY-E + VHYT26-HYARD.HY-E + VHYT26-HYARD.RY-E; 
    VHYT26-HYSUM.CAR_TYPE[6] = "L CARS ";
    VHYT26-HYSUM.TOTAL_CY[6] = VHYT26-HYARD.CY-L;
    VHYT26-HYSUM.TOTAL_DY[6] = VHYT26-HYARD.DY-L;
    VHYT26-HYSUM.TOTAL_HY[6] = VHYT26-HYARD.HY-L;
    VHYT26-HYSUM.TOTAL_RY[6] = VHYT26-HYARD.RY-L;
    VHYT26-HYSUM.TOTAL[6] = VHYT26-HYARD.CY-L + VHYT26-HYARD.DY-L + VHYT26-HYARD.HY-L + VHYT26-HYARD.RY-L;
    VHYT26-HYSUM.CAR_TYPE[7] = "M CARS ";
    VHYT26-HYSUM.TOTAL_CY[7] = VHYT26-HYARD.CY-M;
    VHYT26-HYSUM.TOTAL_DY[7] = VHYT26-HYARD.DY-M;
    VHYT26-HYSUM.TOTAL_HY[7] = VHYT26-HYARD.HY-M;
    VHYT26-HYSUM.TOTAL_RY[7] = VHYT26-HYARD.RY-M;
    VHYT26-HYSUM.TOTAL[7] = VHYT26-HYARD.CY-M + VHYT26-HYARD.DY-M + VHYT26-HYARD.HY-M + VHYT26-HYARD.RY-M; 
       
    VHYT26-HYSUM.CAR_TYPE[8] = "K CARS ";
    VHYT26-HYSUM.TOTAL_CY[8] = VHYT26-HYARD.CY-K;
    VHYT26-HYSUM.TOTAL_DY[8] = VHYT26-HYARD.DY-K;
    VHYT26-HYSUM.TOTAL_HY[8] = VHYT26-HYARD.HY-K;
    VHYT26-HYSUM.TOTAL_RY[8] = VHYT26-HYARD.RY-K;
    VHYT26-HYSUM.TOTAL[8] = VHYT26-HYARD.CY-K + VHYT26-HYARD.DY-K + VHYT26-HYARD.HY-K + VHYT26-HYARD.RY-K; 
    VHYT26-HYSUM.CAR_TYPE[9] = "TOTAL CARS BY HOME YARD";
    VHYT26-HYSUM.TOTAL_CY[9] = VHYT26-HYSUM.TOTAL_CY[1] + VHYT26-HYSUM.TOTAL_CY[2] + VHYT26-HYSUM.TOTAL_CY[3] + VHYT26-HYSUM.TOTAL_CY[4] + 
    	VHYT26-HYSUM.TOTAL_CY[5] + VHYT26-HYSUM.TOTAL_CY[6]+ VHYT26-HYSUM.TOTAL_CY[7]+ VHYT26-HYSUM.TOTAL_CY[8];
    VHYT26-HYSUM.TOTAL_DY[9] = VHYT26-HYSUM.TOTAL_DY[1] + VHYT26-HYSUM.TOTAL_DY[2] + VHYT26-HYSUM.TOTAL_DY[3] + VHYT26-HYSUM.TOTAL_DY[4] + 
    	VHYT26-HYSUM.TOTAL_DY[5] + VHYT26-HYSUM.TOTAL_DY[6] + VHYT26-HYSUM.TOTAL_DY[7] + VHYT26-HYSUM.TOTAL_DY[8];
    VHYT26-HYSUM.TOTAL_HY[9] = VHYT26-HYSUM.TOTAL_HY[1] + VHYT26-HYSUM.TOTAL_HY[2] + VHYT26-HYSUM.TOTAL_HY[3] + VHYT26-HYSUM.TOTAL_HY[4] + 
    	VHYT26-HYSUM.TOTAL_HY[5] + VHYT26-HYSUM.TOTAL_HY[6] + VHYT26-HYSUM.TOTAL_HY[7] + VHYT26-HYSUM.TOTAL_HY[8];;
    VHYT26-HYSUM.TOTAL_RY[9] = VHYT26-HYSUM.TOTAL_RY[1] + VHYT26-HYSUM.TOTAL_RY[2] + VHYT26-HYSUM.TOTAL_RY[3] + VHYT26-HYSUM.TOTAL_RY[4] + 
    	VHYT26-HYSUM.TOTAL_RY[5] + VHYT26-HYSUM.TOTAL_RY[6] + VHYT26-HYSUM.TOTAL_RY[7] + VHYT26-HYSUM.TOTAL_RY[8] ;
    VHYT26-HYSUM.TOTAL[9] = VHYT26-HYSUM.TOTAL_CY[9] + VHYT26-HYSUM.TOTAL_DY[9] + VHYT26-HYSUM.TOTAL_HY[9] + VHYT26-HYSUM.TOTAL_RY[9];
  
  
    VHYT26IW-TRIGGERS.PUSH-DATA-2 = "Y";
end 

Function VHYT27I-DATES ()
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT27I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT27";

    
    try
        call "VHYT27B"(XDCONTROL, VHYT27B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
        	
        	
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHYT27I-DISPLAY () 
    if (VHYT27IW.REPORT-INDEX == 1)
        VHYT27IW-TRIGGERS.RUN-VHYT25I = "Y";
    end
    if (VHYT27IW.REPORT-INDEX == 2)
        VHYT27IW-TRIGGERS.RUN-VHYT26I = "Y";
    end
    if (VHYT27IW.REPORT-INDEX == 3)
        VHYT27IW-TRIGGERS.RUN-VHYT29I = "Y";
    end
    if (VHYT27IW.REPORT-INDEX == 4)
        VHYT27IW-TRIGGERS.RUN-VHYT33I = "Y";
    end
    if (VHYT27IW.REPORT-INDEX == 6)
        VHYT27IW-TRIGGERS.RUN-VHYT32I = "Y";
    end
    if (VHYT27IW.REPORT-INDEX == 7)
        VHYT27IW-TRIGGERS.RUN-VHYT32I = "Y";
    end
end 

Function VHYT27I-HARD-COPY () 
    if (PRINT-IDX > 0)
        ENABLE-HARD = "Y";
        VHYT27IW-PASSVALUE.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRINT-IDX];
    else
        DISABLE-HARD = "Y";
    end
end 

Function VHYT27IS-BEGIN ()
  
  
  
  
  
  
  
   
    if (VHYT27IW-PASSVALUE.WHICH-REPORT == "SHOPSTAT")
        VHYT27IW.REPORT-INDEX = 1;
    end
    if (VHYT27IW-PASSVALUE.WHICH-REPORT == "YARD-LOC")
        VHYT27IW.REPORT-INDEX = 2;
    end
    if (VHYT27IW-PASSVALUE.WHICH-REPORT == "CAR-HIST")
        VHYT27IW.REPORT-INDEX = 3;
    end
    if (VHYT27IW-PASSVALUE.WHICH-REPORT == "YARDHIST")
        VHYT27IW.REPORT-INDEX = 4;
    end
    if (VHYT27IW-PASSVALUE.WHICH-REPORT == "0400-RPT")
        VHYT27IW.REPORT-INDEX = 5;
    end
    if (VHYT27IW-PASSVALUE.WHICH-REPORT == "OSDETAIL")
        VHYT27IW.REPORT-INDEX = 6;
    end
    if (VHYT27IW-PASSVALUE.WHICH-REPORT == "OOSSUM")
        VHYT27IW.REPORT-INDEX = 7;
    end
    if (VHYT27IW-PASSVALUE.WHICH-REPORT == "04XX-RPT")
        VHYT27IW.REPORT-INDEX = 8;
    end


  
  
  
  
  
  
  
  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "WS100I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS70A01";

    
    try
        call "WS70A01"(XDCONTROL, WS70A01_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT27IW.PRINTER-COUNT = XDCONTROL.UROWCNT;
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
  
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT27I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT27";

    
    try
        call "VHYT27B"(XDCONTROL, VHYT27B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
  
  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "WS100I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS70A01";

    
    try
        call "MRSTableMaintenance.VHRT04A"(XDCONTROL, VHRT04A_CRIT, VHRT04A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  
            VHYT27IW.YARD-COUNT = XDCONTROL.UROWCNT;
  
            ICT = 1;
            while (ICT <= VHYT27IW.YARD-COUNT)
                VHYT27IW.YRD[ICT] = VHRT04A_DATA.YRD[ICT];
                VHYT27IW.DASH[ICT] = " - ";
                VHYT27IW.YRD-DESC[ICT] = VHRT04A_DATA.YRD-DESC[ICT];
                ICT = ICT + 1;
            end
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end

  
  
    if (VHYT27IW.REPORT-INDEX > 0)
        if (VHYT27IW.REPORT-INDEX == 1 || VHYT27IW.REPORT-INDEX == 2)
            VHYT27IW-TRIGGERS.ENABLE-DISPLAY = "Y";
            VHYT27IW-TRIGGERS.HIDE-DATE = "Y";
            VHYT27IW-TRIGGERS.HIDE-RANGE = "Y";
        end
        if (VHYT27IW.REPORT-INDEX == 3)
            VHYT27IW-TRIGGERS.ENABLE-DISPLAY = "Y";
            VHYT27IW-TRIGGERS.SHOW-DATE = "Y";
            VHYT27IW-TRIGGERS.SHOW-RANGE = "Y";
        end
        if (VHYT27IW.REPORT-INDEX == 4 || VHYT27IW.REPORT-INDEX == 6 || VHYT27IW.REPORT-INDEX == 7)
            VHYT27IW-TRIGGERS.ENABLE-DISPLAY = "Y";
            VHYT27IW-TRIGGERS.SHOW-DATE = "Y";
            VHYT27IW-TRIGGERS.HIDE-RANGE = "Y";
        end
        if (VHYT27IW.REPORT-INDEX == 5 || VHYT27IW.REPORT-INDEX == 8)
            VHYT27IW-TRIGGERS.DISABLE-DISPLAY = "Y";
            VHYT27IW-TRIGGERS.SHOW-DATE = "Y";
            VHYT27IW-TRIGGERS.HIDE-RANGE = "Y";
        end
        if (VHYT27IW.REPORT-INDEX == 8)
            VHYT27IW-TRIGGERS.HIDE-YARD = "Y";
        else
            VHYT27IW-TRIGGERS.SHOW-YARD = "Y";
        end
        ACCESS-SELECT = "Y";
    end

  
  
    JCT = 1;
    while (JCT <= ICT)
        if (VHYT27IW.YRD[JCT] == VHYT27IW-PASSVALUE.YRD-TRKG-YRD)
            VHYT27IW.YARD-INDEX = JCT;
        end
        JCT = JCT + 1;
    end
end 

Function VHYT27IS-BUTTON () 
    if (VHYT27IW.REPORT-INDEX > 0)
        if (VHYT27IW.REPORT-INDEX < 3)
            VHYT27IW-TRIGGERS.ENABLE-DISPLAY = "Y";
            VHYT27IW-TRIGGERS.HIDE-DATE = "Y";
        else
            VHYT27IW-TRIGGERS.DISABLE-DISPLAY = "Y";
            VHYT27IW-TRIGGERS.SHOW-DATE = "Y";
        end
        ACCESS-SELECT = "Y";
    end
end 

Function VHYT27IS-CLEAR () 
    VHYT27IW.FROM-CAR = " ";
    VHYT27IW.TO-CAR = " ";
end 

Function VHYT27IS-RETURNED () 
    if (VHYT27IW.REPORT-INDEX == 5)
        VHYT27IW-TRIGGERS.DISABLE-DISPLAY = "Y";
    end
    VHYT27IW-TRIGGERS.DISABLE-HARD = "Y";
    ACCESS-SELECT = "N";
end 



Function VHYT27IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  
  
  
  

  
   
    if (VHYT27IW.REPORT-INDEX == 1 || VHYT27IW.REPORT-INDEX == 2)
        set VHYT27A_CRIT empty;
        set VHYT27F_CRIT empty;
  
        VHYT27A_CRIT.YRD-TRKG-YRD = VHYT27IW-PASSVALUE.YRD;
        VHYT27F_CRIT.YRD-TRKG-YRD = VHYT27IW-PASSVALUE.YRD;
        if (VHYT27A_CRIT.YRD-TRKG-YRD == " ")
            VHYT27A_CRIT.YRD-TRKG-YRD = "HY";
            VHYT27F_CRIT.YRD-TRKG-YRD = "HY";
        end
  
        VHYT27A_CRIT.REPT-TYPE = VHYT27IW-PASSVALUE.WHICH-REPORT;
        VHYT27A_CRIT.REPT-CD = VHYT27IW-PASSVALUE.VTAM-NAME;
        VHYT27F_CRIT.REPT-CD = VHYT27IW-PASSVALUE.VTAM-NAME;

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYT27I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT27A";
        if (VHYT27IW-PASSVALUE.WHICH-REPORT == "SHOPSTAT")
    
            try
                call "VHYT27A"(XDCONTROL, VHYT27A_CRIT, VHYT27A_DATA);
            
            end
        else
            if (VHYT27IW-PASSVALUE.WHICH-REPORT == "YARD-LOC")
                try
                    call "VHYT27F"(XDCONTROL, VHYT27F_CRIT, VHYT27F_DATA);
                
                end
            end
        end
        
    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        
       

            else

        


        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end 

  
  
    if (VHYT27IW.REPORT-INDEX == 3)
        set VHYT27C_CRIT empty;
        VHYT27C_CRIT.YRD-TRKG-YRD = VHYT27IW-PASSVALUE.YRD;
        if (VHYT27C_CRIT.YRD-TRKG-YRD == " ")
            VHYT27C_CRIT.YRD-TRKG-YRD = "HY";
        end
        VHYT27C_CRIT.REPT-CD = VHYT27IW-PASSVALUE.VTAM-NAME;
        VHYT27C_CRIT.DATE-REPT-FROM = VHYT27IW.FROM-DATE;
        VHYT27C_CRIT.DATE-REPT-TO = VHYT27IW.TO-DATE;

  
  
  
        if (VHYT27IW.TO-CAR == "    ")
            if (VHYT27IW.FROM-CAR != "    ")
                VHYT27C_CRIT.TO-CAR = VHYT27IW.FROM-CAR;
            else
                VHYT27C_CRIT.TO-CAR = "2999";
            end
        else 
            VHYT27C_CRIT.TO-CAR = VHYT27IW.TO-CAR;
        end
        if (VHYT27IW.FROM-CAR == "    ")
            VHYT27C_CRIT.FROM-CAR = "0300";
        else
            VHYT27C_CRIT.FROM-CAR = VHYT27IW.FROM-CAR;
        end

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYT27I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT27C";

    
        try
            call "VHYT27C"(XDCONTROL, VHYT27C_CRIT, VHYT27C_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        

            else

        


        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end 

  
  
    if (VHYT27IW.REPORT-INDEX == 4)
        set VHYT27D_CRIT empty;
        VHYT27D_CRIT.YRD-TRKG-YRD = VHYT27IW-PASSVALUE.YRD;
        if (VHYT27D_CRIT.YRD-TRKG-YRD == " ")
            VHYT27D_CRIT.YRD-TRKG-YRD = "HY";
        end
