    end

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT32A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT32I";
    set VHYT32A_DATA empty;
    set VHYT32IW-ARRAY empty;
    VHYT32IW.NUMCT = 0;
    VHYT32IW.CARCT = 0;


    
    try
        call "VHYT32A"(XDCONTROL, VHYT32A_CRIT, VHYT32A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHYT32IW.NUMCT = XDCONTROL.UROWCNT;
            VHYT32IW-TRIGGERS.REFORMAT = "Y";
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
  
  
   
    end
end 

Function VHYT32IS-GET-REASO ()
  
  
  
  
  
  
  
  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT32C";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT32I";
    set VHYT32A_DATA empty;

    
    try
        call "VHYT32C"(XDCONTROL, VHYT32C_CRIT, VHYT32C_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHYT32IW.REASON-CT = XDCONTROL.UROWCNT;
            
  
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end
  
  
  
  
  
  
    ICT = 1;
    while (VHYT32IW.ICT <= VHYT32IW.WICT)
        NICT = 1;
  
        while (NICT <= VHYT32IW.REASON-CT)
            if (VHYT32IW-ARRAY.REASON-CD[ICT] == VHYT32C_DATA.MOVE-REASON-CD[NICT])
                VHYT32C_DATA.VAGen_COUNT[NICT] = VHYT32C_DATA.VAGen_COUNT[NICT] + 1;
  
                if (VHYT32IW-ARRAY.DAYS-OOS[ICT] != "  ")
                    VHYT32C_DATA.TOTAL-DAYS[NICT] = VHYT32C_DATA.TOTAL-DAYS[NICT] + VHYT32IW-ARRAY.EDAYS-IN[ICT];
                end
  
                if (VHYT32IW-ARRAY.TIME-OOS[ICT] != " ")
                    VHYT32C_DATA.TOTAL-HOURS[NICT] = VHYT32C_DATA.TOTAL-HOURS[NICT] + VHYT32IW-ARRAY.EHRS-IN[ICT];
                    VHYT32C_DATA.TOTAL-MINUTES[NICT] = VHYT32C_DATA.TOTAL-MINUTES[NICT] + VHYT32IW-ARRAY.EMINS-IN[ICT];
                end
            end 
            NICT = NICT + 1;
        end 
        ICT = ICT + 1;
    end 

  
  
  
  
    ICT = 1;
    NICT = 1;
    while (NICT <= VHYT32IW.REASON-CT)

  
        if (VHYT32C_DATA.VAGen_COUNT[NICT] > 0)
            VHYT32IW-REASONSUM.MOVE-REASON-CD[ICT] = VHYT32C_DATA.MOVE-REASON-CD[NICT];
            VHYT32IW-REASONSUM.MOVE-REASON-DESC[ICT] = VHYT32C_DATA.MOVE-REASON-DSC[NICT];
            VHYT32IW-REASONSUM.VAGen_COUNT[ICT] = VHYT32C_DATA.VAGen_COUNT[NICT];


  
            VHYT32IW-REASONSUM.TOTAL-HOURS[ICT] = (VHYT32C_DATA.TOTAL-DAYS[NICT] * 24) + (VHYT32C_DATA.TOTAL-HOURS[NICT]);
  
            if (VHYT32C_DATA.TOTAL-MINUTES[NICT] > 30)
                VHYT32IW-REASONSUM.TOTAL-HOURS[ICT] = VHYT32IW-REASONSUM.TOTAL-HOURS[ICT] + 1;
            end 
  

  
            VHYT32IW-REASONSUM.AVG-HOURS[ICT] = VHYT32IW-REASONSUM.TOTAL-HOURS[ICT] / VHYT32IW-REASONSUM.VAGen_COUNT[ICT];

  
  
  
  
  
  
            ICT = ICT + 1;
        end 
        NICT = NICT + 1;
    end 

  
    ICT = ICT - 1;

  
    VHYT32D_CRIT.NUM-OF-ROWS = ICT;
    
  
    VHYT32IS-SORTSUM();

  
  
  
    NICT = 1;
    while (NICT <= VHYT32D_CRIT.NUM-OF-ROWS)
        VHYT32IW.TOTAL-REASON-COUNT = VHYT32IW.TOTAL-REASON-COUNT + VHYT32D_DATA.VAGen_COUNT[NICT];
        VHYT32IW.TOTAL-REASON-HOURS = VHYT32IW.TOTAL-REASON-HOURS + VHYT32D_DATA.TOTAL-HOURS[NICT];
        NICT = NICT + 1;
    end


  
    ICT = VHYT32IW.SORTCT + 1; 
  
  
  
  
  
    VHYT32D_DATA.MOVE-REASON-CD[ICT] = " "; 
    VHYT32D_DATA.MOVE-REASON-DESC[ICT] = "                REPORT TOTALS: ";
    VHYT32D_DATA.VAGen_COUNT[ICT] = VHYT32IW.TOTAL-REASON-COUNT;
    VHYT32D_DATA.TOTAL-HOURS[ICT] = VHYT32IW.TOTAL-REASON-HOURS;
  
    if (VHYT32D_DATA.VAGen_COUNT[ICT] > 0)
        VHYT32D_DATA.AVG-HOURS[ICT] = (VHYT32D_DATA.TOTAL-HOURS[ICT] / VHYT32D_DATA.VAGen_COUNT[ICT]) + .5;
    else
        VHYT32D_DATA.AVG-HOURS[ICT] = 0;
    end


  
    VHYT32IW-TRIGGERS.PUSH-SUMMARY = "Y";
end 

Function VHYT32IS-HEADING ()
   
    VHYT32IW.HEADING = "REASON OUT OF SERVICE DETAIL FOR:  ";
end 

Function VHYT32IS-INITIAL ()
  

  
  
  
  
  
  
  
   
    VHYT32D_CRIT.GUI-NAME = "VHYT32";
    VHYT32D_CRIT.MARIS-SUBSYS = "VEHICLE";
    set VHYT32IW empty;
    VHYT32IW.RUNREASON = "Y";
    VHYT32IW.HEADING = "REASON OUT OF SERVICE DETAIL FOR:  ";
    VHYT32IW.HEADING-TIME = VGVar.currentFormattedTime;
    VHYT32IW.RUN_DATE = VGVar.currentFormattedGregorianDate;
    VHYT32IW.SHOP = "HAYWARD SHOP";
    if (VHYT32W_PASSVALUE.YRD-TRKG-YRD == "HY")
        VHYT32IW.SHOP = "HAYWARD SHOP";
    end
    if (VHYT32W_PASSVALUE.YRD-TRKG-YRD == "CY")
        VHYT32IW.SHOP = "CONCORD SHOP";
    end
    if (VHYT32W_PASSVALUE.YRD-TRKG-YRD == "RY")
        VHYT32IW.SHOP = "RICHMOND SHOP";
    end
    if (VHYT32W_PASSVALUE.YRD-TRKG-YRD == "DY")
        VHYT32IW.SHOP = "DALY CITY SHOP";
    end
    if (VHYT32W_PASSVALUE.YRD-TRKG-YRD == "DPX")
        VHYT32IW.SHOP = "DUBLIN/PLEASANTON";
    end
    if (VHYT32W_PASSVALUE.YRD-TRKG-YRD == "PBX")
        VHYT32IW.SHOP = "PITTSBURG/BAYPOINT";
    end
    if (VHYT32W_PASSVALUE.YRD-TRKG-YRD == "MBX")
        VHYT32IW.SHOP = "MILLBRAE STORAGE";
    end
    if (VHYT32W_PASSVALUE.YRD-TRKG-YRD == "SVB")
        VHYT32IW.SHOP = "BERRYESSA STORAGE";
    end    
end 

Function VHYT32IS-PREPARE () 
    CARCT = 0;
    PICT = 0; 
    ICT = 1; 
    NICT = 2; 
    WICT = 1; 
    while (ICT <= XDCONTROL.UROWCNT)
  
        VHYT32B_DATA.YRD-SUB-LOC[WICT] = VHYT32A_DATA.YRD-SUB-LOC[ICT];
        VHYT32B_DATA.CAR-NO[WICT] = VHYT32A_DATA.CAR-NO[ICT];
  
  

  
  
        if ((VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] == "GO" ||
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] == "50" ||
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] == "CT" ||
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] == "CY" ||
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] == "CC") &&
         (VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] != "GO" &&
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] != "50" &&
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] != "MT" &&
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] != "CC" &&
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] != "CY"))
            VHYT32IS-REASON-2();
        end

  
  
  
        if ((VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] != "GO" &&
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] != "50" &&
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] != "CT" &&
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] != "CY" &&
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] != "CC") &&
         (VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] != "GO" &&
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] != "50" &&
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] != "MT" &&
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] != "CC" &&
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] != "CY"))
            VHYT32IS-REASON-3();
        end

  
  
        if ((VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] != "GO" &&
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] != "50" &&
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] != "CT" &&
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] != "CY" &&
         VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT] != "CC") &&
         (VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] == "GO" ||
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] == "50" ||
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] == "MT" ||
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] == "CC" ||
         VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT] == "CY"))
            VHYT32IS-REASON-4();
        end 

  
        PICT = PICT + 1;
        ICT = ICT + 1;
        NICT = NICT + 1;
        WICT = WICT + 1;
    end 
  
    WICT = WICT - 1;

  
    VHYT32IW-TRIGGERS.GET-TIMES = "Y";
end 

Function VHYT32IS-PRESS-SUM ()
   
    if (VHYT32W_PASSVALUE.GUI-INDEX == 7)
        VHYT32IW-TRIGGERS.PRESS-SHOW-SUMMARY = "Y";
    end
end 

Function VHYT32IS-REASON-2 ()
  

   
    VHYT32B_DATA.REASON-CD[WICT] = VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT];
    VHYT32B_DATA.REASON[WICT] = VHYT32A_DATA.NEW-MOVE-REASON-DSC[ICT];
    VHYT32B_DATA.START-DATE[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
    VHYT32B_DATA.START-TIME[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];
    VHYT32B_DATA.DATE-UPD-REASON[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
    VHYT32B_DATA.TIME-UPD-REASON[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];


  
    if (VHYT32A_DATA.CAR-NO[ICT] != VHYT32A_DATA.CAR-NO[NICT])
        VHYT32B_DATA.END-DATE[WICT] = VHYT32A_CRIT.END-DATE;
        if (VHYT32W_PASSVALUE.END-DATE == VHYT32IW.RUN_DATE)
            VHYT32B_DATA.END-TIME[WICT] = VGVar.currentFormattedTime;
        else
            VHYT32B_DATA.END-TIME[WICT] = "24.00.00";
        end
    end

  
    if (VHYT32A_DATA.CAR-NO[ICT] == VHYT32A_DATA.CAR-NO[NICT])
        VHYT32B_DATA.END-DATE[WICT] = VHYT32A_DATA.DATE-UPD-REASON[NICT];
        VHYT32B_DATA.END-TIME[WICT] = VHYT32A_DATA.TIME-UPD-REASON[NICT];
    end
end 

Function VHYT32IS-REASON-3 ()

  
   
    VHYT32B_DATA.END-DATE[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT]; 
    VHYT32B_DATA.END-TIME[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];

  
  
    if (PICT > 0)
        if (VHYT32A_DATA.CAR-NO[ICT] == VHYT32A_DATA.CAR-NO[PICT]) 
            VHYT32B_DATA.REASON-CD[WICT] = VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT];
            VHYT32B_DATA.REASON[WICT] = VHYT32A_DATA.NEW-MOVE-REASON-DSC[ICT];

  
  
            if (VHYT32A_DATA.CAR-NO[ICT] != VHYT32A_DATA.CAR-NO[NICT]) 
                VHYT32B_DATA.END-DATE[WICT] = VHYT32A_CRIT.END-DATE;
                if (VHYT32W_PASSVALUE.END-DATE == VHYT32IW.RUN_DATE)
                    VHYT32B_DATA.END-TIME[WICT] = VGVar.currentFormattedTime;
                else
                    VHYT32B_DATA.END-TIME[WICT] = "24.00.00";
                end
            end
            if (VHYT32A_DATA.CAR-NO[ICT] == VHYT32A_DATA.CAR-NO[NICT]) 
                VHYT32B_DATA.END-DATE[WICT] = VHYT32A_DATA.DATE-UPD-REASON[NICT]; 
                VHYT32B_DATA.END-TIME[WICT] = VHYT32A_DATA.TIME-UPD-REASON[NICT];
            end

  
            X = WICT - 1;
            VHYT32B_DATA.START-DATE[WICT] = VHYT32B_DATA.END-DATE[X];
            VHYT32B_DATA.START-TIME[WICT] = VHYT32B_DATA.END-TIME[X];
  
            VHYT32B_DATA.DATE-UPD-REASON[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
            VHYT32B_DATA.TIME-UPD-REASON[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];
        end
    end

  
  

  
  
    if (PICT > 0) 
        if (VHYT32A_DATA.CAR-NO[ICT] != VHYT32A_DATA.CAR-NO[PICT]) 
            VHYT32B_DATA.REASON-CD[WICT] = VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT];
            VHYT32B_DATA.REASON[WICT] = VHYT32A_DATA.PRV-MOVE-REASON-DSC[ICT];
            VHYT32B_DATA.END-DATE[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
            VHYT32B_DATA.END-TIME[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];
            VHYT32B_DATA.START-DATE[WICT] = VHYT32A_CRIT.START-DATE;
            VHYT32B_DATA.DATE-UPD-REASON[WICT] = " ";
            VHYT32B_DATA.TIME-UPD-REASON[WICT] = " ";
  
            if (VHYT32A_DATA.YRD-SUB-LOC-PREV[ICT] != " ")
                VHYT32B_DATA.YRD-SUB-LOC[WICT] = VHYT32A_DATA.YRD-SUB-LOC-PREV[ICT];
            end

  
            if (VHYT32W_PASSVALUE.START-DATE == VHYT32IW.RUN_DATE || VHYT32W_PASSVALUE.START-DATE == VHYT32W_PASSVALUE.END-DATE)
   
   
                VHYT32B_DATA.START-TIME[WICT] = "00.00.01";
            end


  
  
  
            WICT = WICT + 1;
            VHYT32B_DATA.YRD-SUB-LOC[WICT] = VHYT32A_DATA.YRD-SUB-LOC[ICT];
            VHYT32B_DATA.CAR-NO[WICT] = VHYT32A_DATA.CAR-NO[ICT];
            VHYT32B_DATA.DATE-UPD-REASON[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
            VHYT32B_DATA.TIME-UPD-REASON[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];
            VHYT32B_DATA.REASON-CD[WICT] = VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT];
            VHYT32B_DATA.REASON[WICT] = VHYT32A_DATA.NEW-MOVE-REASON-DSC[ICT];
            VHYT32B_DATA.START-DATE[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
            VHYT32B_DATA.START-TIME[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];
            if (VHYT32A_DATA.CAR-NO[ICT] != VHYT32A_DATA.CAR-NO[NICT]) 
                VHYT32B_DATA.END-DATE[WICT] = VHYT32A_CRIT.END-DATE;
                if (VHYT32W_PASSVALUE.END-DATE == VHYT32IW.RUN_DATE)
                    VHYT32B_DATA.END-TIME[WICT] = VGVar.currentFormattedTime;
                else
                    VHYT32B_DATA.END-TIME[WICT] = "24.00.00";
                end
            else
  
                VHYT32B_DATA.END-DATE[WICT] = VHYT32A_DATA.DATE-UPD-REASON[NICT]; 
                VHYT32B_DATA.END-TIME[WICT] = VHYT32A_DATA.TIME-UPD-REASON[NICT];
            end
            VHYT32IW.NUMCT = VHYT32IW.NUMCT + 1;
            

  
        end 
    end 
  
  
  
  
    if (PICT == 0)
  
        VHYT32B_DATA.REASON-CD[WICT] = VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT];
        VHYT32B_DATA.REASON[WICT] = VHYT32A_DATA.PRV-MOVE-REASON-DSC[ICT];
        VHYT32B_DATA.START-DATE[WICT] = VHYT32A_CRIT.START-DATE;
        VHYT32B_DATA.DATE-UPD-REASON[WICT] = " ";
        VHYT32B_DATA.TIME-UPD-REASON[WICT] = " ";

  
  
        if (VHYT32W_PASSVALUE.START-DATE == VHYT32IW.RUN_DATE || VHYT32W_PASSVALUE.START-DATE == VHYT32W_PASSVALUE.END-DATE)
  
  
            VHYT32B_DATA.START-TIME[WICT] = "00.00.01";
        end
  
  
  
  
        WICT = WICT + 1;
        VHYT32B_DATA.YRD-SUB-LOC[WICT] = VHYT32A_DATA.YRD-SUB-LOC[ICT];
        VHYT32B_DATA.CAR-NO[WICT] = VHYT32A_DATA.CAR-NO[ICT];
        VHYT32B_DATA.DATE-UPD-REASON[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
        VHYT32B_DATA.TIME-UPD-REASON[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];
        VHYT32B_DATA.REASON-CD[WICT] = VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT];
        VHYT32B_DATA.REASON[WICT] = VHYT32A_DATA.NEW-MOVE-REASON-DSC[ICT];
        VHYT32B_DATA.START-DATE[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
        VHYT32B_DATA.START-TIME[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];
        if (VHYT32A_DATA.CAR-NO[ICT] != VHYT32A_DATA.CAR-NO[NICT]) 
            VHYT32B_DATA.END-DATE[WICT] = VHYT32A_CRIT.END-DATE;
            if (VHYT32W_PASSVALUE.END-DATE == VHYT32IW.RUN_DATE)
                VHYT32B_DATA.END-TIME[WICT] = VGVar.currentFormattedTime;
            else
                VHYT32B_DATA.END-TIME[WICT] = "24.00.00";
            end
        else
            VHYT32B_DATA.END-DATE[WICT] = VHYT32A_DATA.DATE-UPD-REASON[NICT];
            VHYT32B_DATA.END-TIME[WICT] = VHYT32A_DATA.TIME-UPD-REASON[NICT];
        end
        VHYT32IW.NUMCT = VHYT32IW.NUMCT + 1;
        

  
    end
end 

Function VHYT32IS-REASON-4 ()
   
    VHYT32B_DATA.END-DATE[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
    VHYT32B_DATA.END-TIME[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];


  
  
    if (PICT != 0)
        if (VHYT32A_DATA.CAR-NO[ICT] != VHYT32A_DATA.CAR-NO[PICT]) 
            VHYT32B_DATA.REASON-CD[WICT] = VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT];
            VHYT32B_DATA.REASON[WICT] = VHYT32A_DATA.PRV-MOVE-REASON-DSC[ICT];
            VHYT32B_DATA.START-DATE[WICT] = VHYT32A_CRIT.START-DATE;
  
  
  
  
            VHYT32B_DATA.START-TIME[WICT] = "00.00.01"; 

  
            VHYT32B_DATA.DATE-UPD-REASON[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
            VHYT32B_DATA.TIME-UPD-REASON[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];
            

  
   
        end 


  
  
  

  
        if (VHYT32A_DATA.CAR-NO[ICT] == VHYT32A_DATA.CAR-NO[PICT]) 
   
            VHYT32B_DATA.START-DATE[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT]; 
            VHYT32B_DATA.START-TIME[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];
            VHYT32B_DATA.REASON-CD[WICT] = VHYT32A_DATA.MOVE-REASON-CD-NEW[ICT]; 
            VHYT32B_DATA.REASON[WICT] = VHYT32A_DATA.NEW-MOVE-REASON-DSC[ICT]; 
  
            VHYT32B_DATA.DATE-UPD-REASON[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
            VHYT32B_DATA.TIME-UPD-REASON[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];
        end
    else
  
  
        VHYT32B_DATA.REASON-CD[WICT] = VHYT32A_DATA.MOVE-REASON-CD-PRV[ICT];
        VHYT32B_DATA.REASON[WICT] = VHYT32A_DATA.PRV-MOVE-REASON-DSC[ICT];
        VHYT32B_DATA.DATE-UPD-REASON[WICT] = VHYT32A_DATA.DATE-UPD-REASON[ICT];
        VHYT32B_DATA.TIME-UPD-REASON[WICT] = VHYT32A_DATA.TIME-UPD-REASON[ICT];
        VHYT32B_DATA.START-DATE[WICT] = VHYT32A_CRIT.START-DATE;
        VHYT32B_DATA.DATE-UPD-REASON[WICT] = " ";
        VHYT32B_DATA.TIME-UPD-REASON[WICT] = " ";

  
  
  
    
        VHYT32B_DATA.START-TIME[WICT] = "00.00.01";
         
  
    end
end 

Function VHYT32IS-REFORMAT ()
   
    CAR-TOT-DAYS = 0;
    CAR-TOT-HRS = 0;
    CAR-TOT-MIN = 0;
    RPT-TOT-DAYS = 0;
    RPT-TOT-HRS = 0;
    RPT-TOT-MIN = 0;
    CARCT = 0;
    HOLDCAR = "    ";
    ICT = 1;
    NICT = 2;
    XXDATEW.VAGen_FUNCTION = "MDY";
    while (ICT <= VHYT32B_CRIT.RECCOUNT)
        VHYT32IWORK.DAYS = 0;
        VHYT32IWORK.HOURS = 0;
        VHYT32IWORK.MINS = 0;

  
        if (HOLDCAR != VHYT32B_DATA.CAR-NO[ICT]) 
            VHYT32IW-ARRAY.CAR-NO[ICT] = VHYT32B_DATA.CAR-NO[ICT];
            HOLDCAR = VHYT32B_DATA.CAR-NO[ICT];
        else
            VHYT32IW-ARRAY.CAR-NO[ICT] = "    ";
        end
        VHYT32IW-ARRAY.YRD-SUB-LOC[ICT] = VHYT32B_DATA.YRD-SUB-LOC[ICT];
        XXDATEW.DATE-YYYY-MM-DD = VHYT32B_DATA.DATE-UPD-REASON[ICT];
        MRSCommonCode.XXDATES-CONVERT();
        VHYT32IW-ARRAY.DATE-UPD-REASON[ICT] = XXDATEW.DATE-MM-DD-YYYY;
        VHYT32IW-ARRAY.TIME-UPD-REASON[ICT] = VHYT32B_DATA.TIME-UPD-REASON[ICT];
        VHYT32IW-ARRAY.TIME-IN-SS[ICT] = "   "; 
        VHYT32IW-ARRAY.REASON-CD[ICT] = VHYT32B_DATA.REASON-CD[ICT];
        VHYT32IW-ARRAY.REASON[ICT] = VHYT32B_DATA.REASON[ICT];

  
        if (VHYT32B_DATA.TS-MO[ICT] > 1)
            VHYT32IW-ARRAY.EDAYS-IN[ICT] = (VHYT32B_DATA.TS-DD[ICT] + (VHYT32B_DATA.TS-MO[ICT] * 30));
        else
            VHYT32IW-ARRAY.EDAYS-IN[ICT] = VHYT32B_DATA.TS-DD[ICT];
        end
        VHYT32IW-ARRAY.EHRS-IN[ICT] = VHYT32B_DATA.TS-HH[ICT];
        VHYT32IW-ARRAY.EMINS-IN[ICT] = VHYT32B_DATA.TS-MM[ICT];
        VHYT32IW-ARRAY.ECOLON1[ICT] = " : ";


  
        CAR-TOT-DAYS = CAR-TOT-DAYS + VHYT32IW-ARRAY.EDAYS-IN[ICT];
        CAR-TOT-HRS = CAR-TOT-HRS + VHYT32IW-ARRAY.EHRS-IN[ICT];
        CAR-TOT-MIN = CAR-TOT-MIN + VHYT32IW-ARRAY.EMINS-IN[ICT];

  
        RPT-TOT-DAYS = RPT-TOT-DAYS + VHYT32IW-ARRAY.EDAYS-IN[ICT];
        RPT-TOT-HRS = RPT-TOT-HRS + VHYT32IW-ARRAY.EHRS-IN[ICT];
        RPT-TOT-MIN = RPT-TOT-MIN + VHYT32IW-ARRAY.EMINS-IN[ICT];

  
  
        if (VHYT32IW-ARRAY.EDAYS-IN[ICT] == 0 && VHYT32IW-ARRAY.EHRS-IN[ICT] == 0 && VHYT32IW-ARRAY.EMINS-IN[ICT] == 0)
            VHYT32IW-ARRAY.DAYS-OOS[ICT] = "  ";
            VHYT32IW-ARRAY.EDAYS-IN-CHAR[ICT] = "  ";
            VHYT32IW-ARRAY.TIME-OOS[ICT] = "       ";
        end
  

  
  
        if (VHYT32B_DATA.CAR-NO[NICT] != VHYT32B_DATA.CAR-NO[ICT])

  
            VHYT32IWORK.TOTAL-ELAP-MINS = (VHYT32IWORK.CAR-TOT-DAYS * 1440) + (VHYT32IWORK.CAR-TOT-HRS * 60) + VHYT32IWORK.CAR-TOT-MIN;

  
            VHYT32IWORK.DAYS = VHYT32IWORK.TOTAL-ELAP-MINS / 1440; 
            VHYT32IWORK.HOURS = (VHYT32IWORK.TOTAL-ELAP-MINS - (VHYT32IWORK.DAYS * 1440)) / 60; 
            VHYT32IWORK.MINS = VHYT32IWORK.TOTAL-ELAP-MINS - ((VHYT32IWORK.DAYS * 1440) + (VHYT32IWORK.HOURS * 60));
            VHYT32IW-ARRAY.GTDAYS[ICT] = VHYT32IWORK.DAYS;
            VHYT32IW-ARRAY.GTHOURS[ICT] = VHYT32IWORK.HOURS;
            VHYT32IW-ARRAY.GTMINS[ICT] = VHYT32IWORK.MINS;
            VHYT32IW-ARRAY.GTCOLON1[ICT] = " : ";
  
            CAR-TOT-DAYS = 0;
            CAR-TOT-HRS = 0;
            CAR-TOT-MIN = 0;
        else 
            VHYT32IW-ARRAY.CAR-TOTAL-DAYS[ICT] = " ";
            VHYT32IW-ARRAY.CAR-TOTAL-HRS-MINS[ICT] = " ";
        end
        ICT = ICT + 1;
        NICT = NICT + 1;
    end

  
    VHYT32IWORK.TOTAL-ELAP-MINS = (VHYT32IWORK.RPT-TOT-DAYS * 1440) + (VHYT32IWORK.RPT-TOT-HRS * 60) + VHYT32IWORK.RPT-TOT-MIN;

  
    VHYT32IWORK.DAYS = VHYT32IWORK.TOTAL-ELAP-MINS / 1440; 
    VHYT32IWORK.HOURS = (VHYT32IWORK.TOTAL-ELAP-MINS - (VHYT32IWORK.DAYS * 1440)) / 60; 
    VHYT32IWORK.MINS = VHYT32IWORK.TOTAL-ELAP-MINS - ((VHYT32IWORK.DAYS * 1440) + (VHYT32IWORK.HOURS * 60));
    VHYT32IWORK.DISPLAY-TOT-DAYS = VHYT32IWORK.DAYS;
    VHYT32IWORK.RPT-TOT-HH = VHYT32IWORK.HOURS;
    VHYT32IWORK.RPT-TOT-MM = VHYT32IWORK.MINS;
    VHYT32IWORK.RPT-TOT-COLON = " : ";

  
    VHYT32IW-TRIGGERS.PUSH-DATA = "Y";
end 

Function VHYT32IS-RUNREASON () 
    if (VHYT32IW.RUNREASON == "Y")
        VHYT32IW-TRIGGERS.RUN-REASON = "Y";
        VHYT32IW.RUNREASON = "N";
    else
        VHYT32IW-TRIGGERS.PUSH-SUMMARY = "Y";
    end
end 

Function VHYT32IS-SORTSUM ()
  
   
    VHYT32D_CRIT.MARIS-SUBSYS = "VEHICLE";
  
    VHYT32D_CRIT.USER-GRP = "TEST";
    VHYT32D_CRIT.GUI-NAME = "VHYT32";
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT32D";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT32I";
    set VHYT32D_DATA empty;

    
    try
        call "VHYT32D"(XDCONTROL, VHYT32IW-REASONSUM, VHYT32D_CRIT, VHYT32D_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHYT32IW.SORTCT = XDCONTROL.UROWCNT;
            
    
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end
end 

Function VHYT32IS-SUMMARY ()
   

end 

Function VHYT33IS-CHECK () 
    if (ICOUNT >= 324)
        VHYT33IW.MAX-ROWS = "Y";
    end
end 

Function VHYT33IS-GET-DATA ()
  
  
  
  
  
  
  
   
    set VHYT33A_CRIT empty;
    set VHYT33A_DATA empty;
    set VHYT33IW-ARRAY empty;

  
  
    VHYT33A_CRIT.YRD-TRKG-YRD = VHYT29W_PASSVALUE.YRD-TRKG-YRD;
  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHYT29W_PASSVALUE.START-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHYT33A_CRIT.START-DATE = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.DATE-MM-DD-YYYY = VHYT29W_PASSVALUE.END-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHYT33A_CRIT.END-DATE = XXDATEW.DATE-YYYY-MM-DD;
    if (VHYT33A_CRIT.YRD-TRKG-YRD == "  ")
        VHYT33A_CRIT.YRD-TRKG-YRD = "HY";
    end


  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT33A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT33I";
    set VHYT33A_DATA empty;

    
    try
        call "VHYT33A"(XDCONTROL, VHYT33A_CRIT, VHYT33A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
            VHYT33IW.NUMCOUNT = XDCONTROL.UROWCNT;
            VHYT30IW-TRIGGERS.REFORMAT = "Y";
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end
end 

Function VHYT33IS-INITIAL ()
   
    VHYT33IW.RUN_TIME = VGVar.currentFormattedTime;
    VHYT33IW.RUN_DATE = VGVar.currentFormattedGregorianDate;
    VHYT33IW.SHOP = "HAYWARD SHOP";
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "HY")
        VHYT33IW.SHOP = "HAYWARD YARD";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "CY")
        VHYT33IW.SHOP = "CONCORD YARD";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "RY")
        VHYT33IW.SHOP = "RICHMOND YARD";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "DY")
        VHYT33IW.SHOP = "DALY CITY YARD";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "DPX")
        VHYT33IW.SHOP = "DUBLIN/PLEASANTON";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "PBX")
        VHYT33IW.SHOP = "PITTSBURG/BAYPOINT";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "MBX")
        VHYT33IW.SHOP = "MILLBRAE STORAGE";
    end
    if (VHYT29W_PASSVALUE.YRD-TRKG-YRD == "SVB")
        VHYT33IW.SHOP = "BERRYESSA STORAGE";
    end    
end 

Function VHYT33IS-REFORMAT ()
  
  
  
  
  
   
    set VHYT33IW-ARRAY empty;
    ICOUNT = 1;
    CARCOUNT = 0;
    while (ICOUNT <= XDCONTROL.UROWCNT)

  
        if (ICOUNT == 1)
            H-CAR-NO = VHYT33A_DATA.CAR-NO[ICOUNT];
            H-DATE = VHYT33A_DATA.DATE-STAT-CHG[ICOUNT];
            VHYT33IW-ARRAY.CAR-NO[ICOUNT] = VHYT33A_DATA.CAR-NO[ICOUNT];
            VHYT33IW-ARRAY.DATE-STAT-CHG[ICOUNT] = VHYT33A_DATA.DATE-STAT-CHG[ICOUNT];
        end
        if (ICOUNT > 1)
            if (H-CAR-NO != VHYT33A_DATA.CAR-NO[ICOUNT])
                H-CAR-NO = VHYT33A_DATA.CAR-NO[ICOUNT];
                VHYT33IW-ARRAY.CAR-NO[ICOUNT] = VHYT33A_DATA.CAR-NO[ICOUNT];
                H-DATE = VHYT33A_DATA.DATE-STAT-CHG[ICOUNT]; 
                VHYT33IW-ARRAY.DATE-STAT-CHG[ICOUNT] = VHYT33A_DATA.DATE-STAT-CHG[ICOUNT];
                 
            else
                VHYT33IW-ARRAY.CAR-NO[ICOUNT] = " ";
                if (H-DATE != VHYT33A_DATA.DATE-STAT-CHG[ICOUNT])
                    H-DATE = VHYT33A_DATA.DATE-STAT-CHG[ICOUNT];
                    VHYT33IW-ARRAY.DATE-STAT-CHG[ICOUNT] = VHYT33A_DATA.DATE-STAT-CHG[ICOUNT];
                else
                    VHYT33IW-ARRAY.DATE-STAT-CHG[ICOUNT] = " ";
                end
                 
            end 
        end 
        VHYT33IW-ARRAY.YRD-SUB-LOC[ICOUNT] = VHYT33A_DATA.YRD-SUB-LOC[ICOUNT];
        VHYT33IW-ARRAY.TIME-STAT-CHG[ICOUNT] = VHYT33A_DATA.TIME-STAT-CHG[ICOUNT];
        VHYT33IW-ARRAY.VEH-STAT-NEW[ICOUNT] = VHYT33A_DATA.VEH-STAT-NEW[ICOUNT];
        VHYT33IW-ARRAY.VEH-STAT-PREV[ICOUNT] = VHYT33A_DATA.VEH-STAT-PREV[ICOUNT];
        VHYT33IW-ARRAY.MOVE-REASON-DESC[ICOUNT] = VHYT33A_DATA.MOVE-REASON-DESC[ICOUNT];
        VHYT33IW-ARRAY.MOVE-REASON-CD[ICOUNT] = VHYT33A_DATA.MOVE-REASON-CD[ICOUNT];

  
        CARCOUNT = CARCOUNT + 1;
        ICOUNT = ICOUNT + 1;
    end
    CMSG = " Rows Returned";
    move CARCOUNT to CCOUNT withV60Compat;
  
    if (VHYT33IW.NUM-1 == "0")
        VHYT33IW.NUM-1 = " ";
    end
    if (VHYT33IW.NUM-2 == "0")
        VHYT33IW.NUM-2 = " ";
    end
  
    VHYT30IW-TRIGGERS.PUSH-DATA = "Y";
end 

Function VHYT34I-ADD-ROW () 
    set VHYT34G_DATA empty;

  
    VHYT34G_DATA.DATE-SCHED-REV = VHYT34IW.REV-DATE;
    VHYT34G_DATA.CON-NO-FROM = " ";
    VHYT34G_DATA.CON-NO-TO = " ";
    if (VHYT34IW.ALL-CANCEL == "1") 
  
  
        VHYT34G_DATA.TIME-OF-ARRIVAL-FR = "00.00.01";
        VHYT34G_DATA.TIME-OF-ARRIVAL-TO = "23.59.59";
  
  
        VHYT34G_DATA.DATE-ARRIVAL-FROM = VHYT34IW.REV-DATE;
        VHYT34G_DATA.DATE-ARRIVAL-TO = VHYT34IW.REV-DATE;
        VHYT34G_DATA.DATE-SCHED-REV = VHYT34IW.REV-DATE;
        VHYT34G_DATA.CANCEL-ALL-IND = "Y";
        VHYT34G_DATA.CON-SIZE = 0;
    else
        VHYT34G_DATA.TIME-OF-ARRIVAL-FR = VHYT34IW.FROM-TIME;
        VHYT34G_DATA.TIME-OF-ARRIVAL-TO = VHYT34IW.TO-TIME;
        VHYT34G_DATA.DATE-ARRIVAL-FROM = VHYT34G_DATA.DATE-SCHED-REV;
        VHYT34G_DATA.DATE-ARRIVAL-TO = VHYT34G_DATA.DATE-SCHED-REV; 
        VHYT34G_DATA.CANCEL-ALL-IND = "N";
        VHYT34G_DATA.CON-SIZE = 0;
    end
    VHYT34G_DATA.SCHED-CD = VHYT34IW.SCHED-CD;
    VHYT34G_DATA.ACTV-IND = "Y";
    VHYT34G_DATA.END-RUN-IND = "N";

  
    VHYT34G_DATA.CANCEL-AM-BRK-IND = "N";
    VHYT34G_DATA.CANCEL-PM-BRK-IND = "N";
    VHYT34G_DATA.CANCEL-AM-MK-IND = "N";
    VHYT34G_DATA.CANCEL-PM-MK-IND = "N";
    VHYT34G_DATA.SCHED-AM-BRK-IND = "N";
    VHYT34G_DATA.SCHED-AM-MK-IND = "N";
    VHYT34G_DATA.SCHED-PM-BRK-IND = "N";
    VHYT34G_DATA.SCHED-PM-MK-IND = "N";

  
    if (VHYT34IW.AM-BREAK-CANCEL-FLAG == "Y")
        VHYT34G_DATA.CANCEL-AM-BRK-IND = "Y";
        VHYT34IW.AM-BREAK-STAT = "Cancelled";
        VHYT34IW-TRIGGERS.DISABLE-C-AM-BREAK = "Y";
        VHYT34IW-TRIGGERS.ENABLE-R-AM-BREAK = "Y";
    end
    if (VHYT34IW.PM-BREAK-CANCEL-FLAG == "Y")
        VHYT34G_DATA.CANCEL-PM-BRK-IND = "Y";
        VHYT34IW.PM-BREAK-STAT = "Cancelled";
        VHYT34IW-TRIGGERS.DISABLE-C-PM-BREAK = "Y";
        VHYT34IW-TRIGGERS.ENABLE-R-PM-BREAK = "Y";
    end
    if (VHYT34IW.AM-MAKE-CANCEL-FLAG == "Y")
        VHYT34G_DATA.CANCEL-AM-MK-IND = "Y";
        VHYT34IW.AM-MAKE-STAT = "Cancelled";
        VHYT34IW-TRIGGERS.DISABLE-C-AM-MAKE = "Y";
        VHYT34IW-TRIGGERS.ENABLE-R-AM-MAKE = "Y";
    end
    if (VHYT34IW.PM-MAKE-CANCEL-FLAG == "Y")
        VHYT34G_DATA.CANCEL-PM-MK-IND = "Y";
        VHYT34IW.PM-MAKE-STAT = "Cancelled";
        VHYT34IW-TRIGGERS.DISABLE-C-PM-MAKE = "Y";
        VHYT34IW-TRIGGERS.ENABLE-R-PM-MAKE = "Y";
    end
    if (VHYT34IW.ALL-CANCEL == "1")
        VHYT34IW.ALL-STAT = "Cancelled";
        VHYT34IW.AM-BREAK-STAT = "Cancelled";
        VHYT34IW.AM-MAKE-STAT = "Cancelled";
        VHYT34IW.PM-BREAK-STAT = "Cancelled";
        VHYT34IW.PM-MAKE-STAT = "Cancelled";
        VHYT34IW-TRIGGERS.DISABLE-ALL-MAKE-BREAK-CANCEL = "Y";
        VHYT34IW-TRIGGERS.ENABLE-ALL-MAKE-BREAK-RE = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-AM-MAKE = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-AM-BREAK = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-PM-MAKE = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-PM-BREAK = "Y";
    end
  
    VHYT34G_DATA.USER-GRP-REQST = VHYT34I-PASSVALUE.USER-GROUP;
    VHYT34G_DATA.TERM-OF-REQST = VHYT34I-PASSVALUE.TERM-ID;
    VHYT34G_DATA.SCHED-CD = VHYT34IW.SCHED-CD;
    VHYT34G_DATA.YRD-REQST = VHYT34I-PASSVALUE.YRD-TRK-YRD;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34G";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";

    
    try
        call "VHYT34G"(XDCONTROL, VHYT34G_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT34IW-PROCESS.SCHED-ADJ-ROWS = XDCONTROL.UROWCNT;
            VHYT34I-MESSAGE.MESSAGE = "The Make/Break Overrides You Requested Were Added";
        else

  
            XDCONTROL.UROWCNT = 0;
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end
end 

Function VHYT34I-AFTER-DATE ()
  

   
    VHYT34IW.RUN-WITH-NEW-DATE-FLAG = "Y";

  
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHYT34IW.REV-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHYT34IW.REV-DATE-MMDDYYYY = XXDATEW.DATE-MM-DD-YYYY;

  

  
  
  
  
  

  
  
  
  
  
    VHYT34IW-TRIGGERS.DISABLE-OVERRIDES = "Y";
    VHYT34IW-TRIGGERS.DISABLE-SINGLE-TRAIN = "Y";

  
    VHYT34IW.ALL-RE-ACTIVATE = "0";
    VHYT34IW.ALL-CANCEL = "0";
    VHYT34IW.PM-BREAK-CANCEL = "0";
    VHYT34IW.PM-BREAK-RE = "0";
    VHYT34IW.AM-BREAK-CANCEL = "0";
    VHYT34IW.AM-BREAK-RE = "0";
    VHYT34IW.PM-MAKE-CANCEL = "0";
    VHYT34IW.PM-MAKE-RE = "0";
    VHYT34IW.AM-MAKE-CANCEL = "0";
    VHYT34IW.AM-MAKE-RE = "0";
  
    VHYT34IW.PM-BREAK-STAT = "Scheduled";
    VHYT34IW.AM-BREAK-STAT = "Scheduled";
    VHYT34IW.PM-MAKE-STAT = "Scheduled";
    VHYT34IW.AM-MAKE-STAT = "Scheduled";
    VHYT34IW.ALL-STAT = " ";

  
  
  
  
    set VHYT34B_DATA empty;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34B";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE01I";
    set VHYT34B_DATA empty;
    VHYT34B_CRIT.MARIS-SUBSYS = "VEHICLE";
    VHYT34B_CRIT.USER-TERM-ID = "VHYT34B";
    VHYT34B_CRIT.USER-GRP = VHYT34I-PASSVALUE.USER-GROUP;
    VHYT34B_CRIT.NEW-DATE-FLAG = "Y";
    VHYT34B_CRIT.REV-DATE = VHYT34IW.REV-DATE;

    
    try
        call "VHYT34B"(XDCONTROL, VHYT34B_CRIT, VHYT34B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end

  
    if (VHYT34B_DATA.CNT-DAY-OF-WEEK == 0)
        VHYT34IW.SCHED-CD = "SU";
    end
    if (VHYT34B_DATA.CNT-DAY-OF-WEEK == 6)
        VHYT34IW.SCHED-CD = "SA";
    end
    if (VHYT34B_DATA.CNT-DAY-OF-WEEK == 1 || VHYT34B_DATA.CNT-DAY-OF-WEEK == 2 || VHYT34B_DATA.CNT-DAY-OF-WEEK == 3 ||
     VHYT34B_DATA.CNT-DAY-OF-WEEK == 4 || VHYT34B_DATA.CNT-DAY-OF-WEEK == 5)
        VHYT34IW.SCHED-CD = "WK";
    end

  
  
  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34C";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE01I";
    set VHYT34C_DATA empty;
    VHYT34C_CRIT.DATE-SCHED-REV = VHYT34IW.REV-DATE;
    
    try
        call "VHYT34C"(XDCONTROL, VHYT34C_CRIT, VHYT34C_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
  
  
            VHYT34IW.SCHED-CD = VHYT34C_DATA.SCHED-CD;
             
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end


  
    if (VHYT34IW.RUN-WITH-NEW-DATE-FLAG == "Y")
        VHYT34IW-TRIGGERS.RUN-TIMES = "Y";
    end
end 

Function VHYT34I-CHECK-SKD ()
  
  

   
    CNT = 1;
    while (CNT <= VHYT34IW-PROCESS.SCHED-ADJ-ROWS)
        if (VHYT34E_DATA.CANCEL-ALL-IND[CNT] == "Y")
            VHYT34IW-PROCESS.CAN-ALL-FLAG = "Y";
        end
  
        if (VHYT34E_DATA.CANCEL-AM-BRK-IND[CNT] == "Y")
            VHYT34IW-PROCESS.CAN-AM-BREAK-FLAG = "Y";
        end
  
        if (VHYT34E_DATA.CANCEL-PM-BRK-IND[CNT] == "Y")
            VHYT34IW-PROCESS.CAN-PM-BREAK-FLAG = "Y";
        end
  
        if (VHYT34E_DATA.CANCEL-AM-MK-IND[CNT] == "Y")
            VHYT34IW-PROCESS.CAN-AM-MAKE-FLAG = "Y";
        end

  
        if (VHYT34E_DATA.CANCEL-PM-MK-IND[CNT] == "Y")
            VHYT34IW-PROCESS.CAN-PM-MAKE-FLAG = "Y";
        end
        CNT = CNT + 1;
    end 

  
    if (VHYT34IW-PROCESS.CAN-AM-BREAK-FLAG == "Y") 
        VHYT34IW-TRIGGERS.DISABLE-C-AM-BREAK = "Y";
        VHYT34IW.AM-BREAK-STAT = "Cancelled";
    end
    if (VHYT34IW-PROCESS.CAN-AM-MAKE-FLAG == "Y") 
        VHYT34IW-TRIGGERS.DISABLE-C-AM-MAKE = "Y";
        VHYT34IW.AM-MAKE-STAT = "Cancelled";
    end
    if (VHYT34IW-PROCESS.CAN-PM-BREAK-FLAG == "Y") 
        VHYT34IW-TRIGGERS.DISABLE-C-PM-BREAK = "Y";
        VHYT34IW.PM-BREAK-STAT = "Cancelled";
    end
    if (VHYT34IW-PROCESS.CAN-AM-MAKE-FLAG == "Y") 
        VHYT34IW-TRIGGERS.DISABLE-C-PM-MAKE = "Y";
        VHYT34IW.AM-MAKE-STAT = "Cancelled";
    end

  
    if (VHYT34IW-PROCESS.CAN-ALL-FLAG == "Y") 
        VHYT34IW-TRIGGERS.DISABLE-ALL-MAKE-BREAK-CANCEL = "Y";
        VHYT34IW-TRIGGERS.DISABLE-C-AM-MAKE = "Y";
        VHYT34IW-TRIGGERS.DISABLE-C-AM-BREAK = "Y";
        VHYT34IW-TRIGGERS.DISABLE-C-PM-MAKE = "Y";
        VHYT34IW-TRIGGERS.DISABLE-C-PM-BREAK = "Y";
        VHYT34IW.ALL-STAT = "Cancelled";
    end
  
  
  
  
    if (VHYT34IW-PROCESS.CAN-AM-BREAK-FLAG == "N") 
        VHYT34IW-TRIGGERS.DISABLE-R-AM-BREAK = "Y";
        VHYT34IW.AM-BREAK-STAT = "Scheduled";
    end
    if (VHYT34IW-PROCESS.CAN-AM-MAKE-FLAG == "N") 
        VHYT34IW-TRIGGERS.DISABLE-R-AM-MAKE = "Y";
        VHYT34IW.AM-MAKE-STAT = "Scheduled";
    end
    if (VHYT34IW-PROCESS.CAN-PM-BREAK-FLAG == "N") 
        VHYT34IW-TRIGGERS.DISABLE-R-PM-BREAK = "Y";
        VHYT34IW.PM-BREAK-STAT = "Scheduled";
    end
    if (VHYT34IW-PROCESS.CAN-AM-MAKE-FLAG == "N") 
        VHYT34IW-TRIGGERS.DISABLE-R-PM-MAKE = "Y";
        VHYT34IW.AM-MAKE-STAT = "Scheduled";
    end
    if (VHYT34IW-PROCESS.CAN-ALL-FLAG == "N")
        VHYT34IW-TRIGGERS.DISABLE-ALL-MAKE-BREAK-RE = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-AM-MAKE = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-AM-BREAK = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-PM-MAKE = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-PM-BREAK = "Y";
        VHYT34IW.ALL-STAT = "Scheduled";
    end
end 

Function VHYT34I-CLEAR ()
   
    VHYT34IW.RUN-WITH-NEW-DATE-FLAG = "N";


  
    VHYT34IW.ST-MAKE-CANCEL = "0";
    VHYT34IW.ST-BREAK-CANCEL = "0";
    VHYT34IW.ST-MAKE-SCHED = "0";
    VHYT34IW.ST-BREAK-SCHED = "0";

  
    VHYT34IW.ALL-CANCEL = "0";
    VHYT34IW.ALL-RE-ACTIVATE = "0";
    VHYT34IW.AM-BREAK-CANCEL = "0";
    VHYT34IW.PM-BREAK-CANCEL = "0";
    VHYT34IW.AM-MAKE-CANCEL = "0";
    VHYT34IW.PM-MAKE-CANCEL = "0";
    VHYT34IW.AM-BREAK-RE = "0";
    VHYT34IW.PM-BREAK-RE = "0";
    VHYT34IW.AM-MAKE-RE = "0";
    VHYT34IW.PM-MAKE-RE = "0";

  
    VHYT34IW.PM-BREAK-STAT = "Scheduled";
    VHYT34IW.AM-BREAK-STAT = "Scheduled";
    VHYT34IW.PM-MAKE-STAT = "Scheduled";
    VHYT34IW.AM-MAKE-STAT = "Scheduled";
    VHYT34IW.ALL-STAT = " ";
    VHYT34IW.SCHEDULED-FOR = " ";
    VHYT34I-MESSAGE.MESSAGE = "Enter Make / Break OR Enter Single Car Override Request";

  
    VHYT34I-TIME-INDEX.TIME-OF-ARRIVAL-IDX = 0;
    VHYT34IW.CON-NO = " ";

  
    VHYT34I-TIME-INDEX.PM-BREAK-FROM-IDX = 0;
    VHYT34I-TIME-INDEX.PM-BREAK-TO-IDX = 0;
    VHYT34I-TIME-INDEX.PM-MAKE-FROM-IDX = 0;
    VHYT34I-TIME-INDEX.PM-MAKE-TO-IDX = 0;
    VHYT34I-TIME-INDEX.AM-BREAK-FROM-IDX = 0;
    VHYT34I-TIME-INDEX.AM-BREAK-TO-IDX = 0;
    VHYT34I-TIME-INDEX.AM-MAKE-FROM-IDX = 0;
    VHYT34I-TIME-INDEX.AM-MAKE-TO-IDX = 0;
    


  
  
    VHYT34I-REV-DATE();
    VHYT34I-TIMES();
    VHYT34I-SCHED-ADJ();
    VHYT34I-TRAIN-DROP();
    VHYT34I-LISTSINGLE();
end 

Function VHYT34I-DATE-CHGED ()
   
    if (VHYT34IW.REV-DATE-MMDDYYYY != VHYT34IW-DATES.NEW-REV-DATE-MMDDYYYY)
  
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHYT34IW-DATES.NEW-REV-DATE-MMDDYYYY;
        MRSCommonCode.XXDATES-CONVERT();
        VHYT34IW.REV-DATE = XXDATEW.DATE-YYYY-MM-DD;

  
        VHYT34I-MESSAGE.MESSAGE = "Program Will Determine  Schedule & Times  For Your New Date Request";
        VHYT34IW.RUN-WITH-NEW-DATE-FLAG = "Y";
        VHYT34IW-TRIGGERS.RUN-AFTER-DATE = "Y";
    end
end 

Function VHYT34I-EN-OVER ()
   

end 

Function VHYT34I-FLIP-FLOP ()
  
   
    if (VHYT34IW.ST-BREAK-SCHED == "1")
        VHYT34IW-TRIGGERS.ST-DISABLE-S-MAKE = "Y";
    end
    if (VHYT34IW.ST-MAKE-SCHED == "1")
        VHYT34IW-TRIGGERS.ST-DISABLE-S-BREAK = "Y";
    end
    if (VHYT34IW.ST-BREAK-SCHED == "0")
        VHYT34IW-TRIGGERS.ST-ENABLE-S-MAKE = "Y";
    end
    if (VHYT34IW.ST-MAKE-SCHED == "0")
        VHYT34IW-TRIGGERS.ST-ENABLE-S-BREAK = "Y";
    end
end 

Function VHYT34I-INITIAL ()
  
  
  
  


   
    set VHYT34IW-PROCESS empty;

  
    VHYT34IW.RUN-WITH-NEW-DATE-FLAG = "N";


  
    VHYT34I-MESSAGE.MESSAGE = "Enter Make / Break OR Enter Single Car Override Request";
  
  
    VHYT34IW-PROCESS.CAN-AM-MAKE-FLAG = "N";
    VHYT34IW-PROCESS.CAN-PM-MAKE-FLAG = "N";
    VHYT34IW-PROCESS.CAN-AM-BREAK-FLAG = "N";
    VHYT34IW-PROCESS.CAN-PM-BREAK-FLAG = "N";
    VHYT34IW-PROCESS.CAN-ALL-FLAG = "N";

  
    VHYT34IW-TRIGGERS.ST-DISABLE-C-BREAK = "Y";
    VHYT34IW-TRIGGERS.ST-DISABLE-C-MAKE = "Y";

  
    VHYT34IW-TRIGGERS.DISABLE-ALL-MAKE-BREAK-RE = "Y";
    VHYT34IW-TRIGGERS.DISABLE-R-AM-MAKE = "Y";
    VHYT34IW-TRIGGERS.DISABLE-R-AM-BREAK = "Y";
    VHYT34IW-TRIGGERS.DISABLE-R-PM-MAKE = "Y";
    VHYT34IW-TRIGGERS.DISABLE-R-PM-BREAK = "Y";
    VHYT34IW-TRIGGERS.ENABLE-ALL-MAKE-BREAK-CANCEL = "Y";
    VHYT34IW-TRIGGERS.ENABLE-C-AM-MAKE = "Y";
    VHYT34IW-TRIGGERS.ENABLE-C-AM-BREAK = "Y";
    VHYT34IW-TRIGGERS.ENABLE-C-PM-MAKE = "Y";
    VHYT34IW-TRIGGERS.ENABLE-C-PM-BREAK = "Y";
    VHYT34IW-TRIGGERS.DISABLE-OVERRIDES = "Y";
    VHYT34IW-TRIGGERS.DISABLE-SINGLE-TRAIN = "Y";

  
    VHYT34IW.ALL-RE-ACTIVATE = "0";
    VHYT34IW.ALL-CANCEL = "0";
    VHYT34IW.PM-BREAK-CANCEL = "0";
    VHYT34IW.PM-BREAK-RE = "0";
    VHYT34IW.AM-BREAK-CANCEL = "0";
    VHYT34IW.AM-BREAK-RE = "0";
    VHYT34IW.PM-MAKE-CANCEL = "0";
    VHYT34IW.PM-MAKE-RE = "0";
    VHYT34IW.AM-MAKE-CANCEL = "0";
    VHYT34IW.AM-MAKE-RE = "0";

  
    VHYT34IW.PM-BREAK-STAT = "Scheduled";
    VHYT34IW.AM-BREAK-STAT = "Scheduled";
    VHYT34IW.PM-MAKE-STAT = "Scheduled";
    VHYT34IW.AM-MAKE-STAT = "Scheduled";
end 

Function VHYT34I-LISTSINGLE ()
  
   
    VHYT34IW-PROCESS.SINGLE-TRAIN-CNT = 0;

  
    VHYT34N_CRIT.DATE-SCHED-REV = VHYT34IW.REV-DATE;
    VHYT34N_CRIT.SCHED-CD = VHYT34IW.SCHED-CD;
    VHYT34N_CRIT.YRD-REQST = VHYT34I-PASSVALUE.YRD-TRK-YRD;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34N";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";
    set VHYT34N_DATA empty;


    
    try
        call "VHYT34N"(XDCONTROL, VHYT34N_CRIT, VHYT34N_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT34IW-PROCESS.SINGLE-TRAIN-CNT = XDCONTROL.UROWCNT;
            

  
   
        else

  
            XDCONTROL.UROWCNT = 0;
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end
    VHYT34IW-TRIGGERS.LOAD-SINGLE-TRAINS = "Y";
end 

Function VHYT34I-MIN-MAX ()
  

   
    VHYT34P_CRIT.DATE-SCHED-REV = VHYT34IW.REV-DATE;
    VHYT34P_CRIT.SCHED-CD = VHYT34IW.SCHED-CD;
    VHYT34P_CRIT.ARRIVAL-YRD = VHYT34I-PASSVALUE.YRD-TRK-YRD;
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34P";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";
    set VHYT34P_DATA empty;

    
    try
        call "VHYT34P"(XDCONTROL, VHYT34P_CRIT, VHYT34P_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT34IW-PROCESS.SCHED-ADJ-ROWS = XDCONTROL.UROWCNT;
        else

  
            XDCONTROL.UROWCNT = 0;
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end
end 

Function VHYT34I-OVERRIDES ()
  
  

  
  

   
    VHYT34I-MESSAGE.MESSAGE = " ";
    

  
    VHYT34IW.AM-MAKE-CANCEL-FLAG = "N";
    VHYT34IW.PM-MAKE-CANCEL-FLAG = "N";
    VHYT34IW.AM-BREAK-CANCEL-FLAG = "N";
    VHYT34IW.PM-BREAK-CANCEL-FLAG = "N";
    

  
    VHYT34I-VALID-TIME();

  
    if (VHYT34I-MESSAGE.MESSAGE != " ")
        return; 
    end 

  
    if (VHYT34IW.ALL-CANCEL == "1")
  
        VHYT34I-ADD-ROW();
        VHYT34IW.ALL-CANCEL = "0";
         
    end

  
    if (VHYT34IW.AM-MAKE-CANCEL == "1")
        if (VHYT34IW.AM-MAKE-FROM-TIME != " ")
            VHYT34IW.FROM-TIME = VHYT34IW.AM-MAKE-FROM-TIME;
        else
            VHYT34IW.AM-MAKE-FROM-TIME = VHYT34D_DATA.TIME-OF-ARRIVAL[1];
            VHYT34IW.FROM-TIME = VHYT34D_DATA.TIME-OF-ARRIVAL[1];
        end
        if (VHYT34IW.AM-MAKE-TO-TIME != " ")
            VHYT34IW.TO-TIME = VHYT34IW.AM-MAKE-TO-TIME;
        else
            VHYT34IW.AM-MAKE-TO-TIME = VHYT34D_DATA.TIME-OF-ARRIVAL[MA-CNT];
            VHYT34IW.TO-TIME = VHYT34D_DATA.TIME-OF-ARRIVAL[MA-CNT];
        end
        VHYT34IW.CON-SIZE = 0;
        VHYT34IW.AM-MAKE-CANCEL-FLAG = "Y";
        VHYT34I-ADD-ROW();
  
        VHYT34IW.AM-MAKE-CANCEL = "0";
        VHYT34IW.AM-MAKE-CANCEL-FLAG = "N";
    end

  
    if (VHYT34IW.AM-BREAK-CANCEL == "1")
        if (VHYT34IW.AM-BREAK-FROM-TIME != " ")
            VHYT34IW.FROM-TIME = VHYT34IW.AM-BREAK-FROM-TIME;
        else
            VHYT34IW.AM-BREAK-FROM-TIME = VHYT34D_BA_DATA.TIME-OF-ARRIVAL[1];
            VHYT34IW.FROM-TIME = VHYT34D_BA_DATA.TIME-OF-ARRIVAL[1];
        end
        if (VHYT34IW.AM-BREAK-TO-TIME != " ")
            VHYT34IW.TO-TIME = VHYT34IW.AM-BREAK-TO-TIME;
        else
            VHYT34IW.AM-BREAK-TO-TIME = VHYT34D_BA_DATA.TIME-OF-ARRIVAL[BA-CNT];
            VHYT34IW.TO-TIME = VHYT34D_BA_DATA.TIME-OF-ARRIVAL[BA-CNT];
        end
        VHYT34IW.CON-SIZE = 0;
        VHYT34IW.AM-BREAK-CANCEL-FLAG = "Y";
        VHYT34I-ADD-ROW();
  
        VHYT34IW.AM-BREAK-CANCEL = "0"; 
        VHYT34IW.CON-SIZE = 0;
        VHYT34IW.AM-BREAK-CANCEL-FLAG = "N";
    end

  
    if (VHYT34IW.PM-MAKE-CANCEL == "1")
        if (VHYT34IW.PM-MAKE-FROM-TIME != " ")
            VHYT34IW.FROM-TIME = VHYT34IW.PM-MAKE-FROM-TIME;
        else
            VHYT34IW.PM-MAKE-FROM-TIME = VHYT34D_MP_DATA.TIME-OF-ARRIVAL[1];
            VHYT34IW.FROM-TIME = VHYT34D_MP_DATA.TIME-OF-ARRIVAL[1];
        end
        if (VHYT34IW.PM-MAKE-TO-TIME != " ")
            VHYT34IW.TO-TIME = VHYT34IW.PM-MAKE-TO-TIME;
        else
            VHYT34IW.PM-MAKE-TO-TIME = VHYT34D_MP_DATA.TIME-OF-ARRIVAL[MP-CNT];
            VHYT34IW.TO-TIME = VHYT34D_MP_DATA.TIME-OF-ARRIVAL[MP-CNT];
        end
        VHYT34IW.CON-SIZE = 0;
        VHYT34IW.CON-SIZE = 0;
        VHYT34IW.PM-MAKE-CANCEL-FLAG = "Y";
        VHYT34I-ADD-ROW();
  
        VHYT34IW.PM-MAKE-CANCEL = "0";
        VHYT34IW.PM-MAKE-CANCEL-FLAG = "N";
    end

  
    if (VHYT34IW.PM-BREAK-CANCEL == "1")
        if (VHYT34IW.PM-BREAK-FROM-TIME != " ")
            VHYT34IW.FROM-TIME = VHYT34IW.PM-BREAK-FROM-TIME;
        else
            VHYT34IW.PM-BREAK-FROM-TIME = VHYT34D_BP_DATA.TIME-OF-ARRIVAL[1];
            VHYT34IW.FROM-TIME = VHYT34D_BP_DATA.TIME-OF-ARRIVAL[1];
        end
        if (VHYT34IW.PM-BREAK-TO-TIME != " ")
            VHYT34IW.TO-TIME = VHYT34IW.PM-BREAK-TO-TIME;
        else
            VHYT34IW.PM-BREAK-TO-TIME = VHYT34D_BP_DATA.TIME-OF-ARRIVAL[BP-CNT];
            VHYT34IW.TO-TIME = VHYT34D_BP_DATA.TIME-OF-ARRIVAL[BP-CNT];
        end
        VHYT34IW.CON-SIZE = 0;
        VHYT34IW.PM-BREAK-CANCEL-FLAG = "Y";
        VHYT34I-ADD-ROW();
  
        VHYT34IW.PM-BREAK-CANCEL = "0";
        VHYT34IW.PM-BREAK-CANCEL-FLAG = "N";
    end

  
  
  
    set VHYT34F_CRIT empty;
    set VHYT34F_DATA empty;
    if (VHYT34IW.ALL-RE-ACTIVATE == "1")
        VHYT34F_CRIT.TIME-FROM = "00.00.01"; 
        VHYT34F_CRIT.TIME-TO = "23.59.59";
        VHYT34F_CRIT.CANCEL-ALL = "Y";
    end
    if (VHYT34IW.AM-MAKE-RE == "1")
        VHYT34F_CRIT.CANCEL-AM-MK = "Y";
    end
    if (VHYT34IW.AM-BREAK-RE == "1")
        VHYT34F_CRIT.CANCEL-AM-BRK = "Y";
    end
    if (VHYT34IW.PM-MAKE-RE == "1")
        VHYT34F_CRIT.CANCEL-PM-MK = "Y";
    end
    if (VHYT34IW.PM-BREAK-RE == "1")
        VHYT34F_CRIT.CANCEL-PM-BRK = "Y";
    end

  
  
  
    if (VHYT34IW.AM-BREAK-RE == "1" || VHYT34IW.PM-BREAK-RE == "1" || VHYT34IW.ALL-RE-ACTIVATE == "1" || VHYT34IW.AM-MAKE-RE == "1" || VHYT34IW.PM-MAKE-RE == "1")
        set VHYT34K_CRIT empty;

  
        VHYT34F_CRIT.DATE-SCHED-REV = VHYT34IW.REV-DATE;
        VHYT34F_CRIT.SCHED-CD = VHYT34IW.SCHED-CD;
        VHYT34F_CRIT.YRD-REQST = VHYT34I-PASSVALUE.YRD-TRK-YRD;
        VHYT34F_CRIT.TERM-LAST-UPD = VHYT34I-PASSVALUE.TERM-ID;
        

  
  
        VHYT34I-TIMESTAMPS();

  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34F";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";
        set VHYT34K_DATA empty;

    
        try
            call "VHYT34F"(XDCONTROL, VHYT34F_CRIT, VHYT34F_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHYT34I-MESSAGE.MESSAGE = "The Make/Break Re-Activates were Done, Single Train Overrides were Removed";
  
                VHYT34IW-TRIGGERS.REFRESH-ST = "Y";
  
                if (VHYT34IW.ALL-RE-ACTIVATE == "1")
                    VHYT34IW.ALL-STAT = " ";
                    VHYT34IW.AM-MAKE-STAT = "Scheduled";
                    VHYT34IW.PM-MAKE-STAT = "Scheduled";
                    VHYT34IW.AM-BREAK-STAT = "Scheduled";
                    VHYT34IW.PM-BREAK-STAT = "Scheduled";
                    VHYT34IW-TRIGGERS.DISABLE-ALL-MAKE-BREAK-RE = "Y";
                    VHYT34IW-TRIGGERS.ENABLE-ALL-MAKE-BREAK-CANCEL = "Y";
                end
                if (VHYT34IW.AM-MAKE-RE == "1")
                    VHYT34IW-TRIGGERS.DISABLE-R-AM-MAKE = "Y";
                    VHYT34IW-TRIGGERS.ENABLE-C-AM-MAKE = "Y";
                    VHYT34IW.AM-MAKE-STAT = "Scheduled";
                end
                if (VHYT34IW.AM-BREAK-RE == "1")
                    VHYT34IW-TRIGGERS.DISABLE-R-AM-BREAK = "Y";
                    VHYT34IW-TRIGGERS.ENABLE-C-AM-BREAK = "Y";
                    VHYT34IW.AM-BREAK-STAT = "Scheduled";
                end
                if (VHYT34IW.PM-MAKE-RE == "1")
                    VHYT34IW-TRIGGERS.DISABLE-R-PM-MAKE = "Y";
                    VHYT34IW-TRIGGERS.ENABLE-C-PM-MAKE = "Y";
                    VHYT34IW.PM-MAKE-STAT = "Scheduled";
                end
                if (VHYT34IW.PM-BREAK-RE == "1")
                    VHYT34IW-TRIGGERS.DISABLE-R-PM-BREAK = "Y";
                    VHYT34IW-TRIGGERS.ENABLE-C-PM-BREAK = "Y";
                    VHYT34IW.PM-BREAK-STAT = "Scheduled";
                end
            else

  
                XDCONTROL.UROWCNT = 0;
        
        
  
                if (XDCONTROL.URC == 100)

                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end 
        end
    end 

  
    VHYT34IW-TRIGGERS.DISABLE-OVERRIDES = "Y";
    

  
    VHYT34I-SCHED-ADJ();
    if (VHYT34IW.AM-BREAK-RE == "1" || VHYT34IW.PM-BREAK-RE == "1" || VHYT34IW.AM-MAKE-RE == "1" || VHYT34IW.PM-MAKE-RE == "1")
        VHYT34I-TRAIN-DROP();
        VHYT34I-LISTSINGLE();
        VHYT34IW.AM-BREAK-RE = "0";
        VHYT34IW.PM-BREAK-RE = "0";
        VHYT34IW.AM-MAKE-RE = "0";
        VHYT34IW.PM-MAKE-RE = "0";
    end

  
    if (VHYT34IW.ALL-RE-ACTIVATE == "1")
        VHYT34I-RESET();
        VHYT34I-TRAIN-DROP();
        VHYT34I-LISTSINGLE();
        VHYT34IW.ALL-RE-ACTIVATE = "0";
    end
end 

Function VHYT34I-RESET ()

   
    VHYT34I-MESSAGE.MESSAGE = "Enter Make / Break OR Enter Single Car Override Request";
  
  
    VHYT34IW-PROCESS.CAN-AM-MAKE-FLAG = "N";
    VHYT34IW-PROCESS.CAN-PM-MAKE-FLAG = "N";
    VHYT34IW-PROCESS.CAN-AM-BREAK-FLAG = "N";
    VHYT34IW-PROCESS.CAN-PM-BREAK-FLAG = "N";
    VHYT34IW-PROCESS.CAN-ALL-FLAG = "N";

  
    VHYT34IW-TRIGGERS.ST-DISABLE-C-BREAK = "Y";
    VHYT34IW-TRIGGERS.ST-DISABLE-C-MAKE = "Y";

  

  
    VHYT34IW-TRIGGERS.DISABLE-R-AM-MAKE = "Y";
    VHYT34IW-TRIGGERS.DISABLE-R-AM-BREAK = "Y";
    VHYT34IW-TRIGGERS.DISABLE-R-PM-MAKE = "Y";
    VHYT34IW-TRIGGERS.DISABLE-R-PM-BREAK = "Y";

  
    VHYT34IW-TRIGGERS.ENABLE-C-AM-MAKE = "Y";
    VHYT34IW-TRIGGERS.ENABLE-C-AM-BREAK = "Y";
    VHYT34IW-TRIGGERS.ENABLE-C-PM-MAKE = "Y";
    VHYT34IW-TRIGGERS.ENABLE-C-PM-BREAK = "Y";
    VHYT34IW-TRIGGERS.DISABLE-OVERRIDES = "Y";
    VHYT34IW-TRIGGERS.DISABLE-SINGLE-TRAIN = "Y";

  
    VHYT34IW.ALL-RE-ACTIVATE = "0";
    VHYT34IW.ALL-CANCEL = "0";
    VHYT34IW.PM-BREAK-CANCEL = "0";
    VHYT34IW.PM-BREAK-RE = "0";
    VHYT34IW.AM-BREAK-CANCEL = "0";
    VHYT34IW.AM-BREAK-RE = "0";
    VHYT34IW.PM-MAKE-CANCEL = "0";
    VHYT34IW.PM-MAKE-RE = "0";
    VHYT34IW.AM-MAKE-CANCEL = "0";
    VHYT34IW.AM-MAKE-RE = "0";

  
    VHYT34IW.PM-BREAK-STAT = "Scheduled";
    VHYT34IW.AM-BREAK-STAT = "Scheduled";
    VHYT34IW.PM-MAKE-STAT = "Scheduled";
    VHYT34IW.AM-MAKE-STAT = "Scheduled";

  
  
    if (VHYT34D_CRIT.BP-CNT == 0)
        VHYT34IW.PM-BREAK-STAT = " ";
    end
    if (VHYT34D_CRIT.BA-CNT == 0)
        VHYT34IW.AM-BREAK-STAT = " ";
    end
    if (VHYT34D_CRIT.MP-CNT == 0)
        VHYT34IW.PM-MAKE-STAT = " ";
         
    end
    if (VHYT34D_CRIT.MA-CNT == 0)
        VHYT34IW.AM-MAKE-STAT = "  ";
    end
end 

Function VHYT34I-REV-DATE ()
  
   
    VHYT34IW.REV-DATE = " ";
    VHYT34IW.REV-DATE-MMDDYYYY = " ";
    set VHYT34A_DATA empty;
    set VHYT34IW-DATES empty;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE01I";
    set VHYT34A_DATA empty;

    
    try
        call "VHYT34A"(XDCONTROL, VHYT34A_CRIT, VHYT34A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end

  
    if (VHYT34A_DATA.CURRENT-TIME > VHYT34A_DATA.TIME-REV-END)
        VHYT34IW.REV-DATE = VHYT34A_DATA.CURRENT-DATE;
    else
        VHYT34IW.REV-DATE = VHYT34A_DATA.YESTERDAY;
    end

  
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHYT34IW.REV-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHYT34IW.REV-DATE-MMDDYYYY = XXDATEW.DATE-MM-DD-YYYY;

  
  
  
  
    set VHYT34B_DATA empty;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34B";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE01I";
    set VHYT34B_DATA empty;

    
    try
        call "VHYT34B"(XDCONTROL, VHYT34B_CRIT, VHYT34B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end

  
    if (VHYT34B_DATA.CNT-DAY-OF-WEEK == 0)
        VHYT34IW.SCHED-CD = "SU";
    end
    if (VHYT34B_DATA.CNT-DAY-OF-WEEK == 6)
        VHYT34IW.SCHED-CD = "SA";
    end
    if (VHYT34B_DATA.CNT-DAY-OF-WEEK == 1 || VHYT34B_DATA.CNT-DAY-OF-WEEK == 2 || VHYT34B_DATA.CNT-DAY-OF-WEEK == 3 ||
     VHYT34B_DATA.CNT-DAY-OF-WEEK == 4 || VHYT34B_DATA.CNT-DAY-OF-WEEK == 5)
        VHYT34IW.SCHED-CD = "WK";
    end

  
  
  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34C";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE01I";
    set VHYT34C_DATA empty;
    VHYT34C_CRIT.DATE-SCHED-REV = VHYT34IW.REV-DATE;
    
    try
        call "VHYT34C"(XDCONTROL, VHYT34C_CRIT, VHYT34C_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
  
  
            VHYT34IW.SCHED-CD = VHYT34C_DATA.SCHED-CD;
             
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end
end 

Function VHYT34I-SCHED-ADJ ()
  
  

  
   
    set VHYT34IW-PROCESS empty;
    set VHYT34E_DATA empty;
    set VHYT34E_CRIT empty;

  
    VHYT34E_CRIT.DATE-SCHED-REV = VHYT34IW.REV-DATE;
    VHYT34E_CRIT.SCHED-CD = VHYT34IW.SCHED-CD;
    VHYT34E_CRIT.YRD-REQST = VHYT34I-PASSVALUE.YRD-TRK-YRD;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34E";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";
    set VHYT34E_DATA empty;

    
    try
        call "VHYT34E"(XDCONTROL, VHYT34E_CRIT, VHYT34E_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT34IW-PROCESS.SCHED-ADJ-ROWS = XDCONTROL.UROWCNT;
        else

  
            XDCONTROL.UROWCNT = 0;
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end

  
    if (VHYT34IW-PROCESS.SCHED-ADJ-ROWS > 0)

  
  
        CNT = 1;
        while (CNT <= VHYT34IW-PROCESS.SCHED-ADJ-ROWS)
            if (VHYT34E_DATA.CANCEL-ALL-IND[CNT] == "Y")
                VHYT34IW-PROCESS.CAN-ALL-FLAG = "Y";
            end
  
            if (VHYT34E_DATA.CANCEL-AM-BRK-IND[CNT] == "Y")
                VHYT34IW-PROCESS.CAN-AM-BREAK-FLAG = "Y";
                VHYT34IW-PROCESS.AM-BREAK-FROM-TIME = VHYT34E_DATA.TIME-OF-ARRIVAL-FR[CNT]; 
                VHYT34IW-PROCESS.AM-BREAK-TO-TIME = VHYT34E_DATA.TIME-OF-ARRIVAL-TO[CNT];
            end
  
            if (VHYT34E_DATA.CANCEL-PM-BRK-IND[CNT] == "Y")
                VHYT34IW-PROCESS.CAN-PM-BREAK-FLAG = "Y";
                VHYT34IW-PROCESS.PM-BREAK-FROM-TIME = VHYT34E_DATA.TIME-OF-ARRIVAL-FR[CNT]; 
                VHYT34IW-PROCESS.PM-BREAK-TO-TIME = VHYT34E_DATA.TIME-OF-ARRIVAL-TO[CNT];
            end
  
            if (VHYT34E_DATA.CANCEL-AM-MK-IND[CNT] == "Y")
                VHYT34IW-PROCESS.CAN-AM-MAKE-FLAG = "Y";
                VHYT34IW-PROCESS.AM-MAKE-FROM-TIME = VHYT34E_DATA.TIME-OF-ARRIVAL-FR[CNT]; 
                VHYT34IW-PROCESS.AM-MAKE-TO-TIME = VHYT34E_DATA.TIME-OF-ARRIVAL-TO[CNT];
            end

  
            if (VHYT34E_DATA.CANCEL-PM-MK-IND[CNT] == "Y")
                VHYT34IW-PROCESS.CAN-PM-MAKE-FLAG = "Y";
                VHYT34IW-PROCESS.PM-MAKE-FROM-TIME = VHYT34E_DATA.TIME-OF-ARRIVAL-FR[CNT]; 
                VHYT34IW-PROCESS.PM-MAKE-TO-TIME = VHYT34E_DATA.TIME-OF-ARRIVAL-TO[CNT];
            end
            CNT = CNT + 1;
        end 

  
        if (VHYT34IW-PROCESS.CAN-AM-BREAK-FLAG == "Y") 
            VHYT34IW-TRIGGERS.DISABLE-C-AM-BREAK = "Y";
            VHYT34IW-TRIGGERS.ENABLE-R-AM-BREAK = "Y";
            VHYT34IW.AM-BREAK-STAT = "Cancelled";
        else 
            VHYT34IW-TRIGGERS.ENABLE-C-AM-BREAK = "Y";
            VHYT34IW-TRIGGERS.DISABLE-R-AM-BREAK = "Y";
        end
        if (VHYT34IW-PROCESS.CAN-AM-MAKE-FLAG == "Y") 
            VHYT34IW-TRIGGERS.DISABLE-C-AM-MAKE = "Y";
            VHYT34IW-TRIGGERS.ENABLE-R-AM-MAKE = "Y";
            VHYT34IW.AM-MAKE-STAT = "Cancelled";
        else
            VHYT34IW-TRIGGERS.ENABLE-C-AM-MAKE = "Y";
            VHYT34IW-TRIGGERS.DISABLE-R-AM-MAKE = "Y";
        end
        if (VHYT34IW-PROCESS.CAN-PM-BREAK-FLAG == "Y") 
            VHYT34IW-TRIGGERS.DISABLE-C-PM-BREAK = "Y";
            VHYT34IW-TRIGGERS.ENABLE-R-PM-BREAK = "Y";
            VHYT34IW.PM-BREAK-STAT = "Cancelled";
        else
            VHYT34IW-TRIGGERS.ENABLE-C-PM-BREAK = "Y";
            VHYT34IW-TRIGGERS.DISABLE-R-PM-BREAK = "Y";
        end
        if (VHYT34IW-PROCESS.CAN-PM-MAKE-FLAG == "Y") 
            VHYT34IW-TRIGGERS.DISABLE-C-PM-MAKE = "Y";
            VHYT34IW-TRIGGERS.ENABLE-R-PM-MAKE = "Y";
            VHYT34IW.PM-MAKE-STAT = "Cancelled";
        else
            VHYT34IW-TRIGGERS.ENABLE-C-PM-MAKE = "Y";
            VHYT34IW-TRIGGERS.DISABLE-R-PM-MAKE = "Y";
        end

  
        if (VHYT34IW-PROCESS.CAN-ALL-FLAG == "Y") 
            VHYT34IW-TRIGGERS.DISABLE-ALL-MAKE-BREAK-CANCEL = "Y";
            VHYT34IW-TRIGGERS.ENABLE-ALL-MAKE-BREAK-RE = "Y";
            VHYT34IW-TRIGGERS.DISABLE-C-AM-MAKE = "Y";
            VHYT34IW-TRIGGERS.DISABLE-C-AM-BREAK = "Y";
            VHYT34IW-TRIGGERS.DISABLE-C-PM-MAKE = "Y";
            VHYT34IW-TRIGGERS.DISABLE-C-PM-BREAK = "Y";
            VHYT34IW.ALL-STAT = "Cancelled";
            VHYT34IW.PM-BREAK-STAT = "Cancelled";
            VHYT34IW.AM-BREAK-STAT = "Cancelled";
            VHYT34IW.PM-MAKE-STAT = "Cancelled";
            VHYT34IW.AM-MAKE-STAT = "Cancelled";
        end
  
  
  
  
        if (VHYT34IW-PROCESS.CAN-AM-BREAK-FLAG == "N") 
            VHYT34IW-TRIGGERS.DISABLE-R-AM-BREAK = "Y";
            VHYT34IW.AM-BREAK-STAT = "Scheduled";
        end
        if (VHYT34IW-PROCESS.CAN-AM-MAKE-FLAG == "N") 
            VHYT34IW-TRIGGERS.DISABLE-R-AM-MAKE = "Y";
            VHYT34IW.AM-MAKE-STAT = "Scheduled";
        end
        if (VHYT34IW-PROCESS.CAN-PM-BREAK-FLAG == "N") 
            VHYT34IW-TRIGGERS.DISABLE-R-PM-BREAK = "Y";
            VHYT34IW.PM-BREAK-STAT = "Scheduled";
        end
        if (VHYT34IW-PROCESS.CAN-PM-MAKE-FLAG == "N") 
            VHYT34IW-TRIGGERS.DISABLE-R-PM-MAKE = "Y";
            VHYT34IW.AM-MAKE-STAT = "Scheduled";
        end
        if (VHYT34IW-PROCESS.CAN-ALL-FLAG == "N")
            VHYT34IW-TRIGGERS.DISABLE-ALL-MAKE-BREAK-RE = "Y";
            VHYT34IW-TRIGGERS.DISABLE-R-AM-MAKE = "Y";
            VHYT34IW-TRIGGERS.DISABLE-R-AM-BREAK = "Y";
            VHYT34IW-TRIGGERS.DISABLE-R-PM-MAKE = "Y";
            VHYT34IW-TRIGGERS.DISABLE-R-PM-BREAK = "Y";
            VHYT34IW.ALL-STAT = "Scheduled";
        end
    else
  
        VHYT34IW-TRIGGERS.DISABLE-ALL-MAKE-BREAK-RE = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-AM-MAKE = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-AM-BREAK = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-PM-MAKE = "Y";
        VHYT34IW-TRIGGERS.DISABLE-R-PM-BREAK = "Y";
        VHYT34IW-TRIGGERS.ENABLE-ALL-MAKE-BREAK-CANCEL = "Y";
        VHYT34IW-TRIGGERS.ENABLE-C-AM-MAKE = "Y";
        VHYT34IW-TRIGGERS.ENABLE-C-AM-BREAK = "Y";
        VHYT34IW-TRIGGERS.ENABLE-C-PM-MAKE = "Y";
        VHYT34IW-TRIGGERS.ENABLE-C-PM-BREAK = "Y";
    end


  
    if (VHYT34IW.RUN-WITH-NEW-DATE-FLAG == "Y")
        VHYT34IW-TRIGGERS.RUN-TRAIN-DROP = "Y";
    end
end 

Function VHYT34I-SCHED-FOR ()
  
  
   
    if (VHYT34I-TIME-INDEX.TIME-OF-ARRIVAL-IDX > 0) 
        set VHYT34K_CRIT empty;

  
        VHYT34K_CRIT.DATE-SCHED-REV = VHYT34IW.REV-DATE;
        VHYT34K_CRIT.SCHED-CD = VHYT34IW.SCHED-CD;
        VHYT34K_CRIT.ARRIVAL-YRD = VHYT34I-PASSVALUE.YRD-TRK-YRD;
        VHYT34K_CRIT.CON-NO = VHYT34IW.CON-NO;
        VHYT34K_CRIT.TIME-OF-ARRIVAL = VHYT34IW.TIME-OF-ARRIVAL;

  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34K";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";
        set VHYT34K_DATA empty;

    
        try
            call "VHYT34K"(XDCONTROL, VHYT34K_CRIT, VHYT34K_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

            else

  
                XDCONTROL.UROWCNT = 0;
        
        
  
                if (XDCONTROL.URC == 100)

                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end 
        end

  
        VHYT34IW.SCHEDULED-FOR = "NONE";
        if (VHYT34K_DATA.BLD-UP-REDUCTN-CD == "MA" || VHYT34K_DATA.BLD-UP-REDUCTN-CD == "MP")
            VHYT34IW.SCHEDULED-FOR = "MAKE";
        end
        if (VHYT34K_DATA.BLD-UP-REDUCTN-CD == "BA" || VHYT34K_DATA.BLD-UP-REDUCTN-CD == "BP")
            VHYT34IW.SCHEDULED-FOR = "BREAK";
        end

  
  
  
        set VHYT34L_CRIT empty;

  
        VHYT34L_CRIT.DATE-SCHED-REV = VHYT34IW.REV-DATE;
        VHYT34L_CRIT.SCHED-CD = VHYT34IW.SCHED-CD;
        VHYT34L_CRIT.YRD-REQST = VHYT34I-PASSVALUE.YRD-TRK-YRD;
        VHYT34L_CRIT.TIME-OF-ARRIVAL = VHYT34IW.TIME-OF-ARRIVAL;
        VHYT34L_CRIT.NUM-OF-ROWS = 0;

  
        VHYT34L_CRIT.DATE-FROM = VHYT34J_DATA.DATE-ARRIVAL-WORK[TIME-OF-ARRIVAL-IDX];
        VHYT34L_CRIT.DASH1 = "-";
        VHYT34L_CRIT.TIME-FROM = VHYT34IW.TIME-OF-ARRIVAL;
        VHYT34L_CRIT.REST-FROM = ".000000";


  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34L";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";
        set VHYT34K_DATA empty;

    
        try
            call "VHYT34L"(XDCONTROL, VHYT34L_CRIT, VHYT34L_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHYT34L_CRIT.NUM-OF-ROWS = XDCONTROL.UROWCNT;
            else

  
                XDCONTROL.UROWCNT = 0;
        
        
  
                if (XDCONTROL.URC == 100)

                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end 
        end

  
        if (VHYT34L_CRIT.NUM-OF-ROWS > 0)
  
            if (VHYT34L_DATA.CANCEL-AM-BRK-IND[1] == "Y" ||
             VHYT34L_DATA.CANCEL-PM-BRK-IND[1] == "Y" ||
             VHYT34L_DATA.CANCEL-AM-MK-IND[1] == "Y" ||
             VHYT34L_DATA.CANCEL-PM-MK-IND[1] == "Y" ||
             VHYT34L_DATA.CANCEL-ALL-IND[1] == "Y")
                VHYT34IW.SCHEDULED-FOR = "CANCELLED";
            end
        end

  
  
  
        set VHYT34M_CRIT empty;

  
        VHYT34M_CRIT.DATE-SCHED-REV = VHYT34IW.REV-DATE;
        VHYT34M_CRIT.SCHED-CD = VHYT34IW.SCHED-CD;
        VHYT34M_CRIT.YRD-REQST = VHYT34I-PASSVALUE.YRD-TRK-YRD;
        VHYT34M_CRIT.TIME-OF-ARRIVAL = VHYT34IW.TIME-OF-ARRIVAL;
        VHYT34M_CRIT.NUM-OF-ROWS = 0;

  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34M";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";
        set VHYT34K_DATA empty;

    
        try
            call "VHYT34M"(XDCONTROL, VHYT34M_CRIT, VHYT34M_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHYT34M_CRIT.NUM-OF-ROWS = XDCONTROL.UROWCNT;
            else

  
                XDCONTROL.UROWCNT = 0;
        
        
  
                if (XDCONTROL.URC == 100)

                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end 
        end


  
        if (VHYT34M_CRIT.NUM-OF-ROWS > 0)
  
            if (VHYT34L_DATA.CANCEL-AM-BRK-IND == "Y" ||
             VHYT34M_DATA.CANCEL-PM-BRK-IND == "Y" ||
             VHYT34M_DATA.CANCEL-AM-MK-IND == "Y" ||
             VHYT34M_DATA.CANCEL-PM-MK-IND == "Y")
                VHYT34IW.SCHEDULED-FOR = "CANCELLED";
            end
            if (VHYT34M_DATA.SCHED-AM-BRK-IND == "Y" || VHYT34M_DATA.SCHED-PM-BRK-IND == "Y")
                VHYT34IW.SCHEDULED-FOR = "BREAK";
            end
            if (VHYT34M_DATA.SCHED-AM-MK-IND == "Y" || VHYT34M_DATA.SCHED-PM-MK-IND == "Y")
                VHYT34IW.SCHEDULED-FOR = "MAKE";
            end
        end

  
  
  
        if (VHYT34IW.SCHEDULED-FOR == "BREAK")
            ST-DISABLE-S-BREAK = "Y"; 
            ST-ENABLE-C-BREAK = "Y";
             
        end
        if (VHYT34IW.SCHEDULED-FOR == "CANCELLED")
            ST-DISABLE-C-BREAK = "Y"; 
            ST-ENABLE-S-BREAK = "Y";
             
        end
        if (VHYT34IW.SCHEDULED-FOR == "MAKE")
            ST-DISABLE-C-BREAK = "Y"; 
            ST-DISABLE-S-BREAK = "Y";
             
        end
        if (VHYT34IW.SCHEDULED-FOR == "NONE" || VHYT34IW.SCHEDULED-FOR == " ")
            ST-DISABLE-C-BREAK = "Y"; 
            ST-ENABLE-S-BREAK = "Y";
             
        end

  
        if (VHYT34IW.SCHEDULED-FOR == "BREAK")
            ST-DISABLE-S-MAKE = "Y"; 
            ST-DISABLE-C-MAKE = "Y";
             
        end
        if (VHYT34IW.SCHEDULED-FOR == "CANCELLED")
            ST-DISABLE-C-MAKE = "Y"; 
            ST-ENABLE-S-MAKE = "Y";
             
        end
        if (VHYT34IW.SCHEDULED-FOR == "MAKE")
            ST-ENABLE-C-MAKE = "Y"; 
            ST-DISABLE-S-MAKE = "Y";
             
        end
        if (VHYT34IW.SCHEDULED-FOR == "NONE" || VHYT34IW.SCHEDULED-FOR == " ")
            ST-DISABLE-C-MAKE = "Y"; 
            ST-ENABLE-S-MAKE = "Y";
             
        end
    end
end 

Function VHYT34I-SINGLEOVER ()
  

   
    set VHYT34G_DATA empty;
  
    VHYT34G_DATA.CON-SIZE = VHYT34J_DATA.CON-SIZE[TIME-OF-ARRIVAL-IDX];
    VHYT34G_DATA.DATE-SCHED-REV = VHYT34IW.REV-DATE;
    VHYT34G_DATA.CON-NO-FROM = VHYT34IW.CON-NO;
    VHYT34G_DATA.CON-NO-TO = VHYT34IW.CON-NO;
    VHYT34G_DATA.TIME-OF-ARRIVAL-FR = VHYT34IW.TIME-OF-ARRIVAL;
    VHYT34G_DATA.TIME-OF-ARRIVAL-TO = VHYT34IW.TIME-OF-ARRIVAL;
    VHYT34G_DATA.DATE-ARRIVAL-FROM = VHYT34J_DATA.DATE-ARRIVAL-WORK[TIME-OF-ARRIVAL-IDX];
    VHYT34G_DATA.DATE-ARRIVAL-TO = VHYT34J_DATA.DATE-ARRIVAL-WORK[TIME-OF-ARRIVAL-IDX];
    VHYT34G_DATA.CANCEL-ALL-IND = "N";
    VHYT34G_DATA.SCHED-CD = VHYT34IW.SCHED-CD;
    VHYT34G_DATA.ACTV-IND = "Y";
    VHYT34G_DATA.END-RUN-IND = "N";
    VHYT34G_DATA.USER-GRP-REQST = VHYT34I-PASSVALUE.USER-GROUP;
    VHYT34G_DATA.TERM-OF-REQST = VHYT34I-PASSVALUE.TERM-ID;
    VHYT34G_DATA.SCHED-CD = VHYT34IW.SCHED-CD;
    VHYT34G_DATA.YRD-REQST = VHYT34I-PASSVALUE.YRD-TRK-YRD;

  
    VHYT34G_DATA.SCHED-PM-BRK-IND = "N";
    VHYT34G_DATA.SCHED-AM-BRK-IND = "N";
    VHYT34G_DATA.SCHED-PM-MK-IND = "N";
    VHYT34G_DATA.SCHED-AM-MK-IND = "N";
    if (VHYT34IW.ST-BREAK-SCHED == "1") 
        if (VHYT34IW.TIME-OF-ARRIVAL >= "12.00.00" && VHYT34J_DATA.BLD-UP-REDUCTN-CD[TIME-OF-ARRIVAL-IDX] == " ")
            VHYT34G_DATA.SCHED-PM-BRK-IND = "Y";
        end
        if (VHYT34IW.TIME-OF-ARRIVAL < "12.00.00" && VHYT34J_DATA.BLD-UP-REDUCTN-CD[TIME-OF-ARRIVAL-IDX] == " ")
            VHYT34G_DATA.SCHED-AM-BRK-IND = "Y";
        end
    end
    if (VHYT34IW.ST-MAKE-SCHED == "1") 
        if (VHYT34IW.TIME-OF-ARRIVAL >= "12.00.00" && VHYT34J_DATA.BLD-UP-REDUCTN-CD[TIME-OF-ARRIVAL-IDX] == " ")
            VHYT34G_DATA.SCHED-PM-MK-IND = "Y";
        end
        if (VHYT34IW.TIME-OF-ARRIVAL < "12.00.00" && VHYT34J_DATA.BLD-UP-REDUCTN-CD[TIME-OF-ARRIVAL-IDX] == " ")
            VHYT34G_DATA.SCHED-AM-MK-IND = "Y";
        end
    end

  
    VHYT34G_DATA.CANCEL-AM-BRK-IND = "N";
    VHYT34G_DATA.CANCEL-PM-BRK-IND = "N";
    VHYT34G_DATA.CANCEL-AM-MK-IND = "N";
    VHYT34G_DATA.CANCEL-PM-MK-IND = "N";
    if (VHYT34IW.ST-BREAK-CANCEL == "1") 
        if (VHYT34J_DATA.BLD-UP-REDUCTN-CD[TIME-OF-ARRIVAL-IDX] == "BA")
            VHYT34G_DATA.CANCEL-AM-BRK-IND = "Y";
        end
        if (VHYT34J_DATA.BLD-UP-REDUCTN-CD[TIME-OF-ARRIVAL-IDX] == "BP")
            VHYT34G_DATA.CANCEL-PM-BRK-IND = "Y";
        end
    end
    if (VHYT34IW.ST-MAKE-CANCEL == "1") 
        if (VHYT34J_DATA.BLD-UP-REDUCTN-CD[TIME-OF-ARRIVAL-IDX] == "MA")
            VHYT34G_DATA.CANCEL-AM-MK-IND = "Y";
        end
        if (VHYT34J_DATA.BLD-UP-REDUCTN-CD[TIME-OF-ARRIVAL-IDX] == "MP")
            VHYT34G_DATA.CANCEL-PM-MK-IND = "Y";
        end
    end

  
    if (VHYT34IW.SCHEDULED-FOR == "MAKE" || VHYT34IW.SCHEDULED-FOR == "BREAK" || VHYT34IW.SCHEDULED-FOR == "CANCEL")
        VHYT34G_DATA.SCHED-FOR = VHYT34IW.SCHEDULED-FOR;
    else
        VHYT34G_DATA.SCHED-FOR = " ";
    end


  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34G";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";

    
    try
        call "VHYT34G"(XDCONTROL, VHYT34G_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT34I-MESSAGE.MESSAGE = "The Scheduled Action Was Added Successfully";
            VHYT34IW-TRIGGERS.REFRESH-ST = "Y";
            VHYT34IW-TRIGGERS.DISABLE-SINGLE-TRAIN = "Y";
        else

  
            XDCONTROL.UROWCNT = 0;
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end
end 

Function VHYT34I-TIMES ()
  
  
  
  

   
    VHYT34D_CRIT.SCHED-CD = VHYT34IW.SCHED-CD;
    VHYT34D_CRIT.ARRIVAL-YRD = VHYT34I-PASSVALUE.YRD-TRK-YRD;
  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34D";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";
    set VHYT34D_DATA empty;
    set VHYT34D_BA_DATA empty;
    set VHYT34D_MP_DATA empty;
    set VHYT34D_BP_DATA empty;

    
    try
        call "VHYT34D"(XDCONTROL, VHYT34D_CRIT, VHYT34D_DATA, VHYT34D_BA_DATA, VHYT34D_MP_DATA, VHYT34D_BP_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

  
            XDCONTROL.UROWCNT = 0;
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end

  
    VHYT34IW-TRIGGERS.LOAD-TIMES = "Y";


  
  
    if (VHYT34D_CRIT.BP-CNT == 0)
        VHYT34IW.PM-BREAK-STAT = " ";
    end
    if (VHYT34D_CRIT.BA-CNT == 0)
        VHYT34IW.AM-BREAK-STAT = " ";
    end
    if (VHYT34D_CRIT.MP-CNT == 0)
        VHYT34IW.PM-MAKE-STAT = " ";
         
    end
    if (VHYT34D_CRIT.MA-CNT == 0)
        VHYT34IW.AM-MAKE-STAT = "  ";
    end


  
  
    VHYT34IW-PROCESS.AM-MAKE-FROM-TIME = VHYT34D_DATA.TIME-OF-ARRIVAL[1];
    if (MA-CNT > 0)
        VHYT34IW-PROCESS.AM-MAKE-TO-TIME = VHYT34D_DATA.TIME-OF-ARRIVAL[MA-CNT];
    else
        VHYT34IW-PROCESS.AM-MAKE-TO-TIME = VHYT34D_DATA.TIME-OF-ARRIVAL[1];
    end
  
    if (VHYT34IW.RUN-WITH-NEW-DATE-FLAG == "Y")
        VHYT34IW-TRIGGERS.RUN-SCHED-ADJ = "Y";
    end
end 

Function VHYT34I-TIMESTAMPS ()
  
  

  
  

  

   
    if (AM-MAKE-FROM-IDX > 0)
        VHYT34F_CRIT.AMM-DATE-FROM = VHYT34D_DATA.DATE-ARRIVAL-WORK[AM-MAKE-FROM-IDX];
        VHYT34F_CRIT.AMM-DASH1 = "-";
        VHYT34F_CRIT.AMM-TIME-FROM = VHYT34IW.AM-MAKE-FROM-TIME;
        VHYT34F_CRIT.AMM-REST-FROM = ".000000";
        VHYT34F_CRIT.AMM-DATE-TO = VHYT34D_DATA.DATE-ARRIVAL-WORK[AM-MAKE-TO-IDX];
        VHYT34F_CRIT.AMM-DASH1 = "-";
        VHYT34F_CRIT.AMM-TIME-TO = VHYT34IW.AM-MAKE-TO-TIME;
        VHYT34F_CRIT.AMM-REST-TO = ".000000";
    end

  
    if (AM-BREAK-FROM-IDX > 0)
        VHYT34F_CRIT.AMB-DATE-FROM = VHYT34D_BA_DATA.DATE-ARRIVAL-WORK[AM-BREAK-FROM-IDX];
        VHYT34F_CRIT.AMB-DASH1 = "-";
        VHYT34F_CRIT.AMB-TIME-FROM = VHYT34IW.AM-BREAK-FROM-TIME;
        VHYT34F_CRIT.AMB-REST-FROM = ".000000";
        VHYT34F_CRIT.AMB-DATE-TO = VHYT34D_BA_DATA.DATE-ARRIVAL-WORK[AM-BREAK-TO-IDX];
        VHYT34F_CRIT.AMB-DASH1 = "-";
        VHYT34F_CRIT.AMB-TIME-TO = VHYT34IW.AM-BREAK-TO-TIME;
        VHYT34F_CRIT.AMB-REST-TO = ".000000";
    end


  
    if (PM-MAKE-FROM-IDX > 0)
        VHYT34F_CRIT.PMM-DATE-FROM = VHYT34D_MP_DATA.DATE-ARRIVAL-WORK[PM-MAKE-FROM-IDX];
        VHYT34F_CRIT.PMM-DASH1 = "-";
        VHYT34F_CRIT.PMM-TIME-FROM = VHYT34IW.PM-MAKE-FROM-TIME;
        VHYT34F_CRIT.PMM-REST-FROM = ".000000";
        VHYT34F_CRIT.PMM-DATE-TO = VHYT34D_MP_DATA.DATE-ARRIVAL-WORK[PM-MAKE-TO-IDX];
        VHYT34F_CRIT.PMM-DASH1 = "-";
        VHYT34F_CRIT.PMM-TIME-TO = VHYT34IW.PM-MAKE-TO-TIME;
        VHYT34F_CRIT.PMM-REST-TO = ".000000";
    end

  
    if (PM-BREAK-FROM-IDX > 0)
        VHYT34F_CRIT.PMB-DATE-FROM = VHYT34D_BP_DATA.DATE-ARRIVAL-WORK[PM-BREAK-FROM-IDX];
        VHYT34F_CRIT.PMB-DASH1 = "-";
        VHYT34F_CRIT.PMB-TIME-FROM = VHYT34IW.PM-BREAK-FROM-TIME;
        VHYT34F_CRIT.PMB-REST-FROM = ".000000";
        VHYT34F_CRIT.PMB-DATE-TO = VHYT34D_BP_DATA.DATE-ARRIVAL-WORK[PM-BREAK-TO-IDX];
        VHYT34F_CRIT.PMB-DASH1 = "-";
        VHYT34F_CRIT.PMB-TIME-TO = VHYT34IW.PM-BREAK-TO-TIME;
        VHYT34F_CRIT.PMB-REST-TO = ".000000";
    end
end 

Function VHYT34I-TRAIN-DROP ()
   
    VHYT34H_CRIT.SCHED-CD = VHYT34IW.SCHED-CD;
    VHYT34H_CRIT.ARRIVAL-YRD = VHYT34I-PASSVALUE.YRD-TRK-YRD;


  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34H";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";
    set VHYT34H_DATA empty;


    
    try
        call "VHYT34H"(XDCONTROL, VHYT34H_CRIT, VHYT34H_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT34IW-PROCESS.CON-CNT = XDCONTROL.UROWCNT;
        else

  
            XDCONTROL.UROWCNT = 0;
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end

  
    VHYT34IW-TRIGGERS.LOAD-CONS = "Y";
    VHYT34I-MESSAGE.MESSAGE = "Enter Make / Break OR Enter Single Car Override Request";

  
    if (VHYT34IW.RUN-WITH-NEW-DATE-FLAG == "Y")
        VHYT34IW-TRIGGERS.RUN-LISTSINGLE = "Y";
    end
end 

Function VHYT34I-TRAIN-SEL ()
  
  
  

   
    VHYT34IW.SCHEDULED-FOR = " ";

  
    VHYT34IW.ST-MAKE-CANCEL = "0";
    VHYT34IW.ST-BREAK-CANCEL = "0";
    VHYT34IW.ST-MAKE-SCHED = "0";
    VHYT34IW.ST-BREAK-SCHED = "0";

  
    VHYT34J_CRIT.SCHED-CD = VHYT34IW.SCHED-CD;
    VHYT34J_CRIT.ARRIVAL-YRD = VHYT34I-PASSVALUE.YRD-TRK-YRD;
  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34J";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT34I";
    set VHYT34J_DATA empty;


    
    try
        call "VHYT34J"(XDCONTROL, VHYT34J_CRIT, VHYT34J_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT34IW-PROCESS.ARRIVAL-TIME-CNT = XDCONTROL.UROWCNT;
  
            VHYT34IW-TRIGGERS.LOAD-ARRIVAL-TIMES = "Y";
            VHYT34I-MESSAGE.MESSAGE = " ";
            VHYT34IW-TRIGGERS.DISABLE-SINGLE-TRAIN = "Y";
        else

  
            XDCONTROL.UROWCNT = 0;
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 
    end
end 

Function VHYT34I-VALID-TIME ()
   
    FLAG1 = "N";
    FLAG2 = "N";

  
    if (VHYT34IW.AM-MAKE-FROM-TIME != " ")
        if ((VHYT34D_DATA.DATE-ARRIVAL-WORK[AM-MAKE-FROM-IDX] == VHYT34D_DATA.DATE-ARRIVAL-WORK[AM-MAKE-TO-IDX]) && (VHYT34IW.AM-MAKE-FROM-TIME <= VHYT34IW.AM-MAKE-TO-TIME))

        else
            FLAG1 = "Y";
        end 
        if ((VHYT34D_DATA.DATE-ARRIVAL-WORK[AM-MAKE-FROM-IDX] < VHYT34D_DATA.DATE-ARRIVAL-WORK[AM-MAKE-TO-IDX]) && (VHYT34IW.AM-MAKE-FROM-TIME > VHYT34IW.AM-MAKE-TO-TIME))

        else
            FLAG2 = "Y";
        end 
    end 
    if (FLAG1 == "Y" && FLAG2 == "Y")
        VHYT34I-MESSAGE.MESSAGE = "FROM TIME Cannot Be Less Than TO TIME";
    end

  
  
    FLAG1 = "N";
    FLAG2 = "N";

  
    if (VHYT34IW.AM-BREAK-FROM-TIME != " ")
        if ((VHYT34D_BA_DATA.DATE-ARRIVAL-WORK[AM-BREAK-FROM-IDX] == VHYT34D_BA_DATA.DATE-ARRIVAL-WORK[AM-BREAK-TO-IDX]) && (VHYT34IW.AM-BREAK-FROM-TIME <= VHYT34IW.AM-BREAK-TO-TIME))

        else
            FLAG1 = "Y";
        end 
        if ((VHYT34D_BA_DATA.DATE-ARRIVAL-WORK[AM-BREAK-FROM-IDX] < VHYT34D_BA_DATA.DATE-ARRIVAL-WORK[AM-BREAK-TO-IDX]) && (VHYT34IW.AM-BREAK-FROM-TIME > VHYT34IW.AM-BREAK-TO-TIME))

        else
            FLAG2 = "Y";
        end 
    end 
    if (FLAG1 == "Y" && FLAG2 == "Y")
        VHYT34I-MESSAGE.MESSAGE = "FROM TIME Cannot Be Less Than TO TIME";
    end


  
    FLAG1 = "N";
    FLAG2 = "N";

  
    if (VHYT34IW.PM-MAKE-FROM-TIME != " ")
        if ((VHYT34D_MP_DATA.DATE-ARRIVAL-WORK[PM-MAKE-FROM-IDX] == VHYT34D_MP_DATA.DATE-ARRIVAL-WORK[PM-MAKE-TO-IDX]) && (VHYT34IW.PM-MAKE-FROM-TIME <= VHYT34IW.PM-MAKE-TO-TIME))

        else
            FLAG1 = "Y";
        end 
        if ((VHYT34D_MP_DATA.DATE-ARRIVAL-WORK[PM-MAKE-FROM-IDX] < VHYT34D_MP_DATA.DATE-ARRIVAL-WORK[PM-MAKE-TO-IDX]) && (VHYT34IW.PM-MAKE-FROM-TIME > VHYT34IW.PM-MAKE-TO-TIME))

        else
            FLAG2 = "Y";
        end 
    end 
    if (FLAG1 == "Y" && FLAG2 == "Y")
        VHYT34I-MESSAGE.MESSAGE = "FROM TIME Cannot Be Less Than TO TIME";
    end


  
  
    FLAG1 = "N";
    FLAG2 = "N";

  
    if (VHYT34IW.PM-BREAK-FROM-TIME != " ")
        if ((VHYT34D_BP_DATA.DATE-ARRIVAL-WORK[PM-BREAK-FROM-IDX] == VHYT34D_BP_DATA.DATE-ARRIVAL-WORK[PM-BREAK-TO-IDX]) && (VHYT34IW.PM-BREAK-FROM-TIME <= VHYT34IW.PM-BREAK-TO-TIME))
            FLAG1 = "N";
        else
            FLAG1 = "Y";
        end 
        if ((VHYT34D_BP_DATA.DATE-ARRIVAL-WORK[PM-BREAK-FROM-IDX] < VHYT34D_BP_DATA.DATE-ARRIVAL-WORK[PM-BREAK-TO-IDX]) && (VHYT34IW.PM-BREAK-FROM-TIME > VHYT34IW.PM-BREAK-TO-TIME))

        else
            FLAG2 = "Y";
        end 
    end 
    if (FLAG1 == "Y" && FLAG2 == "Y")
        VHYT34I-MESSAGE.MESSAGE = "FROM TIME Cannot Be Less Than TO TIME";
    end
end
