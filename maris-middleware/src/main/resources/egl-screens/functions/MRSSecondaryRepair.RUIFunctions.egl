

package MRSSecondaryRepair;


Function VHMSRIS-EXIT () 
    if (VHMSRIW-PASS.EXIT-IND != " ")
        VHMSRIW-PASS.EXIT-SHOP = "Y";
    end
end 

Function VHMSRIS-INIT () 
    VHSR01_DATA.PARENT-GUI = "VHMSRI";
end 

Function VHSR01IS-CAR-VAL () 
    VHSR01IW.FINAL-MESSAGE = " ";
    VHSR01IW.CAR-NO = VHSR01IW.CAR-NO-NUM;
    if (VHSR01IW.CAR-NO != "0000")
  
  
        VHSR01IW.DEPT-CD = " ";
        VHSR01IW.EQUIP-TYPE = " ";
        VHSR01IW.EQUIP-TYPE-CLR = " ";
        VHSR01IW.EQUIP-ID = " ";
        VHSR01IW.EQUIP-LOC = " ";
        DISABLE-WAYSIDE = "Y";
    else
        ENABLE-WAYSIDE = "Y";
  
        DEPTCD-SETFOCUS = "Y";
        VHSR01IW.CAR-NO = " ";
        
  
    end
end 

Function VHSR01IS-CLEAR () 
    set VHSR01IW empty;
    VHSR01IW.DATE-IN = VGVar.currentFormattedGregorianDate;
    VHSR01IW.CNT-CMPNTS-IN = 1;
    VHSR01IW.NARR-NO = 1;
    VHSR01IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHSR01IW.TIME-NARR = VGVar.currentFormattedTime;
    VHSR01IW.WORK-TYPE = "REPAIR";
    VHSR01IW.USER-GRP = VHSR01IW-PASSVALUE.USER-GRP;
    ENABLE-CREATE = "Y";
    DISABLE-JOBSPLIT = "Y";
    DISABLE-WAYSIDE = "Y";
    DISABLE-PCTNO = "Y";
    WORKTYPE-SETFOCUS = "Y";
end 

Function VHSR01IS-CLR-AFTDB () 
    VHSR01IW-TRIGGER.TEMP-FINAL-MESSAGE = VHSR01IW.FINAL-MESSAGE;
    VHSR01IW-TEMP.CAR-NO = VHSR01IW.CAR-NO;
    VHSR01IW-TEMP.JOB-PRT-CTL-NO = VHSR01IW.JOB-PRT-CTL-NO;
    VHSR01IW-TEMP.DEPT-CD = VHSR01IW.DEPT-CD;
    VHSR01IW-TEMP.EQUIP-TYPE = VHSR01IW.EQUIP-TYPE;
    VHSR01IW-TEMP.EQUIP-ID = VHSR01IW.EQUIP-ID;
    VHSR01IW-TEMP.EQUIP-LOC = VHSR01IW.EQUIP-LOC;
    VHSR01IW-TEMP.SENT-FROM = VHSR01IW.SENT-FROM;
    VHSR01IW-TEMP.INCD-NO = VHSR01IW.INCD-NO;
    VHSR01IW-TEMP.JOB-STAT = "OPN";
    set VHSR01IW empty;
    VHSR01IW.WORK-TYPE = "REPAIR";
    VHSR01IW.FINAL-MESSAGE = VHSR01IW-TRIGGER.TEMP-FINAL-MESSAGE;
    VHSR01IW.DATE-IN = VGVar.currentFormattedGregorianDate;
    VHSR01IW.CNT-CMPNTS-IN = 1;
    VHSR01IW.NARR-NO = 1;
    VHSR01IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHSR01IW.TIME-NARR = VGVar.currentFormattedTime;
    VHSR01IW.USER-GRP = VHSR01IW-PASSVALUE.USER-GRP;
    ENABLE-CREATE = "Y";
    DISABLE-JOBSPLIT = "Y";
    DISABLE-WAYSIDE = "Y";
    DISABLE-PCTNO = "Y";
  
    SENTFROM-SETFOCUS = "Y";
end 

Function VHSR01IS-CREATE () 
    VHSR01IW.FINAL-MESSAGE = " ";
    VHSR01IW.ERROR-MESSAGE = " ";
    VHSR01IW.SYSTEM-DATE = VGVar.currentFormattedGregorianDate;
    INVALID-CAR-NO = "N";
    INVALID-WORK-TYPE = "N";
    INVALID-REPR-AREA = "N";
    INVALID-EQUIP-TYPE = "N";
    INVALID-EQUIP-ID = "N";
    INVALID-STOCK-NO = "N";
    INVALID-BATCH-QTY = "N";
    INVALID-DATE-IN = "N";
    INVALID-FUTURE-DATE = "N";
    INVALID-OLD-DATE = "N";
    INVALID-NARR = "N";
    VHSR01IW.ERROR-COUNT = 0;
    VHSR01IW.TEMP-SUM = 0;
    set VHINC6A_CRIT empty;
    set VHSR01A_CRIT empty;
    set VHSR01C_CRIT empty;
    set VHSR01D_CRIT empty;
    VHSR01IW.CAR-NO = VHSR01IW.CAR-NO-NUM;
    if (VHSR01IW.WORK-TYPE == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Invalid Work Type.";
        INVALID-WORK-TYPE = "Y";
    else
        if (VHSR01IW.WORK-TYPE in VHSRWT_DATA.WORK-TYPE)

        else
            ERROR-COUNT = ERROR-COUNT + 1;
            VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Invalid Work Type.";
            INVALID-WORK-TYPE = "Y";
        end
    end
    if (VHSR01IW.DATE-IN == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Invalid Date.";
        INVALID-DATE-IN = "Y";
    else
        if (VHSR01IW.DATE-IN != " ")
            AFCXVLD_CRIT.FORM-DATE = VHSR01IW.DATE-IN;
            MRSCommonCode.AFCXVLD-VALIDATE();
            if (AFCXVLDW.INCORRECT-DATE == "Y")
                ERROR-COUNT = ERROR-COUNT + 1;
                VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Invalid Date.";
                VHSR01IW.INVALID-DATE-IN = "Y";
            else
                if (AFCXVLDW.SQL-ERROR == "Y")
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                else
                    if (AFCXVLDW.NO-ERROR == "Y")
                        XDATECON-W2.WS-GREG-IN-FLAG = "R";
                        XDATECON-W2.WS-RPT-GREG-IN = VGVar.currentFormattedGregorianDate;
                        MRSCommonCode.XDATECON-LOAD-TBL();
                        MRSCommonCode.XDATECON-GREG2JUL();
                        JULIAN-DATE-1 = XDATECON-W1.WS-DATES-CYDDD;
                        XDATECON-W2.WS-GREG-IN-FLAG = "R";
                        XDATECON-W2.WS-RPT-GREG-IN = VHSR01IW.DATE-IN;
                        MRSCommonCode.XDATECON-LOAD-TBL();
                        MRSCommonCode.XDATECON-GREG2JUL();
                        JULIAN-DATE-2 = XDATECON-W1.WS-DATES-CYDDD;
                        VHSR01IS-DATE-CHK();
                    end
                end
            end
        end
    end
    if (VHSR01IW.REPR-AREA == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Invalid Repr Area.";
        INVALID-REPR-AREA = "Y";
    else
        if (VHSR01IW.REPR-AREA in VHSRRA_DATA.REPR-AREA)

        else
            ERROR-COUNT = ERROR-COUNT + 1;
            VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Invalid Repr Area.";
            INVALID-REPR-AREA = "Y";
        end
    end
    if (VHSR01IW.CAR-NO == "0000")
        VHSR01IW.CAR-NO = " ";
    else
        if (VHSR01IW.CAR-NO not numeric)
            ERROR-COUNT = ERROR-COUNT + 1;
            VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Invalid car no.";
            INVALID-CAR-NO = "Y";
             
        else
            if (VHSR01IW.CAR-NO != " " && VHSR01IW.CAR-NO != "0088")
        
                VHINC6A_CRIT.CAR-NO = VHSR01IW.CAR-NO;
                try
                    call "MRSVehicleIncident.VHINC6A"(XDCONTROL, VHINC6A_CRIT, VHINC6A_DATA);
                
                end
                if (XDCONTROL.UROWCNT == 1)
                    if (VHINC6A_DATA.CAR-TYPE-OCCR[1] == "A" ||
                       VHINC6A_DATA.CAR-TYPE-OCCR[1] == "B" ||
                       VHINC6A_DATA.CAR-TYPE-OCCR[1] == "C" || 
                       VHINC6A_DATA.CAR-TYPE-OCCR[1] == "D" ||
                       VHINC6A_DATA.CAR-TYPE-OCCR[1] == "E" || 
                       VHINC6A_DATA.CAR-TYPE-OCCR[1] == "L" ||
                       VHINC6A_DATA.CAR-TYPE-OCCR[1] == "M" || 
                       VHINC6A_DATA.CAR-TYPE-OCCR[1] == "K"
                       )

                    else
                        ERROR-COUNT = ERROR-COUNT + 1;
                        VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Invalid Car type.";
                        INVALID-CAR-NO = "Y";
                    end
                else
                    if (XDCONTROL.URC == 100)
                        ERROR-COUNT = ERROR-COUNT + 1;
                        VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Car no does not exist.";
                        INVALID-CAR-NO = "Y";
                         
                    else
                        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                        return;
                    end
                end
            end
        end
    end
    if (VHSR01IW.DEPT-CD != " ")
        if (VHSR01IW.DEPT-CD == "A" || VHSR01IW.DEPT-CD == "D")
            if (VHSR01IW.EQUIP-ID == " ")
                ERROR-COUNT = ERROR-COUNT + 1;
                VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Equip Id required.";
                INVALID-EQUIP-ID = "Y";
            else
                VHSR01C_CRIT.DEPT-CD = VHSR01IW.DEPT-CD;
                VHSR01C_CRIT.EQUIP-ID = VHSR01IW.EQUIP-ID;
                try
                    call "VHSR01C"(XDCONTROL, VHSR01C_CRIT, VHSR01C_DATA);
                
                end
                if (XDCONTROL.UROWCNT == 1)

                else
                    ERROR-COUNT = ERROR-COUNT + 1;
                    VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Equip ID does not exist.";
                    INVALID-EQUIP-ID = "Y";
                end
            end
        else
            if (VHSR01IW.EQUIP-TYPE == " ")
                ERROR-COUNT = ERROR-COUNT + 1;
                VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Equip Type required.";
                INVALID-EQUIP-TYPE = "Y";
            else
        
                if (VHSR01IW.EQUIP-TYPE in VHSR01B_DATA.EQUIP-TYPE)

                else
                    ERROR-COUNT = ERROR-COUNT + 1;
                    VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Equipment does not exist.";
                    INVALID-EQUIP-TYPE = "Y";
                end
            end
        end
    else
        if (VHSR01IW.CAR-NO == " " && VHSR01IW.DEPT-CD == " ")
            ERROR-COUNT = ERROR-COUNT + 1;
            VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Vehicle/Wayside data required.";
            INVALID-CAR-NO = "Y";
        end
    end
    if (VHSR01IW.STOCK-NO == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Stock No required.";
        INVALID-STOCK-NO = "Y";
    else
     
        VHSRVS_DATA.STOCK-NO = VHSR01IW.STOCK-NO;
        try
            call "VHSRVS"(XDCONTROL, VHSRVS_DATA);
        
        end
        if (VHSRVS_DATA.RECORD-FOUND == "Y")

        else
            if (VHSRVS_DATA.RECORD-FOUND == "N")
                VHSR01IW.STOCKNO-COUNT = 0;
                ERROR-COUNT = ERROR-COUNT + 1;
                VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Invalid Stock No.";
                INVALID-STOCK-NO = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        end
    end
    if (INVALID-STOCK-NO == "N")
        if (VHSR01IW.CNT-CMPNTS-IN < 1)
            ERROR-COUNT = ERROR-COUNT + 1;
            VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Batch qty must be > 0.";
            INVALID-BATCH-QTY = "Y";
        else
            if (VHSR01IW.STOCK-NO != " ")
    
                VHSR01D_CRIT.STOCK-NO = VHSR01IW.STOCK-NO;
                try
                    call "VHSR01D"(XDCONTROL, VHSR01D_CRIT);
                
                end
                if (VHSR01D_CRIT.ROW-COUNT >= 1)
                    VHSR01A_CRIT.RET-IND = "BOTH";
                else
                    VHSR01A_CRIT.RET-IND = " ";
                end
    
                VHSR01A_CRIT.STOCK-NO = VHSR01IW.STOCK-NO;
                try
                    call "VHSR01A"(XDCONTROL, VHSR01A_CRIT, VHSR01A_DATA);
                
                end
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    if (VHSR01A_DATA.CNT-THRESHOLD > 0)
                        VHSR01IW.TEMP-SUM = VHSR01A_DATA.SUM-CNT-CMPNTS-IN + VHSR01IW.CNT-CMPNTS-IN;
                        if (VHSR01IW.TEMP-SUM > VHSR01A_DATA.CNT-THRESHOLD)
            
            
                            INVALID-BATCH-QTY = "Y";
                        end
                    else
                        INVALID-BATCH-QTY = "N";
                    end
                end
            end
        end
    end

  
  
  
  
  
    if (ERROR-COUNT > 0)
    
        VHSR01IS-MOVE-MSG();
    else
    
        VHSR01IS-DB-STORE();
    end
end 

Function VHSR01IS-DATE-CHK () 
    if (JULIAN-DATE-1-CCYY == JULIAN-DATE-2-CCYY)
        if (JULIAN-DATE-2-DDD > JULIAN-DATE-1-DDD)
            ERROR-COUNT = ERROR-COUNT + 1;
            VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Future Date not allowed.";
            INVALID-FUTURE-DATE = "Y";
        else
            JULIAN-DAYS-DIFF = JULIAN-DATE-1 - JULIAN-DATE-2;
            if (JULIAN-DAYS-DIFF > 548) 
                ERROR-COUNT = ERROR-COUNT + 1;
                VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Date too old (548 days).";
                INVALID-OLD-DATE = "Y";
            end
        end
    else
        if (JULIAN-DATE-1-CCYY > JULIAN-DATE-2-CCYY)
            JULIAN-DATE-YR-DIFF = JULIAN-DATE-1-CCYY - JULIAN-DATE-2-CCYY;
        else
            JULIAN-DATE-YR-DIFF = JULIAN-DATE-2-CCYY - JULIAN-DATE-1-CCYY;
        end
        if (JULIAN-DATE-YR-DIFF > 1)
            ERROR-COUNT = ERROR-COUNT + 1;
            VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Date too old (548 days).";
            INVALID-OLD-DATE = "Y";
        else
      
            if (JULIAN-DATE-1-CCYY > JULIAN-DATE-2-CCYY)
                JULIAN-DATE-QUOT = JULIAN-DATE-2-CCYY / 4;
                JULIAN-DATE-REM = JULIAN-DATE-2-CCYY - (JULIAN-DATE-QUOT * 4);
                if (JULIAN-DATE-REM > 0)
                    JULIAN-DATE-1-DDD = JULIAN-DATE-1-DDD + 365;
                else
                    JULIAN-DATE-1-DDD = JULIAN-DATE-1-DDD + 366;
                end
                JULIAN-DAYS-DIFF = JULIAN-DATE-1-DDD - JULIAN-DATE-2-DDD;
                if (JULIAN-DAYS-DIFF > 548) 
                    ERROR-COUNT = ERROR-COUNT + 1;
                    VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Date too old (548 days).";
                    INVALID-OLD-DATE = "Y";
                end
            else
                ERROR-COUNT = ERROR-COUNT + 1;
                VHSR01IW.ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Future Date not allowed.";
                INVALID-FUTURE-DATE = "Y";
            end
        end
    end
end 

Function VHSR01IS-DB-STORE () 
    VHSR01IW.FINAL-MESSAGE = " ";
    VHSR01E_DATA.CAR-NO = VHSR01IW.CAR-NO;
    VHSR01E_DATA.DEPT-CD = VHSR01IW.DEPT-CD;
    VHSR01E_DATA.EQUIP-TYPE = VHSR01IW.EQUIP-TYPE;
    VHSR01E_DATA.EQUIP-ID = VHSR01IW.EQUIP-ID;
    VHSR01E_DATA.EQUIP-LOC = VHSR01IW.EQUIP-LOC;
    VHSR01E_DATA.INCD-NO = VHSR01IW.INCD-NO;
    VHSR01E_DATA.JOB-PRT-CTL-NO = VHSR01IW.JOB-PRT-CTL-NO;
    VHSR01E_DATA.WORK-TYPE = VHSR01IW.WORK-TYPE;
    VHSR01E_DATA.DATE-IN = VHSR01IW.DATE-IN;
    VHSR01E_DATA.REPR-AREA = VHSR01IW.REPR-AREA;
    VHSR01E_DATA.CNT-CMPNTS-IN = VHSR01IW.CNT-CMPNTS-IN;
    VHSR01E_DATA.STOCK-NO = VHSR01IW.STOCK-NO;
    VHSR01E_DATA.SER-NO = VHSR01IW.SER-NO;
    VHSR01E_DATA.SENT-FROM = VHSR01IW.SENT-FROM;
    VHSR01E_DATA.USER-GRP = VHSR01IW-PASSVALUE.USER-GRP;
    VHSR01E_DATA.TERM-LAST-UPD = VHSR01IW-PASSVALUE.TERM-LAST-UPD;
    VHSR01E_DATA.NARR = VHSR01IW.NARR;
    try
        call "VHSR01E"(XDCONTROL, VHSR01E_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHSR01IW.FINAL-MESSAGE-1 = "Job No ";
        VHSR01IW.FINAL-MESSAGE-2 = VHSR01E_DATA.JOB-NO;
        VHSR01IW.FINAL-MESSAGE-3 = " has been created.";
        if (INVALID-BATCH-QTY == "Y")
            VHSR01IW.FINAL-MESSAGE-4 = "          Warning :- Stock no. exceeds limit.";
        else
            VHSR01IW.FINAL-MESSAGE-4 = " ";
        end
        VHSR01IS-MOVE-JOBS();
        if (JOB-DATA-COUNT > 30)
            VHSR01IW.FINAL-MESSAGE-4 = "Reached the no. of max job rows allowed.";
            DISABLE-JOBSPLIT = "Y";
        else
            ENABLE-JOBSPLIT = "Y";
        end
        DISABLE-CREATE = "Y";
        VHSR01IS-CLR-AFTDB(); 
                                   
  
    else
        VHSR01IW.FINAL-MESSAGE = "Database error. No job created.";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        VHSR01IW.PRN-STK-SUM = 0;
         
    end
end 

Function VHSR01IS-DEPT-VAL () 
    VHSR01IW.EQUIP-TYPE = " ";
    VHSR01IW.EQUIP-ID = " ";
    VHSR01IW.EQUIP-LOC = " ";
    VHSR01IW.EQUIPTYPE-COUNT = 0;
    if (VHSR01IW.DEPT-CD != " ")
        VHSR01IW.FINAL-MESSAGE = " ";
        if (VHSR01IW.DEPT-CD == "A" || VHSR01IW.DEPT-CD == "D")
            DISABLE-EQPTYPE = "Y";
            ENABLE-EQPID = "Y";
        else
            ENABLE-EQPTYPE = "Y";
            DISABLE-EQPID = "Y";
            VHSR01B_CRIT.DEPT-CD = VHSR01IW.DEPT-CD;
            try
                call "VHSR01B"(XDCONTROL, VHSR01B_CRIT, VHSR01B_DATA);
            
            end
            if (XDCONTROL.UROWCNT > 0)
                VHSR01IW.EQUIPTYPE-COUNT = XDCONTROL.UROWCNT;
                LOAD-EQUIP-TYPE = "Y";
            else
                if (XDCONTROL.URC == 100)
                    set VHSR01B_DATA empty;
                    LOAD-EQUIP-TYPE = "Y";
                end
            end
        end
    end
    DISABLE-LOC = "Y";
end 

Function VHSR01IS-EQUIP-ID () 
    VHSR01IW.FINAL-MESSAGE = " ";
    if (VHSR01IW.DEPT-CD == "A" || VHSR01IW.DEPT-CD == "D")
        VHSR01IW.EQUIP-TYPE = " ";
        VHSR01IW.EQUIP-LOC = " ";
        if (VHSR01IW.EQUIP-ID != " ")
            VHSR01C_CRIT.DEPT-CD = VHSR01IW.DEPT-CD;
            VHSR01C_CRIT.EQUIP-ID = VHSR01IW.EQUIP-ID;
            try
                call "VHSR01C"(XDCONTROL, VHSR01C_CRIT, VHSR01C_DATA);
            
            end
            if (XDCONTROL.UROWCNT == 1)
                VHSR01IW.EQUIP-TYPE = VHSR01C_DATA.EQUIP-TYPE;
                VHSR01IW.EQUIP-LOC = VHSR01C_DATA.EQUIP-LOC;
            end
        end
    end
end 

Function VHSR01IS-INIT () 
    set VHSR01IW empty;
    set VHSR01IW-JOB empty;
    VHSR01IW-TRIGGER.JOB-DATA-COUNT = 0;
    VHSR01IW.DATE-IN = VGVar.currentFormattedGregorianDate;
    VHSR01IW.NARR-NO = 1;
    VHSR01IW.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHSR01IW.TIME-NARR = VGVar.currentFormattedTime;
    VHSR01IW.USER-GRP = VHSR01IW-PASSVALUE.USER-GRP;

  
    try
        call "VHSRWT"(XDCONTROL, VHSRWT_DATA);
    
    end
    if (XDCONTROL.UROWCNT > 0)
        VHSR01IW.WORKTYPE-COUNT = XDCONTROL.UROWCNT;
    else
        VHSR01IW.WORKTYPE-COUNT = 0;
    end
    LOAD-WORKTYPE = "Y";
    VHSR01IW.WORK-TYPE = "REPAIR";

  
    try
        call "VHSRRA"(XDCONTROL, VHSRRA_DATA);
    
    end
    if (XDCONTROL.UROWCNT > 0)
        VHSR01IW.REPRAREA-COUNT = XDCONTROL.UROWCNT;
    else
        VHSR01IW.REPRAREA-COUNT = 0;
    end
    LOAD-REPRAREA = "Y";

  
    VHSRUD_CRIT.USER-GRP = VHSR01IW-PASSVALUE.USER-GRP;
    try
        call "VHSRUD"(XDCONTROL, VHSRUD_CRIT, VHSRUD_DATA);
    
    end
    if (XDCONTROL.UROWCNT > 0)
        VHSR01IW.DEPTCD-COUNT = XDCONTROL.UROWCNT;
    else
        VHSR01IW.DEPTCD-COUNT = 0;
    end
    LOAD-DEPTCD = "Y";
    VHSR01IW.CNT-CMPNTS-IN = 1;
    DISABLE-WAYSIDE = "Y";
    DISABLE-PCTNO = "Y";
    ENABLE-CREATE = "Y";
    DISABLE-JOBSPLIT = "Y";
end 

Function VHSR01IS-MOVE-JOBS ()
   
    JOB-DATA-COUNT = JOB-DATA-COUNT + 1;
    VHSR01IW-JOB.JOB-NO[JOB-DATA-COUNT] = VHSR01E_DATA.JOB-NO;
    VHSR01IW-JOB.SUB-JOB-DOC-NO[JOB-DATA-COUNT] = 0;
    VHSR01IW-STOCK.SER-NO[JOB-DATA-COUNT] = VHSR01E_DATA.SER-NO;
    VHSR01IW-STOCK.STOCK-NO[JOB-DATA-COUNT] = VHSR01E_DATA.STOCK-NO;
    VHSR01IW-STOCK.PRN-STK-SUM[JOB-DATA-COUNT] = VHSR01IW.PRN-STK-SUM;
end 

Function VHSR01IS-MOVE-MSG () 
    VHSR01IW.ERROR-LOOP-INDEX = 1;
    VHSR01IW.FINAL-INDEX = 0;
    VHSR01IW.FINAL-ERROR-MSG = " ";
    VHSR01IW.TEMP-ERROR-MSG = " ";
    if (ERROR-COUNT > 0)
        while (((ERROR-LOOP-INDEX <= 8) &&
         (ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX] != " ")))
            ERROR-COUNT = 1;
            TEMP-ERROR-MSG = ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX];
            while ((ERROR-COUNT <= 30))
                if (TEMP-MSG[ERROR-COUNT] != ".")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = TEMP-MSG[ERROR-COUNT];
                else
                    if (TEMP-MSG[ERROR-COUNT] == ".")
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = ",";
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = " ";
                        ERROR-COUNT = 30;
                    end
                end
                ERROR-COUNT = ERROR-COUNT + 1;
            end
            ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
        end
        FINAL-INDEX = FINAL-INDEX - 1;
        FINAL-MSG[FINAL-INDEX] = " ";
        VHSR01IW.FINAL-MESSAGE = FINAL-ERROR-MSG;
        EXECUTE-SETFOCUS = "Y";
    end
end 

Function VHSR01IS-PASS-VAL () 
    VHSR01IW.PASSVALUE-JOB-NO = VHSR01IW-JOB.JOB-NO[JOB-DATA-COUNT];
    VHSR01IW.PARENT-GUI = "VHSR01I";
end 

Function VHSR01IS-RETURN () 
    if (VHSR01IW-JOB.JOB-NO[1] == " " &&
     VHSR01IW-JOB.SUB-JOB-DOC-NO[1] == 0)
        VHSR01IW-TRIGGER.CLOSE-GUI = "Y";
    else
        VHSR01IW-TRIGGER.OPEN-GUI = "Y";
    end
end 

Function VHSR01IS-SETFOCUS () 
    if (INVALID-WORK-TYPE == "Y")
        WORKTYPE-SETFOCUS = "Y";
    else
        if (INVALID-DATE-IN == "Y")
            DATEIN-SETFOCUS = "Y";
        else
            if (INVALID-REPR-AREA == "Y")
                REPRAREA-SETFOCUS = "Y";
            else
                if (INVALID-CAR-NO == "Y")
                    CARNO-SETFOCUS = "Y";
                else
                    if (INVALID-EQUIP-TYPE == "Y")
                        EQUIPTYPE-SETFOCUS = "Y";
                    else
                        if (INVALID-EQUIP-ID == "Y")
                            EQUIPID-SETFOCUS = "Y";
                        else
                            if (INVALID-STOCK-NO == "Y")
                                STOCKNO-SETFOCUS = "Y";
                            else
                                if (INVALID-BATCH-QTY == "Y")
                                    BATCHQTY-SETFOCUS = "Y";
                                else
                                    if (INVALID-NARR == "Y")
                                        NARR-SETFOCUS = "Y";
                                    else

                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

Function VHSR02IS-ADDNARR ()
  
  
  
  
  
  
  
  

  
   
    if (VHSR02IW.CURRENT-NARR != " ")
        VHSR02IW.FINAL-MESSAGE = " ";

  
  
  
  
  
  
        if (VHSR02IW-PASSVALUE.PARENT-GUI == "VHMSRI")
            VHSR02A_DATA.JOB-NO = VHSR02IW.JOB-NO;
            VHSR02A_DATA.SUB-JOB-DOC-NO = VHSR02IW.SUB-JOB-DOC-NO;
            VHSR02IW-PASSVALUE.JOB-NO = VHSR02IW.JOB-NO;
            VHSR02IW-PASSVALUE.SUB-JOB-DOC-NO = VHSR02IW.SUB-JOB-DOC-NO;
        else
            VHSR02A_DATA.JOB-NO = VHSR02IW-PASSVALUE.JOB-NO;
            VHSR02A_DATA.SUB-JOB-DOC-NO = VHSR02IW-PASSVALUE.SUB-JOB-DOC-NO;
        end
        VHSR02A_DATA.NARR-NO = VHSR02IW-PASSVALUE.MAX-ROWS + 1;
        VHSR02A_DATA.NARR = VHSR02IW.CURRENT-NARR;
        VHSR02A_DATA.USER-GRP = VHSR02IW-PASSVALUE.STORE-USER-GRP;
        VHSR02A_DATA.TERM-NARR = VHSR02IW-PASSVALUE.TERM-LAST-UPD;
        if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "JOB")
            VHSR02A_DATA.JOB-INDICATOR = "JOB";
        else
            if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "REPAIR")
                VHSR02A_DATA.JOB-INDICATOR = "REPAIR";
            end
        end
        XXEXT_CALL_Level77Items.UEXTNAM = "VHSR02I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHSR02A";
        try
            call "VHSR02A"(XDCONTROL, VHSR02A_DATA);
        
        end
        MRSCommonCode.XXA0IS-CHECK_EXT();
        if (XXEXT_CALL_Level77Items.URC == 0)
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                ENABLE-UPDATE = "Y";
                VHSR02IW-PASSVALUE.REFRESH-GUI = "Y";
                VHSR02IW.CURRENT-NARR = " ";
                VHSR02IS-JOB-NARR(); 
                                   
                ADDNARR-SETFOCUS = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    else
        VHSR02IW.FINAL-MESSAGE = "Invalid comment.";
        VHSR02IW-TRIGGER.ADDNARR-SETFOCUS = "Y";
    end
end 

Function VHSR02IS-CLEAR () 
    VHSR02IW.FINAL-MESSAGE = " ";
    VHSR02IW.JOB-NO = " ";
    VHSR02IW.SUB-JOB-DOC-NO = 1;
    VHSR02IW.SEL-ACTION = 1;
    VHSR02IW.UPD-NARR = " ";
    VHSR02IW-PASSVALUE.NARR = " ";
    VHSR02IW-PASSVALUE.DATE-NARR = VGVar.currentFormattedGregorianDate;
    VHSR02IW-PASSVALUE.TIME-NARR = VGVar.currentFormattedTime;
    VHSR02IW-PASSVALUE.USER-GRP = VHSR02IW-PASSVALUE.STORE-USER-GRP;
    VHSR02IW-PASSVALUE.NARR-NO = 0;
    VHSR02IW-PASSVALUE.CURRENT-ROW = 1;
    VHSR02IW.CURRENT-NARR = " ";
    ENABLE-LIST = "Y";
    DISABLE-UPDNARR = "Y";
    DISABLE-ADDNARR = "Y";
    JOB-SETFOCUS = "Y";
    ENABLE-JOBCRIT = "Y";
end 

Function VHSR02IS-INIT () 
    VHSR02IW.FINAL-MESSAGE = " ";
    VHSR02IW-PASSVALUE.REFRESH-GUI = "N";
    if (VHSR02IW-PASSVALUE.PARENT-GUI == "VHMSRI")
        SEL-ACTION = 1;
        ENABLE-JOBCRIT = "Y";
        ENABLE-SELECTION = "Y";
        ENABLE-LIST = "Y";
        ENABLE-CLEAR = "Y";
        DISABLE-ADDNARR = "Y";
        DISABLE-UPDNARR = "Y";
        EXECUTE-CLEAR = "Y";
    else
        if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "JOB")
            SEL-ACTION = 1;
        else
            SEL-ACTION = 2;
        end
        DISABLE-JOBCRIT = "Y";
        DISABLE-SELECTION = "Y";
        DISABLE-LIST = "Y";
        DISABLE-CLEAR = "Y";
        ENABLE-ADDNARR = "Y";
        if (VHSR02IW-PASSVALUE.CURRENT-ROW > 0)
            ENABLE-UPDNARR = "Y";
            TIME-NARR-FILLER-1 = ":";
            TIME-NARR-FILLER-2 = ":";
            ENABLE-UPDATE = "Y";
            if (VHSR02IW-PASSVALUE.CURRENT-ROW == 1)
                DISABLE-PRV = "Y";
            else
                ENABLE-PRV = "Y";
            end
            if (VHSR02IW-PASSVALUE.CURRENT-ROW < VHSR02IW-PASSVALUE.MAX-ROWS)
                ENABLE-NXT = "Y";
            else
                DISABLE-NXT = "Y";
            end
        else
            TIME-NARR-FILLER-1 = " ";
            TIME-NARR-FILLER-2 = " ";
            DISABLE-UPDNARR = "Y";
        end
        ADDNARR-SETFOCUS = "Y";
    end
end 

Function VHSR02IS-JOB-NARR () 
    set VHSR02D_CRIT empty;
    VHSR02D_CRIT.JOB-NO = VHSR02IW-PASSVALUE.JOB-NO;
    VHSR02D_CRIT.SUB-JOB-DOC-NO = VHSR02IW-PASSVALUE.SUB-JOB-DOC-NO;
    VHSR02D_CRIT.NARR-NO = 0;
    if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "JOB")
        VHSR02D_CRIT.JOB-INDICATOR = "JOB";
    else
        if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "REPAIR")
            VHSR02D_CRIT.JOB-INDICATOR = "REPAIR";
        end
    end
    XXEXT_CALL_Level77Items.UEXTNAM = "VHSR02I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHSR02D";
    try
        call "VHSR02D"(XDCONTROL, VHSR02D_CRIT, VHSR02D_DATA);
    
    end
    MRSCommonCode.XXA0IS-CHECK_EXT();
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            ENABLE-UPDNARR = "Y";
            VHSR02IW-PASSVALUE.USER-GRP = VHSR02D_DATA.USER-GRP;
            VHSR02IW-PASSVALUE.DATE-NARR = VHSR02D_DATA.DATE-NARR;
            VHSR02IW-PASSVALUE.TIME-NARR = VHSR02D_DATA.TIME-NARR;
            VHSR02IW-PASSVALUE.TIME-NARR-FILLER-1 = ":";
            VHSR02IW-PASSVALUE.TIME-NARR-FILLER-2 = ":";
            VHSR02IW-PASSVALUE.NARR = VHSR02D_DATA.NARR;
            VHSR02IW-PASSVALUE.NARR-NO = VHSR02D_DATA.NARR-NO;
            VHSR02IW-PASSVALUE.MAX-ROWS = VHSR02D_DATA.CURRENT-ROW;
            VHSR02IW-PASSVALUE.CURRENT-ROW = VHSR02D_DATA.NARR-NO;
            if (VHSR02IW-PASSVALUE.CURRENT-ROW <= 1)
                VHSR02IW-TRIGGER.DISABLE-PRV = "Y";
            else
                VHSR02IW-TRIGGER.ENABLE-PRV = "Y";
            end
            VHSR02IW-TRIGGER.DISABLE-NXT = "Y";
            if (VHSR02D_CRIT.JOB-INDICATOR == "JOB")
                FINAL-MESSAGE = "Job comment added successfully.";
            else
                if (VHSR02D_CRIT.JOB-INDICATOR == "REPAIR")
                    FINAL-MESSAGE = "Job repr comment added successfully.";
                end
            end
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHSR02IS-LIST () 
    VHSR02IW.FINAL-MESSAGE = " ";
    VHSR02IW.CURRENT-NARR = " ";
    ERROR-MESSAGE = " ";
    INVALID-JOB = "N";
    INVALID-DOCNO = "N";
    INVALID-ACTION = "N";
    ERROR-COUNT = 0;
    if (VHSR02IW-PASSVALUE.PARENT-GUI == "VHMSRI")
        VHSR02IW-PASSVALUE.JOB-NO = VHSR02IW.JOB-NO;
        VHSR02IW-PASSVALUE.SUB-JOB-DOC-NO = VHSR02IW.SUB-JOB-DOC-NO;
    end
    if (VHSR02IW.JOB-NO == " ")
        ERROR-COUNT = ERROR-COUNT + 1;
        ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Job no required.";
        INVALID-JOB = "Y";
        ENABLE-JOBCRIT = "Y";
    end
    if (VHSR02IW.SUB-JOB-DOC-NO < 1)
        ERROR-COUNT = ERROR-COUNT + 1;
        ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Doc no should be greater than zero.";
        INVALID-DOCNO = "Y";
        ENABLE-JOBCRIT = "Y";
    end
    if (VHSR02IW.SEL-ACTION == 0)
        ERROR-COUNT = ERROR-COUNT + 1;
        ERROR-MESSAGE-OCCR[ERROR-COUNT] = "Invalid selection action.";
        INVALID-ACTION = "Y";
        ENABLE-JOBCRIT = "Y";
    end
    if (ERROR-COUNT > 0)
        VHSR02IS-MOVE-MSG();
    else
    
    
        VHSR02E_CRIT.JOB-NO = VHSR02IW.JOB-NO;
        VHSR02E_CRIT.SUB-JOB-DOC-NO = VHSR02IW.SUB-JOB-DOC-NO;
        try
            call "VHSR02E"(XDCONTROL, VHSR02E_CRIT, VHSR02E_DATA);
        
        end
        if (XDCONTROL.UROWCNT == 1)
            DISABLE-JOBCRIT = "Y";
        else
            if (XDCONTROL.URC == 100)
                FINAL-MESSAGE = "The entered job and doc no does not exist in the database.";
                JOB-SETFOCUS = "Y";
                ENABLE-JOBCRIT = "Y";
                return;
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        end
        VHSR02F_CRIT.JOB-NO = VHSR02IW.JOB-NO;
        VHSR02F_CRIT.SUB-JOB-DOC-NO = VHSR02IW.SUB-JOB-DOC-NO;
        if (VHSR02IW.SEL-ACTION == 1)
            VHSR02F_CRIT.JOB-INDICATOR = "JOB";
            VHSR02IW-PASSVALUE.JOB-INDICATOR = "JOB";
        else
            if (VHSR02IW.SEL-ACTION == 2)
                VHSR02F_CRIT.JOB-INDICATOR = "REPAIR";
                VHSR02IW-PASSVALUE.JOB-INDICATOR = "REPAIR";
            end
        end
        try
            call "VHSR02F"(XDCONTROL, VHSR02F_CRIT, VHSR02F_DATA);
        
        end
        if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
         VHSR02F_DATA.MAX-ROWS >= 1)
            ENABLE-UPDNARR = "Y";
            if (VHSR02F_DATA.MAX-ROWS == 1)
                DISABLE-PRV = "Y";
                DISABLE-NXT = "Y";
            else
                DISABLE-PRV = "Y";
                ENABLE-NXT = "Y";
            end
            VHSR02IW-PASSVALUE.MAX-ROWS = VHSR02F_DATA.MAX-ROWS;
            VHSR02IW-PASSVALUE.USER-GRP = VHSR02F_DATA.USER-GRP;
            VHSR02IW-PASSVALUE.DATE-NARR = VHSR02F_DATA.DATE-NARR;
            VHSR02IW-PASSVALUE.TIME-NARR = VHSR02F_DATA.TIME-NARR;
            VHSR02IW-PASSVALUE.TIME-NARR-FILLER-1 = ":";
            VHSR02IW-PASSVALUE.TIME-NARR-FILLER-2 = ":";
            VHSR02IW-PASSVALUE.NARR = VHSR02F_DATA.NARR;
            VHSR02IW-PASSVALUE.NARR-NO = VHSR02F_DATA.NARR-NO;
            VHSR02IW-PASSVALUE.CURRENT-ROW = VHSR02F_DATA.NARR-NO;
        else
            if ((XDCONTROL.URC == 0 || XDCONTROL.URC == 4) &&
             VHSR02F_DATA.MAX-ROWS == 0)
                VHSR02IW-PASSVALUE.USER-GRP = VHSR02IW-PASSVALUE.STORE-USER-GRP;
                VHSR02IW-PASSVALUE.DATE-NARR = VGVar.currentFormattedGregorianDate;
                VHSR02IW-PASSVALUE.TIME-NARR = VGVar.currentFormattedTime;
                VHSR02IW-PASSVALUE.TIME-NARR-FILLER-1 = ":";
                VHSR02IW-PASSVALUE.TIME-NARR-FILLER-2 = ":";
                VHSR02IW-PASSVALUE.NARR = " ";
                DISABLE-UPDNARR = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        end
        ENABLE-ADDNARR = "Y";
        ADDNARR-SETFOCUS = "Y";
    end
end 

Function VHSR02IS-MOVE-MSG () 
    VHSR02IW.ERROR-LOOP-INDEX = 1;
    VHSR02IW.FINAL-INDEX = 0;
    VHSR02IW.FINAL-ERROR-MSG = " ";
    VHSR02IW.TEMP-ERROR-MSG = " ";
    if (ERROR-COUNT > 0)
        while (((ERROR-LOOP-INDEX <= 3) &&
         (ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX] != " ")))
            ERROR-COUNT = 1;
            TEMP-ERROR-MSG = ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX];
            while ((ERROR-COUNT <= 40))
                if (TEMP-MSG[ERROR-COUNT] != ".")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = TEMP-MSG[ERROR-COUNT];
                else
                    if (TEMP-MSG[ERROR-COUNT] == ".")
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = ",";
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = " ";
                        ERROR-COUNT = 40;
                    end
                end
                ERROR-COUNT = ERROR-COUNT + 1;
            end
            ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
        end
        FINAL-INDEX = FINAL-INDEX - 1;
        FINAL-MSG[FINAL-INDEX] = " ";
        VHSR02IW.FINAL-MESSAGE = FINAL-ERROR-MSG;
        EXECUTE-SETFOCUS = "Y";
    end
end 

Function VHSR02IS-PRV-NXT () 
    VHSR02IW.FINAL-MESSAGE = " ";
    if (VHSR02IW.BUTTON-CLICK == "PRV")
        VHSR02IW.UPD-NARR-NO = VHSR02IW.UPD-NARR-NO - 1;
        if (VHSR02IW.UPD-NARR-NO == 1)
            DISABLE-PRV = "Y";
            if (VHSR02IW.UPD-NARR-NO == VHSR02IW-PASSVALUE.MAX-ROWS)
                DISABLE-NXT = "Y";
            else
                ENABLE-NXT = "Y";
                NXT-SETFOCUS = "Y";
            end
        else
            ENABLE-PRV = "Y";
            ENABLE-NXT = "Y";
            PRV-SETFOCUS = "Y";
        end
    else
        if (VHSR02IW.BUTTON-CLICK == "NXT")
            VHSR02IW.UPD-NARR-NO = VHSR02IW.UPD-NARR-NO + 1;
            ENABLE-PRV = "Y";
            if (VHSR02IW.UPD-NARR-NO == VHSR02IW-PASSVALUE.MAX-ROWS)
                DISABLE-NXT = "Y";
                PRV-SETFOCUS = "Y";
            else
                ENABLE-NXT = "Y";
                NXT-SETFOCUS = "Y";
            end
        end
    end
    VHSR02C_CRIT.JOB-NO = VHSR02IW-PASSVALUE.JOB-NO;
    VHSR02C_CRIT.SUB-JOB-DOC-NO = VHSR02IW-PASSVALUE.SUB-JOB-DOC-NO;
    VHSR02C_CRIT.NARR-NO = VHSR02IW.UPD-NARR-NO;
    if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "JOB")
        VHSR02C_CRIT.JOB-INDICATOR = "JOB";
    else
        if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "REPAIR")
            VHSR02C_CRIT.JOB-INDICATOR = "REPAIR";
        end
    end
    XXEXT_CALL_Level77Items.UEXTNAM = "VHSR02I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHSR02C";
    try
        call "VHSR02C"(XDCONTROL, VHSR02C_CRIT, VHSR02C_DATA);
    
    end
    MRSCommonCode.XXA0IS-CHECK_EXT();
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHSR02IW-PASSVALUE.USER-GRP = VHSR02C_DATA.USER-GRP;
            VHSR02IW-PASSVALUE.DATE-NARR = VHSR02C_DATA.DATE-NARR;
            VHSR02IW-PASSVALUE.TIME-NARR = VHSR02C_DATA.TIME-NARR;
            VHSR02IW-PASSVALUE.TIME-NARR-FILLER-1 = ":";
            VHSR02IW-PASSVALUE.TIME-NARR-FILLER-2 = ":";
            VHSR02IW-PASSVALUE.NARR = VHSR02C_DATA.NARR;
            VHSR02IW-PASSVALUE.CURRENT-ROW = VHSR02IW.UPD-NARR-NO;
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHSR02IS-SETFOCUS () 
    if (INVALID-JOB == "Y")
        JOB-SETFOCUS = "Y";
    else
        if (INVALID-DOCNO == "Y")
            DOCNO-SETFOCUS = "Y";
        else
            if (INVALID-ACTION == "Y")
                ACTION-SETFOCUS = "Y";
            end
        end
    end
end 

Function VHSR02IS-UPDNARR ()
  
  
  
  
  
  
  
   
    if (VHSR02IW.UPD-NARR != " ")
        VHSR02IW.UPD-NARR-NO = VHSR02IW-PASSVALUE.CURRENT-ROW;
        if (VHSR02IW-PASSVALUE.PARENT-GUI == "VHMSRI")
            VHSR02B_CRIT.JOB-NO = VHSR02IW.JOB-NO;
            VHSR02B_CRIT.NARR-NO = VHSR02IW.UPD-NARR-NO;
            VHSR02B_CRIT.SUB-JOB-DOC-NO = VHSR02IW.SUB-JOB-DOC-NO;
            VHSR02IW-PASSVALUE.JOB-NO = VHSR02IW.JOB-NO;
            VHSR02IW-PASSVALUE.SUB-JOB-DOC-NO = VHSR02IW.SUB-JOB-DOC-NO;
        else
            VHSR02B_CRIT.JOB-NO = VHSR02IW-PASSVALUE.JOB-NO;
            VHSR02B_CRIT.NARR-NO = VHSR02IW.UPD-NARR-NO;
            VHSR02B_CRIT.SUB-JOB-DOC-NO = VHSR02IW-PASSVALUE.SUB-JOB-DOC-NO;
        end
        VHSR02B_DATA.NARR = VHSR02IW.UPD-NARR;
        VHSR02B_DATA.USER-GRP = VHSR02IW-PASSVALUE.STORE-USER-GRP;
        VHSR02B_DATA.TERM-NARR = VHSR02IW-PASSVALUE.TERM-LAST-UPD;
        if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "JOB")
            VHSR02B_CRIT.JOB-INDICATOR = "JOB";
        else
            if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "REPAIR")
                VHSR02B_CRIT.JOB-INDICATOR = "REPAIR";
            end
        end

    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHSR02I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHSR02B";
        try
            call "VHSR02B"(XDCONTROL, VHSR02B_CRIT, VHSR02B_DATA);
        
        end
        MRSCommonCode.XXA0IS-CHECK_EXT();
        if (XXEXT_CALL_Level77Items.URC == 0)
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "JOB")
                    FINAL-MESSAGE = "Job comment updated successfully";
                else
                    if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "REPAIR")
                        FINAL-MESSAGE = "Job repr comment updated successfully";
                    end
                end
                VHSR02IW-PASSVALUE.REFRESH-GUI = "Y";
                ADDNARR-SETFOCUS = "Y";
            else
                if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "JOB")
                    FINAL-MESSAGE = "Job comment update unsuccessful";
                else
                    if (VHSR02IW-PASSVALUE.JOB-INDICATOR == "REPAIR")
                        FINAL-MESSAGE = "Job repr comment update unsuccessful";
                    end
                end
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    else
        VHSR02IW.FINAL-MESSAGE = "Invalid comment.";
        VHSR02IW-TRIGGER.UPDNARR-SETFOCUS = "Y";
    end
end 

Function VHSR03IS-ADDLABOR () 
    VHSR03IS-INPUT();
    VHSR03IW.LOOP-INDEX = VHSR03IW.NEXT-ROW-COUNT;
    VHSR03IW.ERROR-MESSAGE = " ";
    VHSR03IW.FINAL-MESSAGE = " ";
    VHSR03IW.ERROR-COUNT = 0;
    VHSR03IW.SET-ROW-IND = "N";
    VHSR03IW.SET-INDEX = 0;
    LOAD-NEXT-DATA = "Y";
    VHSR03IW.COUNT-BLANK-ROW = 0;
    while ((LOOP-INDEX <= 100 && COUNT-BLANK-ROW <= 2 &&
     ERROR-COUNT <= 6))
        VHSR03IW.SET-INDEX = VHSR03IW.SET-INDEX + 1;
        if (VHSR03A_DATA-X.DATE-WORK[LOOP-INDEX] == " " &&
         VHSR03A_DATA-X.REPR-LABOR-HRS[LOOP-INDEX] == 0.0)
            COUNT-BLANK-ROW = COUNT-BLANK-ROW + 1;
        end
        if (VHSR03A_DATA-X.DATE-WORK[LOOP-INDEX] == " " &&
         VHSR03A_DATA-X.REPR-LABOR-HRS[LOOP-INDEX] == 0.0 &&
         VHSR03IW.SET-INDEX == 1)
            ERROR-COUNT = ERROR-COUNT + 1;
            VHSR03IW.ERROR-MSG-1[ERROR-COUNT] = "Line: ";
            VHSR03IW.ERROR-MSG-2[ERROR-COUNT] = SET-INDEX;
            VHSR03IW.ERROR-MSG-3[ERROR-COUNT] = " - Data required.";
            LOOP-INDEX = 101;
        else
            if (COUNT-BLANK-ROW <= 2 &&
             (VHSR03A_DATA-X.DATE-WORK[LOOP-INDEX] != " " || 
       
       
       
             VHSR03A_DATA-X.EMPL-NO[LOOP-INDEX] != " " ||
             VHSR03A_DATA-X.REPR-LABOR-HRS[LOOP-INDEX] > 0.0))
                if (VHSR03A_DATA-X.DATE-WORK[LOOP-INDEX] == " ")
                    ERROR-COUNT = ERROR-COUNT + 1;
                    VHSR03IW.ERROR-MSG-1[ERROR-COUNT] = "Line: ";
                    VHSR03IW.ERROR-MSG-2[ERROR-COUNT] = SET-INDEX;
                    VHSR03IW.ERROR-MSG-3[ERROR-COUNT] = " - Date Work required.";
                else

          
                    VHSR03IW.TEMP-DATE = " ";
                    VHSR03IW.FINAL-DATE = " ";
                    VHSR03IW.TEMP-DATE = VHSR03A_DATA-X.DATE-WORK[LOOP-INDEX];
                    VHSR03IW.FINAL-DATE-MM = VHSR03IW.TEMP-DATE-MM;
                    VHSR03IW.FINAL-DATE-FILLER-1 = "-";
                    VHSR03IW.FINAL-DATE-DD = VHSR03IW.TEMP-DATE-DD;
                    VHSR03IW.FINAL-DATE-FILLER-2 = "-";
                    VHSR03IW.FINAL-DATE-YYYY = VHSR03IW.TEMP-DATE-YYYY;
  
                    AFCXVLD_CRIT.FORM-DATE = VHSR03IW.FINAL-DATE;
                    MRSCommonCode.AFCXVLD-VALIDATE();
                    if (AFCXVLDW.INCORRECT-DATE == "Y")
                        ERROR-COUNT = ERROR-COUNT + 1;
                        VHSR03IW.ERROR-MSG-1[ERROR-COUNT] = "Line: ";
                        VHSR03IW.ERROR-MSG-2[ERROR-COUNT] = SET-INDEX;
                        VHSR03IW.ERROR-MSG-3[ERROR-COUNT] = " - Invalid Date Work.";
                    else
                        if (AFCXVLDW.SQL-ERROR == "Y")
                            ERROR-COUNT = ERROR-COUNT + 1;
                            VHSR03IW.ERROR-MSG-1[ERROR-COUNT] = "Line: ";
                            VHSR03IW.ERROR-MSG-2[ERROR-COUNT] = SET-INDEX;
                            VHSR03IW.ERROR-MSG-3[ERROR-COUNT] = " - Date DB Error.";
                        else
                            if (AFCXVLDW.NO-ERROR == "Y")
                
                
                                VHSR03IS-DATE-CHK();
                            end
                        end
                    end
                end
                if (ERROR-COUNT == 6)
                    LOOP-INDEX = 101;
                end
                VHSR03IS-VALIDATE(); 
            end
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
    if (ERROR-COUNT > 0)
        VHSR03IS-MOVE-MSG();
    else
        VHSR03IS-DB-STORE(); 
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            GO-COMMENTS = "Y";
        end
    end
end 

Function VHSR03IS-AFT-CHKST () 
    VHSR03IW.NARR = " ";
    VHSR03IW.NARR-NO = 0;
    set VHSR03A_DATA-X empty;
    if (VHSR03IW-PASSVALUE.PARENT-GUI == "VHSR09I")
        DISABLE-JOBLIST = "Y";
        VHSR03IW.JOB-NO = VHSR03IW-PASSVALUE.JOB-NO;
        VHSR03IW.SUB-JOB-DOC-NO = VHSR03IW-PASSVALUE.SUB-JOB-DOC-NO;
        

    
        VHSR03F_CRIT.JOB-NO = VHSR03IW.JOB-NO;
        VHSR03F_CRIT.SUB-JOB-DOC-NO = VHSR03IW.SUB-JOB-DOC-NO;
        try
            call "VHSR03F"(XDCONTROL, VHSR03F_CRIT, VHSR03F_DATA);
        
        end
        if (VHSR03F_DATA.DOC-COUNT == 1)
            if (VHSR03F_DATA.SUB-JOB-STAT == "CLO")
                VHSR03IW.FINAL-MESSAGE-1 = "Job ";
                VHSR03IW.FINAL-MESSAGE-2 = VHSR03IW.JOB-NO;
                VHSR03IW.FINAL-MESSAGE-3 = "-";
                VHSR03IW.FINAL-MESSAGE-4 = VHSR03IW.SUB-JOB-DOC-NO;
                VHSR03IW.FINAL-MESSAGE-5 = " Closed.";
                VHSR03IW.PREV-ROW-COUNT = 0;
                LOAD-PREV-DATA = "Y";
                VHSR03IW.NEXT-ROW-COUNT = 101;
                LOAD-NEXT-DATA = "Y";
                VHSR03IW.NARR = " ";
                VHSR03IW.NARR-NO = 0;
                DISABLE-ADDLABOR = "Y";
                DISABLE-COMMENTS = "Y";
                DISABLE-CLOSEJOB = "Y";
                DISABLE-NARR = "Y";
                DISABLE-PRV = "Y";
                DISABLE-NXT = "Y";
                DETAILS1-SETFOCUS = "Y";
            else
                if (VHSR03F_DATA.SUB-JOB-STAT == "OTV" ||
                 VHSR03F_DATA.SUB-JOB-STAT == "REP" ||
                 VHSR03F_DATA.SUB-JOB-STAT == "DEF" ||
                 VHSR03F_DATA.SUB-JOB-STAT == "NWP")
          
                    VHSR03A_CRIT.JOB-NO = VHSR03IW.JOB-NO;
                    VHSR03A_CRIT.SUB-JOB-DOC-NO = VHSR03IW.SUB-JOB-DOC-NO;
                    try
                        call "VHSR03A"(XDCONTROL, VHSR03A_CRIT, VHSR03A_DATA);
                    
                    end
                    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                        VHSR03IW.PREV-ROW-COUNT = XDCONTROL.UROWCNT;
                        LOAD-PREV-DATA = "Y";
                        VHSR03IW.NEXT-ROW-COUNT = XDCONTROL.UROWCNT + 1;
                        LOAD-NEXT-DATA = "Y";

            
                        VHSR09A_CRIT.JOB-NO = VHSR03IW.JOB-NO;
                        VHSR09A_CRIT.SUB-JOB-DOC-NO = VHSR03IW.SUB-JOB-DOC-NO;
                        try
                            call "VHSR09A"(XDCONTROL, VHSR09A_CRIT, VHSR09A_DATA_01, VHSR09A_DATA_02);
                        
                        end
                        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                            ENABLE-CLOSEJOB = "Y";
                        else
                            if (XDCONTROL.URC == 100)
                                VHSR03IW.FINAL-MESSAGE = "Atleast One Repair Detail required to Close this job";
                                DISABLE-CLOSEJOB = "Y";
                            end
                        end
                        ENABLE-ADDLABOR = "Y";
                        ENABLE-COMMENTS = "Y";
                        EXECUTE-PRVNXT = "Y";
                        DETAILS1-SETFOCUS = "Y";
                    else
                        if (XDCONTROL.URC == 100)
                            VHSR03A_DATA.DATA_ROW = "  ";
                            VHSR03IW.PREV-ROW-COUNT = 0;
             
                            VHSR03IW.NEXT-ROW-COUNT = 1;
                            LOAD-NEXT-DATA = "Y";
                            DISABLE-CLOSEJOB = "Y";
                            DETAILS1-SETFOCUS = "Y";
                            ENABLE-ADDLABOR = "Y";
                            ENABLE-COMMENTS = "Y";
                            EXECUTE-PRVNXT = "Y";
                        else
                            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                            return;
                        end
                    end
                else
                    VHSR03IW.FINAL-MESSAGE = "Sub Job NOT OUT THE DOOR.";
                    set VHSR03A_DATA empty;
                    VHSR03IW.PREV-ROW-COUNT = 0;
                    LOAD-PREV-DATA = "Y";
                    VHSR03IW.NEXT-ROW-COUNT = 101;
                    LOAD-NEXT-DATA = "Y";
                    VHSR03IW.NARR = " ";
                    VHSR03IW.NARR-NO = 0;
                    DISABLE-ADDLABOR = "Y";
                    DISABLE-COMMENTS = "Y";
                    DISABLE-CLOSEJOB = "Y";
                    DISABLE-NARR = "Y";
                    DISABLE-PRV = "Y";
                    DISABLE-NXT = "Y";
                end
            end
        else
            set VHSR03A_DATA empty;
            VHSR03IW.PREV-ROW-COUNT = 0;
            LOAD-PREV-DATA = "Y";
            VHSR03IW.NEXT-ROW-COUNT = 101;
            LOAD-NEXT-DATA = "Y";
            VHSR03IW.NARR = " ";
            VHSR03IW.NARR-NO = 0;
            DISABLE-ADDLABOR = "Y";
            DISABLE-COMMENTS = "Y";
            DISABLE-CLOSEJOB = "Y";
            DISABLE-NARR = "Y";
            DISABLE-PRV = "Y";
            DISABLE-NXT = "Y";
        end
    else
        if (VHSR03IW-PASSVALUE.PARENT-GUI == "VHMSRI")
            DISABLE-ADDLABOR = "Y";
            DISABLE-COMMENTS = "Y";
            DISABLE-CLOSEJOB = "Y";
            DISABLE-NARR = "Y";
            DISABLE-PRV = "Y";
            DISABLE-NXT = "Y";
            ENABLE-JOBLIST = "Y";
            VHSR03IW.JOB-NO = " ";
            VHSR03IW.NARR = " ";
            VHSR03IW.SUB-JOB-DOC-NO = 1;
            set VHSR03A_DATA empty;
            VHSR03IW.PREV-ROW-COUNT = 0;
            LOAD-PREV-DATA = "Y";
            VHSR03IW.NEXT-ROW-COUNT = 101;
            LOAD-NEXT-DATA = "Y";
            JOBNO-SETFOCUS = "Y";
        end
    end
end 

Function VHSR03IS-AFT-NARR () 
    VHSR03IW.FINAL-MESSAGE = " ";
    VHSR03IW.BUTTON-CLICK = " ";
    if (VHSR03IW.REFRESH-GUI == "Y")
        VHSR03IW.NARR-COUNT = 0;
        EXECUTE-PRVNXT = "Y";
    end
    DISABLE-JOBLIST = "Y";
    AFT-NARR-SW = "Y";
end 

Function VHSR03IS-CLEAR () 
    set VHSR03IW-INPUT empty;
    set VHSR03IW empty;
    VHSR03IS-AFT-CHKST();
    ENABLE-JOBLIST = "Y";
    set VHSR03A_DATA empty;
    PREV-ROW-COUNT = 0;
    LOAD-PREV-DATA = "Y";
end 

Function VHSR03IS-CLEAR-X () 
    set VHSR03IW-INPUT empty;
end 

Function VHSR03IS-CLOSEJOB () 
    VHSR03IW.LOOP-INDEX = VHSR03IW.NEXT-ROW-COUNT;
    VHSR03IW.ERROR-MESSAGE = " ";
    VHSR03IW.FINAL-MESSAGE = " ";
    VHSR03IW.ERROR-COUNT = 0;
    VHSR03IW.SET-ROW-IND = "N";
    VHSR03IW.SET-INDEX = 0;
    VHSR03IW.COUNT-BLANK-ROW = 0;
    while ((LOOP-INDEX <= 100 && COUNT-BLANK-ROW <= 2))
        VHSR03IW.SET-INDEX = VHSR03IW.SET-INDEX + 1;
        if (VHSR03A_DATA.DATE-WORK[LOOP-INDEX] == " " &&
         VHSR03A_DATA.REPR-LABOR-HRS[LOOP-INDEX] == 0.0)
            COUNT-BLANK-ROW = COUNT-BLANK-ROW + 1;
        end
        if (COUNT-BLANK-ROW <= 2 &&
         (VHSR03A_DATA.DATE-WORK[LOOP-INDEX] != " " || 
     
     
     
         VHSR03A_DATA.EMPL-NO[LOOP-INDEX] != " " ||
         VHSR03A_DATA.REPR-LABOR-HRS[LOOP-INDEX] > 0.0))
            if (VHSR03A_DATA.DATE-WORK[LOOP-INDEX] == " ")
                ERROR-COUNT = ERROR-COUNT + 1;
                VHSR03IW.ERROR-MSG-1[ERROR-COUNT] = "Line: ";
                VHSR03IW.ERROR-MSG-2[ERROR-COUNT] = SET-INDEX;
                VHSR03IW.ERROR-MSG-3[ERROR-COUNT] = " - Date Work required.";
            else
          
                AFCXVLD_CRIT.FORM-DATE = VHSR03A_DATA.DATE-WORK[LOOP-INDEX];
                MRSCommonCode.AFCXVLD-VALIDATE();
                if (AFCXVLDW.INCORRECT-DATE == "Y")
                    ERROR-COUNT = ERROR-COUNT + 1;
                    VHSR03IW.ERROR-MSG-1[ERROR-COUNT] = "Line: ";
                    VHSR03IW.ERROR-MSG-2[ERROR-COUNT] = SET-INDEX;
                    VHSR03IW.ERROR-MSG-3[ERROR-COUNT] = " - Invalid Date Work.";
                else
                    if (AFCXVLDW.SQL-ERROR == "Y")
                        ERROR-COUNT = ERROR-COUNT + 1;
                        VHSR03IW.ERROR-MSG-1[ERROR-COUNT] = "Line: ";
                        VHSR03IW.ERROR-MSG-2[ERROR-COUNT] = SET-INDEX;
                        VHSR03IW.ERROR-MSG-3[ERROR-COUNT] = " - Date DB Error.";
                    else
                        if (AFCXVLDW.NO-ERROR == "Y")
                            VHSR03IS-VALIDATE(); 
                        end
                    end
                end
            end
        end
        LOOP-INDEX = LOOP-INDEX + 1;
    end
    if (ERROR-COUNT > 0)
        VHSR03IS-MOVE-MSG();
    else
        VHSR03IS-DB-CLOSE(); 
        RETURN-TO-REPAIR = "Y";
    end
    if (AFT-NARR-SW == "Y")
        RETURN-TO-REPAIR = "Y";
    end
end 

Function VHSR03IS-CLR-CLOSE () 
    VHSR03IW-TRIGGER.TEMP-FINAL-MESSAGE = " ";
    VHSR03IW-TRIGGER.TEMP-FINAL-MESSAGE = VHSR03IW.FINAL-MESSAGE;
    set VHSR03IW empty;
    VHSR03IW.FINAL-MESSAGE = VHSR03IW-TRIGGER.TEMP-FINAL-MESSAGE;
    DISABLE-ADDLABOR = "Y";
    DISABLE-COMMENTS = "Y";
    DISABLE-CLOSEJOB = "Y";
    DISABLE-NARR = "Y";
    DISABLE-PRV = "Y";
    DISABLE-NXT = "Y";
    if (VHSR03IW-PASSVALUE.PARENT-GUI == "VHMSRI")
        VHSR03IW.JOB-NO = " ";
        VHSR03IW.SUB-JOB-DOC-NO = 1;
        ENABLE-JOBLIST = "Y";
        JOBNO-SETFOCUS = "Y";
    else
        DISABLE-JOBLIST = "Y";
        VHSR03IW.JOB-NO = VHSR03IW-PASSVALUE.JOB-NO;
        VHSR03IW.SUB-JOB-DOC-NO = VHSR03IW-PASSVALUE.SUB-JOB-DOC-NO;
    end
    VHSR03IW.PREV-ROW-COUNT = 0;
    LOAD-PREV-DATA = "Y";
    VHSR03IW.NEXT-ROW-COUNT = 101;
    LOAD-NEXT-DATA = "Y";
end 

Function VHSR03IS-COMMENTS () 
    VHSR03IW-PASSVALUE.JOB-NO = VHSR03IW.JOB-NO;
    VHSR03IW-PASSVALUE.SUB-JOB-DOC-NO = VHSR03IW.SUB-JOB-DOC-NO;
    VHSR03IW-PASS-COMM.PARENT-GUI = "VHSR03I";
    VHSR03IW-PASSVALUE.JOB-INDICATOR = "REPAIR";
end 

Function VHSR03IS-DATE-CHK ()
   
    VHSR03IW.TEMP-DATE-WORK = VHSR03IW.FINAL-DATE;
    if ((VHSR03IW.TEMP-DATE-WORK-YYYY < VHSR03F_DATA.DATE-IN-YYYY) ||
     (VHSR03IW.TEMP-DATE-WORK-YYYY == VHSR03F_DATA.DATE-IN-YYYY &&
     VHSR03IW.TEMP-DATE-WORK-MM < VHSR03F_DATA.DATE-IN-MM) ||
     (VHSR03IW.TEMP-DATE-WORK-YYYY == VHSR03F_DATA.DATE-IN-YYYY &&
     VHSR03IW.TEMP-DATE-WORK-MM == VHSR03F_DATA.DATE-IN-MM &&
     VHSR03IW.TEMP-DATE-WORK-DD < VHSR03F_DATA.DATE-IN-DD))
        ERROR-COUNT = ERROR-COUNT + 1;
        VHSR03IW.ERROR-MSG-1[ERROR-COUNT] = "Line: ";
        VHSR03IW.ERROR-MSG-2[ERROR-COUNT] = SET-INDEX;
        VHSR03IW.ERROR-MSG-3[ERROR-COUNT] = " - Date older than Date In.";
    else
        if ((VHSR03IW.TEMP-DATE-WORK-YYYY > VHSR03F_DATA.DATE-OUT-YYYY) ||
         (VHSR03IW.TEMP-DATE-WORK-YYYY == VHSR03F_DATA.DATE-OUT-YYYY &&
         VHSR03IW.TEMP-DATE-WORK-MM > VHSR03F_DATA.DATE-OUT-MM) ||
         (VHSR03IW.TEMP-DATE-WORK-YYYY == VHSR03F_DATA.DATE-OUT-YYYY &&
         VHSR03IW.TEMP-DATE-WORK-MM == VHSR03F_DATA.DATE-OUT-MM &&
         VHSR03IW.TEMP-DATE-WORK-DD > VHSR03F_DATA.DATE-OUT-DD))
            ERROR-COUNT = ERROR-COUNT + 1;
            VHSR03IW.ERROR-MSG-1[ERROR-COUNT] = "Line: ";
            VHSR03IW.ERROR-MSG-2[ERROR-COUNT] = SET-INDEX;
            VHSR03IW.ERROR-MSG-3[ERROR-COUNT] = " - Date after Date Out.";
        end
    end
end 

Function VHSR03IS-DB-CLOSE ()
  
   
    set VHSR03D_DATA empty;
    VHSR03IW.LOOP-INDEX = 0;
    VHSR03IW.ERROR-ROW-COUNT = 0;
    while ((VHSR03IW.NEXT-ROW-COUNT < 100) &&
     VHSR03IW.ERROR-ROW-COUNT <= 2)
        if (VHSR03A_DATA.DATE-WORK[NEXT-ROW-COUNT] != " ")
            VHSR03IW.LOOP-INDEX = VHSR03IW.LOOP-INDEX + 1;
            VHSR03D_DATA.DATE-WORK[LOOP-INDEX] = VHSR03A_DATA.DATE-WORK[NEXT-ROW-COUNT];
  
  
            VHSR03D_DATA.REPR-LABOR-HRS[LOOP-INDEX] = VHSR03A_DATA.REPR-LABOR-HRS[NEXT-ROW-COUNT];
            VHSR03D_DATA.EMPL-NO[LOOP-INDEX] = VHSR03A_DATA.EMPL-NO[NEXT-ROW-COUNT];
            
  
  
  
  
  
  
  
  
        else
            VHSR03IW.ERROR-ROW-COUNT = VHSR03IW.ERROR-ROW-COUNT + 1;
        end
        NEXT-ROW-COUNT = NEXT-ROW-COUNT + 1;
    end
    VHSR03D_DATA.JOB-NO = VHSR03IW.JOB-NO;
    VHSR03D_DATA.SUB-JOB-DOC-NO = VHSR03IW.SUB-JOB-DOC-NO;
    VHSR03D_DATA.TERM-LAST-UPD = VHSR03IW-PASSVALUE.TERM-LAST-UPD;
    VHSR03IW-PASSVALUE.JOB-NO = VHSR03IW.JOB-NO;
    VHSR03IW-PASSVALUE.SUB-JOB-DOC-NO = VHSR03IW.SUB-JOB-DOC-NO;
    if (VHSR03IW.LOOP-INDEX >= 1)
        try
            call "VHSR03D"(XDCONTROL, VHSR03D_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
            VHSR03IW.FINAL-MESSAGE = "Database access error. Labor Details not added successfully.";
            DISABLE-ADDLABOR = "Y";
            DISABLE-CLOSEJOB = "Y";
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end

  
    VHSR03E_CRIT.JOB-NO = VHSR03IW.JOB-NO;
    VHSR03E_CRIT.SUB-JOB-DOC-NO = VHSR03IW.SUB-JOB-DOC-NO;
    VHSR03E_DATA.TERM-LAST-UPD = VHSR03IW-PASSVALUE.TERM-LAST-UPD;
    VHSR03E_DATA.USER-GRP = VHSR03IW-PASSVALUE.USER-GRP;
    try
        call "VHSR03E"(XDCONTROL, VHSR03E_CRIT, VHSR03E_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHSR03IW.FINAL-MESSAGE = "Job Closed.";
    else
        VHSR03IW.FINAL-MESSAGE = "Database access error. Job not closed successfully.";
        DISABLE-ADDLABOR = "Y";
        DISABLE-CLOSEJOB = "Y";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    VHSR03IW-TRIGGER.DESELECT-ALLCELLS = "Y";
    VHSR03IS-CLR-CLOSE();
end 

Function VHSR03IS-DB-STORE () 
    set VHSR03D_DATA empty;
    VHSR03D_DATA.ADD-NARR-IND = "N";
    VHSR03IW.LOOP-INDEX = 0;
    VHSR03IW.ERROR-ROW-COUNT = 0;
    while ((VHSR03IW.NEXT-ROW-COUNT < 100) &&
     VHSR03IW.ERROR-ROW-COUNT <= 2)
        if (VHSR03A_DATA-X.DATE-WORK[NEXT-ROW-COUNT] != " ")
            VHSR03IW.LOOP-INDEX = VHSR03IW.LOOP-INDEX + 1;
            VHSR03IW.TEMP-DATE = " ";
            VHSR03IW.FINAL-DATE = " ";
            VHSR03IW.TEMP-DATE = VHSR03A_DATA-X.DATE-WORK[NEXT-ROW-COUNT];
  
            VHSR03IW.FINAL-DATE-MM = VHSR03IW.TEMP-DATE-MM;
            VHSR03IW.FINAL-DATE-FILLER-1 = "-";
            VHSR03IW.FINAL-DATE-DD = VHSR03IW.TEMP-DATE-DD;
            VHSR03IW.FINAL-DATE-FILLER-2 = "-";
            VHSR03IW.FINAL-DATE-YYYY = VHSR03IW.TEMP-DATE-YYYY;
            VHSR03D_DATA.DATE-WORK[LOOP-INDEX] = VHSR03IW.FINAL-DATE;

  
  

  
  
  
  
  
  
  
  
  
  
  
  
  
  
            VHSR03D_DATA.REPR-LABOR-HRS[LOOP-INDEX] = VHSR03A_DATA-X.REPR-LABOR-HRS[NEXT-ROW-COUNT];
            VHSR03D_DATA.EMPL-NO[LOOP-INDEX] = VHSR03A_DATA-X.EMPL-NO[NEXT-ROW-COUNT];
            
  
  
  
  
  
  
  
  
  
  
        end
        NEXT-ROW-COUNT = NEXT-ROW-COUNT + 1;
    end
    VHSR03IW-PASSVALUE.JOB-NO = VHSR03IW.JOB-NO;
    VHSR03IW-PASSVALUE.SUB-JOB-DOC-NO = VHSR03IW.SUB-JOB-DOC-NO;
    VHSR03D_DATA.JOB-NO = VHSR03IW.JOB-NO;
    VHSR03D_DATA.SUB-JOB-DOC-NO = VHSR03IW.SUB-JOB-DOC-NO;
    VHSR03D_DATA.TERM-LAST-UPD = VHSR03IW-PASSVALUE.TERM-LAST-UPD;
    VHSR03D_DATA.USER-GRP = VHSR03IW-PASSVALUE.USER-GRP;
    if (VHSR03IW.NARR-COUNT == 0)
        if (VHSR03IW.NARR == " ")
            VHSR03D_DATA.ADD-NARR-IND = "N";
            VHSR03D_DATA.NARR = " ";
        else
            VHSR03D_DATA.ADD-NARR-IND = "Y";
            VHSR03D_DATA.NARR = VHSR03IW.NARR;
        end
    else
        VHSR03D_DATA.ADD-NARR-IND = "N";
        VHSR03D_DATA.NARR = " ";
    end
    if (VHSR03IW.LOOP-INDEX >= 1)
        try
            call "VHSR03D"(XDCONTROL, VHSR03D_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHSR03IW.FINAL-MESSAGE = "Labor Details added.";
            VHSR03IS-RET-AFTDB(); 
  
  
            ENABLE-COMMENTS = "Y";
        else
            VHSR03IW.FINAL-MESSAGE = "Database access error. Records not added successfully.";
            DISABLE-ADDLABOR = "Y";
            DISABLE-CLOSEJOB = "Y";
            ENABLE-JOBLIST = "Y";
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
    VHSR03IW-TRIGGER.DESELECT-ALLCELLS = "Y";
end 

Function VHSR03IS-INIT ()
  
  

   
    AFT-NARR-SW = "N";
    set VHSR03D_DATA empty;
    try
        call "VHSRWEL"(XDCONTROL, VHSRWEL_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else

    end
    try
        call "VHSR03C"(XDCONTROL, VHSR03C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        set VHSR03IW empty;
        VHSR03IS-AFT-CHKST();
    else

    end
    DETAILS1-SETFOCUS = "Y";
    VHSR03IW.FINAL-MESSAGE = "Need to add more Repair, press RETURN";
end 

