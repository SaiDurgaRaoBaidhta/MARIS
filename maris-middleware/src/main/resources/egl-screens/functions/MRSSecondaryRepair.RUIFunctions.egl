    X = X + 1;
    VHSR03A_DATA-X.DATE-WORK[X] = VHSR03IW-INPUT.DATE-WORK-2;
    VHSR03A_DATA-X.EMPL-NO[X] = VHSR03IW-INPUT.EMPL-NO-2;
  
  
    VHSR03A_DATA-X.JOB-LABOR-DOC-NO[X] = VHSR03IW-INPUT.JOB-LABOR-DOC-NO-2;
  
  
    VHSR03A_DATA-X.REPR-LABOR-HRS[X] = VHSR03IW-INPUT.REPR-LABOR-HRS-2;
  
  
  
  
  
  
