    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF50A-ADDUPDT.DATE-LAST-REMOVED;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50A-ADDUPDT.DATE-LAST-REMOVED = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF50A-ADDUPDT.DATE-HUB-COUP-REPL;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50A-ADDUPDT.DATE-HUB-COUP-REPL = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF50A-ADDUPDT.DATE-CMPNT-EVALUAT;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50A-ADDUPDT.DATE-CMPNT-EVALUAT = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF50A-ADDUPDT.DATE-CMPNT-REPR;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50A-ADDUPDT.DATE-CMPNT-REPR = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF50A-ADDUPDT.DATE-CMPNT-REPR;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50A-ADDUPDT.DATE-CMPNT-REPR = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF50A-ADDUPDT.DATE-MAINT-UPD;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50A-ADDUPDT.DATE-MAINT-UPD = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF50A-ADDUPDT.DATE-LAST-UPD;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50A-ADDUPDT.DATE-LAST-UPD = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF50A-ADDUPDT.DATE-TRK-REMOVE;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50A-ADDUPDT.DATE-TRK-REMOVE = XXDATEW.DATE-YYYY-MM-DD;
end 

Function VHCF50IS_DT_CHK () 
    if (VHCF50A-ADDUPDT.DATE-AXLE == "          ")

    else
        if (VHCF50A-ADDUPDT.DATE-AXLE != VHCF50A_SELECTION.DATE-AXLE)
            VHCF50D_DATA.DATE-MAINT-UPD = VHCF50A-ADDUPDT.DATE-AXLE;
            VHCF50D_DATA.MARIS-SUBSYS = "BMTEST1";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF50D";
            try
                call "VHCF50D"(XDCONTROL, VHCF50D_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                VHCF50I_MESSAGE.MESG1 = "DATE AXLE NOT VALID";
            end
        end
    end
    if (VHCF50A-ADDUPDT.DATE-BUY-REBUILT == "          ")

    else
        if (VHCF50A-ADDUPDT.DATE-BUY-REBUILT != VHCF50A_SELECTION.DATE-BUY-REBUILT)
            VHCF50D_DATA.DATE-MAINT-UPD = VHCF50A-ADDUPDT.DATE-BUY-REBUILT;
            VHCF50D_DATA.MARIS-SUBSYS = "BMTEST1";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF50D";
            try
                call "VHCF50D"(XDCONTROL, VHCF50D_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                VHCF50I_MESSAGE.MESG1 = "DATE BUY REBUILT NOT VALID";
            end
        end
    end
    if (VHCF50A-ADDUPDT.DATE-INSTALLED == "          ")

    else
        if (VHCF50A-ADDUPDT.DATE-INSTALLED != VHCF50A_SELECTION.DATE-INSTALLED)
            VHCF50D_DATA.DATE-MAINT-UPD = VHCF50A-ADDUPDT.DATE-INSTALLED;
            VHCF50D_DATA.MARIS-SUBSYS = "BMTEST1";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF50D";
            try
                call "VHCF50D"(XDCONTROL, VHCF50D_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                VHCF50I_MESSAGE.MESG1 = "DATE INSTALLED NOT VALID";
            end
        end
    end
    if (VHCF50A-ADDUPDT.DATE-LAST-REMOVED == "          ")

    else
        if (VHCF50A-ADDUPDT.DATE-LAST-REMOVED != VHCF50A_SELECTION.DATE-LAST-REMOVED)
            VHCF50D_DATA.DATE-MAINT-UPD = VHCF50A-ADDUPDT.DATE-LAST-REMOVED;
            VHCF50D_DATA.MARIS-SUBSYS = "BMTEST1";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF50D";
            try
                call "VHCF50D"(XDCONTROL, VHCF50D_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                VHCF50I_MESSAGE.MESG1 = "DATE LAST REMOVED NOT VALID";
            end
        end
    end
    if (VHCF50A-ADDUPDT.DATE-HUB-COUP-REPL == "          ")

    else
        if (VHCF50A-ADDUPDT.DATE-HUB-COUP-REPL != VHCF50A_SELECTION.DATE-HUB-COUP-REPL)
            VHCF50D_DATA.DATE-MAINT-UPD = VHCF50A-ADDUPDT.DATE-HUB-COUP-REPL;
            VHCF50D_DATA.MARIS-SUBSYS = "BMTEST1";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF50D";
            try
                call "VHCF50D"(XDCONTROL, VHCF50D_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                VHCF50I_MESSAGE.MESG1 = "DATE HUB COUP REPL NOT VALID";
            end
        end
    end
    if (VHCF50A-ADDUPDT.DATE-CMPNT-EVALUAT == "          ")

    else
        if (VHCF50A-ADDUPDT.DATE-CMPNT-EVALUAT != VHCF50A_SELECTION.DATE-CMPNT-EVALUAT)
            VHCF50D_DATA.DATE-MAINT-UPD = VHCF50A-ADDUPDT.DATE-CMPNT-EVALUAT;
            VHCF50D_DATA.MARIS-SUBSYS = "BMTEST1";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF50D";
            try
                call "VHCF50D"(XDCONTROL, VHCF50D_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                VHCF50I_MESSAGE.MESG1 = "DATE CMPNT REPL NOT VALID";
            end
        end
    end
    if (VHCF50A-ADDUPDT.DATE-CMPNT-REPR == "          ")

    else
        if (VHCF50A-ADDUPDT.DATE-CMPNT-REPR != VHCF50A_SELECTION.DATE-CMPNT-REPR)
            VHCF50D_DATA.DATE-MAINT-UPD = VHCF50A-ADDUPDT.DATE-CMPNT-REPR;
            VHCF50D_DATA.MARIS-SUBSYS = "BMTEST1";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF50D";
            try
                call "VHCF50D"(XDCONTROL, VHCF50D_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                VHCF50I_MESSAGE.MESG1 = "DATE CMPNT REPL NOT VALID";
            end
        end
    end
    if (VHCF50A-ADDUPDT.DATE-TRK-REMOVE == "          ")

    else
        if (VHCF50A-ADDUPDT.DATE-TRK-REMOVE != VHCF50A_SELECTION.DATE-TRK-REMOVE)
            VHCF50D_DATA.DATE-MAINT-UPD = VHCF50A-ADDUPDT.DATE-TRK-REMOVE;
            VHCF50D_DATA.MARIS-SUBSYS = "BMTEST1";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF50D";
            try
                call "VHCF50D"(XDCONTROL, VHCF50D_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                VHCF50I_MESSAGE.MESG1 = "DATE TRK REMOVE NOT VALID";
            end
        end
    end
end 

