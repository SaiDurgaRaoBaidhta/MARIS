Function VHCF50IS_REFRESH () 
    VHCF50I-ADD.ADD-UPDT-1 = "REF";
    VHCF50I_MESSAGE.MESG1 = "                                                                   ";
    if (VHCF50I-ADD.ADD-UPDT == "VIEW")
        VHCF50IS_SELECT();
    else
        VHCF50IS_SELECT_R();
    end
end 

Function VHCF50IS_SAVE () 
    VHCF50I_MESSAGE.MESG1 = "                                                                   ";
    if (VHCF50A-ADDUPDT.STOCK-NO == " ")
        VHCF50I_MESSAGE.MESG1 = "Stock No required";
    end
    VHCF50IS-DATE-UPD();
    VHCF50IS_DT_CHK();
    if (VHCF50I_MESSAGE.MESG1 == "               ")
        move VHCF50A-ADDUPDT to VHCF50A_DATA withV60Compat;
        VHCF50A_CRIT.STOCK-NO = VHCF50A-ADDUPDT.STOCK-NO;
        VHCF50A_CRIT.CMPNT-SERIAL-NO = VHCF50A-ADDUPDT.CMPNT-SERIAL-NO;
        VHCF50A_DATA.COMMENTS = VHCF50IW-COMMENT.COMMENTS;
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF50A";
        try
            call "VHCF50A"(XDCONTROL, VHCF50A_CRIT, VHCF50A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF50I_MESSAGE.MESG1 = "UPDATE SUCCESSFUL";
        else
                             
              
              
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            VHCF50I_MESSAGE.MESG1 = "UPDATE FAILED";
        end
    end
end 

Function VHCF50IS_SELECT () 
    VHCF50I_MESSAGE.MESG1 = "                                                                   ";
    STOR-INDEX = 1;
    STOR-SELECTION = 0;
    STOR-SELECTION-L1 = 0;
    STOR-INDEX = 1;
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCF50A_SELECTION.DATA_ROW = VHCF49A_DATA.DATA_ROW[VHCF49I_SELECTION_Level77Items.SELECTION-IDX];
   
   
        VHCF50B_CRIT.YRD-INDEX = VHCF50A_SELECTION.HOME-YRD;
        while (STOR-INDEX <= VHCF50B_CRIT.COUNTER)
            if (VHCF50A_SELECTION.HOME-YRD ==
             VHCF50B_DATA.YRD[STOR-INDEX])
                VHCF50A_SELECTION_Level77Items.STOR-SELECTION = STOR-INDEX;
            end
            STOR-INDEX = STOR-INDEX + 1;
        end
    end
    STOR-INDEX-L1 = 1;
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCF50C_CRIT.YRD-INDEX = VHCF50A_SELECTION.SHOP-LOC;
        while (STOR-INDEX-L1 <= VHCF50C_CRIT.COUNTER-1)
            if (VHCF50A_SELECTION.SHOP-LOC ==
             VHCF50C_DATA.YRD[STOR-INDEX-L1])
                VHCF50A_SELECTION_Level77Items.STOR-SELECTION-L1 = STOR-INDEX-L1;
            end
            STOR-INDEX-L1 = STOR-INDEX-L1 + 1;
        end
    end
    STOR-INDEX-C = 1;
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCF50E_CRIT.CMPNT-INDEX = VHCF50A_SELECTION.CONFIG-STAT;
        while (STOR-INDEX-C <= VHCF50E_CRIT.COUNTER)
            if (VHCF50A_SELECTION.CONFIG-STAT ==
             VHCF50E_DATA.CONFIG-CMPNT-STAT[STOR-INDEX-C])
                VHCF50A_SELECTION_Level77Items.STOR-SELECTION-C = STOR-INDEX-C;
            end
            STOR-INDEX-C = STOR-INDEX-C + 1;
        end
    end
    STOR-INDEX-F = 1;
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCF50F_CRIT.STAT-INDEX = VHCF50A_SELECTION.SERIAL-STAT;
        while (STOR-INDEX-F <= VHCF50F_CRIT.COUNTER)
            if (VHCF50A_SELECTION.SERIAL-STAT ==
             VHCF50F_DATA.SERIAL-STAT[STOR-INDEX-F])
                VHCF50A_SELECTION_Level77Items.STOR-SELECTION-F = STOR-INDEX-F;
            end
            STOR-INDEX-F = STOR-INDEX-F + 1;
        end
    end
    STOR-INDEX-G = 1;
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCF50G_CRIT.G-INDEX = VHCF50A_SELECTION.CMPNT-EQUIP-TYPE;
        while (STOR-INDEX-G <= VHCF50G_CRIT.COUNTER)
            if (VHCF50A_SELECTION.CMPNT-EQUIP-TYPE ==
             VHCF50G_DATA.CMPNT-EQUIP-TYPE[STOR-INDEX-G])
                VHCF50A_SELECTION_Level77Items.STOR-SELECTION-G = STOR-INDEX-G;
            end
            STOR-INDEX-G = STOR-INDEX-G + 1;
        end
    end
    STOR-INDEX-H = 1;
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCF50H_CRIT.H-INDEX = VHCF50A_SELECTION.PARENT-EQUIP-TYPE;
        while (STOR-INDEX-H <= VHCF50H_CRIT.COUNTER)
            if (VHCF50A_SELECTION.PARENT-EQUIP-TYPE ==
             VHCF50H_DATA.CMPNT-EQUIP-TYPE[STOR-INDEX-H])
                VHCF50A_SELECTION_Level77Items.STOR-SELECTION-H = STOR-INDEX-H;
            end
            STOR-INDEX-H = STOR-INDEX-H + 1;
        end
    end
    STOR-INDEX-J = 1;
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCF50J_CRIT.J-INDEX = VHCF50A_SELECTION.POSN-CD;
        while (STOR-INDEX-J <= VHCF50J_CRIT.COUNTER)
            if (VHCF50A_SELECTION.POSN-CD ==
             VHCF50J_DATA.POSN-CD[STOR-INDEX-J])
                VHCF50A_SELECTION_Level77Items.STOR-SELECTION-J = STOR-INDEX-J;
            end
            STOR-INDEX-J = STOR-INDEX-J + 1;
        end
    end
    STOR-INDEX-K = 1;
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCF50K_CRIT.K-INDEX = VHCF50A_SELECTION.PARENT-POSN-CD;
        while (STOR-INDEX-K <= VHCF50K_CRIT.COUNTER)
            if (VHCF50A_SELECTION.PARENT-POSN-CD ==
             VHCF50K_DATA.POSN-CD[STOR-INDEX-K])
                VHCF50A_SELECTION_Level77Items.STOR-SELECTION-K = STOR-INDEX-K;
            end
            STOR-INDEX-K = STOR-INDEX-K + 1;
        end
    end
    STOR-INDEX-L = 1;
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCF50L_CRIT.L-INDEX = VHCF50A_SELECTION.CMPNT-TRACKING-CD;
        while (STOR-INDEX-L <= VHCF50L_CRIT.COUNTER)
            if (VHCF50A_SELECTION.CMPNT-TRACKING-CD ==
             VHCF50L_DATA.CMPNT-TRACKING-CD[STOR-INDEX-L])
                VHCF50A_SELECTION_Level77Items.STOR-SELECTION-L = STOR-INDEX-L;
            end
            STOR-INDEX-L = STOR-INDEX-L + 1;
        end
    end
    STOR-INDEX-M = 1;
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCF50M_CRIT.M-INDEX = VHCF50A_SELECTION.PARENT-STOCK-NO;
        while (STOR-INDEX-M <= VHCF50M_CRIT.COUNTER)
            if (VHCF50A_SELECTION.PARENT-STOCK-NO ==
             VHCF50M_DATA.STOCK-NO[STOR-INDEX-M])
                VHCF50A_SELECTION_Level77Items.STOR-SELECTION-M = STOR-INDEX-M;
            end
            STOR-INDEX-M = STOR-INDEX-M + 1;
        end
    end


  
    if (VHCF50I-ADD.ADD-UPDT == "UPDATE")
     
        VHCF50IW-TRIGGER.ENABLE-SAVE = "Y";
        VHCF50IW-TRIGGER.DISABLE-SAVE = " ";
    else
        set VHCF50A_DATA empty;
    end
    VHCF50IW-TRIGGER.DISABLE-STK-NO = "Y";
    VHCF50IW-TRIGGER.DISABLE-CMP-SER = "Y";
    VHCF50I-ADD.ADD-UPDT-1 = "       ";
    VHCF50IS-DATE();
    VHCF50IS-COMMENT();
end 

Function VHCF50IS_SELECT_R () 
    if (VHCF50I-ADD.ADD-UPDT-1 == "REF")
        if (VHCF50I-ADD.ADD-UPDT == "UPDATE")
        
            VHCF50A_SELECTION.STOCK-NO = VHCF50A-ADDUPDT.STOCK-NO;
            VHCF50A_SELECTION.HOME-YRD = VHCF50A-ADDUPDT.HOME-YRD;
            VHCF50A_SELECTION.CAR-NO = VHCF50A-ADDUPDT.CAR-NO;
            VHCF50A_SELECTION.CAR-NO-PREV = VHCF50A-ADDUPDT.CAR-NO-PREV;
            VHCF50A_SELECTION.CMPNT-EQUIP-TYPE = VHCF50A-ADDUPDT.CMPNT-EQUIP-TYPE;
            VHCF50A_SELECTION.CMPNT-TRACKING-CD = VHCF50A-ADDUPDT.CMPNT-TRACKING-CD;
            VHCF50A_SELECTION.CMPNT-SERIAL-NO = VHCF50A-ADDUPDT.CMPNT-SERIAL-NO;
            VHCF50A_SELECTION.DATE-AXLE = VHCF50A-ADDUPDT.DATE-AXLE;
            VHCF50A_SELECTION.DATE-BUY-REBUILT = VHCF50A-ADDUPDT.DATE-BUY-REBUILT;
            VHCF50A_SELECTION.DATE-INSTALLED = VHCF50A-ADDUPDT.DATE-INSTALLED;
            VHCF50A_SELECTION.DATE-LAST-REMOVED = VHCF50A-ADDUPDT.DATE-LAST-REMOVED;
            VHCF50A_SELECTION.EMPL-NO = VHCF50A-ADDUPDT.EMPL-NO;
            VHCF50A_SELECTION.LAST-REMOVED-BY = VHCF50A-ADDUPDT.LAST-REMOVED-BY;
            VHCF50A_SELECTION.PARENT-EQUIP-TYPE = VHCF50A-ADDUPDT.PARENT-EQUIP-TYPE;
            VHCF50A_SELECTION.PARENT-POSN-CD = VHCF50A-ADDUPDT.PARENT-POSN-CD;
            VHCF50A_SELECTION.PARENT-SERIAL-NO = VHCF50A-ADDUPDT.PARENT-SERIAL-NO;
            VHCF50A_SELECTION.PARENT-STOCK-NO = VHCF50A-ADDUPDT.PARENT-STOCK-NO;
            VHCF50A_SELECTION.POSN-CD = VHCF50A-ADDUPDT.POSN-CD;
            VHCF50A_SELECTION.SERIAL-CONFIGD-IND = VHCF50A-ADDUPDT.SERIAL-CONFIGD-IND;
            VHCF50A_SELECTION.SERIAL-STAT = VHCF50A-ADDUPDT.SERIAL-STAT;
            VHCF50A_SELECTION.SHOP-LOC = VHCF50A-ADDUPDT.SHOP-LOC;
            VHCF50A_SELECTION.DATE-HUB-COUP-REPL = VHCF50A-ADDUPDT.DATE-HUB-COUP-REPL;
            VHCF50A_SELECTION.SEC-CMPNT-STAT = VHCF50A-ADDUPDT.SEC-CMPNT-STAT;
            VHCF50A_SELECTION.CMPNT-FAILURE-CD = VHCF50A-ADDUPDT.CMPNT-FAILURE-CD;
            VHCF50A_SELECTION.JOB-NO = VHCF50A-ADDUPDT.JOB-NO;
            VHCF50A_SELECTION.SUB-JOB-DOC-NO = VHCF50A-ADDUPDT.SUB-JOB-DOC-NO;
            VHCF50A_SELECTION.ARMATURE-NO = VHCF50A-ADDUPDT.ARMATURE-NO;
            VHCF50A_SELECTION.DATE-CMPNT-EVALUAT = VHCF50A-ADDUPDT.DATE-CMPNT-EVALUAT;
            VHCF50A_SELECTION.DATE-CMPNT-REPR = VHCF50A-ADDUPDT.DATE-CMPNT-REPR;
        end
    end
end 

Function VHCF51IS_CLEAR () 
    VHCF51I_PASSVALUE.STOCK-NO = "         ";
    VHCF51I_PASSVALUE.CMPNT-SERIAL-NO = "            ";
    set VHCF51I_PASSVALUE empty;
    set VHCF51I_SELECTION empty;
    if (VHCF51I_TRIGGER.UP-TRIGGER == "Y")
        VHCF51I_TRIGGER.UP-TRIGGER = "   ";
    else
        set VHCF51I_MESSAGE empty;
    end
    ENABLE-KEY = "Y";
    ENABLE-CLEAR = "Y";
    DISABLE-UPDATE = "Y";
end 

Function VHCF51IS_INIT ()
   
    set VHCF51A_DATA empty;
    set VHCF51I_PASSVALUE empty;
    set VHCF51I_SELECTION empty;
    if (VHCF49I-TRIGGER.FROM-GUI == "MRS14I")
        VHCF49I-TRIGGER.ENABLE-UPDT = "Y";
    else
        VHCF49I-TRIGGER.DISABLE-UPDT = "Y";
    end

  


  

  
  

  
  
  
  
  
  
  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF51A";
    try
        call "VHCF51A"(XDCONTROL, VHCF51A_CRIT, VHCF51A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF51A_CRIT.COUNTER = UROWCNT;
    else
        VHCF51I_MESSAGE.MESG1 = "NO DATA FOUND FOR SELECTED CRITERIA";
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    set VHCF51I_PASSVALUE empty;
    if (VHCF51I_TRIGGER.UP-TRIGGER == " ")
        set VHCF51I_MESSAGE empty;
    end
    ENABLE-CLEAR = "Y";
    DISABLE-UPDATE = "Y";
    ENABLE-ADD = "Y";
    STK-DISABLE = "Y";
    CMPNT-DISABLE = "Y";
end 

Function VHCF51IS_SELECT () 
    if (VHCF51I_TRIGGER.MSG-TRIGGER == "Y")

    else
        set VHCF51I_MESSAGE empty;
    end
    if (SELECTION-IDX > 0)
        VHCF51I_SELECTION.DATA_ROW = VHCF51A_DATA.DATA_ROW[SELECTION-IDX];
    end
    DISABLE-ADD = "Y";
    DISABLE-KEY = "Y";
    ENABLE-UPDATE = "Y";
    
    ENABLE-CLEAR = "Y";
    STK-DISABLE = "Y";
    CMPNT-DISABLE = "Y";
end 

Function VHCF51IS_UPDATE ()
   
    if (VHCF51I_PASSVALUE.DATE-HRS-POSTED != " ")
        XXDATEW.DATE-MM-DD-YYYY = VHCF51I_PASSVALUE.DATE-HRS-POSTED;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHCF51B_DATA.DT-CONV-1 = XXDATEW.DATE-YYYY-MM-DD;
        VHCF51B_DATA.DT-FILLER1-1 = "-";
        VHCF51B_DATA.DT-FILLER2-1 = "-";
        VHCF51I_PASSVALUE.DATE-HRS-POSTED = VHCF51B_DATA.DT-CONV-1;
        AFCXVLD_CRIT.FORM-DATE = VHCF51I_PASSVALUE.DATE-HRS-POSTED;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHCF51IW.INVALID-TO-DATE = "Y";
            ENABLE-UPDATE = "N";
            VHCF51I_MESSAGE.MESG1 = "INVALID DATE HRS POSTED";
            return;
  
  
  
  
  
  
        else
            if (AFCXVLDW.NO-ERROR == "Y")

            end
        end
  
    end
    VHCF51B_CRIT.STOCK-NO = VHCF51I_PASSVALUE.STOCK-NO;
    VHCF51B_CRIT.CMPNT-SERIAL-NO = VHCF51I_PASSVALUE.CMPNT-SERIAL-NO;
    VHCF51B_DATA.STOCK-NO = VHCF51I_PASSVALUE.STOCK-NO;
    VHCF51B_DATA.CMPNT-SERIAL-NO = VHCF51I_PASSVALUE.CMPNT-SERIAL-NO;
    VHCF51B_DATA.CMPNT-CUM-HRS = VHCF51I_PASSVALUE.CMPNT-CUM-HRS;
    VHCF51B_DATA.CMPNT-CUM-MIN = VHCF51I_PASSVALUE.CMPNT-CUM-MIN;
    VHCF51B_DATA.DATE-HRS-POSTED = VHCF51I_PASSVALUE.DATE-HRS-POSTED;
    VHCF51B_DATA.TERM-LAST-UPD = VHCF51I_PASSVALUE.TERM-LAST-UPD;
    VHCF51B_DATA.TERM-MAINT-UPD = VHCF51I_PASSVALUE.TERM-MAINT-UPD;
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF51B";
    try
        call "VHCF51B"(XDCONTROL, VHCF51B_CRIT, VHCF51B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF51I_TRIGGER.MSG-TRIGGER = "Y";
        VHCF51I_MESSAGE.MESG1 = "UPDATE SUCCESFUL";
    else
                             
            
            
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        VHCF51I_MESSAGE.MESG1 = "UPDATE ERROR";
        VHCF51I_TRIGGER.MSG-TRIGGER = "N";
    end
  
      
  
  
  
  
   
   
    
  
    VHCF51I_TRIGGER.MSG-TRIGGER = "Y";
    ENABLE-CLEAR = "Y";
    DISABLE-UPDATE = "Y";
    ENABLE-ADD = "Y";
    STK-DISABLE = "Y";
    CMPNT-DISABLE = "Y";
    UP-TRIGGER = "Y";
end 

Function VHCF52IS_CLEAR () 
    VHCF52I_PASSVALUE.STOCK-NO = "         ";
    VHCF52I_PASSVALUE.CMPNT-SERIAL-NO = "            ";
    set VHCF52I_PASSVALUE empty;
    set VHCF52I_SELECTION empty;
    if (VHCF52I_TRIGGER.UP-TRIGGER == "Y")
        VHCF52I_TRIGGER.UP-TRIGGER = "   ";
    else
        set VHCF52I_MESSAGE empty;
    end
    ENABLE-KEY = "Y";
    ENABLE-CLEAR = "Y";
    DISABLE-UPDATE = "Y";
end 

Function VHCF52IS_INIT ()
   
    set VHCF52A_DATA empty;
    set VHCF52I_PASSVALUE empty;
    set VHCF52I_SELECTION empty;
    if (VHCF49I-TRIGGER.FROM-GUI == "MRS14I")
        VHCF49I-TRIGGER.ENABLE-UPDT = "Y";
        VHCF52A_CRIT.DIVIDE-SW = "0";
    else
        VHCF49I-TRIGGER.DISABLE-UPDT = "Y";
        VHCF52A_CRIT.DIVIDE-SW = "1";
    end

  

  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF52C";
    try
        call "VHCF52C"(XDCONTROL, VHCF52C_CRIT, VHCF52C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF52C_CRIT.COUNTER-1 = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF52A";
    try
        call "VHCF52A"(XDCONTROL, VHCF52A_CRIT, VHCF52A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if (UROWCNT < 130)
            VHCF52A_CRIT.COUNTER = UROWCNT;
            set VHCF52I_MESSAGE empty;
        else
            VHCF52A_CRIT.COUNTER = UROWCNT;
            VHCF52I_MESSAGE.MESG1 = "MORE THAN 130 ROWS FOR SELECTED CRITERIA";
        end
    else
        VHCF52I_MESSAGE.MESG1 = "NO DATA FOUND FOR SELECTED CRITERIA";
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    set VHCF52I_PASSVALUE empty;
  
  
  
    ENABLE-CLEAR = "Y";
    DISABLE-UPDATE = "Y";
    ENABLE-ADD = "Y";
    STK-DISABLE = "Y";
    CMPNT-DISABLE = "Y";
end 

Function VHCF52IS_SELECT () 
    if (VHCF52I_TRIGGER.MSG-TRIGGER == "Y")

    else
        set VHCF52I_MESSAGE empty;
    end
    if (SELECTION-IDX > 0)
        VHCF52I_SELECTION.DATA_ROW = VHCF52A_DATA.DATA_ROW[SELECTION-IDX];
        STOR-INDEX-L1 = 1;
        VHCF52C_CRIT.YRD-INDEX = VHCF52I_SELECTION.LOC;
        while (STOR-INDEX-L1 <= VHCF52C_CRIT.COUNTER-1)
            if (VHCF52I_SELECTION.LOC ==
             VHCF52C_DATA.YRD[STOR-INDEX-L1])
                VHCF52I_PASSVALUE.STOR-SELECTION = STOR-INDEX-L1;
            end
            STOR-INDEX-L1 = STOR-INDEX-L1 + 1;
        end
    end
 
  
  
  
  
  
  
  
  
  
  
    DISABLE-ADD = "Y";
    DISABLE-KEY = "Y";
    ENABLE-UPDATE = "Y";
    
    ENABLE-CLEAR = "Y";
    STK-DISABLE = "Y";
    CMPNT-DISABLE = "Y";
end 

Function VHCF52IS_UPDATE ()
   
    if (VHCF52I_PASSVALUE.DATE-MEASURED != " ")
        XXDATEW.DATE-MM-DD-YYYY = VHCF52I_PASSVALUE.DATE-MEASURED;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHCF52B_DATA.DT-CONV-1 = XXDATEW.DATE-YYYY-MM-DD;
        VHCF52B_DATA.DT-FILLER1-1 = "-";
        VHCF52B_DATA.DT-FILLER2-1 = "-";
        VHCF52I_PASSVALUE.DATE-MEASURED = VHCF52B_DATA.DT-CONV-1;
        AFCXVLD_CRIT.FORM-DATE = VHCF52I_PASSVALUE.DATE-MEASURED;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHCF52IW.INVALID-TO-DATE = "Y";
            ENABLE-UPDATE = "N";
            VHCF52I_MESSAGE.MESG1 = "INVALID DATE HRS POSTED";
            return;
  
  
  
  
  
  
        else
            if (AFCXVLDW.NO-ERROR == "Y")

            end
        end
  
    end
    VHCF52B_CRIT.STOCK-NO = VHCF52I_PASSVALUE.STOCK-NO;
    VHCF52B_CRIT.CMPNT-SERIAL-NO = VHCF52I_PASSVALUE.CMPNT-SERIAL-NO;
    VHCF52B_DATA.GEO-DATA-NAME = VHCF52I_PASSVALUE.GEO-DATA-NAME;
    VHCF52B_DATA.MEASURED-BY = VHCF52I_PASSVALUE.MEASURED-BY;
    VHCF52B_DATA.TIME-MEASURED = VHCF52I_PASSVALUE.TIME-MEASURED;
    VHCF52B_DATA.MEASUREMENT = VHCF52I_PASSVALUE.MEASUREMENT;
    VHCF52B_DATA.INSPECTOR-EMPL-NO = VHCF52I_PASSVALUE.INSPECTOR-EMPL-NO;
    VHCF52B_DATA.LOC = VHCF52I_PASSVALUE.LOC;
    VHCF52B_DATA.POSN-CD = VHCF52I_PASSVALUE.POSN-CD;
    VHCF52B_DATA.CAR-NO = VHCF52I_PASSVALUE.CAR-NO;
    VHCF52B_DATA.DATE-MEASURED = VHCF52I_PASSVALUE.DATE-MEASURED;
    VHCF52B_DATA.TERM-LAST-UPD = VHCF52I_PASSVALUE.TERM-LAST-UPD;
    VHCF52B_DATA.TERM-MAINT-UPD = VHCF52I_PASSVALUE.TERM-MAINT-UPD;
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF52B";
    try
        call "VHCF52B"(XDCONTROL, VHCF52B_CRIT, VHCF52B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF52I_TRIGGER.MSG-TRIGGER = "Y";
        VHCF52I_MESSAGE.MESG1 = "UPDATE SUCCESFUL";
    else
                             
            
            
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        VHCF52I_MESSAGE.MESG1 = "UPDATE ERROR";
        VHCF52I_TRIGGER.MSG-TRIGGER = "N";
    end
  
      
  
  
  
  
   
   
    
  
    VHCF52I_TRIGGER.MSG-TRIGGER = "Y";
    ENABLE-CLEAR = "Y";
    DISABLE-UPDATE = "Y";
    ENABLE-ADD = "Y";
    STK-DISABLE = "Y";
    CMPNT-DISABLE = "Y";
    UP-TRIGGER = "Y";
end
