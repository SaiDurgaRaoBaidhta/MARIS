

package MRSTableMaintenanceApp3;


Function SERIAL-GEO-DAT () 
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX == 0)
        VHCF52A_CRIT.FR-STOCK-NO = "AAAAAAAAA";
        VHCF52A_CRIT.TO-STOCK-NO = "999999999";
        VHCF52A_CRIT.FR-SERIAL-NO = "AAAAAAAAAAAA";
        VHCF52A_CRIT.TO-SERIAL-NO = "999999999999";
    else
        VHCF52A_CRIT.FR-STOCK-NO = VHCF49A_DATA.STOCK-NO[SELECTION-IDX];
        VHCF52A_CRIT.TO-STOCK-NO = VHCF49A_DATA.STOCK-NO[SELECTION-IDX];
        VHCF52A_CRIT.FR-SERIAL-NO = VHCF49A_DATA.CMPNT-SERIAL-NO[SELECTION-IDX];
        VHCF52A_CRIT.TO-SERIAL-NO = VHCF49A_DATA.CMPNT-SERIAL-NO[SELECTION-IDX];
    end
end 

Function SERIAL-NO-HRS ()
  
  
  
  
  
   
    if (VHCF49I_SELECTION_Level77Items.SELECTION-IDX == 0)
        VHCF51A_CRIT.FR-STOCK-NO = "AAAAAAAAA";
        VHCF51A_CRIT.TO-STOCK-NO = "999999999";
        VHCF51A_CRIT.FR-SERIAL-NO = "AAAAAAAAAAAA";
        VHCF51A_CRIT.TO-SERIAL-NO = "999999999999";
    else
        VHCF51A_CRIT.FR-STOCK-NO = VHCF49A_DATA.STOCK-NO[SELECTION-IDX];
        VHCF51A_CRIT.TO-STOCK-NO = VHCF49A_DATA.STOCK-NO[SELECTION-IDX];
        VHCF51A_CRIT.FR-SERIAL-NO = VHCF49A_DATA.CMPNT-SERIAL-NO[SELECTION-IDX];
        VHCF51A_CRIT.TO-SERIAL-NO = VHCF49A_DATA.CMPNT-SERIAL-NO[SELECTION-IDX];
    end
end 

Function VHCCS49I_CLEAR () 
    VHCF49I_SELECTION_Level77Items.SELECTION-IDX = 0;
    set VHCF49A_DATA empty;
    set VHCF49I_MESSAGE empty;
    set VHCF49I_PASSVALUE empty;
    set VHCF49I_SELECTION empty;
    VHCF49IW_TRIGGER.LOAD = "Y";
    VHCF49IW_CRIT.STOCK-NO = "        ";
    VHCF49IW_CRIT.STOCK-SHORT-DESC = "        ";
    VHCF49IW_CRIT.CMPNT-EQUIP-TYPE = "        ";
    VHCF49IW_CRIT.CMPNT-SERIAL-NO = "        ";
    VHCF49IW_CRIT.CAR-NO = "  ";
    VHCF49IW.TO-TIME = "        ";
    VHCF49I_MESSAGE.MESG1 = "                                                                                           ";
    ENABLE-KEY = "Y";
    ENABLE-ADD = "Y";
    ENABLE-CLEAR = "Y";
    DISABLE-UPDATE = "Y";
end 

Function VHCCS49I_DELETE ()
   
    if (SELECTION-IDX == 0)
        VHCF49I_MESSAGE.MESG1 = "PLEASE SELECT AN ROW";
    else
        if (VHCF49I_PASSVALUE.STOCK-NO == " ")
            VHCF49I_MESSAGE.MESG1 = "Stock No  invalid ";
        else
            VHCF49D_CRIT.STOCK-NO = VHCF49I_PASSVALUE.STOCK-NO;
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF49D";
            try
                call "VHCF49D"(XDCONTROL, VHCF49D_CRIT);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHCF49IW_TRIGGER.MSG-TRIGGER = "Y";
                VHCF49I_MESSAGE.MESG1 = "Delete Successful ";
            else
                   
       
        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                VHCF49I_MESSAGE.MESG1 = "Delete Error ";
            end
            
  
        end
    end
end 

Function VHCCS49I_INIT () 
    if (VHCF49IW-PASSVALUE.VHMEN-MENU == "VHMEN")
        VHCF49IW-TRIGGER-X.HIDE-UPD = "Y";
    else
        VHCF49IW-TRIGGER-X.SHOW-UPD = "Y";
    end
    set VHCF49A_DATA empty;
    set VHCF49I_PASSVALUE empty;
    if (VHCF49I-TRIGGER.FROM-GUI == "MRS14I")
        VHCF49IW-TRIGGER-X.ENABLE-UPD = "Y";
    else
        VHCF49IW-TRIGGER-X.DISABLE-UPD = "Y";
    end

  

  
  
  
  
  
  
  
  
  
  
  
  
  


  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF49B";
    try
        call "VHCF49B"(XDCONTROL, VHCF49B_CRIT, VHCF49B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF49B_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    VHCF49IW_CRIT.WK-DATE = VGVar.currentShortGregorianDate;
    VHCF49IW_CRIT.FROM-DATE-FILLER1 = "-";
    VHCF49IW_CRIT.FROM-DATE-FILLER2 = "-";
    WK-YY1 = "20";
    move WK-DATE-YR to WK-YY2 withV60Compat;
    VHCF49IW_CRIT.FROM-DATE-MO = WK-DATE-MO;
    VHCF49IW_CRIT.FROM-DATE-DAY = WK-DATE-DY;
    VHCF49IW_CRIT.FROM-DATE-YEAR = WK-DATE-YR4;
end 

Function VHCCS49I_LIST () 
    set VHCF49I_PASSVALUE empty;
    set VHCF49I_SELECTION empty;
    VHCF49I_SELECTION_Level77Items.SELECTION-IDX = 0;
    set VHCF49A_DATA empty;
    VHCF49I_MESSAGE.MESG1 = "                                                                          ";
    VHCF49I_MESSAGE.MESG3 = "                                                                          ";
    if (VHCF49IW_CRIT.CAR-NO != "    ")
        VHCF49E_CRIT.CAR-NO = VHCF49IW_CRIT.CAR-NO;
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF49E";
        try
            call "VHCF49E"(XDCONTROL, VHCF49E_CRIT, VHCF49E_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF49A_CRIT.COUNTER = UROWCNT;
            VHCF49I_MESSAGE.MESG1 = "                                                                   ";
        else
            VHCF49I_MESSAGE.MESG1 = "CAR NUMBER DOES NOT EXITS";
            ENABLE-ADD = "N";
            return;
    
        
         
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end


  
    if (VHCF49IW_CRIT.CAR-NO == "    ")
        VHCF49A_CRIT.CAR-NO-FR = "   ";
        VHCF49A_CRIT.CAR-NO-TO = "9999";
    else
        VHCF49A_CRIT.CAR-NO-FR = VHCF49IW_CRIT.CAR-NO;
        VHCF49A_CRIT.CAR-NO-TO = VHCF49IW_CRIT.CAR-NO;
    end
    if (VHCF49IW_CRIT.STOCK-NO == "ALL" ||
     VHCF49IW_CRIT.STOCK-NO == "         ")
        VHCF49A_CRIT.FR-STOCK-NO = "          ";
        VHCF49A_CRIT.TO-STOCK-NO = "999999999";
    else
        VHCF49A_CRIT.FR-STOCK-NO = VHCF49IW_CRIT.STOCK-NO;
        VHCF49A_CRIT.TO-STOCK-NO = VHCF49IW_CRIT.STOCK-NO;
    end
    if (VHCF49IW_CRIT.CMPNT-SERIAL-NO == "            ")
        VHCF49A_CRIT.FR-SERIAL-NO = "            ";
        VHCF49A_CRIT.TO-SERIAL-NO = "999999999999";
    else
        VHCF49A_CRIT.FR-SERIAL-NO = VHCF49IW_CRIT.CMPNT-SERIAL-NO;
        VHCF49A_CRIT.TO-SERIAL-NO = VHCF49IW_CRIT.CMPNT-SERIAL-NO;
    end
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF49A";
    try
        call "VHCF49A"(XDCONTROL, VHCF49A_CRIT, VHCF49A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if (UROWCNT < 90)
            VHCF49A_CRIT.COUNTER = UROWCNT;
            VHCF49IW_TRIGGER.LOAD = "Y";
            VHCF49I_MESSAGE.MESG1 = "                                                                   ";
        else
            VHCF49A_CRIT.COUNTER = UROWCNT;
            VHCF49IW_TRIGGER.LOAD = "Y";
            VHCF49I_MESSAGE.MESG1 = "MORE THAN 90 ROWS FOR SELECTED CRITERIA";
        end
    else
        VHCF49IW_TRIGGER.LOAD = "Y";
        VHCF49I_MESSAGE.MESG1 = " NO DATA FOUND FOR SELECTED CRITERIA    ";
        ENABLE-ADD = "N";
        return;
    
        
         
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHCCS49I_SELECT () 
    VHCF49I_MESSAGE.MESG1 = "                                                                   ";

  
  
    SELECTION-IDX = VHCF49I_PASSVALUE.SELECTION-INDEX;
    if (SELECTION-IDX > 0)
        VHCF49I_SELECTION.DATA_ROW = VHCF49A_DATA.DATA_ROW[SELECTION-IDX];
        
  
   
    end
end 

Function VHCCS49I_UPDATE ()
   
    if (SELECTION-IDX == 0)
        VHCF49I_MESSAGE.MESG1 = "PLEASE SELECT AN ROW";
    else
        VHCF50I-ADD.ADD-UPDT = "UPDATE";
    end
end 

Function VHCCS49I_VIEW () 
    if (SELECTION-IDX == 0)
        VHCF49I_MESSAGE.MESG1 = "PLEASE SELECT AN ROW";
    else
        VHCF50I-ADD.ADD-UPDT = "VIEW";
    end
end 

Function VHCF50IS-COMMENT () 
    VHCF50IW-COMMENT.COMMENTS = " ";
    VHCF50I_CRIT.STOCK-NO = VHCF50A_SELECTION.STOCK-NO;
    VHCF50I_CRIT.CMPNT-SERIAL-NO = VHCF50A_SELECTION.CMPNT-SERIAL-NO;
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF50I";
    try
        call "VHCF50I"(XDCONTROL, VHCF50I_CRIT, VHCF50I_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF50IW-COMMENT.COMMENTS = VHCF50I_DATA.COMMENTS;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHCF50IS-DATE () 
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCF50A_SELECTION.DATE-AXLE;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50IW-DATE.DATE-AXLE = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCF50A_SELECTION.DATE-BUY-REBUILT;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50IW-DATE.DATE-BUY-REBUILT = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCF50A_SELECTION.DATE-INSTALLED;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50IW-DATE.DATE-INSTALLED = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCF50A_SELECTION.DATE-LAST-REMOVED;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50IW-DATE.DATE-LAST-REMOVED = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCF50A_SELECTION.DATE-LAST-UPD;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50IW-DATE.DATE-LAST-UPD = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCF50A_SELECTION.DATE-MAINT-UPD;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50IW-DATE.DATE-MAINT-UPD = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCF50A_SELECTION.DATE-HUB-COUP-REPL;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50IW-DATE.DATE-HUB-COUP-REPL = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCF50A_SELECTION.DATE-CMPNT-EVALUAT;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50IW-DATE.DATE-CMPNT-EVALUAT = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCF50A_SELECTION.DATE-CMPNT-REPR;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50IW-DATE.DATE-CMPNT-REPR = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCF50A_SELECTION.DATE-TRK-REMOVE;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50IW-DATE.DATE-TRK-REMOVE = XXDATEW.DATE-MM-DD-YYYY;
end 

Function VHCF50IS-DATE-UPD () 
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF50A-ADDUPDT.DATE-AXLE;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50A-ADDUPDT.DATE-AXLE = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF50A-ADDUPDT.DATE-BUY-REBUILT;
    MRSCommonCode.XXDATES-CONVERT();
    VHCF50A-ADDUPDT.DATE-BUY-REBUILT = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHCF50A-ADDUPDT.DATE-INSTALLED;
    MRSCommonCode.XXDATES-CONVERT();
