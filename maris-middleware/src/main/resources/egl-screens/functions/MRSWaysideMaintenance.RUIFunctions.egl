end 

Function WS17IS-CLEAR () 
    WS17IW-PASSVALUE.STOCK-DESCRIPTION = "       ";
    set WS17A05_DATA empty;
    set XDCONTROL empty;
    set WS17A05_CRIT empty;
    XDCONTROL.UROWCNT = 0;
    WS17IW-TRIGGER.HAS-LOADED = "Y";
end 

Function WS17IS-REFORMAT () 
    WS17IW-TRIGGER.VAGen_INDEX = 10;
    WS17IW-PASSVALUE.STOCK-DESC-2[1] = WS17IW-PASSVALUE.STOCK-DESCRIPTION-1;
    WS17IW-PASSVALUE.STOCK-DESC-2[2] = WS17IW-PASSVALUE.STOCK-DESCRIPTION-2;
    WS17IW-PASSVALUE.STOCK-DESC-2[3] = WS17IW-PASSVALUE.STOCK-DESCRIPTION-3;
    WS17IW-PASSVALUE.STOCK-DESC-2[4] = WS17IW-PASSVALUE.STOCK-DESCRIPTION-4;
    WS17IW-PASSVALUE.STOCK-DESC-2[5] = WS17IW-PASSVALUE.STOCK-DESCRIPTION-5;
    WS17IW-PASSVALUE.STOCK-DESC-2[6] = WS17IW-PASSVALUE.STOCK-DESCRIPTION-6;
    WS17IW-PASSVALUE.STOCK-DESC-2[7] = WS17IW-PASSVALUE.STOCK-DESCRIPTION-7;
    WS17IW-PASSVALUE.STOCK-DESC-2[8] = WS17IW-PASSVALUE.STOCK-DESCRIPTION-8;
    WS17IW-PASSVALUE.STOCK-DESC-2[9] = WS17IW-PASSVALUE.STOCK-DESCRIPTION-9;
    WS17IW-PASSVALUE.STOCK-DESC-2[10] = WS17IW-PASSVALUE.STOCK-DESCRIPTION-10;
    while ((WS17IW-TRIGGER.VAGen_INDEX <= 10 && WS17IW-TRIGGER.VAGen_INDEX > 0) && (WS17IW-PASSVALUE.STOCK-DESC-2[VAGen_INDEX] == " "))
        if (WS17IW-PASSVALUE.STOCK-DESC-2[VAGen_INDEX] == " ")
            WS17IW-PASSVALUE.STOCK-DESC-2[VAGen_INDEX] = "%";
        end
        WS17IW-TRIGGER.VAGen_INDEX = WS17IW-TRIGGER.VAGen_INDEX - 1;
    end
    WS17IW-PASSVALUE.STOCK-DESC-1 = "%";
end 

Function WS17IS-RETRIEVE ()
  
  
  
  
  
  
  
   
    WS15A15_CRIT.DEPT-CD = WS17IW-PASSVALUE.DEPT-CD;
    

  
    XXEXT_CALL_Level77Items.UEXTNAM = "WS17I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS15A15";
    

    
    try
        call "MRSWaysideRepair.WS15A15"(XDCONTROL, WS15A15_CRIT, WS15A15_DATA);
    
    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            return;
        else
            if (XDCONTROL.URC == 100)
                XXMESSAGE.UMSGCODE = "REC NOT FND";
                XXMESSAGE.UMSGINS[1] = "STOCK NO";
            else

        
        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
end 

Function WS17IS-SEARCH ()
  
  
  
  
  
  
  
   
    WS17A05_CRIT.STOCK-DESC = WS17IW-PASSVALUE.STOCK-DESC;
    WS17A05_CRIT.DEPT-CD = WS17IW-PASSVALUE.DEPT-CD;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "WS17I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS17A05";

    
    try
        call "WS17A05"(XDCONTROL, WS17A05_CRIT, WS17A05_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            WS17IW-TRIGGER.HAS-LOADED = "Y";
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function WS17IS-SELECT () 
    if (WS17IW-PASSVALUE.SELECT-INDEX > 0)
        WS17IW-PASSVALUE.STOCK-NO = WS17A05_DATA.STOCK-NO[SELECT-INDEX];
    end
end
