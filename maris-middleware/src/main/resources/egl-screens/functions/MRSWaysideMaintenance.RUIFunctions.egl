            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function WS13IS-RETR-REPAIR ()
  
  
  
  
  
  
  
   
    WS13A08_CRIT.INCD-NO = WS13IW-PASSVALUE.INCD-NO;
    WS13A08_CRIT.REPR-DOC-NO = WS13IW-PASSVALUE.REPR-DOC-NO;
