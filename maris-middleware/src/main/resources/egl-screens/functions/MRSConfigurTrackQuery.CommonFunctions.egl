

package MRSConfigurTrackQuery;


Function VHCF14IS-STK-DASH ()
  
  
  
  
  
  

  
   
    if (VHCF14IW-STOCK.WHICH == "L")
        VHCF14IW-STOCK.STOCK-A = VHCF14IW-STOCK.STOCK1;
        VHCF14IW-STOCK.DASH-A = "-";
        VHCF14IW-STOCK.STOCK-B = VHCF14IW-STOCK.STOCK2;
        VHCF14IW-STOCK.DASH-B = "-";
        VHCF14IW-STOCK.STOCK-C = VHCF14IW-STOCK.STOCK3;
    end
    if (VHCF14IW-STOCK.WHICH == "S")
        VHCF14IW-STOCK.STOCK1 = VHCF14IW-STOCK.STOCK-A;
        VHCF14IW-STOCK.STOCK2 = VHCF14IW-STOCK.STOCK-B;
        VHCF14IW-STOCK.STOCK3 = VHCF14IW-STOCK.STOCK-C;
    end
end
