    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM10I";

  
  
  
    VHVM10C_DATA.CON-NO = VHVM10IW-SELECT.CON-NO;
  
  
    VHVM10C_DATA.TERM-MAINT-UPD = VHVM10IW-ID.TERM-ID;


  
    if (XDCONTROL.UFUNCTION == "UPDATE" || XDCONTROL.UFUNCTION == "ADD")
        if (VHVM10C_DATA.CON-NO not blanks &&
         VHVM10C_DATA.CON-STAT not blanks)


  
            if (XDCONTROL.UFUNCTION == "UPDATE")
                try
                    call "VHVM10C"(XDCONTROL, VHVM10C_DATA);
                
                end
                if (XXEXT_CALL_Level77Items.URC == 0)

  
                    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                        VHVM10IW-TRIGGERS.UPDATED = "Y";
                        VHVM10IW-SELECT_Level77Items.SELECTION-IDX = 0;
                        XDCONTROL.UFUNCTION = "RETRIEVE";
                    else
