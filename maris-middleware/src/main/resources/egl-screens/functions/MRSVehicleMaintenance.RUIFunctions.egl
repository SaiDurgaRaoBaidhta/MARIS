     VHVM1A5_DATA.CURR-SCHD-PM-NO != VHVM1A5_CRIT.CURR-SCHD-PM-NO ||
     VHVM1A5_DATA.DASH-NO != VHVM1A5_CRIT.DASH-NO ||
     VHVM1A5_DATA.DASH-NO-FAIL != VHVM1A5_CRIT.DASH-NO-FAIL ||
     VHVM1A5_DATA.DATE-END-CAR-REV != VHVM1A5_CRIT.DATE-END-CAR-REV ||
