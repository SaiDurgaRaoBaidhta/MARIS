

package MRSVehicleMaintenance;


Function VHIM11IS-BAT () 
    if (VHVM11IW-SELECT.EVENT-TYPE == "BAT")
        if ((VHVM11H_DATA.CAR-TYPE == "C1" || VHVM11H_DATA.CAR-TYPE == "C2") &&
         VHVM11H_DATA.BATTERY-REPL-SW == " ")
            VHVM11IW-TRIGGERS.PROMP-BAT = "Y";
        else
            VHVM11IW-TRIGGERS.CONT-UPD = "Y";
        end
    else
        VHVM11IW-TRIGGERS.CONT-UPD = "Y";
    end
end 

Function VHIM11IS-BAT-C () 
    if (VHVM11IW-SELECT.EVENT-TYPE == "BAT")
        if ((VHVM11H_DATA.CAR-TYPE == "C1" || VHVM11H_DATA.CAR-TYPE == "C2") &&
         VHVM11H_DATA.BATTERY-REPL-SW == " ")
            VHVM11IW-TRIGGERS.PROMP-BAT-C = "Y";
        else
            VHVM11IW-TRIGGERS.CONT-CLO = "Y";
        end
    else
        VHVM11IW-TRIGGERS.CONT-CLO = "Y";
    end
end 

Function VHNAR02IS-RETNARR () 
    VHNARX_DATA.CRIT-INCD-NO = VHNAR02IW-PASSVAL.INCD-NO;
    try
        call "VHNARX"(XDCONTROL, VHNARX_DATA);
    
    end
    if (XDCONTROL.UROWCNT > 0)
        VHNAR02IW.NARR-ROW-COUNT = XDCONTROL.UROWCNT;
        LOAD-DATA = "Y";
    else

    end
end 

Function VHNARIS-ADDNARR ()
  
  
  
  
  
  
  
  


  
  
  
  
  
  
  
  
  
  

   
    if (VHNARIW-PASSVALUE.CURRENT-NARR != " ")
        VHNAR01IW.FINAL-ERROR-MESSAGE = " ";
        VHNAR01IW.CI-NARR-PART = " ";
        VHNAR01IW.TEMP-NARR = " ";
  
  
  
        if (VHNARIW-PASSVALUE.REPR-DOC-NO != 0)
            VHXNR3A_DATA.INCD-NO = VHNARIW-PASSVALUE.INCD-NO;
            VHXNR3A_DATA.NARR-NO = VHNARIW-PASSVALUE.MAX-ROWS + 1;
            VHXNR3A_DATA.NARR = VHNARIW-PASSVALUE.CURRENT-NARR;
            VHXNR3A_DATA.USER-GRP = VHNARIW-PASSVALUE.STORE-USER-GRP;
            VHXNR3A_DATA.REPR-DOC-NO = VHNARIW-PASSVALUE.REPR-DOC-NO;
            VHXNR3A_DATA.TERM-NARR = VHNARIW-PASSVALUE.TERM-LAST-UPD;
            XXEXT_CALL_Level77Items.UEXTNAM = "VHNAR1I";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHXNR3A";
            try
                call "VHXNR3A"(XDCONTROL, VHXNR3A_DATA);
            
            end
            MRSCommonCode.XXA0IS-CHECK_EXT();
            if (XXEXT_CALL_Level77Items.URC == 0)
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    VHNARIW-PASSVALUE.MAX-ROWS = VHXNR3A_DATA.NARR-NO;
                    VHNARIW-PASSVALUE.CURRENT-NARR = " ";
                    VHNARS-RETR-REPAIR();
                    ADDNARR-SETFOCUS = "Y";
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end
        end

  
  
  
        if (VHNARIW-PASSVALUE.INCD-NO != " " && VHNARIW-PASSVALUE.REPR-DOC-NO == 0)
            VHXNR2A_DATA.INCD-NO = VHNARIW-PASSVALUE.INCD-NO;
            VHXNR2A_DATA.NARR-NO = VHNARIW-PASSVALUE.MAX-ROWS + 1;
            VHXNR2A_DATA.NARR = VHNARIW-PASSVALUE.CURRENT-NARR;
            VHXNR2A_DATA.USER-GRP = VHNARIW-PASSVALUE.STORE-USER-GRP;
            VHXNR2A_DATA.TERM-NARR = VHNARIW-PASSVALUE.TERM-LAST-UPD;
            XXEXT_CALL_Level77Items.UEXTNAM = "VHNAR1I";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHXNR2A";
            try
                call "VHXNR2A"(XDCONTROL, VHXNR2A_DATA);
            
            end
            MRSCommonCode.XXA0IS-CHECK_EXT();
            if (XXEXT_CALL_Level77Items.URC == 0)
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    VHNARIW-PASSVALUE.MAX-ROWS = VHXNR2A_DATA.NARR-NO;
                    VHNARIW-PASSVALUE.CURRENT-NARR = " ";
                    VHNARIS-RETR-INCD();
                    ADDNARR-SETFOCUS = "Y";
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end
        end
        VHNARIW-PASSVALUE.REFRESH-GUI = "Y";
    else
        VHNAR01IW.FINAL-ERROR-MESSAGE = "Invalid Narrative.";
        VHNARIW-TRIGGER.ADDNARR-SETFOCUS = "Y";
    end
end 

Function VHNARIS-CHK-NARR () 
    if (VHNARIW-PASSVALUE.NARR-1 == "CI / ACTION")
        VHNAR01IW.CI-NARR-PART = VHNARIW-PASSVALUE.NARR-CI;
        VHNARIW-PASSVALUE.NARR = VHNARIW-PASSVALUE.NARR-REM;
    else
        VHNAR01IW.CI-NARR-PART = " ";
    end
end 

Function VHNARIS-GET-NARR ()
  
  
   
    VHNAR01IW.TEMP-NARR = " ";
    VHNAR01IW.FINAL-ERROR-MESSAGE = " ";
    VHXNR1A_CRIT.CURRENT-ROW = VHNARIW-PASSVALUE.CURRENT-ROW;
    VHXNR1A_CRIT.MAX-ROWS = VHNARIW-PASSVALUE.MAX-ROWS;
    VHXNR1A_CRIT.INCD-NO = VHNARIW-PASSVALUE.INCD-NO;
    VHXNR5A_CRIT.CURRENT-ROW = VHNARIW-PASSVALUE.CURRENT-ROW;
    VHXNR5A_CRIT.INCD-NO = VHNARIW-PASSVALUE.INCD-NO;
    VHXNR5A_CRIT.REPR-DOC-NO = VHNARIW-PASSVALUE.REPR-DOC-NO;
    VHXNR5A_CRIT.MAX-ROWS = VHNARIW-PASSVALUE.MAX-ROWS;


  
  
  
    if (VHNARIW-PASSVALUE.REPR-DOC-NO != 0)
        if (VHXNR1A_CRIT.VAGen_FUNCTION == "UPNARR")
            VHXNR5A_CRIT.CURRENT-ROW = VHXNR5A_CRIT.CURRENT-ROW - 1;
            if (VHXNR5A_CRIT.CURRENT-ROW <= 1)
                VHXNR5A_CRIT.CURRENT-ROW = 1;
            end
        end
    end

  
    if (VHNARIW-PASSVALUE.INCD-NO != " " &&
     VHNARIW-PASSVALUE.REPR-DOC-NO == 0)
        if (VHXNR1A_CRIT.VAGen_FUNCTION == "UPNARR")
            VHXNR1A_CRIT.CURRENT-ROW = VHXNR1A_CRIT.CURRENT-ROW - 1;
            if (VHXNR1A_CRIT.CURRENT-ROW <= 1)
                VHXNR1A_CRIT.CURRENT-ROW = 1;
            end
        end
    end
    if (VHNARIW-PASSVALUE.REPR-DOC-NO != 0)
        if (VHXNR1A_CRIT.VAGen_FUNCTION == "DOWNNARR")
            VHXNR5A_CRIT.CURRENT-ROW = VHXNR5A_CRIT.CURRENT-ROW + 1;
            if (VHXNR5A_CRIT.CURRENT-ROW >= VHXNR5A_CRIT.MAX-ROWS)
                VHXNR5A_CRIT.CURRENT-ROW = VHXNR5A_CRIT.MAX-ROWS;
            end
        end
    end
    if (VHNARIW-PASSVALUE.INCD-NO != " " && VHNARIW-PASSVALUE.REPR-DOC-NO == 0)
        if (VHXNR1A_CRIT.VAGen_FUNCTION == "DOWNNARR")
            VHXNR1A_CRIT.CURRENT-ROW = VHXNR1A_CRIT.CURRENT-ROW + 1;
            if (VHXNR1A_CRIT.CURRENT-ROW >= VHXNR1A_CRIT.MAX-ROWS)
                VHXNR1A_CRIT.CURRENT-ROW = VHXNR1A_CRIT.MAX-ROWS;
            end
        end
    end
    VHXNR1A_CRIT.NARR-NO = VHXNR1A_CRIT.CURRENT-ROW;
    VHXNR5A_CRIT.NARR-NO = VHXNR5A_CRIT.CURRENT-ROW;

  

  
    if (VHNARIW-PASSVALUE.REPR-DOC-NO != 0)
        XXEXT_CALL_Level77Items.UEXTNAM = "VHNAR1I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHXNR5A";
        try
            call "VHXNR5A"(XDCONTROL, VHXNR5A_CRIT, VHXNR5A_DATA);
        
        end
        VHNARIW-PASSVALUE.USER-GRP = VHXNR5A_DATA.USER-GRP;
        VHNARIW-PASSVALUE.TIME-NARR = VHXNR5A_DATA.TIME-NARR;
        TIME-NARR-FILLER-1 = ":";
        TIME-NARR-FILLER-2 = ":";
        VHNARIW-PASSVALUE.DATE-NARR = VHXNR5A_DATA.DATE-NARR;
        VHNARIW-PASSVALUE.NARR = VHXNR5A_DATA.NARR;
        VHNARIW-PASSVALUE.CURRENT-ROW = VHXNR5A_DATA.NARR-NO;
    else

  
        if (VHNARIW-PASSVALUE.INCD-NO != " " &&
         VHNARIW-PASSVALUE.REPR-DOC-NO == 0)
            XXEXT_CALL_Level77Items.UEXTNAM = "VHNAR1I";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHXNR1A";
            try
                call "VHXNR1A"(XDCONTROL, VHXNR1A_CRIT, VHXNR1A_DATA);
            
            end
            VHNARIW-PASSVALUE.USER-GRP = VHXNR1A_DATA.USER-GRP;
            VHNARIW-PASSVALUE.TIME-NARR = VHXNR1A_DATA.TIME-NARR;
            TIME-NARR-FILLER-1 = ":";
            TIME-NARR-FILLER-2 = ":";
            VHNARIW-PASSVALUE.DATE-NARR = VHXNR1A_DATA.DATE-NARR;
            VHNARIW-PASSVALUE.NARR = VHXNR1A_DATA.NARR;
            VHNARIW-PASSVALUE.CURRENT-ROW = VHXNR1A_DATA.NARR-NO;
        else

        end
    end
     
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end

  
  
  
    if (VHNARIW-PASSVALUE.REPR-DOC-NO != 0)
        if (VHNARIW-PASSVALUE.MAX-ROWS == 1)
            VHNARIW-TRIGGER.DISABLE-UP = "Y";
            VHNARIW-TRIGGER.DISABLE-DOWN = "Y";
        end
        if (VHNARIW-PASSVALUE.CURRENT-ROW > 1 &&
         VHNARIW-PASSVALUE.CURRENT-ROW < VHNARIW-PASSVALUE.MAX-ROWS)
            VHNARIW-TRIGGER.ENABLE-UP = "Y";
            VHNARIW-TRIGGER.ENABLE-DOWN = "Y";
            PRV-SETFOCUS = "Y";
        end
        if (VHNARIW-PASSVALUE.CURRENT-ROW > 1 &&
         VHNARIW-PASSVALUE.CURRENT-ROW == VHNARIW-PASSVALUE.MAX-ROWS)
            VHNARIW-TRIGGER.ENABLE-UP = "Y";
            VHNARIW-TRIGGER.DISABLE-DOWN = "Y";
            PRV-SETFOCUS = "Y";
        end
        if (VHNARIW-PASSVALUE.CURRENT-ROW == 1 &&
         VHNARIW-PASSVALUE.CURRENT-ROW < VHNARIW-PASSVALUE.MAX-ROWS)
            VHNARIW-TRIGGER.DISABLE-UP = "Y";
            VHNARIW-TRIGGER.ENABLE-DOWN = "Y";
            NXT-SETFOCUS = "Y";
        end
    end
    if (VHNARIW-PASSVALUE.INCD-NO != " " &&
     VHNARIW-PASSVALUE.REPR-DOC-NO == 0)
        if (VHNARIW-PASSVALUE.MAX-ROWS == 1)
            VHNARIW-TRIGGER.DISABLE-UP = "Y";
            VHNARIW-TRIGGER.DISABLE-DOWN = "Y";
        end
        if (VHNARIW-PASSVALUE.CURRENT-ROW > 1 &&
         VHNARIW-PASSVALUE.CURRENT-ROW < VHNARIW-PASSVALUE.MAX-ROWS)
            VHNARIW-TRIGGER.ENABLE-UP = "Y";
            VHNARIW-TRIGGER.ENABLE-DOWN = "Y";
            PRV-SETFOCUS = "Y";
        end
        if (VHNARIW-PASSVALUE.CURRENT-ROW > 1 &&
         VHNARIW-PASSVALUE.CURRENT-ROW == VHNARIW-PASSVALUE.MAX-ROWS)
            VHNARIW-TRIGGER.ENABLE-UP = "Y";
            VHNARIW-TRIGGER.DISABLE-DOWN = "Y";
            PRV-SETFOCUS = "Y";
        end
        if (VHNARIW-PASSVALUE.CURRENT-ROW == 1 &&
         VHNARIW-PASSVALUE.CURRENT-ROW < VHNARIW-PASSVALUE.MAX-ROWS)
            VHNARIW-TRIGGER.DISABLE-UP = "Y";
            VHNARIW-TRIGGER.ENABLE-DOWN = "Y";
            NXT-SETFOCUS = "Y";
        end
    end
    VHNARIS-CHK-NARR();
end 

Function VHNARIS-INIT () 
    TIME-NARR-FILLER-1 = ":";
    TIME-NARR-FILLER-2 = ":";
    if (VHNARIW-PASSVALUE.CURRENT-ROW == 1)
        DISABLE-UP = "Y";
    else
        ENABLE-UP = "Y";
        NXT-SETFOCUS = "Y";
    end
    if (VHNARIW-PASSVALUE.CURRENT-ROW < VHNARIW-PASSVALUE.MAX-ROWS)
        ENABLE-DOWN = "Y";
        NXT-SETFOCUS = "Y";
    else
        DISABLE-DOWN = "Y";
        PRV-SETFOCUS = "Y";
    end
    VHNARIS-CHK-NARR();
end 

Function VHNARIS-RETR-INCD ()
  
  
  
  
  
  
  
   
    VHXNR6A_CRIT.INCD-NO = VHNARIW-PASSVALUE.INCD-NO;
    VHXNR6A_CRIT.NARR-NO = 0;
    VHXNR6A_CRIT.VAGen_FUNCTION = "NARR";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHNAR1I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHXNR6A";
    try
        call "VHXNR6A"(XDCONTROL, VHXNR6A_CRIT, VHXNR6A_DATA);
    
    end
    MRSCommonCode.XXA0IS-CHECK_EXT();
    if (XXEXT_CALL_Level77Items.URC == 0)
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHNARIW-PASSVALUE.USER-GRP = VHXNR6A_DATA.USER-GRP;
            VHNARIW-PASSVALUE.DATE-NARR = VHXNR6A_DATA.DATE-NARR;
            VHNARIW-PASSVALUE.TIME-NARR = VHXNR6A_DATA.TIME-NARR;
            VHNARIW-PASSVALUE.TIME-NARR-FILLER-1 = ":";
            VHNARIW-PASSVALUE.TIME-NARR-FILLER-2 = ":";
            VHNARIW-PASSVALUE.NARR = VHXNR6A_DATA.NARR;
            VHNARIW-PASSVALUE.NARR-NO = VHXNR6A_DATA.MAX-ROWS;
            VHNARIW-PASSVALUE.CURRENT-ROW = VHXNR6A_DATA.MAX-ROWS;
            VHNARIW-TRIGGER.ENABLE-UP = "Y";
            VHNARIW-TRIGGER.DISABLE-DOWN = "Y";
            FINAL-ERROR-MESSAGE = "Incd Narrative added successfully.";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHNARIS-RETURN () 
    set VHNAR01IW empty;
end 

Function VHNARIS-UPDNARR ()
  
  
  
  
  
  
  
   
    if (VHNAR01IW.UPD-NARR != " ")
        VHNAR01IW.UPD-NARR-NO = VHNARIW-PASSVALUE.CURRENT-ROW;
        if (VHNAR01IW.CI-NARR-PART-1 == "CI / ACTION")
            VHNAR01IW.TEMP-NARR-1 = VHNAR01IW.CI-NARR-PART-1;
            VHNAR01IW.TEMP-NARR-2 = VHNAR01IW.CI-NARR-PART-2;
            VHNAR01IW.TEMP-NARR-3 = VHNAR01IW.UPD-NARR;
        else
            VHNAR01IW.TEMP-NARR = VHNAR01IW.UPD-NARR;
        end

  
  
  
        if (VHNARIW-PASSVALUE.REPR-DOC-NO != 0)
            VHXNR8A_CRIT.INCD-NO = VHNARIW-PASSVALUE.INCD-NO;
            VHXNR8A_CRIT.NARR-NO = VHNAR01IW.UPD-NARR-NO;
            VHXNR8A_CRIT.REPR-DOC-NO = VHNARIW-PASSVALUE.REPR-DOC-NO;
            VHXNR8A_DATA.NARR = VHNAR01IW.TEMP-NARR;
            VHXNR8A_DATA.USER-GRP = VHNARIW-PASSVALUE.STORE-USER-GRP;
            VHXNR8A_DATA.TERM-NARR = VHNARIW-PASSVALUE.TERM-LAST-UPD;

      
            XXEXT_CALL_Level77Items.UEXTNAM = "VHNAR1I";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHXNR8A";
            try
                call "VHXNR8A"(XDCONTROL, VHXNR8A_CRIT, VHXNR8A_DATA);
            
            end
            MRSCommonCode.XXA0IS-CHECK_EXT();
            if (XXEXT_CALL_Level77Items.URC == 0)
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    FINAL-ERROR-MESSAGE = "Repr Narrative updated successfully.";
                    ADDNARR-SETFOCUS = "Y";
                else
                    FINAL-ERROR-MESSAGE = "Repr Narrative update unsuccessful.";
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end
        end

  
  
  
        if (VHNARIW-PASSVALUE.INCD-NO != " " && VHNARIW-PASSVALUE.REPR-DOC-NO == 0)
            VHXNR7A_CRIT.INCD-NO = VHNARIW-PASSVALUE.INCD-NO;
            VHXNR7A_CRIT.NARR-NO = VHNAR01IW.UPD-NARR-NO;
            VHXNR7A_DATA.NARR = VHNAR01IW.TEMP-NARR;
            VHXNR7A_DATA.USER-GRP = VHNARIW-PASSVALUE.STORE-USER-GRP;
            VHXNR7A_DATA.TERM-NARR = VHNARIW-PASSVALUE.TERM-LAST-UPD;
            XXEXT_CALL_Level77Items.UEXTNAM = "VHNAR1I";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHXNR7A";
            try
                call "VHXNR7A"(XDCONTROL, VHXNR7A_CRIT, VHXNR7A_DATA);
            
            end
            MRSCommonCode.XXA0IS-CHECK_EXT();
            if (XXEXT_CALL_Level77Items.URC == 0)
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    FINAL-ERROR-MESSAGE = "Incd Narrative updated successfully.";
                    ADDNARR-SETFOCUS = "Y";
                else
                    FINAL-ERROR-MESSAGE = "Incd Narrative update unsuccessful.";
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end
        end
    else
        VHNAR01IW.FINAL-ERROR-MESSAGE = "Invalid Narrative.";
        VHNARIW-TRIGGER.UPDNARR-SETFOCUS = "Y";
    end
end 

Function VHNARS-RETR-REPAIR ()
  
  
  
  
  
  
  
   
    VHXNR4A_CRIT.INCD-NO = VHNARIW-PASSVALUE.INCD-NO;
    VHXNR4A_CRIT.REPR-DOC-NO = VHNARIW-PASSVALUE.REPR-DOC-NO;
