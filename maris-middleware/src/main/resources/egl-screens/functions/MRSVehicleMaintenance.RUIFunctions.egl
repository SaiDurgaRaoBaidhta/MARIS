Function VHVM03IS-GET-STATS ()
  
  
  
  
  
  
  
  
  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM03II";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM1A9";

  

    
    try
        call "VHVM1A9"(XDCONTROL, VHVM1A9_CRIT, VHVM1A9_DATA, VHVM1A9B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHVM03IW.STAT-CNT = XDCONTROL.UROWCNT;
            
  
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHVM03IS-ORIENT ()
  
   
    set VHVM03IW-ORIENT empty;
    VHVM02IW.CAR-COUNT = 1;
    while (VHVM02IW.CAR-COUNT <= VHVM1A7_DATA.VAGen_COUNT)
        if (VHVM1A5_DATA.CAR-TYPE == VHVM1A7_DATA.CAR-TYPE[VHVM02IW.CAR-COUNT])
            VHVM03IW-ORIENT.ORIENTATION-CD[1] = VHVM1A7_DATA.LFT-ORIENTATION-CD[VHVM02IW.CAR-COUNT];
            VHVM03IW-ORIENT.ORIENTATION-CD[2] = VHVM1A7_DATA.RGT-ORIENTATION-CD[VHVM02IW.CAR-COUNT];
        end
        VHVM02IW.CAR-COUNT = VHVM02IW.CAR-COUNT + 1;
    end
end 

