Function VHVM13I-RE-DATE ()
  

    
    try
        call "VHVMDTA"(XDCONTROL, VHVMDTA_CRIT, VHVMDTA_DATA);
    
    end
    if (XDCONTROL.UROWCNT == 1)
        VHVM11IW-WORKING.RUN-DATE = VHVMDTA_CRIT.CURRENT-DATE;
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

Function VHVM13IS-HARD-COPY () 
    if (PRINT-IDX > 0)
        ENABLE-HARD = "Y";
        VHVM13IW.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRINT-IDX];
    else
        DISABLE-HARD = "Y";
    end
end 

Function VHVM13IS-INIT ()
  


   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM13C";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM13C";
    try
        call "VHVM13C"(XDCONTROL, VHVM13C_CRIT, VHVM13C_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHVM13IW-WORKING.COUNTER = UROWCNT;
    else
        VHVM13C_DATA.EVENT-TYPE[1] = "CE";
        VHVM13C_DATA.EVENT-TYPE[2] = "MOD";
        VHVM13IW-WORKING.COUNTER = 2;
    end
    VHVM13IW-WORKING.LOAD-EVENTS = "Y";
end 

Function VHVM13IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  

   
    if (VHVM13IW-PASS-DATA.CAR-TYPE != " " && VHVM13IW-PASS-DATA.DATE-INITIALIZED != " " && VHVM13IW-PASS-DATA.TRKG-REF-NO != " " && VHVM13IW-PASS-DATA.COMMENTS != " ")
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHVM13IW-PASS-DATA.DATE-INITIALIZED;
        MRSCommonCode.XXDATES-CONVERT();
        VHVM13A_CRIT.DATE-FROM = XXDATEW.DATE-YYYY-MM-DD;

  
        VHVM13A_CRIT.CAR-TYPE = VHVM13IW-PASS-DATA.CAR-TYPE;
        VHVM13A_CRIT.EVENT-TYPE = VHVM13IW-PASS-DATA.EVENT-TYPE;
        VHVM13A_CRIT.EVENT-STAT = VHVM13IW-PASS-DATA.EVENT-STAT;
        VHVM13A_CRIT.TRKG-REF-NO = VHVM13IW-PASS-DATA.TRKG-REF-NO;
        VHVM13A_CRIT.COMMENTS = VHVM13IW-PASS-DATA.COMMENTS;
        VHVM13A_CRIT.VTAM-NAME = VHVM13IW.VTAM-NAME;
        VHVM13A_CRIT.HOME-YRD = VHVM13IW-PASS-DATA.HOME-YRD;


    
        XXEXT_CALL_Level77Items.UEXTNAM = "VHVM13AI";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM13A";


    
        try
            call "VHVM13A"(XDCONTROL, VHVM13A_CRIT, VHVM13A_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)

      
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
                VHVM13IW.VALID = "Y";
                
        
       
            else

        


        
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    else 
        if (VHVM13IW-PASS-DATA.CAR-TYPE == " ")
            VHVM13IW.MISSING-CAR-TYPE = "Y";
        end
        if (VHVM13IW-PASS-DATA.DATE-INITIALIZED == " ")
            VHVM13IW.MISSING-DATE = "Y";
        end
        if (VHVM13IW-PASS-DATA.TRKG-REF-NO == " ")
            VHVM13IW.MISSING-REF-NO = "Y";
        end
        if (VHVM13IW-PASS-DATA.COMMENTS == " ")
            VHVM13IW.MISSING-COMMENTS = "Y";
        end
        VHVM13IW.NOT-VALID = "Y";
    end
end 

