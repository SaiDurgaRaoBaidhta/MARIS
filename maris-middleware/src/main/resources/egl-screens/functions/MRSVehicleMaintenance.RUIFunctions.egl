    VHVM11A_CRIT.EVENT-TYPE = VHVM11IW-PASS-DATA.EVENT-TYPE;
    VHVM11IW-WORKING.EVENT-TYPE = "ALL";

  
    if (VHVM11IW-PASS-DATA.EVENT-TYPE == "AWP")
        VHVM11IW-WORKING.EVENT-TYPE = "AWP";
    end
    if (VHVM11IW-PASS-DATA.EVENT-TYPE == "BAT")
        VHVM11IW-WORKING.EVENT-TYPE = "BAT";
    end


  
    VHVM11IW-WORKING.EVENT-STAT = "ALL";
    VHVM11A_CRIT.EVENT-STAT = "OPEN       ";

  
    VHVM11A_CRIT.CURR-LOC = "       ";
    VHVM11A_CRIT.TRKG-REF-NO = " ";
