     VHVM1A5_DATA.DATE-LAST-UPD != VHVM1A5_CRIT.DATE-LAST-UPD ||
     VHVM1A5_DATA.DATE-MAINT-UPD != VHVM1A5_CRIT.DATE-MAINT-UPD ||
     VHVM1A5_DATA.END-CAR-HRS != VHVM1A5_CRIT.END-CAR-HRS ||
     VHVM1A5_DATA.END-CAR-MIN != VHVM1A5_CRIT.END-CAR-MIN ||
     VHVM1A5_DATA.HOME-YRD != VHVM1A5_CRIT.HOME-YRD ||
     VHVM1A5_DATA.HRS-AT-LAST-PM != VHVM1A5_CRIT.HRS-AT-LAST-PM ||
     VHVM1A5_DATA.HRS-FROM-LAST-PM != VHVM1A5_CRIT.HRS-FROM-LAST-PM ||
     VHVM1A5_DATA.HRS-TO-NEXT-PM != VHVM1A5_CRIT.HRS-TO-NEXT-PM ||
