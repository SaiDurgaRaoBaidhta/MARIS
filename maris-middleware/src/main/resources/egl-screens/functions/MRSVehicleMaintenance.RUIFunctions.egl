Function VHVM06IS-GETSUBLOC () 
    if (VHVM06IW-SELECT.YRD-TRKG-YRD != "        ")
        VHVM6A6_CRIT.YARD-LOC-IND = "Y";
        try
            call "VHVM6A6"(XDCONTROL, VHVM6A6_CRIT, VHVM6A6_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHVM06IW.ROW-COUNT = XDCONTROL.UROWCNT;
            VHVM06IW-TRIGGERS.LOAD-SUBLOC = "Y";
            
    
        else
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHVM06IS-MOD-DATA ()
  
  
  
  
  
  
  
  
  
  
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM06I";

  
  
  
  
  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHVM06IW-SELECT.DATE-STAT-CHG;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM6A3_DATA.DATE-STAT-CHG = XXDATEW.DATE-YYYY-MM-DD;
    VHVM6A3_DATA.TS-STAT-CHG = VHVM06IW-SELECT.TS-STAT-CHG;
    VHVM6A3_DATA.HOME-YRD = VHVM06IW-SELECT.HOME-YRD;
    VHVM6A3_DATA.INCD-NO = VHVM06IW-SELECT.INCD-NO;
    VHVM6A3_DATA.INCD-STAT-NEW = VHVM06IW-SELECT.INCD-STAT-NEW;
    VHVM6A3_DATA.INCD-STAT-PREV = VHVM06IW-SELECT.INCD-STAT-PREV;
    VHVM6A3_DATA.MARIS-FUNC = "VHVM06";
    VHVM6A3_DATA.MOVE-REASON-CD = VHVM06IW-SELECT.MOVE-REASON-CD;
    VHVM6A3_DATA.TERM-MAINT-UPD = VHVM06IW-ID.TERM-ID;
    VHVM6A3_DATA.TIME-STAT-CHG = VHVM06IW-SELECT.TIME-STAT-CHG;
    VHVM6A3_DATA.USER-GRP = VHVM06IW-ID.USER-GROUP;
    VHVM6A3_DATA.YRD-SUB-LOC = VHVM06IW-SELECT.YRD-SUB-LOC;
    VHVM6A3_DATA.YRD-TRKG-YRD = VHVM06IW-SELECT.YRD-TRKG-YRD;
    VHVM6A3_DATA.PSEUDO-CON-NO = VHVM06IW-SELECT.PSEUDO-CON-NO;

  
    if (XDCONTROL.UFUNCTION == "UPDATE" || XDCONTROL.UFUNCTION == "ADD")
        if (VHVM6A3_DATA.INCD-NO not blanks &&
         VHVM6A3_DATA.DATE-STAT-CHG not blanks &&
         VHVM6A3_DATA.TIME-STAT-CHG not blanks &&
         VHVM6A3_DATA.INCD-STAT-NEW not blanks &&
         VHVM6A3_DATA.HOME-YRD not blanks)


  
            if (XDCONTROL.UFUNCTION == "UPDATE")
                try
                    call "VHVM6A3"(XDCONTROL, VHVM6A3_CRIT, VHVM6A3_DATA);
                
                end
                if (XXEXT_CALL_Level77Items.URC == 0)

  
                    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                        VHVM06IW-TRIGGERS.UPDATED = "Y";
                        VHVM06IW-SELECT_Level77Items.SELECTION-IDX = 0;
                        XDCONTROL.UFUNCTION = "RETRIEVE";
                    else
                        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    end 
                end
            end
  

  
            if (XDCONTROL.UFUNCTION == "ADD")
                VHVM6A3_DATA.STAT-CHG-ACTN = "MAINT ADD";
                VHVM6A3_DATA.TERM-LAST-UPD = "MAINT ADD";
                try
                    call "VHVM6A2"(XDCONTROL, VHVM6A3_DATA);
                
                end
                if (XXEXT_CALL_Level77Items.URC == 0)

  
                    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                        VHVM06IW-TRIGGERS.ADDED = "Y";
                        VHVM06IW-SELECT_Level77Items.SELECTION-IDX = 0;
                        XDCONTROL.UFUNCTION = "RETRIEVE";
                        VHVM06IW.ROW-COUNT = VHVM06IW.ROW-COUNT + 1;
                    else
                        if (XDCONTROL.UMSGINS[1] == "-803")
                            VHVM06IW-TRIGGERS.DUPLICATE-KEY = "Y";
                        else
                            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                        end 
                    end
                end
            end
        else
  
            VHVM06IW-TRIGGERS.DATA-ERROR = "Y";
            

  
  
        end
    else

  
        if (XDCONTROL.UFUNCTION == "DELETE")
            try
                call "VHVM6A4"(XDCONTROL, VHVM6A3_DATA);
            
            end
            if (XXEXT_CALL_Level77Items.URC == 0)
     
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    VHVM06IW-TRIGGERS.DELETED = "Y";
                    XDCONTROL.UFUNCTION = "RETRIEVE";
                    
  
  
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end 
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
  
    if (XDCONTROL.UFUNCTION == "RETRIEVE")
        VHVM06IW.ROW-COUNT = 0;
        try
            call "VHVM6A1"(XDCONTROL, VHVM6A1_CRIT, VHVM6A1_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHVM06IW.INCD-ROWS = XDCONTROL.UROWCNT;
            VHVM06IW-TRIGGERS.LOAD-DATA = "Y";
            VHVM06IW.RETURNED-DATA = "Y";
            VHVM06IW-TRIGGERS.PUSH-CLEAR = "Y";
        else
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    else 
        VHVM06IW-TRIGGERS.MISSING-VALUES = "Y";
    end
end 

Function VHVM06IS-RET-DATA () 
    if (VHVM6A1_CRIT.INCD-NO != "        ")
        VHVM06IW.ROW-COUNT = 0;
        try
            call "VHVM6A1"(XDCONTROL, VHVM6A1_CRIT, VHVM6A1_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHVM06IW.INCD-ROWS = XDCONTROL.UROWCNT;
            VHVM06IW-TRIGGERS.LOAD-DATA = "Y";
            VHVM06IW.RETURNED-DATA = "Y";
        else
        
        
            VHVM06IW-TRIGGERS.BAD-INCIDENT = "Y";
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHVM06IS-SELECT () 
    if (SELECTION-IDX > 0)
        VHVM06IW-SELECT.DATA_ROW = VHVM6A1_DATA.DATA_ROW[SELECTION-IDX];
        VHVM06IW-TRIGGERS.ENABLE-UPDATE = "Y";
    end
end 

Function VHVM06IS-VDATE ()
  
  
  
   
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHVM06IW-SELECT.DATE-STAT-CHG;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM6A3_DATA.DATE-STAT-CHG = XXDATEW.DATE-YYYY-MM-DD;
    VHVM6A3_DATA.TS-STAT-CHG = VHVM06IW-SELECT.TS-STAT-CHG;
    VHVM6A3_DATA.HOME-YRD = VHVM06IW-SELECT.HOME-YRD;
    VHVM6A3_DATA.INCD-NO = VHVM06IW-SELECT.INCD-NO;
    VHVM6A3_DATA.INCD-STAT-NEW = VHVM06IW-SELECT.INCD-STAT-NEW;
    VHVM6A3_DATA.INCD-STAT-PREV = VHVM06IW-SELECT.INCD-STAT-PREV;
    VHVM6A3_DATA.MARIS-FUNC = "VHVM06";
    VHVM6A3_DATA.MOVE-REASON-CD = VHVM06IW-SELECT.MOVE-REASON-CD;
    VHVM6A3_DATA.TERM-MAINT-UPD = VHVM06IW-ID.TERM-ID;
    VHVM6A3_DATA.TIME-STAT-CHG = VHVM06IW-SELECT.TIME-STAT-CHG;
    VHVM6A3_DATA.USER-GRP = VHVM06IW-ID.USER-GROUP;
    VHVM6A3_DATA.YRD-SUB-LOC = VHVM06IW-SELECT.YRD-SUB-LOC;
    VHVM6A3_DATA.YRD-TRKG-YRD = VHVM06IW-SELECT.YRD-TRKG-YRD;
    VHVM6A3_DATA.PSEUDO-CON-NO = VHVM06IW-SELECT.PSEUDO-CON-NO;

  
    VHVM06IS-DATE.TODAY = VGVar.currentGregorianDate;
    VHVM06IS-DATE.CURRENT-TIME = VGVar.currentFormattedTime;
  
    VHVM06IS-DATE.ENTRY-DATE-Y = VHVM06IS-DATE.YR-IN-N;
    VHVM06IS-DATE.ENTRY-DATE-M = VHVM06IS-DATE.MO-IN-N;
    VHVM06IS-DATE.ENTRY-DATE-D = VHVM06IS-DATE.DAY-IN-N;
    VHVM06IW-TRIGGERS.BAD-TIME = "N";
    VHVM06IW-TRIGGERS.BAD-DATE = "N";
    VHVM06IW-TRIGGERS.BLANK = "N";
    if (VHVM06IS-DATE.MO-IN-N < 1 || VHVM06IS-DATE.MO-IN-N > 12)
  
  
        VHVM06IW-TRIGGERS.BAD-DATE = "Y";
    end
    if (VHVM06IS-DATE.DAY-IN-N < 1 || VHVM06IS-DATE.DAY-IN-N > 31)
  
  
        VHVM06IW-TRIGGERS.BAD-DATE = "Y";
    end
    if (VHVM06IS-DATE.YR-IN-N < 1999 || VHVM06IS-DATE.YR-IN-N > 2100)
  
  
        VHVM06IW-TRIGGERS.BAD-DATE = "Y";
    end
  
    if (VHVM06IS-DATE.ENTRY-DATE > VHVM06IS-DATE.TODAY-N)
   
  
        VHVM06IW-TRIGGERS.BAD-DATE = "Y";
    end


  
    if (VHVM06IS-DATE.HR-IN-N > 24)
  
  
        VHVM06IW-TRIGGERS.BAD-TIME = "Y";
    end
    if (VHVM06IS-DATE.MIN-IN-N > 59)
  
  
        VHVM06IW-TRIGGERS.BAD-TIME = "Y";
    end
    if (VHVM06IS-DATE.HR-IN-N == 0 && VHVM06IS-DATE.MIN-IN-N == 0)
  
  
        VHVM06IW-TRIGGERS.BAD-TIME = "Y";
    end
  
    if ((VHVM06IS-DATE.TODAY-N == VHVM06IS-DATE.ENTRY-DATE) && VHVM06IS-DATE.TIME-IN > CURRENT-TIME)
        VHVM06IW-TRIGGERS.BAD-TIME = "Y";
    end
    if (VHVM06IW-TRIGGERS.BAD-DATE == "Y")
        VHVM06IW-TRIGGERS.BAD-DATE-MSG = "Y";
    end
    if (VHVM06IW-TRIGGERS.BAD-TIME == "Y")
        VHVM06IW-TRIGGERS.BAD-TIME-MSG = "Y";
    end

  
  
  
    if (XDCONTROL.UFUNCTION == "UPDATE" || XDCONTROL.UFUNCTION == "ADD")
        if (VHVM6A3_DATA.YRD-TRKG-YRD not blanks && VHVM6A3_DATA.YRD-SUB-LOC is blanks)
            VHVM06IW-TRIGGERS.BLANK-SUB-LOC = "Y";
            VHVM06IW-TRIGGERS.BLANK = "Y";
        end
        if (VHVM6A3_DATA.INCD-STAT-PREV is blanks && SELECTION-IDX > 1)
            VHVM06IW-TRIGGERS.BLANK-PREV-STAT = "Y";
            VHVM06IW-TRIGGERS.BLANK = "Y";
             
        end
    end
    if (VHVM06IW-TRIGGERS.BAD-TIME == "N" &&
     VHVM06IW-TRIGGERS.BAD-DATE == "N" &&
     VHVM06IW-TRIGGERS.BLANK == "N")
        VHVM06IW-TRIGGERS.RUN-PGM = "Y";
    end
end 

Function VHVM08IS-CALC ()
  
  
   
