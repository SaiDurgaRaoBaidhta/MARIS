Function VHVM03I-UPDATE-CAR ()
  
  
  
  
  
  
  
  
  
  

   
    if (VHVM1A5_DATA.DATE-END-CAR-REV != VHVM1A5_CRIT.DATE-END-CAR-REV)
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHVM1A5_DATA.DATE-END-CAR-REV;
        MRSCommonCode.XXDATES-CONVERT();
        VHVM1A5_DATA.DATE-END-CAR-REV = XXDATEW.DATE-YYYY-MM-DD;
    end

  
    VHVM1A4_DATA.CONFIG-UPD-SWITCH = "N";
    if (VHVM1A5_DATA.DATE-CONFIG-UPD != " " && VHVM1A5_DATA.TIME-CONFIG-UPD != " ")
        VHVM1A4_DATA.CONFIG-UPD-SWITCH = "Y";
    end
    VHVM1A4_DATA.HOME-YARD-SWITCH = "N";

  
  
    if (VHVM1A5_DATA.HOME-YRD != VHVM1A5_CRIT.HOME-YRD)
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VGVar.currentFormattedGregorianDate;
        MRSCommonCode.XXDATES-CONVERT();
        VHVM1A5_DATA.DATE-HOME-YRD-UPD = XXDATEW.DATE-YYYY-MM-DD;
        VHVM1A5_DATA.TERM-HOME-YRD-UPD = VH01A01_DATA.TERM-ID;

  
        VHVM1A4_DATA.HOME-YARD-SWITCH = "Y";
    end

  
    VHVM1A5_DATA.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
    VHVM1A5_DATA.TERM-MAINT-UPD = VH01A01_DATA.TERM-ID;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM1A4";

  
    try
        call "VHVM1A4"(XDCONTROL, VHVM1A4_DATA, VHVM1A5_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHVM03IW-TRIGGERS.DONE = "Y";
            

     
        else
           
        
            VHVM03IW-TRIGGERS.BAD = "Y";
            

  
  
  
  
        end 
    end
end 

Function VHVM03IS-CLEAR () 
    set VHVM1A5_DATA empty;
    VHVM03IW-TRIGGERS.CLEAR = "Y";
end 

Function VHVM03IS-GET-CAMER ()
  
  
  
  
  
  
  
  
  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM03II";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM1A6";

  

    
    try
        call "VHVM1A6"(XDCONTROL, VHVM1A6_CRIT, VHVM1A6_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHVM03IW.CAMERA-CNT = XDCONTROL.UROWCNT;
            
  
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

Function VHVM03IS-GET-CAR ()
  
  
  
  
  
  
  
  
  

  
  
  
  
  
   
    if (VHVM1A5_DATA.CAR-NO != "    ")
        VHVM03IW.CARS-RET = "N";
        XXEXT_CALL_Level77Items.UEXTNAM = "VHVM03I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM1A5";

  
        VHVM1A5_CRIT.CAR-NO = VHVM1A5_DATA.CAR-NO;

  
        try
            call "VHVM1A5"(XDCONTROL, VHVM1A5_CRIT, VHVM1A5_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                XXDATEW.VAGen_FUNCTION = "MDY";
                XXDATEW.DATE-YYYY-MM-DD = VHVM1A5_DATA.DATE-BATTERY-REPL;
                MRSCommonCode.XXDATES-CONVERT();
                VHVM1A5_DATA.DATE-BATTERY-REPL = XXDATEW.DATE-MM-DD-YYYY;
                XXDATEW.DATE-YYYY-MM-DD = VHVM1A5_DATA.DATE-CONFIG-C-STAT;
                MRSCommonCode.XXDATES-CONVERT();
                VHVM1A5_DATA.DATE-CONFIG-C-STAT = XXDATEW.DATE-MM-DD-YYYY;
                XXDATEW.DATE-YYYY-MM-DD = VHVM1A5_DATA.DATE-CONFIG-UPD;
                MRSCommonCode.XXDATES-CONVERT();
                VHVM1A5_DATA.DATE-CONFIG-UPD = XXDATEW.DATE-MM-DD-YYYY;
                VHVM03IW.CARS-RET = "Y";
                VHVM03IW-TRIGGERS.ENABLE-UPDATE = "Y";
                VHVM03IS-ORIENT();
  
                VHVM03IW.CAMERA-INDEX = 0;
                if (VHVM1A5_DATA.CAMERA-CD != " ")
                    VHVM03IW.CCOUNT = 1;
                    while (VHVM03IW.CCOUNT <= VHVM03IW.CAMERA-CNT)
                        if (VHVM1A5_DATA.CAMERA-CD == VHVM1A6_DATA.CAMERA-CD[VHVM03IW.CCOUNT])
                            VHVM03IW.CAMERA-INDEX = VHVM03IW.CCOUNT;
                        end
                        VHVM03IW.CCOUNT = VHVM03IW.CCOUNT + 1;
                    end
                     
                end 
        
      
                PM-COUNTER = 11;
                VHVM03IW.SCHD-INDEX = 0;
                if (VHVM1A5_DATA.CURR-SCHD-PM-NO != "  ")
                    VHVM03IW.SCHD-CNT = 1;
                    while (VHVM03IW.SCHD-CNT <= VHVM03-SCH-PM.PM-COUNTER)
                        if (VHVM1A5_DATA.CURR-SCHD-PM-NO == VHVM03-SCH-PM.SCHD-PM[VHVM03IW.SCHD-CNT])
                            VHVM03IW.SCHD-INDEX = VHVM03IW.SCHD-CNT;
                        end
                        VHVM03IW.SCHD-CNT = VHVM03IW.SCHD-CNT + 1;
                    end
                     
                end 
          
                PM-COUNTER-2 = 11;
                VHVM03IW.SCHD2-INDEX = 0;
                if (VHVM1A5_DATA.NEXT-SCHD-PM-NO != "  ")
                    VHVM03IW.SCHD2-CNT = 1;
                    while (VHVM03IW.SCHD2-CNT <= VHVM03-SCH-PM-2.PM-COUNTER-2)
                        if (VHVM1A5_DATA.NEXT-SCHD-PM-NO == VHVM03-SCH-PM-2.SCHD-PM-2[VHVM03IW.SCHD2-CNT])
                            VHVM03IW.SCHD2-INDEX = VHVM03IW.SCHD2-CNT;
                        end
                        VHVM03IW.SCHD2-CNT = VHVM03IW.SCHD2-CNT + 1;
                    end
                     
                end 
           
                PM-COUNTER-3 = 11;
                VHVM03IW.SCHD3-INDEX = 0;
                if (VHVM1A5_DATA.LAST-SCHD-PM-NO != "  ")
                    VHVM03IW.SCHD3-CNT = 1;
                    while (VHVM03IW.SCHD3-CNT <= VHVM03-SCH-PM-3.PM-COUNTER-3)
                        if (VHVM1A5_DATA.LAST-SCHD-PM-NO == VHVM03-SCH-PM-3.SCHD-PM-3[VHVM03IW.SCHD3-CNT])
                            VHVM03IW.SCHD3-INDEX = VHVM03IW.SCHD3-CNT;
                        end
                        VHVM03IW.SCHD3-CNT = VHVM03IW.SCHD3-CNT + 1;
                    end
                     
                end
                 
            else

        
        
                VHVM03IW-TRIGGERS.BAD-CAR = "Y";
                

  
  
  
  
            end 
        end
    end
end 

