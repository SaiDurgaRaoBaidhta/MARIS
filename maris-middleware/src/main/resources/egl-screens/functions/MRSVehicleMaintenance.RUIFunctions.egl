Function VHVM02IS-ORIENT ()
  
   
    set VHVM03IW-ORIENT empty;
    VHVM02IW.CAR-COUNT = 1;
    while (VHVM02IW.CAR-COUNT <= VHVM1A7_DATA.VAGen_COUNT)
        if (VHVM1A3_DATA.CAR-TYPE == VHVM1A7_DATA.CAR-TYPE[VHVM02IW.CAR-COUNT])
            VHVM03IW-ORIENT.ORIENTATION-CD[1] = VHVM1A7_DATA.LFT-ORIENTATION-CD[VHVM02IW.CAR-COUNT];
            VHVM03IW-ORIENT.ORIENTATION-CD[2] = VHVM1A7_DATA.RGT-ORIENTATION-CD[VHVM02IW.CAR-COUNT];
        end
        VHVM02IW.CAR-COUNT = VHVM02IW.CAR-COUNT + 1;
    end
end 

Function VHVM02IS-PRE-ADD () 
    if (VHVM1A3_DATA.CAR-NO != "    " &&
     VHVM1A3_DATA.CAR-TYPE != "   " &&
     VHVM1A3_DATA.VEH-STAT != "      " &&
     VHVM1A3_DATA.HOME-YRD != "   " &&
     VHVM1A3_DATA.CAMERA-CD != "   " &&
     VHVM1A3_DATA.VAGen_ORIENTATION != "   " &&
     VHVM1A3_DATA.ATO-PRESENT-IND != " " &&
     VHVM1A3_DATA.DATE-BATTERY-REPL not blanks &&
     VHVM1A3_DATA.BATTERY-REPL-LOC not blanks &&
     VHVM1A3_DATA.BATTERY-REPL-IND != " ")
  
  
  
  
  
  
  
  

  
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHVM1A3_DATA.DATE-BATTERY-REPL;
        MRSCommonCode.XXDATES-CONVERT();
        VHVM1A3_DATA.DATE-BATTERY-REPL = XXDATEW.DATE-YYYY-MM-DD;

  
  


  

  
  
   

  
  
        VHVM02IW-TRIGGERS.RUN-ADD = "Y";
        
  
  
    else
        VHVM02IW-TRIGGERS.MISSING-DATA = "Y";
    end
end 

Function VHVM02IW-CARTYPE ()
   
    if (VHVM1A3_DATA.CAR-TYPE != "    ")
        if ( VHVM1A3_DATA.CAR-TYPE == "A2" || VHVM1A3_DATA.CAR-TYPE == "B2" ||
         VHVM1A3_DATA.CAR-TYPE == "C1" || VHVM1A3_DATA.CAR-TYPE == "C2" ||
         VHVM1A3_DATA.CAR-TYPE == "D1" || VHVM1A3_DATA.CAR-TYPE == "E1" || 
         VHVM1A3_DATA.CAR-TYPE == "L1" || VHVM1A3_DATA.CAR-TYPE == "M1" ||
         VHVM1A3_DATA.CAR-TYPE == "K1" || VHVM1A3_DATA.CAR-TYPE == "K2" ||
         XXEXT_CALL_Level77Items.UEXTNAM == "VHVM01I")
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM1AA";

  
            VHVM1AA_CRIT.CAR-TYPE = VHVM1A3_DATA.CAR-TYPE;

    
            try
                call "VHVM1AA"(XDCONTROL, VHVM1AA_CRIT, VHVM1AA_DATA);
            
            end
            

    
            MRSCommonCode.XXA0IS-CHECK_EXT();

    
            if (XXEXT_CALL_Level77Items.URC == 0)
  
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    VHVM1A3_DATA.CNT-DAYS-NXT-PA = VHVM1AA_DATA.CNT-DAYS-NXT-PA;
                    VHVM1A3_DATA.CNT-DAYS-NXT-WASH = VHVM1AA_DATA.CNT-DAYS-NXT-WASH;
                    VHVM1A3_DATA.HRS-TO-NEXT-PM = VHVM1AA_DATA.HRS-TO-NEXT-PM;
  
                    VHVM1A3_DATA.DATE-NXT-PA-INSPC = VHVM1AA_DATA.DATE-NXT-PA;
                    VHVM1A3_DATA.DATE-NXT-CAR-WASH = VHVM1AA_DATA.DATE-NXT-WASH;
                    
     
                else

        
        
                    VHVM02IW-TRIGGERS.BAD-TYPE = "Y";
                    

  
  
  
  
                end 
            end
        else
            VHVM02IW-TRIGGERS.BAD-TYPE = "Y";
        end 
    end
end 

