    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHVM19IS-CLEAR () 
    set VHVM19A_DATA empty;
    set VHVM19B_CRIT empty;
    set VHVM19B_DATA empty;
    set VHVM19IW-SELECT empty;
    VHVM19A_CRIT.CON-NO-BEG = " ";
    VHVM19A_CRIT.CON-NO-END = " ";
    VHVM19IW.ROW-COUNT = 1;
    VHVM19IW-TRIGGERS.LOAD-DATA = "Y";
end 

Function VHVM19IS-MOD-DATA ()
  
  
  
  
  
  
  
  
  
  
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM19I";

  
  
  

  
    VHVM19B_CRIT.CON-NO = VHVM19IW-SELECT.CON-NO;
    VHVM19B_CRIT.DASH-NO = VHVM19IW-SELECT.DASH-NO;
    VHVM19B_CRIT.TIME-INSRV = VHVM19IW-SELECT.TIME-INSRV;
    VHVM19B_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
    VHVM19B_CRIT.TERM-MAINT-UPD = VH01A01_DATA.TERM-ID;

  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHVM19IW-SELECT.DATE-INSRV;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM19B_CRIT.DATE-INSRV = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.DATE-MM-DD-YYYY = VHVM19IW-SELECT.DATE-INSRV-REV;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM19B_CRIT.DATE-INSRV-REV = XXDATEW.DATE-YYYY-MM-DD;

  
    if (VHVM19B_DATA.DATE-INSRV-ICS != " ")
        XXDATEW.DATE-MM-DD-YYYY = VHVM19B_DATA.DATE-INSRV-ICS;
        MRSCommonCode.XXDATES-CONVERT();
        VHVM19B_DATA.DATE-INSRV-ICS = XXDATEW.DATE-YYYY-MM-DD;
    end

  
    if (XDCONTROL.UFUNCTION == "UPDATE" || XDCONTROL.UFUNCTION == "ADD")
        if (VHVM19B_DATA.CON-STAT not blanks)


  
            if (XDCONTROL.UFUNCTION == "UPDATE")
                try
                    call "VHVM19B"(XDCONTROL, VHVM19B_CRIT, VHVM19B_DATA);
                
                end
                if (XXEXT_CALL_Level77Items.URC == 0)

  
                    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                        VHVM19IW-TRIGGERS.UPDATED = "Y";
                        VHVM19IW-SELECT_Level77Items.SELECTION-IDX = 0;
                        XDCONTROL.UFUNCTION = "RETRIEVE";
                        VHVM19IW.MSG = "The Consist History Record was Updated ";
                    else
                        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    end 
                end
            end
  
        else
  
            VHVM19IW-TRIGGERS.DATA-ERROR = "Y";
            

  
  
        end
    end
  
    if (XDCONTROL.UFUNCTION == "RETRIEVE")
        try
            call "VHVM19A"(XDCONTROL, VHVM19A_CRIT, VHVM19A_DATA);
        
        end
        if (XXEXT_CALL_Level77Items.URC == 0)

  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHVM19IW-TRIGGERS.LOAD-DATA = "Y";
                VHVM19IW-TRIGGERS.DESELECT-ALL-ITEMS = "Y";
                set VHVM19IW-SELECT empty;
                set VHVM19B_DATA empty;
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

Function VHVM19IS-RET-DATA () 
    VHVM19IW.ROW-COUNT = 0;
    VHVM19IW.MSG = " ";
    if (VHVM19A_CRIT.CON-NO-BEG != "   ") 
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHVM19IW.REV-DATE-MMDDYYYY;
        MRSCommonCode.XXDATES-CONVERT();
        VHVM19A_CRIT.REV-DATE = XXDATEW.DATE-YYYY-MM-DD;
        if (VHVM19A_CRIT.CON-NO-END == "   ")
            VHVM19A_CRIT.CON-NO-END = VHVM19A_CRIT.CON-NO-BEG;
        end
        try
            call "VHVM19A"(XDCONTROL, VHVM19A_CRIT, VHVM19A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHVM19IW.ROW-COUNT = XDCONTROL.UROWCNT;
            VHVM19IW-TRIGGERS.LOAD-DATA = "Y";
            VHVM19IW.RETURNED-DATA = "Y";
        else
            VHVM19IW.MSG = "No Data Available For the Selected Criteria";
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
  
        if (VHVM19A_DATA.CON-NO[150] != "   ")
            VHVM19IW.MSG = "You Have Exceeded the Max Number of Rows of 188";
        end
    end
end 

Function VHVM19IS-REV-DATE ()
  
   
    set VHYT34A_DATA empty;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT34A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHIE01I";
    set VHYT34A_DATA empty;

    
    try
        call "MrsYardTrackingQueries.VHYT34A"(XDCONTROL, VHYT34A_CRIT, VHYT34A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end

  
    if (VHYT34A_DATA.CURRENT-TIME > VHYT34A_DATA.TIME-REV-END)
        VHVM19IW.REV-DATE = VHYT34A_DATA.CURRENT-DATE;
    else
        VHVM19IW.REV-DATE = VHYT34A_DATA.YESTERDAY;
    end

  
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHVM19IW.REV-DATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM19IW.REV-DATE-MMDDYYYY = XXDATEW.DATE-MM-DD-YYYY;
end 

Function VHVM19IS-SELECT () 
    if (SELECTION-IDX > 0)
        VHVM19IW-SELECT.DATA_ROW = VHVM19A_DATA.DATA_ROW[SELECTION-IDX];
        VHVM19IW-TRIGGERS.ENABLE-UPDATE = "Y";
    end
end 

Function VHVM19IS-UPDATE () 
    XDCONTROL.UFUNCTION = "UPDATE";
end
