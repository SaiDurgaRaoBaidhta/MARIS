            if (VHVM11A_CRIT.MAX-ROWS-EXCEEDED == "Y")
                VHVM11IW-WORKING.MSG = "TOTAL ROWS SELECTED EXCEEDS THE MAX ROWS OF 117";
            end
            
   
        
        else

        
        
  
            VHVM11IW-WORKING.MSG = "THERE WAS NO DATA SELECTED WITH YOUR SEARCH CRITERIA";
            
  
  
  
  
        end 
    end

  
    VHVM11IW-SELECT.EVENT-STAT = VHVM11IW-PASS-DATA.EVENT-STAT;
    VHVM11IW-SELECT.EVENT-TYPE = VHVM11IW-PASS-DATA.EVENT-TYPE;
    VHVM11IW-SELECT.CAR-NO = VHVM11IW-PASS-DATA.CAR-NO;
    VHVM11IW-SELECT.INCD-NO = VHVM11IW-PASS-DATA.INCD-NO;

  
    if (VHVM11IW-PASS-DATA.DATE-INITIALIZED == " ")
        VHVM11IW-SELECT.DATE-INITIALIZED = VHVM11IW-WORKING.DATE-TO;
    else
        VHVM11IW-SELECT.DATE-INITIALIZED = VHVM11IW-PASS-DATA.DATE-INITIALIZED;
    end

  
    VHVM11IW-TRIGGERS.ENABLE-ADD = "Y";
    VHVM11IW-TRIGGERS.DISABLE-UPDATE = "Y";
    VHVM11IW-TRIGGERS.SET-FOCUS-STK = "Y";
    if (VHVM11IW-PASS-DATA.EVENT-TYPE == "BAT")
        VHVM11IW-TRIGGERS.SHOW-LOC-DROPDOWN = "Y";
        VHVM11IW-TRIGGERS.HIDE-LOC-TEXT = "Y";
    else
        VHVM11IW-TRIGGERS.HIDE-LOC-DROPDOWN = "Y";
        VHVM11IW-TRIGGERS.SHOW-LOC-TEXT = "Y";
    end
end 

Function VHVM11I-GET-DATA3 ()
  
   
    set VHVM11A_CRIT empty;
  

  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = "01-01-2000";
    MRSCommonCode.XXDATES-CONVERT();
    VHVM11A_CRIT.DATE-FROM = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-WORKING.DATE-TO;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM11A_CRIT.DATE-TO = XXDATEW.DATE-YYYY-MM-DD;

  
  
    VHVM11A_CRIT.CAR-NO = VHVM11IW-PASS-DATA.CAR-NO;
    VHVM11IW-WORKING.CAR-NO = VHVM11IW-PASS-DATA.CAR-NO;

  
    VHVM11A_CRIT.BEG-CAR-TYPE = "A1";
    VHVM11A_CRIT.END-CAR-TYPE = "C2";

  
    VHVM11A_CRIT.HOME-YRD = "  ";

  
    VHVM11A_CRIT.EVENT-TYPE = "MOD";
    VHVM11IW-WORKING.EVENT-TYPE = "MOD";

  
    VHVM11A_CRIT.EVENT-STAT = "OPEN       ";
    VHVM11IW-WORKING.EVENT-STAT = "OPEN";

  
    VHVM11A_CRIT.CURR-LOC = "       ";
    VHVM11A_CRIT.TRKG-REF-NO = " ";
    VHVM11A_CRIT.SORT-ORDER = 2;
    VHVM11IW-TRIGGERS.FOUND-MODS = "N"; 
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11A";

  
    try
        call "VHVM11A"(XDCONTROL, VHVM11A_CRIT, VHVM11A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHVM11IW-TRIGGERS.FOUND-MODS = "Y";
            VHVM11IW-WORKING.MSG = " ";
            VHVM11IW-TRIGGERS.CARS-RET = "Y";
  
  
            VHVM11IW-TRIGGERS.HIDE-LOC-DROPDOWN = "Y";
            VHVM11IW-TRIGGERS.SHOW-LOC-TEXT = "Y";
            VHVM11IW-WORKING.NUM-CARS = XDCONTROL.UROWCNT;
            if (VHVM11A_CRIT.MAX-ROWS-EXCEEDED == "Y")
                VHVM11IW-WORKING.MSG = "TOTAL ROWS SELECTED EXCEEDS THE MAX ROWS OF 117";
            end
            
   
        
        else
            VHVM11IW-TRIGGERS.FOUND-MODS = "N";
        
        
  
            VHVM11IW-WORKING.MSG = "THERE WAS NO DATA SELECTED WITH YOUR SEARCH CRITERIA";
            
  
  
  
  
        end 
    end


  
  
    if (VHVM11IW-TRIGGERS.FOUND-MODS == "Y")
        MOD-INDEX = 0;
        JCT = 1;
        while (JCT <= VHVM11IW-WORKING.NUM-CARS && VHVM11IW-WORKING.MOD-INDEX == 0)
            if (VHVM11A_DATA.INCD-NO[JCT] == " ")
                move JCT to MOD-INDEX withV60Compat;
            end 
            JCT = JCT + 1;
        end
         
    end 

  
    if (VHVM11IW-WORKING.MOD-INDEX > 0)
        move MOD-INDEX to SELECT-INDEX withV60Compat;
        VHVM11IW-SELECT.EVENT-STAT = VHVM11A_DATA.EVENT-STAT[SELECT-INDEX];
        VHVM11IW-SELECT.EVENT-TYPE = VHVM11A_DATA.EVENT-TYPE[SELECT-INDEX];
        VHVM11IW-SELECT.DATE-INITIALIZED = VHVM11A_DATA.DATE-INITIALIZED[SELECT-INDEX];
        VHVM11IW-SELECT.TIME-INITIALIZED = VHVM11A_DATA.TIME-INITIALIZED[SELECT-INDEX];
        VHVM11IW-SELECT.TRKG-REF-NO = VHVM11A_DATA.TRKG-REF-NO[SELECT-INDEX];
        VHVM11IW-SELECT.DATE-CLOSED = VHVM11A_DATA.DATE-CLOSED[SELECT-INDEX];
        VHVM11IW-SELECT.TIME-CLOSED = VHVM11A_DATA.TIME-CLOSED[SELECT-INDEX];
        VHVM11IW-SELECT.CAR-NO = VHVM11A_DATA.CAR-NO[SELECT-INDEX];
        VHVM11IW-SELECT.VEH-STAT = VHVM11A_DATA.VEH-STAT[SELECT-INDEX];
        VHVM11IW-SELECT.DATE-LAST-UPD = VHVM11A_DATA.DATE-LAST-UPD[SELECT-INDEX];
        VHVM11IW-SELECT.HOME-YRD = VHVM11A_DATA.HOME-YRD[SELECT-INDEX];
  
        VHVM11IW-SELECT.INCD-NO = VHVM11IW-PASS-DATA.INCD-NO; 
        VHVM11IW-SELECT.EVENT-COMMENT = VHVM11A_DATA.EVENT-COMMENT[SELECT-INDEX];
        VHVM11IW-SELECT.LOC = VHVM11A_DATA.LOC[SELECT-INDEX];
        VHVM11IW-SELECT.LOC-CMPLT-EVENT = VHVM11A_DATA.LOC-CMPLT-EVENT[SELECT-INDEX];
        VHVM11IW-SELECT.ACTV-IND = VHVM11A_DATA.ACTV-IND[SELECT-INDEX];
        VHVM11IW-TRIGGERS.ENABLE-UPDATE = "Y";
        VHVM11IW-TRIGGERS.DISABLE-ADD = "Y";
        VHVM11IW-TRIGGERS.SET-FOCUS-STK = "Y";
    end

  
  
    if (VHVM11IW-WORKING.MOD-INDEX == 0)
  
        if (VHVM11IW-PASS-DATA.DATE-INITIALIZED == " ")
            VHVM11IW-SELECT.DATE-INITIALIZED = VHVM11IW-WORKING.DATE-TO;
        else
            VHVM11IW-SELECT.DATE-INITIALIZED = VHVM11IW-PASS-DATA.DATE-INITIALIZED;
        end
        VHVM11IW-SELECT.EVENT-STAT = "OPEN";
        VHVM11IW-SELECT.EVENT-TYPE = VHVM11IW-PASS-DATA.EVENT-TYPE;
        VHVM11IW-SELECT.CAR-NO = VHVM11IW-PASS-DATA.CAR-NO;
        VHVM11IW-SELECT.INCD-NO = VHVM11IW-PASS-DATA.INCD-NO;
        VHVM11IW-TRIGGERS.ENABLE-ADD = "Y";
        VHVM11IW-TRIGGERS.DISABLE-UPDATE = "Y";
        VHVM11IW-TRIGGERS.HIDE-LOC-DROPDOWN = "Y";
        VHVM11IW-TRIGGERS.SHOW-LOC-TEXT = "Y";
        VHVM11IW-TRIGGERS.SET-FOCUS-STK = "Y";
    end
end 

Function VHVM11I-PRINT ()
   
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-WORKING.DATE-FROM;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM11IW-PRINT.DATE-FROM-DB2 = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-WORKING.DATE-TO;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM11IW-PRINT.DATE-TO-DB2 = XXDATEW.DATE-YYYY-MM-DD;
    VHVM11IW-PRINT.DATE-FROM = VHVM11IW-WORKING.DATE-FROM;
    VHVM11IW-PRINT.DATE-TO = VHVM11IW-WORKING.DATE-TO;

  
  
  
  

  
  
  
  
    VHVM11IW-PRINT.CAR-NO = VHVM11IW-WORKING.CAR-NO;
  
    if (VHVM11IW-WORKING.CAR-TYPE == "ALL" || VHVM11IW-WORKING.CAR-TYPE == "  ")
        VHVM11IW-PRINT.BEG-CAR-TYPE = "A1";
        VHVM11IW-PRINT.END-CAR-TYPE = "C2";
    else
        VHVM11IW-PRINT.BEG-CAR-TYPE = VHVM11IW-WORKING.CAR-TYPE;
        VHVM11IW-PRINT.END-CAR-TYPE = VHVM11IW-WORKING.CAR-TYPE;
    end
    if (VHVM11IW-WORKING.HOME-YRD == "ALL")
        VHVM11IW-PRINT.HOME-YRD = "  ";
    else
        VHVM11IW-PRINT.HOME-YRD = VHVM11IW-WORKING.HOME-YRD;
    end
    if (VHVM11IW-WORKING.EVENT-TYPE == "ALL")
        VHVM11IW-PRINT.EVENT-TYPE = "    ";
    else
        VHVM11IW-PRINT.EVENT-TYPE = VHVM11IW-WORKING.EVENT-TYPE;
    end
    if (VHVM11IW-WORKING.EVENT-SUB-TYPE != " ")
        VHVM11IW-PRINT.EVENT-SUB-TYPE = VHVM11IW-WORKING.EVENT-SUB-TYPE;
    end
    if (VHVM11IW-WORKING.EVENT-STAT == "ALL")
        VHVM11IW-PRINT.EVENT-STAT = "       ";
    else
        VHVM11IW-PRINT.EVENT-STAT = VHVM11IW-WORKING.EVENT-STAT;
    end
    if (VHVM11IW-WORKING.CURR-LOC == "ALL")
        VHVM11IW-PRINT.CURR-LOC = "       ";
    else
        VHVM11IW-PRINT.CURR-LOC = VHVM11IW-WORKING.CURR-LOC;
    end
    VHVM11IW-PRINT.TRKG-REF-NO = VHVM11IW-WORKING.TRKG-REF-NO;

  
    if (VHVM11IW-WORKING.SORT-ORDER == "2")
        VHVM11IW-PRINT.SORT-ORDER = "T";
    end
    if (VHVM11IW-WORKING.SORT-ORDER == "1")
        VHVM11IW-PRINT.SORT-ORDER = "D";
    end
    if (VHVM11IW-WORKING.SORT-ORDER == "3")
        VHVM11IW-PRINT.SORT-ORDER = "S";
    end
end 

Function VHVM11I-REFRESH ()
  
  
  
  
  
  
  
  
   
    set VHVM11A_DATA empty;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11A";

  
    try
        call "VHVM11A"(XDCONTROL, VHVM11A_CRIT, VHVM11A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHVM11IW-SELECT.EVENT-STAT = "OPEN";
  
            VHVM11IW-TRIGGERS.CARS-RET = "Y";
            VHVM11IW-TRIGGERS.ENABLE-ADD = "Y";
            VHVM11IW-TRIGGERS.DISABLE-UPDATE = "Y";
            VHVM11IW-TRIGGERS.DISABLE-CREATE-ACTION = "Y";
            if (VHVM11A_CRIT.EVENT-TYPE != "BAT")
                VHVM11IW-TRIGGERS.HIDE-LOC-DROPDOWN = "Y";
                VHVM11IW-TRIGGERS.SHOW-LOC-TEXT = "Y";
            else
                VHVM11IW-TRIGGERS.SHOW-LOC-DROPDOWN = "Y";
                VHVM11IW-TRIGGERS.HIDE-LOC-TEXT = "Y";
            end
            VHVM11IW-WORKING.NUM-CARS = XDCONTROL.UROWCNT;
            if (VHVM11A_CRIT.MAX-ROWS-EXCEEDED == "Y")
                VHVM11IW-WORKING.MSG = "TOTAL ROWS SELECTED EXCEEDS THE MAX ROWS OF 154";
            end
            
   
        
        else

        
        
            VHVM11IW-TRIGGERS.PUSH-ZERO = "Y";
            
  
  
  
  
  
  
  
        end 
    end
    VHVM11IW-WORKING.RUN-DATE = VGVar.currentFormattedGregorianDate;
end 

Function VHVM11I-REMOVE () 
    set VHVM11C_DATA empty;
    VHVM11C_CRIT.REMOVED-FLAG = "Y";

  
    if (VHVM11IW-SELECT.INCD-NO-PREFIX == "I")
        VHVM11C_CRIT.I-INCIDENT-FLAG = "Y";
    else
        VHVM11C_CRIT.I-INCIDENT-FLAG = "N";
    end
    if (VHVM11IW-SELECT.CAR-NO != " " && VHVM11IW-SELECT.EVENT-STAT != " " && VHVM11IW-SELECT.EVENT-TYPE != " " && VHVM11IW-SELECT.TRKG-REF-NO != " ")

  
        XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-SELECT.DATE-INITIALIZED;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHVM11C_DATA.DATE-INITIALIZED = XXDATEW.DATE-YYYY-MM-DD;
  
  
  

  
        if (VHVM11IW-SELECT.DATE-CLOSED != "          ")
            XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-SELECT.DATE-CLOSED;
            XXDATEW.VAGen_FUNCTION = "YMD";
            MRSCommonCode.XXDATES-CONVERT();
            VHVM11C_DATA.DATE-CLOSED = XXDATEW.DATE-YYYY-MM-DD;
        end 
        VHVM11C_DATA.TERM-LAST-UPD = VHVM11IW-PASSVALUE.TERM-ID;
        VHVM11C_DATA.EVENT-STAT = VHVM11IW-SELECT.EVENT-STAT;
        VHVM11C_DATA.EVENT-TYPE = VHVM11IW-SELECT.EVENT-TYPE;
        VHVM11C_DATA.TRKG-REF-NO = VHVM11IW-SELECT.TRKG-REF-NO;
        VHVM11C_DATA.CAR-NO = VHVM11IW-SELECT.CAR-NO;
        VHVM11C_DATA.DATE-LAST-UPD = VHVM11IW-SELECT.DATE-LAST-UPD;
        VHVM11C_DATA.INCD-NO = VHVM11IW-SELECT.INCD-NO;
        VHVM11C_DATA.EVENT-COMMENT = VHVM11IW-SELECT.EVENT-COMMENT;
  
        VHVM11C_DATA.LOC-CMPLT-EVENT = VHVM11IW-SELECT.LOC-CMPLT-EVENT;
        VHVM11C_DATA.TIME-INITIALIZED = VHVM11IW-SELECT.TIME-INITIALIZED;
        VHVM11C_DATA.ACTV-IND = "N";

  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11C";
        try
            call "VHVM11C"(XDCONTROL, VHVM11C_CRIT, VHVM11C_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHVM11IW-WORKING.MSG = "Event Entry Has Been REMOVED From  the AWP and Mod Tracking File";
                VHVM11C_CRIT.REMOVED-FLAG = "N";
                VHVM11IW-TRIGGERS.REFRESH-LIST = "Y";
            else

        
        
                if (XDCONTROL.UMSGINS[1] == "-803")
                    VHVM11IW-TRIGGERS.DUP-ADD = "Y";
                else
                    VHVM11IW-TRIGGERS.ERROR-ADD = "Y";
                end
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end

  
        set VHVM11IW-SELECT empty;
    else

  
        VHVM11IW-WORKING.MSG = "Please Provide ALL Esential Data";
    end
end 

Function VHVM11I-SELECT () 
    if (SELECT-INDEX > 0)
  
  
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHVM11A_DATA.DATE-INITIALIZED[SELECT-INDEX];
        MRSCommonCode.XXDATES-CONVERT();
        VHVM11H_CRIT.DATE-INITIALIZED = XXDATEW.DATE-YYYY-MM-DD;
        VHVM11H_CRIT.TIME-INITIALIZED = VHVM11A_DATA.TIME-INITIALIZED[SELECT-INDEX];
        VHVM11H_CRIT.CAR-NO = VHVM11A_DATA.CAR-NO[SELECT-INDEX];
        XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11H";

  


  
        try
            call "VHVM11H"(XDCONTROL, VHVM11H_CRIT, VHVM11H_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

       
                VHVM11IW-SELECT.EVENT-COMMENT = VHVM11H_DATA.EVENT-COMMENT;
            end 

        
        else

        
        
            VHVM11IW-WORKING.MSG = "The Event type data is not on file";
            

  
  
  
  
        end
  
  
        VHVM11IW-WORKING.MSG = " ";

  
        if (VHVM11A_DATA.EVENT-TYPE[SELECT-INDEX] == "BAT")
            VHVM11IW-TRIGGERS.SHOW-LOC-DROPDOWN = "Y";
            VHVM11IW-TRIGGERS.HIDE-LOC-TEXT = "Y";
        else
            VHVM11IW-TRIGGERS.HIDE-LOC-DROPDOWN = "Y";
            VHVM11IW-TRIGGERS.SHOW-LOC-TEXT = "Y";
        end
  
        VHVM11IW-SELECT.EVENT-STAT = VHVM11A_DATA.EVENT-STAT[SELECT-INDEX];
        VHVM11IW-SELECT.EVENT-TYPE = VHVM11A_DATA.EVENT-TYPE[SELECT-INDEX];
        VHVM11IW-SELECT.EVENT-SUB-TYPE = VHVM11A_DATA.EVENT-SUB-TYPE[SELECT-INDEX];
  
        VHVM11IW-SELECT.DATE-INITIALIZED = VHVM11A_DATA.DATE-INITIALIZED[SELECT-INDEX];
        VHVM11IW-SELECT.TIME-INITIALIZED = VHVM11A_DATA.TIME-INITIALIZED[SELECT-INDEX];
        VHVM11IW-SELECT.TRKG-REF-NO = VHVM11A_DATA.TRKG-REF-NO[SELECT-INDEX];
        VHVM11IW-SELECT.DATE-CLOSED = VHVM11A_DATA.DATE-CLOSED[SELECT-INDEX];
        VHVM11IW-SELECT.TIME-CLOSED = VHVM11A_DATA.TIME-CLOSED[SELECT-INDEX];
        VHVM11IW-SELECT.CAR-NO = VHVM11A_DATA.CAR-NO[SELECT-INDEX];

  
        set VHVM11C_CRIT empty;
        VHVM11C_CRIT.CAR-NO = VHVM11A_DATA.CAR-NO[SELECT-INDEX];
  
        VHVM11IW-SELECT.VEH-STAT = VHVM11A_DATA.VEH-STAT[SELECT-INDEX];
        VHVM11IW-SELECT.DATE-LAST-UPD = VHVM11A_DATA.DATE-LAST-UPD[SELECT-INDEX];
        VHVM11IW-SELECT.HOME-YRD = VHVM11A_DATA.HOME-YRD[SELECT-INDEX];
        VHVM11IW-SELECT.INCD-NO = VHVM11A_DATA.INCD-NO[SELECT-INDEX];
        VHVM11IW-SELECT.EVENT-COMMENT = VHVM11A_DATA.EVENT-COMMENT[SELECT-INDEX];
        VHVM11IW-SELECT.LOC = VHVM11A_DATA.LOC[SELECT-INDEX];
        VHVM11IW-SELECT.LOC-CMPLT-EVENT = VHVM11A_DATA.LOC-CMPLT-EVENT[SELECT-INDEX];
        VHVM11IW-SELECT.ACTV-IND = VHVM11A_DATA.ACTV-IND[SELECT-INDEX];

  
        if (VHVM11IW-SELECT.INCD-NO-PREFIX == "I")
            VHVM11IW-TRIGGERS.DISABLE-CREATE-ACTION = "Y";
        else
            VHVM11IW-TRIGGERS.ENABLE-CREATE-ACTION = "Y";
        end
        VHVM11IW-TRIGGERS.ENABLE-UPDATE = "Y";
        VHVM11IW-TRIGGERS.ENABLE-DELETE = "Y";
        VHVM11IW-TRIGGERS.DISABLE-ADD = "Y";
        VHVM11IW-TRIGGERS.DISABLE-FIELD = "Y";
        if (VHVM11A_DATA.EVENT-TYPE[SELECT-INDEX] == "BAT")
            VHVM11IW-PASSVALUE.EVENT-TYPE = VHVM11A_DATA.EVENT-TYPE[SELECT-INDEX];
            VHVM11IW-TRIGGERS.SHOW-LOC-DROPDOWN = "Y";
            VHVM11IW-TRIGGERS.HIDE-LOC-TEXT = "Y";
            VHVM11IW-TRIGGERS.DISABLE-CREATE-ACTION = "Y";
            VHVM11IW-SELECT.EVENT-STAT = "CLOSED";
  
            VHVM11IW-TRIGGERS.SHOW-LOC-TEXT = "Y";
        end
        if (VHVM11A_DATA.EVENT-TYPE[SELECT-INDEX] != "BAT")
            if (VHVM11IW-SELECT.DATE-CLOSED == " ")
   
  
  
  
  
  
  

            end
        end

  
        EVENT-INDEX = 1;
        POINTER = 1;
        while (POINTER <= 10)
            if (VHVM11IW-SELECT.EVENT-TYPE == VHVM11IW-EVENT.EVENT-TYPE[POINTER] &&
             VHVM11IW-SELECT.EVENT-SUB-TYPE == VHVM11IW-EVENT.EVENT-SUB-TYPE[POINTER])
                move POINTER to EVENT-INDEX withV60Compat;
            end
            POINTER = POINTER + 1;
        end 

  
        if (VHVM11A_DATA.EVENT-TYPE[SELECT-INDEX] == "BAT")
            VHVM11IW-TRIGGERS.RUN-BATTERY-CHECK = "Y";
        end
        

  
  
  
    end
end 

Function VHVM11I-STOCK ()
  

  
  

   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11L";
    

  
    set VHVM11L_DATA empty;
    

  
    try
        call "VHVM11L"(XDCONTROL, VHVM11L_CRIT, VHVM11L_DATA);
    
    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

  

        end 

        
    else

        
        
        VHVM11IW-WORKING.MSG = "The Event type data is not on file";
        

  
  
  
  
    end
    if (VHVM11L_CRIT.STOCK-NO != VHVM11L_DATA.STOCK-NO)
        VHVM11IW-WORKING.STOCK-NO-FAILED = "Y";
        VHVM11IW-WORKING.MSG = "THE STOCK NUMBER YOU ENTERED CANNOT BE VALIDATED IN MRS_VEH_STOCK";
        return;
    end
end 

Function VHVM11I-UPDATE () 
    if (VHVM11IW-SELECT.EVENT-TYPE == "BAT")
        VHIM11IS-BAT();
    end

  
    if (VHVM11IW-SELECT.EVENT-TYPE == VHVM11B_DATA.EVENT-TYPE)
        VHVM11IW-WORKING.STOCK-NO-FAILED = "N";
        VHVM11L_CRIT.STOCK-NO = VHVM11B_DATA.TRKG-REF-NO;

  
  
  
  
        if (VHVM11IW-WORKING.STOCK-NO-FAILED != "Y") 
            set VHVM11C_DATA empty;
            if (VHVM11IW-SELECT.CAR-NO != " " && VHVM11IW-SELECT.EVENT-STAT != " " && VHVM11IW-SELECT.EVENT-TYPE != " " && VHVM11IW-SELECT.TRKG-REF-NO != " ")
                VHVM11C_CRIT.UPDATE-FLAG = "Y"; 
  
                XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-SELECT.DATE-INITIALIZED;
                XXDATEW.VAGen_FUNCTION = "YMD";
                MRSCommonCode.XXDATES-CONVERT();
                VHVM11C_DATA.DATE-INITIALIZED = XXDATEW.DATE-YYYY-MM-DD;
  
  
  

  
                if (VHVM11IW-SELECT.DATE-CLOSED != "          ")
                    XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-SELECT.DATE-CLOSED;
                    XXDATEW.VAGen_FUNCTION = "YMD";
                    MRSCommonCode.XXDATES-CONVERT();
                    VHVM11C_DATA.DATE-CLOSED = XXDATEW.DATE-YYYY-MM-DD;
                end 

  
                VHVM11C_DATA.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
                VHVM11C_DATA.EVENT-STAT = VHVM11IW-SELECT.EVENT-STAT;
                if (VHVM11IW-SELECT.EVENT-TYPE == "AWP") 
                    VHVM11C_DATA.EVENT-TYPE = VHVM11B_DATA.EVENT-TYPE;
                    VHVM11C_DATA.EVENT-SUB-TYPE = VHVM11B_DATA.EVENT-SUB-TYPE;
                else
                    VHVM11C_DATA.EVENT-TYPE = VHVM11IW-SELECT.EVENT-TYPE;
                    VHVM11C_DATA.EVENT-SUB-TYPE = VHVM11IW-SELECT.EVENT-SUB-TYPE;
                end
                VHVM11C_DATA.TRKG-REF-NO = VHVM11IW-SELECT.TRKG-REF-NO;
                VHVM11C_DATA.CAR-NO = VHVM11IW-SELECT.CAR-NO;
                VHVM11C_DATA.DATE-LAST-UPD = VHVM11IW-SELECT.DATE-LAST-UPD;
                VHVM11C_DATA.INCD-NO = VHVM11IW-SELECT.INCD-NO;
                VHVM11C_DATA.EVENT-COMMENT = VHVM11IW-SELECT.EVENT-COMMENT;
  
                VHVM11C_DATA.LOC-CMPLT-EVENT = VHVM11IW-SELECT.LOC-CMPLT-EVENT;
                VHVM11C_DATA.TIME-INITIALIZED = VHVM11IW-SELECT.TIME-INITIALIZED;
                VHVM11C_DATA.ACTV-IND = "Y";


  
                XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
                XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11C";
                try
                    call "VHVM11C"(XDCONTROL, VHVM11C_CRIT, VHVM11C_DATA);
                
                end
                

    
                MRSCommonCode.XXA0IS-CHECK_EXT();

    
                if (XXEXT_CALL_Level77Items.URC == 0)
  
                    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                        VHVM11IW-TRIGGERS.REFRESH-LIST = "Y";
                        VHVM11IW-WORKING.MSG = "Event Entry Has Been UPDATED in the Vehicle Parts and Mod Tracking File";
                        VHVM11C_CRIT.UPDATE-FLAG = "N";
                        VHVM11IW-TRIGGERS.CLEAR-SELECT = "Y";
                    else

        
        
                        if (XDCONTROL.UMSGINS[1] == "-803")
                            VHVM11IW-TRIGGERS.DUP-ADD = "Y";
                        else
                            VHVM11IW-TRIGGERS.ERROR-ADD = "Y";
                        end
                        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    end
                end
            else

  
                VHVM11IW-WORKING.MSG = "Please Provide ALL Esential Data";
            end
             
        end
         

   
    else
        VHVM11IW-WORKING.MSG = "You Cannot Change Event Types only Sub-types within an Event";
    end
end 

Function VHVM11I-UP_CLOSE ()
  


  
  
  
  

  


  
  
  
  
   
    if (VHVM11IW-SELECT.EVENT-STAT == "OPEN" && VHVM11IW-SELECT.DATE-CLOSED != " ")
        VHVM11IW-WORKING.MSG = "YOU HAVE ENTERED A CLOSED DATE, BUT THE EVENT STATUS IS OPEN PLEASE FIX";
    else
        if (VHVM11IW-SELECT.EVENT-STAT == "OPEN")
            VHVM11IW-TRIGGERS.RUN-UPDATE = "Y";
        end
        if (VHVM11IW-SELECT.EVENT-STAT == "CLOSED")
            VHVM11IW-TRIGGERS.RUN-PRE-CLOSE = "Y";
        end
    end
end 

Function VHVM11I-VALID-CAR () 
    if (VHVM11B_DATA.CAR-NO != "    ") 
  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHVM03I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM1A5";

  
        VHVM1A5_DATA.CAR-NO = VHVM11B_DATA.CAR-NO;

  
        try
            call "VHVM1A5"(XDCONTROL, VHVM1A5_CRIT, VHVM1A5_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)


  
                VHVM11IW-WORKING.CAR-FAILED = "N";
                VHVM11IW-WORKING.MSG = " ";
            else
                VHVM11IW-WORKING.MSG = "The Car Number You Entered Does Not Exist";
                VHVM11IW-TRIGGERS.BAD-CAR = "Y";
                VHVM11IW-WORKING.CAR-FAILED = "Y";
            end 

        
        else

        
        
  
            VHVM11IW-WORKING.MSG = "The Car Number You Entered Does Not Exist";
            

  
  
  
  
        end 
    else
        VHVM11IW-WORKING.MSG = "Valid Car Number is Required";
    end
end 

Function VHVM11I-VALID-DATE ()
  
   
    set VHVM11IW-VDATE empty;
    VHVM11IW-WORKING.DATE-OK = "Y";
    if (VHVM11IW-SELECT.DATE-CLOSED != "          ")
        VHVM11IW-VDATE.ENTRY-DATE = VHVM11IW-SELECT.DATE-CLOSED;

  
        if (VHVM11IW-VDATE.ENTRY-REST != "  ")
            move ENTRY-DATE to EXIT-DATE withV60Compat;
        end

  
        if (VHVM11IW-VDATE.ENTRY-YEAR2 == "  ")
            move ENTRY-MO to EXIT-MO withV60Compat;
            EXIT-DASH1 = "-";
            move ENTRY-DAY to EXIT-DAY withV60Compat;
            EXIT-DASH2 = "-";
            move ENTRY-YEAR1 to ENTRY-YEAR2 withV60Compat;
            ENTRY-YEAR1 = "20";
            move ENTRY-YEAR to EXIT-YEAR withV60Compat;
        end

  
        if (VHVM11IW-VDATE.ENTRY-REST == "  ")
            move ENTRY-MO to EXIT-MO withV60Compat;
            EXIT-DASH1 = "-";
            move ENTRY-DAY to EXIT-DAY withV60Compat;
            EXIT-DASH2 = "-";
            move ENTRY-YEAR to EXIT-YEAR withV60Compat;
        end
        if (NUM-MO < 1 || NUM-MO > 12)
            VHVM11IW-WORKING.MSG = "You have entered an Invalid Month ";
            VHVM11IW-WORKING.DATE-OK = "N";
        end
        if (NUM-DAY < 1 || NUM-DAY > 31)
            VHVM11IW-WORKING.MSG = "You have entered an Invalid DAY ";
            VHVM11IW-WORKING.DATE-OK = "N";
        end
        if (NUM-YEAR < 2000)
            VHVM11IW-WORKING.MSG = "You have entered an Invalid Year ";
            VHVM11IW-WORKING.DATE-OK = "N";
        end

  
        move EXIT-YEAR to E-YEAR withV60Compat;
        move EXIT-MO to E-MO withV60Compat;
        move EXIT-DAY to E-DAY withV60Compat;
        VHVMDTA_CRIT.CURR-YYYY = VHVMDTA_CRIT.CURRENT-YYYY;
        VHVMDTA_CRIT.CURR-MM = VHVMDTA_CRIT.CURRENT-MM;
        VHVMDTA_CRIT.CURR-DD = VHVMDTA_CRIT.CURRENT-DD;
        E-DATE-TODAY = VHVMDTA_CRIT.CURRENT-DATE-8;
        if (E-DATE-COMPARE > E-DATE-TODAY)
            VHVM11IW-WORKING.MSG = "You have entered a Date Grater Than Todays Dater ";
            VHVM11IW-WORKING.DATE-OK = "N";
        end
        if (VHVM11IW-WORKING.DATE-OK == "Y") 
            VHVM11IW-SELECT.DATE-CLOSED = VHVM11IW-VDATE.EXIT-DATE;
        end
    else
        if (VHVM11IW-SELECT.EVENT-TYPE == "BAT" && VHVM11IW-SELECT.DATE-CLOSED == "  ")
            VHVM11IW-WORKING.MSG = "You Must Specify a CLOSED DATE  For the Battery Replacement";
            VHVM11IW-TRIGGERS.NEED-BATTERY-LOC = "Y";
            VHVM11IW-WORKING.DATE-OK = "N";
        end
    end
end 

