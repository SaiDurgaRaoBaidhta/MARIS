Function VHVM02IS-BDATE ()
  
  


  
   
    VHVM1A3_DATA.DATE-BATTERY-REPL = VGVar.currentFormattedGregorianDate;
end 


Function VHVM02IS-CLEAR () 
    set VHVM1A3_DATA empty;
    VHVM1A3_DATA.BATTERY-REPL-IND = "N";
    VHVM1A3_DATA.WAR-IND = "Y";
