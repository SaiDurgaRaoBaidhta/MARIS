    VHVM03-SCH-PM-2.PM-COUNTER-2 = 11;
    VHVM03-SCH-PM-3.SCHD-PM-3[1] = "  ";
    VHVM03-SCH-PM-3.SCHD-PM-3[2] = "1 ";
    VHVM03-SCH-PM-3.SCHD-PM-3[3] = "2 ";
    VHVM03-SCH-PM-3.SCHD-PM-3[4] = "3 ";
    VHVM03-SCH-PM-3.SCHD-PM-3[5] = "4 ";
    VHVM03-SCH-PM-3.SCHD-PM-3[6] = "5 ";
    VHVM03-SCH-PM-3.SCHD-PM-3[7] = "6 ";
    VHVM03-SCH-PM-3.SCHD-PM-3[8] = "A ";
    VHVM03-SCH-PM-3.SCHD-PM-3[9] = "B ";
    VHVM03-SCH-PM-3.SCHD-PM-3[10] = "C ";
    VHVM03-SCH-PM-3.SCHD-PM-3[11] = "D ";
