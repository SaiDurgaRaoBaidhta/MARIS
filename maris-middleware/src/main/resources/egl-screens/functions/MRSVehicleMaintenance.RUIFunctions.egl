                end
                if (XXEXT_CALL_Level77Items.URC == 0)

  
                    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                        VHVM10IW-TRIGGERS.ADDED = "Y";
                        VHVM10IW-SELECT_Level77Items.SELECTION-IDX = 0;
                        XDCONTROL.UFUNCTION = "RETRIEVE";
                        VHVM10IW.ROW-COUNT = VHVM10IW.ROW-COUNT + 1;
                    else
                        if (XDCONTROL.UMSGINS[1] == "-803")
                            VHVM10IW-TRIGGERS.DUPLICATE-KEY = "Y";
                        else
                            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                        end 
                    end
                end
            end
        else
  
            VHVM10IW-TRIGGERS.DATA-ERROR = "Y";
            

  
  
        end
    else

  
        if (XDCONTROL.UFUNCTION == "DELETEZZ")
            try
                call "MRSAFCMaintenance.AFC5304"(XDCONTROL, VHVM10C_DATA);
            
            end
            if (XXEXT_CALL_Level77Items.URC == 0)
     
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    XDCONTROL.UFUNCTION = "RETRIEVE";
                    XXMESSAGE.UMSGCODE = "RECORD DELETED";
                    XXMESSAGE.UMSGINS[1] = "Status Change";
                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end 
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end
    end
  
    if (XDCONTROL.UFUNCTION == "RETRIEVE")
        try
            call "VHVM10A"(XDCONTROL, VHVM10A_CRIT, VHVM10A_DATA);
        
        end
        if (XXEXT_CALL_Level77Items.URC == 0)

  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHVM10IW-TRIGGERS.LOAD-DATA = "Y";
                VHVM10IW-TRIGGERS.PUSH-CLEAR = "Y";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

Function VHVM10IS-OUT-DATE ()
  
  

   
    if (VHVM10C_DATA.CON-STAT == "OUT" && VHVM10IW.DATE-OUTSRV == "          ")
        VHVM10C_DATA.DATE-OUTSRV = VHVM10IW-SELECT.DATE-INSRV-REV;
        VHVM10IW.DATE-OUTSRV = VHVM10C_DATA.DATE-OUTSRV;
         
    else
        VHVM10C_DATA.DATE-OUTSRV = VHVM10IW-SELECT.DATE-OUTSRV;
    end
end 

Function VHVM10IS-RET-DATA () 
    VHVM10IW.ROW-COUNT = 0;
    if (VHVM10A_CRIT.CON-NO-BEG != "   ")
        if (VHVM10A_CRIT.CON-NO-END == "   ")
            VHVM10A_CRIT.CON-NO-END = VHVM10A_CRIT.CON-NO-BEG;
        end
        try
            call "VHVM10A"(XDCONTROL, VHVM10A_CRIT, VHVM10A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHVM10IW.ROW-COUNT = XDCONTROL.UROWCNT;
            VHVM10IW-TRIGGERS.LOAD-DATA = "Y";
            VHVM10IW.RETURNED-DATA = "Y";
        else
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
  
        if (VHVM10A_DATA.CON-NO[182] != "   ")
            VHVM10IW-TRIGGERS.SHOW-MSG = "Y";
        end
    end
end 

Function VHVM10IS-SELECT () 
    if (SELECTION-IDX > 0)
        VHVM10IW-SELECT.DATA_ROW = VHVM10A_DATA.DATA_ROW[SELECTION-IDX];
        VHVM10IW-TRIGGERS.ENABLE-UPDATE = "Y";
    end
end 

Function VHVM10IS-UPDATE () 
    XDCONTROL.UFUNCTION = "UPDATE";
end 

Function VHVM11I-ADD ()
  
  
  
  
  
  
  
  
  
   
    VHVM11IW-WORKING.STOCK-NO-FAILED = "N";
    VHVM11L_CRIT.STOCK-NO = VHVM11B_DATA.TRKG-REF-NO;

  
  
  
  
    if (VHVM11IW-WORKING.STOCK-NO-FAILED != "Y") 
        if (VHVM11B_DATA.CAR-NO != " " && VHVM11B_DATA.EVENT-STAT != " " && VHVM11B_DATA.EVENT-TYPE != " " && VHVM11B_DATA.TRKG-REF-NO != " ")

  
            XXDATEW.DATE-MM-DD-YYYY = VHVM11B_DATA.DATE-INITIALIZED;
            XXDATEW.VAGen_FUNCTION = "YMD";
            MRSCommonCode.XXDATES-CONVERT();
            VHVM11B_DATA.DATE-INITIALIZED-DB2 = XXDATEW.DATE-YYYY-MM-DD;
            VHVM11B_DATA.DATE-REMOVED = "0001-01-01";
            VHVM11B_DATA.TIME-REMOVED = "00.00.00";
            VHVM11B_DATA.ACTV-IND = "Y";
            VHVM11B_DATA.TERM-LAST-UPD = VHVM11IW-PASSVALUE.TERM-ID;


  
            XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11B";
            try
                call "VHVM11B"(XDCONTROL, VHVM11B_DATA);
            
            end
            

    
            MRSCommonCode.XXA0IS-CHECK_EXT();

    
            if (XXEXT_CALL_Level77Items.URC == 0)
  
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    VHVM11IW-TRIGGERS.REFRESH-LIST = "Y";
                    VHVM11IW-WORKING.MSG = "Event Type Has Been Added to Vehicle Parts and Mod Tracking File";
                    set VHVM11B_DATA empty;
                else

        
        
                    if (XDCONTROL.UMSGINS[1] == "-803")
                        VHVM11IW-TRIGGERS.DUP-ADD = "Y";
                    else
                        VHVM11IW-TRIGGERS.ERROR-ADD = "Y";
                    end
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end
        else

  
            VHVM11IW-WORKING.MSG = "Some of the Required Data is Missing ";
        end 
    end
end 

Function VHVM11I-BAT-SEL ()
  
  
  


  
  
   
    if (VHVM11IW-SELECT.BATTERY-LOC != "CY" || VHVM11IW-SELECT.BATTERY-LOC != "DY" || VHVM11IW-SELECT.BATTERY-LOC != "HY" || VHVM11IW-SELECT.BATTERY-LOC != "RY")
        VHVM11IW-SELECT.BATTERY-LOC = VHVM11A_DATA.HOME-YRD[SELECT-INDEX];
    end
end 

Function VHVM11I-BEGIN ()
    
    try
        call "VHVMDTA"(XDCONTROL, VHVMDTA_CRIT, VHVMDTA_DATA);
    
    end
    if (XDCONTROL.UROWCNT == 1)
        VHVM11IW-WORKING.RUN-DATE = VHVMDTA_CRIT.CURRENT-DATE;
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end


  
    if (VHVM11IW-PASS-DATA.PASS-FROM-GUI == " " || VHVM11IW-PASS-DATA.EVENT-TYPE == " ")
        VHVM11IW-TRIGGERS.INITIAL-VALUE = "Y";
    end
    VHVM11IW-WORKING.CAR-NO = VHVM11IW-PASS-DATA.CAR-NO;
    

  
    if (VH01A01_DATA.USER-GROUP == "TEST" || VH01A01_DATA.USER-GROUP == " " || VH01A01_DATA.USER-GROUP == "DBMAINT" ||
     VH01A01_DATA.USER-GROUP == "SHOPSUPR" || VH01A01_DATA.USER-GROUP == "MAINTADM" ||
     VH01A01_DATA.USER-GROUP == "VEHSHOPS" || VH01A01_DATA.USER-GROUP == "HYSHOP" || VH01A01_DATA.USER-GROUP == "CYSHOP" ||
     VH01A01_DATA.USER-GROUP == "DYSHOP" || VH01A01_DATA.USER-GROUP == "RYSHOP" ||
     VH01A01_DATA.USER-GROUP == "VEHMENG" || VH01A01_DATA.USER-GROUP == "VHMENG" || VHVM11IW-PASS-DATA.PASS-FROM-GUI == "VHCI02" || VHVM11IW-PASS-DATA.PASS-FROM-GUI == "VHCI03" ||
     VHVM11IW-PASS-DATA.PASS-FROM-GUI == "VHSV02")

    else
        VHVM11IW-TRIGGERS.QUERY-ONLY = "Y";
    end


  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11E";
    

  


  
    try
        call "VHVM11E"(XDCONTROL, VHVM11E_CRIT, VHVM11E_DATA);
    
    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)


  
            VHVM11IW-WORKING.NUM-EVENT = XDCONTROL.UROWCNT;
        end 

        
    else

        
        
        VHVM11IW-WORKING.MSG = "The Event type data is not on file";
        

  
  
  
  
    end


  
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11F";
    

  

  
    try
        call "VHVM11F"(XDCONTROL, VHVM11F_CRIT, VHVM11F_DATA);
    
    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHVM11IW-WORKING.DATE-FROM = VHVM11F_CRIT.BEGIN-DATE;
            if (VHVM11IW-WORKING.DATE-FROM == " ")
                VHVM11IW-WORKING.DATE-FROM = "12-01-2006";
            end
            VHVM11IW-WORKING.NUM-EVENT-STAT = XDCONTROL.UROWCNT;
        end 

        
    else

        
        
        VHVM11IW-WORKING.MSG = "The Event Stat data is not on file";
        

  
  
  
  
    end

  
  
  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11G";
    

  

  
    try
        call "VHVM11G"(XDCONTROL, VHVM11G_CRIT, VHVM11G_DATA);
    
    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)


  
            VHVM11IW-WORKING.NUM-LOCS = XDCONTROL.UROWCNT;
        end 

        
    else

        
        
        VHVM11IW-WORKING.MSG = "The Event Stat data is not on file";
        

  
  
  
  
    end

  
    ICT = 3;
    JCT = 3;
    

  
    VHVM11IW-EVENTS.EVENT-TYPE[1] = VHVM11E_DATA.EVENT-TYPE[1];
    VHVM11IW-EVENTS.EVENT-TYPE[2] = VHVM11E_DATA.EVENT-TYPE[2];
    VHVM11IW-EVENTS.EVENT-SUB-TYPE-DSC[2] = " ALL";
    while (ICT <= VHVM11IW-WORKING.NUM-EVENT)
        if (VHVM11E_DATA.EVENT-TYPE[ICT] != " ")
            VHVM11IW-EVENTS.EVENT-TYPE[JCT] = VHVM11E_DATA.EVENT-TYPE[ICT];
            VHVM11IW-EVENTS.EVENT-SUB-TYPE[JCT] = VHVM11E_DATA.EVENT-SUB-TYPE[ICT];
            if (VHVM11IW-EVENTS.EVENT-SUB-TYPE[JCT] != " ") 
                VHVM11IW-EVENTS.EVENT-DASH[JCT] = "-";
            end
            VHVM11IW-EVENTS.EVENT-SUB-TYPE-DSC[JCT] = VHVM11E_DATA.EVENT-SUB-TYPE-DSC[ICT];
            JCT = JCT + 1;
        end
        ICT = ICT + 1;
    end

  
    ICT = 3;
    JCT = 1;
    while (ICT <= VHVM11IW-WORKING.NUM-EVENT)
        VHVM11IW-EVENT.EVENT-TYPE[JCT] = VHVM11IW-EVENTS.EVENT-TYPE[ICT];
        VHVM11IW-EVENT.EVENT-SUB-TYPE[JCT] = VHVM11IW-EVENTS.EVENT-SUB-TYPE[ICT];
        VHVM11IW-EVENT.EVENT-SUB-TYPE-DSC[JCT] = VHVM11IW-EVENTS.EVENT-SUB-TYPE-DSC[ICT];
        if (VHVM11IW-EVENT.EVENT-SUB-TYPE[JCT] != " ") 
            VHVM11IW-EVENT.EVENT-DASH[JCT] = "-";
        end
        ICT = ICT + 1;
        JCT = JCT + 1;
    end

  
    ICT = 2;
    JCT = 1;
    while (ICT <= VHVM11IW-WORKING.NUM-EVENT-STAT)
        VHVM11IW-STATUS.EVENT-STAT[JCT] = VHVM11F_DATA.EVENT-STAT[ICT];
        ICT = ICT + 1;
        JCT = JCT + 1;
    end


  
    if (VHVM11IW-PASS-DATA.PASS-FROM-GUI == "VHCI03")
        VHVM11IW-TRIGGERS.FROM-CI-NEVERGO = "Y";
    end

  
    if (VHVM11IW-PASS-DATA.PASS-FROM-GUI == "VHCI02")
        VHVM11IW-TRIGGERS.FROM-CI-GO = "Y";
    end


  
  
  
    VHVM11IW-WORKING.DATE-FROM = VHVM11F_CRIT.BEGIN-DATE;
    if (VHVM11IW-WORKING.DATE-FROM == " ")
        VHVM11IW-WORKING.DATE-FROM = "12-01-2006";
    end
end 

Function VHVM11I-CLEAR () 
    set VHVM11IW-WORKING empty;
    set VHVM11A_CRIT empty;
    set VHVM11IW-SELECT empty;
    VHVM11IW-WORKING.DATE-FROM = "01-01-2000";
    VHVM11IW-WORKING.NUM-CARS = 0;
    VHVM11IW-TRIGGERS.CARS-RET = "Y";
    VHVM11IW-TRIGGERS.INITIAL-VALUE = "Y";
    VHVM11IW-TRIGGERS.DISABLE-UPDATE = "Y";
    VHVM11IW-TRIGGERS.DISABLE-CREATE-ACTION = "Y";
    VHVM11IW-TRIGGERS.ENABLE-ADD = "Y";
    VHVM11IW-TRIGGERS.HIDE-LOC-DROPDOWN = "Y";
    VHVM11IW-TRIGGERS.SHOW-LOC-TEXT = "Y";
    VHVM11IW-WORKING.RUN-DATE = VGVar.currentFormattedGregorianDate;
    VHVM11IW-WORKING.DATE-FROM = VHVM11F_CRIT.BEGIN-DATE;
end 

Function VHVM11I-CLEAR-LINE () 
    set VHVM11IW-SELECT empty;
    VHVM11IW-WORKING.RUN-DATE = VGVar.currentFormattedGregorianDate;
end 

Function VHVM11I-CLOSED () 
    VHVM11IW-WORKING.STOCK-NO-FAILED = "N";
    VHVM11L_CRIT.STOCK-NO = VHVM11B_DATA.TRKG-REF-NO;

  
  
  
  
  
  
    if (VHVM11B_DATA.EVENT-TYPE == "AWP" && VHVM11B_DATA.TRKG-REF-NO != " ")
  

    end
    if (VHVM11IW-WORKING.STOCK-NO-FAILED != "Y") 
        set VHVM11C_DATA empty;
        if ((VHVM11IW-PASSVALUE.EVENT-TYPE != "BAT" &&
         VHVM11IW-SELECT.CAR-NO != " " && VHVM11IW-SELECT.TRKG-REF-NO != " ") ||
         (VHVM11IW-PASSVALUE.EVENT-TYPE == "BAT" &&
         VHVM11IW-SELECT.CAR-NO != " "))


  
            VHVM11C_CRIT.CLOSED-FLAG = "Y";

  
            if (VHVM11IW-SELECT.INCD-NO-PREFIX == "I")
                VHVM11C_CRIT.I-INCIDENT-FLAG = "Y";
            else
                VHVM11C_CRIT.I-INCIDENT-FLAG = "N";
            end
            XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-SELECT.DATE-INITIALIZED;
            XXDATEW.VAGen_FUNCTION = "YMD";
            MRSCommonCode.XXDATES-CONVERT();
            VHVM11C_DATA.DATE-INITIALIZED = XXDATEW.DATE-YYYY-MM-DD;


  
            if (VHVM11IW-SELECT.DATE-CLOSED == "          ")
                XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-WORKING.RUN-DATE;
                XXDATEW.VAGen_FUNCTION = "YMD";
                MRSCommonCode.XXDATES-CONVERT();
                VHVM11C_DATA.DATE-CLOSED = XXDATEW.DATE-YYYY-MM-DD;
            else 
                XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-SELECT.DATE-CLOSED;
                XXDATEW.VAGen_FUNCTION = "YMD";
                MRSCommonCode.XXDATES-CONVERT();
                VHVM11C_DATA.DATE-CLOSED = XXDATEW.DATE-YYYY-MM-DD;
            end 


   
            VHVM11C_DATA.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
            VHVM11C_DATA.EVENT-STAT = VHVM11IW-SELECT.EVENT-STAT;
            VHVM11C_DATA.EVENT-TYPE = VHVM11IW-SELECT.EVENT-TYPE;
            VHVM11C_DATA.EVENT-SUB-TYPE = VHVM11IW-SELECT.EVENT-SUB-TYPE;
            VHVM11C_DATA.TRKG-REF-NO = VHVM11IW-SELECT.TRKG-REF-NO;
            VHVM11C_DATA.CAR-NO = VHVM11IW-SELECT.CAR-NO;
            VHVM11C_DATA.DATE-LAST-UPD = VHVM11IW-SELECT.DATE-LAST-UPD;
            VHVM11C_DATA.INCD-NO = VHVM11IW-SELECT.INCD-NO;
            VHVM11C_DATA.EVENT-COMMENT = VHVM11IW-SELECT.EVENT-COMMENT;
  
            VHVM11C_DATA.LOC-CMPLT-EVENT = VHVM11IW-SELECT.LOC;
            VHVM11C_DATA.TIME-INITIALIZED = VHVM11IW-SELECT.TIME-INITIALIZED;
            VHVM11C_DATA.ACTV-IND = "N";

  
            XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11C";
            try
                call "VHVM11C"(XDCONTROL, VHVM11C_CRIT, VHVM11C_DATA);
            
            end
            

    
            MRSCommonCode.XXA0IS-CHECK_EXT();

    
            if (XXEXT_CALL_Level77Items.URC == 0)
  
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    VHVM11IW-WORKING.MSG = "Event Entry Has Been CLOSED in  the AWP and Mod Tracking File";
                    VHVM11C_CRIT.CLOSED-FLAG = "N";
                    VHVM11IW-TRIGGERS.REFRESH-LIST = "Y";
                else

        
        
                    if (XDCONTROL.UMSGINS[1] == "-803")
                        VHVM11IW-TRIGGERS.DUP-ADD = "Y";
                    else
                        VHVM11IW-TRIGGERS.ERROR-ADD = "Y";
                    end
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end

  
  
            if (VHVM11C_DATA.EVENT-TYPE == "BAT")
                VHVM11J_DATA.CAR-NO = VHVM11C_DATA.CAR-NO;
                VHVM11J_DATA.BATTERY-REPL-LOC = VHVM11C_DATA.LOC-CMPLT-EVENT;
                VHVM11J_DATA.DATE-BATTERY-REPL = VHVM11C_DATA.DATE-CLOSED;
                XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
                XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11J";
                try
                    call "VHVM11J"(XDCONTROL, VHVM11J_CRIT, VHVM11J_DATA);
                
                end
                

    
                MRSCommonCode.XXA0IS-CHECK_EXT();

    
                if (XXEXT_CALL_Level77Items.URC == 0)
  
                    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                        VHVM11IW-WORKING.MSG = "Event Entry Has Been CLOSED in  the Tracking File and Vehicle Record was Updated";
                        
  
  
                    else

        
        
                        if (XDCONTROL.UMSGINS[1] == "-803")
                            VHVM11IW-TRIGGERS.DUP-ADD = "Y";
                        else
                            VHVM11IW-TRIGGERS.ERROR-ADD = "Y";
                        end
                        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    end
                end
  
            end 
  
            set VHVM11IW-SELECT empty;
        else 

  
            VHVM11IW-WORKING.MSG = "Please Provide ALL Esential Data";
        end
    end
end 

Function VHVM11I-GET-DATA ()
  
  
  
  
  
  
  
  
   
    set VHVM11A_CRIT empty;
    set VHVM11A_DATA empty;
  

  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-WORKING.DATE-FROM;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM11A_CRIT.DATE-FROM = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-WORKING.DATE-TO;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM11A_CRIT.DATE-TO = XXDATEW.DATE-YYYY-MM-DD;

  
  
  
  

  
    if (VHVM11IW-WORKING.CAR-NO == "ALL")
        VHVM11A_CRIT.CAR-NO = "    ";
    else
        VHVM11A_CRIT.CAR-NO = VHVM11IW-WORKING.CAR-NO;
        VHVM11IW-SELECT.CAR-NO = VHVM11IW-WORKING.CAR-NO;
    end
    if (VHVM11IW-WORKING.CAR-TYPE == "ALL" || VHVM11IW-WORKING.CAR-TYPE == "  ")
        VHVM11A_CRIT.BEG-CAR-TYPE = "A1";
        VHVM11A_CRIT.END-CAR-TYPE = "C2";
    else
        VHVM11A_CRIT.BEG-CAR-TYPE = VHVM11IW-WORKING.CAR-TYPE;
        VHVM11A_CRIT.END-CAR-TYPE = VHVM11IW-WORKING.CAR-TYPE;
    end
    if (VHVM11IW-WORKING.HOME-YRD == "ALL")
        VHVM11A_CRIT.HOME-YRD = "  ";
    else
        VHVM11A_CRIT.HOME-YRD = VHVM11IW-WORKING.HOME-YRD;
    end
    if (VHVM11IW-WORKING.EVENT-TYPE == "ALL")
        VHVM11A_CRIT.EVENT-TYPE = "    ";
    else
        VHVM11A_CRIT.EVENT-TYPE = VHVM11IW-WORKING.EVENT-TYPE;
    end
    if (VHVM11IW-WORKING.EVENT-STAT == "ALL")
        VHVM11A_CRIT.EVENT-STAT = "       ";
    else
        VHVM11A_CRIT.EVENT-STAT = VHVM11IW-WORKING.EVENT-STAT;
    end
    if (VHVM11IW-WORKING.CURR-LOC == "ALL")
        VHVM11A_CRIT.CURR-LOC = "       ";
    else
        VHVM11A_CRIT.CURR-LOC = VHVM11IW-WORKING.CURR-LOC;
    end
    VHVM11A_CRIT.EVENT-SUB-TYPE = VHVM11IW-WORKING.EVENT-SUB-TYPE;
    if (VHVM11IW-WORKING.TRKG-F-D == "-" && VHVM11IW-WORKING.TRKG-S-D == "-")
        VHVM11IW-WORKING.TRKG-1-TO-2 = VHVM11IW-WORKING.TRKG-F-2;
        VHVM11IW-WORKING.TRKG-3-TO-4 = VHVM11IW-WORKING.TRKG-S-2;
        VHVM11IW-WORKING.TRKG-5-TO-7 = VHVM11IW-WORKING.TRKG-L-3;
        VHVM11IW-WORKING.TRKG-8-TO-9 = VHVM11IW-WORKING.TRKG-L-2;
    else
        VHVM11IW-WORKING.TRKG-REF-NO = VHVM11IW-WORKING.TRKG-REF-NO-9;
    end
    VHVM11A_CRIT.TRKG-REF-NO = VHVM11IW-WORKING.TRKG-REF-NO;
    VHVM11A_CRIT.SORT-ORDER = VHVM11IW-WORKING.SORT-ORDER;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHVM11I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHVM11A";

  
    try
        call "VHVM11A"(XDCONTROL, VHVM11A_CRIT, VHVM11A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
  
  
  
  
  
  
  
  
  

  
            VHVM11IW-SELECT.EVENT-STAT = "OPEN";
  
            VHVM11IW-TRIGGERS.CARS-RET = "Y";
            VHVM11IW-TRIGGERS.ENABLE-ADD = "Y";
            VHVM11IW-TRIGGERS.DISABLE-UPDATE = "Y";
            VHVM11IW-TRIGGERS.DISABLE-CREATE-ACTION = "Y";
            if (VHVM11A_CRIT.EVENT-TYPE != "BAT")
                VHVM11IW-TRIGGERS.HIDE-LOC-DROPDOWN = "Y";
                VHVM11IW-TRIGGERS.SHOW-LOC-TEXT = "Y";
            else
                VHVM11IW-TRIGGERS.SHOW-LOC-DROPDOWN = "Y";
                VHVM11IW-TRIGGERS.HIDE-LOC-TEXT = "Y";
            end
            VHVM11IW-WORKING.NUM-CARS = XDCONTROL.UROWCNT;
            if (VHVM11A_CRIT.MAX-ROWS-EXCEEDED == "Y")
                VHVM11IW-WORKING.MSG = "TOTAL ROWS SELECTED EXCEEDS THE MAX ROWS OF 146";
            end
            
   
        
        else

        
        
  
      
            VHVM11IW-WORKING.MSG = "No data found with your criteria or stock # is entered with an incorrect format-Correct Format: 999999999 or 99-99-99999";
            
  
  
  
  
        end 
    end
end 

Function VHVM11I-GET-DATA2 ()
  
   
    set VHVM11A_CRIT empty;
  

  
    XXDATEW.VAGen_FUNCTION = "YMD";
    XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-WORKING.DATE-FROM;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM11A_CRIT.DATE-FROM = XXDATEW.DATE-YYYY-MM-DD;
    XXDATEW.DATE-MM-DD-YYYY = VHVM11IW-WORKING.DATE-TO;
    MRSCommonCode.XXDATES-CONVERT();
    VHVM11A_CRIT.DATE-TO = XXDATEW.DATE-YYYY-MM-DD;

  
  
  
  

  
  
    VHVM11A_CRIT.CAR-NO = VHVM11IW-PASS-DATA.CAR-NO;
    VHVM11IW-WORKING.CAR-NO = VHVM11IW-PASS-DATA.CAR-NO;

  
