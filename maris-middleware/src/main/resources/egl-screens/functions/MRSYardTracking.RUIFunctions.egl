function VHYT08IS-TO-CAR()
    if(VHYT11IW-PASSVALUE.TO-CAR == " ")
        if(VHYT11IW-PASSVALUE.FROM-POST == 1)
            if(VHYT08IW-COLOR.CAR-2-COLOR == "YELLOW")
                VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-2-CENTER;
                VHYT11IW-PASSVALUE.TO-POST = 2;
                VHYT11IW-PASSVALUE.TO-POSITION = LABEL-2-CENTER;
            else
                if(VHYT08IW-COLOR.CAR-3-COLOR == "YELLOW")
                    VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-3-CENTER;
                    VHYT11IW-PASSVALUE.TO-POST = 3;
                    VHYT11IW-PASSVALUE.TO-POSITION = LABEL-3-CENTER;
                else
                    if(VHYT08IW-COLOR.CAR-4-COLOR == "YELLOW")
                        VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-4-CENTER;
                        VHYT11IW-PASSVALUE.TO-POST = 4;
                        VHYT11IW-PASSVALUE.TO-POSITION = LABEL-4-CENTER;
                    else
                        if(VHYT08IW-COLOR.CAR-5-COLOR == "YELLOW")
                            VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-5-CENTER;
                            VHYT11IW-PASSVALUE.TO-POST = 5;
                            VHYT11IW-PASSVALUE.TO-POSITION = LABEL-5-CENTER;
                        else
                            if(VHYT08IW-COLOR.CAR-6-COLOR == "YELLOW")
                                VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-6-CENTER;
                                VHYT11IW-PASSVALUE.TO-POST = 6;
                                VHYT11IW-PASSVALUE.TO-POSITION = LABEL-6-CENTER;
                            else
                                if(VHYT08IW-COLOR.CAR-7-COLOR == "YELLOW")
                                    VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-7-CENTER;
                                    VHYT11IW-PASSVALUE.TO-POST = 7;
                                    VHYT11IW-PASSVALUE.TO-POSITION = LABEL-7-CENTER;
                                else
                                    if(VHYT08IW-COLOR.CAR-8-COLOR == "YELLOW")
                                        VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-8-CENTER;
                                        VHYT11IW-PASSVALUE.TO-POST = 8;
                                        VHYT11IW-PASSVALUE.TO-POSITION = LABEL-8-CENTER;
                                    else
