                VHYT08IW-TRIGGER.ENABLE-FIX = "Y";
                VHYT08IW-PASSVALUE.POSN-NO-Y = 9;
                VHYT08IW-PASSVALUE.POSN-NO-Y = VHYT08IW-3.LABEL-9-CENTER;
            end
        end
    else
        if(VHYT08IW-COLOR.CAR-9-COLOR == "YELLOW" &&
                VHYT08IW-PASSVALUE.USER-OK == "Y")
            VHYT08IW-TRIGGER.ENABLE-CHANGE = "Y";
            VHYT08IW-TRIGGER.ENABLE-FIX = "Y";
            VHYT08IW-PASSVALUE.CAR-NO-X = VHYT08IW-1.CAR-NO-9;
            VHYT08IW-PASSVALUE.POSN-NO-X = 9;
            VHYT08IW-PASSVALUE.POSN-NO-X = VHYT08IW-3.LABEL-9-CENTER;
        else
            VHYT08IW-TRIGGER.DISABLE-CHANGE = "Y";
            VHYT08IW-TRIGGER.DISABLE-FIX = "Y";
        end
    end
end 

function VHYT08IS-PRE-FIX()
    VHYT08IW-MESSAGE.MESSAGE = " ";
    if(VHYT08IW-PASSVALUE.CLICK-COUNT == 0)
        VHYT08IW-MESSAGE.MESSAGE = "No car present in position selected - please correct selection";
    else
        VHYT08IS-FIX();
        VHYTIW-BUTTOM.RUN-FIX = "Y";
    end
end 

function VHYT08IS-PRE-LOAD()
    if(VHYT08IW-TRIGGER.FINAL-COUNT > 30)
        VHYT08IS-LOAD-T-95();
    else
        VHYT08IS-LOAD-T95X();
    end
end 

function VHYT08IS-PRV()
    VHYT08IS-CAR-COLOR();
    set VHYT08IW-1 empty;
    VHYT08IW-TRIGGER.PAGENO = VHYT08IW-TRIGGER.PAGENO - 1;
    VHYT08IS-LABEL();
    VHYT08IW-TRIGGER.LABELNO = VHYT08IW-TRIGGER.PAGENO - 1;
    VHYT08IW-TRIGGER.LABELNO = VHYT08IW-TRIGGER.LABELNO * 30;
    VHYT08IW-TRIGGER.START-COUNTER = VHYT08IW-TRIGGER.LABELNO + 1;
    VHYT08IW-TRIGGER.FINAL-COUNT = VHYT08IW-TRIGGER.FINAL-COUNT + 30;
    
    if(VHYT08IW-TRIGGER.FINAL-COUNT >= 30)
        VHYT08IW-TRIGGER.ENABLE-NXT = "Y";
    else
        VHYT08IW-TRIGGER.DISABLE-NXT = "Y";
    end
    if(VHYT08IW-TRIGGER.PAGENO > 1)
        VHYT08IW-TRIGGER.ENABLE-PRV = "Y";
    else
        VHYT08IW-TRIGGER.DISABLE-PRV = "Y";
    end
    VHYT08IS-PRE-LOAD();
end 

function VHYT08IS-PSEUDO()
    VHYT07IW-PASSVALUE.YRD-TRKG-YRD = "HY";
end 

function VHYT08IS-PSEUDO-L()
    if(VHYT08IW-PASSVALUE.YRD-SUB-LOC == "T-95")
        VHYT08IW-PSEUDO-X.PSEUDO-LABEL-1 = "  From";
        VHYT08IW-PSEUDO-X.PSEUDO-LABEL-2 = "Train";
    else
        VHYT08IW-PSEUDO-X.PSEUDO-LABEL-1 = "Pseudo";
        VHYT08IW-PSEUDO-X.PSEUDO-LABEL-2 = "Train";
    end
end 

