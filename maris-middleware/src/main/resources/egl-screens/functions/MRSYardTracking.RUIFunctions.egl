function VHYT02IS-CLEAR()
    VHYT02IW-SAVE.YRD-TRKG-YRD = " ";
    VHYT02IW-WORK.YRD-TRKG-YRD = " ";
end 

function VHYT02IS-INIT()








    VHYT02IW-SAVE.YRD-TRKG-YRD = VHYT02IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT02IW-SAVE.YRD-SUB-LOC = VHYT02IW-PASSVALUE.YRD-SUB-LOC;
    VHYT02B_CRIT.YRD = VHYT02IW-PASSVALUE.YRD-TRKG-YRD;
    
    XXEXT_CALL_Level77Items.UEXTNAM = "BHYT02I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT02B";

    
    try
        call "VHYT02B"(XDCONTROL, VHYT02B_CRIT, VHYT02B_DATA, VHYT02B_DATA_1);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            XDCONTROL.UROWCNT = XDCONTROL.UROWCNT + 1;
            VHYT02B_DATA_1.YRD-SUB-LOC[XDCONTROL.UROWCNT] = "ALL";
            VHYT02IS-SELECT();

        
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT02IS-INIT-A()








    if(VHYT02IW-SAVE.YRD-TRKG-YRD == " ")
        VHYT02IW-PASSVALUE.YRD-TRKG-YRD = " ";
        VHYT02IW-PASSVALUE.YRD-SUB-LOC = " ";
    end
    VHYT02B_CRIT.YRD = VHYT02IW-WORK.YRD-TRKG-YRD;
    
    XXEXT_CALL_Level77Items.UEXTNAM = "BHYT02I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT02B";

    
    try
        call "VHYT02B"(XDCONTROL, VHYT02B_CRIT, VHYT02B_DATA, VHYT02B_DATA_1);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            XDCONTROL.UROWCNT = XDCONTROL.UROWCNT + 1;
            VHYT02B_DATA_1.YRD-SUB-LOC[XDCONTROL.UROWCNT] = "ALL";
            if(VHYT02IW-PASSVALUE.YRD-TRKG-YRD == VHYT02IW-WORK.YRD-TRKG-YRD)
                VHYT02IS-SELECT();
            end

        
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT02IS-INIT-X()










    XXEXT_CALL_Level77Items.UEXTNAM = "WS100I";
