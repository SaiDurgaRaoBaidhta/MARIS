function VHYT11IS-VALID()
    if(VHYT11IW-PASSVALUE.FROM-CAR == " ")
        VHYT11IW-MESSAGE.MESSAGE = "Please select valid car to move";
        VHYT11IW-TRIGGER.ERROR-SW = "Y";
    end
    if(VHYT11IW-PASSVALUE.FROM-POSITION == 0 ||
            VHYT11IW-PASSVALUE.TO-POSITION == 0)
        VHYT11IW-MESSAGE.MESSAGE = "No cars selected on the track - no cars moved";
        VHYT11IW-TRIGGER.ERROR-SW = "Y";
    end
    if(VHYT08IW-1.CAR-NO-1 == " " && VHYT08IW-1.CAR-NO-2 == " " &&
            VHYT08IW-1.CAR-NO-3 == " " && VHYT08IW-1.CAR-NO-4 == " " &&
            VHYT08IW-1.CAR-NO-5 == " " && VHYT08IW-1.CAR-NO-6 == " " &&
            VHYT08IW-1.CAR-NO-7 == " " && VHYT08IW-1.CAR-NO-8 == " " &&
            VHYT08IW-1.CAR-NO-9 == " " && VHYT08IW-1.CAR-NO-10 == " " &&
            VHYT08IW-1.CAR-NO-11 == " " && VHYT08IW-1.CAR-NO-12 == " " &&
            VHYT08IW-1.CAR-NO-13 == " " && VHYT08IW-1.CAR-NO-14 == " " &&
            VHYT08IW-1.CAR-NO-15 == " " && VHYT08IW-1.CAR-NO-16 == " " &&
            VHYT08IW-1.CAR-NO-17 == " " && VHYT08IW-1.CAR-NO-18 == " " &&
            VHYT08IW-1.CAR-NO-19 == " " && VHYT08IW-1.CAR-NO-20 == " " &&
            VHYT08IW-1.CAR-NO-21 == " " && VHYT08IW-1.CAR-NO-22 == " " &&
            VHYT08IW-1.CAR-NO-23 == " " && VHYT08IW-1.CAR-NO-24 == " " &&
            VHYT08IW-1.CAR-NO-25 == " " && VHYT08IW-1.CAR-NO-26 == " " &&
            VHYT08IW-1.CAR-NO-27 == " " && VHYT08IW-1.CAR-NO-28 == " " &&
            VHYT08IW-1.CAR-NO-29 == " " && VHYT08IW-1.CAR-NO-30 == " ")
        VHYT11IW-MESSAGE.MESSAGE = "No cars present on current track = no cars moved";
        VHYT11IW-TRIGGER.ERROR-SW = "Y";
    end
    if(VHYT11IW-TRACK.YRD-SUB-LOC == " ")
        VHYT11IW-MESSAGE.MESSAGE = "Must select a destination track from the Move to list";
        VHYT11IW-TRIGGER.ERROR-SW = "Y";
    end
    if(VHYT11IW-PASSVALUE.CLICK-COUNT > 2)
        VHYT11IW-MESSAGE.MESSAGE = "Too many cars selected, Can only move 1 car or a range of cars.";
        VHYT11IW-TRIGGER.ERROR-SW = "Y";
    end
end 

function VHYT12IS-CLEAR-X()
    VHYT12IW.CON-NO = " ";
    CON-NO-SETFOCUS = "Y";
    VHYT12IW-MSG.FINAL-MESSAGE = "  ";
    ENABLE-VERIFY = "Y";
end 

function VHYT12IS-CLEAR-X1()
    VHYT12IW.CON-NO = " ";
    VHYT12IW.CON-NO-X = 0;
    VHYT12B_CRIT.CON-NO = " ";
    CON-NO-SETFOCUS = "Y";
    VHYT12IW-MSG.FINAL-MESSAGE = VHYT12IW-MSG.PROMPT-MSG-A;
    ENABLE-VERIFY = "Y";
end 

function VHYT12IS-COMP-CARS()
    if(VHYT12A_DATA.CAR-NO[1] != VHYT12IW.CAR-NO-1 || VHYT12A_DATA.CAR-NO[2] !=
                    VHYT12IW.CAR-NO-2 || VHYT12A_DATA.CAR-NO[3] !=
                    VHYT12IW.CAR-NO-3 || VHYT12A_DATA.CAR-NO[4] !=
                    VHYT12IW.CAR-NO-4 || VHYT12A_DATA.CAR-NO[5] !=
                    VHYT12IW.CAR-NO-5 || VHYT12A_DATA.CAR-NO[6] !=
                    VHYT12IW.CAR-NO-6 || VHYT12A_DATA.CAR-NO[7] !=
                    VHYT12IW.CAR-NO-7 || VHYT12A_DATA.CAR-NO[8] !=
                    VHYT12IW.CAR-NO-8 || VHYT12A_DATA.CAR-NO[9] !=
                    VHYT12IW.CAR-NO-9 || VHYT12A_DATA.CAR-NO[10] !=
                    VHYT12IW.CAR-NO-10)
        CAR-MOVED-PROMPT = "Y";
        CAR-MOVED = "Y";
    end
end 

function VHYT12IS-IDENT-CR1()

    if(VHYT12A_DATA.CAR-TYPE[1] == "XX" || VHYT12A_DATA.CAR-TYPE[1] == "XX")

    else
        if(VHYT12A_DATA.VAGen_ORIENTATION[1] ==
                VHYT12A_DATA.LFT-ORIENTATION-CD[1])
            VHYT12IW.LFT-OR-1 = VHYT12A_DATA.VAGen_ORIENTATION[1];
        else
            VHYT12IW.RGT-OR-1 = VHYT12A_DATA.VAGen_ORIENTATION[1];
            LEAD-OR-ERROR = "Y";
        end
    end
    VHYT12IW.CAR-1 = VHYT12A_DATA.CAR-NO[1];
    if(VHYT12IW.CAR-NO-1 is numeric)

        
        VHYT12C_CRIT.CAR-NO = VHYT12IW.CAR-NO-1;
        try
            call "VHYT12C"(XDCONTROL, VHYT12C_CRIT, VHYT12C_DATA);

        end
        if((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
            CAR-IN-CON = "Y";
            VHYT12IW-COLOR.CON-1-COLOR = "RED";
            VHYT12IW.CON-NO-1 = VHYT12C_DATA.CON-NO;
            VHYT12IW.PART-IND-1 = VHYT12C_DATA.PART-IND;
        end
    end
end 

