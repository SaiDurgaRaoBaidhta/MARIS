    set VHYT04IW-B-PIT-23 empty;
    set VHYT04IW-B-PIT-24 empty;
    set VHYT04IW-1N-1 empty;
    set VHYT04IW-1N-2 empty;
    set VHYT04IW-ES-1 empty;
    set VHYT04IW-ES-2 empty;
    set VHYT04IW-ES1-S empty;
    set VHYT04IW-ES2-S empty;
    set VHYT04IW-ES1-N empty;
    set VHYT04IW-ES2-N empty;
    set VHYT04IW-TT-1 empty;
    set VHYT04IW-TT empty;
    VHYT04IS-INIT-S();
end 

function VHYT04IS-LOAD()
    CNT = 1;

    while(VHYT04IW.CNT <= XDCONTROL.UROWCNT)
        VHYT04A-DATA.FCOLOR[CNT] = dy100Color(VHYT04A-DATA.HOME-YRD[CNT]);
        if(strLib.characterLen(VHYT04A-DATA.SOFTVER[CNT]) > 1)
            if(VHYT04A-DATA.VAGen_ORIENTATION[CNT] ==
                    VHYT04A-DATA.LFT-ORIENTATION-CD[CNT])
                VHYT04A-DATA.BUTTONTXT[CNT] = "$" +
                        VHYT04A-DATA.VAGen_ORIENTATION[CNT] +
                        VHYT04A-DATA.CAR-NO[CNT];
            else
                VHYT04A-DATA.BUTTONTXT[CNT] = "$" + VHYT04A-DATA.CAR-NO[CNT] +
                        VHYT04A-DATA.VAGen_ORIENTATION[CNT];
            end
        else
            if(VHYT04A-DATA.VAGen_ORIENTATION[CNT] ==
                    VHYT04A-DATA.LFT-ORIENTATION-CD[CNT])
                VHYT04A-DATA.BUTTONTXT[CNT] = VHYT04A-DATA.VAGen_ORIENTATION[CNT] +
                        VHYT04A-DATA.CAR-NO[CNT];
            else
                VHYT04A-DATA.BUTTONTXT[CNT] = VHYT04A-DATA.CAR-NO[CNT] +
                        VHYT04A-DATA.VAGen_ORIENTATION[CNT];
            end
        end

        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-01")
            VHYT04IS-B-PIT-01();
        else
            if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-02")
                VHYT04IS-B-PIT-02();
            else
                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-03")
                    VHYT04IS-B-PIT-03();
                else
                    if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-04")
                        VHYT04IS-B-PIT-04();
                    else
                        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-05")
                            VHYT04IS-B-PIT-05();
                        else
                            if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-06")
                                VHYT04IS-B-PIT-06();
                            else
                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-07")
                                    VHYT04IS-B-PIT-07();
                                else
                                    if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                            "B-PIT-08")
                                        VHYT04IS-B-PIT-08();
                                    else
                                        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                "B-PIT-09")
                                            VHYT04IS-B-PIT-09();
                                        else
                                            if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                    "B-PIT-10")
                                                VHYT04IS-B-PIT-10();
                                            else
                                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                        "B-PIT-11")
                                                    VHYT04IS-B-PIT-11();
                                                else
                                                    if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                            "B-PIT-12")
                                                        VHYT04IS-B-PIT-12();
                                                    else
                                                        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                "B-PIT-13")
                                                            VHYT04IS-B-PIT-13();
                                                        else
                                                            if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                    "B-PIT-14")
                                                                VHYT04IS-B-PIT-14();
                                                            else
                                                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                        "B-PIT-15")
                                                                    VHYT04IS-B-PIT-15();
                                                                end
                                                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                        "B-PIT-16")
                                                                    VHYT04IS-B-PIT-16();
                                                                end
                                                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                        "B-PIT-17")
                                                                    VHYT04IS-B-PIT-17();
                                                                end
                                                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                        "B-PIT-18")
                                                                    VHYT04IS-B-PIT-18();
                                                                end
                                                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                        "B-PIT-19")
                                                                    VHYT04IS-B-PIT-19();
                                                                end
                                                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                        "B-PIT-20")
                                                                    VHYT04IS-B-PIT-20();
                                                                end
                                                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                        "B-PIT-21")
                                                                    VHYT04IS-B-PIT-21();
                                                                end
                                                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                        "B-PIT-22")
                                                                    VHYT04IS-B-PIT-22();
                                                                end
                                                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                        "B-PIT-23")
                                                                    VHYT04IS-B-PIT-23();
                                                                end
                                                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                                        "B-PIT-24")
                                                                    VHYT04IS-B-PIT-24();
                                                                end									            	
                                                            end												            
                                                        end
                                                    end									            	
                                                end
                                            end									        
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "TT")
            VHYT04IS-TT();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "TT-1")
            VHYT04IS-TT-1();
        end

        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "1N-1")
            VHYT04IS-1N-1();
        else
            if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "1N-2")
                VHYT04IS-1N-2();
            else
                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "ES-1")
                    VHYT04IS-ES-1();
                else
                    if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "ES-2")
                        VHYT04IS-ES-2();
                    else
                        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "ES1-N")
                            VHYT04IS-ES1-N();
                        else
                            if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "ES2-N")
                                VHYT04IS-ES2-N();
                            else
                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "ES1-S")
                                    VHYT04IS-ES1-S();
                                else
                                    if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                            "ES2-S")
                                        VHYT04IS-ES2-S();
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "2N-1")
            VHYT04IS-2-N1();
        else
            if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "2N-2")
                VHYT04IS-2-N2();
            else
                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "3N-1" ||
                        VHYT04A-DATA.YRD-SUB-LOC[CNT] == "3N-2" ||
                        VHYT04A-DATA.YRD-SUB-LOC[CNT] == "3N-3")
                    VHYT04IS-3-N();
                else
                    if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "T-24")
                        VHYT04IS-T24();
                    else
                        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "WT-N")
                            VHYT04IS-WT-N();
                        else
                            if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "WT-S")
                                VHYT04IS-WT-S();
                            else
                                if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "TC-A")
                                    VHYT04IS-TC-A();
                                else
                                    if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "TC-B")
                                        VHYT04IS-TC-B();
                                    else
                                        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                "SI-1A")
                                            VHYT04IS-SI-1A();
                                        else
                                            if(VHYT04A-DATA.YRD-SUB-LOC[CNT] ==
                                                    "SI-1B")
                                                VHYT04IS-SI-1B();
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "SI-1C")
            VHYT04IS-SI-1C();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "SI-1D")
            VHYT04IS-SI-1D();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "SI-1E")
            VHYT04IS-SI-1E();
        end

        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "ST-A")
            VHYT04IS-ST-A();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "ST-B")
            VHYT04IS-ST-B();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "ST-C")
            VHYT04IS-ST-C();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "ST-D")
            VHYT04IS-ST-D();
        end

        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "1A")
            VHYT04IS-1A();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "1B")
            VHYT04IS-1B();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "1C")
            VHYT04IS-1C();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "2A")
            VHYT04IS-2A();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "2B")
            VHYT04IS-2B();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "2C")
            VHYT04IS-2C();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "3A")
            VHYT04IS-3A();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "3B")
            VHYT04IS-3B();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "3C")
            VHYT04IS-3C();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "1S-1")
            VHYT04IS-1-S-1();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "1S-2")
            VHYT04IS-1-S-2();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "2S-1")
            VHYT04IS-2-S();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "3S-1")
            VHYT04IS-3-S();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "S-25")
            VHYT04IS-S25();
        end
        if(VHYT04A-DATA.YRD-SUB-LOC[CNT] == "T-23A")
            VHYT04IS-T-23A();
        end
        CNT = CNT + 1;
    end
end 














