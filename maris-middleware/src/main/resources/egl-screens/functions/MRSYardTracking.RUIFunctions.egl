                        VHYT60A-DATA.LFT-ORIENTATION-CD[CNT])
                    VHYT60IW-RR01.LFT-OR-3 = VHYT60A-DATA.VAGen_ORIENTATION[CNT];
                else
                    VHYT60IW-RR01.RGT-OR-3 = VHYT60A-DATA.VAGen_ORIENTATION[CNT];
