function VHYT60IS-LOAD2()
    CNT = 1;
    while(VHYT60IW.CNT <= XDCONTROL.UROWCNT)
        VHYT60A-DATA.FCOLOR[CNT] = dy100Color(VHYT60A-DATA.HOME-YRD[CNT]);
        
        if(strLib.characterLen(VHYT60A-DATA.SOFTVER[CNT]) > 1)
            if(VHYT60A-DATA.VAGen_ORIENTATION[CNT] ==
                    VHYT60A-DATA.LFT-ORIENTATION-CD[CNT])
                VHYT60A-DATA.BUTTONTXT[CNT] = "$" +
                        VHYT60A-DATA.VAGen_ORIENTATION[CNT] +
                        VHYT60A-DATA.CAR-NO[CNT];
            else
                VHYT60A-DATA.BUTTONTXT[CNT] = "$" + VHYT60A-DATA.CAR-NO[CNT] +
                        VHYT60A-DATA.VAGen_ORIENTATION[CNT];
            end
        else
            if(VHYT60A-DATA.VAGen_ORIENTATION[CNT] ==
                    VHYT60A-DATA.LFT-ORIENTATION-CD[CNT])
                VHYT60A-DATA.BUTTONTXT[CNT] = VHYT60A-DATA.VAGen_ORIENTATION[CNT] +
                        VHYT60A-DATA.CAR-NO[CNT];
            else
                VHYT60A-DATA.BUTTONTXT[CNT] = VHYT60A-DATA.CAR-NO[CNT] +
                        VHYT60A-DATA.VAGen_ORIENTATION[CNT];
            end
        end
        if(VHYT60A-DATA.YRD-SUB-LOC[CNT][1 : 5] == "B-PIT")
            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-01")
                VHYT60IS-B-PIT-01();
            else
                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-02")
                    VHYT60IS-B-PIT-02();
                else
                    if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-03")
                        VHYT60IS-B-PIT-03();
                    else
                        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-04")
                            VHYT60IS-B-PIT-04();
                        else
                            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-05")
                                VHYT60IS-B-PIT-05();
                            else
                                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-06")
                                    VHYT60IS-B-PIT-06();
                                end
                            end
                        end
                    end
                end
            end
        end

        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "RR-01")
            VHYT60IS-RR01();
        else
            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "RR-02")
                VHYT60IS-RR02();
            else
                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "RR-03")
                    VHYT60IS-RR03();
                else
                    if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "1A")
                        VHYT60IS-1A();
                    else
                        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "1B")
                            VHYT60IS-1B();
                        else
                            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "2A")
                                VHYT60IS-2A();
                            else
                                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "2B")
                                    VHYT60IS-2B();
                                else
                                    if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "2C")
                                        VHYT60IS-2C();
                                    else
                                        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] ==
                                                "2D")
                                            VHYT60IS-2D();
                                        else
                                            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] ==
                                                    "3A")
                                                VHYT60IS-3A();
                                            else
                                                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] ==
                                                        "3B")
                                                    VHYT60IS-3B();
                                                else
                                                    if(VHYT60A-DATA.YRD-SUB-LOC[CNT] ==
                                                            "3C")
                                                        VHYT60IS-3C();
                                                    else
                                                        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] ==
                                                                "3D")
                                                            VHYT60IS-3D();
                                                        else
                                                            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] ==
                                                                    "S7-1")
                                                                VHYT60IS-S7-1();
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S7-2")
            VHYT60IS-S7-2();
        else
            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S7-3")
                VHYT60IS-S7-3();
            else
                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S7-4")
                    VHYT60IS-S7-4();
                else
