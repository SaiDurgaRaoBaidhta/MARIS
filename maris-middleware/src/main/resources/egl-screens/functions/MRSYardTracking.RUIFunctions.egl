function VHYT11IS-TRACK()
    VHYT11IW-PASSVALUE.TRACK-COUNTER = 1;
    while(VHYT11IW-PASSVALUE.TRACK-COUNTER <= VHYT11A_CRIT.TRACK-COUNTER)
        if(VHYT11A_DATA.YRD-SUB-LOC[VHYT11IW-PASSVALUE.TRACK-COUNTER] ==
                VHYT11IW-PASSVALUE.TO-YRD-SUB-LOC)
            VHYT11IW-TRACK.TRACK-COUNTER = VHYT11IW-PASSVALUE.TRACK-COUNTER;
        end
        VHYT11IW-PASSVALUE.TRACK-COUNTER = VHYT11IW-PASSVALUE.TRACK-COUNTER +
                1;
    end
end 

function VHYT11IS-UPD-MSG()
