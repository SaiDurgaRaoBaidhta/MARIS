                        end
                    end
                end
            end
        end
    end
end 

function VHYT11IS-INIT()
    set VHYT11IW-MESSAGE empty;
    VHYT11IW-PASSVALUE.FROM-CAR = " ";
    VHYT11IW-PASSVALUE.TO-CAR = " ";
    VHYT11IW-PASSVALUE.FROM-POSITION = 0;
    VHYT11IW-PASSVALUE.TO-POSITION = 0;
    VHYT11IS-COLOR();
    VHYT11A_CRIT.YRD-TRKG-YRD = VHYT08IW-PASSVALUE.YRD_TRKG_YRD;
    VHYT11A_CRIT.YRD-SUB-LOC = VHYT11IW-PASSVALUE.FROM-YRD-SUB-LOC;
    
    
    
    
    
    
    
    

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT11I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT11A";

    
    try
        call "VHYT11A"(XDCONTROL, VHYT11A_CRIT, VHYT11A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if(VHYT11A_CRIT.TRANSFER-TRK-IND == "Y")
                
                VHYT11IW-TRIGGER.DISABLE-PSEUDO = "Y";
            else
                VHYT11IW-TRIGGER.ENABLE-PSEUDO = "Y";
            end
            VHYT11IW-TRIGGER.LOAD-LOC = "Y";
            VHYT11IS-TRACK();
            VHYT11IS-ABLE();
        end
    else

        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

function VHYT11IS-INIT-X()
    set VHYT08IW-1 empty;
    VHYT08IS-VALIDATE();

    
    
    
    
    
    
    
    

    
    set VHYT08A_DATA empty;
    VHYT08A_CRIT.YRD-TRKG-YRD = VHYT08IW-PASSVALUE.YRD_TRKG_YRD;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT08I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT08A";

    
    try
        call "VHYT08A"(XDCONTROL, VHYT08A_CRIT, VHYT08A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT11IW-PASSVALUE.CAR-COUNT = XDCONTROL.UROWCNT;
            VHYT08IW-PASSVALUE.UROWCNT = XDCONTROL.UROWCNT;
            if(XDCONTROL.UROWCNT <= 30)
                if(VHYT08IW-2.SUB-LOC != "T-95")
                    VHYT11I-LOAD-DATA();
                    VHYT08IW-TRIGGER.DISABLE-NXT = "Y";
                    VHYT08IW-TRIGGER.DISABLE-PRV = "Y";
                else
                    
                    VHYT11I-LOAD-DATA();
                    VHYT08IW-TRIGGER.DISABLE-NXT = "Y";
                    VHYT08IW-TRIGGER.DISABLE-PRV = "Y";
                end
            else
                VHYT08IW-TRIGGER.FINAL-COUNT = XDCONTROL.UROWCNT;
                VHYT08IW-TRIGGER.FC-SW = " ";
                VHYT08IW-TRIGGER.ENABLE-NXT = "Y";
                VHYT08IW-TRIGGER.DISABLE-PRV = "Y";
            end
            VHYT08IW-TRIGGER.FINAL-COUNT = XDCONTROL.UROWCNT;
            VHYT11IS-PRE-LOAD();

        
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT11IS-LOAD-T-95()






    COUNTERS = 1;
    while(VHYT08IW-TRIGGER.COUNTERS <= 30)
        if(VHYT08A_DATA.POSN-NO[START-COUNTER] == LABEL-1-CENTER)
            VHYT08IW-1.HOME-YRD-1 = VHYT08A_DATA.HOME-YRD[START-COUNTER];
            VHYT08IW-1.CON-1 = VHYT08A_DATA.CON-NO[START-COUNTER];
