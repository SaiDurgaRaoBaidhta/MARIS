                            VHYT08IW-PASSVALUE.CAR-K-LEFT-ORIENTATION)

                VHYT08IW-1.CAR-NO-30-LEFT = VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER];
            else
                if(VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                        VHYT08IW-PASSVALUE.CAR-A-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-C-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-B-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-D-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-E-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-L-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-M-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-K-RIGHT-ORIENTATION)
                    VHYT08IW-1.CAR-NO-30-RIGHT = VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER];
                end
            end
        end
        START-COUNTER = START-COUNTER + 1;
        COUNTERS = COUNTERS + 1;
    end
    VHYT08IS-ABLE();
end 

function VHYT08IS-MOVE()
    VH01A02_CRIT.GUI-NAME = "VHYT08";
    VHYT01IS-INIT-Y();
end 

function VHYT08IS-MOVE-CAR()

    VHYT08IW-MESSAGE.MESSAGE = "  ";
    VHYT08G_DATA.TRK-IS-FULL = " ";
    VHYT08G_DATA.DB-CHANGE = " ";
    VHYT08G_DATA.GO-CAR-FOUND = " ";
    VHYT08G_CRIT.FR-YRD-SUB-LOC = VHYT08IW-PASSVALUE.YRD-SUB-LOC;
    VHYT08G_CRIT.TO-YRD-SUB-LOC = VHYT08IW-PASSVALUE.YRD-SUB-LOC-TO;

    

    
    
    
    
    
    VHYT08IS-MVECARX();
    VHYT08G_CRIT.FR-POSN-NO = VHYT11IW-PASSVALUE.FROM-POSITION;
    VHYT08G_CRIT.TO-POSN-NO = VHYT11IW-PASSVALUE.TO-POSITION;
    if(VHYT11IW-TRIGGER.ERROR-SW-MC != "Y")
        VHYT08IS-MOVE-CAR1();
        if(VHYTIW-BUTTOM.OPEN-MOVEYRD == "Y")
            VHYTIW-BUTTOM.OPEN-MOVEYRD1 = "Y";
        end
    else
        if(VHYT11IW-PASSVALUE.FROM-POSITION == 0 ||
                VHYT11IW-PASSVALUE.TO-POSITION == 0)
            VHYT11IW-MESSAGE.MESSAGE = "No car selected on the track - no cars moved";
        end
    end
end 

function VHYT08IS-MOVE-CAR1()
    VHYT08G_CRIT.YRD-TRKG-YRD = VHYT08IW-PASSVALUE.YRD_TRKG_YRD;
    VHYT08G_CRIT.FR-POSN-NO = VHYT11IW-PASSVALUE.FROM-POSITION;
    VHYT08G_CRIT.TO-POSN-NO = VHYT11IW-PASSVALUE.TO-POSITION;
    VHYT08G_CRIT.TOT-CAR-MOVED =(VHYT08G_CRIT.TO-POSN-NO -
            VHYT08G_CRIT.FR-POSN-NO) + 1;
    VHYT08G_CRIT.TERM-ID = VH01A01_DATA.TERM-ID;
    VHYT08G_CRIT.USER-GROUP = VH01A01_DATA.USER-GROUP;
    if(VHYT08G_CRIT.FR-POSN-NO > 0 && VHYT08IW-PASSVALUE.YRD-SUB-LOC-TO !=
                    "   ")
        move VHYT08A_DATA.SV-DATA-ROW to VHYT08G_DATA.SV-DATA-ROW[1] for all;

        
        
        try
            call "VHYT08G"(XDCONTROL, VHYT08G_CRIT, VHYT08G_DATA);

        end
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if(VHYT08G_DATA.DB-CHANGE == "Y")
                VHYT08IW-MESSAGE.TEMP-MSG-1 = " Data base has been changed.  Car can not be moved.  Please re-do this function ";
                VHYT08IW-MESSAGE.MESSAGE = VHYT08IW-MESSAGE.TEMP-MESSAGE;
                VHYT08IW-MESSAGE.TEMP-MESSAGE = "  ";
                VHYT11IW-PASSVALUE.FROM-CAR = " ";
                VHYT11IW-PASSVALUE.TO-CAR = " ";
            else
                if(VHYT08G_DATA.TRK-IS-FULL == "Y")
                    VHYT08IW-MESSAGE.TEMP-MSG-1 = " Car can not be moved. Please select another track. No enough room on Track ";
                    VHYT08IW-MESSAGE.TEMP-MSG-2 = VHYT08G_CRIT.TO-YRD-SUB-LOC;
                    VHYT08IW-MESSAGE.MESSAGE = VHYT08IW-MESSAGE.TEMP-MESSAGE;
                    VHYT08IW-MESSAGE.TEMP-MESSAGE = "  ";
                    VHYT11IW-PASSVALUE.FROM-CAR = " ";
                    VHYT11IW-PASSVALUE.TO-CAR = " ";
                else
                    if(VHYT08G_DATA.GO-CAR-FOUND == "Y")
                        VHYT08IW-MESSAGE.FINAL-MSG-ALL = " Selected Car(s) not moved, only 'No Go / Never Go'  cars can be moved";
                        VHYT08IW-MESSAGE.MESSAGE = VHYT08IW-MESSAGE.FINAL-MSG-ALL;
                        VHYT11IW-PASSVALUE.FROM-CAR = " ";
                        VHYT11IW-PASSVALUE.TO-CAR = " ";
                    else
                        VHYT08IW-MESSAGE.MESSAGE = "  Car(s) selected are moved ";
                        VHYT08IS-INIT();
                    end
                end
            end
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    else
        VHYT08IW-MESSAGE.MESSAGE = "No car/track selected.  Please select a car/track before press MOVE CAR button";
        if(VHYT08IW-PASSVALUE.YRD-SUB-LOC-TO == " ")
            VHYT08IW-TRIGGER.MOVE-TRK-SETFOCUS = "Y";
        end
    end
end 

function VHYT08IS-MVECAR()
    VHYT08IW-PASSVALUE.BUTTOM = "MOVECAR";
    VHYT08IS-FROM-CAR();
    VHYT11IW-TRIGGER.ERROR-SW-MC = "N";
    if(VHYT11IW-PASSVALUE.FROM-CAR == " ")
        VHYT11IW-MESSAGE.MESSAGE = "Please select valid car to move";
        VHYT11IW-TRIGGER.ERROR-SW-MC = "Y";
    else
        if(VHYT11IW-PASSVALUE.FROM-POSITION == 0 ||
                VHYT11IW-PASSVALUE.TO-POSITION == 0)
            VHYT11IW-MESSAGE.MESSAGE = "No car selected on the track - no cars moved";
            VHYT11IW-TRIGGER.ERROR-SW-MC = "Y";
        else
            if(VHYT08IW-1.CAR-NO-1 == " " && VHYT08IW-1.CAR-NO-2 == " " &&
                    VHYT08IW-1.CAR-NO-3 == " " && VHYT08IW-1.CAR-NO-4 == " " &&
                    VHYT08IW-1.CAR-NO-5 == " " && VHYT08IW-1.CAR-NO-6 == " " &&
                    VHYT08IW-1.CAR-NO-7 == " " && VHYT08IW-1.CAR-NO-8 == " " &&
                    VHYT08IW-1.CAR-NO-9 == " " && VHYT08IW-1.CAR-NO-10 ==
                            " " && VHYT08IW-1.CAR-NO-11 == " " &&
                    VHYT08IW-1.CAR-NO-12 == " " && VHYT08IW-1.CAR-NO-13 ==
                            " " && VHYT08IW-1.CAR-NO-14 == " " &&
                    VHYT08IW-1.CAR-NO-15 == " " && VHYT08IW-1.CAR-NO-16 ==
                            " " && VHYT08IW-1.CAR-NO-17 == " " &&
                    VHYT08IW-1.CAR-NO-18 == " " && VHYT08IW-1.CAR-NO-19 ==
                            " " && VHYT08IW-1.CAR-NO-20 == " " &&
                    VHYT08IW-1.CAR-NO-21 == " " && VHYT08IW-1.CAR-NO-22 ==
                            " " && VHYT08IW-1.CAR-NO-23 == " " &&
                    VHYT08IW-1.CAR-NO-24 == " " && VHYT08IW-1.CAR-NO-25 ==
                            " " && VHYT08IW-1.CAR-NO-26 == " " &&
                    VHYT08IW-1.CAR-NO-27 == " " && VHYT08IW-1.CAR-NO-28 ==
                            " " && VHYT08IW-1.CAR-NO-29 == " " &&
                    VHYT08IW-1.CAR-NO-30 == " ")
                VHYT11IW-MESSAGE.MESSAGE = "No car present on current track = no con moved";
                VHYT11IW-TRIGGER.ERROR-SW-MC = "Y";
            else
                if(VHYT11IW-PASSVALUE.CLICK-COUNT > 2)
                    
                    VHYT11IW-MESSAGE.MESSAGE = "Car selected invalid, please select  a range of car.";
                    VHYT11IW-TRIGGER.ERROR-SW-MC = "Y";
                end
            end
        end
    end
    if(VHYT11IW-TRIGGER.ERROR-SW-MC != "Y")
        VHYT11IW-TRIGGER.NO-ERROR-SW-MC = "Y";
    end
end 

