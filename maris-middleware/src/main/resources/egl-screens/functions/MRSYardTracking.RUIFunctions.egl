        VHYT50IW-CTM2.CAR-10-COLOR-B = VHYT50IW-PASSVALUE.CAR-COLOR-B;
        if(isleft)
            VHYT50IW-CTM2.BUTTON-10 = VHYT50A_DATA.VAGen_ORIENTATION[COUNTER] +
