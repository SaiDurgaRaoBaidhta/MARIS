function VHYT10IS-CAR-TYPE()
    COUNTER = 1;
    while(COUNTER <= VHYT10IW-PASSVALUE.CAR-TYPE-COUNTER)
        if(VHYT08C_DATA.CAR-TYPE[COUNTER] == "A1" ||
                VHYT08C_DATA.CAR-TYPE[COUNTER] == "A2")
            VHYT10IW-PASSVALUE.CAR-A-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[COUNTER];
            VHYT10IW-PASSVALUE.CAR-A-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[COUNTER];
        else
            if(VHYT08C_DATA.CAR-TYPE[COUNTER] == "C1" ||
                    VHYT08C_DATA.CAR-TYPE[COUNTER] == "C2")
                VHYT10IW-PASSVALUE.CAR-C-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[COUNTER];
                VHYT10IW-PASSVALUE.CAR-C-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[COUNTER];
            else
                if(VHYT08C_DATA.CAR-TYPE[COUNTER] == "B1" ||
                        VHYT08C_DATA.CAR-TYPE[COUNTER] == "B2")
                    VHYT10IW-PASSVALUE.CAR-B-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[COUNTER];
                    VHYT10IW-PASSVALUE.CAR-B-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[COUNTER];
                end
            end
        end

        if(VHYT08C_DATA.CAR-TYPE[COUNTER] == "D1")
            VHYT10IW-PASSVALUE.CAR-D-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[COUNTER];
            VHYT10IW-PASSVALUE.CAR-D-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[COUNTER];
        else
            if(VHYT08C_DATA.CAR-TYPE[COUNTER] == "E1")
                VHYT10IW-PASSVALUE.CAR-E-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[COUNTER];
                VHYT10IW-PASSVALUE.CAR-E-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[COUNTER];
            end
        end

        if(VHYT08C_DATA.CAR-TYPE[COUNTER] == "L1")
            VHYT10IW-PASSVALUE.CAR-L-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[COUNTER];
            VHYT10IW-PASSVALUE.CAR-L-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[COUNTER];
        else
            if(VHYT08C_DATA.CAR-TYPE[COUNTER] == "M1")
                VHYT10IW-PASSVALUE.CAR-M-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[COUNTER];
                VHYT10IW-PASSVALUE.CAR-M-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[COUNTER];
            end
        end
        if(VHYT08C_DATA.CAR-TYPE[COUNTER] == "K1" ||
                VHYT08C_DATA.CAR-TYPE[COUNTER] == "K2")
            VHYT10IW-PASSVALUE.CAR-K-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[COUNTER];
            VHYT10IW-PASSVALUE.CAR-K-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[COUNTER];
        end
        COUNTER = COUNTER + 1;
    end
end 

