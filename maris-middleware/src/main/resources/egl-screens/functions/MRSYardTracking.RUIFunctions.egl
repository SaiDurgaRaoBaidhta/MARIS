function VHYT08IS-CAR-TYPE()
    CAR-COUNTER = 1;
    while(CAR-COUNTER <= VHYT08IW-PASSVALUE.CAR-TYPE-COUNT)
        if(VHYT08C_DATA.CAR-TYPE[CAR-COUNTER] == "A2")
            VHYT08IW-PASSVALUE.CAR-A-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[CAR-COUNTER];
            VHYT08IW-PASSVALUE.CAR-A-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[CAR-COUNTER];
        else
            if(VHYT08C_DATA.CAR-TYPE[CAR-COUNTER] == "C1" ||
                    VHYT08C_DATA.CAR-TYPE[CAR-COUNTER] == "C2")
                VHYT08IW-PASSVALUE.CAR-C-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[CAR-COUNTER];
                VHYT08IW-PASSVALUE.CAR-C-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[CAR-COUNTER];
            else
                if(VHYT08C_DATA.CAR-TYPE[CAR-COUNTER] == "B2")
                    VHYT08IW-PASSVALUE.CAR-B-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[CAR-COUNTER];
                    VHYT08IW-PASSVALUE.CAR-B-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[CAR-COUNTER];
                end
            end
        end
        if(VHYT08C_DATA.CAR-TYPE[CAR-COUNTER] == "D1")
            VHYT08IW-PASSVALUE.CAR-D-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[CAR-COUNTER];
            VHYT08IW-PASSVALUE.CAR-D-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[CAR-COUNTER];
        else
            if(VHYT08C_DATA.CAR-TYPE[CAR-COUNTER] == "E1")
                VHYT08IW-PASSVALUE.CAR-E-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[CAR-COUNTER];
                VHYT08IW-PASSVALUE.CAR-E-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[CAR-COUNTER];
            end
        end
        if(VHYT08C_DATA.CAR-TYPE[CAR-COUNTER] == "L1")
            VHYT08IW-PASSVALUE.CAR-L-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[CAR-COUNTER];
            VHYT08IW-PASSVALUE.CAR-L-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[CAR-COUNTER];
        else
            if(VHYT08C_DATA.CAR-TYPE[CAR-COUNTER] == "M1")
                VHYT08IW-PASSVALUE.CAR-M-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[CAR-COUNTER];
                VHYT08IW-PASSVALUE.CAR-M-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[CAR-COUNTER];
            end
        end
        if(VHYT08C_DATA.CAR-TYPE[CAR-COUNTER] == "K1" ||
                VHYT08C_DATA.CAR-TYPE[CAR-COUNTER] == "K2")
            VHYT08IW-PASSVALUE.CAR-K-LEFT-ORIENTATION = VHYT08C_DATA.LFT-ORIENTATION-CD[CAR-COUNTER];
            VHYT08IW-PASSVALUE.CAR-K-RIGHT-ORIENTATION = VHYT08C_DATA.RGT-ORIENTATION-CD[CAR-COUNTER];
        end
        CAR-COUNTER = CAR-COUNTER + 1;
    end
end 

function VHYT08IS-CHANGE()
    if(VHYT08IW-PASSVALUE.CLICK-COUNT == 0)
        VHYT08IW-MESSAGE.MESSAGE = "No car present in position selected - please correct selection";
    else
        VHYT08IS-REASON();
        VHYT08IW-TRIGGER.RUN-VHYT06I = "Y";
    end
end 

function VHYT08IS-CK-USER()
    VHYT08IS-CLEAR();
    VH01A02_CRIT.GUI-NAME = "VHYT08";
    
    
    
    
    
    
    
    
    VHYT08D_CRIT.YRD-TRKG-YRD = VHYT08IW-PASSVALUE.YRD_TRKG_YRD;
    VHYT08D_CRIT.USER-GRP = VH01A01_DATA.USER-GROUP;
    
    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT08I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT08D";

    
    try
        call "VHYT08D"(XDCONTROL, VHYT08D_CRIT, VHYT08D_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if((VHYT08IW-PASSVALUE.YRD_TRKG_YRD ==
                    VHYT08D_DATA.YRD-TRKG-YRD) ||(VHYT08D_DATA.YRD-TRKG-YRD ==
                            "ALL") || VHYT08D_DATA.PSEUDO-YRD-IND == "Y")
                VHYT08IW-PASSVALUE.USER-OK = "Y";
                VHYT08IW-PASSVALUE.USER-NOT-OK = " ";
            else
                
                VHYT08IW-PASSVALUE.USER-NOT-OK = "Y";
                VHYT08IW-PASSVALUE.USER-OK = " ";
            end
        else
            VHYT08IW-PASSVALUE.USER-NOT-OK = "Y";
            VHYT08IW-PASSVALUE.USER-OK = " ";
        end
    else

        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end 
    if(VHYT08IW-PASSVALUE.USER-OK == "Y")
        VHYT08IW-TRIGGER.ENABLE-CHANGE = "Y";
    else
        if(VHYT08IW-PASSVALUE.USER-NOT-OK == "Y")
            VHYT08IW-TRIGGER.DISABLE-CHANGE = "Y";
        end
    end
end 

function VHYT08IS-CK-USER1()
    VHYT08IS-CLEAR();
    
    
    
    
    
    
    
    
    VHYT08E_CRIT.YRD-TRKG-YRD = VHYT08IW-PASSVALUE.YRD_TRKG_YRD;
    VHYT08E_CRIT.YRD = VHYT08IW-PASSVALUE.YRD_TRKG_YRD;
    
    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT08I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT08E";

    
    try
        call "VHYT08E"(XDCONTROL, VHYT08E_CRIT, VHYT08E_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            
            VHYT08IW-PASSVALUE.USER-OK = "Y";
            VHYT08IW-PASSVALUE.USER-NOT-OK = " ";
        else
            VHYT08IW-PASSVALUE.USER-NOT-OK = "Y";
            VHYT08IW-PASSVALUE.USER-OK = " ";
        end
    else

        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end 
    if(VHYT08IW-PASSVALUE.USER-OK == "Y")
        VHYT08IW-TRIGGER.ENABLE-CHANGE = "Y";
    else
        if(VHYT08IW-PASSVALUE.USER-NOT-OK == "Y")
            VHYT08IW-TRIGGER.DISABLE-CHANGE = "Y";
        end
    end
end 

