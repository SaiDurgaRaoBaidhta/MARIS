function VHYT07IS-COLOR()
    if(VHYT07A_DATA.HOME-YRD[COUNTER] == "HY")
        VHYT07IW-PASSVALUE.CAR-COLOR = "GREEN";
        VHYT07IW-PASSVALUE.CAR-COLOR-B = "GREY90";
    else
        if(VHYT07A_DATA.HOME-YRD[COUNTER] == "RY")
            VHYT07IW-PASSVALUE.CAR-COLOR = "BROWN";
            VHYT07IW-PASSVALUE.CAR-COLOR-B = "GREY90";
        else
            if(VHYT07A_DATA.HOME-YRD[COUNTER] == "CY")
                VHYT07IW-PASSVALUE.CAR-COLOR = "BLUE";
                VHYT07IW-PASSVALUE.CAR-COLOR-B = "GREY90";
            else
                if(VHYT07A_DATA.HOME-YRD[COUNTER] == "DY")
                    VHYT07IW-PASSVALUE.CAR-COLOR = "RED";
                    VHYT07IW-PASSVALUE.CAR-COLOR-B = "GREY90";
                else
                    VHYT07IW-PASSVALUE.CAR-COLOR = "BLACK";
                    VHYT07IW-PASSVALUE.CAR-COLOR-B = "GREY90";
                end
            end
        end
    end
end 

function VHYT07IS-INIT()
    VHYT07IS-S-EMPTY();
    VHYT07IS-CLEAR();
    VHYT07IS-CLR-R93();
    VHYT07IW-PASSVALUE.YRD-TRKG-YRD = "HY";
    
    
    
    
    
    
    
    

    
    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT07I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT07A";

    
    try
        call "VHYT07A"(XDCONTROL, VHYT07A_CRIT, VHYT07A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT07IS-LOAD();
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT07IS-LOAD()
    COUNTER = 1;
    while(VHYT07IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)

        if(VHYT07A_DATA.YRD-SUB-LOC[COUNTER] == "T-10")
            VHYT07IS-T10();
        end
        if(VHYT07A_DATA.YRD-SUB-LOC[COUNTER] == "T-11")
