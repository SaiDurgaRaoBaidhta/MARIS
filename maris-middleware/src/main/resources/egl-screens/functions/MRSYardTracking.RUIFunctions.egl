        VHYT40IW-LTM2.CAR-8-COLOR = VHYT40IW-PASSVALUE.CAR-COLOR;
        VHYT40IW-LTM2.CAR-8-COLOR-B = VHYT40IW-PASSVALUE.CAR-COLOR-B;
        if(isleft)
            VHYT40IW-LTM2.BUTTON-8 = VHYT40A_DATA.VAGen_ORIENTATION[COUNTER] +
                    VHYT40A_DATA.CAR-NO[COUNTER];
        else
            VHYT40IW-LTM2.BUTTON-8 = VHYT40A_DATA.CAR-NO[COUNTER] +
                    VHYT40A_DATA.VAGen_ORIENTATION[COUNTER];
        end
    end
    if(VHYT40A_DATA.POSN-NO[COUNTER] == 9)
        VHYT40IW-LTM2.ORIENTATION-9 = VHYT40A_DATA.VAGen_ORIENTATION[COUNTER];
        VHYT40IW-LTM2.CAR-NO-9 = VHYT40A_DATA.CAR-NO[COUNTER];
        VHYT40IS-COLOR();
        VHYT40IW-LTM2.CAR-9-COLOR = VHYT40IW-PASSVALUE.CAR-COLOR;
        VHYT40IW-LTM2.CAR-9-COLOR-B = VHYT40IW-PASSVALUE.CAR-COLOR-B;
        if(isleft)
            VHYT40IW-LTM2.BUTTON-9 = VHYT40A_DATA.VAGen_ORIENTATION[COUNTER] +
                    VHYT40A_DATA.CAR-NO[COUNTER];
        else
            VHYT40IW-LTM2.BUTTON-9 = VHYT40A_DATA.CAR-NO[COUNTER] +
                    VHYT40A_DATA.VAGen_ORIENTATION[COUNTER];
        end
    end
    if(VHYT40A_DATA.POSN-NO[COUNTER] == 10)
        VHYT40IW-LTM2.ORIENTATION-10 = VHYT40A_DATA.VAGen_ORIENTATION[COUNTER];
        VHYT40IW-LTM2.CAR-NO-10 = VHYT40A_DATA.CAR-NO[COUNTER];
        VHYT40IS-COLOR();
        VHYT40IW-LTM2.CAR-10-COLOR = VHYT40IW-PASSVALUE.CAR-COLOR;
        VHYT40IW-LTM2.CAR-10-COLOR-B = VHYT40IW-PASSVALUE.CAR-COLOR-B;
        if(isleft)
            VHYT40IW-LTM2.BUTTON-10 = VHYT40A_DATA.VAGen_ORIENTATION[COUNTER] +
                    VHYT40A_DATA.CAR-NO[COUNTER];
        else
            VHYT40IW-LTM2.BUTTON-10 = VHYT40A_DATA.CAR-NO[COUNTER] +
                    VHYT40A_DATA.VAGen_ORIENTATION[COUNTER];
        end
    end
end 

