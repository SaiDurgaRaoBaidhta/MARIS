function VHYT40IS-LOAD()
    COUNTER = 1;
    while(VHYT40IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if(VHYT40A_DATA.YRD-SUB-LOC[COUNTER] == "L1")
            VHYT40IS-L1();
        end
        if(VHYT40A_DATA.YRD-SUB-LOC[COUNTER] == "L2")
            VHYT40IS-L2();
        end
        if(VHYT40A_DATA.YRD-SUB-LOC[COUNTER] == "LTM1")
            VHYT40IS-LTM1();
        end
        if(VHYT40A_DATA.YRD-SUB-LOC[COUNTER] == "LTM2")
            VHYT40IS-LTM2();
        end
        if(VHYT40A_DATA.YRD-SUB-LOC[COUNTER] == "LB1")
            VHYT40IS-LB1();
        end
        if(VHYT40A_DATA.YRD-SUB-LOC[COUNTER] == "LB2")
            VHYT40IS-LB2();
        end
        if(VHYT40A_DATA.YRD-SUB-LOC[COUNTER] == "LSTOR1")
            VHYT40IS-LSTOR1();
        end
        if(VHYT40A_DATA.YRD-SUB-LOC[COUNTER] == "LSTOR2")
            VHYT40IS-LSTOR2();
        end
        COUNTER = COUNTER + 1;
    end
end 

