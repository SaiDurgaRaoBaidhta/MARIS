function VHYT12IS-IDENT-CRS()
    LEAD-OR-ERROR = "N";
    END-OR-ERROR = "N";
    CAR-IN-CON = "N";
    CAR-ERROR = "N";
    VHYT12IW.CON-SIZE = 0;
    set VHYT12IW-MSG empty;
    ERROR-CNT = 0;

    
    if(VHYT12IW.CAR-NO-1 == " ")
        ERROR-CNT = ERROR-CNT + 1;
        ERROR-MESSAGE-OCCR[ERROR-CNT] = "First car cannot be blank.";
        VHYT12IW-TRIGGER.CAR-ERROR = "Y";

    
    else
        if(VHYT12IW.CAR-NO-2 == " ")
            VHYT12IS-IDENT-CR1();
            ERROR-CNT = ERROR-CNT + 1;
            ERROR-MESSAGE-OCCR[ERROR-CNT] = "Train has less than 2 cars.";
            VHYT12IW-TRIGGER.CAR-ERROR = "Y";
            CON-SIZE = 1;
        else
            if(VHYT12IW.CAR-NO-3 == " ")
                VHYT12IW.CON-SIZE = 2;
                VHYT12IS-IDENT-CR1();
                VHYT12IS-IDENT-CR2();
            else
                if(VHYT12IW.CAR-NO-4 == " ")
                    VHYT12IW.CON-SIZE = 3;
                    VHYT12IS-IDENT-CR1();
                    VHYT12IS-IDENT-CR2();
                    VHYT12IS-IDENT-CR3();
                else
                    if(VHYT12IW.CAR-NO-5 == " ")
                        VHYT12IW.CON-SIZE = 4;
                        VHYT12IS-IDENT-CR1();
                        VHYT12IS-IDENT-CR2();
                        VHYT12IS-IDENT-CR3();
                        VHYT12IS-IDENT-CR4();
                    else
                        if(VHYT12IW.CAR-NO-6 == " ")
                            VHYT12IW.CON-SIZE = 5;
                            VHYT12IS-IDENT-CR1();
                            VHYT12IS-IDENT-CR2();
                            VHYT12IS-IDENT-CR3();
                            VHYT12IS-IDENT-CR4();
                            VHYT12IS-IDENT-CR5();
                        else
                            if(VHYT12IW.CAR-NO-7 == " ")
                                VHYT12IW.CON-SIZE = 6;
                                VHYT12IS-IDENT-CR1();
                                VHYT12IS-IDENT-CR2();
                                VHYT12IS-IDENT-CR3();
                                VHYT12IS-IDENT-CR4();
                                VHYT12IS-IDENT-CR5();
                                VHYT12IS-IDENT-CR6();
                            else
                                if(VHYT12IW.CAR-NO-8 == " ")
                                    VHYT12IW.CON-SIZE = 7;
                                    VHYT12IS-IDENT-CR1();
                                    VHYT12IS-IDENT-CR2();
                                    VHYT12IS-IDENT-CR3();
                                    VHYT12IS-IDENT-CR4();
                                    VHYT12IS-IDENT-CR5();
                                    VHYT12IS-IDENT-CR6();
                                    VHYT12IS-IDENT-CR7();
                                else
                                    if(VHYT12IW.CAR-NO-9 == " ")
                                        VHYT12IW.CON-SIZE = 8;
                                        VHYT12IS-IDENT-CR1();
                                        VHYT12IS-IDENT-CR2();
                                        VHYT12IS-IDENT-CR3();
                                        VHYT12IS-IDENT-CR4();
                                        VHYT12IS-IDENT-CR5();
                                        VHYT12IS-IDENT-CR6();
                                        VHYT12IS-IDENT-CR7();
                                        VHYT12IS-IDENT-CR8();
                                    else
                                        if(VHYT12IW.CAR-NO-10 == " ")
                                            VHYT12IW.CON-SIZE = 9;
                                            VHYT12IS-IDENT-CR1();
                                            VHYT12IS-IDENT-CR2();
                                            VHYT12IS-IDENT-CR3();
                                            VHYT12IS-IDENT-CR4();
                                            VHYT12IS-IDENT-CR5();
                                            VHYT12IS-IDENT-CR6();
                                            VHYT12IS-IDENT-CR7();
                                            VHYT12IS-IDENT-CR8();
                                            VHYT12IS-IDENT-CR9();
                                        else
                                            VHYT12IW.CON-SIZE = 10;
                                            VHYT12IS-IDENT-CR1();
                                            VHYT12IS-IDENT-CR2();
                                            VHYT12IS-IDENT-CR3();
                                            VHYT12IS-IDENT-CR4();
                                            VHYT12IS-IDENT-CR5();
                                            VHYT12IS-IDENT-CR6();
                                            VHYT12IS-IDENT-CR7();
                                            VHYT12IS-IDENT-CR8();
                                            VHYT12IS-IDENT-CR9();
                                            VHYT12IS-IDENT-CRX();
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if(ERROR-CNT > 0)
        VHYT12IS-MOVE-MSG();
    else
        if(CAR-IN-CON == "Y")
            CAR-IN-CON-PROMPT = "Y";
        else
            VHYT12IS-VALID-OR();
        end
    end
end 

function VHYT12IS-IDENT-CRX()
    if(VHYT12A_DATA.CAR-TYPE[10] == "XX" || VHYT12A_DATA.CAR-TYPE[10] == "XX")

    else
        if(VHYT12A_DATA.VAGen_ORIENTATION[10] ==
                VHYT12A_DATA.LFT-ORIENTATION-CD[10])
            VHYT12IW.LFT-OR-10 = VHYT12A_DATA.VAGen_ORIENTATION[10];
            END-OR-ERROR = "Y";
        else
            VHYT12IW.RGT-OR-10 = VHYT12A_DATA.VAGen_ORIENTATION[10];
        end
    end
    VHYT12IW.CAR-10 = VHYT12A_DATA.CAR-NO[10];
    if(VHYT12IW.CAR-NO-10 is numeric)

        
        VHYT12C_CRIT.CAR-NO = VHYT12IW.CAR-NO-10;
        try
            call "VHYT12C"(XDCONTROL, VHYT12C_CRIT, VHYT12C_DATA);

        end
        if((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
            CAR-IN-CON = "Y";
            VHYT12IW-COLOR.CON-10-COLOR = "RED";
            VHYT12IW.CON-NO-10 = VHYT12C_DATA.CON-NO;
            VHYT12IW.PART-IND-10 = VHYT12C_DATA.PART-IND;
        end
    end
end 

function VHYT12IS-INIT()
    VHYT12IW.CON-NO = " ";
    CON-NO-SETFOCUS = "Y";
    set VHYT12IW empty;
    set VHYT12IW-MSG empty;
    VHYT12IW-COLOR.CON-1-COLOR = "RED";
    VHYT12IW-COLOR.CON-2-COLOR = "RED";
    VHYT12IW-COLOR.CON-3-COLOR = "RED";
    VHYT12IW-COLOR.CON-4-COLOR = "RED";
    VHYT12IW-COLOR.CON-5-COLOR = "RED";
    VHYT12IW-COLOR.CON-6-COLOR = "RED";
    VHYT12IW-COLOR.CON-7-COLOR = "RED";
    VHYT12IW-COLOR.CON-8-COLOR = "RED";
    VHYT12IW-COLOR.CON-9-COLOR = "RED";
    VHYT12IW-COLOR.CON-10-COLOR = "RED";
end 

function VHYT12IS-LOAD-CARS()
    set VHYT12A_DATA empty;
    set VHYT12IW empty;
    FINAL-MSG = "   ";

    
    
    
    
    
    
    VHYT12A_CRIT.YRD-SUB-LOC = VHYT12IW-PASSVALUE.YRD-SUB-LOC;
    VHYT12A_CRIT.FROM-POS = VHYT12IW-PASSVALUE.FROM-POS;
    VHYT12A_CRIT.TO-POS = VHYT12IW-PASSVALUE.TO-POS;
    VHYT12A_CRIT.YRD-TRKG-YRD = VHYT12IW-PASSVALUE.YRD-TRKG-YRD;
    try
        call "VHYT12A"(XDCONTROL, VHYT12A_CRIT, VHYT12A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();
    
    if(XXEXT_CALL_Level77Items.URC == 0)
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT12IS-MOVE-CARS();
        else
            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT12IS-MOVE-CARS()
    VHYT12IW.CAR-NO-1 = VHYT12A_DATA.CAR-NO[1];
    VHYT12IW.CAR-NO-2 = VHYT12A_DATA.CAR-NO[2];
    VHYT12IW.CAR-NO-3 = VHYT12A_DATA.CAR-NO[3];
    VHYT12IW.CAR-NO-4 = VHYT12A_DATA.CAR-NO[4];
    VHYT12IW.CAR-NO-5 = VHYT12A_DATA.CAR-NO[5];
    VHYT12IW.CAR-NO-6 = VHYT12A_DATA.CAR-NO[6];
    VHYT12IW.CAR-NO-7 = VHYT12A_DATA.CAR-NO[7];
    VHYT12IW.CAR-NO-8 = VHYT12A_DATA.CAR-NO[8];
    VHYT12IW.CAR-NO-9 = VHYT12A_DATA.CAR-NO[9];
