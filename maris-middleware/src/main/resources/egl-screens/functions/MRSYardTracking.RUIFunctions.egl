function VHYT41IS-CLK-LB2()
    VHYT41IW-MOVE.CLICKED = VHYT41IW-MOVE.CLICKED + 1;
    if(VHYT41IW-MOVE.CLICKED == 1)
        VHYT41IW-MOVE.FIRST-CLICK = "LB2";
        VHYT41IW-PASSVALUE.FROM-CAR-POSN = VHYT41IW-PARM.POSN;
        VHYT41IW-PASSVALUE.TO-CAR-POSN = VHYT41IW-PARM.POSN;
        VHYT41IW-PASSVALUE.FROM-YRD-SUB-LOC = "LB2";
    else
        if(VHYT41IW-MOVE.CLICKED == 2)
            VHYT41IW-MOVE.SECOND-CLICK = "LB2";
            if(VHYT41IW-MOVE.FIRST-CLICK == VHYT41IW-MOVE.SECOND-CLICK)
                VHYT41IW-PASSVALUE.TO-CAR-POSN = VHYT41IW-PARM.POSN;
            end
        else
            if(VHYT41IW-MOVE.CLICKED == 3)
                VHYT41IW-MOVE.THIRD-CLICK = "LB2";
                VHYT41IW-PASSVALUE.TO-YRD-SUB-LOC = "LB2";
                VHYT41IW-TRIGGER.OPEN-DETAIL = "Y";
            end
        end
    end
end 

