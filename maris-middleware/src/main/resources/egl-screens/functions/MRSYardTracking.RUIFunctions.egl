function VHYT09IS-MOVE-DATA()
    X = 1;
    Y1 = 1;
    while(X <= VHYT09IW-CNT.CON-ROW-CNT)
        if(VHYT09B_DATA.CON-NO[X] == VHYT09C_DATA.CON-NO[Y1])
            Y2 = Y1 + 1;
            Y3 = Y2 + 1;
            Y4 = Y3 + 1;
            Y5 = Y4 + 1;
            Y6 = Y5 + 1;
            Y7 = Y6 + 1;
