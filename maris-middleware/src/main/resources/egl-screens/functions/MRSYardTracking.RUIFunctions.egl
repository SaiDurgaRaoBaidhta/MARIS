

package MRSYardTracking;

function GiveAColor(VEHSTAT char(6) const in, TRAININCD char(1) const in, HIGHPMHR smallInt const in) returns(string)
    aColor string;
    if(strLib.clip(VEHSTAT, 2) == "GO" && TRAININCD != "Y")
        if(HIGHPMHR == 1)
            aColor = "BROWN";
        else
            aColor = "BLACK";
        end
    else
        if(strLib.clip(VEHSTAT, 2) == "USABLE" && TRAININCD != "Y")
            aColor = "BLUE";
        else
            aColor = "RED";
        end
    end
    return(aColor);
end

function dy100Color(HOME_YARD char(3) const in) returns(string)
    theColor string;
    
    if(HOME_YARD == "HY")
        theColor = "GREEN";
    else
        if(HOME_YARD == "RY")
            theColor = "BROWN";
        else
            if(HOME_YARD == "CY")
                theColor = "BLUE";
            else
                if(HOME_YARD == "DY")
                    theColor = "RED";
                else
                    theColor = "BLACK";
                end
            end
        end
    end
    return(theColor);
end 

function VGTT03IS-PRE-VAL()
    if(VHYT03IW-CAR-DA.MOVE-COUNTER == 0 || VHYT03IW-CAR-DAX.MOVE-REASON-X == " ")
        return;
    else
        VHYT03IS-VAL-NEWL();
    end
end

function VH03IS-UPDATE()

    if(VHYT10IW-PASSVALUE.CAR-NO-2 != " ")
        VHYT03IW-MESSAGE.MSG-3-1 = "To location is occupied by Car No. ";
        VHYT03IW-MESSAGE.CAR-NO-3 = VHYT10IW-PASSVALUE.CAR-NO-2;
        VHYT03IW-MESSAGE.ERROR-MESSAGE = VHYT03IW-MESSAGE.ERROR-MESSAGE-3;
        VHYT03IW-CAR-DA.SET-CAR-FOCUS = "Y";
        VHYT03IW-TRIGGER.DISABLE-UPDATE = "Y";
        VHYT03IW-TRIGGER.DISABLE-SVHV = "Y";
        VHYT03IW-TRIGGER.INVALID-2ND-CAR = "Y";
    else
        if(VHYT03IW-CAR-DAX.MOVE-REASON-CD == "17")
            VHYT03IW-MESSAGE.ERROR-MESSAGE = "Reason code 17 must be changed.  Please select a new reason code from the drop down";
            VHYT03IW-TRIGGER.DISABLE-UPDATE = "Y";
            VHYT03IW-TRIGGER.DISABLE-SVHV = "Y";
            VHYT03IW-TRIGGER.INVALID-REASON = "Y";
        else
            if(VHYT03IW-CAR-DAX.MOVE-REASON-CD == "  ")
                VHYT03IW-MESSAGE.ERROR-MESSAGE = "Please select a new reason code from the drop down";
                VHYT03IW-TRIGGER.DISABLE-UPDATE = "Y";
                VHYT03IW-TRIGGER.DISABLE-SVHV = "Y";
                VHYT03IW-TRIGGER.INVALID-REASON = "Y";
            else
                if(VHYT03D_DATA.MOVE-REASON-CD ==
                        VHYT03IW-CAR-DAX.MOVE-REASON-CD &&
                        VHYT42IW.CONTINUE-UPDATE != "Y")
                    VHYT03IW-TRIGGER.OPEN-VHYT42I = "Y";
                else
                    if((VHYT03D_DATA.MOVE-REASON-CD !=
                            VHYT03IW-CAR-DAX.MOVE-REASON-CD &&
                            VHYT03IW-CAR-DA.YRD-SUB-LOC-X ==
                                    VHYT03IW-CAR-DAX.NEW-YARD-LOC-X) ||(
                            VHYT03D_DATA.MOVE-REASON-CD !=
                                    VHYT03IW-CAR-DAX.MOVE-REASON-CD &&
                                    VHYT03IW-CAR-DAX.NEW-YARD-LOC-X == " "))
                        VHYT03IS-ONLY-MOVE();
                    else
                        if((VHYT03D_DATA.MOVE-REASON-CD !=
                                VHYT03IW-CAR-DAX.MOVE-REASON-CD &&
                                VHYT03IW-CAR-DA.YRD-SUB-LOC-X !=
                                        VHYT03IW-CAR-DAX.NEW-YARD-LOC-X) ||(
                                VHYT03D_DATA.MOVE-REASON-CD ==
                                        VHYT03IW-CAR-DAX.MOVE-REASON-CD &&
                                        VHYT03IW-CAR-DA.YRD-SUB-LOC-X !=
                                                VHYT03IW-CAR-DAX.NEW-YARD-LOC-X) ||
                                ((VHYT03IW-PASSVALUE.POSN-NO-FROM !=
                                        VHYT03IW-PASSVALUE.POSN-NO-TO)))
                            VHYT03IS-BOTH-CHG();
                        else
                            VHYT03IW-MESSAGE.ERROR-MESSAGE = "Update action invalid since neither Reason nor Sub-Location has changed";

                        end
                    end
                end
            end
        end
    end
end 

function VHSV08IS-SV06-14()
    if(VHYT08IW-1.VEH-STAT-14 != " ")
        VHYT08IW-PASSVALUE.CAR-NO = VHYT08IW-1.CAR-NO-14-CENTER;
        VHYT08IW-TRIGGER.OPEN-SV06 = "Y";
    end
end

