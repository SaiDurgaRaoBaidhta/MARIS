    set VHYT60IW-1A empty;
    set VHYT60IW-1B empty;
    set VHYT60IW-2A empty;
    set VHYT60IW-2B empty;
    set VHYT60IW-2C empty;
    set VHYT60IW-2D empty;
    set VHYT60IW-3A empty;
    set VHYT60IW-3B empty;
    set VHYT60IW-3C empty;
    set VHYT60IW-3D empty;
    set VHYT60IW-S7-1 empty;
    set VHYT60IW-S7-2 empty;
    set VHYT60IW-S7-3 empty;
    set VHYT60IW-S7-4 empty;
    set VHYT60IW-S6-1 empty;
    set VHYT60IW-S6-2 empty;
    set VHYT60IW-S6-3 empty;
    set VHYT60IW-S6-4 empty;
    set VHYT60IW-S6-5 empty;
    set VHYT60IW-S6-6 empty;
    set VHYT60IW-S5-1 empty;
    set VHYT60IW-S5-2 empty;
    set VHYT60IW-S5-3 empty;
    set VHYT60IW-S5-4 empty;
    set VHYT60IW-S5-5 empty;
    set VHYT60IW-S5-6 empty;
    set VHYT60IW-MT-1 empty;
    set VHYT60IW-MT-2 empty;
    set VHYT60IW-MT-3 empty;
    set VHYT60IW-MT-4 empty;
    set VHYT60IW-RRBP-2 empty;
    set VHYT60IW-RRBP-3 empty;
    set VHYT60IW-S8-1 empty;
    set VHYT60IW-S8-2 empty;
    set VHYT60IW-S1-N empty;
    set VHYT60IW-S2-N empty;
    set VHYT60IW-RM-1 empty;
    set VHYT60IW-RM-2 empty;
    set VHYT60IW-RM-3 empty;
    set VHYT60IW-RM-4 empty;
    set VHYT60IW-RRBP-2B empty;
