function VHYT05IS-R91()
    txt char(6) = "      ";
    isleft boolean = strLib.indexOf("<O({vblm",
                    VHYT07A_DATA.VAGen_ORIENTATION[COUNTER]) > 0;
    if(isleft)
        txt = VHYT07A_DATA.VAGen_ORIENTATION[COUNTER] +
                VHYT07A_DATA.CAR-NO[COUNTER];
    else
        txt = VHYT07A_DATA.CAR-NO[COUNTER] +
                VHYT07A_DATA.VAGen_ORIENTATION[COUNTER];
    end
    if(strLib.characterLen(strLib.clip(VHYT07A_DATA.SOFTVER[COUNTER], 0)) > 0)
        txt = "$" + txt;
    end
    aColor string = GiveAColor(VHYT07A_DATA.VEH-STAT[COUNTER],
                    VHYT07A_DATA.TRAIN_INCD_IND[COUNTER],
                    VHYT07A_DATA.HPMHRS[COUNTER]);
    if(VHYT07A_DATA.POSN-NO[COUNTER] == 1)
        VHYT07IW-R91.ORIENTATION-1 = VHYT07A_DATA.VAGen_ORIENTATION[COUNTER];
        VHYT07IW-R91.CAR-NO-1 = VHYT07A_DATA.CAR-NO[COUNTER];
        VHYT07IW-R91.BUTTON-1 = strLib.clip(txt, 0);
