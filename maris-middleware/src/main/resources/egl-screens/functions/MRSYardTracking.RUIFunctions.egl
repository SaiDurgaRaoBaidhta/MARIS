function VHYT50IS-COLOR()
    if(VHYT50A_DATA.HOME-YRD[COUNTER] == "HY")
        VHYT50IW-PASSVALUE.CAR-COLOR = "GREEN";
        VHYT50IW-PASSVALUE.CAR-COLOR-B = "GREY80";
    else
        if(VHYT50A_DATA.HOME-YRD[COUNTER] == "RY")
            VHYT50IW-PASSVALUE.CAR-COLOR = "BROWN";
            VHYT50IW-PASSVALUE.CAR-COLOR-B = "GREY80";
        else
            if(VHYT50A_DATA.HOME-YRD[COUNTER] == "CY")
                VHYT50IW-PASSVALUE.CAR-COLOR = "BLUE";
                VHYT50IW-PASSVALUE.CAR-COLOR-B = "GREY80";
            else
                if(VHYT50A_DATA.HOME-YRD[COUNTER] == "DY")
                    VHYT50IW-PASSVALUE.CAR-COLOR = "RED";
                    VHYT50IW-PASSVALUE.CAR-COLOR-B = "GREY80";
                else
                    VHYT50IW-PASSVALUE.CAR-COLOR = "BLACK";
                    VHYT50IW-PASSVALUE.CAR-COLOR-B = "GREY80";
                end
            end
        end
    end
end 

