function VHYT31IS-CLEAR()
    set VHYT31IW-CNT empty;
    set VHYT31B_DATA empty;
    set VHYT31IW-TOT empty;
    set VHYT31IW-MSG empty;
    VHYT31IW-TRIGGER.LOAD-ALL-DATA = "Y";
    DISABLE-CLEAR = "Y";
    DISABLE-PRINT = "Y";
    DISABLE-LIST = "Y";
    VHYT31IW.WS-DATEX = VGVar.currentFormattedGregorianDate;
    VHYT31IW.YARD = " ";
end 

function VHYT31IS-INIT()
    set VHYT31IW-CNT empty;
    set VHYT31B_DATA empty;
    set VHYT31H_DATA empty;
    set VHYT31IW-TOT empty;
    set VHYT31IW-MSG empty;
    ENABLE-LIST = "Y";
    VHYT31IW-TRIGGER.LOAD-ALL-DATA = "Y";
    VHYT31IW.WS-DATEX = VGVar.currentFormattedGregorianDate;
    if(VHYT31IW-PASSVALUE.YRD-TRKG-YRD != "  ")
        VHYT31H_CRIT.YRD = VHYT31IW-PASSVALUE.YRD-TRKG-YRD;
        try
            call "VHYT31H"(XDCONTROL, VHYT31H_CRIT, VHYT31H_DATA);

        end
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT31IW.YRD-TRKG-YRD = VHYT31IW-PASSVALUE.YRD-TRKG-YRD;
            VHYT31IW.YRD-DESC = VHYT31H_DATA.YRD-DESC;
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
    try
        call "VHYT31A"(XDCONTROL, VHYT31A_CRIT, VHYT31A_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        
        
        VHYT31IW-CNT.YRD-CNT = XDCONTROL.UROWCNT;
        VHYT31IW-TRIGGER.LOAD-YRD-DATA = "Y";
        if(VHYT31IW-PASSVALUE.YRD-TRKG-YRD == "  ")
            VHYT31IW.YRD-TRKG-YRD = VHYT31A_DATA.YRD[1];
            VHYT31IW.YRD-DESC = VHYT31A_DATA.YRD-DESC[1];
            VHYT31IW.YARD = VHYT31A_DATA.YARD[1];
        end
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    if(VHYT31IW-PASSVALUE.YRD-TRKG-YRD != "  ")
        VHYT31IW.YRD-TRKG-YRD = VHYT31IW-PASSVALUE.YRD-TRKG-YRD;
        VHYT31IW-PASSVALUE.YRD-TRKG-YRD = "  ";

    
    else
        DISABLE-CLEAR = "Y";
        DISABLE-PRINT = "Y";
    end
    VHYT31IW.WS-DATE = VHYT31IW.WS-DATEX;
end 

function VHYT31IS-LIST2()
    set VHYT31IW-CNT empty;
    set VHYT31B_DATA empty;
    set VHYT31IW-TOT empty;
    set VHYT31IW-MSG empty;
    VHYT31IW-TRIGGER.LOAD-ALL-DATA = "Y";
    if(VHYT31IW.YRD-TRKG-YRD == "ALL")
        VHYT31IW-MSG.FINAL-MSG = "All yards selected.  Print report only.";
        DISABLE-LIST = "Y";
        DISABLE-PRINT = "Y";
        DISABLE-CLEAR = "Y";
        set VHYT31IW-CNT empty;
        VHYT31IW-TRIGGER.PRINT-REPORT-SW = "Y";
    else
        VHYT31B_CRIT.YRD-TRKG-YRD = VHYT31IW.YRD-TRKG-YRD;
        VHYT31IW.WS-DATE = VHYT31IW.WS-DATEX;
        if(VHYT31IW.WS-1 == "-")
            VHYT31E_CRIT.DATE-WORK = VHYT31IW.WS-DATE;
        else
            DATE-MM-DD-YYYY = VHYT31IW.WS-DATE;
            move MONTH-MM-DD-YYYY to MONTH-YYYY-MM-DD withV60Compat;
            move DAY-MM-DD-YYYY to DAY-YYYY-MM-DD withV60Compat;
            move YEAR-MM-DD-YYYY to YEAR-YYYY-MM-DD withV60Compat;
            SEP1-YYYY-MM-DD = "-";
            SEP2-YYYY-MM-DD = "-";
            VHYT31E_CRIT.DATE-WORK = DATE-YYYY-MM-DD;
            VHYT31IW.WS-DATE = DATE-YYYY-MM-DD;
        end
        try
            call "VHYT31E"(XDCONTROL, VHYT31E_CRIT, VHYT31E_DATA);

        end
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            
            VHYT31IW.WS-DATE2 = VHYT31IW.WS-DATE;
            VHYT31IW.WS-DATE = VHYT31E_DATA.DATE-WORK;
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
        VHYT31B_CRIT.YRD-TRKG-YRD = VHYT31IW.YRD-TRKG-YRD;
        VHYT31B_CRIT.WS-DATE = VHYT31IW.WS-DATE;
        VHYT31B_CRIT.WS-DATE2 = VHYT31IW.WS-DATE2;
        try
            call "VHYT31B"(XDCONTROL, VHYT31B_CRIT, VHYT31B_DATA);

        end
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT31IW-CNT.ROW-CNT = VHYT31B_DATA.ROW-CNT;
            VHYT31IW-TRIGGER.LOAD-ALL-DATA = "Y";
            VHYT31IS-MOVE-TOT();
            VHYT31IW-TOT.REMAIN-CNT = XDCONTROL.UROWCNT +
                    VHYT31B_DATA.CAR-IN-CNT;
            VHYT31IW-TOT.REMAIN-CNT3 = VHYT31B_DATA.ROW-CNT3 +
                    VHYT31B_DATA.CAR-IN-CNT3;
        else
            if(XDCONTROL.URC == 100)
                DISABLE-PRINT = "Y";
                FINAL-MSG = "Report has no data for this selection.";
            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        end
    end
    ENABLE-LIST = "Y";
    ENABLE-CLEAR = "Y";
    ENABLE-PRINT = "Y";
end 

function VHYT31IS-MOVE-TOT()
    VHYT31IW-TOT.ARRIVAL-CNT = VHYT31B_DATA.ARRIVAL-CNT;
    VHYT31IW-TOT.DEPART-CNT = VHYT31B_DATA.DEPART-CNT;
    VHYT31IW-TOT.RELEASE-CNT = VHYT31B_DATA.RELEASE-CNT;
    VHYT31IW-TOT.PRODUCT-CNT = VHYT31B_DATA.PRODUCT-CNT;
    VHYT31IW-TOT.PROD-GAIN-LOSS-CNT = VHYT31B_DATA.PROD-GAIN-LOSS-CNT;
    VHYT31IW-TOT.AVAIL-GAIN-LOSS-CNT = VHYT31B_DATA.AVAIL-GAIN-LOSS-CNT;
    VHYT31IW-TOT.A400-CNT = VHYT31B_DATA.A400-CNT;
end 

function VHYT31IS-PRINT()
    VHYT31IW-PASSVALUE.YRD-TRKG-YRD = VHYT31IW.YRD-TRKG-YRD;
end 

