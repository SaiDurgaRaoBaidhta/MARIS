function VHYT08IS-GRP-ACCES()
    if(VHYT08IW-2.SUB-LOC == "T-95")
        if("pbtMoveYard" in VH01A02_DATA.PART-NAME)
            if(VH01A02_DATA.ACCESS-ALLOW[sysVar.arrayIndex] == "Y")
                VHYTIW-BUTTOM.ENABLE-MOVEYRD = "Y";
            else
                VHYTIW-BUTTOM.DISABLE-MOVEYRD = "Y";
            end
        else
            VHYTIW-BUTTOM.DISABLE-MOVEYRD = "Y";
        end
    else
        VHYTIW-BUTTOM.DISABLE-MOVEYRD = "Y";
    end
    if("pbtMoveCar" in VH01A02_DATA.PART-NAME)
        if(VH01A02_DATA.ACCESS-ALLOW[sysVar.arrayIndex] == "Y")
            VHYTIW-BUTTOM.ENABLE-MOVECAR = "Y";
        else
            VHYTIW-BUTTOM.DISABLE-MOVECAR = "Y";
        end
    else
        VHYTIW-BUTTOM.DISABLE-MOVECAR = "Y";
    end
    if(VHYT08IW-CNT.YES-FIX == "Y")
        if("pbtFixOrder" in VH01A02_DATA.PART-NAME)
            if(VH01A02_DATA.ACCESS-ALLOW[sysVar.arrayIndex] == "Y")
                VHYTIW-BUTTOM.ENABLE-FIX = "Y";
                VHYT08IW-TRIGGER.ENABLE-FIX = "Y";
            else
                VHYTIW-BUTTOM.DISABLE-FIX = "Y";

            
            end
        else
            VHYTIW-BUTTOM.DISABLE-FIX = "Y";
        end
    else
        VHYTIW-BUTTOM.DISABLE-FIX = "Y";
    end
end 

function VHYT08IS-INIT()
    set VHYT08IW-1 empty;
    VHYT08IS-VALIDATE();

    
    
    
    
    
    
    
    

    
    VHYT08A_CRIT.YRD-TRKG-YRD = VHYT08IW-PASSVALUE.YRD_TRKG_YRD;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT08I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT08A";

    
    try
        call "VHYT08A"(XDCONTROL, VHYT08A_CRIT, VHYT08A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT11IW-PASSVALUE.CAR-COUNT = XDCONTROL.UROWCNT;
            VHYT08IW-PASSVALUE.UROWCNT = XDCONTROL.UROWCNT;
            if(XDCONTROL.UROWCNT <= 30)
                if(VHYT08IW-2.SUB-LOC != "T-95")
                    VHYT08I-LOAD-DATA();
                else
                    VHYT08I-LOAD-DATA1();
                end
                VHYT08IW-TRIGGER.DISABLE-NXT = "Y";
                VHYT08IW-TRIGGER.DISABLE-PRV = "Y";
            else
                VHYT08IW-TRIGGER.FINAL-COUNT = XDCONTROL.UROWCNT;
                VHYT08IW-TRIGGER.FC-SW = " ";
                VHYT08IW-TRIGGER.ENABLE-NXT = "Y";
                VHYT08IW-TRIGGER.DISABLE-PRV = "Y";
                VHYT08IS-PRE-LOAD();
            end
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT08IS-INIT-X()
    set VHYT08IW-2 empty;
    VHYT08IW-PASSVALUE.POSN-NO-X = 0;
    VHYT08IW-PASSVALUE.POSN-NO-Y = 0;
    VHYT08IW-PASSVALUE.CLICK-COUNT = 0;
    VHYT11IW-PASSVALUE.FROM-POST = 0;
    VHYT11IW-PASSVALUE.TO-POST = 0;
    VHYT11IW-PASSVALUE.FROM-POSITION = 0;
    VHYT11IW-PASSVALUE.TO-POSITION = 0;
    VHYT11IW-PASSVALUE.FROM-CAR = " ";
    VHYT11IW-PASSVALUE.TO-CAR = " ";
    VHYT08A_CRIT.YRD-SUB-LOC = VHYT08IW-PASSVALUE.YRD-SUB-LOC;
    VHYT08IW-2.YRD = VHYT08IW-PASSVALUE.YRD_TRKG_YRD;
    VHYT08IW-2.YRD-FILLER1 = " - ";
    VHYT08B_CRIT.YRD = VHYT08IW-PASSVALUE.YRD_TRKG_YRD;
    VHYT08IW-2.YRD-SUB-LOC = VHYT08IW-PASSVALUE.YRD-SUB-LOC;
    VHYT08B_CRIT.YRD-SUB-LOC = VHYT08IW-PASSVALUE.YRD-SUB-LOC;
    VHYT08IW-2.LOC-FILLER1 = "-";

    
    
    
    
    
    
    
    

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT08I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT08B";

    
    try
        call "VHYT08B"(XDCONTROL, VHYT08B_CRIT, VHYT08B_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT08IW-2.YRD-DESC = VHYT08B_DATA.YRD-DESC;
            VHYT08IW-2.YRD-SUB-LOC-DESC = VHYT08B_DATA.YRD-SUB-LOC-DESC;
            VHYT08IS-L-SHOP();
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT08IS-INIT-Y()











    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT08I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT08C";

    
    try
        call "VHYT08C"(XDCONTROL, VHYT08C_CRIT, VHYT08C_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT08IW-PASSVALUE.CAR-TYPE-COUNT = XDCONTROL.UROWCNT;
            VHYT08IS-CAR-TYPE();
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT08IS-L-SHOP()
    VHYT08F_CRIT.YRD-TRKG-YRD = VHYT08IW-2.YRD;
    VHYT08F_CRIT.YRD-SUB-LOC = VHYT08IW-2.SUB-LOC;
    try
        call "VHYT08F"(XDCONTROL, VHYT08F_CRIT, VHYT08F_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT08IW-CNT.SHOP-ROW-CNT = XDCONTROL.UROWCNT;
        VHYT08IW-TRIGGER.LOAD-SHOP-LOC = "Y";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    VHYT08H_CRIT.YRD-TRKG-YRD = VHYT08IW-2.YRD;
    VHYT08H_CRIT.YRD-SUB-LOC = VHYT08IW-2.SUB-LOC;
    try
        call "VHYT08H"(XDCONTROL, VHYT08H_CRIT, VHYT08H_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT08IW-CNT.FIX-ROW-CNT = XDCONTROL.UROWCNT;
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

