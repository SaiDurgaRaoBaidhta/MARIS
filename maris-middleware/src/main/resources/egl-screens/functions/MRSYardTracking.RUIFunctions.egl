function VHYT11IS-CON-NO()
    if(VHYT11IW-PASSVALUE.FROM-POSITION > 0 && VHYT11IW-PASSVALUE.TO-POSITION >
                    0)
        CON-CNT = VHYT11IW-PASSVALUE.FROM-POSITION;
        VHYT11IW-PASSVALUE.CON-NO-SAVE = VHYT08A_DATA.CON-NO[CON-CNT];
        VHYT11IW-PASSVALUE.CON-NO-NOSAME = "N";
        while(VHYT11IW-PASSVALUE.CON-CNT <= VHYT11IW-PASSVALUE.TO-POSITION)
            if(VHYT08A_DATA.CON-NO[CON-CNT] != VHYT11IW-PASSVALUE.CON-NO-SAVE)
                VHYT11IW-PASSVALUE.CON-NO-NOSAME = "Y";
                VHYT11IW-PASSVALUE.CON-NO-SAVE = VHYT08A_DATA.CON-NO[CON-CNT];
                CON-CNT = CON-CNT + 1;
            end
            VHYT11IW-PASSVALUE.CON-NO-SAVE = VHYT08A_DATA.CON-NO[CON-CNT];
            CON-CNT = CON-CNT + 1;
        end
    end
end 

