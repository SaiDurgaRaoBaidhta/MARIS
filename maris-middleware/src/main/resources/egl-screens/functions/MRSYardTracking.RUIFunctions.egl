                                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "TA-2")
                                        VHYT95IS-TA2();
                                    else
                                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                "TA-3")
                                            VHYT95IS-TA3();
                                        else
                                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                    "TR1-A")
                                                VHYT95IS-TR1-A();
                                            else
                                                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                        "TR1-B")
                                                    VHYT95IS-TR1-B();
                                                else
                                                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                            "TR1-C")
                                                        VHYT95IS-TR1-C();
                                                    else
                                                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                                "TR1-D")
                                                            VHYT95IS-TR1-D();
                                                        else
                                                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                                    "WT-1")
                                                                VHYT95IS-WT-1();
                                                            else

                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "S-1")
            VHYT95IS-SA-1();
        else
            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "S-2")
                VHYT95IS-SA-2();
            else
                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "S-3")
                    VHYT95IS-SA-3();
                else
                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "TR-1")
                        VHYT95IS-TR-1();
                    else
                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "WT-0")
                            VHYT95IS-WT-0();
                        else
                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "BP-0A")
                                VHYT95IS-BP-0A();
                            else
                                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "TA-4")
                                    VHYT95IS-TA4();
                                else
                                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "TA-5")
                                        VHYT95IS-TA5();
                                    else
                                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                "TA-6")
                                            VHYT95IS-TA6();
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        CNT = CNT + 1;
    end
end 

