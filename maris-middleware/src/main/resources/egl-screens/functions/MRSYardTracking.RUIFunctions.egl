function VHYT11IS-POS-1()
    set VHYT11IW-MESSAGE empty;
    VHYT11IW-PASSVALUE.FROM-CAR = " ";
    VHYT11IW-PASSVALUE.TO-CAR = " ";
    VHYT11IW-PASSVALUE.FROM-POSITION = 0;
    VHYT11IW-PASSVALUE.TO-POSITION = 0;
    VHYT11IW-PASSVALUE.DIFFERENCE-POSITION = 0;
    if(VHYT08IW-1.CAR-NO-1 != " ")
        if(VHYT11IW-COLOR.CAR-1-COLOR == "YELLOW")
            if(VHYT08IW-1.VEH-STAT-PREV-1 == "USABLE")
                VHYT11IW-COLOR.CAR-1-COLOR = "SKY BLUE";
                VHYT11IW-PASSVALUE.CLICK-COUNT = VHYT11IW-PASSVALUE.CLICK-COUNT -
                        1;
            else
                VHYT11IW-COLOR.CAR-1-COLOR = "GREY80";
                VHYT11IW-PASSVALUE.CLICK-COUNT = VHYT11IW-PASSVALUE.CLICK-COUNT -
                        1;
            end
        else
            VHYT11IW-COLOR.CAR-1-COLOR = "YELLOW";
            VHYT11IW-PASSVALUE.CLICK-COUNT = VHYT11IW-PASSVALUE.CLICK-COUNT +
                    1;
        end
    else
        VHYT11IW-COLOR.CAR-1-COLOR = "GREY80";
        VHYT11IW-TRIGGER.ENABLE-MOVE = "Y";
    end
end 

