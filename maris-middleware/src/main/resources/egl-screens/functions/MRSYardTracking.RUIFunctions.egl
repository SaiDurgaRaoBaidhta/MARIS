function VHYT08IS-ACC-FIX()
    VHYT08IW-CNT.COUNTER-X = 1;
    VHYT08IW-CNT.YES-FIX = " ";
    while(VHYT08IW-CNT.COUNTER-X <= VHYT08IW-CNT.FIX-ROW-CNT)
        if(VHYT08IW-2.SUB-LOC ==
                VHYT08H_DATA.YRD-SUB-LOC[VHYT08IW-CNT.COUNTER-X])
            VHYT08IW-CNT.YES-FIX = "Y";
            VHYT08IW-CNT.COUNTER-X = VHYT08IW-CNT.COUNTER-X + 1;
        else
            VHYT08IW-CNT.COUNTER-X = VHYT08IW-CNT.COUNTER-X + 1;
        end
    end
end 

