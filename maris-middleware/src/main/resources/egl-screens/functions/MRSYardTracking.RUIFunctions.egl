function VHYT40IS-COLOR()
    if(VHYT40A_DATA.HOME-YRD[COUNTER] == "HY")
        VHYT40IW-PASSVALUE.CAR-COLOR = "GREEN";
        VHYT40IW-PASSVALUE.CAR-COLOR-B = "GREY80";
    else
        if(VHYT40A_DATA.HOME-YRD[COUNTER] == "RY")
            VHYT40IW-PASSVALUE.CAR-COLOR = "BROWN";
            VHYT40IW-PASSVALUE.CAR-COLOR-B = "GREY80";
        else
            if(VHYT40A_DATA.HOME-YRD[COUNTER] == "CY")
                VHYT40IW-PASSVALUE.CAR-COLOR = "BLUE";
                VHYT40IW-PASSVALUE.CAR-COLOR-B = "GREY80";
            else
                if(VHYT40A_DATA.HOME-YRD[COUNTER] == "DY")
                    VHYT40IW-PASSVALUE.CAR-COLOR = "RED";
                    VHYT40IW-PASSVALUE.CAR-COLOR-B = "GREY80";
                else
                    VHYT40IW-PASSVALUE.CAR-COLOR = "BLACK";
                    VHYT40IW-PASSVALUE.CAR-COLOR-B = "GREY80";
                end
            end
        end
    end
end 

function VHYT40IS-INIT()
    VHYT40IS-CLEAR();
    VHYT40IW-PASSVALUE.YRD-TRKG-YRD = "DPX";
    VHYT40A_CRIT.YRD-TRKG-YRD = "DPX";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT40I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT40A";

    
    try
        call "VHYT40A"(XDCONTROL, VHYT40A_CRIT, VHYT40A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT40IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

