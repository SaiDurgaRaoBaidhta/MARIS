function VHYT12IS-VALID-CRS()
    if(VHYT12IW.CON-SIZE == 2)
        VHYT12IS-VALID-CR1();
        VHYT12IS-VALID-CR2();
    else
        if(VHYT12IW.CON-SIZE == 3)
            VHYT12IS-VALID-CR1();
            VHYT12IS-VALID-CR2();
            VHYT12IS-VALID-CR3();
        else
            if(VHYT12IW.CON-SIZE == 4)
                VHYT12IS-VALID-CR1();
                VHYT12IS-VALID-CR2();
                VHYT12IS-VALID-CR3();
                VHYT12IS-VALID-CR4();
            else
                if(VHYT12IW.CON-SIZE == 5)
                    VHYT12IS-VALID-CR1();
                    VHYT12IS-VALID-CR2();
                    VHYT12IS-VALID-CR3();
                    VHYT12IS-VALID-CR4();
                    VHYT12IS-VALID-CR5();
                else
                    if(VHYT12IW.CON-SIZE == 6)
                        VHYT12IS-VALID-CR1();
                        VHYT12IS-VALID-CR2();
                        VHYT12IS-VALID-CR3();
                        VHYT12IS-VALID-CR4();
                        VHYT12IS-VALID-CR5();
                        VHYT12IS-VALID-CR6();
                    else
                        if(VHYT12IW.CON-SIZE == 7)
                            VHYT12IS-VALID-CR1();
                            VHYT12IS-VALID-CR2();
                            VHYT12IS-VALID-CR3();
                            VHYT12IS-VALID-CR4();
                            VHYT12IS-VALID-CR5();
                            VHYT12IS-VALID-CR6();
                            VHYT12IS-VALID-CR7();
                        else
                            if(VHYT12IW.CON-SIZE == 8)
                                VHYT12IS-VALID-CR1();
                                VHYT12IS-VALID-CR2();
                                VHYT12IS-VALID-CR3();
                                VHYT12IS-VALID-CR4();
                                VHYT12IS-VALID-CR5();
                                VHYT12IS-VALID-CR6();
                                VHYT12IS-VALID-CR7();
                                VHYT12IS-VALID-CR8();
                            else
                                if(VHYT12IW.CON-SIZE == 9)
                                    VHYT12IS-VALID-CR1();
                                    VHYT12IS-VALID-CR2();
                                    VHYT12IS-VALID-CR3();
                                    VHYT12IS-VALID-CR4();
                                    VHYT12IS-VALID-CR5();
                                    VHYT12IS-VALID-CR6();
                                    VHYT12IS-VALID-CR7();
                                    VHYT12IS-VALID-CR8();
                                    VHYT12IS-VALID-CR9();
                                else
                                    VHYT12IS-VALID-CR1();
                                    VHYT12IS-VALID-CR2();
                                    VHYT12IS-VALID-CR3();
                                    VHYT12IS-VALID-CR4();
                                    VHYT12IS-VALID-CR5();
                                    VHYT12IS-VALID-CR6();
                                    VHYT12IS-VALID-CR7();
                                    VHYT12IS-VALID-CR8();
                                    VHYT12IS-VALID-CR9();
                                    VHYT12IS-VALID-CRX();
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if(ERROR-CNT > 0)
        VHYT12IS-MOVE-MSG();
        DISABLE-VERIFY = "Y";
    else
        ENABLE-VERIFY = "Y";
        if(VHYT12IW.CON-NO-1 != " ")
            ENABLE-RESET = "Y";
        else
            DISABLE-RESET = "Y";
        end
    end
end 

function VHYT12IS-VALID-CRX()
    CNT = 10;
    if(VHYT12IW.CAR-NO-10 is numeric)
        
        VHYT12IW-SAVE.CAR-NO = VHYT12IW.CAR-NO-10;
        VHYT12IW-SAVE.VEH-STAT = VHYT12A_DATA.VEH-STAT[CNT];
        VHYT12IW-SAVE.CAR-TYPE = VHYT12A_DATA.CAR-TYPE[CNT];
        VHYT12IW-SAVE.TRAIN-INCD-IND = VHYT12A_DATA.TRAIN-INCD-IND[CNT];
        VHYT12IW-SAVE.ATO-PRESENT-IND = VHYT12A_DATA.ATO-PRESENT-IND[CNT];
        CAR-NO-GO = "N";
        
        if(VHYT12IW.CON-SIZE == 10)
            VHYT12IS-VALID-END();
            if(CAR-NO-GO == "Y")
                VHYT12IW-COLOR.CAR-10-COLOR = "RED";
            else
                VHYT12IW-COLOR.CAR-10-COLOR = "BLACK";
            end
        else
            
            VHYT12IS-VALID-MID();
            if(CAR-NO-GO == "Y")
                VHYT12IW-COLOR.CAR-10-COLOR = "RED";
            else
                VHYT12IW-COLOR.CAR-10-COLOR = "BLACK";
            end
        end
        VHYT12IW.CAR-10-CURR-LOC = VHYT12IW.CAR-CURR-LOC;
    else
        ERROR-CNT = ERROR-CNT + 1;
        ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
        ER-DESC[ERROR-CNT] = "-Car 10 is not numeric.";
        VHYT12IW-TRIGGER.CAR-ERROR = "Y";
    end
end 

function VHYT12IS-VALID-END()


    VHYT12IW.CAR-CURR-LOC = "  ";
    if(VHYT12IW-SAVE.CAR-TYPE != "A2" && VHYT12IW-SAVE.CAR-TYPE != "C1" &&
            VHYT12IW-SAVE.CAR-TYPE != "C2" && VHYT12IW-SAVE.CAR-TYPE != "D1" &&
            VHYT12IW-SAVE.CAR-TYPE != "L1")
        ERROR-CNT = ERROR-CNT + 1;
        ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
        ER-DESC[ERROR-CNT] = "-Invalid type for end car.";
        VHYT12IW-TRIGGER.CAR-ERROR = "Y";
    else
        if((VHYT12IW-SAVE.CAR-TYPE == "A2" || VHYT12IW-SAVE.CAR-TYPE == "C1" ||
                VHYT12IW-SAVE.CAR-TYPE == "C2" || VHYT12IW-SAVE.CAR-TYPE ==
                        "L1" || VHYT12IW-SAVE.CAR-TYPE == "D1") &&(
                VHYT12IW-SAVE.ATO-PRESENT-IND != "Y"))
            ERROR-CNT = ERROR-CNT + 1;
            ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
            ER-DESC[ERROR-CNT] = "-Invalid type for end car.";
            VHYT12IW-TRIGGER.CAR-ERROR = "Y";
        else
            if(VHYT12IW-SAVE.TRAIN-INCD-IND == "Y")
                VHYT12IW-TRIGGER.CAR-ERROR = "Y";
                ERROR-CNT = ERROR-CNT + 1;
                ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
                ER-DESC[ERROR-CNT] = "-Not servicable.";
                if(VHYT12IW-SAVE.VEH-STAT == "NO GO")
                    CAR-NO-GO = "Y";
                    VHYT12IW.CAR-CURR-LOC = "NO GO TI";
                else
                    VHYT12IW.CAR-LOC = VHYT12IW-SAVE.VEH-STAT;
                    VHYT12IW.CAR-TI = "TI";
                end
            else
                if(VHYT12IW-SAVE.VEH-STAT == "NO GO")
                    CAR-NO-GO = "Y";
                    VHYT12IW-TRIGGER.CAR-ERROR = "Y";
                    ERROR-CNT = ERROR-CNT + 1;
                    ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
                    ER-DESC[ERROR-CNT] = "-Not servicable.";
                    VHYT12IW.CAR-CURR-LOC = VHYT12IW-SAVE.VEH-STAT;
                else
                    if(VHYT12IW-SAVE.VEH-STAT != "GO" &&
                            VHYT12IW-SAVE.VEH-STAT != "USABLE" &&
                            VHYT12IW-SAVE.VEH-STAT != "ERROR")
                        ERROR-CNT = ERROR-CNT + 1;
                        ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
                        ER-DESC[ERROR-CNT] = "-Not servicable.";
                        VHYT12IW-TRIGGER.CAR-ERROR = "Y";
                        VHYT12IW.CAR-CURR-LOC = VHYT12IW-SAVE.VEH-STAT;
                    end
                end
            end
        end
    end
end 

function VHYT12IS-VALID-MID()


    VHYT12IW.CAR-CURR-LOC = "  ";
    if(VHYT12IW-SAVE.CAR-TYPE != "B1" && VHYT12IW-SAVE.CAR-TYPE != "B2" &&
            VHYT12IW-SAVE.CAR-TYPE != "C1" && VHYT12IW-SAVE.CAR-TYPE != "C2" &&
            VHYT12IW-SAVE.CAR-TYPE != "D1" && VHYT12IW-SAVE.CAR-TYPE != "E1" &&
            VHYT12IW-SAVE.CAR-TYPE != "K1" && VHYT12IW-SAVE.CAR-TYPE != "K2" &&
            VHYT12IW-SAVE.CAR-TYPE != "L1" && VHYT12IW-SAVE.CAR-TYPE != "M1")
        ERROR-CNT = ERROR-CNT + 1;
        ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
        ER-DESC[ERROR-CNT] = "-Invalid Car Type.";
        VHYT12IW-TRIGGER.CAR-ERROR = "Y";
    else
        if(VHYT12IW-SAVE.TRAIN-INCD-IND == "Y")
            ERROR-CNT = ERROR-CNT + 1;
            VHYT12IW-TRIGGER.CAR-ERROR = "Y";
            ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
            ER-DESC[ERROR-CNT] = "-Not servicable.";
            if(VHYT12IW-SAVE.VEH-STAT == "NO GO")
                CAR-NO-GO = "Y";
                VHYT12IW.CAR-CURR-LOC = "NO GO TI";
            else
                VHYT12IW.CAR-LOC = VHYT12IW-SAVE.VEH-STAT;
                VHYT12IW.CAR-TI = "TI";
            end
        else
            if(VHYT12IW-SAVE.VEH-STAT == "NO GO")
                ERROR-CNT = ERROR-CNT + 1;
                CAR-NO-GO = "Y";
                VHYT12IW-TRIGGER.CAR-ERROR = "Y";
                ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
                ER-DESC[ERROR-CNT] = "-Not servicable.";
                VHYT12IW.CAR-CURR-LOC = VHYT12IW-SAVE.VEH-STAT;
            else
                if(VHYT12IW-SAVE.VEH-STAT != "GO" && VHYT12IW-SAVE.VEH-STAT !=
                                "USABLE" && VHYT12IW-SAVE.VEH-STAT != "ERROR")
                    VHYT12IW-TRIGGER.CAR-ERROR = "Y";
                    ERROR-CNT = ERROR-CNT + 1;
                    ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
                    ER-DESC[ERROR-CNT] = "-Not servicable.";
                    VHYT12IW.CAR-CURR-LOC = VHYT12IW-SAVE.VEH-STAT;
                end
            end
        end
    end
end 

function VHYT12IS-VALID-OR()
    PROMPT-MSG = "   ";
    if(LEAD-OR-ERROR == "Y" && END-OR-ERROR == "Y")
        PROMPT-MSG = "Both Lead and End car orientation values are invalid.  Do you wish to continue? ";
        OR-ERROR-PROMPT = "Y";
    else
        if(LEAD-OR-ERROR == "Y")
            PROMPT-MSG = "Lead car orientation value is invalid.  Do you wish to continue?";
            OR-ERROR-PROMPT = "Y";
        else
            if(END-OR-ERROR == "Y")
                PROMPT-MSG = "End car orientation value is invalid.  Do you wish to continue?";
                OR-ERROR-PROMPT = "Y";
            else
                VHYT12IS-VALID-CRS();
            end
        end
    end
end 

function VHYT12IS-VERIFY()
    CAR-MOVED = "N";
    set VHYT12A_DATA empty;

    
    
    
    
    
    try
        call "VHYT12A"(XDCONTROL, VHYT12A_CRIT, VHYT12A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();
    
    if(XXEXT_CALL_Level77Items.URC == 0)
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT12IS-COMP-CARS();
        else
            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
    if(ERROR-CNT == 0 && CAR-MOVED == "N")
        VHYT12D_CRIT.YRD-SUB-LOC = VHYT12IW-PASSVALUE.YRD-SUB-LOC;
        VHYT12D_CRIT.FROM-POS = VHYT12IW-PASSVALUE.FROM-POS;
        VHYT12D_CRIT.TO-POS = VHYT12IW-PASSVALUE.TO-POS;
        VHYT12D_CRIT.YRD-TRKG-YRD = VHYT12IW-PASSVALUE.YRD-TRKG-YRD;
        VHYT12D_DATA.CON-NO = VHYT12IW.CON-NO;
        VHYT12D_DATA.TERM-LAST-UPD = VHYT12IW-PASSVALUE.TERM-LAST-UPD;
        VHYT12D_DATA.USER-GROUP = VHYT12IW-PASSVALUE.USER-GROUP;
        VHYT12D_DATA.CON-NO-1 = VHYT12IW.CON-NO-1;
        VHYT12D_DATA.CON-NO-2 = VHYT12IW.CON-NO-2;
        VHYT12D_DATA.CON-NO-3 = VHYT12IW.CON-NO-3;
        VHYT12D_DATA.CON-NO-4 = VHYT12IW.CON-NO-4;
        VHYT12D_DATA.CON-NO-5 = VHYT12IW.CON-NO-5;
        VHYT12D_DATA.CON-NO-6 = VHYT12IW.CON-NO-6;
        VHYT12D_DATA.CON-NO-7 = VHYT12IW.CON-NO-7;
        VHYT12D_DATA.CON-NO-8 = VHYT12IW.CON-NO-8;
        VHYT12D_DATA.CON-NO-9 = VHYT12IW.CON-NO-9;
        VHYT12D_DATA.CON-NO-10 = VHYT12IW.CON-NO-10;
        CAR-CNT = 1;
        while(CAR-CNT <= 10)
            VHYT12D_DATA.CAR-NUM[CAR-CNT] = VHYT12A_DATA.CAR-NO[CAR-CNT];
            VHYT12D_DATA.CAR-TYPE[CAR-CNT] = VHYT12A_DATA.CAR-TYPE[CAR-CNT];
            VHYT12D_DATA.VAGen_ORIENTATION[CAR-CNT] = VHYT12A_DATA.VAGen_ORIENTATION[CAR-CNT];
            VHYT12D_DATA.POSN-NUM[CAR-CNT] = VHYT12A_DATA.POSN-NO[CAR-CNT];
            VHYT12D_DATA.VEH-STAT[CAR-CNT] = VHYT12A_DATA.VEH-STAT[CAR-CNT];
            CAR-CNT = CAR-CNT + 1;
        end
        VHYT12D_DATA.CAR-NUM[2] = VHYT12IW.CAR-NO-2;
        VHYT12D_DATA.CAR-NUM[3] = VHYT12IW.CAR-NO-3;
        VHYT12D_DATA.CAR-NUM[4] = VHYT12IW.CAR-NO-4;
        VHYT12D_DATA.CAR-NUM[5] = VHYT12IW.CAR-NO-5;
        VHYT12D_DATA.CAR-NUM[6] = VHYT12IW.CAR-NO-6;
        VHYT12D_DATA.CAR-NUM[7] = VHYT12IW.CAR-NO-7;
        VHYT12D_DATA.CAR-NUM[8] = VHYT12IW.CAR-NO-8;
        VHYT12D_DATA.CAR-NUM[9] = VHYT12IW.CAR-NO-9;
        VHYT12D_DATA.CAR-NUM[10] = VHYT12IW.CAR-NO-10;

        
        
        
        
        try
            call "VHYT12D"(XDCONTROL, VHYT12D_CRIT, VHYT12D_DATA);

        end

        
        MRSCommonCode.XXA0IS-CHECK_EXT();
        
        if(XXEXT_CALL_Level77Items.URC == 0)
            if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHYT12IS-MOVE-CONS();
            else
                
                
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

function VHYT13IS-CHANGE()
    if(VHYT13IW.LFT-OR == " ")
        VHYT13E_CRIT.VAGen_ORIENTATION = VHYT13IW.RGT-OR;
    else
        VHYT13E_CRIT.VAGen_ORIENTATION = VHYT13IW.LFT-OR;
    end
    VHYT13E_CRIT.CAR-NO = VHYT13IW.CAR-NO;
    try
        call "VHYT13E"(XDCONTROL, VHYT13E_CRIT, VHYT13E_DATA);

    end
    if(VHYT13E_CRIT.DB-NOT-CHG == "Y")
        if(VHYT13E_CRIT.CAR-IN-CON == "Y")
            if(VHYT13E_CRIT.END-CAR-IND == "N")
                
                VHYT13IS-UPDATE();
            else
                FINAL-MESSAGE = "Car is an end car. can not be changed.";
                DISABLE-CHANGE = "Y";
            end
        else
            VHYT13IS-UPDATE();
        end
    else
        FINAL-MESSAGE = "Car not Updated.  Data base has changed - Car orientation not same.";
    end
end 

function VHYT13IS-GET-INDEX()
    X = 1;
    while(X <= VHYT13IW-TRIGGER.ROW-CNT)
        if(VHYT13A_DATA.CAR-NO[X] == VHYT13IW-PASSVALUE.CAR-NO)
            VHYT13IW.INIT-CAR-INDEX = X;
            X = ROW-CNT + 1;
        end
        X = X + 1;
    end
    if(VHYT13IW.INIT-CAR-INDEX == 0)
        VHYT13IW.INIT-CAR-INDEX = 1;
    end
end 

function VHYT13IS-GET-ORIEN()
    VHYT13B_CRIT.CAR-NO = VHYT13A_DATA.CAR-NO[CAR-INDEX];
    VHYT13IW.CAR-AND-ORIEN = VHYT13A_DATA.CAR-AND-OR[CAR-INDEX];
    try
        call "VHYT13B"(XDCONTROL, VHYT13B_CRIT, VHYT13B_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT13B_DATA.VAGen_ORIENTATION[1] = VHYT13B_DATA.LFT-ORIENTATION-CD;
        VHYT13B_DATA.VAGen_ORIENTATION[2] = VHYT13B_DATA.RGT-ORIENTATION-CD;
        VHYT13IW-TRIGGER.ORIEN-CNT = 2;
        VHYT13IW-TRIGGER.LOAD-ORIEN = "Y";
        if(VHYT13IW.LFT-OR == " ")
            VHYT13IW.ORIEN = VHYT13IW.RGT-OR;
            VHYT13IW.ORIEN-INDEX = 2;
        else
            VHYT13IW.ORIEN = VHYT13IW.LFT-OR;
            VHYT13IW.ORIEN-INDEX = 1;
        end
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

function VHYT13IS-LOAD-DATA()
    VHYT13IW-MSG.FINAL-MESSAGE = " ";
    VHYT13IW-TRIGGER.ROW-CNT = 0;
    set VHYT13IW empty;
    set VHYT13A_DATA empty;
    VHYT13IW-TRIGGER.UPDATE-SW = "N";

    
    
    VHYT13A_CRIT.YRD-TRKG-YRD = VHYT13IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT13A_CRIT.YRD-SUB-LOC = VHYT13IW-PASSVALUE.YRD-SUB-LOC;
    try
        call "VHYT13A"(XDCONTROL, VHYT13A_CRIT, VHYT13A_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if(VHYT13A_DATA.CAR-FOUND == "Y")
            VHYT13IW-TRIGGER.ROW-CNT = XDCONTROL.UROWCNT;
            VHYT13IW-TRIGGER.LOAD-DATA-ROW = "Y";
            if(VHYT13IW-PASSVALUE.CAR-NO != "  ")
                VHYT13IS-GET-INDEX();
            else
                VHYT13IW.CAR-AND-ORIEN = VHYT13A_DATA.CAR-AND-OR[1];
                VHYT13IW.INIT-CAR-INDEX = 1;
            end
        end
    else
        if(XDCONTROL.URC == 100)
            VHYT13IW-MSG.FINAL-MESSAGE = "Yard or sub loc has no car";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT13IS-MOVE-OR()
    if(VHYT13IW.LFT-OR == " ")
        VHYT13IW.ORIEN = VHYT13IW.RGT-OR;
        VHYT13IW.ORIEN-INDEX = 2;
    else
        VHYT13IW.ORIEN = VHYT13IW.LFT-OR;
        VHYT13IW.ORIEN-INDEX = 1;
    end
end 

function VHYT13IS-RELOAD()
    VHYT13IW-TRIGGER.ROW-CNT = 0;
    set VHYT13A_DATA empty;
    VHYT13A_CRIT.YRD-TRKG-YRD = VHYT13IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT13A_CRIT.YRD-SUB-LOC = VHYT13IW-PASSVALUE.YRD-SUB-LOC;

    
    
    try
        call "VHYT13A"(XDCONTROL, VHYT13A_CRIT, VHYT13A_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if(VHYT13A_DATA.CAR-FOUND == "Y")
            VHYT13IW-TRIGGER.ROW-CNT = XDCONTROL.UROWCNT;
            VHYT13IW-TRIGGER.LOAD-DATA-ROW = "Y";
            VHYT13IW.CAR-AND-ORIEN = VHYT13A_DATA.CAR-AND-OR[CAR-INDEX];
        end
    else
        if(XDCONTROL.URC == 100)
            VHYT13IW-MSG.FINAL-MESSAGE = "Yard or sub loc has no car";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT13IS-RESET-CON()
    VHYT13IW-MSG.FINAL-MESSAGE = " ";
    set VHYT13G_DATA empty;
    set VHYT13F_DATA empty;
    VHYT13F_CRIT.YRD-SUB-LOC = VHYT13IW-PASSVALUE.YRD-SUB-LOC;
    VHYT13F_CRIT.YRD-TRKG-YRD = VHYT13IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT13F_DATA.CON-NO = "  ";
    VHYT13F_DATA.TERM-LAST-UPD = VHYT13IW-PASSVALUE.TERM-LAST-UPD;
    VHYT13F_DATA.USER-GROUP = VHYT13IW-PASSVALUE.USER-GROUP;
    VHYT13F_CRIT.CON-NO = VHYT13E_CRIT.CON-NO;
    VHYT13G_CRIT.YRD-SUB-LOC = VHYT13IW-PASSVALUE.YRD-SUB-LOC;
    VHYT13G_CRIT.YRD-TRKG-YRD = VHYT13IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT13G_CRIT.CON-NO = VHYT13E_CRIT.CON-NO;
    try
        call "VHYT13G"(XDCONTROL, VHYT13G_CRIT, VHYT13G_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        CAR-CNT-E = 1;
        while(CAR-CNT-E <= 10)
            VHYT13F_DATA.CAR-NUM[CAR-CNT-E] = VHYT13G_DATA.CAR-NO[CAR-CNT-E];
            VHYT13F_DATA.CON-NUM[CAR-CNT-E] = VHYT13G_DATA.CON-NO[CAR-CNT-E];
            VHYT13F_DATA.CAR-TYPE[CAR-CNT-E] = VHYT13G_DATA.CAR-TYPE[CAR-CNT-E];
            VHYT13F_DATA.VAGen_ORIENTATION[CAR-CNT-E] = VHYT13G_DATA.VAGen_ORIENTATION[CAR-CNT-E];
            VHYT13F_DATA.POSN-NUM[CAR-CNT-E] = VHYT13G_DATA.POSN-NO[CAR-CNT-E];
            VHYT13F_DATA.VEH-STAT[CAR-CNT-E] = VHYT13G_DATA.VEH-STAT[CAR-CNT-E];
            CAR-CNT-E = CAR-CNT-E + 1;
        end
        try
            call "VHYT13F"(XDCONTROL, VHYT13F_CRIT, VHYT13F_DATA);

        end

        
        MRSCommonCode.XXA0IS-CHECK_EXT();
        
        if(XXEXT_CALL_Level77Items.URC == 0)
            if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHYT13IS-UPDATE();
            else
                
                
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    else
        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

function VHYT13IS-UPDATE()
    VHYT13C_CRIT.YRD-TRKG-YRD = VHYT13IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT13C_CRIT.YRD-SUB-LOC = VHYT13IW-PASSVALUE.YRD-SUB-LOC;
    VHYT13C_DATA.TERM-LAST-UPD = VHYT13IW-PASSVALUE.TERM-LAST-UPD;
    VHYT13C_CRIT.CAR-NO = VHYT13IW.CAR-NO;
    VHYT13C_DATA.VAGen_ORIENTATION = VHYT13B_DATA.VAGen_ORIENTATION[ORIEN-INDEX];

    
    
    try
        call "VHYT13C"(XDCONTROL, VHYT13C_CRIT, VHYT13C_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT13IS-UPDATE-2();
        UPDATE-SW = "Y";
    else
        if(XDCONTROL.URC == 100)
            VHYT13IW-MSG.FINAL-MESSAGE = "Error - orientation not updated.";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT13IS-UPDATE-2()


    VHYT13D_DATA.TERM-LAST-UPD = VHYT13IW-PASSVALUE.TERM-LAST-UPD;
    VHYT13D_CRIT.CAR-NO = VHYT13IW.CAR-NO;
    VHYT13D_DATA.VAGen_ORIENTATION = VHYT13B_DATA.VAGen_ORIENTATION[ORIEN-INDEX];
    try
        call "VHYT13D"(XDCONTROL, VHYT13D_CRIT, VHYT13D_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT13IS-RELOAD();
    else
        if(XDCONTROL.URC == 100)
            VHYT13IW-MSG.FINAL-MESSAGE = "Error - orientation not updated.";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT13IS-VALID()
    VHYT13IW-MSG.FINAL-MESSAGE = "  ";
    if((VHYT13B_DATA.VAGen_ORIENTATION[ORIEN-INDEX] != " "))
        if((VHYT13B_DATA.VAGen_ORIENTATION[ORIEN-INDEX] == VHYT13IW.LFT-OR) ||(
                VHYT13B_DATA.VAGen_ORIENTATION[ORIEN-INDEX] ==
                        VHYT13IW.RGT-OR))
            if(UPDATE-SW == "Y" || UPDATE-SW == "X")
                if(UPDATE-SW == "X")
                    UPDATE-SW = "N";
                else
                    UPDATE-SW = "X";
                end
                VHYT13IW-MSG.FINAL-MSG-1 = "Orientation for car ";
                VHYT13IW-MSG.FINAL-MSG-2 = VHYT13IW.CAR-NO;
                VHYT13IW-MSG.FINAL-MSG-3 = " is updated. ";
                DISABLE-CHANGE = "Y";
            else
                VHYT13IW-MSG.FINAL-MESSAGE = "Select new orientation for car. ";
                DISABLE-CHANGE = "Y";
            end
        else
            VHYT13IW-MSG.FINAL-MESSAGE = " Press CHANGE button to change the orientation. ";
            ENABLE-CHANGE = "Y";
        end
    
    
    end
end 

function VHYT14IS-ADD-HIS()
    VHYT14E_CRIT.YRD-TRKG-YRD = VHYT14IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT14E_CRIT.YRD-SUB-LOC = VHYT14IW-PASSVALUE.YRD-SUB-LOC;

    
    
    move FIRST-CAR to UPDATE-INDEX withV60Compat;

    
    
    VHYT14E_CRIT.CAR-NO = VHYT14IW.SAVE-CAR-NO;

    
    VHYT14E_DATA.POSN-NO-PREV = VHYT14IW.SAVE-POSN-NO;
    try
        call "VHYT14E"(XDCONTROL, VHYT14E_CRIT, VHYT14E_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
    

    else
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

function VHYT14IS-CAR-CON()
    if(VHYT14A_DATA.PART-CON-IND[CAR1-INDEX] == "Y")
        CAR-IN-CON = "Y";
        VHYT14IW-MSG.WARN-C-1 = "Car being moved is part of Partial Pseudo ";
        VHYT14IW-MSG.WARN-C-2 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
        VHYT14IW-MSG.WARN-C-3 = " if the car is moved, Partial Pseudo ";
        VHYT14IW-MSG.WARN-C-4 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
        VHYT14IW-MSG.WARN-C-5 = " will be un-made.  Continue?";
        VHYT14IW.CON-NO-2 = "  ";
    else
        CAR-IN-CON = "Y";
        VHYT14IW-MSG.WARN-C-1 = "Car being moved is part of Complete Pseudo ";
        VHYT14IW-MSG.WARN-C-2 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
        VHYT14IW-MSG.WARN-C-3 = " If the car is moved,  Pseudo Trains ";
        VHYT14IW-MSG.WARN-C-4 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
        VHYT14IW-MSG.WARN-C-5 = " will be un-made.  Continue?";
        VHYT14IW.CON-NO-2 = "  ";
    end
end 

function VHYT14IS-CAR-LOC()
    if(VHYT14A_DATA.PART-CON-IND[CAR1-INDEX] == "Y" &&
            VHYT14A_DATA.PART-CON-IND[CAR2-INDEX] == "Y")
        CAR-LOC-IN-CON = "Y";
        VHYT14IW-MSG.WARN-B-1 = "Car being moved is part of Partial Pseudo ";
        VHYT14IW-MSG.WARN-B-2 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
        VHYT14IW-MSG.WARN-B-3 = " and new location is within Partial Pseudo ";
        VHYT14IW-MSG.WARN-B-4 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
        VHYT14IW-MSG.WARN-B-5 = " If the car is moved, Partial Pseudo ";
        VHYT14IW-MSG.WARN-B-6 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
        VHYT14IW-MSG.WARN-B-8 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
        VHYT14IW-MSG.WARN-B-9 = " will be un-made.  Continue?";
        VHYT14IW.CON-NO-2 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
    else
        if(VHYT14A_DATA.PART-CON-IND[CAR1-INDEX] == "Y" &&
                VHYT14A_DATA.PART-CON-IND[CAR2-INDEX] == "N")
            CAR-LOC-IN-CON = "Y";
            VHYT14IW-MSG.WARN-B-1 = "Car being moved is part of Partial Pseudo ";
            VHYT14IW-MSG.WARN-B-2 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
            VHYT14IW-MSG.WARN-B-3 = " and new location is within Complete Pseudo ";
            VHYT14IW-MSG.WARN-B-4 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
            VHYT14IW-MSG.WARN-B-5 = " If the car is moved,  Pseudo Trains ";
            VHYT14IW-MSG.WARN-B-6 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
            VHYT14IW-MSG.WARN-B-8 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
            VHYT14IW-MSG.WARN-B-9 = " will be un-made.  Continue?";
            VHYT14IW.CON-NO-2 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
        else
            if(VHYT14A_DATA.PART-CON-IND[CAR1-INDEX] == "N" &&
                    VHYT14A_DATA.PART-CON-IND[CAR2-INDEX] == "Y")
                CAR-LOC-IN-CON = "Y";
                VHYT14IW-MSG.WARN-B-1 = "Car being moved is part of Complete Pseudo ";
                VHYT14IW-MSG.WARN-B-2 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
                VHYT14IW-MSG.WARN-B-3 = " and new location is within the Partial Pseudo ";
                VHYT14IW-MSG.WARN-B-4 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
                VHYT14IW-MSG.WARN-B-5 = " If the car is moved,  Pseudo Trains ";
                VHYT14IW-MSG.WARN-B-6 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
                VHYT14IW-MSG.WARN-B-8 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
                VHYT14IW-MSG.WARN-B-9 = " will be un-made.  Continue?";
                VHYT14IW.CON-NO-2 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
            else
                CAR-LOC-IN-CON = "Y";
                VHYT14IW-MSG.WARN-B-1 = "Car being moved is part of Complete Pseudo ";
                VHYT14IW-MSG.WARN-B-2 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
                VHYT14IW-MSG.WARN-B-3 = " and new location is within Complete Pseudo ";
                VHYT14IW-MSG.WARN-B-4 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
                VHYT14IW-MSG.WARN-B-5 = " If the car is moved,  Pseudo Trains ";
                VHYT14IW-MSG.WARN-B-6 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
                VHYT14IW-MSG.WARN-B-8 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
                VHYT14IW-MSG.WARN-B-9 = " will be un-made.  Continue?";
                VHYT14IW.CON-NO-2 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
            end
        end
    end
end 

function VHYT14IS-CHANGE()
    VHYT14IW.SAVE-CAR-NO = VHYT14A_DATA.CAR-NO[CAR1-INDEX];
    VHYT14IW.SAVE-POSN-NO = VHYT14A_DATA.POSN-NO[CAR1-INDEX];
    VHYT14IW-MSG.FINAL-MESSAGE = " ";
    if(BEFORE-AFTER == 2)
        CARX-INDEX = CAR2-INDEX + 1;
        if(VHYT14IW.CAR1-INDEX == CAR2-INDEX)
            FINAL-MESSAGE = "Car cannot be moved after itselt";
        else
            if(CARX-INDEX == VHYT14IW.CAR1-INDEX)
                FINAL-MSG-1 = "Car ";
                FINAL-MSG-2 = VHYT14A_DATA.CAR-NO[CAR1-INDEX];
                FINAL-MSG-3 = " already present after car  ";
                FINAL-MSG-4 = VHYT14A_DATA.CAR-NO[CAR2-INDEX];
                FINAL-MSG-5 = ". Car not moved. ";
            else
                VHYT14IS-CHK-CARS();
                if(VHYT14IW-TRIGGER.CAR-MOVED == "Y")
                    VHYT14IW-MSG.FINAL-MESSAGE = "Cars not moved.  Data base has changed - cars no longer in current positions. ";
                else
                    VHYT14IS-CHK-CON-X();
                end
            end
        end
    else
        if(VHYT14IW.CAR2-INDEX > 1)
            CARX-INDEX = CAR2-INDEX - 1;
        end
        if(VHYT14IW.CAR1-INDEX == CAR2-INDEX)
            FINAL-MESSAGE = "Car cannot be moved before itselt";
        else
            if(CARX-INDEX == VHYT14IW.CAR1-INDEX)
                FINAL-MSG-1 = "Car ";
                FINAL-MSG-2 = VHYT14A_DATA.CAR-NO[CAR1-INDEX];
                FINAL-MSG-3 = " already present before car  ";
                FINAL-MSG-4 = VHYT14A_DATA.CAR-NO[CAR2-INDEX];
                FINAL-MSG-5 = ". Car not moved. ";
            else
                VHYT14IS-CHK-CARS();
                if(VHYT14IW-TRIGGER.CAR-MOVED == "Y")
                    VHYT14IW-MSG.FINAL-MESSAGE = "Cars not moved.  Data base has changed - cars no longer in current positions. ";
                else
                    VHYT14IS-CHK-C1-X();
                end
            end
        end
    end
end 

function VHYT14IS-CHK-C1-X()













    if(VHYT14A_DATA.CON-NO[CAR1-INDEX] != "  " &&
            VHYT14A_DATA.CON-NO[CAR2-INDEX] != "  ")
        if(VHYT14A_DATA.CON-NO[CAR1-INDEX] == VHYT14A_DATA.CON-NO[CAR2-INDEX])
            VHYT14IS-RE-ORDER();
        else
            if(VHYT14A_DATA.CON-NO[CAR1-INDEX] !=
                    VHYT14A_DATA.CON-NO[CAR2-INDEX])
                if(CAR2-INDEX > 1)
                    TEMP-INDEX = CAR2-INDEX - 1;
                    if(VHYT14A_DATA.CON-NO[TEMP-INDEX] ==
                            VHYT14A_DATA.CON-NO[CAR2-INDEX])
                        VHYT14IS-CAR-LOC();
                    else
                        VHYT14IS-CAR-CON();
                    end
                else
                    VHYT14IS-CAR-CON();
                end
            end
        end
    else
        if(VHYT14A_DATA.CON-NO[CAR1-INDEX] != "  ")
            VHYT14IS-CAR-CON();
        else
            if(VHYT14A_DATA.CON-NO[CAR2-INDEX] != "  ")
                if(CAR2-INDEX > 1)
                    TEMP-INDEX = CAR2-INDEX - 1;
                    if(VHYT14A_DATA.CON-NO[TEMP-INDEX] ==
                            VHYT14A_DATA.CON-NO[CAR2-INDEX])
                        VHYT14IS-LOC-CON();
                    else
                        VHYT14IS-GO-UPD();
                    end
                else
                    VHYT14IS-GO-UPD();
                end
            else
                VHYT14IS-GO-UPD();
            end
        end
    end
end 

function VHYT14IS-CHK-CARS()
    VHYT14B_CRIT.YRD-TRKG-YRD = VHYT14IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT14B_CRIT.YRD-SUB-LOC = VHYT14IW-PASSVALUE.YRD-SUB-LOC;

    
    
    CAR-MOVED = "N";
    try
        call "VHYT14B"(XDCONTROL, VHYT14B_CRIT, VHYT14B_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT14IW-TRIGGER.ROW-CNT = XDCONTROL.UROWCNT;
        CHK-INDEX = 1;
        while(CHK-INDEX <= ROW-CNT)
            if(VHYT14A_DATA.CAR-NO[CHK-INDEX] ==
                    VHYT14B_DATA.CAR-NO[CHK-INDEX])
                CHK-INDEX = CHK-INDEX + 1;
            else
                CHK-INDEX = ROW-CNT + 1;
                CAR-MOVED = "Y";
            end
        end
    else
        if(XDCONTROL.URC == 100)
            CAR-MOVED = "Y";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT14IS-CHK-CON()
    if(VHYT14A_DATA.CON-NO[CAR1-INDEX] != "  " &&
            VHYT14A_DATA.CON-NO[CAR2-INDEX] != "  ")
        if(VHYT14A_DATA.CON-NO[CAR1-INDEX] == VHYT14A_DATA.CON-NO[CAR2-INDEX])
            VHYT14IS-RE-ORDER();
        else
            if(VHYT14A_DATA.CON-NO[CAR1-INDEX] !=
                    VHYT14A_DATA.CON-NO[CAR2-INDEX])
                TEMP-INDEX = CAR2-INDEX + 1;
                if(VHYT14A_DATA.CON-NO[TEMP-INDEX] ==
                        VHYT14A_DATA.CON-NO[CAR2-INDEX])
                    VHYT14IS-CAR-LOC();
                else
                    VHYT14IS-CAR-CON();
                end
            end
        end
    else
        if(VHYT14A_DATA.CON-NO[CAR1-INDEX] != "  ")
            VHYT14IS-CAR-CON();
        else
            if(VHYT14A_DATA.CON-NO[CAR2-INDEX] != "  ")
                TEMP-INDEX = CAR2-INDEX + 1;
                if(VHYT14A_DATA.CON-NO[TEMP-INDEX] ==
                        VHYT14A_DATA.CON-NO[CAR2-INDEX])
                    VHYT14IS-LOC-CON();
                else
                    VHYT14IS-GO-UPD();
                end
            else
                VHYT14IS-GO-UPD();
            end
        end
    end
end 

function VHYT14IS-CHK-CON-X()













    if(VHYT14A_DATA.CON-NO[CAR1-INDEX] != "  " &&
            VHYT14A_DATA.CON-NO[CAR2-INDEX] != "  ")
        if(VHYT14A_DATA.CON-NO[CAR1-INDEX] == VHYT14A_DATA.CON-NO[CAR2-INDEX])
            VHYT14IS-RE-ORDER();
        else
            if(VHYT14A_DATA.CON-NO[CAR1-INDEX] !=
                    VHYT14A_DATA.CON-NO[CAR2-INDEX])
                TEMP-INDEX = CAR2-INDEX + 1;
                if(VHYT14A_DATA.CON-NO[TEMP-INDEX] ==
                        VHYT14A_DATA.CON-NO[CAR2-INDEX])
                    VHYT14IS-CAR-LOC();
                else
                    VHYT14IS-CAR-CON();
                end
            end
        end
    else
        if(VHYT14A_DATA.CON-NO[CAR1-INDEX] != "  ")
            VHYT14IS-CAR-CON();
        else
            if(VHYT14A_DATA.CON-NO[CAR2-INDEX] != "  ")
                TEMP-INDEX = CAR2-INDEX + 1;
                if(VHYT14A_DATA.CON-NO[TEMP-INDEX] ==
                        VHYT14A_DATA.CON-NO[CAR2-INDEX])
                    VHYT14IS-LOC-CON();
                else
                    VHYT14IS-GO-UPD();
                end
            else
                VHYT14IS-GO-UPD();
            end
        end
    end
end 

function VHYT14IS-CHK-CON1()
    if(VHYT14A_DATA.CON-NO[CAR1-INDEX] != "  " &&
            VHYT14A_DATA.CON-NO[CAR2-INDEX] != "  ")
        if(VHYT14A_DATA.CON-NO[CAR1-INDEX] == VHYT14A_DATA.CON-NO[CAR2-INDEX])
            VHYT14IS-RE-ORDER();
        else
            if(VHYT14A_DATA.CON-NO[CAR1-INDEX] !=
                    VHYT14A_DATA.CON-NO[CAR2-INDEX])
                if(CAR2-INDEX > 1)
                    TEMP-INDEX = CAR2-INDEX - 1;
                    if(VHYT14A_DATA.CON-NO[TEMP-INDEX] ==
                            VHYT14A_DATA.CON-NO[CAR2-INDEX])
                        VHYT14IS-CAR-LOC();
                    else
                        VHYT14IS-CAR-CON();
                    end
                else
                    VHYT14IS-CAR-CON();
                end
            end
        end
    else
        if(VHYT14A_DATA.CON-NO[CAR1-INDEX] != "  ")
            VHYT14IS-CAR-CON();
        else
            if(VHYT14A_DATA.CON-NO[CAR2-INDEX] != "  ")
                if(CAR2-INDEX > 1)
                    TEMP-INDEX = CAR2-INDEX - 1;
                    if(VHYT14A_DATA.CON-NO[TEMP-INDEX] ==
                            VHYT14A_DATA.CON-NO[CAR2-INDEX])
                        VHYT14IS-LOC-CON();
                    else
                        VHYT14IS-GO-UPD();
                    end
                else
                    VHYT14IS-GO-UPD();
                end
            else
                VHYT14IS-GO-UPD();
            end
        end
    end
end 

function VHYT14IS-GO-UPD()
    if(BEFORE-AFTER == 2)
        VHYT14IS-UPDATE();
        if(UPDATE-SW == "Y")
            FINAL-MSG-1 = "Car ";
            FINAL-MSG-2 = VHYT14A_DATA.CAR-NO[CAR1-INDEX];
            FINAL-MSG-3 = " is  inserted  after  car  ";
            FINAL-MSG-4 = VHYT14A_DATA.CAR-NO[CAR2-INDEX];
            VHYT14IS-RELOAD();
        end
    else
        VHYT14IS-UPDATE2();
        if(UPDATE-SW == "Y")
            FINAL-MSG-1 = "Car ";
            FINAL-MSG-2 = VHYT14A_DATA.CAR-NO[CAR1-INDEX];
            FINAL-MSG-3 = " is  inserted  before  car  ";
            FINAL-MSG-4 = VHYT14A_DATA.CAR-NO[CAR2-INDEX];
            VHYT14IS-RELOAD();
        end
    end
end 

function VHYT14IS-LOAD-DATA()
    VHYT14IW-MSG.FINAL-MESSAGE = " ";
    VHYT14IW-TRIGGER.ROW-CNT = 0;
    set VHYT14IW empty;
    set VHYT14A_DATA empty;

    
    
    VHYT14A_CRIT.YRD-TRKG-YRD = VHYT14IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT14A_CRIT.YRD-SUB-LOC = VHYT14IW-PASSVALUE.YRD-SUB-LOC;
    try
        call "VHYT14A"(XDCONTROL, VHYT14A_CRIT, VHYT14A_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if(VHYT14A_DATA.CAR-FOUND == "Y")
            VHYT14IW-TRIGGER.ROW-CNT = XDCONTROL.UROWCNT;
            VHYT14IW-TRIGGER.LOAD-DATA-ROW = "Y";
            if(VHYT14IW-PASSVALUE.POSN-NO != 0)
                VHYT14IW-X.INIT-CAR-INDEX = VHYT14IW-PASSVALUE.POSN-NO;
                VHYT14IW.CAR-NO = VHYT14A_DATA.CAR-NO[VHYT14IW-X.INIT-CAR-INDEX];
                VHYT14IW-PASSVALUE.POSN-NO = 0;
            else
                VHYT14IW.CAR-NO = VHYT14A_DATA.CAR-NO[1];
                VHYT14IW-X.INIT-CAR-INDEX = 1;
                VHYT14IW.CAR1-INDEX = 1;
            end
            VHYT14IW.CAR2-INDEX = 1;
        end
    else
        if(XDCONTROL.URC == 100)
            VHYT14IW-MSG.FINAL-MESSAGE = "Yard or sub loc has no car";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT14IS-LOC-CON()
    if(VHYT14A_DATA.PART-CON-IND[CAR2-INDEX] == "Y")
        LOC-IN-CON = "Y";
        VHYT14IW-MSG.WARN-C-1 = "    New location is within Partial Pseudo ";
        VHYT14IW-MSG.WARN-C-2 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
        VHYT14IW-MSG.WARN-C-3 = " if the car is moved, Partial Pseudo ";
        VHYT14IW-MSG.WARN-C-4 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
        VHYT14IW-MSG.WARN-C-5 = " will be un-made.  Continue?";
        VHYT14IW.CON-NO-2 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
    else
        LOC-IN-CON = "Y";
        VHYT14IW-MSG.WARN-C-1 = "   New location is within Complete Pseudo ";
        VHYT14IW-MSG.WARN-C-2 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
        VHYT14IW-MSG.WARN-C-3 = " If the car is moved,Complete Pseudo ";
        VHYT14IW-MSG.WARN-C-4 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
        VHYT14IW-MSG.WARN-C-5 = " will be un-made.  Continue?";
        VHYT14IW.CON-NO-2 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
    end
end 

function VHYT14IS-RE-ORDER()
    if(VHYT14A_DATA.PART-CON-IND[CAR1-INDEX] == "Y")
        CAR-RE-ORDER-IN-CON = "Y";
        VHYT14IW-MSG.WARN-A-1 = "Car being moved and new location are part of Partial Pseudo ";
        VHYT14IW-MSG.WARN-A-2 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
        VHYT14IW-MSG.WARN-A-3 = " If the car is moved,  Partial Pseudo ";
        VHYT14IW-MSG.WARN-A-4 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
        VHYT14IW-MSG.WARN-A-5 = " will be un-made.  Continue?";
        VHYT14IW.CON-NO-2 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
    else
        CAR-RE-ORDER-IN-CON = "Y";
        VHYT14IW-MSG.WARN-A-1 = "Car being moved and new location are part of Complete Pseudo ";
        VHYT14IW-MSG.WARN-A-2 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
        VHYT14IW-MSG.WARN-A-3 = " If the car is moved, Complete Pseudo ";
        VHYT14IW-MSG.WARN-A-4 = VHYT14A_DATA.CON-NO[CAR1-INDEX];
        VHYT14IW-MSG.WARN-A-5 = " will be un-made.  Continue?";
        VHYT14IW.CON-NO-2 = VHYT14A_DATA.CON-NO[CAR2-INDEX];
    end
end 

function VHYT14IS-RELOAD()
    VHYT14IW-TRIGGER.ROW-CNT = 0;
    set VHYT14IW empty;
    set VHYT14A_DATA empty;
    VHYT14A_CRIT.YRD-TRKG-YRD = VHYT14IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT14A_CRIT.YRD-SUB-LOC = VHYT14IW-PASSVALUE.YRD-SUB-LOC;

    
    
    try
        call "VHYT14A"(XDCONTROL, VHYT14A_CRIT, VHYT14A_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if(VHYT14A_DATA.CAR-FOUND == "Y")
            VHYT14IW-TRIGGER.ROW-CNT = XDCONTROL.UROWCNT;
            VHYT14IW-TRIGGER.LOAD-DATA-ROW = "Y";
            VHYT14IW.CAR-NO = VHYT14A_DATA.CAR-NO[1];
            VHYT14IW-X.INIT-CAR-INDEX = 0;
            VHYT14IW.CAR1-INDEX = 1;
            VHYT14IW.CAR2-INDEX = 1;
        end
    else
        if(XDCONTROL.URC == 100)
            VHYT14IW-MSG.FINAL-MESSAGE = "Yard or sub loc has no car";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT14IS-RESET-CON()
    VHYT14F_CRIT.CON-NO = VHYT14A_DATA.CON-NO[CAR1-INDEX];
    VHYT14F_CRIT.CON-NO-2 = VHYT14IW.CON-NO-2;
    VHYT14F_CRIT.YRD-TRKG-YRD = VHYT14IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT14F_CRIT.YRD-SUB-LOC = VHYT14IW-PASSVALUE.YRD-SUB-LOC;
    VHYT14F_DATA.TERM-LAST-UPD = VHYT14IW-PASSVALUE.TERM-LAST-UPD;
    try
        call "VHYT14F"(XDCONTROL, VHYT14F_CRIT, VHYT14F_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT14IS-GO-UPD();
    else
        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

function VHYT14IS-UPDATE()
    if(CAR1-INDEX < CAR2-INDEX)
        move CAR1-INDEX to FIRST-CAR withV60Compat;
        move CAR2-INDEX to LAST-CAR withV60Compat;
        move CAR2-INDEX to MOVE-TO-POS withV60Compat;
        POS[CAR1-INDEX] = 999;
        PREV-POS[CAR1-INDEX] = VHYT14A_DATA.POSN-NO[CAR1-INDEX];
        LOOP-INDEX = CAR1-INDEX + 1;
        while(LOOP-INDEX <= CAR2-INDEX)
            POS[LOOP-INDEX] = LOOP-INDEX - 1;
            PREV-POS[LOOP-INDEX] = VHYT14A_DATA.POSN-NO[LOOP-INDEX];
            LOOP-INDEX = LOOP-INDEX + 1;
        end
    else
        if(CAR1-INDEX > CAR2-INDEX)
            FIRST-CAR = CAR2-INDEX + 1;
            move CAR1-INDEX to LAST-CAR withV60Compat;
            MOVE-TO-POS = CAR2-INDEX + 1;
            POS[CAR1-INDEX] = 999;
            PREV-POS[CAR1-INDEX] = VHYT14A_DATA.POSN-NO[CAR1-INDEX];
            LOOP-INDEX = CAR2-INDEX + 1;
            while(LOOP-INDEX < CAR1-INDEX)
                POS[LOOP-INDEX] = LOOP-INDEX + 1;
                PREV-POS[LOOP-INDEX] = VHYT14A_DATA.POSN-NO[LOOP-INDEX];
                LOOP-INDEX = LOOP-INDEX + 1;
            end
        end
    end
    UPDATE-SW = "N";
    VHYT14D_CRIT.YRD-TRKG-YRD = VHYT14IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT14D_CRIT.YRD-SUB-LOC = VHYT14IW-PASSVALUE.YRD-SUB-LOC;
    VHYT14D_DATA.TERM-LAST-UPD = VHYT14IW-PASSVALUE.TERM-LAST-UPD;

    
    
    if(CAR1-INDEX < CAR2-INDEX)
        move FIRST-CAR to UPDATE-INDEX withV60Compat;
        while(UPDATE-INDEX <= LAST-CAR)
            VHYT14D_CRIT.CAR-NO = VHYT14A_DATA.CAR-NO[UPDATE-INDEX];
            VHYT14D_DATA.POSN-NO = VHYT14IW.POS[UPDATE-INDEX];
            try
                call "VHYT14D"(XDCONTROL, VHYT14D_CRIT, VHYT14D_DATA);

            end
            if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                UPDATE-INDEX = UPDATE-INDEX + 1;
                UPDATE-SW = "Y";
            else
                UPDATE-INDEX = LAST-CAR + 1;
                UPDATE-SW = "N";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        end
    else
        move LAST-CAR to UPDATE-INDEX withV60Compat;
        while(UPDATE-INDEX >= FIRST-CAR)
            VHYT14D_CRIT.CAR-NO = VHYT14A_DATA.CAR-NO[UPDATE-INDEX];
            VHYT14D_DATA.POSN-NO = VHYT14IW.POS[UPDATE-INDEX];
            try
                call "VHYT14D"(XDCONTROL, VHYT14D_CRIT, VHYT14D_DATA);

            end
            if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                UPDATE-INDEX = UPDATE-INDEX - 1;
                UPDATE-SW = "Y";
            else
                UPDATE-INDEX = FIRST-CAR - 1;
                UPDATE-SW = "N";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        end
    end
    if(UPDATE-SW == "Y")
        
        VHYT14C_CRIT.YRD-TRKG-YRD = VHYT14IW-PASSVALUE.YRD-TRKG-YRD;
        VHYT14C_CRIT.YRD-SUB-LOC = VHYT14IW-PASSVALUE.YRD-SUB-LOC;

        
        
        VHYT14C_DATA.POSN-NO = MOVE-TO-POS;
        VHYT14C_CRIT.POSN-NO = 999;
        try
            call "VHYT14C"(XDCONTROL, VHYT14C_CRIT, VHYT14C_DATA);

        end
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT14IS-ADD-HIS();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT14IS-UPDATE2()
    if(CAR1-INDEX < CAR2-INDEX)
        move CAR1-INDEX to FIRST-CAR withV60Compat;
        LAST-CAR = CAR2-INDEX - 1;
        MOVE-TO-POS = CAR2-INDEX - 1;
        POS[CAR1-INDEX] = 999;
        PREV-POS[CAR1-INDEX] = VHYT14A_DATA.POSN-NO[CAR1-INDEX];
        LOOP-INDEX = CAR1-INDEX + 1;
        while(LOOP-INDEX < CAR2-INDEX)
            POS[LOOP-INDEX] = LOOP-INDEX - 1;
            PREV-POS[LOOP-INDEX] = VHYT14A_DATA.POSN-NO[LOOP-INDEX];
            LOOP-INDEX = LOOP-INDEX + 1;
        end
    else
        if(CAR1-INDEX > CAR2-INDEX)
            move CAR2-INDEX to FIRST-CAR withV60Compat;
            move CAR1-INDEX to LAST-CAR withV60Compat;
            move CAR2-INDEX to MOVE-TO-POS withV60Compat;
            POS[CAR1-INDEX] = 999;
            PREV-POS[CAR1-INDEX] = VHYT14A_DATA.POSN-NO[CAR1-INDEX];
            move CAR2-INDEX to LOOP-INDEX withV60Compat;
            while(LOOP-INDEX < CAR1-INDEX)
                POS[LOOP-INDEX] = LOOP-INDEX + 1;
                PREV-POS[LOOP-INDEX] = VHYT14A_DATA.POSN-NO[LOOP-INDEX];
                LOOP-INDEX = LOOP-INDEX + 1;
            end
        end
    end
    UPDATE-SW = "N";
    VHYT14D_CRIT.YRD-TRKG-YRD = VHYT14IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT14D_CRIT.YRD-SUB-LOC = VHYT14IW-PASSVALUE.YRD-SUB-LOC;
    VHYT14D_DATA.TERM-LAST-UPD = VHYT14IW-PASSVALUE.TERM-LAST-UPD;

    
    
    if(CAR1-INDEX < CAR2-INDEX)
        move FIRST-CAR to UPDATE-INDEX withV60Compat;
        while(UPDATE-INDEX <= LAST-CAR)
            VHYT14D_CRIT.CAR-NO = VHYT14A_DATA.CAR-NO[UPDATE-INDEX];
            VHYT14D_DATA.POSN-NO = VHYT14IW.POS[UPDATE-INDEX];
            try
                call "VHYT14D"(XDCONTROL, VHYT14D_CRIT, VHYT14D_DATA);

            end
            if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                UPDATE-INDEX = UPDATE-INDEX + 1;
                UPDATE-SW = "Y";
            else
                UPDATE-INDEX = LAST-CAR + 1;
                UPDATE-SW = "N";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        end
    else
        move LAST-CAR to UPDATE-INDEX withV60Compat;
        while(UPDATE-INDEX >= FIRST-CAR)
            VHYT14D_CRIT.CAR-NO = VHYT14A_DATA.CAR-NO[UPDATE-INDEX];
            VHYT14D_DATA.POSN-NO = VHYT14IW.POS[UPDATE-INDEX];
            try
                call "VHYT14D"(XDCONTROL, VHYT14D_CRIT, VHYT14D_DATA);

            end
            if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                UPDATE-INDEX = UPDATE-INDEX - 1;
                UPDATE-SW = "Y";
            else
                UPDATE-INDEX = FIRST-CAR - 1;
                UPDATE-SW = "N";
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                return;
            end
        end
    end
    if(UPDATE-SW == "Y")
        
        VHYT14C_CRIT.YRD-TRKG-YRD = VHYT14IW-PASSVALUE.YRD-TRKG-YRD;
        VHYT14C_CRIT.YRD-SUB-LOC = VHYT14IW-PASSVALUE.YRD-SUB-LOC;

        
        
        VHYT14C_DATA.POSN-NO = MOVE-TO-POS;
        VHYT14C_CRIT.POSN-NO = 999;
        try
            call "VHYT14C"(XDCONTROL, VHYT14C_CRIT, VHYT14C_DATA);

        end
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT14IS-ADD-HIS();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 



function VHYT23IS-SUBMIT()















    set VHYT23A_CRIT empty;
    VHYT23A_CRIT.YRD-TRKG-YRD = VHYT23IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT23A_CRIT.DATE-REPT-FROM = VHYT23IW-PASSVALUE.REPORT-DATE;
    VHYT23A_CRIT.REPT-TYPE = VHDVS4IW-PASSVALUE.VTAM-NAME;
    

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT23A";

    
    try
        call "VHYT23A"(XDCONTROL, VHYT23A_CRIT, VHYT23A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)

        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

            
            VHEZE7IW-TRIGGER.SUBMIT = "Y";
        else

            

            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT24IS-SUB()
