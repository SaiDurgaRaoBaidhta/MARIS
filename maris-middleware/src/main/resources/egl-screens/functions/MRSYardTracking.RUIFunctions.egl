function VHYT12IS-MOVE-MSG()
    ERROR-LOOP-INDEX = 1;
    FINAL-INDEX = 0;
    FINAL-ERROR-MSG = " ";
    TEMP-ERROR-MSG = " ";
    if(ERROR-CNT > 0)
        while(((ERROR-LOOP-INDEX <= 10) &&(
                ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX] != " ")))
            CHAR-CNT = 1;
            TEMP-ERROR-MSG = ERROR-MESSAGE-OCCR[ERROR-LOOP-INDEX];
            while((CHAR-CNT < 32))
                if(TEMP-MSG[CHAR-CNT] != ".")
                    FINAL-INDEX = FINAL-INDEX + 1;
                    FINAL-MSG[FINAL-INDEX] = TEMP-MSG[CHAR-CNT];
                else
                    if(TEMP-MSG[CHAR-CNT] == ".")
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = ",";
                        FINAL-INDEX = FINAL-INDEX + 1;
                        FINAL-MSG[FINAL-INDEX] = " ";
                        CHAR-CNT = 32;
                    end
                end
                CHAR-CNT = CHAR-CNT + 1;
            end
            ERROR-LOOP-INDEX = ERROR-LOOP-INDEX + 1;
        end
        FINAL-INDEX = FINAL-INDEX - 1;
        FINAL-MSG[FINAL-INDEX] = " ";
        move FINAL-ERROR-MSG to FINAL-MESSAGE withV60Compat;
        if(CAR-ERROR == "Y")
            DISABLE-VERIFY = "Y";
        else
            if(CON-ERROR == "Y")
                CON-NO-SETFOCUS = "Y";
                ENABLE-VERIFY = "Y";
            end
        end
    end
end 

function VHYT12IS-ORIENT()
    VHYT12IW-MSG.FINAL-MESSAGE = "Orientation for end car is not valid, Please correct.  Cannot identify train.";
end 

function VHYT12IS-RESET-CON()
    VHYT12IW-MSG.FINAL-MSG = " ";
    CAR-IN-CON-CNT = 0;
    ERROR-CNT = 0;
    CON-ERROR = "N";
    VHYT12IW.CON-NO = "  ";
    CAR-MOVED = "N";
    set VHYT12A_DATA empty;
    try
        call "VHYT12A"(XDCONTROL, VHYT12A_CRIT, VHYT12A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();
    
    if(XXEXT_CALL_Level77Items.URC == 0)
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT12IS-COMP-CARS();
        else
            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
    if(ERROR-CNT == 0 && CAR-MOVED == "N")
        VHYT12E_CRIT.YRD-SUB-LOC = VHYT12IW-PASSVALUE.YRD-SUB-LOC;
        VHYT12E_CRIT.FROM-POS = VHYT12IW-PASSVALUE.FROM-POS;
        VHYT12E_CRIT.TO-POS = VHYT12IW-PASSVALUE.TO-POS;
        VHYT12E_CRIT.YRD-TRKG-YRD = VHYT12IW-PASSVALUE.YRD-TRKG-YRD;
        VHYT12E_DATA.CON-NO = "  ";
        VHYT12E_DATA.TERM-LAST-UPD = VHYT12IW-PASSVALUE.TERM-LAST-UPD;
        VHYT12E_DATA.USER-GROUP = VHYT12IW-PASSVALUE.USER-GROUP;
        VHYT12E_DATA.CON-NO-1 = VHYT12IW.CON-NO-1;
        VHYT12E_DATA.CON-NO-2 = VHYT12IW.CON-NO-2;
        VHYT12E_DATA.CON-NO-3 = VHYT12IW.CON-NO-3;
        VHYT12E_DATA.CON-NO-4 = VHYT12IW.CON-NO-4;
        VHYT12E_DATA.CON-NO-5 = VHYT12IW.CON-NO-5;
        VHYT12E_DATA.CON-NO-6 = VHYT12IW.CON-NO-6;
        VHYT12E_DATA.CON-NO-7 = VHYT12IW.CON-NO-7;
        VHYT12E_DATA.CON-NO-8 = VHYT12IW.CON-NO-8;
        VHYT12E_DATA.CON-NO-9 = VHYT12IW.CON-NO-9;
        VHYT12E_DATA.CON-NO-10 = VHYT12IW.CON-NO-10;
        CAR-CNT-E = 1;
        while(CAR-CNT-E <= 10)
            VHYT12E_DATA.CAR-NUM[CAR-CNT-E] = VHYT12A_DATA.CAR-NO[CAR-CNT-E];
            VHYT12E_DATA.CON-NUM[CAR-CNT-E] = VHYT12A_DATA.CON-NO[CAR-CNT-E];
            VHYT12E_DATA.CAR-TYPE[CAR-CNT-E] = VHYT12A_DATA.CAR-TYPE[CAR-CNT-E];
            VHYT12E_DATA.VAGen_ORIENTATION[CAR-CNT-E] = VHYT12A_DATA.VAGen_ORIENTATION[CAR-CNT-E];
            VHYT12E_DATA.POSN-NUM[CAR-CNT-E] = VHYT12A_DATA.POSN-NO[CAR-CNT-E];
            VHYT12E_DATA.VEH-STAT[CAR-CNT-E] = VHYT12A_DATA.VEH-STAT[CAR-CNT-E];
            CAR-CNT-E = CAR-CNT-E + 1;
        end
        VHYT12E_DATA.CAR-NUM[1] = VHYT12IW.CAR-NO-1;
        VHYT12E_DATA.CAR-NUM[2] = VHYT12IW.CAR-NO-2;
        VHYT12E_DATA.CAR-NUM[3] = VHYT12IW.CAR-NO-3;
        VHYT12E_DATA.CAR-NUM[4] = VHYT12IW.CAR-NO-4;
        VHYT12E_DATA.CAR-NUM[5] = VHYT12IW.CAR-NO-5;
        VHYT12E_DATA.CAR-NUM[6] = VHYT12IW.CAR-NO-6;
        VHYT12E_DATA.CAR-NUM[7] = VHYT12IW.CAR-NO-7;
        VHYT12E_DATA.CAR-NUM[8] = VHYT12IW.CAR-NO-8;
        VHYT12E_DATA.CAR-NUM[9] = VHYT12IW.CAR-NO-9;
        VHYT12E_DATA.CAR-NUM[10] = VHYT12IW.CAR-NO-10;
        try
            call "VHYT12E"(XDCONTROL, VHYT12E_CRIT, VHYT12E_DATA);

        end

        
        MRSCommonCode.XXA0IS-CHECK_EXT();
        
        if(XXEXT_CALL_Level77Items.URC == 0)
            if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHYT12IS-MOVE-CON2();
            else
                
                
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

function VHYT12IS-VALID-CON()
    VHYT12IW-MSG.FINAL-MSG = " ";
    CAR-IN-CON-CNT = 0;
    ERROR-CNT = 0;
    CON-ERROR = "N";
    if(CAR-ERROR == "Y")
        CAR-ERROR-PROMPT = "Y";
    else
        if(VHYT12IW.CON-NO == "  ")
            ERROR-CNT = ERROR-CNT + 1;
            ER-CAR-NO[ERROR-CNT] = VHYT12IW.CON-NO;
            ER-DESC[ERROR-CNT] = "Con No can not be blank.";
            VHYT12IW-TRIGGER.CON-ERROR = "Y";
            VHYT12IS-MOVE-MSG();
        else
            if(VHYT12IW.CON-NO is numeric)
                if(VHYT12IW.CON-NO-X > 99 && VHYT12IW.CON-NO-X < 1000)
                    
                    VHYT12B_CRIT.CON-NO = VHYT12IW.CON-NO;
                    try
                        call "VHYT12B"(XDCONTROL, VHYT12B_CRIT, VHYT12B_DATA);

                    end
                    if((XDCONTROL.URC == 0 || XDCONTROL.URC == 4))
                        if(CAR-IN-CON-CNT > 0)
                            if(VHYT12B_DATA.YRD-TRKG-YRD !=
                                    VHYT12IW-PASSVALUE.YRD-TRKG-YRD)
                                VHYT12IW-MSG.PROMPT-MSG-A = " ";
                                VHYT12IW-MSG.PROMPT-MSG-A-1 = "  Train ";
                                VHYT12IW-MSG.PROMPT-MSG-A-2 = VHYT12IW.CON-NO;
                                VHYT12IW-MSG.PROMPT-MSG-A-3 = " already exists in ";
                                VHYT12IW-MSG.PROMPT-MSG-A-4 = VHYT12B_DATA.YRD-TRKG-YRD;
                                VHYT12IW-MSG.PROMPT-MSG-A-5 = " yard.";
                                VHYT12IW-MSG.PROMPT-MSG-A-6 = "Please enter another train number.";
                                VHYT12IS-CLEAR-X1();
                            else
                                VHYT12IW-MSG.PROMPT-MSG = "  ";
                                VHYT12IW-MSG.PROMPT-MSG-1 = "  Train ";
                                VHYT12IW-MSG.PROMPT-MSG-2 = VHYT12IW.CON-NO;
                                VHYT12IW-MSG.PROMPT-MSG-3 = " has already been identified:";
                                VHYT12IW-MSG.PROMPT-MSG-4 = VHYT12B_DATA.CAR-IN-CON-CNT;
                                VHYT12IW-MSG.PROMPT-MSG-5 = " cars.  Do you want to override the train number?";
                                VHYT12IW-TRIGGER.CON-HAS-CAR-PROMPT = "Y";
                            end
                        else
                            VHYT12IS-VERIFY();
                        end
                    else
                        if((XDCONTROL.URC == 100))
                            VHYT12IS-VERIFY();
                        else
                            
                            
                            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                        end
                    end
                else
                    
                    ERROR-CNT = ERROR-CNT + 1;
                    ER-CAR-NO[ERROR-CNT] = VHYT12IW.CON-NO;
                    ER-DESC[ERROR-CNT] = "-Con No out of range.";
                    VHYT12IW-TRIGGER.CON-ERROR = "Y";
                    VHYT12IS-MOVE-MSG();
                end
            else
                ERROR-CNT = ERROR-CNT + 1;
                ER-CAR-NO[ERROR-CNT] = VHYT12IW.CON-NO;
                ER-DESC[ERROR-CNT] = "-Con No is not numeric.";
                VHYT12IW-TRIGGER.CON-ERROR = "Y";
                VHYT12IS-MOVE-MSG();
            end
        end
    end
end 

function VHYT12IS-VALID-CR1()
    CNT = 1;
    if(VHYT12IW.CAR-NO-1 is numeric)

        
        VHYT12IW-SAVE.CAR-NO = VHYT12IW.CAR-NO-1;
        VHYT12IW-SAVE.VEH-STAT = VHYT12A_DATA.VEH-STAT[CNT];
        VHYT12IW-SAVE.CAR-TYPE = VHYT12A_DATA.CAR-TYPE[CNT];
        VHYT12IW-SAVE.TRAIN-INCD-IND = VHYT12A_DATA.TRAIN-INCD-IND[CNT];
        VHYT12IW-SAVE.ATO-PRESENT-IND = VHYT12A_DATA.ATO-PRESENT-IND[CNT];
        CAR-NO-GO = "N";
        VHYT12IS-VALID-END();
        VHYT12IW.CAR-1-CURR-LOC = VHYT12IW.CAR-CURR-LOC;
        if(CAR-NO-GO == "Y")
            VHYT12IW-COLOR.CAR-1-COLOR = "RED";
        else
            VHYT12IW-COLOR.CAR-1-COLOR = "BLACK";
        end
    else
        VHYT12IW-TRIGGER.CAR-ERROR = "Y";
        ERROR-CNT = ERROR-CNT + 1;
        ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
        ER-DESC[ERROR-CNT] = "-Car 1 is not numeric.";
    end
end 

