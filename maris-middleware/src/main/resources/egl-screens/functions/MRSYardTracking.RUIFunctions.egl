function VHYT11IS-FROM-CAR()
    if(VHYT11IW-PASSVALUE.FROM-CAR == " ")
        if(VHYT11IW-COLOR.CAR-1-COLOR == "YELLOW")
            VHYT11IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-1-CENTER;
            VHYT11IW-PASSVALUE.FROM-POST = 1;
            VHYT11IW-PASSVALUE.FROM-POSITION = LABEL-1-CENTER;
            VHYT11IW-PASSVALUE.FROM-POST = 1;
            VHYT11IS-TO-CAR();
        else
            if(VHYT11IW-COLOR.CAR-2-COLOR == "YELLOW")
                VHYT11IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-2-CENTER;
                VHYT11IW-PASSVALUE.FROM-POSITION = LABEL-2-CENTER;
                VHYT11IW-PASSVALUE.FROM-POST = 2;
                VHYT11IS-TO-CAR();
            else
                if(VHYT11IW-COLOR.CAR-3-COLOR == "YELLOW")
                    VHYT11IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-3-CENTER;
                    VHYT11IW-PASSVALUE.FROM-POST = 3;
                    VHYT11IW-PASSVALUE.FROM-POSITION = LABEL-3-CENTER;
                    VHYT11IS-TO-CAR();
                else
                    if(VHYT11IW-COLOR.CAR-4-COLOR == "YELLOW")
                        VHYT11IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-4-CENTER;
                        VHYT11IW-PASSVALUE.FROM-POST = 4;
                        VHYT11IW-PASSVALUE.FROM-POSITION = LABEL-4-CENTER;
                        VHYT11IS-TO-CAR();
                    else
                        if(VHYT11IW-COLOR.CAR-5-COLOR == "YELLOW")
                            VHYT11IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-5-CENTER;
                            VHYT11IW-PASSVALUE.FROM-POST = 5;
                            VHYT11IW-PASSVALUE.FROM-POSITION = LABEL-5-CENTER;
                            VHYT11IS-TO-CAR();
                        else
                            if(VHYT11IW-COLOR.CAR-6-COLOR == "YELLOW")
                                VHYT11IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-6-CENTER;
                                VHYT11IW-PASSVALUE.FROM-POST = 6;
                                VHYT11IW-PASSVALUE.FROM-POSITION = LABEL-6-CENTER;
                                VHYT11IS-TO-CAR();
                            else
                                if(VHYT11IW-COLOR.CAR-7-COLOR == "YELLOW")
                                    VHYT11IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-7-CENTER;
                                    VHYT11IW-PASSVALUE.FROM-POST = 7;
                                    VHYT11IW-PASSVALUE.FROM-POSITION = LABEL-7-CENTER;
                                    VHYT11IS-TO-CAR();
                                else
                                    if(VHYT11IW-COLOR.CAR-8-COLOR == "YELLOW")
                                        VHYT11IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-8-CENTER;
                                        VHYT11IW-PASSVALUE.FROM-POST = 8;
                                        VHYT11IW-PASSVALUE.FROM-POSITION = LABEL-8-CENTER;
                                        VHYT11IS-TO-CAR();
                                    else
                                        if(VHYT11IW-COLOR.CAR-9-COLOR ==
                                                "YELLOW")
                                            VHYT11IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-9-CENTER;
                                            VHYT11IW-PASSVALUE.FROM-POST = 9;
                                            VHYT11IW-PASSVALUE.FROM-POSITION = LABEL-9-CENTER;
                                            VHYT11IS-TO-CAR();
                                        else
                                            if(VHYT11IW-COLOR.CAR-10-COLOR ==
                                                    "YELLOW")
                                                VHYT11IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-10-CENTER;
                                                VHYT11IW-PASSVALUE.FROM-POST = 10;
                                                VHYT11IW-PASSVALUE.FROM-POSITION = LABEL-10-CENTER;
                                                VHYT11IS-TO-CAR();
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    VHYT11IS-FROM-CAR1();
    VHYT11IS-FROM-CAR2();
    if(VHYT11IW-PASSVALUE.FROM-CAR == " ")
        VHYT11IW-MESSAGE.MESSAGE = "Please select valid car to move";
        VHYT11IW-TRIGGER.ERROR-SW = "Y";
    else
        if(VHYT11IW-PASSVALUE.TO-CAR == " ")
            VHYT11IW-PASSVALUE.TO-CAR = VHYT11IW-PASSVALUE.FROM-CAR;
            VHYT11IW-PASSVALUE.TO-POSITION = VHYT11IW-PASSVALUE.FROM-POSITION;
            VHYT11IW-PASSVALUE.TO-POST = VHYT11IW-PASSVALUE.FROM-POST;
        end
        VHYT11IS-MOVE-CAR();
        VHYT11IS-CON-NO();
    end
end 

