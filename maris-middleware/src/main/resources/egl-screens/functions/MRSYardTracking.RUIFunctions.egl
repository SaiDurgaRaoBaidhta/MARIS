    VHYT51IW-MOVE.CLICKED = 0;
    VHYT51IW-PASSVALUE.FROM-YRD-SUB-LOC = " ";
    VHYT51IW-PASSVALUE.TO-YRD-SUB-LOC = " ";
    VHYT51IW-PASSVALUE.TO-CAR-POSN = 0;
    VHYT51IW-PASSVALUE.FROM-CAR-POSN = 0;
    set VHYT51IW-C1 empty;
    set VHYT51IW-C2 empty;
    set VHYT51IW-CTM1 empty;
    set VHYT51IW-CTM2 empty;
    set VHYT51IW-C88-3 empty;
    set VHYT51IW-CSTOR2 empty;
    set VHYT51IW-CSTOR3 empty;
    set VHYT51IW-C75STOR2 empty;
    set VHYT51IW-C75STOR1 empty;
    set VHYT51IW-C1-COLOR empty;
    set VHYT51IW-C2-COLOR empty;
    set VHYT51IW-CTM1-COLOR empty;
    set VHYT51IW-CTM2-COLOR empty;
    set VHYT51IW-C88-3-COLOR empty;
    set VHYT51IW-CSTOR2-COLOR empty;
    set VHYT51IW-CSTOR3-COLOR empty;
    set VHYT51IW-C1-STAT-COR empty;
    set VHYT51IW-C2-STAT-COR empty;
    set VHYT51IW-CTM1-STAT-COR empty;
    set VHYT51IW-CTM2-STAT-COR empty;
    set VHYT51IW-C88-3-STAT-COR empty;
    set VHYT51IW-CSTOR2-STAT-COR empty;
    set VHYT51IW-CSTOR3-STAT-COR empty;
end 

