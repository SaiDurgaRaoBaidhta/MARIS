function VHYT95IS-INIT-S()
    VHMVSIW-EXIT.TITLE-NAME = " ";
    VHYT95IS-CLEAR();
    VHYT10IW-PASSVALUE.WHICH-GUI = "VHYT03I";
    VHYT10IW-PASSVALUE.WHICH-GUI-FROM = "VHYT95I";
    VHYT10IW-PASSVALUE.YRD-TRKG-YRD = "RY";
    
    
    
    
    
    
    
    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT95I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT95A";

    
    try
        call "VHYT95A"(XDCONTROL, VHYT95A-CRIT, VHYT95A-DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT95IS-LOAD();
        else
            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT95IS-LOAD()
    CNT = 1;
    while(VHYT95IW.CNT <= XDCONTROL.UROWCNT)
        VHYT95A-DATA.FCOLOR[CNT] = dy100Color(VHYT95A-DATA.HOME-YRD[CNT]);
        
        if(strLib.characterLen(VHYT95A-DATA.SOFTVER[CNT]) > 1)
            if(VHYT95A-DATA.VAGen_ORIENTATION[CNT] ==
                    VHYT95A-DATA.LFT-ORIENTATION-CD[CNT])
                VHYT95A-DATA.BUTTONTXT[CNT] = "$" +
                        VHYT95A-DATA.VAGen_ORIENTATION[CNT] +
                        VHYT95A-DATA.CAR-NO[CNT];
            else
                VHYT95A-DATA.BUTTONTXT[CNT] = "$" + VHYT95A-DATA.CAR-NO[CNT] +
                        VHYT95A-DATA.VAGen_ORIENTATION[CNT];
            end
        else
            if(VHYT95A-DATA.VAGen_ORIENTATION[CNT] ==
                    VHYT95A-DATA.LFT-ORIENTATION-CD[CNT])
                VHYT95A-DATA.BUTTONTXT[CNT] = VHYT95A-DATA.VAGen_ORIENTATION[CNT] +
                        VHYT95A-DATA.CAR-NO[CNT];
            else
                VHYT95A-DATA.BUTTONTXT[CNT] = VHYT95A-DATA.CAR-NO[CNT] +
                        VHYT95A-DATA.VAGen_ORIENTATION[CNT];
            end
        end

        if(VHYT95A-DATA.YRD-SUB-LOC[CNT][1 : 5] == "B-PIT")
            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-01")
                VHYT95IS-B-PIT-01();
            else
                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-02")
                    VHYT95IS-B-PIT-02();
                else
                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-03")
                        VHYT95IS-B-PIT-03();
                    else
                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-04")
                            VHYT95IS-B-PIT-04();
                        else
                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-05")
                                VHYT95IS-B-PIT-05();
                            else
                                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "B-PIT-06")
                                    VHYT95IS-B-PIT-06();
                                end
                            end
                        end
                    end
                end
            end
        end

        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "RR-01")
            VHYT95IS-RR01();
        else
            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "RR-02")
                VHYT95IS-RR02();
            else
                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "RR-03")
                    VHYT95IS-RR03();
                else
                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "1A")
                        VHYT95IS-1A();
                    else
                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "1B")
                            VHYT95IS-1B();
                        else
                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "1C")
                                VHYT95IS-1C();
                            else
                                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "1D")
                                    VHYT95IS-1D();
                                else
                                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "2A")
                                        VHYT95IS-2A();
                                    else
                                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                "2B")
                                            VHYT95IS-2B();
                                        else
                                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                    "2C")
                                                VHYT95IS-2C();
                                            else
                                                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                        "2D")
                                                    VHYT95IS-2D();
                                                else
                                                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                            "3A")
                                                        VHYT95IS-3A();
                                                    else
                                                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                                "3B")
                                                            VHYT95IS-3B();
                                                        else
                                                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                                    "3C")
                                                                VHYT95IS-3C();
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "3D")
            VHYT95IS-3D();
        else
            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "BP-1A")
                VHYT95IS-BP-1A();
            else
                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "BP-1B")
                    VHYT95IS-BP-1B();
                else
                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "BP-2A")
                        VHYT95IS-BP-2A();
                    else
                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "RRP-2A")
                            VHYT95IS-RRP-2A();
                        else
                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "RRP-2B")
                                VHYT95IS-RRP-2B();
                            else
                                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "RRP-2C")
                                    VHYT95IS-RRP-2C();
                                else
                                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                            "RRP-3A")
                                        VHYT95IS-RRP-3A();
                                    else
                                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                "RRP-3B")
                                            VHYT95IS-RRP-3B();
                                        else
                                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                    "RRP-3C")
                                                VHYT95IS-RRP-3C();
                                            else
                                                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                        "RRP-3D")
                                                    VHYT95IS-RRP-3D();
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "RT-91A")
            VHYT95IS-RT-91A();
        else
            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "RT-91B")
                VHYT95IS-RT-91B();
            else
                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "S8-BP")
                    VHYT95IS-S8-BP();
                else
                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "TR-1A")
                        VHYT95IS-TR-1A();
                    else
                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "BP-1C")
                            VHYT95IS-BP-1C();
                        else
                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "RT-92")
                                VHYT95IS-RT-92();
                            else
                                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "TA-1")
                                    VHYT95IS-TA1();
                                else
                                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "TA-2")
                                        VHYT95IS-TA2();
                                    else
                                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                "TA-3")
                                            VHYT95IS-TA3();
                                        else
                                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                    "TR1-A")
                                                VHYT95IS-TR1-A();
                                            else
                                                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                        "TR1-B")
                                                    VHYT95IS-TR1-B();
                                                else
                                                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                            "TR1-C")
                                                        VHYT95IS-TR1-C();
                                                    else
                                                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                                "TR1-D")
                                                            VHYT95IS-TR1-D();
                                                        else
                                                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                                    "WT-1")
                                                                VHYT95IS-WT-1();
                                                            else

                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "S-1")
            VHYT95IS-SA-1();
        else
            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "S-2")
                VHYT95IS-SA-2();
            else
                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "S-3")
                    VHYT95IS-SA-3();
                else
                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "TR-1")
                        VHYT95IS-TR-1();
                    else
                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "WT-0")
                            VHYT95IS-WT-0();
                        else
                            if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "BP-0A")
                                VHYT95IS-BP-0A();
                            else
                                if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "TA-4")
                                    VHYT95IS-TA4();
                                else
                                    if(VHYT95A-DATA.YRD-SUB-LOC[CNT] == "TA-5")
                                        VHYT95IS-TA5();
                                    else
                                        if(VHYT95A-DATA.YRD-SUB-LOC[CNT] ==
                                                "TA-6")
                                            VHYT95IS-TA6();
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        CNT = CNT + 1;
    end
end 

