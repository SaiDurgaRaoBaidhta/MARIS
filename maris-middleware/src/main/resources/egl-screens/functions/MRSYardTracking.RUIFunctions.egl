                                                VHYT60IS-S5-1();
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S5-2")
            VHYT60IS-S5-2();
        else
            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S5-3")
                VHYT60IS-S5-3();
            else
                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S5-4")
                    VHYT60IS-S5-4();
                else
                    if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S5-5")
                        VHYT60IS-S5-5();
                    else
                        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S5-6")
                            VHYT60IS-S5-6();
                        else
                            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "MT-1")
                                VHYT60IS-MT-1();
                            else
                                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "MT-2")
                                    VHYT60IS-MT-2();
                                else
                                    if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "MT-3")
                                        VHYT60IS-MT-3();
                                    else
                                        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] ==
                                                "MT-4")
                                            VHYT60IS-MT-4();
                                        else
                                            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] ==
                                                    "RRBP-2")
                                                VHYT60IS-RRBP-2();
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "RRBP-3")
            VHYT60IS-RRBP-3();
        else
            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S8-1")
                VHYT60IS-S8-1();
            else
                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S8-2")
                    VHYT60IS-S8-2();
                else
                    if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S1-N")
                        VHYT60IS-S1-N();
                    else
                        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S2-N")
                            VHYT60IS-S2-N();
                        else
                            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "RRBP-2B")
                                VHYT60IS-RRBP-2B();
                            else
                                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "RRBP-3B")
                                    VHYT60IS-RRBP-3B();
                                else
                                    if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "RM-1")
                                        VHYT60IS-RM-1();
                                    else
                                        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] ==
                                                "RM-2")
                                            VHYT60IS-RM-2();
                                        else
                                            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] ==
                                                    "RM-3")
                                                VHYT60IS-RM-3();
                                            else
                                                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] ==
                                                        "RM-4")
                                                    VHYT60IS-RM-4();
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "SN-TF")
            VHYT60IS-SN-TF();
        end
        CNT = CNT + 1;
    end
end 

function VHYT60IS-MT-1()
    if(VHYT60A-DATA.POSN-NO[CNT] == 1)
        if(VHYT60A-DATA.VAGen_ORIENTATION[CNT] ==
                VHYT60A-DATA.LFT-ORIENTATION-CD[CNT])
            VHYT60IW-MT-1.LFT-OR-1 = VHYT60A-DATA.VAGen_ORIENTATION[CNT];
        else
            VHYT60IW-MT-1.RGT-OR-1 = VHYT60A-DATA.VAGen_ORIENTATION[CNT];
