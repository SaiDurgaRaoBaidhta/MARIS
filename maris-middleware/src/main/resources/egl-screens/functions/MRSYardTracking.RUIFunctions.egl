                VHYT12IW-COLOR.CAR-6-COLOR = "RED";
            else
                VHYT12IW-COLOR.CAR-6-COLOR = "BLACK";
            end
        end
        VHYT12IW.CAR-6-CURR-LOC = VHYT12IW.CAR-CURR-LOC;
    else
        ERROR-CNT = ERROR-CNT + 1;
        ER-CAR-NO[ERROR-CNT] = VHYT12IW-SAVE.CAR-NO;
        ER-DESC[ERROR-CNT] = "-Car 6 is not numeric.";
        VHYT12IW-TRIGGER.CAR-ERROR = "Y";
    end
end 

