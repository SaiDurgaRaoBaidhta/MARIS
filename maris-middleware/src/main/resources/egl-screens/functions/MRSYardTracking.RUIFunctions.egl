    VHYT03IW.FIRST-SW = " ";

    
    set VHYT03IW-CAR-DA empty;
    set VHYT03IW-MESSAGE empty;
    set VHYT03IW-HOLD empty;
    VHYT03IW-MESSAGE.ERROR-MESSAGE = " ";
    VHYT03IW-MESSAGE.ERROR-MESSAGE-1 = " ";
    VHYT03IW-MESSAGE.ERROR-MESSAGE-2 = " ";
    VHYT03IW-MESSAGE.ERROR-MESSAGE-3 = " ";
    VHYT03IW-MESSAGE.ERROR-MESSAGE-4 = " ";
    VHYT03IW-MESSAGE.ERROR-MESSAGE-5 = " ";
    VHYT03IW-CAR-DAX.CAR-NO = " ";
    VHYT03IW-CAR-DAX.YRD-SUB-LOC-SAVE = " ";
    VHYT03IW-TRIGGER.DISABLE-SVHV = "Y";
    VHYT03IW-TRIGGER.DISABLE-UPDATE = "Y";
end 

function VHYT03IS-CLEAR-1()
    VHYT03IW.FIRST-SW = " ";
    VHYT03IW-CAR-DA.MOVE-COUNTER = 0;
    
    
    VHYT03IW-CAR-DA.VAGen_ORIENTATION = " ";
    VHYT03IW-CAR-DA.VEH-STAT = " ";
    VHYT03IW-CAR-DA.CAR-NO = " ";
    set VHYT03IW-MESSAGE empty;
    set VHYT03IW-HOLD empty;
    VHYT03IW-MESSAGE.ERROR-MESSAGE = " ";
    VHYT03IW-MESSAGE.ERROR-MESSAGE-1 = " ";
    VHYT03IW-MESSAGE.ERROR-MESSAGE-2 = " ";
    VHYT03IW-MESSAGE.ERROR-MESSAGE-3 = " ";
    VHYT03IW-MESSAGE.ERROR-MESSAGE-4 = " ";
    VHYT03IW-MESSAGE.ERROR-MESSAGE-5 = " ";
    
    VHYT03IW-CAR-DAX.YRD-SUB-LOC-SAVE = " ";
    VHYT03IW-TRIGGER.DISABLE-SVHV = "Y";
    VHYT03IW-TRIGGER.DISABLE-UPDATE = "Y";
end 

function VHYT03IS-FND-2CAR()
    if(VHYT03IW.MOVE-SW != "N")
        VHYT03IW-TRIGGER.INVALID-2ND-CAR = " ";
        if(VHYT10IW-PASSVALUE.CAR-NO-2 != " ")
            VHYT03IW-MESSAGE.MSG-3-1 = "New location is occupied by Car No. ";
            VHYT03IW-MESSAGE.CAR-NO-3 = VHYT10IW-PASSVALUE.CAR-NO-2;
            VHYT03IW-MESSAGE.ERROR-MESSAGE = VHYT03IW-MESSAGE.ERROR-MESSAGE-3;
            
            VHYT03IW-TRIGGER.DISABLE-UPDATE = "Y";
            VHYT03IW-TRIGGER.DISABLE-SVHV = "Y";
            VHYT03IW-TRIGGER.INVALID-2ND-CAR = "Y";
        else
            VHYT03IW-TRIGGER.ENABLE-UPDATE = "Y";
        end
    end
end 

function VHYT03IS-FND-MOVE()
    VHYT03IW.MOVE-SW = "N";
    if(VHYT03IW-MESSAGE.ERROR-MESSAGE ==
            "Reason cannot be blank, please select valid reason")
        VHYT03IW-MESSAGE.ERROR-MESSAGE = " ";
    end
    VHYT03IW-PASSVALUE.MOVE-COUNTER = 1;
    while(VHYT03IW-PASSVALUE.MOVE-COUNTER <= VHYT03A_CRIT.MOVE-REASON-COUNT)
        if(VHYT03D_DATA.MOVE-REASON-CD != " ")
            if(VHYT03D_DATA.MOVE-REASON-CD ==
                    VHYT03A_DATA.MOVE-REASON-CD[VHYT03IW-PASSVALUE.MOVE-COUNTER])
                VHYT03IW-CAR-DA.MOVE-COUNTER = VHYT03IW-PASSVALUE.MOVE-COUNTER;
                VHYT03IW.MOVE-SW = "Y";
            else
                VHYT03IW.MOVE-SW = "Y";
            end
        end
        VHYT03IW-PASSVALUE.MOVE-COUNTER = VHYT03IW-PASSVALUE.MOVE-COUNTER + 1;
    end
    if(VHYT03IW.MOVE-SW == "N")
        VHYT03IW-MESSAGE.ERROR-MESSAGE = "Reason cannot be blank, please select valid reason";
        VHYT03IW-PASSVALUE.MOVE-COUNTER = 0;
        VHYT03IW-TRIGGER.DISABLE-UPDATE = "Y";

    
    
    end
    if(VHYT03D_DATA.MOVE-REASON-CD == "17")
        VHYT03IW-MESSAGE.ERROR-MESSAGE = "Reason code 17 must be changed.  Please select a new reason code from the drop down";
    end
    if(VHYT03D_DATA.MOVE-REASON-CD == "GO")
        VHYT03IW-MESSAGE.ERROR-MESSAGE = "Please select a new reason code from the drop down";
    end
end 

function VHYT03IS-FND-TOLOC()
    VHYT03IW-PASSVALUE.COUNTER = 1;
    while(VHYT03IW-PASSVALUE.COUNTER <= VHYT03B_CRIT.LOC-COUNTER)
        if(VHYT03IW.NEW-YARD-LOC ==
                VHYT03B_DATA.YRD-SUB-LOC[VHYT03IW-PASSVALUE.COUNTER])
            VHYT03IW-CAR-DA.COUNTER = VHYT03IW-PASSVALUE.COUNTER;
        end
        VHYT03IW-PASSVALUE.COUNTER = VHYT03IW-PASSVALUE.COUNTER + 1;
    end
end 

function VHYT03IS-GET-CAR()










    VHYT03E_CRIT.CAR-NO = VHYT03IW-CAR-DAX.CAR-NO;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT03I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT03E";

    
    try
        call "VHYT03E"(XDCONTROL, VHYT03E_CRIT, VHYT03E_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT03IW-CAR-DA.VEH-STAT1 = VHYT03E_DATA.VEH-STAT;
            if(VHYT03E_DATA.TRAIN-INCD-IND == "Y")
                VHYT03IW-CAR-DA.VEH-STAT1-TI = "TI";
            else
                VHYT03IW-CAR-DA.VEH-STAT1-TI = " ";
            end

            
            VHYT03IW-CAR-DA.VAGen_ORIENTATION = VHYT03E_DATA.VAGen_ORIENTATION;

            
            VHYT03IS-FND-MOVE();
            VHYT03IS-FND-2CAR();
        else
            if(XDCONTROL.URC == 100)
                VHYT03IW-TRIGGER.DISABLE-UPDATE = "Y";
                VHYT03IW-MESSAGE.ERROR-MESSAGE = "Invalid Car No";
            else

                
                
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

function VHYT03IS-INIT()
    set VHYT42IW empty;
    set VHYT03IW-MESSAGE empty;
    VHYT03IW-PASSVALUE.WHICH-GUI-FROM = VHYT10IW-PASSVALUE.WHICH-GUI;
    VHYT10IW-PASSVALUE.WHICH-GUI = "VHYT03I";
    if(VHYT10IW-PASSVALUE.CAR-NO == "0000")
        VHYT10IW-PASSVALUE.CAR-NO = " ";
    end
    VHYT03IW.CAR-NO = VHYT10IW-PASSVALUE.CAR-NO;
    VHYT03IW.NEW-YARD-LOC = VHYT10IW-PASSVALUE.NEW-YRD-LOC;
    VHYT03IW-CAR-DAX.YRD-SUB-LOC-SAVE = VHYT10IW-PASSVALUE.NEW-YRD-LOC;
    VHYT03IW.YARD = VHYT10IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT03IW.YRD-SUB-LOC = VHYT10IW-PASSVALUE.YRD-SUB-LOC;
    set VHYT03D_DATA empty;
    VHYT03IW-HOLD.YRD-SUB-LOC = VHYT03IW.NEW-YARD-LOC;
    VHYT03IW-TRIGGER.DISABLE-SVHV = "Y";
    VHYT03IW-TRIGGER.DISABLE-UPDATE = "Y";
    if(VHYT03IW.CAR-NO == " ")
        VHYT03IW-MESSAGE.ERROR-MESSAGE = "No car present at 'from location', please enter car number";
        VHYT03IW-CAR-DA.SET-CAR-FOCUS = "Y";
    else
        VHYT03IW-CAR-DA.CAR-NO = VHYT03IW.CAR-NO;
        VHYT03IW-CAR-DAX.CAR-NO = VHYT03IW.CAR-NO;
        VHYT03IS-CHECK-CAR();
    end
end 

function VHYT03IS-INIT-S()










    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT03I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT03A";

    
    try
        call "VHYT03A"(XDCONTROL, VHYT03A_CRIT, VHYT03A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT03A_CRIT.MOVE-REASON-COUNT = XDCONTROL.UROWCNT;
            VHYT03IS-FND-MOVE();
            VHYT03IS-INIT-X();
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT03IS-INIT-X()










    VHYT03B_CRIT.YRD-TRKG-YRD = VHYT03IW.YARD;
    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT03I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT03B";

    
    try
        call "VHYT03B"(XDCONTROL, VHYT03B_CRIT, VHYT03B_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT03B_CRIT.LOC-COUNTER = XDCONTROL.UROWCNT;
            VHYT03IW-TRIGGER.LOAD = "Y";
            VHYT03IS-FND-TOLOC();
            VHYT03IS-INIT-Y();
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT03IS-INIT-Y()










    VHYT03F_CRIT.YRD = VHYT03IW.YARD;
    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT03I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT03F";

    
    try
        call "VHYT03F"(XDCONTROL, VHYT03F_CRIT, VHYT03F_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT03IW-CAR-DA.YRD = VHYT03F_CRIT.YRD;
            VHYT03IW-CAR-DA.FILLER-X = " - ";
            VHYT03IW-CAR-DA.YRD-DESCRIPTION = VHYT03F_DATA.YRD-DESC;
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT03IS-ONLY-MOVE()
    VHYT03H_CRIT.CAR-SHIFT-SW = 0;
    if(VHYT03D_DATA.BI-DIR-INSERT-IND == "Y")
        if(VHYT03IW-CAR-SHIFT.CAR-SHIFT-SW != 0)
            VHYT03H_CRIT.CAR-SHIFT-SW = VHYT03IW-CAR-SHIFT.CAR-SHIFT-SW;
        else
            VHYT03IW-MESSAGE.ERROR-MESSAGE = "Please select north or south in the compress box";
            return;
        end
    end
    VHYT03G_CRIT.MOVE-REASON-CD = VHYT03D_DATA.MOVE-REASON-CD;
    VHYT03G_CRIT.MOVE-REASON-CD-NEW = VHYT03IW-CAR-DAX.MOVE-REASON-CD;
    VHYT03G_CRIT.YRD-SUB-LOC = VHYT03IW-CAR-DA.YRD-SUB-LOC-X;
    VHYT03G_CRIT.CAR-NO = VHYT03IW-CAR-DAX.CAR-NO;
    VHYT03G_CRIT.POSN-NO = VHYT03D_DATA.POSN-NO;
    VHYT03G_CRIT.POSN-NO-S25 = VHYT03IW-PASSVALUE.POSN-NO-TO;
    VHYT03G_CRIT.POSN-NO-TT = VHYT03IW-PASSVALUE.POSN-NO-TO;
    VHYT03G_CRIT.POSN-NO-TT1 = VHYT03IW-PASSVALUE.POSN-NO-TO;
    VHYT03G_CRIT.YRD-TRKG-YRD = VHYT03IW.YARD;
    VHYT03G_CRIT.USER-GROUP = VH01A01_DATA.USER-GROUP;
    VHYT03G_CRIT.TERM-ID = VH01A01_DATA.TERM-ID;
    VHYT03G_CRIT.ERROR-MOVE = " ";
    VHYT03G_CRIT.ERROR-SUB-LOC = " ";
    VHYT03G_CRIT.ERROR-POSITION = " ";

    
    
    
    
    
    
    
    

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT03I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT03G";

    
    try
        call "VHYT03G"(XDCONTROL, VHYT03G_CRIT, VHYT03G_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT03IS-CK-MSG();
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT03IS-PRE-UPD()
    if(VHYT03IW.RUN-VHYT03J != " ")
        VHYT10IW-PASSVALUE.CAR-NO-2 = VHYT03J_DATA.CAR-NO;
    end
end 

function VHYT03IS-VAL-NEWL()










    if(VHYT03IW-CAR-DAX.NEW-YARD-LOC-X != " ")
        VHYT03IW.RUN-VHYT03J = " ";
        if(VHYT03IW.FIRST-SW == " ")
            VHYT03IW.FIRST-SW = "Y";
        else
            if(VHYT03IW-CAR-DAX.YRD-SUB-LOC !=
                    VHYT03IW-CAR-DAX.YRD-SUB-LOC-SAVE)
                VHYT03IW-CAR-DAX.YRD-SUB-LOC-SAVE = VHYT03IW-CAR-DAX.YRD-SUB-LOC;
                VHYT03J_CRIT.YRD-SUB-LOC = VHYT03IW-CAR-DAX.NEW-YARD-LOC-X;
                VHYT03J_CRIT.YRD-TRKG-YRD = VHYT10IW-PASSVALUE.YRD-TRKG-YRD;
                XXEXT_CALL_Level77Items.UEXTNAM = "VHYT03I";
                XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT03J";

                
                try
                    call "VHYT03J"(XDCONTROL, VHYT03J_CRIT, VHYT03J_DATA);

                end
                MRSCommonCode.XXA0IS-CHECK_EXT();
                if(XXEXT_CALL_Level77Items.URC == 0)

                    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                        VHYT03IW-MESSAGE.MSG-3-1 = "New location is occupied by Car No. ";
                        VHYT03IW-MESSAGE.CAR-NO-3 = VHYT03J_DATA.CAR-NO;
                        VHYT03IW-MESSAGE.ERROR-MESSAGE = VHYT03IW-MESSAGE.ERROR-MESSAGE-3;
                        VHYT03IW-TRIGGER.DISABLE-UPDATE = "Y";

                        VHYT03IW-TRIGGER.INVALID-2ND-CAR = "Y";
                        VHYT03IW.RUN-VHYT03J = "Y";
                    else
                        if(XDCONTROL.URC == 100)
                            VHYT03IW-TRIGGER.ENABLE-UPDATE = "Y";
                            VHYT03IW-MESSAGE.ERROR-MESSAGE = " ";
                            VHYT03IW.RUN-VHYT03J = "Y";
                        else
                            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                        end 
                    end
                end
            end
        end
    end
end 

function VHYT03IS-VHYT42()
    if(VHYT42IW.CONTINUE-UPDATE == "Y")
        VHYT03IW-TRIGGER.VAGen_UPDATE = "Y";
    end
end 

function VHYT04IP-1-S-1()
    if(VHYT04IW-1-S-1.CAR-1 == " ")

    else
        VHYT04IW-PASSVALUE.CAR-NO = VHYT04IW-1-S-1.CAR-1;
        VHYT04IW-TRIGGER.OPEN-SV06 = "Y";
    end
end 

function VHYT04IP-1-S-2()
    if(VHYT04IW-1-S-2.CAR-1 == " ")

    else
        VHYT04IW-PASSVALUE.CAR-NO = VHYT04IW-1-S-2.CAR-1;
