function VHYT11IS-PRE-LOAD()
    if(VHYT08IW-TRIGGER.FINAL-COUNT > 30)
        VHYT11IS-LOAD-T-95();
    else
        VHYT11IS-LOAD-T95X();
    end
end 

function VHYT11IS-PRV()

    set VHYT08IW-1 empty;
    VHYT08IW-TRIGGER.PAGENO = VHYT08IW-TRIGGER.PAGENO - 1;
    VHYT08IS-LABEL();
    VHYT08IW-TRIGGER.LABELNO = VHYT08IW-TRIGGER.PAGENO - 1;
    VHYT08IW-TRIGGER.LABELNO = VHYT08IW-TRIGGER.LABELNO * 30;
    VHYT08IW-TRIGGER.START-COUNTER = VHYT08IW-TRIGGER.LABELNO + 1;
    VHYT08IW-TRIGGER.FINAL-COUNT = VHYT08IW-TRIGGER.FINAL-COUNT + 30;
    
    if(VHYT08IW-TRIGGER.FINAL-COUNT >= 30)
        VHYT08IW-TRIGGER.ENABLE-NXT = "Y";
    else
        VHYT08IW-TRIGGER.DISABLE-NXT = "Y";
    end
    if(VHYT08IW-TRIGGER.PAGENO > 1)
        VHYT08IW-TRIGGER.ENABLE-PRV = "Y";
    else
        VHYT08IW-TRIGGER.DISABLE-PRV = "Y";
    end
    VHYT11IS-PRE-LOAD();
end 

function VHYT11IS-PSEUDO-L()





    VHYT11IW-PSEUDO-L.PSEUDO-LABEL-1 = "Pseudo";
    VHYT11IW-PSEUDO-L.PSEUDO-LABEL-2 = "Train";
end 

function VHYT11IS-PSEUDO-MT()
    VHYT11IS-FROM-CAR();
    VHYT11IW-PASSVALUE.DIFFERENCE-POSITION = VHYT11IW-PASSVALUE.TO-POSITION -
            VHYT11IW-PASSVALUE.FROM-POSITION;
    if(VHYT11IW-PASSVALUE.FROM-POSITION == VHYT11IW-PASSVALUE.TO-POSITION)
        VHYT11IW-MESSAGE.MESSAGE = "Must select 2 to 10 cars for Pseudo Make Train";
    else
        if(VHYT11IW-PASSVALUE.DIFFERENCE-POSITION < 1 ||
                VHYT11IW-PASSVALUE.DIFFERENCE-POSITION > 10)
            VHYT11IW-MESSAGE.MESSAGE = "Must select 2 to 10 cars for Pseudo Make Train";
        else
            VHYT11IW-TRIGGER.RUN-PSEUDO = "Y";
        end
    end
end 

function VHYT11IS-REV-CARS()









    set VHYT11F_CRIT empty;
    set VHYT11F_DATA empty;
    VHYT11F_CRIT.POSN-FROM = VHYT11IW-PASSVALUE.FROM-POSITION;
    VHYT11F_CRIT.POSN-TO = VHYT11IW-PASSVALUE.TO-POSITION;
    VHYT11F_CRIT.YRD-TRKG-YRD = VHYT08IW-2.YRD;
    VHYT11F_CRIT.YRD-SUB-LOC = VHYT08IW-2.SUB-LOC;
    VHYT11F_CRIT.TERM-ID = VH01A01_DATA.TERM-ID;
    VHYT11F_CRIT.USER-GROUP = VH01A01_DATA.USER-GROUP;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT11I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT11F";

    
    try
        call "VHYT11F"(XDCONTROL, VHYT11F_CRIT, VHYT11F_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

            
            VHYT11IW-TRIGGER.RUN-REVERSE = "Y";
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT11IS-REV-MSG()
    VHYT11IW-MESSAGE.MESSAGE-3-1 = "POS NO ";
    VHYT11IW-MESSAGE.MESSAGE-3-2 = VHYT11F_CRIT.POSN-FROM;
    VHYT11IW-MESSAGE.MESSAGE-3-3 = " THRU POSN NO ";
    VHYT11IW-MESSAGE.MESSAGE-3-4 = VHYT11F_CRIT.POSN-TO;
    VHYT11IW-MESSAGE.MESSAGE-3-5 = " REVERSED";
    VHYT11IW-MESSAGE.MESSAGE = VHYT11IW-MESSAGE.MESSAGE-3;
end 

function VHYT11IS-REVERS1()
    if(VHYT11IW-TRIGGER.ERROR-SW != "Y")
        VHYT11IS-REV-CARS();
    end
end 

function VHYT11IS-REVERSE()
    VHYT11IS-FROM-CAR();
    VHYT11IW-TRIGGER.ERROR-SW = "N";
    if(VHYT11IW-PASSVALUE.FROM-CAR == " ")
        VHYT11IW-MESSAGE.MESSAGE = "Please select valid car to reverse";
        VHYT11IW-TRIGGER.ERROR-SW = "Y";
    else
        if(VHYT11IW-PASSVALUE.FROM-POSITION == 0 ||
                VHYT11IW-PASSVALUE.TO-POSITION == 0)
            VHYT11IW-MESSAGE.MESSAGE = "No cars selected on the track - no cars reversed";
            VHYT11IW-TRIGGER.ERROR-SW = "Y";
        else
            if(VHYT08IW-1.CAR-NO-1 == " " && VHYT08IW-1.CAR-NO-2 == " " &&
                    VHYT08IW-1.CAR-NO-3 == " " && VHYT08IW-1.CAR-NO-4 == " " &&
                    VHYT08IW-1.CAR-NO-5 == " " && VHYT08IW-1.CAR-NO-6 == " " &&
                    VHYT08IW-1.CAR-NO-7 == " " && VHYT08IW-1.CAR-NO-8 == " " &&
                    VHYT08IW-1.CAR-NO-9 == " " && VHYT08IW-1.CAR-NO-10 ==
                            " " && VHYT08IW-1.CAR-NO-11 == " " &&
                    VHYT08IW-1.CAR-NO-12 == " " && VHYT08IW-1.CAR-NO-13 ==
                            " " && VHYT08IW-1.CAR-NO-14 == " " &&
                    VHYT08IW-1.CAR-NO-15 == " " && VHYT08IW-1.CAR-NO-16 ==
                            " " && VHYT08IW-1.CAR-NO-17 == " " &&
                    VHYT08IW-1.CAR-NO-18 == " " && VHYT08IW-1.CAR-NO-19 ==
                            " " && VHYT08IW-1.CAR-NO-20 == " " &&
                    VHYT08IW-1.CAR-NO-21 == " " && VHYT08IW-1.CAR-NO-22 ==
                            " " && VHYT08IW-1.CAR-NO-23 == " " &&
                    VHYT08IW-1.CAR-NO-24 == " " && VHYT08IW-1.CAR-NO-25 ==
                            " " && VHYT08IW-1.CAR-NO-26 == " " &&
                    VHYT08IW-1.CAR-NO-27 == " " && VHYT08IW-1.CAR-NO-28 ==
                            " " && VHYT08IW-1.CAR-NO-29 == " " &&
                    VHYT08IW-1.CAR-NO-30 == " ")
                VHYT11IW-MESSAGE.MESSAGE = "No cars present on current track = no cars reversed";
                VHYT11IW-TRIGGER.ERROR-SW = "Y";
            else
                if(VHYT11IW-PASSVALUE.CLICK-COUNT > 2 ||
                        VHYT11IW-PASSVALUE.CLICK-COUNT < 2)
                    VHYT11IW-MESSAGE.MESSAGE = "Cars selected invalid, please select  a range of cars.";
                    VHYT11IW-TRIGGER.ERROR-SW = "Y";
                end
            end
        end
    end
    if(VHYT11IW-TRIGGER.ERROR-SW != "Y")
        VHYT11IW-TRIGGER.NO-ERROR-SW = "Y";
    end
end 

function VHYT11IS-TO-CAR()
    if(VHYT11IW-PASSVALUE.TO-CAR == " ")
        if(VHYT11IW-PASSVALUE.FROM-POST == 1)
            if(VHYT11IW-COLOR.CAR-2-COLOR == "YELLOW")
                VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-2-CENTER;
                VHYT11IW-PASSVALUE.TO-POST = 2;
                VHYT11IW-PASSVALUE.TO-POSITION = LABEL-2-CENTER;
            else
                if(VHYT11IW-COLOR.CAR-3-COLOR == "YELLOW")
                    VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-3-CENTER;
                    VHYT11IW-PASSVALUE.TO-POST = 3;
                    VHYT11IW-PASSVALUE.TO-POSITION = LABEL-3-CENTER;
                else
                    if(VHYT11IW-COLOR.CAR-4-COLOR == "YELLOW")
                        VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-4-CENTER;
                        VHYT11IW-PASSVALUE.TO-POST = 4;
                        VHYT11IW-PASSVALUE.TO-POSITION = LABEL-4-CENTER;
                    else
                        if(VHYT11IW-COLOR.CAR-5-COLOR == "YELLOW")
                            VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-5-CENTER;
                            VHYT11IW-PASSVALUE.TO-POST = 5;
                            VHYT11IW-PASSVALUE.TO-POSITION = LABEL-5-CENTER;
                        else
                            if(VHYT11IW-COLOR.CAR-6-COLOR == "YELLOW")
                                VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-6-CENTER;
                                VHYT11IW-PASSVALUE.TO-POST = 6;
                                VHYT11IW-PASSVALUE.TO-POSITION = LABEL-6-CENTER;
                            else
                                if(VHYT11IW-COLOR.CAR-7-COLOR == "YELLOW")
                                    VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-7-CENTER;
                                    VHYT11IW-PASSVALUE.TO-POST = 7;
                                    VHYT11IW-PASSVALUE.TO-POSITION = LABEL-7-CENTER;
                                else
                                    if(VHYT11IW-COLOR.CAR-8-COLOR == "YELLOW")
                                        VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-8-CENTER;
                                        VHYT11IW-PASSVALUE.TO-POST = 8;
                                        VHYT11IW-PASSVALUE.TO-POSITION = LABEL-8-CENTER;
                                    else
                                        if(VHYT11IW-COLOR.CAR-9-COLOR ==
                                                "YELLOW")
                                            VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-9-CENTER;
                                            VHYT11IW-PASSVALUE.TO-POST = 9;
                                            VHYT11IW-PASSVALUE.TO-POSITION = LABEL-9-CENTER;
                                        else
                                            if(VHYT11IW-COLOR.CAR-10-COLOR ==
                                                    "YELLOW")
                                                VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-10-CENTER;
                                                VHYT11IW-PASSVALUE.TO-POST = 10;
                                                VHYT11IW-PASSVALUE.TO-POSITION = LABEL-10-CENTER;
                                            else
                                                VHYT11IS-TO-CAR1();
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        else
            if(VHYT11IW-PASSVALUE.FROM-POST == 2)
                if(VHYT11IW-COLOR.CAR-3-COLOR == "YELLOW")
                    VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-3-CENTER;
                    VHYT11IW-PASSVALUE.TO-POST = 3;
                    VHYT11IW-PASSVALUE.TO-POSITION = LABEL-3-CENTER;
                else
                    if(VHYT11IW-COLOR.CAR-4-COLOR == "YELLOW")
                        VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-4-CENTER;
                        VHYT11IW-PASSVALUE.TO-POST = 4;
                        VHYT11IW-PASSVALUE.TO-POSITION = LABEL-4-CENTER;
                    else
                        if(VHYT11IW-COLOR.CAR-5-COLOR == "YELLOW")
                            VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-5-CENTER;
                            VHYT11IW-PASSVALUE.TO-POST = 5;
                            VHYT11IW-PASSVALUE.TO-POSITION = LABEL-5-CENTER;
                        else
                            if(VHYT11IW-COLOR.CAR-6-COLOR == "YELLOW")
                                VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-6-CENTER;
                                VHYT11IW-PASSVALUE.TO-POST = 6;
                                VHYT11IW-PASSVALUE.TO-POSITION = LABEL-6-CENTER;
                            else
                                if(VHYT11IW-COLOR.CAR-7-COLOR == "YELLOW")
                                    VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-7-CENTER;
                                    VHYT11IW-PASSVALUE.TO-POST = 7;
                                    VHYT11IW-PASSVALUE.TO-POSITION = LABEL-7-CENTER;
                                else
                                    if(VHYT11IW-COLOR.CAR-8-COLOR == "YELLOW")
                                        VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-8-CENTER;
                                        VHYT11IW-PASSVALUE.TO-POST = 8;
                                        VHYT11IW-PASSVALUE.TO-POSITION = LABEL-8-CENTER;
                                    else
                                        if(VHYT11IW-COLOR.CAR-9-COLOR ==
                                                "YELLOW")
                                            VHYT11IW-PASSVALUE.TO-CAR = VHYT08IW-1.CAR-NO-9-CENTER;
                                            VHYT11IW-PASSVALUE.TO-POST = 9;
                                            VHYT11IW-PASSVALUE.TO-POSITION = LABEL-9-CENTER;
