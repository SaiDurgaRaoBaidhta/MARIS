function VHYT10IS-FLOA()
    VHYT10IW-FLOA.CAR-NO-1 = " ";
    if(VHYT04A-DATA.POSN-NO[CNT] == 1)
        VHYT10IW-FLOA.CAR-NO-1-CENTER = VHYT04A-DATA.CAR-NO[CNT];
        if(VHYT04A-DATA.VAGen_ORIENTATION[CNT] ==
                VHYT10IW-PASSVALUE.CAR-A-LEFT-ORIENTATION ||
                VHYT04A-DATA.VAGen_ORIENTATION[CNT] ==
                        VHYT10IW-PASSVALUE.CAR-B-LEFT-ORIENTATION ||
                VHYT04A-DATA.VAGen_ORIENTATION[CNT] ==
                        VHYT10IW-PASSVALUE.CAR-C-LEFT-ORIENTATION ||
                VHYT04A-DATA.VAGen_ORIENTATION[CNT] ==
                        VHYT10IW-PASSVALUE.CAR-D-LEFT-ORIENTATION ||
                VHYT04A-DATA.VAGen_ORIENTATION[CNT] ==
                        VHYT10IW-PASSVALUE.CAR-E-LEFT-ORIENTATION ||
