end 

function VHYT02IS-SELECT()
    VHYT02IW-PASSVALUE.COUNTER = 1;
    while(VHYT02IW-PASSVALUE.COUNTER <= VHYT02B_CRIT.YRD-COUNT)
        if(VHYT02IW-PASSVALUE.YRD-TRKG-YRD ==
                VHYT02B_DATA.YRD[VHYT02IW-PASSVALUE.COUNTER])
            VHYT02IW-PASSVALUE.YRD-IDX = VHYT02IW-PASSVALUE.COUNTER;
        end
        VHYT02IW-PASSVALUE.COUNTER = VHYT02IW-PASSVALUE.COUNTER + 1;
    end
    VHYT02IW-PASSVALUE.COUNTER = 1;
    while(VHYT02IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if(VHYT02IW-PASSVALUE.YRD-SUB-LOC ==
                VHYT02B_DATA_1.YRD-SUB-LOC[VHYT02IW-PASSVALUE.COUNTER])
            VHYT02IW-PASSVALUE.SUB-LOC-IDX = VHYT02IW-PASSVALUE.COUNTER;
        end
        VHYT02IW-PASSVALUE.COUNTER = VHYT02IW-PASSVALUE.COUNTER + 1;
    end
end 



function VHYT02IS-SUBMIT()















    VHYT02IW-MESSAGE.MESSAGE = " ";
    set VHYT02A_CRIT empty;
    if(VHYT02IW-WORK.YRD-TRKG-YRD == " ")
        VHYT02IW-MESSAGE.MESSAGE = "Please select yard tracking yrd";
    end
    if(VHYT02IW-WORK.YRD-SUB-LOC == " ")
        VHYT02IW-WORK.YRD-SUB-LOC = "ALL";
    end
    if(VHYT02IW-WORK.YRD-TRKG-YRD != " ")
        VHYT02A_CRIT.YRD-TRKG-YRD = VHYT02IW-WORK.YRD-TRKG-YRD;
        VHYT02A_CRIT.YRD-SUB-LOC = VHYT02IW-WORK.YRD-SUB-LOC;
        VHYT02A_CRIT.REPT-TYPE = VHDVS4IW-PASSVALUE.VTAM-NAME;
        

        
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYT02I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT02A";

        
        try
            call "VHYT02A"(XDCONTROL, VHYT02A_CRIT, VHYT02A_DATA);

        end

        
        MRSCommonCode.XXA0IS-CHECK_EXT();

        
        if(XXEXT_CALL_Level77Items.URC == 0)

            
            if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC ==
                            100)

                
                VHEZE7IW-TRIGGER.SUBMIT = "Y";
            else

                

                
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

function VHYT03IS-BOTH-CHG()
    VHYT03H_CRIT.CAR-SHIFT-SW = 0;
    if(VHYT03D_DATA.BI-DIR-INSERT-IND == "Y")
        if(VHYT03IW-CAR-SHIFT.CAR-SHIFT-SW != 0)
            VHYT03H_CRIT.CAR-SHIFT-SW = VHYT03IW-CAR-SHIFT.CAR-SHIFT-SW;
        else
            VHYT03IW-MESSAGE.ERROR-MESSAGE = "Please select north or south in the compress box";
            return;
        end
    end
    VHYT03H_CRIT.MOVE-REASON-CD = VHYT03D_DATA.MOVE-REASON-CD;
    VHYT03H_CRIT.MOVE-REASON-CD-NEW = VHYT03IW-CAR-DAX.MOVE-REASON-CD;
    VHYT03H_CRIT.YRD-SUB-LOC = VHYT03IW-CAR-DA.YRD-SUB-LOC;
    VHYT03H_CRIT.NEW-YRD-SUB-LOC = VHYT03IW-CAR-DAX.YRD-SUB-LOC;
    VHYT03H_CRIT.CAR-NO = VHYT03IW-CAR-DAX.CAR-NO;
    VHYT03H_CRIT.POSN-NO = VHYT03D_DATA.POSN-NO;
    VHYT03H_CRIT.POSN-NO-S25 = VHYT03IW-PASSVALUE.POSN-NO-TO;
    VHYT03H_CRIT.POSN-NO-TT = VHYT03IW-PASSVALUE.POSN-NO-TO;   
    VHYT03H_CRIT.POSN-NO-TT1 = VHYT03IW-PASSVALUE.POSN-NO-TO;  
    VHYT03H_CRIT.YRD-TRKG-YRD = VHYT03IW.YARD;
    VHYT03H_CRIT.USER-GROUP = VH01A01_DATA.USER-GROUP;
    VHYT03H_CRIT.TERM-ID = VH01A01_DATA.TERM-ID;
    VHYT03H_CRIT.ERROR-MOVE = " ";
    VHYT03H_CRIT.ERROR-SUB-LOC = " ";
    VHYT03H_CRIT.ERROR-POSITION = " ";
    VHYT03H_CRIT.ERROR-POSN-NEW-LOC = " ";

    

    

    
    

    
    
    
    
    
    
    
    
    

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT03I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT03H";

    
    try
        call "VHYT03H"(XDCONTROL, VHYT03H_CRIT, VHYT03H_DATA, VHYT03H_DATA_1,
                VHYT03H_DATA_2);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT03IS-CK-MSGX();
        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT03IS-CAR-COMP()

end 

function VHYT03IS-CHECK-CAR()








    if(VHYT03IW-CAR-DAX.CAR-NO == "0000")
        VHYT03IW-CAR-DAX.CAR-NO = " ";
    end
    VHYT03IW-HOLD.MOVE-REASON-CD = VHYT03D_DATA.MOVE-REASON-CD;
    if(VHYT03IW-CAR-DAX.CAR-NO != " ")
        
        VHYT03IW-TRIGGER.ENABLE-SVHV = "Y";
        VHYT03D_CRIT.YRD-TRKG-YRD = VHYT03IW-CAR-DA.YRD;
        VHYT03D_CRIT.CAR-NO = VHYT03IW-CAR-DAX.CAR-NO;
        VHYT03D_CRIT.NEW-YRD-LOC = VHYT03IW.NEW-YARD-LOC;
        if(VHYT03D_CRIT.YRD-TRKG-YRD == " ")
            
            
            VHYT03D_CRIT.YRD-TRKG-YRD = VHYT10IW-PASSVALUE.YRD-TRKG-YRD;
            VHYT03IW-CAR-DA.YRD = VHYT10IW-PASSVALUE.YRD-TRKG-YRD;
        end
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYT03I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT03D";

        
        try
            call "VHYT03D"(XDCONTROL, VHYT03D_CRIT, VHYT03D_DATA);

        end

        
        MRSCommonCode.XXA0IS-CHECK_EXT();

        
        if(XXEXT_CALL_Level77Items.URC == 0)
            
            if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHYT03IS-CK-LABEL();
                VHYT03IS-CHECK-LOC();
                VHYT03IS-GET-CAR();
            else
                if(XDCONTROL.URC == 100)
                    VHYT03IW-MESSAGE.ERROR-MESSAGE = "Car not in Shop";
                    VHYT03IW-CAR-DA.SET-CAR-FOCUS = "Y";
                else

                    
                    
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end 
            end
        end
    else
        VHYT03IW-TRIGGER.DISABLE-SVHV = "Y";
        VHYT03IW-MESSAGE.ERROR-MESSAGE = "Please enter car number";
    end
end 

function VHYT03IS-CHECK-LOC()
    VHYT03IW-CAR-DA.YRD-SUB-LOC = VHYT03D_DATA.YRD-SUB-LOC;
    VHYT03IW-CAR-DA.FILLER = " - ";
    VHYT03IW-CAR-DA.YRD-SUB-LOC-DESC = VHYT03D_DATA.YRD-SUB-LOC-DESC;
    if(VHYT03IW-PASSVALUE.WHICH-GUI-FROM-X != "VHCI02I" &&
            VHYT03IW-PASSVALUE.WHICH-GUI-FROM-X != "VHCI03I")
        if(VHYT03D_DATA.YRD-SUB-LOC != VHYT03IW.YRD-SUB-LOC)
            VHYT03IW-MESSAGE.FIELD-1 = "Car";
            VHYT03IW-MESSAGE.CAR-NO = VHYT03IW-CAR-DAX.CAR-NO;
            VHYT03IW-MESSAGE.FIELD-2 = " has moved from ";
            VHYT03IW-MESSAGE.YRD-SUB-LOC-FROM = VHYT03IW.YRD-SUB-LOC;
            VHYT03IW-MESSAGE.FIELD-3 = "to ";
            VHYT03IW-MESSAGE.YRD-SUB-LOC-TO = VHYT03D_DATA.YRD-SUB-LOC;
            VHYT03IW-MESSAGE.ERROR-MESSAGE = VHYT03IW-MESSAGE.ERROR-MESSAGE-1;
        end
    end
end 

function VHYT03IS-CI-GO()
    VHYT03IW-PASSVALUE.CAR-NO = VHYT03IW-CAR-DAX.CAR-NO;
    VHYT03IW-PASSVALUE.WHICH-GUI-FROM = "VHYT03I";
    VHYT03IW-PASSVALUE.YRD-TRKG-YRD = VHYT03IW.YARD;
    VHYTM5IW-PASSVALUE.EXEC-GUI = "VHCI02I";
end 

function VHYT03IS-CI-NGO()
    VHYT03IW-PASSVALUE.CAR-NO = VHYT03IW-CAR-DAX.CAR-NO;
    VHYT03IW-PASSVALUE.WHICH-GUI-FROM = "VHYT03I";
    VHYT03IW-PASSVALUE.YRD-TRKG-YRD = VHYT03IW.YARD;
end 

function VHYT03IS-CK-LABEL()
    if(VHYT03D_DATA.SHIFT-CARS-CD == "SN" || VHYT03D_DATA.SHIFT-CARS-CD ==
                    "SO")
        VHYT03IW-CAR-SHIFT.CAR-SHIFT-SW = 1;
    else
        if(VHYT03D_DATA.SHIFT-CARS-CD == "NS" || VHYT03D_DATA.SHIFT-CARS-CD ==
                        "NO")
            VHYT03IW-CAR-SHIFT.CAR-SHIFT-SW = 2;
        else
            VHYT03IW-CAR-SHIFT.CAR-SHIFT-SW = 0;
        end
    end
    if(VHYT03D_DATA.BI-DIR-INSERT-IND == "Y")
        VHYT03IW-LABEL.LABEL-1-1 = "Insert car ";
        VHYT03IW-LABEL.LABEL-1-2 = VHYT03IW-CAR-DA.CAR-NO;
        VHYT03IW-LABEL.LABEL-1-3 = " ON ";
        VHYT03IW-LABEL.LABEL-2-1 = "END OF TRACK";
        VHYT03IW-LABEL.LABEL-2-2 = VHYT03IW.NEW-YARD-LOC;
        VHYT03IW-TRIGGER.LABEL-SHOW = "Y";
    else
        set VHYT03IW-LABEL empty;
        VHYT03IW-TRIGGER.LABEL-HIDE = "Y";
    end
    if(VHYT03D_DATA.MOVE-REASON-CD == "17")
        VHYT03IW-MESSAGE.ERROR-MESSAGE = "Reason code 17 must be changed.  Please select a new reason code from the drop down";
    end
    if(VHYT03D_DATA.MOVE-REASON-CD == "GO")
        VHYT03IW-MESSAGE.ERROR-MESSAGE = "Please select a new reason code from the drop down";
    end
end 

function VHYT03IS-CK-MSG()
    if(VHYT03G_CRIT.ERROR-SUB-LOC != " " || VHYT03G_CRIT.ERROR-MOVE != " " ||
            VHYT03G_CRIT.ERROR-POSITION != " ")
        VHYT03IW-MESSAGE.MSG-1 = "Data base has changed.  Car ";
        VHYT03IW-MESSAGE.CAR-NO-1 = VHYT03IW-CAR-DAX.CAR-NO;
        VHYT03IW-MESSAGE.MSG-2 = "NOT updated";
        ERROR-MESSAGE = VHYT03IW-MESSAGE.ERROR-MESSAGE-2;
    else
        VHYT03IW-MESSAGE.ERROR-MESSAGE = "Update successful";
    end
end 

function VHYT03IS-CK-MSGX()
    if(VHYT03H_CRIT.ERROR-SUB-LOC != " " || VHYT03H_CRIT.ERROR-MOVE != " " ||
            VHYT03H_CRIT.ERROR-POSITION != " ")
        VHYT03IW-MESSAGE.MSG-1 = "Data base has changed.  Car ";
        VHYT03IW-MESSAGE.CAR-NO-1 = VHYT03IW-CAR-DAX.CAR-NO;
        VHYT03IW-MESSAGE.MSG-2 = "NOT updated";
        ERROR-MESSAGE = VHYT03IW-MESSAGE.ERROR-MESSAGE-2;
    else
        if(VHYT03H_CRIT.ERROR-POSN-NEW-LOC != " ")
            if(VHYT03H_CRIT.NEW-YRD-SUB-LOC == "T-24")
                VHYT03IW-MESSAGE.MSG-5-1 = "The new location is full - cars: ";
                VHYT03IW-MESSAGE.CAR-NO-5-1 = VHYT03H_DATA_1.CAR-NO[1];
                VHYT03IW-MESSAGE.CAR-NO-5-2 = VHYT03H_DATA_1.CAR-NO[2];
                VHYT03IW-MESSAGE.CAR-NO-5-3 = VHYT03H_DATA_1.CAR-NO[3];
                VHYT03IW-MESSAGE.CAR-NO-5-4 = VHYT03H_DATA_1.CAR-NO[4];
                VHYT03IW-MESSAGE.CAR-NO-5-5 = VHYT03H_DATA_1.CAR-NO[5];
                VHYT03IW-MESSAGE.CAR-NO-5-6 = " ";
                VHYT03IW-MESSAGE.FILLER-5-1 = ",";
                VHYT03IW-MESSAGE.FILLER-5-2 = ",";
                VHYT03IW-MESSAGE.FILLER-5-3 = ",";
                VHYT03IW-MESSAGE.FILLER-5-4 = ",";
                VHYT03IW-MESSAGE.FILLER-5-5 = " ";
                VHYT03IW-MESSAGE.ERROR-MESSAGE = VHYT03IW-MESSAGE.ERROR-MESSAGE-5;
            else
                if(VHYT03H_CRIT.NEW-YRD-SUB-LOC == "TS")
                    VHYT03IW-MESSAGE.MSG-5-1 = "The new location is full - cars: ";
                    VHYT03IW-MESSAGE.CAR-NO-5-1 = VHYT03H_DATA_1.CAR-NO[1];
                    VHYT03IW-MESSAGE.CAR-NO-5-2 = VHYT03H_DATA_1.CAR-NO[2];
                    VHYT03IW-MESSAGE.CAR-NO-5-3 = VHYT03H_DATA_1.CAR-NO[3];
                    VHYT03IW-MESSAGE.CAR-NO-5-4 = " ";
                    VHYT03IW-MESSAGE.CAR-NO-5-5 = " ";
                    VHYT03IW-MESSAGE.CAR-NO-5-6 = " ";
                    VHYT03IW-MESSAGE.FILLER-5-1 = ",";
                    VHYT03IW-MESSAGE.FILLER-5-2 = ",";
                    VHYT03IW-MESSAGE.FILLER-5-3 = ",";
                    VHYT03IW-MESSAGE.FILLER-5-4 = " ";
                    VHYT03IW-MESSAGE.FILLER-5-5 = " ";
                    VHYT03IW-MESSAGE.ERROR-MESSAGE = VHYT03IW-MESSAGE.ERROR-MESSAGE-5;
                else
                    if(VHYT03H_CRIT.NEW-YRD-SUB-LOC == "3-N")
                        VHYT03IW-MESSAGE.MSG-5-1 = "The new location is full - cars: ";
                        VHYT03IW-MESSAGE.CAR-NO-5-1 = VHYT03H_DATA_1.CAR-NO[1];
                        VHYT03IW-MESSAGE.CAR-NO-5-2 = VHYT03H_DATA_1.CAR-NO[2];
                        VHYT03IW-MESSAGE.CAR-NO-5-3 = VHYT03H_DATA_1.CAR-NO[3];
                        VHYT03IW-MESSAGE.CAR-NO-5-4 = VHYT03H_DATA_1.CAR-NO[4];
                        VHYT03IW-MESSAGE.CAR-NO-5-5 = " ";
                        VHYT03IW-MESSAGE.CAR-NO-5-6 = " ";
                        VHYT03IW-MESSAGE.FILLER-5-1 = ",";
                        VHYT03IW-MESSAGE.FILLER-5-2 = ",";
                        VHYT03IW-MESSAGE.FILLER-5-3 = ",";
                        VHYT03IW-MESSAGE.FILLER-5-4 = ",";
                        VHYT03IW-MESSAGE.FILLER-5-5 = " ";
                        VHYT03IW-MESSAGE.ERROR-MESSAGE = VHYT03IW-MESSAGE.ERROR-MESSAGE-5;
                    else
                        VHYT03IW-MESSAGE.MSG-4-1 = "Car ";
                        VHYT03IW-MESSAGE.CAR-NO-4 = VHYT03H_DATA_1.CAR-NO[1];
                        VHYT03IW-MESSAGE.MSG-4-2 = " is already present at New Location.";
                        VHYT03IW-MESSAGE.ERROR-MESSAGE = VHYT03IW-MESSAGE.ERROR-MESSAGE-4;
                    end
                end
            end
        else
            VHYT03IW-MESSAGE.ERROR-MESSAGE = "Update successful";
        end
    end
end 

