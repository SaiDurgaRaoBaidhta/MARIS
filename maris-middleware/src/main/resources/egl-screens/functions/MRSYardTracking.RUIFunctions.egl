        VHYT12IW-SAVE.ATO-PRESENT-IND = VHYT12A_DATA.ATO-PRESENT-IND[CNT];
        CAR-NO-GO = "N";
        if(VHYT12IW.CON-SIZE == 6)
            VHYT12IS-VALID-END();
            if(CAR-NO-GO == "Y")
                VHYT12IW-COLOR.CAR-6-COLOR = "RED";
            else
                VHYT12IW-COLOR.CAR-6-COLOR = "BLACK";
            end
        else
            
            VHYT12IS-VALID-MID();
