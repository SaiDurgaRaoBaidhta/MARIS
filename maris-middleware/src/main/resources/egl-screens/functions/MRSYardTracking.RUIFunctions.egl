function VHYT01IS-SI1A()
    if(VHYT10IW-TRIGGER.CLICK-ONE == " ")
        VHYT10IW-TRIGGER.CLICK-ONE = "Y";
        
        VHYT10IW-PASSVALUE.CLICK-SI-1A = "Y";
        VHYT10IW-PASSVALUE.CAR-NO = VHYT10IW-SI-1A.CAR-NO-1-CENTER;
        VHYT10IW-PASSVALUE.YRD-SUB-LOC = "SI-1A";
        VHYT10IW-PASSVALUE.POSN-NO-FROM = 1;

    
    else
        if(VHYT10IW-TRIGGER.CLICK-TWO == " ")
            VHYT10IW-TRIGGER.CLICK-TWO = "Y";
            if(VHYT10IW-PASSVALUE.CLICK-SI-1A == " ")
                VHYT10IW-PASSVALUE.CLICK-SI-1A = "Y";
                VHYT10IW-PASSVALUE.NEW-YRD-LOC = "SI-1A";
                VHYT10IW-PASSVALUE.CAR-NO-2 = VHYT10IW-SI-1A.CAR-NO-1-CENTER;
                VHYT10IW-TRIGGER.OPEN-YT03I = "Y";
            else
                VHYT10IW-PASSVALUE.CLICK-SI-1A = " ";
                VHYT10IW-TRIGGER.CLICK-ONE = " ";
                VHYT10IW-TRIGGER.CLICK-TWO = " ";
            end
        else
            VHYT10IW-TRIGGER.CLICK-ONE = " ";
            VHYT10IW-TRIGGER.CLICK-TWO = " ";
            VHYT10IW-PASSVALUE.CLICK-SI-1A = "Y";
            VHYT10IW-MESSAGE.TOO-MANY-CLICK = "TOO MANY CLICK......";
        end
    end
    if(VHYT10IW-SI-1A.CAR-NO-1-CENTER != " ")
        VHYT10IW-TRIGGER.ENABLE-SVHV = "Y";
    else
        VHYT10IW-TRIGGER.DISABLE-SVHV = "Y";
    end
end 



