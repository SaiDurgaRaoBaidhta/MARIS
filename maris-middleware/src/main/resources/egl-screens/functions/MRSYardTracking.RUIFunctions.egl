function VHYT41IS-CLICK()
    VHYT41IW-PASSVALUE.YRD-TRKG-YRD = "DPX";
    if(VHYT41IW-PARM.TRACK-NO == "L1")
        VHYT41IS-CLK-L1();
    else
        if(VHYT41IW-PARM.TRACK-NO == "L2")
            VHYT41IS-CLK-L2();
        else
            if(VHYT41IW-PARM.TRACK-NO == "LSTOR1")
                VHYT41IS-CK-LSTOR1();
            else
                if(VHYT41IW-PARM.TRACK-NO == "LSTOR2")
                    VHYT41IS-CK-LSTOR2();
                else
                    if(VHYT41IW-PARM.TRACK-NO == "LTM1")
                        VHYT41IS-CLK-LTM1();
                    else
                        if(VHYT41IW-PARM.TRACK-NO == "LTM2")
                            VHYT41IS-CLK-LTM2();
                        else
                            if(VHYT41IW-PARM.TRACK-NO == "LB1")
                                VHYT41IS-CLK-LB1();
                            else
                                if(VHYT41IW-PARM.TRACK-NO == "LB2")
                                    VHYT41IS-CLK-LB2();
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end 

function VHYT41IS-CLK-L1()
    VHYT41IW-MOVE.CLICKED = VHYT41IW-MOVE.CLICKED + 1;
    if(VHYT41IW-MOVE.CLICKED == 1)
        VHYT41IW-MOVE.FIRST-CLICK = "L1";
        VHYT41IW-PASSVALUE.FROM-CAR-POSN = VHYT41IW-PARM.POSN;
        VHYT41IW-PASSVALUE.TO-CAR-POSN = VHYT41IW-PARM.POSN;
        VHYT41IW-PASSVALUE.FROM-YRD-SUB-LOC = "L1";
    else
        if(VHYT41IW-MOVE.CLICKED == 2)
            VHYT41IW-MOVE.SECOND-CLICK = "L1";
            if(VHYT41IW-MOVE.FIRST-CLICK == VHYT41IW-MOVE.SECOND-CLICK)
                VHYT41IW-PASSVALUE.TO-CAR-POSN = VHYT41IW-PARM.POSN;
            end
        else
            if(VHYT41IW-MOVE.CLICKED == 3)
                VHYT41IW-MOVE.THIRD-CLICK = "L1";
                VHYT41IW-PASSVALUE.TO-YRD-SUB-LOC = "L1";
                VHYT41IW-TRIGGER.OPEN-DETAIL = "Y";
            end
        end
    end
end 

