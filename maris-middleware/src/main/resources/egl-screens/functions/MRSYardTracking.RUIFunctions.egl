function VHYT50IS-CTM2-P()
    VHYT50IW-PASSVALUE.YRD-SUB-LOC = "CTM2";
end 

function VHYT50IS-INIT()
    VHYT50IS-CLEAR();
    VHYT50IW-PASSVALUE.YRD-TRKG-YRD = "PBX";
    VHYT50A_CRIT.YRD-TRKG-YRD = "PBX";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT50I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT50A";

    
    try
        call "VHYT50A"(XDCONTROL, VHYT50A_CRIT, VHYT50A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT50IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT50IS-LOAD()   
    COUNTER = 1;
    while(VHYT50IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if(VHYT50A_DATA.YRD-SUB-LOC[COUNTER] == "C1")
            VHYT50IS-C1();
        end
        if(VHYT50A_DATA.YRD-SUB-LOC[COUNTER] == "C2")
            VHYT50IS-C2();
        end
        if(VHYT50A_DATA.YRD-SUB-LOC[COUNTER] == "CTM1")
            VHYT50IS-CTM1();
        end
        if(VHYT50A_DATA.YRD-SUB-LOC[COUNTER] == "CTM2")
            VHYT50IS-CTM2();
        end
        if(VHYT50A_DATA.YRD-SUB-LOC[COUNTER] == "C88-3")
            VHYT50IS-C88-3();
        end

        if(VHYT50A_DATA.YRD-SUB-LOC[COUNTER] == "C75-ST2")
            VHYT50IS-C75STOR2();
        end
        if(VHYT50A_DATA.YRD-SUB-LOC[COUNTER] == "C75-ST1")
            VHYT50IS-C75STOR1();
        end

        if(VHYT50A_DATA.YRD-SUB-LOC[COUNTER] == "CSTOR2")
            VHYT50IS-CSTOR2();
        end
        if(VHYT50A_DATA.YRD-SUB-LOC[COUNTER] == "CSTOR3")
            VHYT50IS-CSTOR3();
        end
        COUNTER = COUNTER + 1;
    end
end 

function VHYT50IS-PRINT()
    VHYT50IW-PASSVALUE.YRD-TRKG-YRD = "PBX";
end 

function VHYT50IS-PSEUDO()
    VHYT50IW-PASSVALUE.YRD-SUB-LOC = "T-95";
end 

