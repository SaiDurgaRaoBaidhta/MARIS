function VHYT11IS-MOVE-X()










    if(VHYT11IW-TRIGGER.ERROR-SW == "N")
        VHYT11B_CRIT.FROM-CAR-NO = VHYT11IW-PASSVALUE.FROM-CAR;
        VHYT11B_CRIT.TO-CAR-NO = VHYT11IW-PASSVALUE.TO-CAR;
        VHYT11B_CRIT.FROM-POSITION = VHYT11IW-PASSVALUE.FROM-POSITION;
        VHYT11B_CRIT.TO-POSITION = VHYT11IW-PASSVALUE.TO-POSITION;
        VHYT11B_CRIT.YRD-TRKG-YRD = VHYT08IW-2.YRD-TRKG-YRD;
        VHYT11B_CRIT.FROM-SUB-LOC = VHYT08IW-2.SUB-LOC;
        VHYT11B_CRIT.TO-SUB-LOC = VHYT11IW-TRACK.YRD-SUB-LOC;
        VHYT11B_CRIT.CON-NO-SW = VHYT11IW-PASSVALUE.CON-NO-NOSAME;
        VHYT11B_CRIT.USER-GROUP = VH01A01_DATA.USER-GROUP;
        VHYT11B_CRIT.TERM-ID = VH01A01_DATA.TERM-ID;
        XXEXT_CALL_Level77Items.UEXTNAM = "VHYT11I";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT11B";

        
        try
            call "VHYT11B"(XDCONTROL, VHYT11B_CRIT, VHYT11B_DATA,
                    VHYT11B_DATA_1);
        end

        
        MRSCommonCode.XXA0IS-CHECK_EXT();

        
        if(XXEXT_CALL_Level77Items.URC == 0)
            
            if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                if(VHYT11B_CRIT.RE-VALID-SW == "Y")
                    VHYT11IW-MESSAGE.MESSAGE = "Cars NOT moved, cars no longer in current positions - Return to Yard Map and try again";
                else
                    if(VHYT11B_CRIT.POSITION-FULL != "Y")
                        VHYT11IS-CLEAR-1();
                        VHYT11IW-TRIGGER.REFRESH-SW = "Y";
                        
                        VHYT11IW-TRIGGER.UPDATE-MSG = "Y";
                    else
                        VHYT11IW-MESSAGE.MESSAGE-1-1 = "No room on Track ";
                        VHYT11IW-MESSAGE.MESSAGE-1-2 = VHYT11B_CRIT.TO-SUB-LOC;
                        VHYT11IW-MESSAGE.MESSAGE-1-3 = " (has*";
                        VHYT11IW-MESSAGE.MESSAGE-1-4 = VHYT11B_CRIT.MAX-ROWS;
                        ;
                        VHYT11IW-MESSAGE.MESSAGE-1-5 = " cars )";
                        VHYT11IW-MESSAGE.MESSAGE = VHYT11IW-MESSAGE.MESSAGE-1;
                    end
                end
            else
                if(VHYT11B_CRIT.RE-VALID-SW == "Y")
                    VHYT11IW-MESSAGE.MESSAGE = "Cars NOT moved, cars no longer in current positions - Return to Yard Map and try again";
                end
                
                
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end 
        end
    end
end 

function VHYT11IS-MOVEX()
    VH01A02_CRIT.GUI-NAME = "VHYT11";
    VHYT01IS-INIT-Y();
end 

function VHYT11IS-MVECON()
    VHYT11IS-FROM-CAR();
    VHYT11IW-TRIGGER.ERROR-SW-MC = "N";
    if(VHYT11IW-PASSVALUE.FROM-CAR == " ")
        VHYT11IW-MESSAGE.MESSAGE = "Please select valid car to move";
        VHYT11IW-TRIGGER.ERROR-SW-MC = "Y";
    else
        if(VHYT11IW-PASSVALUE.FROM-POSITION == 0 ||
                VHYT11IW-PASSVALUE.TO-POSITION == 0)
            VHYT11IW-MESSAGE.MESSAGE = "No car selected on the track - no cars moved";
            VHYT11IW-TRIGGER.ERROR-SW-MC = "Y";
        else
            if(VHYT08IW-1.CAR-NO-1 == " " && VHYT08IW-1.CAR-NO-2 == " " &&
                    VHYT08IW-1.CAR-NO-3 == " " && VHYT08IW-1.CAR-NO-4 == " " &&
                    VHYT08IW-1.CAR-NO-5 == " " && VHYT08IW-1.CAR-NO-6 == " " &&
                    VHYT08IW-1.CAR-NO-7 == " " && VHYT08IW-1.CAR-NO-8 == " " &&
                    VHYT08IW-1.CAR-NO-9 == " " && VHYT08IW-1.CAR-NO-10 ==
                            " " && VHYT08IW-1.CAR-NO-11 == " " &&
                    VHYT08IW-1.CAR-NO-12 == " " && VHYT08IW-1.CAR-NO-13 ==
                            " " && VHYT08IW-1.CAR-NO-14 == " " &&
                    VHYT08IW-1.CAR-NO-15 == " " && VHYT08IW-1.CAR-NO-16 ==
                            " " && VHYT08IW-1.CAR-NO-17 == " " &&
                    VHYT08IW-1.CAR-NO-18 == " " && VHYT08IW-1.CAR-NO-19 ==
                            " " && VHYT08IW-1.CAR-NO-20 == " " &&
                    VHYT08IW-1.CAR-NO-21 == " " && VHYT08IW-1.CAR-NO-22 ==
                            " " && VHYT08IW-1.CAR-NO-23 == " " &&
                    VHYT08IW-1.CAR-NO-24 == " " && VHYT08IW-1.CAR-NO-25 ==
                            " " && VHYT08IW-1.CAR-NO-26 == " " &&
                    VHYT08IW-1.CAR-NO-27 == " " && VHYT08IW-1.CAR-NO-28 ==
                            " " && VHYT08IW-1.CAR-NO-29 == " " &&
                    VHYT08IW-1.CAR-NO-30 == " ")
                VHYT11IW-MESSAGE.MESSAGE = "No car present on current track = no con moved";
                VHYT11IW-TRIGGER.ERROR-SW-MC = "Y";
            else
                if(VHYT11IW-PASSVALUE.CLICK-COUNT > 2)
                    
                    VHYT11IW-MESSAGE.MESSAGE = "Car selected invalid, please select  a range of car.";
                    VHYT11IW-TRIGGER.ERROR-SW-MC = "Y";
                end
            end
        end
    end
    if(VHYT11IW-TRIGGER.ERROR-SW-MC != "Y")
        VHYT11IW-TRIGGER.NO-ERROR-SW-MC = "Y";
        if(VHYTIW-BUTTOM.OPEN-MOVEYRD == "Y")
            VHYTIW-BUTTOM.OPEN-MOVEYRD1 = "Y";
        end
    end
end 

function VHYT11IS-MVECON1()
    if(VHYT08IW-2.SUB-LOC != "T-95")
        VHYT11IW-MESSAGE.MESSAGE = "It can only move from T-95 cons";
        VHYT11IW-TRIGGER.ERROR-SW-MC = "Y";
    end

    
    

    
    
    
    
    
    

    
    
    
    

    
    
    
    
    
    
    if(VHYT11IW-TRIGGER.ERROR-SW-MC != "Y")
        VHYT11IW-TRIGGER.NO-ERROR-SW-MCX = "Y";
        VHIC03IW-PASSVALUE.FROM-YRD-SUB-LOC = VHYT08IW-2.SUB-LOC;
        VHIC03IW-PASSVALUE.TO-YRD-SUB-LOC = VHYT08IW-2.SUB-LOC;
        VHIC03IW-PASSVALUE.FROM-CON-NO = VHYT11IW-PASSX.VEH-CON-NO-SAVE;
        VHIC03IW-PASSVALUE.TO-CON-NO = VHYT11IW-PASSX.VEH-CON-NO-SAVE;
        VHIC03IW-PASSVALUE.FROM-YRD-TRKG-YRD = VHYT08IW-2.YRD-TRKG-YRD;
        VHIC03IW-PASSVALUE.FROM-POSN-NO = VHYT11IW-PASSVALUE.FROM-POSITION;
        VHIC03IW-PASSVALUE.TO-POSN-NO = VHYT11IW-PASSVALUE.TO-POSITION;
    end
end 

function VHYT11IS-NXT()

    set VHYT08IW-1 empty;
    VHYT08IW-TRIGGER.PAGENO = VHYT08IW-TRIGGER.PAGENO + 1;
    VHYT08IS-LABEL();
    
    
    
    
    
    
    
    if(VHYT08IW-TRIGGER.PAGENO > 1)
        VHYT08IW-TRIGGER.ENABLE-PRV = "Y";
    else
        VHYT08IW-TRIGGER.DISABLE-PRV = "Y";
    end
    VHYT11IS-PRE-LOAD();
    if(VHYT08IW-TRIGGER.FINAL-COUNT > 29)
        VHYT08IW-TRIGGER.FINAL-COUNT = VHYT08IW-TRIGGER.FINAL-COUNT - 30;
        if(VHYT08IW-TRIGGER.FINAL-COUNT > 30)
            VHYT08IW-TRIGGER.ENABLE-NXT = "Y";
        else
            VHYT08IW-TRIGGER.DISABLE-NXT = "Y";
        end
    end
end 

