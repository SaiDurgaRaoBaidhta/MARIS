function VHYT08IS-VALID()
    if(VHYT11IW-PASSVALUE.FROM-CAR == " ")
        VHYT08IW-MESSAGE.MESSAGE = "Please select valid car to move";
        VHYT11IW-TRIGGER.ERROR-SW = "Y";
    end
    if(VHYT11IW-PASSVALUE.FROM-POSITION == 0 ||
            VHYT11IW-PASSVALUE.TO-POSITION == 0)
        VHYT08IW-MESSAGE.MESSAGE = "No cars selected on the track - no cars moved";
        VHYT11IW-TRIGGER.ERROR-SW = "Y";
    end
    if(VHYT08IW-1.CAR-NO-1 == " " && VHYT08IW-1.CAR-NO-2 == " " &&
            VHYT08IW-1.CAR-NO-3 == " " && VHYT08IW-1.CAR-NO-4 == " " &&
            VHYT08IW-1.CAR-NO-5 == " " && VHYT08IW-1.CAR-NO-6 == " " &&
            VHYT08IW-1.CAR-NO-7 == " " && VHYT08IW-1.CAR-NO-8 == " " &&
            VHYT08IW-1.CAR-NO-9 == " " && VHYT08IW-1.CAR-NO-10 == " " &&
            VHYT08IW-1.CAR-NO-11 == " " && VHYT08IW-1.CAR-NO-12 == " " &&
            VHYT08IW-1.CAR-NO-13 == " " && VHYT08IW-1.CAR-NO-14 == " " &&
            VHYT08IW-1.CAR-NO-15 == " " && VHYT08IW-1.CAR-NO-16 == " " &&
            VHYT08IW-1.CAR-NO-17 == " " && VHYT08IW-1.CAR-NO-18 == " " &&
            VHYT08IW-1.CAR-NO-19 == " " && VHYT08IW-1.CAR-NO-20 == " " &&
            VHYT08IW-1.CAR-NO-21 == " " && VHYT08IW-1.CAR-NO-22 == " " &&
            VHYT08IW-1.CAR-NO-23 == " " && VHYT08IW-1.CAR-NO-24 == " " &&
            VHYT08IW-1.CAR-NO-25 == " " && VHYT08IW-1.CAR-NO-26 == " " &&
            VHYT08IW-1.CAR-NO-27 == " " && VHYT08IW-1.CAR-NO-28 == " " &&
            VHYT08IW-1.CAR-NO-29 == " " && VHYT08IW-1.CAR-NO-30 == " ")
        VHYT08IW-MESSAGE.MESSAGE = "No cars present on current track = no cars moved";
        VHYT11IW-TRIGGER.ERROR-SW = "Y";
    end
    
    
    
    
    if(VHYT11IW-PASSVALUE.CLICK-COUNT > 2)
        VHYT08IW-MESSAGE.MESSAGE = "Too many cars selected, Can only move 1 car or a range of cars.";
        VHYT11IW-TRIGGER.ERROR-SW = "Y";
    end
end 

function VHYT08IS-VALIDATE()
    VHYT08IW-TRIGGER.PAGENO = 1;
    if(VHYT08IW-PASSVALUE.YRD-SUB-LOC == "T-95")
        START-COUNTER = 1;
    else
        DISABLE-NXT = "Y";
        DISABLE-PRV = "Y";
    end
    VHYT08IS-LABEL();
end 

function VHYT09IS-CLEAR()
    set VHYT09IW-CNT empty;
    set VHYT09IW-CON-1 empty;
    set VHYT09IW-CON-2 empty;
    set VHYT09IW-CON-3 empty;
    set VHYT09IW-CON-4 empty;
    set VHYT09IW empty;
    DISABLE-PRINT = "Y";
    DISABLE-CLEAR = "Y";
    DISABLE-PRV-PAGE = "Y";
    DISABLE-NXT-PAGE = "Y";
    VHYT09IW-PASSVALUE.YRD-TRKG-YRD = "  ";
    VHYT09IW.YRD-TRKG-YRD = "  ";
    VHYT09IW-MSG.FINAL-MESSAGE = "Please select the Yard you want to display. ";
end 

