function VHYT51IS-DETAIL()
    VHYT51IW-PASSVALUE.YRD-TRKG-YRD = "PBX";
    VHYT51IW-PASSVALUE.FROM-YRD-SUB-LOC = VHYT51IW-PARM.TRACK-LOC;
end 

function VHYT51IS-INIT()
    VHYT51IS-CLEAR-1();
    set VHYT51IW-MOVE empty;
    VHYT51IW-MOVE.CLICKED = 0;
    set VHYT51IW-PASSVALUE empty;
    VHYT51IW-PASSVALUE.YRD-TRKG-YRD = "PBX";
    VHYT50A_CRIT.YRD-TRKG-YRD = "PBX";
    VH01A02_CRIT.GUI-NAME = "VHYT51";
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT50I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT50A";

    
    try
        call "VHYT50A"(XDCONTROL, VHYT50A_CRIT, VHYT50A_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT51IS-LOAD();
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT51IS-LOAD()
    move VHYT50A_DATA.DATA_ROW to VHYT51A_DATA.DATA_ROW[1] for all;
    COUNTER = 1;
    while(VHYT51IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if(VHYT51A_DATA.YRD-SUB-LOC[COUNTER] == "C1")
            VHYT51IS-C1();
        else
            if(VHYT51A_DATA.YRD-SUB-LOC[COUNTER] == "C2")
                VHYT51IS-C2();
            else
                if(VHYT51A_DATA.YRD-SUB-LOC[COUNTER] == "CTM1")
                    VHYT51IS-CTM1();
                else
                    if(VHYT51A_DATA.YRD-SUB-LOC[COUNTER] == "CTM2")
                        VHYT51IS-CTM2();
                    else
                        if(VHYT51A_DATA.YRD-SUB-LOC[COUNTER] == "C88-3")
                            VHYT51IS-C88-3();
                        else
                            if(VHYT51A_DATA.YRD-SUB-LOC[COUNTER] == "CSTOR2")
                                VHYT51IS-CSTOR2();
                            else
                                if(VHYT51A_DATA.YRD-SUB-LOC[COUNTER] ==
                                        "CSTOR3")
                                    VHYT51IS-CSTOR3();
                                end
                                if(VHYT51A_DATA.YRD-SUB-LOC[COUNTER] ==
                                        "C75-ST1")
                                    VHYT51IS-C75STOR1();
                                end
                                if(VHYT51A_DATA.YRD-SUB-LOC[COUNTER] ==
                                        "C75-ST2")
                                    VHYT51IS-C75STOR2();
                                end
                            end                                
                        end                        
                    end
                end
            end
        end
        COUNTER = COUNTER + 1;
    end
end 

function VHYT51IS-MAINT()
    VHYT51IW-PASSVALUE.YRD-TRKG-YRD = "PBX";
    VH01A02_CRIT.GUI-NAME = "VHYT50";
    VHYT01IS-INIT-Y();
end 

function VHYT51IS-PSEUDO()
    set VHYT51IW-PASSVALUE empty;
    VHYT51IW-PASSVALUE.FROM-YRD-SUB-LOC = "T-95";
    VHYT51IW-PASSVALUE.YRD-TRKG-YRD = "PBX";
end 

function VHYT51IS-REPORT()
    VHYT51IW-PASSVALUE.YRD-TRKG-YRD = "PBX";
end 

function VHYT51IS-TRACK()
    set VHYT51IW-PASSVALUE empty;
    VHYT51IW-PASSVALUE.FROM-YRD-SUB-LOC = VHYT51IW-PARM.TRACK-LOC;
    VHYT51IW-PASSVALUE.YRD-TRKG-YRD = "PBX";
    VHYT51IW-MOVE.CLICKED = 0;
end 

function VHYT52-CLEAR()
    set VHYT52A-CONSIST empty;
end 

function VHYT52-MOVE-CARS()
    set VHYT52A-CONSIST empty;
    VHYT52A-PASSVALUE.CNT = 1;
    VHYT52A-PASSVALUE.CNT1 = 1;
    VHYT52A-PASSVALUE.CON-NO-OLD = "   ";
    VHYT52A-PASSVALUE.LAST-ROW = 1;
    while(VHYT52A-PASSVALUE.CNT <= XDCONTROL.UROWCNT)
        if(VHYT52A_DATA.CONSIST[CNT] != VHYT52A-PASSVALUE.CON-NO-OLD)
            if(VHYT52A-TRIGGER.FIRST-SW == "Y")
                VHYT52A-PASSVALUE.LAST-ROW = 1;
                VHYT52A-TRIGGER.FIRST-SW = "N";
            else
                VHYT52A-PASSVALUE.LAST-ROW = VHYT52A-PASSVALUE.LAST-ROW + 1;
                VHYT52A-TRIGGER.FIRST-SW = "N";
            end
            VHYT52A-PASSVALUE.CNT1 = 1;
            VHYT52A-PASSVALUE.CON-NO-OLD = VHYT52A_DATA.CONSIST[CNT];
            VHYT52A-PASSVALUE.CON-NUM = VHYT52A_DATA.CON-NO[CNT];
            VHYT52A-PASSVALUE.HYPHEN = VHYT52A_DATA.CON-HYPHEN[CNT];
            VHYT52A-PASSVALUE.DASH-NO = VHYT52A_DATA.DASH-NO[CNT];
            VHYT52A-CONSIST.CON-NO-D[LAST-ROW] = VHYT52A-PASSVALUE.CONSIST-NUMB;
            VHYT52A-PASSVALUE.CAR-NUM[CNT1] = VHYT52A_DATA.CAR-NO[CNT];
            if(VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "<" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "(" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "O" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "{" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "v" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "b" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "l" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "m")
                VHYT52A-PASSVALUE.LFT-ORIENT[CNT1] = VHYT52A_DATA.LFT-ORIENTATION-CD[CNT];
                VHYT52A-PASSVALUE.RHT-ORIENT[CNT1] = " ";
            else
                VHYT52A-PASSVALUE.RHT-ORIENT[CNT1] = VHYT52A_DATA.RGT-ORIENTATION-CD[CNT];
                VHYT52A-PASSVALUE.LFT-ORIENT[CNT1] = " ";
            end
            VHYT52A-CARS();
            VHYT52A-CONSIST.DATE-INSRV-REV[LAST-ROW] = VHYT52A_DATA.DATE-INSRV-REV[CNT];
            VHYT52A-CONSIST.DATE-INSRV[LAST-ROW] = VHYT52A_DATA.DATE-INSRV[CNT];
            VHYT52A-CONSIST.CON-STAT[LAST-ROW] = VHYT52A_DATA.CON-STAT[CNT];
            VHYT52A-CONSIST.TIME-INSRV[LAST-ROW] = VHYT52A_DATA.TIME-INSRV[CNT];
            VHYT52A-CONSIST.NO-CARS-IND[LAST-ROW] = VHYT52A_DATA.NO-CARS-IND[CNT];
            VHYT52A-PASSVALUE.CNT = VHYT52A-PASSVALUE.CNT + 1;
        else
            VHYT52A-PASSVALUE.CNT1 = VHYT52A-PASSVALUE.CNT1 + 1;
            VHYT52A-PASSVALUE.CAR-NUM[CNT1] = VHYT52A_DATA.CAR-NO[CNT];
            if(VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "<" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "(" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "O" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "{" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "v" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "b" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "l" ||
                    VHYT52A_DATA.VAGen_ORIENTATION[CNT] == "m")
                VHYT52A-PASSVALUE.LFT-ORIENT[CNT1] = VHYT52A_DATA.LFT-ORIENTATION-CD[CNT];
                VHYT52A-PASSVALUE.RHT-ORIENT[CNT1] = " ";
            else
                VHYT52A-PASSVALUE.RHT-ORIENT[CNT1] = VHYT52A_DATA.RGT-ORIENTATION-CD[CNT];
                VHYT52A-PASSVALUE.LFT-ORIENT[CNT1] = " ";
            end
            VHYT52A-CARS();
            VHYT52A-PASSVALUE.CNT = VHYT52A-PASSVALUE.CNT + 1;
        end
    
    end
end 

function VHYT52A-CARS()
    if(VHYT52A-PASSVALUE.CNT1 == 1)
        VHYT52A-CONSIST.CAR-01[LAST-ROW] = VHYT52A-PASSVALUE.CAR-NUMBER[CNT1];
    end
    if(VHYT52A-PASSVALUE.CNT1 == 2)
        VHYT52A-CONSIST.CAR-02[LAST-ROW] = VHYT52A-PASSVALUE.CAR-NUMBER[CNT1];
    end
    if(VHYT52A-PASSVALUE.CNT1 == 3)
        VHYT52A-CONSIST.CAR-03[LAST-ROW] = VHYT52A-PASSVALUE.CAR-NUMBER[CNT1];
    end
    if(VHYT52A-PASSVALUE.CNT1 == 4)
        VHYT52A-CONSIST.CAR-04[LAST-ROW] = VHYT52A-PASSVALUE.CAR-NUMBER[CNT1];
    end
    if(VHYT52A-PASSVALUE.CNT1 == 5)
        VHYT52A-CONSIST.CAR-05[LAST-ROW] = VHYT52A-PASSVALUE.CAR-NUMBER[CNT1];
    end
    if(VHYT52A-PASSVALUE.CNT1 == 6)
        VHYT52A-CONSIST.CAR-06[LAST-ROW] = VHYT52A-PASSVALUE.CAR-NUMBER[CNT1];
    end
    if(VHYT52A-PASSVALUE.CNT1 == 7)
        VHYT52A-CONSIST.CAR-07[LAST-ROW] = VHYT52A-PASSVALUE.CAR-NUMBER[CNT1];
    end
    if(VHYT52A-PASSVALUE.CNT1 == 8)
        VHYT52A-CONSIST.CAR-08[LAST-ROW] = VHYT52A-PASSVALUE.CAR-NUMBER[CNT1];
    end
    if(VHYT52A-PASSVALUE.CNT1 == 9)
        VHYT52A-CONSIST.CAR-09[LAST-ROW] = VHYT52A-PASSVALUE.CAR-NUMBER[CNT1];
    end
    if(VHYT52A-PASSVALUE.CNT1 == 10)
        VHYT52A-CONSIST.CAR-10[LAST-ROW] = VHYT52A-PASSVALUE.CAR-NUMBER[CNT1];
    end
end 

function VHYT52A-RETRIEVE()
    if(VHYT52A-PASSVALUE.ERRCAR == "N")
        set VHYT52A_MESSAGE empty;
    end
    if(VHYT52A-CONSIST.CON-STAT[SELECTION-IDX] == "CON")
        VHYT52A_MESSAGE.MESG1 = "Invalid Selection. Train has Train Incident.";
    else
        if(VHYT52A-CONSIST.CON-STAT[SELECTION-IDX] == "CAR")
            VHYT52A_NOGO();
            VHYT52A_MESSAGE.MESG1 = VHYT52A_MESSAGE.MESG5;
        else
            if(VHYT52A-CONSIST.NO-CARS-IND[SELECTION-IDX] == "Y")
                VHYT52A_MESSAGE.MESG1 = "Cannot Retrieve Cars For Train With 'NO CARS'. Please Make Another Selection";
            else
                VHYT52B_DATA.RETRIEVE-REQST-CD = "RQST";
                VHYT52A-SELECTION.CONSIST = VHYT52A-CONSIST.CON-NO-D[SELECTION-IDX];
                VHYT52B_DATA.CON-NO = VHYT52A-SELECTION.CON-NO;
                VHYT52B_DATA.DASH-NO = VHYT52A-SELECTION.DASH-NO;
                VHYT52B_DATA.DATE-INSRV-REV = VHYT52A-CONSIST.DATE-INSRV-REV[SELECTION-IDX];
                VHYT52B_DATA.DATE-INSRV = VHYT52A-CONSIST.DATE-INSRV[SELECTION-IDX];
                VHYT52B_DATA.TIME-INSRV = VHYT52A-CONSIST.TIME-INSRV[SELECTION-IDX];
                VHYT52B_DATA.CURR-CON-NO = "   ";
                VHYT52B_DATA.USER-GRP-REQST = VHYT52A-PASSVALUE.USER-GRP;

                
                
                VHYT52B_MSGRCV.MSG-PROCESSED-CD = "N";
                VHYT52B_MSGRCV.MSG-TRAN-CD = "3R";
                VHYT52B_MSGRCV.MSG-LENGTH = 126;
                VHYT52B_MSGRCV.CON-NO = VHYT52A-SELECTION.CON-NO;
                VHYT52B_MSGRCV.DASH-NO = VHYT52A-SELECTION.DASH-NO;
                VHYT52B_MSGRCV.DATE-INSRV-REV = VHYT52A-CONSIST.DATE-INSRV-REV[SELECTION-IDX];
                if(VHYT52A-TRIGGER.ENABLE-YRD == "Y")
                    VHYT52B_MSGRCV.CON-CURR-YRD = VHYT52A-PASSVALUE.YRD-TRKG-YRD-L;
                    VHYT52B_DATA.YRD-REQST = VHYT52A-PASSVALUE.YRD-TRKG-YRD-L;
                else
                    VHYT52B_MSGRCV.CON-CURR-YRD = VHYT52A-PASSVALUE.YRD-TRKG-YRD;
                    VHYT52B_DATA.YRD-REQST = VHYT52A-PASSVALUE.YRD-TRKG-YRD;
                end
                try
                    call "VHYT52B"(VHYT52BR_DATA, VHYT52B_CRIT, VHYT52B_MSGRCV,
                            XDCONTROL, VHYT52B_DATA);

                end
                if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    if(VHYT52B_CRIT.YES-REQUEST == "Y")
                        VHYT52A_MESSAGE.MESG4-1 = "Retrieve request already present for train";
                        VHYT52A_MESSAGE.MESG4-2 = VHYT52A-SELECTION.CON-NO;
                        VHYT52A_MESSAGE.MESG1 = VHYT52A_MESSAGE.MESG4;
                    else
                        VHYT52A_MESSAGE.MESG1 = "Process started  Cars will be placed in your pseudo track";
                    end
                else
                    VHYT52A_MESSAGE.MESG1 = " Update Failed - Please Refresh";
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    return;
                end
            end
        end
    end
    VHYT52A-TRIGGER.DISABLE-RETRIEVE = "Y";
    VHYT52A-SELECTION_Level77Items.SELECTION-IDX = 0;
    VHYT52A-PASSVALUE.SELECT-TIMES = "N";
end 

function VHYT52A_INIT()
    VHYT52IS-CLEAR();
    
    
    VHYT52A_MESSAGE.MESG1 = "                                                                                ";
    VHYT52A-TRIGGER.FIRST-SW = "Y";
    VHYT52A-TRIGGER.DISABLE-RETRIEVE = "Y";
    VHYT52A-PASSVALUE.ERRCAR = "N";
    VHYT52A_CRIT.YRD-TRKG-YRD = VHYT52A-PASSVALUE.YRD-TRKG-YRD;
    try
        call "VHYT52A"(XDCONTROL, VHYT52A_CRIT, VHYT52A_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT52-MOVE-CARS();
        LOC-TRIGGER = "Y";
    else
        VHYT52A_MESSAGE.MESG1 = " No Inservice trains present for your location";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end

    
    
    
    
    
    
    
    
    
    
    
    
    STOR-INDEX = 1;
    STOR-SELECTION = 0;

    
    
    
    
    
    
    
    
    if(VHYT52A-PASSVALUE.WHICH-GUI == "VH001I")
        VHYT52A-TRIGGER.ENABLE-YRD = "Y";
    else
        VHYT52A-TRIGGER.DISABLE-YRD = "Y";
    end
end 

function VHYT52A_LIST()

    VHYT52A_MESSAGE.MESG1 = "                                                                                ";
    VHYT52A-TRIGGER.FIRST-SW = "Y";
    VHYT52A-TRIGGER.DISABLE-RETRIEVE = "Y";
    VHYT52A-PASSVALUE.ERRCAR = "N";
    VHYT52A_CRIT.YRD-TRKG-YRD = VHYT52A-PASSVALUE.YRD-TRKG-YRD-L;
    try
        call "VHYT52A"(XDCONTROL, VHYT52A_CRIT, VHYT52A_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT52-MOVE-CARS();
        LOC-TRIGGER = "Y";
    else
        VHYT52A_MESSAGE.MESG1 = " No Inservice trains present for your location";
        VHYT52A-TRIGGER.CLEAR-SW = "Y";
        set VHYT52A-CONSIST empty;
        set VHYT52A-PASSVALUE empty;
        set VHYT52A_DATA empty;
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

function VHYT52A_NOGO()
    VHYT52A_MESSAGE.MESG5 = "                                                                                                                                                     ";
    VHYT52A_MESSAGE.MESG-TXT1 = " Invalid selction. Train has 'NO GO' cars. Please call Central. Cars:";
    VHYT52A-PASSVALUE.CNT = 1;
    VHYT52A-PASSVALUE.CNT1 = 1;
    VHYT52A-PASSVALUE.CNT2 = 6;
    VHYT52A-TRIGGER.FIRST-SW = "Y";
    VHYT52A-PASSVALUE.CON-NO-OLD = "   ";
    VHYT52A-PASSVALUE.SELECT-TIMES = "N";
    while(VHYT52A-PASSVALUE.CNT <= VHYT52A-PASSVALUE.CNT2)
        if(VHYT52A_DATA.CONSIST[CNT] != VHYT52A-PASSVALUE.CON-NO-OLD)
            if(VHYT52A-TRIGGER.FIRST-SW == "Y")
                VHYT52A-PASSVALUE.CNT1 = 1;
                VHYT52A-TRIGGER.FIRST-SW = "N";
            else
                
                VHYT52A-TRIGGER.FIRST-SW = "N";
            end
            VHYT52A-PASSVALUE.CON-NO-OLD = VHYT52A_DATA.CONSIST[CNT];
            if(VHYT52A_DATA.VEH-STAT[CNT] == "NO GO")
                VHYT52A_MESSAGE.MSG-CAR[CNT1] = VHYT52A_DATA.CAR-NO[CNT];
                VHYT52A_MESSAGE.MSG-COMMA[CNT1] = ",";
                VHYT52A-PASSVALUE.CNT1 = VHYT52A-PASSVALUE.CNT1 + 1;
                VHYT52A-PASSVALUE.ERRCAR = "Y";
            else
                VHYT52A-PASSVALUE.CNT = VHYT52A-PASSVALUE.CNT + 1;
            end
        else
            VHYT52A-PASSVALUE.CNT = VHYT52A-PASSVALUE.CNT + 1;
        end
    end
end 

function VHYT52IS-CLEAR()
    if(VHYT52A-PASSVALUE.WHICH-GUI == "VH001I")

    else
        set VHYT52A-CONSIST empty;
        
        set VHYT52A_MESSAGE empty;
        VHYT52A-PASSVALUE.SELECT-TIMES = "N";
    end
end 

function VHYT52IS-SEL-ITEM()
    if(VHYT52A-PASSVALUE.ERRCAR == "Y")
    
    

    else
        if(VHYT52A-PASSVALUE.SELECT-TIMES == "Y" &&
                VHYT52A-SELECTION_Level77Items.SELECTION-IDX ==
                        VHYT52A-SELECTION_Level77Items.SELECTION-IDX-OLD) 
            VHYT52A_MESSAGE.MESG1 = "Please select one row from container to identify train whose cars are to be returned";
            VHYT52A-TRIGGER.DISABLE-RETRIEVE = "Y";
            VHYT52A-PASSVALUE.SELECT-TIMES = "N";
        else
            if(VHYT52A-SELECTION_Level77Items.SELECTION-IDX > 0)
                VHYT52A-TRIGGER.ENABLE-RETRIEVE = "Y";
                VHYT52A-PASSVALUE.SELECT-TIMES = "Y";
                set VHYT52A_MESSAGE empty;
                VHYT52A-SELECTION_Level77Items.SELECTION-IDX-OLD = VHYT52A-SELECTION_Level77Items.SELECTION-IDX;
            else
                VHYT52A-TRIGGER.DISABLE-RETRIEVE = "Y";
                VHYT52A-PASSVALUE.SELECT-TIMES = "N";
            end
        end
    end
    if(VHYT52A-PASSVALUE.ERRCAR == "Y")
        VHYT52A-TRIGGER.ENABLE-RETRIEVE = "Y";
        VHYT52A-PASSVALUE.SELECT-TIMES = "Y";
        VHYT52A-SELECTION_Level77Items.SELECTION-IDX-OLD = VHYT52A-SELECTION_Level77Items.SELECTION-IDX;
        VHYT52A-PASSVALUE.ERRCAR = "N";
    end
end 

function VHYT54-FORCE()
    VHYT54A_MESSAGE.MESG1 = "                                                                                ";
    if(VHYT54I-PASSVALUE.CON-NO < "100" || VHYT54I-PASSVALUE.CON-NO > "999")
        VHYT54I-ERR-MSG.ERR1-MSG = "Train ";
        VHYT54I-ERR-MSG.ERR-CON-NO = VHYT54I-PASSVALUE.CON-NO;
        VHYT54I-ERR-MSG.ERR1-MSG-2 = " is not a valid train number.";
        VHYT54A_MESSAGE.MESG1 = VHYT54I-ERR-MSG.ERROR-CON;
        return;
    end
    VHYT54A_CRIT.CON-NO = VHYT54I-PASSVALUE.CON-NO;
    try
        call "VHYT54A"(XDCONTROL, VHYT54A_CRIT, VHYT54A_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        LOC-TRIGGER = "Y";
    else
        VHYT54I-ERR-MSG.ERR1-MSG = "Train ";
        VHYT54I-ERR-MSG.ERR-CON-NO = VHYT54I-PASSVALUE.CON-NO;
        VHYT54I-ERR-MSG.ERR1-MSG-2 = " is not in service.";
        VHYT54A_MESSAGE.MESG1 = VHYT54I-ERR-MSG.ERROR-CON;
        VHYT54A_MESSAGE.MESG1 = VHYT54I-ERR-MSG.ERROR-CON;
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    VHYT54B_CRIT.YRD = VHYT54I-PASSVALUE.YRD;
    try
        call "VHYT54B"(XDCONTROL, VHYT54B_CRIT, VHYT54B_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        LOC-TRIGGER = "Y";
    else
        VHYT54I-ERR-MSG.ERR2-MSG = "Clear-To-Location  ";
        VHYT54I-ERR-MSG.ERR-YRD = VHYT54I-PASSVALUE.YRD;
        VHYT54I-ERR-MSG.ERR2-MSG-2 = " is not a valid location to clear trains.";
        VHYT54A_MESSAGE.MESG1 = VHYT54I-ERR-MSG.ERROR-YRD;
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    VHYT54C_DATA.CON-CURR-YRD = VHYT54I-PASSVALUE.YRD;
    VHYT54C_DATA.CON-NO = VHYT54I-PASSVALUE.CON-NO;
    VHYT54C_DATA.MSG-PROCESSED-CD = "N";
    VHYT54C_DATA.MSG-TRAN-CD = "3F";
    VHYT54C_DATA.MSG-LENGTH = 126;
    VHYT54C_DATA.DASH-NO = VHYT54A_DATA.DASH-NO;
    VHYT54C_DATA.DATE-INSRV-REV = VHYT54A_DATA.DATE-INSRV-REV;
    VHYT54C_DATA.USER-GRP-MSG-CMPLT = VH01A01_DATA.USER-GROUP;
    VHYT54C_DATA.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
    try
        call "VHYT54C"(XDCONTROL, VHYT54C_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        LOC-TRIGGER = "Y";
        VHYT54I-ERR-MSG.PRO-MSG-1 = "Process started. Train ";
        VHYT54I-ERR-MSG.PRO-CON-NO = VHYT54I-PASSVALUE.CON-NO;
        VHYT54I-ERR-MSG.PRO-MSG-2 = " will be cleared to ";
        VHYT54I-ERR-MSG.PRO-YRD = VHYT54I-PASSVALUE.YRD;
        VHYT54A_MESSAGE.MESG1 = VHYT54I-ERR-MSG.PRO-MSG;
    else
        VHYT54I-ERR-MSG.ERR2-MSG = "Clear-To-Location  ";
        VHYT54I-ERR-MSG.ERR-YRD = VHYT54I-PASSVALUE.YRD;
        VHYT54I-ERR-MSG.ERR2-MSG-2 = " is not a valid location to clear trains.";
        VHYT54A_MESSAGE.MESG1 = VHYT54I-ERR-MSG.ERROR-YRD;
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end

    
    VHYT54I-ERR-MSG.ERROR-CON = "                                     ";
    VHYT54I-PASSVALUE.YRD = "   ";
    VHYT54I-PASSVALUE.CON-NO = "   ";
end 

function VHYT54B_INIT()
    VHYT54A_MESSAGE.MESG1 = "                                                                                              ";
    VHYT54I-ERR-MSG.ERROR-CON = "                                     ";
    VHYT54I-PASSVALUE.YRD = "   ";
    VHYT54I-PASSVALUE.CON-NO = "   ";
end 

function VHYT54I-CLEAR()
    VHYT54A_MESSAGE.MESG1 = "                                                                                              ";
    VHYT54I-ERR-MSG.ERROR-CON = "                                     ";
    VHYT54I-PASSVALUE.YRD = "   ";
    VHYT54I-PASSVALUE.CON-NO = "   ";
end 

