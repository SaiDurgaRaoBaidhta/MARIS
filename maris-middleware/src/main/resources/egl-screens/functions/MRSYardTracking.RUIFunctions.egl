function VHYT11IS-CK-CON()
    VHYT11B_CRIT.SAME-CON-NO-SW = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[1] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[2] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[3] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[4] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[5] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[6] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[7] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[8] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[9] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[10] = " ";
    if(VHYT11IW-PASSVALUE.FROM-POSITION > 0 && VHYT11IW-PASSVALUE.TO-POSITION >
                    0 &&(VHYT11IW-PASSVALUE.FROM-POSITION !=
                    VHYT11IW-PASSVALUE.TO-POSITION))
        VHYT11IW-PASSVALUE.PREV-POS = VHYT11IW-PASSVALUE.FROM-POSITION - 1;
        VHYT11IW-PASSVALUE.AFTER-POS = VHYT11IW-PASSVALUE.TO-POSITION + 1;
        VHYT11IS-CK-CON-1();
    end
end 

function VHYT11IS-CK-CON-1()
    VHYT11IW-PASSVALUE.ALL-CARS = " ";
    if(VHYT11IW-PASSVALUE.PREV-POS == 0 && VHYT11IW-PASSVALUE.AFTER-POS >=
                    VHYT11IW-PASSVALUE.CAR-COUNT)
        VHYT11IW-PASSVALUE.COUNTERX = 1;
        VHYT11IW-PASSVALUE.FINAL-COUNTER = VHYT11IW-PASSVALUE.CAR-COUNT;
        VHYT11IW-PASSVALUE.ALL-CARS = "Y";
    end

    if(VHYT11IW-PASSVALUE.PREV-POS == 0 && VHYT11IW-PASSVALUE.AFTER-POS <
                    VHYT11IW-PASSVALUE.CAR-COUNT)
        VHYT11IW-PASSVALUE.COUNTERX = 1;
        VHYT11IW-PASSVALUE.FINAL-COUNTER = VHYT11IW-PASSVALUE.AFTER-POS;
    end
    if(VHYT11IW-PASSVALUE.PREV-POS != 0 && VHYT11IW-PASSVALUE.AFTER-POS >=
                    VHYT11IW-PASSVALUE.CAR-COUNT)
        VHYT11IW-PASSVALUE.COUNTERX = VHYT11IW-PASSVALUE.PREV-POS;
        VHYT11IW-PASSVALUE.FINAL-COUNTER = VHYT11IW-PASSVALUE.CAR-COUNT;
    end
    if(VHYT11IW-PASSVALUE.PREV-POS != 0 && VHYT11IW-PASSVALUE.AFTER-POS <
                    VHYT11IW-PASSVALUE.CAR-COUNT)
        VHYT11IW-PASSVALUE.COUNTERX = VHYT11IW-PASSVALUE.PREV-POS;
        VHYT11IW-PASSVALUE.FINAL-COUNTER = VHYT11IW-PASSVALUE.AFTER-POS;
    end
    VHYT11IW-PASSVALUE.IDX = 0;
    VHYT11IW-PASSVALUE.FIRST-TIME-CK = " ";
    VHYT11IW-PASSVALUE.TOTAL-POS = VHYT11IW-PASSVALUE.FROM-POSITION -
            VHYT11IW-PASSVALUE.TO-POSITION + 1;
    VHYT11IW-PASSVALUE.FROM-COUNTER = VHYT11IW-PASSVALUE.FROM-POSITION;
    if(VHYT11IW-PASSVALUE.PREV-POS > 0)

        if(VHYT08A_DATA.CON-NO[PREV-POS] == " " &&
                VHYT08A_DATA.CON-NO[AFTER-POS] == " ")
            while(VHYT11IW-PASSVALUE.FROM-COUNTER <
                    VHYT11IW-PASSVALUE.TO-POSITION)
                if(VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.FROM-COUNTER] ==
                        VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.TO-POSITION])
                    VHYT11IW-PASSVALUE.ALL-CARS = "Y";
                else
                    VHYT11IW-PASSVALUE.ALL-CARS = " ";
                end
                VHYT11IW-PASSVALUE.FROM-COUNTER = VHYT11IW-PASSVALUE.FROM-COUNTER +
                        1;
            end
        end
    end
    while(VHYT11IW-PASSVALUE.COUNTERX < VHYT11IW-PASSVALUE.FINAL-COUNTER)
        VHYT11IW-PASSVALUE.COUNTER-NEXT = VHYT11IW-PASSVALUE.COUNTERX + 1;
        if((VHYT11IW-PASSVALUE.FIRST-TIME-CK == " " &&(
                VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTER-NEXT] !=
                        VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.CAR-COUNT]) &&
                VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTERX] !=
                        VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTER-NEXT]) &&
                VHYT11IW-PASSVALUE.TOTAL-POS > 2 ||
                VHYT11IW-PASSVALUE.ALL-CARS == "Y")
            VHYT11IW-PASSVALUE.FIRST-TIME-CK = "Y";
            VHYT11B_CRIT.SAME-CON-NO-SW = "Y";
            VHYT11IW-PASSVALUE.IDX = VHYT11IW-PASSVALUE.IDX + 1;
            if(VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTERX] != " ")
                VHYT11B_CRIT.SAME-CON-NO-X[IDX] = VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTERX];
            else
                VHYT11B_CRIT.SAME-CON-NO-X[IDX] = VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTER-NEXT];
            end
            VHYT11IW-PASSVALUE.COUNTERX = VHYT11IW-PASSVALUE.COUNTERX + 1;
        else
            if(VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTERX] !=
                    VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTER-NEXT] &&(
                    VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTERX] != " "))

                VHYT11B_CRIT.SAME-CON-NO-SW = "Y";
                VHYT11IW-PASSVALUE.IDX = VHYT11IW-PASSVALUE.IDX + 1;
                if(VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTERX] != " ")
                    VHYT11B_CRIT.SAME-CON-NO-X[IDX] = VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTERX];
                else
                    VHYT11B_CRIT.SAME-CON-NO-X[IDX] = VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTER-NEXT];
                end
                VHYT11IW-PASSVALUE.COUNTERX = VHYT11IW-PASSVALUE.COUNTERX + 1;
            end
        end
        VHYT11IW-PASSVALUE.COUNTERX = VHYT11IW-PASSVALUE.COUNTERX + 1;
    end
    if(VHYT11IW-PASSVALUE.ALL-CARS == "Y" && VHYT11B_CRIT.SAME-CON-NO-SW ==
                    " ")
        VHYT11IW-PASSVALUE.COUNTER-NEXT = VHYT11IW-PASSVALUE.COUNTERX + 1;
        VHYT11B_CRIT.SAME-CON-NO-SW = "Y";
        VHYT11IW-PASSVALUE.IDX = VHYT11IW-PASSVALUE.IDX + 1;
        if(VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTERX] != " ")
            VHYT11B_CRIT.SAME-CON-NO-X[IDX] = VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTERX];
        else
            VHYT11B_CRIT.SAME-CON-NO-X[IDX] = VHYT08A_DATA.CON-NO[VHYT11IW-PASSVALUE.COUNTER-NEXT];
        end
    end
end 

function VHYT11IS-CK-CON-X()










    set VHYT11C_CRIT empty;
    set VHYT11C_DATA empty;
    VHYT11C_CRIT.FROM-POSITION = VHYT11IW-PASSVALUE.FROM-POSITION;
    VHYT11C_CRIT.TO-POSITION = VHYT11IW-PASSVALUE.TO-POSITION;
    VHYT11C_CRIT.YRD-TRKG-YRD = VHYT08IW-2.YRD;
    VHYT11C_CRIT.FROM-SUB-LOC = VHYT08IW-2.SUB-LOC;
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT11I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT11C";

    
    try
        call "VHYT11C"(XDCONTROL, VHYT11C_CRIT, VHYT11C_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHYT11IS-CK-CON-Z();
        else
            VHYT11IW-TRIGGER.RUN-MOVE = "Y";
        end
    else

        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

function VHYT11IS-CK-CON-Z()
    VHYT11IW-PASSVALUE.COUNTERX = XDCONTROL.UROWCNT;
    VHYT11IW-PASSVALUE.COUNTER-NEXT = 1;
    VHYT11B_CRIT.SAME-CON-NO-SW = " ";
    VHYT11IW-PASSVALUE.NOT-SAME-CON-NO-SW = " ";
    VHYT11IW-PASSVALUE.IDX = 0;
    VHYT11IW-MESSAGE.MESSAGE-2 = " ";
    VHYT11IW-PASSVALUE.CON-NO-SPLIT[1] = " ";
    VHYT11IW-PASSVALUE.CON-NO-SPLIT[2] = " ";
    VHYT11IW-PASSVALUE.CON-NO-SPLIT[3] = " ";
    VHYT11IW-PASSVALUE.CON-NO-SPLIT[4] = " ";
    VHYT11IW-PASSVALUE.CON-NO-SPLIT[5] = " ";
    VHYT11IW-PASSVALUE.CON-NO-SPLIT[6] = " ";
    VHYT11IW-PASSVALUE.CON-NO-SPLIT[7] = " ";
    VHYT11IW-PASSVALUE.CON-NO-SPLIT[8] = " ";
    VHYT11IW-PASSVALUE.CON-NO-SPLIT[9] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[1] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[2] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[3] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[4] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[5] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[6] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[7] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[8] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[9] = " ";
    VHYT11B_CRIT.SAME-CON-NO-X[10] = " ";
    VHYT11IW-PASSVALUE.CON-NO-SPLIT[10] = " ";
    while(VHYT11IW-PASSVALUE.COUNTER-NEXT <= VHYT11IW-PASSVALUE.COUNTERX)
        if(VHYT11C_DATA.SPLIT-NOT[COUNTER-NEXT] == "NOT")
            VHYT11B_CRIT.SAME-CON-NO-SW = "Y";
            VHYT11B_CRIT.SAME-CON-NO-X[COUNTER-NEXT] = VHYT11C_DATA.CON-NO[COUNTER-NEXT];
        else
            VHYT11IW-PASSVALUE.NOT-SAME-CON-NO-SW = "Y";
            VHYT11IW-PASSVALUE.IDX = VHYT11IW-PASSVALUE.IDX + 1;
            VHYT11IW-PASSVALUE.CON-NO-SPLIT[IDX] = VHYT11C_DATA.CON-NO[COUNTER-NEXT];

        end
        VHYT11IW-PASSVALUE.COUNTER-NEXT = VHYT11IW-PASSVALUE.COUNTER-NEXT + 1;
    end
    if(VHYT11IW-PASSVALUE.NOT-SAME-CON-NO-SW == "Y")
        VHYT11IW-MESSAGE.MESSAGE-2-1 = "All cars for Pseudo Train(s), ";
        VHYT11IW-MESSAGE.MESSAGE-2-2 = VHYT11IW-PASSVALUE.CON-NO-SPLIT[1];
        VHYT11IW-MESSAGE.MESSAGE-2-3 = ",  ";
        VHYT11IW-MESSAGE.MESSAGE-2-4 = VHYT11IW-PASSVALUE.CON-NO-SPLIT[2];
        VHYT11IW-MESSAGE.MESSAGE-2-5 = " are not being moved. ";
        VHYT11IW-MESSAGE.MESSAGE-2-6 = " This will result in the Pseudo Train(s) being 'un-made'. ";
        VHYT11IW-MESSAGE.MESSAGE-2-7 = " Do you want to continue?";
        VHYT11IW-MSG.TEST-MSG = VHYT11IW-MESSAGE.MESSAGE-2;
        VHYT11IW-TRIGGER.MESSAGE-SPLI = "Y";
    else
        VHYT11IW-TRIGGER.RUN-MOVE = "Y";
    end
end 

function VHYT11IS-CLEAR()
    set VHYT11IW-MESSAGE empty;
    if(VHYT08IW-TRIGGER.PAGENO < 2)
        VHYT08IW-TRIGGER.PAGENO = 1;
        VHYT08IS-LABEL();
    end
    VHYT11IS-CLEAR-1();
    VHYT11IW-PASSVALUE.FROM-CAR = " ";
    VHYT11IW-PASSVALUE.TO-CAR = " ";
    VHYT11IW-PASSVALUE.FROM-POSITION = 0;
    VHYT11IW-PASSVALUE.TO-POSITION = 0;
    VHYT11IW-PASSVALUE.DIFFERENCE-POSITION = 0;
end 

