                        VHYT60IS-S6-1();
                    else
                        if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S6-2")
                            VHYT60IS-S6-2();
                        else
                            if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S6-3")
                                VHYT60IS-S6-3();
                            else
                                if(VHYT60A-DATA.YRD-SUB-LOC[CNT] == "S6-4")
                                    VHYT60IS-S6-4();
                                else
