function VHYT06IS-ADD-HIS()
    VHYT06E_CRIT.YRD-TRKG-YRD = VHYT06IW.YRD-TRKG-YRD;
    VHYT06E_CRIT.YRD-SUB-LOC = VHYT06IW.YRD-SUB-LOC;
    VHYT06E_CRIT.CAR-NO = VHYT06IW.CAR-NO;

    
    
    VHYT06E_CRIT.POSN-NO = VHYT06IW.POSN-NO;
    VHYT06E_DATA.MOVE-REASON-CD-PRV = VHYT06IW.MOVE-REASON-CD-PRV;
    VHYT06E_DATA.TERM-ID = VH01A01_DATA.TERM-ID;
    VHYT06E_DATA.USER-GROUP = VH01A01_DATA.USER-GROUP;
    try
        call "VHYT06E"(XDCONTROL, VHYT06E_CRIT, VHYT06E_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

function VHYT06IS-CHANGE()
    if(VHYT06IW.MOVE-REASON-CD == VHYT06B_DATA.MOVE-REASON-CD)
        FINAL-MESSAGE = "Reason not changed - Update is not  performed";
    else
        VHYT06IS-CHK-DB();
        if(RECORD-EXIST == "N")
            VHYT06IW-MSG.FINAL-MESSAGE = "Data base has changed - Reason not same.  Update is not processed.";
            DISABLE-UPDATE = "Y";
            ENABLE-CLEAR = "Y";
        else
            VHYT06IS-UPDATE();
            if(UPDATE-SW == "Y")
                FINAL-MSG-1 = "Reason code ";
                FINAL-MSG-2 = VHYT06B_DATA.MOVE-REASON-CD;
                FINAL-MSG-3 = " for car ";
                FINAL-MSG-4 = VHYT06IW.CAR-NO;
                FINAL-MSG-5 = " has been changed to  ";
                FINAL-MSG-6 = VHYT06IW.MOVE-REASON-CD;
                DISABLE-UPDATE = "Y";
                VHYT06IS-RELOAD();
            end
        end
    end
end 

function VHYT06IS-CHK-DB()
    VHYT06IW-MSG.FINAL-MESSAGE = " ";
    set VHYT06C_DATA empty;

    
    
    
    VHYT06C_CRIT.YRD-TRKG-YRD = VHYT06IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT06C_CRIT.YRD-SUB-LOC = VHYT06IW-PASSVALUE.YRD-SUB-LOC;
    VHYT06C_CRIT.CAR-NO = VHYT06IW-PASSVALUE.CAR-NO;
    VHYT06C_CRIT.MOVE-REASON-CD = VHYT06B_DATA.MOVE-REASON-CD;
    try
        call "VHYT06C"(XDCONTROL, VHYT06C_CRIT, VHYT06C_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        RECORD-EXIST = "Y";
    else
        if(XDCONTROL.URC == 100)
            RECORD-EXIST = "N";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT06IS-CLEAR()
    set VHYT06IW-CNT empty;
    VHYT06IW.MOVE-REASON = "  ";
    DISABLE-CLEAR = "Y";
    VHYT06IW-MSG.FINAL-MESSAGE = "Please select reason code to change. ";
end 

function VHYT06IS-GET-DATA()
    VHYT06IW-MSG.FINAL-MESSAGE = " ";

    
    set VHYT06B_DATA empty;
    VHYT06B_CRIT.YRD-TRKG-YRD = VHYT06IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT06B_CRIT.YRD-SUB-LOC = VHYT06IW-PASSVALUE.YRD-SUB-LOC;
    VHYT06B_CRIT.CAR-NO = VHYT06IW-PASSVALUE.CAR-NO;
    VHYT06B_CRIT.POSN-NO = VHYT06IW-PASSVALUE.POSN-NO;

    
    
    
    
    try
        call "VHYT06B"(XDCONTROL, VHYT06B_CRIT, VHYT06B_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT06IW.MOVE-REASON-CD-PRV = VHYT06B_DATA.MOVE-REASON-CD;
        VHYT06IW.MOVE-REASON-PREV = VHYT06IW.MOVE-REASON;
        VHYT06IW-TRIGGER.LOAD-CAR-DATA = "Y";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

function VHYT06IS-INIT()
    VHYT06IW-MSG.FINAL-MESSAGE = " ";
    VHYT06IW-CNT.ROW-CNT = 0;
    set VHYT06IW empty;
    set VHYT06A_DATA empty;
    DISABLE-UPDATE = "Y";
    DISABLE-CLEAR = "Y";
    try
        call "VHYT06A"(XDCONTROL, VHYT06A_CRIT, VHYT06A_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT06IW-CNT.ROW-CNT = XDCONTROL.UROWCNT;
        VHYT06IW-TRIGGER.LOAD-REASON = "Y";
        VHYT06IW.MOVE-REASON = VHYT06A_DATA.MOVE-REASON[1];
        VHYT06IS-GET-DATA();
    else
        if(XDCONTROL.URC == 100)
            VHYT06IW-MSG.FINAL-MESSAGE = "Check database - No reason code is found.";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT06IS-LOAD-DATA()
    VHYT06IW.CAR-NO = VHYT06B_DATA.CAR-NO;
    VHYT06IW.POSN-NO = VHYT06B_DATA.POSN-NO;
    VHYT06IW.VAGen_ORIENTATION = VHYT06B_DATA.VAGen_ORIENTATION;
    VHYT06IW.VEH-STAT = VHYT06B_DATA.VEH-STAT;
    VHYT06IW.YRD-TRKG-YRD = VHYT06B_DATA.YRD-TRKG-YRD;
    VHYT06IW.YRD-SUB-LOC = VHYT06B_DATA.YRD-SUB-LOC;
    VHYT06IW.MOVE-REASON-CD = VHYT06B_DATA.MOVE-REASON-CD;
    VHYT06IW.MOVE-REASON-DESC = VHYT06B_DATA.MOVE-REASON-DESC;
    VHYT06IW-TRIGGER.ENABLE-CLEAR = "Y";
end 

function VHYT06IS-RELOAD()
    set VHYT06B_DATA empty;
    VHYT06B_CRIT.YRD-TRKG-YRD = VHYT06IW.YRD-TRKG-YRD;
    VHYT06B_CRIT.YRD-SUB-LOC = VHYT06IW.YRD-SUB-LOC;
    VHYT06B_CRIT.CAR-NO = VHYT06IW.CAR-NO;
    VHYT06B_CRIT.POSN-NO = VHYT06IW.POSN-NO;

    
    
    
    
    try
        call "VHYT06B"(XDCONTROL, VHYT06B_CRIT, VHYT06B_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT06IW-TRIGGER.LOAD-CAR-DATA = "Y";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

function VHYT06IS-UPDATE()
    UPDATE-SW = "N";
    VHYT06D_CRIT.YRD-TRKG-YRD = VHYT06IW.YRD-TRKG-YRD;
    VHYT06D_CRIT.YRD-SUB-LOC = VHYT06IW.YRD-SUB-LOC;
    VHYT06D_CRIT.CAR-NO = VHYT06IW.CAR-NO;

    
    VHYT06D_DATA.TERM-LAST-UPD = VHYT06IW-PASSVALUE.TERM-LAST-UPD;
    VHYT06D_DATA.USER-GRP-UP-REASON = VHYT06IW-PASSVALUE.USER-GRP-UP-REASON;
    VHYT06D_DATA.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
    VHYT06D_DATA.USER-GRP-UP-REASON = VH01A01_DATA.USER-GROUP;
    VHYT06D_DATA.TERM-UPD-REASON = VH01A01_DATA.TERM-ID;
    VHYT06D_DATA.VEH-STAT = VHYT06IW.VEH-STAT;
    VHYT06D_DATA.VAGen_ORIENTATION = VHYT06IW.VAGen_ORIENTATION;
    VHYT06D_DATA.MOVE-REASON-CD = VHYT06IW.MOVE-REASON-CD;
    try
        call "VHYT06D"(XDCONTROL, VHYT06D_CRIT, VHYT06D_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        UPDATE-SW = "Y";
        VHYT06IS-ADD-HIS();
    else
        UPDATE-SW = "N";
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
end 

function VHYT06IS-VALID()
    if(VHYT06IW.MOVE-REASON-CD == VHYT06B_DATA.MOVE-REASON-CD ||
            VHYT06IW.MOVE-REASON == "  ")
        FINAL-MESSAGE = "Please select new reason code to change.";
        VHYT06IW-TRIGGER.DISABLE-UPDATE = "Y";
    else
        FINAL-MESSAGE = "Press UPDATE button to change the reason";
        VHYT06IW-TRIGGER.ENABLE-UPDATE = "Y";
        VHYT06IW-TRIGGER.ENABLE-CLEAR = "Y";
    end
end 

function VHYT07-PRINT()
    VHYT07IW-PASSVALUE.YRD-TRKG-YRD = "HY";
end 

