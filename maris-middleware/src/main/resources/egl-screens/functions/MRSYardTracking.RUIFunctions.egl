    if(VHYT04A-DATA.POSN-NO[CNT] == 1)
        VHYT10IW-ST-1.ORIENTATION-1 = VHYT04A-DATA.VAGen_ORIENTATION[CNT];
        VHYT10IW-ST-1.CAR-NO-1-CENTER = VHYT04A-DATA.CAR-NO[CNT];
    end
    if(VHYT04A-DATA.POSN-NO[CNT] == 2)
