function VHYT51IS-CLICK()
    VHYT51IW-MOVE.CLICKED = VHYT51IW-MOVE.CLICKED + 1;
    if(VHYT51IW-MOVE.CLICKED == 1)
        VHYT51IW-MOVE.FIRST-CLICK = VHYT51IW-PARM.TRACK-NO;
        VHYT51IW-PASSVALUE.FROM-CAR-POSN = VHYT51IW-PARM.POSN;
        VHYT51IW-PASSVALUE.TO-CAR-POSN = VHYT51IW-PARM.POSN;
        VHYT51IW-PASSVALUE.FROM-YRD-SUB-LOC = VHYT51IW-PARM.TRACK-NO;
    else
        if(VHYT51IW-MOVE.CLICKED == 2)
            VHYT51IW-MOVE.SECOND-CLICK = VHYT51IW-PARM.TRACK-NO;
            if(VHYT51IW-MOVE.FIRST-CLICK == VHYT51IW-MOVE.SECOND-CLICK)
                VHYT51IW-PASSVALUE.TO-CAR-POSN = VHYT51IW-PARM.POSN;
            end
        else
            if(VHYT51IW-MOVE.CLICKED == 3)
                VHYT51IW-MOVE.THIRD-CLICK = VHYT51IW-PARM.TRACK-NO;
                VHYT51IW-PASSVALUE.TO-YRD-SUB-LOC = VHYT51IW-PARM.TRACK-NO;
                VHYT51IW-TRIGGER.OPEN-DETAIL = "Y";
            end
        end
    end
end 

function VHYT51IS-CSTOR2()
    isleft boolean = strLib.indexOf("<O({vblm",
                    VHYT51A_DATA.VAGen_ORIENTATION[COUNTER]) > 0;
    aColor string = GiveAColor(VHYT51A_DATA.VEH-STAT[COUNTER],
                    VHYT51A_DATA.TRAIN_INCD_IND[COUNTER],
                    VHYT51A_DATA.HPMHRS[COUNTER]);
    if(VHYT51A_DATA.POSN-NO[COUNTER] < 11)
        if(VHYT51A_DATA.POSN-NO[COUNTER] == 1)
            VHYT51IW-CSTOR2.ORIENTATION-1 = VHYT51A_DATA.VAGen_ORIENTATION[COUNTER];
            VHYT51IW-CSTOR2.CAR-NO-1 = VHYT51A_DATA.CAR-NO[COUNTER];
            if(isleft)
                VHYT51IW-CSTOR2.BUTTON-1 = VHYT51A_DATA.VAGen_ORIENTATION[COUNTER] +
                        VHYT51A_DATA.CAR-NO[COUNTER];
            else
                VHYT51IW-CSTOR2.BUTTON-1 = VHYT51A_DATA.CAR-NO[COUNTER] +
                        VHYT51A_DATA.VAGen_ORIENTATION[COUNTER];
            end
            VHYT51IW-CSTOR2-STAT-COR.CAR-1-STAT-COLOR = strLib.clip(aColor, 2);
        else
