function VHYT08IS-NXT()
    VHYT08IS-CAR-COLOR();
    set VHYT08IW-1 empty;
    VHYT08IW-TRIGGER.PAGENO = VHYT08IW-TRIGGER.PAGENO + 1;
    VHYT08IS-LABEL();
    
    
    
    
    
    
    
    if(VHYT08IW-TRIGGER.PAGENO > 1)
        VHYT08IW-TRIGGER.ENABLE-PRV = "Y";
    else
        VHYT08IW-TRIGGER.DISABLE-PRV = "Y";
    end
    VHYT08IS-PRE-LOAD();
    if(VHYT08IW-TRIGGER.FINAL-COUNT > 29)
        VHYT08IW-TRIGGER.FINAL-COUNT = VHYT08IW-TRIGGER.FINAL-COUNT - 30;
        if(VHYT08IW-TRIGGER.FINAL-COUNT > 30)
            VHYT08IW-TRIGGER.ENABLE-NXT = "Y";
        else
            VHYT08IW-TRIGGER.DISABLE-NXT = "Y";
        end
    end
end 

function VHYT08IS-POS-1()
    VHYT08IW-MESSAGE.MESSAGE = " ";
    if(VHYT08IW-1.CAR-NO-1 != " ")
        if(VHYT08IW-COLOR.CAR-1-COLOR == "YELLOW")
            if(VHYT08IW-1.VEH-STAT-PREV-1 == "USABLE")
                VHYT08IW-COLOR.CAR-1-COLOR = "SKY BLUE";
                VHYT08IW-PASSVALUE.CLICK-COUNT = VHYT08IW-PASSVALUE.CLICK-COUNT -
                        1;
            else
                VHYT08IW-COLOR.CAR-1-COLOR = "GREY80";
                VHYT08IW-PASSVALUE.CLICK-COUNT = VHYT08IW-PASSVALUE.CLICK-COUNT -
                        1;
            end
        else
            VHYT08IW-COLOR.CAR-1-COLOR = "YELLOW";
            VHYT08IW-PASSVALUE.CLICK-COUNT = VHYT08IW-PASSVALUE.CLICK-COUNT +
                    1;
        end
    end
    if(VHYT08IW-PASSVALUE.CLICK-COUNT > 1)
        VHYT08IW-TRIGGER.DISABLE-CHANGE = "Y";
        VHYT08IW-TRIGGER.DISABLE-FIX = "Y";
    end
    if(VHYT08IW-PASSVALUE.CLICK-COUNT > 2)
        if(VHYT08IW-PASSVALUE.BUTTOM != "MOVECAR")
            VHYT08IW-MESSAGE.MESSAGE = "Too many cars selected, Please select only 1 car";
            VHYT08IW-TRIGGER.DISABLE-CHANGE = "Y";
            VHYT08IW-TRIGGER.DISABLE-FIX = "Y";
        else
            if(VHYT08IW-COLOR.CAR-1-COLOR == "YELLOW" &&
                    VHYT08IW-PASSVALUE.USER-OK == "Y")
                VHYT08IW-TRIGGER.ENABLE-CHANGE = "Y";
                VHYT08IW-TRIGGER.ENABLE-FIX = "Y";
                VHYT08IW-PASSVALUE.POSN-NO-Y = 1;
                VHYT08IW-PASSVALUE.POSN-NO-Y = VHYT08IW-3.LABEL-1-CENTER;
            end
        end
    else
        if(VHYT08IW-COLOR.CAR-1-COLOR == "YELLOW" &&
                VHYT08IW-PASSVALUE.USER-OK == "Y")
            VHYT08IW-TRIGGER.ENABLE-CHANGE = "Y";
            VHYT08IW-TRIGGER.ENABLE-FIX = "Y";
            VHYT08IW-PASSVALUE.CAR-NO-X = VHYT08IW-1.CAR-NO-1;
            VHYT08IW-PASSVALUE.POSN-NO-X = 1;
            VHYT08IW-PASSVALUE.POSN-NO-X = VHYT08IW-3.LABEL-1-CENTER;
        else
            VHYT08IW-TRIGGER.DISABLE-CHANGE = "Y";
            VHYT08IW-TRIGGER.DISABLE-FIX = "Y";
        end
    end
end 

