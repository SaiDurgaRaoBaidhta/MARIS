function VHYT10IS-TT()
    if(VHYT04A-DATA.POSN-NO[CNT] == 1)
        VHYT10IW-TT.ORIENTATION-1 = VHYT04A-DATA.VAGen_ORIENTATION[CNT];
        VHYT10IW-TT.CAR-NO-1-CENTER = VHYT04A-DATA.CAR-NO[CNT];
