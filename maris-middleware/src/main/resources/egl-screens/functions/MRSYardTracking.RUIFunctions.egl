function VHYT08IS-LOAD-T-95()






    COUNTERS = 1;
    while(VHYT08IW-TRIGGER.COUNTERS <= 30)
        if(VHYT08A_DATA.POSN-NO[START-COUNTER] == LABEL-1-CENTER)
            VHYT08IW-1.HOME-YRD-1 = VHYT08A_DATA.HOME-YRD[START-COUNTER];
            VHYT08IW-1.CON-1 = VHYT08A_DATA.CON-NO[START-COUNTER];
            VHYT08IW-PASSVALUE.VEH-CON-NO = VHYT08A_DATA.VEH-CON-NO[START-COUNTER];
            VHYT08IW-PASSVALUE.VEH-FILLER = "-";
            VHYT08IW-PASSVALUE.VEH-DASH-NO = VHYT08A_DATA.VEH-DASH-NO[START-COUNTER];
            if(VHYT08IW-PASSVALUE.VEH-CON-NO != " ")
                VHYT08IW-1.CON-1 = VHYT08IW-PASSVALUE.VEH-CON;
            end
            VHYT08IW-1.CAR-NO-1-CENTER = VHYT08A_DATA.CAR-NO[START-COUNTER];
            VHYT08IW-1.VEH-STAT-1 = VHYT08A_DATA.VEH-STAT[START-COUNTER];
            VHYT08IW-1.VEH-STAT-PREV-1 = VHYT08A_DATA.VEH-STAT-PREV[START-COUNTER];
            if(VHYT08A_DATA.TRAIN-INCD-IND[START-COUNTER] == "Y")
                VHYT08IW-1.VEH-STAT1-TI = "TI";
            else
                VHYT08IW-1.VEH-STAT1-TI = " ";
            end
            if(VHYT08IW-1.VEH-STAT-1 == "GO" || VHYT08IW-1.VEH-STAT-1 ==
                            "USABLE")
                VHYT11IW-STAT-COR.CAR-1-STAT-COLOR = "BLACK";
            else
                VHYT11IW-STAT-COR.CAR-1-STAT-COLOR = "red";
            end
            if(VHYT08IW-1.VEH-STAT-PREV-1 == "USABLE")
                VHYT08IW-COLOR.CAR-1-COLOR = "SKY BLUE";
            else
                VHYT08IW-COLOR.CAR-1-COLOR = "GREY80";
            end
            if(VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                    VHYT08IW-PASSVALUE.CAR-A-LEFT-ORIENTATION ||
                    VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                            VHYT08IW-PASSVALUE.CAR-C-LEFT-ORIENTATION ||
                    VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                            VHYT08IW-PASSVALUE.CAR-B-LEFT-ORIENTATION ||
                    VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                            VHYT08IW-PASSVALUE.CAR-D-LEFT-ORIENTATION ||
                    VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                            VHYT08IW-PASSVALUE.CAR-E-LEFT-ORIENTATION ||
                    VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                            VHYT08IW-PASSVALUE.CAR-L-LEFT-ORIENTATION ||
                    VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                            VHYT08IW-PASSVALUE.CAR-M-LEFT-ORIENTATION ||
                    VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                            VHYT08IW-PASSVALUE.CAR-K-LEFT-ORIENTATION)

                VHYT08IW-1.CAR-NO-1-LEFT = VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER];
            else
                if(VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                        VHYT08IW-PASSVALUE.CAR-A-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-C-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-B-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-D-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-E-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-L-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-M-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-K-RIGHT-ORIENTATION)
                    VHYT08IW-1.CAR-NO-1-RIGHT = VHYT08A_DATA.VAGen_ORIENTATION[START-COUNTER];
                end
            end
        end
        if(VHYT08A_DATA.POSN-NO[START-COUNTER] == LABEL-2-CENTER)
            VHYT08IW-1.HOME-YRD-2 = VHYT08A_DATA.HOME-YRD[START-COUNTER];
