function VHYT41IS-LOAD()
    move VHYT40A_DATA.DATA_ROW to VHYT41A_DATA.DATA_ROW[1] for all;
    COUNTER = 1;
    while(VHYT41IW-PASSVALUE.COUNTER <= XDCONTROL.UROWCNT)
        if(VHYT41A_DATA.YRD-SUB-LOC[COUNTER] == "L1")
            VHYT41IS-L1();
        end
        if(VHYT41A_DATA.YRD-SUB-LOC[COUNTER] == "L2")
            VHYT41IS-L2();
        end
        if(VHYT41A_DATA.YRD-SUB-LOC[COUNTER] == "LTM1")
            VHYT41IS-LTM1();
        end
        if(VHYT41A_DATA.YRD-SUB-LOC[COUNTER] == "LTM2")
            VHYT41IS-LTM2();
        end
        if(VHYT41A_DATA.YRD-SUB-LOC[COUNTER] == "LB1")
            VHYT41IS-LB1();
        end
        if(VHYT41A_DATA.YRD-SUB-LOC[COUNTER] == "LB2")
            VHYT41IS-LB2();
        end
        if(VHYT41A_DATA.YRD-SUB-LOC[COUNTER] == "LSTOR1")
            VHYT41IS-LSTOR1();
        end
        if(VHYT41A_DATA.YRD-SUB-LOC[COUNTER] == "LSTOR2")
            VHYT41IS-LSTOR2();
        end
        COUNTER = COUNTER + 1;
    end
end 

