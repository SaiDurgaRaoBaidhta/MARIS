        VHYT24IS-SUBMIT-X();
    end
    if(VHYT24IW-PASSVALUE.YRD-TRKG-YRD == "DPX")
        VHYT24IS-SUB-DPX();
    end
    if(VHYT24IW-PASSVALUE.YRD-TRKG-YRD == "PBX")
        VHYT24IS-SUB-PBX();
    end
    if(VHYT24IW-PASSVALUE.YRD-TRKG-YRD == "CY")
        VHYT24IS-SUB-CY();
    end
    if(VHYT24IW-PASSVALUE.YRD-TRKG-YRD == "RY")
        VHYT24IS-SUB-RY();
    end
    if(VHYT24IW-PASSVALUE.YRD-TRKG-YRD == "DY")
        VHYT24IS-SUB-DY();
    end
    if(VHYT24IW-PASSVALUE.YRD-TRKG-YRD == "MBX")
        VHYT24IS-SUB-MBX();
    end
    if(VHYT24IW-PASSVALUE.YRD-TRKG-YRD == "SVB") 
        VHYT24IS-SUB-SVB();
    end
    if(VHYT24IW-PASSVALUE.YRD-TRKG-YRD == "SW")
        VHYT24IS-SUB-SW();
    end
end 



