function VHYT09IS-PAGE-CNT()
    VHYT09IW-CNT.TOT-PAGE-CNT = 0;
    VHYT09IW-CNT.TOT-PAGE-CNT = VHYT09IW-CNT.CON-ROW-CNT / 4.00;
    if(VHYT09IW-CNT.REMAINDER == 0)

    else
        VHYT09IW-CNT.TOT-PAGE = VHYT09IW-CNT.TOT-PAGE + 1;
    end
    if(VHYT09IW-CNT.TOT-PAGE == 1)
        DISABLE-NXT-PAGE = "Y";
        DISABLE-PRV-PAGE = "Y";
    else
        ENABLE-NXT-PAGE = "Y";
        DISABLE-PRV-PAGE = "Y";
    end
end 

function VHYT09IS-PAGE-DOWN()
    if(PAGE-CNT < TOT-PAGE)
        PAGE-CNT = PAGE-CNT + 1;
        if(PAGE-CNT == TOT-PAGE)
            DISABLE-NXT-PAGE = "Y";
        else
            ENABLE-NXT-PAGE = "Y";
        end
        ENABLE-PRV-PAGE = "Y";
    end
    VHYT09IS-LOAD-PAGE();
end 

function VHYT09IS-PAGE-UP()
    if(PAGE-CNT > 1)
        PAGE-CNT = PAGE-CNT - 1;
        if(PAGE-CNT == 1)
            DISABLE-PRV-PAGE = "Y";
        else
            ENABLE-PRV-PAGE = "Y";
        end
        ENABLE-NXT-PAGE = "Y";
    end
    VHYT09IS-LOAD-PAGE();
end 

function VHYT09IS-PRINT()

end 

function VHYT10I-SHOPM()
    VHMVSIW-EXIT.TITLE-NAME = "YT";
end 



