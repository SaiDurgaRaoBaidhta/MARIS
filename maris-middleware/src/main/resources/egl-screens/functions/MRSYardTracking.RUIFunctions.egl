function VHYT08IS-FIX()
    if(VHYT08IW-COLOR.CAR-1-COLOR == "YELLOW")
        VHYT08IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-1-CENTER;
        
        VHYT08IW-PASSVALUE.FROM-POSITION = LABEL-1-CENTER;
    end
    if(VHYT08IW-COLOR.CAR-2-COLOR == "YELLOW")
        VHYT08IW-PASSVALUE.FROM-CAR = VHYT08IW-1.CAR-NO-2-CENTER;
        VHYT08IW-PASSVALUE.FROM-POSITION = LABEL-2-CENTER;
