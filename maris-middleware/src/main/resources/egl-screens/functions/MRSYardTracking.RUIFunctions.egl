function VHYT24IS-SUB-DPX()















    set VHYT24A_CRIT empty;

    
    
    VHYT02E_CRIT.YRD-TRKG-YRD = VHYT24IW-PASSVALUE.YRD-TRKG-YRD;
    VHYT02E_CRIT.REPT-TYPE = VHDVS4IW-PASSVALUE.VTAM-NAME;
    

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT01I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT24A";

    
    try
        call "VHYT02E"(XDCONTROL, VHYT02E_CRIT, VHYT02E_DATA);

