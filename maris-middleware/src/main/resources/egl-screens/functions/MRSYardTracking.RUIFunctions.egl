function VHYTM6IS-CLEAR()
    set VH001IW-MESSAGE empty;
end 

function VHYTM6IS-INIT-Y()
    set VH001IW-MESSAGE empty;
    VH01A02_CRIT.USER-GRP = VH01A01_DATA.USER-GROUP;
    VH01A02_CRIT.GUI-NAME = "VHYTM6";
    
    
    
    
    
    
    
    
    
    
    
    

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VH001I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VH01A02";
    try
        call "VH01A02"(XDCONTROL, VH01A02_CRIT, VH01A02_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        else

            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

function VYT05IS-CLK-R92()
    if(VHYT05IW-TRIGGER.CLICK-ONE == " ")
        VHYT05IW-TRIGGER.CLICK-ONE = "Y";
        
        VHYT05IW-PASSVALUE.CLICK-R92 = "Y";
        
        VHYT05IW-PASSVALUE.FROM-CAR-POSITION = VHYT05IW-PARM.VAGen_POSITION;
        VHYT05IW-PASSVALUE.FROM-YRD-TRKG-YRD = "R92";

    
    else
        if(VHYT05IW-TRIGGER.CLICK-TWO == " ")
            VHYT05IW-TRIGGER.CLICK-TWO = "Y";
            if(VHYT05IW-PASSVALUE.CLICK-R92 == " ")
                VHYT05IW-PASSVALUE.CLICK-R92 = "Y";
            else
                
                VHYT05IW-PASSVALUE.TO-CAR-POSITION = VHYT05IW-PARM.VAGen_POSITION;
            end
        else
            if(VHYT05IW-TRIGGER.CLICK-THREE == " ")
                VHYT05IW-TRIGGER.CLICK-THREE = "Y";
                if(VHYT05IW-PASSVALUE.CLICK-R92 == " ")
                    VHYT05IW-PASSVALUE.TO-YRD-TRKG-YRD = "R92";
                    VHYT05IW-TRIGGER.OPEN-DETAIL = "Y";
                else
                    VHYT05IW-PASSVALUE.TO-YRD-TRKG-YRD = "R92";
                    VHYT05IW-TRIGGER.OPEN-DETAIL = "Y";
                    VHYT05IW-PASSVALUE.CLICK-R92 = " ";
                    VHYT05IW-TRIGGER.CLICK-ONE = " ";
                    VHYT05IW-TRIGGER.CLICK-TWO = " ";
                    VHYT05IW-TRIGGER.CLICK-THREE = " ";
                end
            end
        end
    end
end 

function VYT08IS-SV06-15()
