            else
                VHYT08IW-1.VEH-STAT1-TI = " ";
            end
            if(VHYT08IW-1.VEH-STAT-1 == "GO" || VHYT08IW-1.VEH-STAT-1 ==
                            "USABLE")
                VHYT11IW-STAT-COR.CAR-1-STAT-COLOR = "BLACK";
            else
                VHYT11IW-STAT-COR.CAR-1-STAT-COLOR = "red";
            end
            if(VHYT08IW-1.VEH-STAT-PREV-1 == "USABLE")
                VHYT11IW-COLOR.CAR-1-COLOR = "SKY BLUE";
            else
                VHYT11IW-COLOR.CAR-1-COLOR = "GREY80";
