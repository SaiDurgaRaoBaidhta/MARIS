function VHYT04IS-CLK-TT()
    if(VHYT04IW-TRIGGER.CLICK-ONE == " ")
        VHYT04IW-TRIGGER.CLICK-ONE = "Y";
        VHYT04IW-PASSVALUE.CLICK-TT = "Y";
        VHYT04IW-PASSVALUE.FROM-CAR-POSITION = VHYT04IW-PARM.VAGen_POSITION;
        VHYT04IW-PASSVALUE.FROM-YRD-TRKG-YRD = "TT";
    else
        if(VHYT04IW-TRIGGER.CLICK-TWO == " ")
            VHYT04IW-TRIGGER.CLICK-TWO = "Y";
            if(VHYT04IW-PASSVALUE.CLICK-TT == " ")
                VHYT04IW-PASSVALUE.CLICK-TT = "Y";
            else
                VHYT04IW-PASSVALUE.TO-CAR-POSITION = VHYT04IW-PARM.VAGen_POSITION;
            end
        else
            if(VHYT04IW-TRIGGER.CLICK-THREE == " ")
                VHYT04IW-TRIGGER.CLICK-THREE = "Y";
                if(VHYT04IW-PASSVALUE.CLICK-TT == " ")
                    VHYT04IW-PASSVALUE.TO-YRD-TRKG-YRD = "TT";
                    VHYT04IW-TRIGGER.OPEN-DETAIL = "Y";
                else
                    VHYT04IW-PASSVALUE.TO-YRD-TRKG-YRD = "TT";
                    VHYT04IW-TRIGGER.OPEN-DETAIL = "Y";
                    VHYT04IW-PASSVALUE.CLICK-TT = " ";
                    VHYT04IW-TRIGGER.CLICK-ONE = " ";
                    VHYT04IW-TRIGGER.CLICK-TWO = " ";
                    VHYT04IW-TRIGGER.CLICK-THREE = " ";
                end
            end
        end
    end
end 

