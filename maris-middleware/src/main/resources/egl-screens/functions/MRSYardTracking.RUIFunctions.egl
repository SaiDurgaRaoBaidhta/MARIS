function VHYT10IS-INIT()
    VHMVSIW-EXIT.TITLE-NAME = " ";
    VHYT10IS-CLEAR();
    VHYT10IW-PASSVALUE.WHICH-GUI = "VHYT03I";
    VHYT10IW-PASSVALUE.WHICH-GUI-FROM = "VHYT10I";
    VHYT10IW-PASSVALUE.YRD-TRKG-YRD = "HY";
    
    
    
    
    
    
    
    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT10I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT08C";

    
    try
        call "VHYT08C"(XDCONTROL, VHYT08C_CRIT, VHYT08C_DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT10IW-PASSVALUE.CAR-TYPE-COUNTER = XDCONTROL.UROWCNT;
            VHYT10IS-CAR-TYPE();
            VHYT10IS-INIT-S();
        else
            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT10IS-INIT-S()








    XXEXT_CALL_Level77Items.UEXTNAM = "VHYT04I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYT04A";

    
    try
        call "VHYT04A"(XDCONTROL, VHYT04A-CRIT, VHYT04A-DATA);

    end

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if(XXEXT_CALL_Level77Items.URC == 0)
        if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)
            VHYT10IS-LOAD();
        else
            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

function VHYT10IS-LOAD()
    CNT = 1;
    while(VHYT10IW.CNT <= XDCONTROL.UROWCNT)
        VHYT04A-DATA.FCOLOR[CNT] = dy100Color(VHYT04A-DATA.HOME-YRD[CNT]);

        if(strLib.characterLen(VHYT04A-DATA.SOFTVER[CNT]) > 1)
            if(VHYT04A-DATA.VAGen_ORIENTATION[CNT] ==
                    VHYT04A-DATA.LFT-ORIENTATION-CD[CNT])
                VHYT04A-DATA.BUTTONTXT[CNT] = "$" +
                        VHYT04A-DATA.VAGen_ORIENTATION[CNT] +
                        VHYT04A-DATA.CAR-NO[CNT];
            else
                VHYT04A-DATA.BUTTONTXT[CNT] = "$" + VHYT04A-DATA.CAR-NO[CNT] +
                        VHYT04A-DATA.VAGen_ORIENTATION[CNT];
            end
        else
            if(VHYT04A-DATA.VAGen_ORIENTATION[CNT] ==
                    VHYT04A-DATA.LFT-ORIENTATION-CD[CNT])
                VHYT04A-DATA.BUTTONTXT[CNT] = VHYT04A-DATA.VAGen_ORIENTATION[CNT] +
                        VHYT04A-DATA.CAR-NO[CNT];
