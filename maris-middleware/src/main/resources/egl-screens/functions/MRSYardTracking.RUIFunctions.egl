            VHYT51IW-CTM2-STAT-COR.CAR-2-STAT-COLOR = strLib.clip(aColor, 2);
        else
            if(VHYT51A_DATA.POSN-NO[COUNTER] == 3)
                VHYT51IW-CTM2.ORIENTATION-3 = VHYT51A_DATA.VAGen_ORIENTATION[COUNTER];
                VHYT51IW-CTM2.CAR-NO-3 = VHYT51A_DATA.CAR-NO[COUNTER];
