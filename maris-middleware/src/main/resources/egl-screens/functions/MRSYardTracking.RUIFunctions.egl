        VHYT60IW-RR01.COLOR-01 = VHYT60A-DATA.FCOLOR[CNT];
    else
        if(VHYT60A-DATA.POSN-NO[CNT] == 2)
            if(VHYT60A-DATA.VAGen_ORIENTATION[CNT] ==
                    VHYT60A-DATA.LFT-ORIENTATION-CD[CNT])
                VHYT60IW-RR01.LFT-OR-2 = VHYT60A-DATA.VAGen_ORIENTATION[CNT];
            else
