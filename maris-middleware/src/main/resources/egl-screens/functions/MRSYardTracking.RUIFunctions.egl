                            VHYT08IW-PASSVALUE.CAR-L-LEFT-ORIENTATION ||
                    VHYT08A_DATA.VAGen_ORIENTATION[COUNTER] ==
                            VHYT08IW-PASSVALUE.CAR-M-LEFT-ORIENTATION ||
                    VHYT08A_DATA.VAGen_ORIENTATION[COUNTER] ==
                            VHYT08IW-PASSVALUE.CAR-K-LEFT-ORIENTATION)

                VHYT08IW-1.CAR-NO-30-LEFT = VHYT08A_DATA.VAGen_ORIENTATION[COUNTER];
            else
                if(VHYT08A_DATA.VAGen_ORIENTATION[COUNTER] ==
                        VHYT08IW-PASSVALUE.CAR-A-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-C-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-B-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-D-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-E-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-L-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-M-RIGHT-ORIENTATION ||
                        VHYT08A_DATA.VAGen_ORIENTATION[COUNTER] ==
                                VHYT08IW-PASSVALUE.CAR-K-RIGHT-ORIENTATION)
                    VHYT08IW-1.CAR-NO-30-RIGHT = VHYT08A_DATA.VAGen_ORIENTATION[COUNTER];
                end
            end
        end
        COUNTER = COUNTER + 1;
    end
    VHYT08IS-ABLE();
end 

