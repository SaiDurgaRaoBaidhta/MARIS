function VHYT09IS-GET-CARS()
    set VHYT09C_DATA empty;

    
    
    
    
    
    VHYT09C_CRIT.FR-YRD-TRKG-YRD = VHYT09B_CRIT.FR-YRD-TRKG-YRD;
    VHYT09C_CRIT.TO-YRD-TRKG-YRD = VHYT09B_CRIT.TO-YRD-TRKG-YRD;
    try
        call "VHYT09C"(XDCONTROL, VHYT09C_CRIT, VHYT09C_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

    else
        if(XDCONTROL.URC == 100)
            VHYT09IW-MSG.FINAL-MSG-1 = VHYT09C_CRIT.FR-YRD-TRKG-YRD;
            VHYT09IW-MSG.FINAL-MSG-2 = " Yard has no consist";
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT09IS-GET-DATA()
    set VHYT09B_DATA empty;
    set VHYT09IW-MSG empty;
    VHYT09IW-TRIGGER.DATA-MOVED = "N";

    
    
    
    
    
    
    
    
    
    
    
    
    
    
    if(VHYT09IW-PASSVALUE.YRD-TRKG-YRD == "  ")
        if(VHYT09IW.YRD-TRKG-YRD == "ALL")
            VHYT09B_CRIT.FR-YRD-TRKG-YRD = "AAA";
            VHYT09B_CRIT.TO-YRD-TRKG-YRD = "ZZZ";
        else
            VHYT09B_CRIT.FR-YRD-TRKG-YRD = VHYT09IW.YRD-TRKG-YRD;
            VHYT09B_CRIT.TO-YRD-TRKG-YRD = VHYT09IW.YRD-TRKG-YRD;
        end
    else
        VHYT09B_CRIT.FR-YRD-TRKG-YRD = VHYT09IW-PASSVALUE.YRD-TRKG-YRD;
        VHYT09B_CRIT.TO-YRD-TRKG-YRD = VHYT09IW-PASSVALUE.YRD-TRKG-YRD;
    end
    try
        call "VHYT09B"(XDCONTROL, VHYT09B_CRIT, VHYT09B_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT09IW-CNT.CON-ROW-CNT = XDCONTROL.UROWCNT;
        VHYT09IS-GET-CARS();
        VHYT09IS-MOVE-DATA();
        if(VHYT09IW-TRIGGER.DATA-MOVED == "Y")
            VHYT09IS-PAGE-CNT();
            VHYT09IW-CNT.PAGE-CNT = 1;
            VHYT09IS-LOAD-PAGE();
            VHYT09IW-MSG.FINAL-MSG-1 = VHYT09IW.YRD-TRKG-YRD;
            VHYT09IW-MSG.FINAL-MSG-2 = " Yard is selected.";
            DISABLE-LIST = "Y";
            ENABLE-PRINT = "Y";
            ENABLE-CLEAR = "Y";
        end
    else
        if(XDCONTROL.URC == 100)
            VHYT09IW-MSG.FINAL-MSG-1 = VHYT09B_CRIT.FR-YRD-TRKG-YRD;
            VHYT09IW-MSG.FINAL-MSG-2 = " Yard has no consist";
            DISABLE-LIST = "Y";
            DISABLE-PRINT = "Y";
            DISABLE-CLEAR = "Y";
            DISABLE-PRV-PAGE = "Y";
            DISABLE-NXT-PAGE = "Y";
            set VHYT09IW-CNT empty;
            set VHYT09IW-CON-1 empty;
            set VHYT09IW-CON-2 empty;
            set VHYT09IW-CON-3 empty;
            set VHYT09IW-CON-4 empty;
        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            return;
        end
    end
end 

function VHYT09IS-INIT()
    VHYT09IW-MSG.FINAL-MESSAGE = " ";
    set VHYT09IW empty;
    set VHYT09IW-CNT empty;
    set VHYT09IW-CON-1 empty;
    set VHYT09IW-CON-2 empty;
    set VHYT09IW-CON-3 empty;
    set VHYT09IW-CON-4 empty;
    set VHYT09A_DATA empty;
    DISABLE-PRINT = "Y";
    DISABLE-CLEAR = "Y";
    DISABLE-PRV-PAGE = "Y";
    DISABLE-NXT-PAGE = "Y";
    try
        call "VHYT09A"(XDCONTROL, VHYT09A_CRIT, VHYT09A_DATA);

    end
    if(XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHYT09IW-CNT.HY-ROW-CNT = XDCONTROL.UROWCNT + 1;
        VHYT09A_DATA.YRD[HY-ROW-CNT] = "ALL";
        VHYT09IW-TRIGGER.LOAD-YARD-DATA = "Y";
        if(VHYT09IW-PASSVALUE.YRD-TRKG-YRD != "  ")
            VHYT09IW.YRD-TRKG-YRD = VHYT09IW-PASSVALUE.YRD-TRKG-YRD;
        else
            VHYT09IW.YRD-TRKG-YRD = VHYT09A_DATA.YRD[1];
        end
        VHYT09IW-MSG.FINAL-MESSAGE = "Please select the Yard you want to display. ";
    else
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        return;
    end
    if(VHYT09IW-PASSVALUE.YRD-TRKG-YRD != "  ")
        VHYT09IW.YRD-TRKG-YRD = VHYT09IW-PASSVALUE.YRD-TRKG-YRD;
        VHYT09IW-PASSVALUE.YRD-TRKG-YRD = "  ";
        VHYT09IW-TRIGGER.GET-DATA = "Y";
    end
end 

function VHYT09IS-LOAD-PAGE()
    set VHYT09IW-CON-1 empty;
    set VHYT09IW-CON-2 empty;
    set VHYT09IW-CON-3 empty;
    set VHYT09IW-CON-4 empty;
    X =((PAGE-CNT - 1) * 4) + 1;
    
    VHYT09IW-CON-1.DATE-LAST-UPD = VHYT09B_DATA.DATE-LAST-UPD[X];
