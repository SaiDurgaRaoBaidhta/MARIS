Function MRS02IS-CHECK_ID ()
  
  
  
  
  
  
  
  
  
  


     
    XXEXT_CALL_Level77Items.UEXTNAM = "MRS02I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "MRS02A";

    
    try
        call "MRS02A"(XDCONTROL, MRS02A_CRIT, MRS02A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (MRS02A_DATA.USER_GRP_EXISTS == "Y")
                if (MRS02A_DATA.SIGNON_IS_VALID == "Y")

          
                    WS00IW_Level77Items.SIGNON_GOOD = "Y";
                    if (MRS02A_DATA.MENU_GUI_NAME == "AFC01")
                        MRS02IW-TRIGGER.RUN-AFC01I = "Y";
                    end
                    if (MRS02A_DATA.MENU_GUI_NAME == "WS01")
                        MRS02IW-TRIGGER.RUN-WS01I = "Y";
                    end
                    if (MRS02A_DATA.MENU_GUI_NAME == "MRS00")
                        MRS02IW-TRIGGER.RUN-MRS00I = "Y";
                    end
                    
          
          
          
                else

          
                    WS00IW_Level77Items.SIGNON_FAILED = "Y";
                    XXMESSAGE.UMSGCODE = "WS00I002";
                    XXMESSAGE.UMSGINS[1] = MRS02A_CRIT.USER_GRP;
                end
            else

        
                WS00IW_Level77Items.SIGNON_INVALID = "Y";
                XXMESSAGE.UMSGCODE = "WS00I003";
                XXMESSAGE.UMSGINS[1] = MRS02A_CRIT.USER_GRP;
            end
        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end
