

package MRSMainMenu;
 

Function MRS00IS-CHK_ACCESS () 
    set XXREQUEST empty;

  

  
    if ("hsAfcmenu" in AFCX6A_DATA.PART-NAME)
        if (AFCX6A_DATA.ACCESS-ALLOWED[sysVar.arrayIndex] == "N")
  
            MRS00IW-TRIGGERS.DIS-AFCMENU = "Y";
        else
  
            MRS00IW-TRIGGERS.EN-AFCMENU = "Y";
        end
    end

  
    if ("hsWaysidemenu" in AFCX6A_DATA.PART-NAME)
        if (AFCX6A_DATA.ACCESS-ALLOWED[sysVar.arrayIndex] == "N")
  
            MRS00IW-TRIGGERS.DIS-WAYSIDE = "Y";
        else
  
            MRS00IW-TRIGGERS.EN-WAYSIDE = "Y";
        end
    end

  
    if ("hsDbmaint" in AFCX6A_DATA.PART-NAME)
        if (AFCX6A_DATA.ACCESS-ALLOWED[sysVar.arrayIndex] == "N")
  
            MRS00IW-TRIGGERS.DIS-DBMAINT = "Y";
        else
  
            MRS00IW-TRIGGERS.EN-DBMAINT = "Y";
        end
    end
    if ("hsVhshop" in AFCX6A_DATA.PART-NAME)
