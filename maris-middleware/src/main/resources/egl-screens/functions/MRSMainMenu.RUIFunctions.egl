            MRS00IW-TRIGGERS.DIS-VHSHOP = "Y";
        else
            MRS00IW-TRIGGERS.EN-VHSHOP = "Y";
        end
    end

  
    if ("hsTdesk" in AFCX6A_DATA.PART-NAME)
        if (AFCX6A_DATA.ACCESS-ALLOWED[sysVar.arrayIndex] == "N")
            MRS00IW-TRIGGERS.DIS-VEH-TROUBLE = "Y";
        else
            MRS00IW-TRIGGERS.EN-VEH-TROUBLE = "Y";
        end
    end
  
    if ("hsVsuper" in AFCX6A_DATA.PART-NAME)
        if (AFCX6A_DATA.ACCESS-ALLOWED[sysVar.arrayIndex] == "N")
            MRS00IW-TRIGGERS.DIS-VEH-TROUBLE = "Y";
        else
            MRS00IW-TRIGGERS.EN-VEH-TROUBLE = "Y";
        end
    end


  
    if ("hsTower" in AFCX6A_DATA.PART-NAME)
        if (AFCX6A_DATA.ACCESS-ALLOWED[sysVar.arrayIndex] == "N")
            MRS00IW-TRIGGERS.DIS-TOWER = "Y";
        else
            MRS00IW-TRIGGERS.EN-TOWER = "Y";
        end
    end
  
    if ("hsCentral" in AFCX6A_DATA.PART-NAME)
        if (AFCX6A_DATA.ACCESS-ALLOWED[sysVar.arrayIndex] == "N")
            MRS00IW-TRIGGERS.DIS-TOWER = "Y";
        else
            MRS00IW-TRIGGERS.EN-TOWER = "Y";
        end
    end
  
    if ("hsTmgt" in AFCX6A_DATA.PART-NAME)
        if (AFCX6A_DATA.ACCESS-ALLOWED[sysVar.arrayIndex] == "N")
            MRS00IW-TRIGGERS.DIS-TOWER = "Y";
        else
            MRS00IW-TRIGGERS.EN-TOWER = "Y";
        end
    end
  
    if ("hsVme" in AFCX6A_DATA.PART-NAME)
        if (AFCX6A_DATA.ACCESS-ALLOWED[sysVar.arrayIndex] == "N")
            MRS00IW-TRIGGERS.DIS-VME = "Y";
        else
            MRS00IW-TRIGGERS.EN-VME = "Y";
        end
    end
    if ("pbtChangeIncident" in AFCX6A_DATA.PART-NAME)
        if (AFCX6A_DATA.ACCESS-ALLOWED[sysVar.arrayIndex] == "N")
            MRS00I-PASSVALUE.DIS-CI = "Y";
        else
            MRS00I-PASSVALUE.EN-CI = "Y";
        end
    end
    if ("pbtPmSchedule" in AFCX6A_DATA.PART-NAME)
