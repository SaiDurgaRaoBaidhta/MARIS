        else
            MRS00I-PASSVALUE.EN-PM = "Y";
        end
    end
    if ("pbtChangeYard" in AFCX6A_DATA.PART-NAME)
        if (AFCX6A_DATA.ACCESS-ALLOWED[sysVar.arrayIndex] == "N")
            MRS00I-PASSVALUE.DIS-CY = "Y";
        else
            MRS00I-PASSVALUE.EN-CY = "Y";
        end
    end
end 

