            call "VHCCS5N"(XDCONTROL, VHCCS5N_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
            VHCCS05A_ADDUPDT.DATE-MSG-CMPLT = "          ";
            
  
  
  
  
  
        end
        
  
    else

    end
    if (VHCCS05A_ADDUPDT.DATE-INSRV-REV != " ")
   
        VHCCS5N_DATA.DATE-MAINT-UPD = VHCCS05A_ADDUPDT.DATE-INSRV-REV;
        VHCCS5N_CRIT.MARIS-SUBSYS = "BMTEST1";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS5N";
        try
            call "VHCCS5N"(XDCONTROL, VHCCS5N_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
            VHCCS05A_ADDUPDT.DATE-INSRV-REV = "          ";
            
  
  
  
  
  
        end
        
  
    else

    end
    if (VHCCS05A_ADDUPDT.TIME-CREATE != " ")
        VHCCS5M_DATA.TIME-MAINT-UPD = VHCCS05A_ADDUPDT.TIME-CREATE;
        VHCCS5M_CRIT.MARIS-SUBSYS = "BMTEST1";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS5M";
        try
            call "VHCCS5M"(XDCONTROL, VHCCS5M_CRIT, VHCCS5M_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
            VHCCS05A_ADDUPDT.TIME-CREATE = "        ";
        end
    else

    end
    if (VHCCS05A_ADDUPDT.TIME-ICS-CREATE != " ")
        VHCCS5M_DATA.TIME-MAINT-UPD = VHCCS05A_ADDUPDT.TIME-ICS-CREATE;
        VHCCS5M_CRIT.MARIS-SUBSYS = "BMTEST1";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS5M";
        try
            call "VHCCS5M"(XDCONTROL, VHCCS5M_CRIT, VHCCS5M_DATA);
        
        end
