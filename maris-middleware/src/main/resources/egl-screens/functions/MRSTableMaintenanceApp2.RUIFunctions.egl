            VHCCS05A-CARS.D-CAR-8 = VHCCS05A_SELECTION.I-CAR-8;
            VHCCS05A-CARS.D-CAR-9 = VHCCS05A_SELECTION.I-CAR-9;
            VHCCS05A-CARS.D-CAR-10 = VHCCS05A_SELECTION.I-CAR-10;
        end
