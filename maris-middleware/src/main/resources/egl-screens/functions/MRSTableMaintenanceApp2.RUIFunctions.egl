Function VHCCS18I_SELECTION () 
    STOR-INDEX-P = 1;
    STOR-SELECTION-P = 0;
    VHCCSHF_CRIT.PROC-INDEX = VHCCS4IW_CRIT.MSG-PROCESSED-CD;
    while (STOR-INDEX-P <= VHCCSHF_CRIT.COUNTER)
        if (VHCCS4IW_CRIT.MSG-PROCESSED-CD ==
         VHCCSHF_DATA.MSG-PROCESSED-CD[STOR-INDEX-P])
            VHCCS4IW_CRIT_Level77Items.STOR-SELECTION-P = STOR-INDEX-P;
        end
        STOR-INDEX-P = STOR-INDEX-P + 1;
    end
    STOR-INDEX-Y = 1;
    STOR-SELECTION-Y = 0;
    VHCCSHC_CRIT.YRD-INDEX = VHCCS4IW_CRIT.CON-CURR-YRD;
    while (STOR-INDEX-Y <= VHCCSHC_CRIT.COUNTER)
        if (VHCCS4IW_CRIT.CON-CURR-YRD ==
         VHCCSHC_DATA.YRD[STOR-INDEX-Y])
            VHCCS4IW_CRIT_Level77Items.STOR-SELECTION-Y = STOR-INDEX-Y;
        end
        STOR-INDEX-Y = STOR-INDEX-Y + 1;
    end
    STOR-INDEX-C = 1;
    STOR-SELECTION-C = 0;
    VHCCSHD_CRIT.LOC-INDEX = VHCCS4IW_CRIT.CON-CURR-LOC;
    while (STOR-INDEX-C <= VHCCSHD_CRIT.COUNTER)
        if (VHCCS4IW_CRIT.CON-CURR-LOC ==
         VHCCSHD_DATA.LOC[STOR-INDEX-C])
            VHCCS4IW_CRIT_Level77Items.STOR-SELECTION-C = STOR-INDEX-C;
        end
        STOR-INDEX-C = STOR-INDEX-C + 1;
    end
    STOR-INDEX-S = 1;
    STOR-SELECTION-S = 0;
    VHCCSHE_CRIT.SCAN-INDEX = VHCCS4IW_CRIT.SCAN-ID;
    while (STOR-INDEX-S <= VHCCSHE_CRIT.COUNTER)
        if (VHCCS4IW_CRIT.SCAN-ID ==
         VHCCSHE_DATA.SCAN-ID[STOR-INDEX-S])
            VHCCS4IW_CRIT_Level77Items.STOR-SELECTION-S = STOR-INDEX-S;
        end
        STOR-INDEX-S = STOR-INDEX-S + 1;
    end
    STOR-INDEX-T = 1;
    STOR-SELECTION-M = 0;
    VHCCSHB_CRIT.TRAN-CD = VHCCS4IW_CRIT.MSG-TRAN-CD;
    while (STOR-INDEX-T <= VHCCSHB_CRIT.COUNTER)
        if (VHCCS4IW_CRIT.MSG-TRAN-CD ==
         VHCCSHB_DATA.TRAN-CD[STOR-INDEX-T])
            VHCCS4IW_CRIT_Level77Items.STOR-SELECTION-M = STOR-INDEX-T;
        end
        STOR-INDEX-T = STOR-INDEX-T + 1;
    end
end 

Function VHCCS18S-HARD-COPY () 
    if (PRX-ID > 0)
        WS100IW-TRIGGER_Level77Items.ENABLE-HARD = "Y";
        VHCCS18W-PASSVALUE.VTAM-NAME = WS70A01_DATA.VTAM-NAME[PRX-ID];
    else
        WS100IW-TRIGGER_Level77Items.DISABLE-HARD = "Y";
    end
end 

Function VHCCS4IS_VIEW () 
    VHCCS05I-ADD.ADD-UPDT = "VIEW";
    LOAD-05 = "Y";
end 

Function VHCCS4IS_VIEW_ONE () 
    if (SELECTION-IDX == 0)
        VHCCS04I_MESSAGE.MESG1 = "PLEASE SELECT AN ROW";
    else
        VHCCS4IS_VIEW();
    end
end 

Function VHCCS7-RCV-ERRS () 
    VHCCS07-CRITERIA.TS-MSG-RCVD = VHCCS4A_CRIT.TS-MSG-RCVD;
    VHCCS07-CRITERIA.COMPARE-DT-F = VHCCS4A_CRIT.COMPARE-DT-F;
    VHCCS07-CRITERIA.COMPARE-DT-T = VHCCS4A_CRIT.COMPARE-DT-T;
    VHCCS07-CRITERIA.FROM-TIME = VHCCS4A_CRIT.FROM-TIME;
    VHCCS07-CRITERIA.TO-TIME = VHCCS4A_CRIT.TO-TIME;
    VHCCS07-CRITERIA.FROM-DATE = VHCCS4A_CRIT.FROM-DATE;
    VHCCS07-CRITERIA.TO-DATE = VHCCS4A_CRIT.TO-DATE;
    VHCCS07-CRITERIA.SELECTION-IDX-T = VHCCS04I_SELECTION_Level77Items.SELECTION-IDX;
    if (VHCCS04I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCCS07-CRITERIA.TS-MSG-RCVD = VHCCS4A_DATA.TS-MSG-RCVD[VHCCS04I_SELECTION_Level77Items.SELECTION-IDX];
    end
end
