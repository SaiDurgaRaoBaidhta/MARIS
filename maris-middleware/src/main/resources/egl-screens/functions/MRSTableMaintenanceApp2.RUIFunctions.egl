        VHCCS07I_SELECTION.DATA_ROW = VHCCS7A_DATA.DATA_ROW[SELECTION-IDX];
    end
    DISABLE-ADD = "Y";
    DISABLE-KEY = "Y";
    ENABLE-UPDATE = "Y";
    
    ENABLE-CLEAR = "Y";
end 

Function VHCCS07IS_UPDATE ()
   
    if (VHCCS07I_PASSVALUE.TS-MSG-RCVD != " " &&
     VHCCS07I_PASSVALUE.CNT-ERRS != 0 && 
   
     VHCCS07I_PASSVALUE.MARIS-FUNC != " " &&
     VHCCS07I_PASSVALUE.MSG-ERR-DESC != " " &&
     VHCCS07I_PASSVALUE.MSG-ERR-TYPE != " ")
        VHCCS7C_DATA.TS-MSG-RCVD = VHCCS07I_PASSVALUE.TS-MSG-RCVD;
        VHCCS7C_CRIT.TS-MSG-RCVD = VHCCS07I_PASSVALUE.TS-MSG-RCVD;
        VHCCS7C_DATA.CNT-ERRS = VHCCS07I_PASSVALUE.CNT-ERRS;
        VHCCS7C_DATA.FLD-NAME = VHCCS07I_PASSVALUE.FLD-NAME;
        VHCCS7C_DATA.MARIS-FUNC = VHCCS07I_PASSVALUE.MARIS-FUNC;
        VHCCS7C_DATA.MSG-ERR-DESC = VHCCS07I_PASSVALUE.MSG-ERR-DESC;
        VHCCS7C_DATA.MSG-ERR-TYPE = VHCCS07I_PASSVALUE.MSG-ERR-TYPE;
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS7C";
        try
            call "VHCCS7C"(XDCONTROL, VHCCS7C_CRIT, VHCCS7C_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCCS07-TRIGGER.MARIS-TRIGGER = "Y";
            VHCCS07I_MESSAGE.MESG1 = "UPDATE SUCCESFUL";
        else
                             
            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            VHCCS07I_MESSAGE.MESG1 = "UPDATE ERROR";
            VHCCS07-TRIGGER.MARIS-TRIGGER = "N";
        end
    else
      
        if (VHCCS07I_PASSVALUE.TS-MSG-RCVD == " ")
            VHCCS07I_MESSAGE.MESG1 = "Time stamp required ";
        end
  
  
  
        if (VHCCS07I_PASSVALUE.CNT-ERRS == 0)
            VHCCS07I_MESSAGE.MESG1 = "Count errors required ";
        end
        if (VHCCS07I_PASSVALUE.MARIS-FUNC == " ")
            VHCCS07I_MESSAGE.MESG1 = "Maris Function required ";
        end
        if (VHCCS07I_PASSVALUE.MSG-ERR-DESC == "           ")
            VHCCS07I_MESSAGE.MESG1 = "Message Error Description required ";
        end
        if (VHCCS07I_PASSVALUE.MSG-ERR-TYPE != "  ")
            VHCCS07I_MESSAGE.MESG1 = "Message Error Type required ";
        end
    end
    if (VHCCS07-TRIGGER.MARIS-TRIGGER == "Y")
        ENABLE-CLEAR = "Y";
        DISABLE-UPDATE = "Y";
        ENABLE-ADD = "Y";
        SELECTION-IDX = 0;
    end
end 

Function VHCCS18-INIT ()
  
  
  
  
  
  
  
  


   
    XXEXT_CALL_Level77Items.UEXTNAM = "WS100I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "WS70A01";

    
    try
        call "WS70A01"(XDCONTROL, WS70A01_DATA);
    
    end
    

  
    MRSCommonCode.XXA0IS-CHECK_EXT();

  
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VHCCS18IS-SUBMIT ()
  
  
  
  
  
  
  
  
  
  

  
  
  
   
    VHCCSHA_CRIT.FROM-DATE = VHCCS18W_PASSVALUE.FROM-DATE;
    VHCCSHA_CRIT.FROM-TIME = VHCCS18W_PASSVALUE.FROM-TIME;
    VHCCSHA_CRIT.TO-TIME = VHCCS18W_PASSVALUE.TO-TIME;
    VHCCSHA_CRIT.MSG-TRAN-CD = VHCCS18W_PASSVALUE.MSG-TRAN-CD;
    VHCCSHA_CRIT.CON-CURR-YRD = VHCCS18W_PASSVALUE.CON-CURR-YRD;
    VHCCSHA_CRIT.CON-CURR-LOC = VHCCS18W_PASSVALUE.CON-CURR-LOC;
    VHCCSHA_CRIT.CON-NO = VHCCS18W_PASSVALUE.CON-NO;
    VHCCSHA_CRIT.SCANNER-ID = VHCCS18W_PASSVALUE.SCANNER-ID;
    VHCCSHA_CRIT.SORT-CODE = VHCCS18W_PASSVALUE.SORT-INDEX;
    VHCCSHA_CRIT.REPT-ID = VHCCS18W-PASSVALUE.VTAM-NAME;

    
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCCS18I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCSHA";

    
    try
        call "VHCCSHA"(XDCONTROL, VHCCSHA_CRIT, VHCCSHA_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)

      
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        
            VHCCS18W-PASSVALUE.SUBMIT = "Y";
        else

        


        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end 
    end
end 

