            VHCCS05A_SELECTION.DATE-TRANS = VHCCS5D_DATA.DATE-TRANS;
            VHCCS05A_SELECTION.TIME-TRANS = VHCCS5D_DATA.TIME-TRANS;
            VHCCS05A_SELECTION.MSG-SEQ-NO = VHCCS5D_DATA.MSG-SEQ-NO;
