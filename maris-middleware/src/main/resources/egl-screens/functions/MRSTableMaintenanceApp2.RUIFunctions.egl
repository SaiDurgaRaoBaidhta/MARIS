        else
            VHCCS05A_ADDUPDT.TIME-TRANS = "        ";
        end
    else

    end
end 

Function VHCCS05IS_INIT ()
   
    set VHCCS5A_DATA empty;
    set VHCCS5IS_MESSAGE empty;

  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS5B";
    try
        call "VHCCS5B"(XDCONTROL, VHCCS5B_CRIT, VHCCS5B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCCS5B_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end

  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS5E";
    try
        call "VHCCS5E"(XDCONTROL, VHCCS5E_CRIT, VHCCS5E_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCCS5E_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    if (VHCCS05I-ADD.ADD-UPDT == "VIEW")
        VHCCS05IW-TRIGGER.DISABLE-SAVE = "Y";
     
        VHCCS05IW-TRIGGER.DISABLE-CON-CUR-YRD = "Y";
        VHCCS05IW-TRIGGER.DISABLE-SCANNER-DATA = "Y";
    else
    
        VHCCS05IW-TRIGGER.ENABLE-SAVE = "Y";
    end
    if (VHCCS05I-ADD.ADD-UPDT == "ADD")
        set VHCCS04I_SELECTION empty;
        set VHCCS05A_SELECTION empty;
        VHCCS05IW-TRIGGER.ENABLE-CON-CUR-YRD = "Y";
        VHCCS05IW-TRIGGER.ENABLE-SCANNER-DATA = "Y";
        VHCCS05IS_ADD_INIT();
    end
    if (VHCCS05I-ADD.ADD-UPDT == "UPDATE")
        VHCCS05IW-TRIGGER.ENABLE-CON-CUR-YRD = "Y";
        VHCCS05IW-TRIGGER.ENABLE-SCANNER-DATA = "Y";
        
      
    end
end 

Function VHCCS05IS_SAVE () 
    VHCCS5IS_MESSAGE.MESG1 = "                                                                   ";
    if (VHCCS05I-ADD.ADD-UPDT == "ADD")
        if (VHCCS05A_ADDUPDT.TS-MSG-RCVD == " ")
            VHCCS5IS_MESSAGE.MESG1 = "Time stamp required ";
        end
        if (VHCCS05A_ADDUPDT.DATE-TRANS == " ")
            VHCCS5IS_MESSAGE.MESG1 = "Date Trans required";
        end
        if (VHCCS05A_ADDUPDT.MSG-TRAN-CD == " ")
            VHCCS5IS_MESSAGE.MESG1 = "Msg tran code required";
        end
        if (VHCCS05A_ADDUPDT.MSG-LENGTH == 0)
            VHCCS5IS_MESSAGE.MESG1 = "Msg length required";
        end

   
  
        if (VHCCS5IS_MESSAGE.MESG1 == "               ")
            move VHCCS05A_ADDUPDT to VHCCS5D_DATA withV60Compat;
            XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS5D";
            try
                call "VHCCS5D"(XDCONTROL, VHCCS5D_DATA);
            
            end
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHCCS05IS-DATE-MV();
                VHCCS5IS_MESSAGE.MESG1 = "ADD SUCCESSFUL";
                
  
   
            else
                             
              
              
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                VHCCS5IS_MESSAGE.MESG1 = "DUPLICATE RECORD";
            end
        end
    else
        if (VHCCS05I-ADD.ADD-UPDT == "UPDATE")
            if (VHCCS05A_ADDUPDT.TS-MSG-RCVD == "                    ")
                VHCCS5IS_MESSAGE.MESG1 = "Time stamp required ";
            end
            if (VHCCS05A_ADDUPDT.DATE-TRANS == " ")
                VHCCS5IS_MESSAGE.MESG1 = "Date Trans required";
            end
   
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
            if (VHCCS05A_ADDUPDT.MSG-TRAN-CD == " ")
                VHCCS5IS_MESSAGE.MESG1 = "Msg tran code required";
            end
            if (VHCCS05A_ADDUPDT.MSG-LENGTH == 0)
                VHCCS5IS_MESSAGE.MESG1 = "Msg length required";
            end
  
  
  
            VHCCS05A_ADDUPDT.I-FIL1 = " ";
            VHCCS05A_ADDUPDT.I-FIL2 = " ";
            VHCCS05A_ADDUPDT.I-FIL3 = " ";
            VHCCS05A_ADDUPDT.I-FIL4 = " ";
            VHCCS05A_ADDUPDT.I-FIL5 = " ";
            VHCCS05A_ADDUPDT.I-FIL6 = " ";
            VHCCS05A_ADDUPDT.I-FIL7 = " ";
            VHCCS05A_ADDUPDT.I-FIL8 = " ";
            VHCCS05A_ADDUPDT.I-FIL9 = " ";
            VHCCS05A_ADDUPDT.I-FIL10 = " ";
            VHCCS05IS_DT_CK();
            if (VHCCS5IS_MESSAGE.MESG1 == "               ")
                move VHCCS05A_ADDUPDT to VHCCS5C_DATA withV60Compat;
                VHCCS5C_CRIT.TS-MSG-RCVD = VHCCS05A_ADDUPDT.TS-MSG-RCVD;
                XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS5C";
                try
                    call "VHCCS5C"(XDCONTROL, VHCCS5C_CRIT, VHCCS5C_DATA);
                
                end
                if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                    VHCCS05IS-DATE-MV();
                    VHCCS5IS_MESSAGE.MESG1 = "UPDATE SUCCESSFUL";
                    
   
       
                else
                             
              
              
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                    VHCCS5IS_MESSAGE.MESG1 = "UPDATE FAILED";
                end
            end
        end
    end
end 

Function VHCCS05IS_SELECT () 
    VHCCS5IS_MESSAGE.MESG1 = "                                                                   ";
    STOR-INDEX = 1;
    STOR-SELECTION = 0;

  
    if (VHCCS04I_SELECTION_Level77Items.SELECTION-IDX > 0)
        VHCCS05A_SELECTION.DATA_ROW = VHCCS4A_DATA.DATA_ROW[VHCCS04I_SELECTION_Level77Items.SELECTION-IDX];
        VHCCS05A-CARS.D-CAR-1 = VHCCS05A_SELECTION.I-CAR-1;
        VHCCS05A-CARS.D-CAR-2 = VHCCS05A_SELECTION.I-CAR-2;
        VHCCS05A-CARS.D-CAR-3 = VHCCS05A_SELECTION.I-CAR-3;
        VHCCS05A-CARS.D-CAR-4 = VHCCS05A_SELECTION.I-CAR-4;
        VHCCS05A-CARS.D-CAR-5 = VHCCS05A_SELECTION.I-CAR-5;
        VHCCS05A-CARS.D-CAR-6 = VHCCS05A_SELECTION.I-CAR-6;
        VHCCS05A-CARS.D-CAR-7 = VHCCS05A_SELECTION.I-CAR-7;
        VHCCS05A-CARS.D-CAR-8 = VHCCS05A_SELECTION.I-CAR-8;
        VHCCS05A-CARS.D-CAR-9 = VHCCS05A_SELECTION.I-CAR-9;
        VHCCS05A-CARS.D-CAR-10 = VHCCS05A_SELECTION.I-CAR-10;
  
  
        VHCCS5B_CRIT.YRD-INDEX = VHCCS05A_SELECTION.CON-CURR-YRD;
        while (STOR-INDEX <= VHCCS5B_CRIT.COUNTER)
            if (VHCCS05A_SELECTION.CON-CURR-YRD ==
             VHCCS5B_DATA.YRD[STOR-INDEX])
                VHCCS05A_SELECTION_Level77Items.STOR-SELECTION = STOR-INDEX;
            end
            STOR-INDEX = STOR-INDEX + 1;
        end
        
  
    end
    STOR-INDEX-S = 1;
    STOR-SELECTION-S = 0;
    VHCCS5E_CRIT.SCAN-INDEX = VHCCS05A_SELECTION.SCANNER-ID-X;
    while (STOR-INDEX-S <= VHCCS5E_CRIT.COUNTER)
        if (VHCCS05A_SELECTION.SCANNER-ID-X ==
         VHCCS5E_DATA.SCANNER-ID[STOR-INDEX-S])
            VHCCS05A_SELECTION_Level77Items.STOR-SELECTION-S = STOR-INDEX-S;
        end
        STOR-INDEX-S = STOR-INDEX-S + 1;
    end
    if (VHCCS05I-ADD.ADD-UPDT == "VIEW" ||
     VHCCS05I-ADD.ADD-UPDT == "UPDATE")
        VHCCS05IW-TRIGGER.LOAD = "Y";
    else
        set VHCCS5D_DATA empty;
    end
    VHCCS05I-ADD.ADD-UPDT-1 = "       ";
    VHCCS05IS_DATE();
end 

Function VHCCS05IS_SELECT_R () 
    if (VHCCS05I-ADD.ADD-UPDT-1 == "REF")
        if (VHCCS05I-ADD.ADD-UPDT == "UPDATE")
        
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
            VHCCS05A_SELECTION.DATA_ROW = VHCCS4A_DATA.DATA_ROW[VHCCS04I_SELECTION_Level77Items.SELECTION-IDX];
            VHCCS05A-CARS.D-CAR-1 = VHCCS05A_SELECTION.I-CAR-1;
            VHCCS05A-CARS.D-CAR-2 = VHCCS05A_SELECTION.I-CAR-2;
            VHCCS05A-CARS.D-CAR-3 = VHCCS05A_SELECTION.I-CAR-3;
            VHCCS05A-CARS.D-CAR-4 = VHCCS05A_SELECTION.I-CAR-4;
            VHCCS05A-CARS.D-CAR-5 = VHCCS05A_SELECTION.I-CAR-5;
