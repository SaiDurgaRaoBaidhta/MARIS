Function VHCCS06IS_INIT ()
   
    set VHCCS6A_DATA empty;
    if (MARIS-TRIGGER != "Y")
        set VHCCS06I_MESSAGE empty;
    end
  
    if (VHCCS06-CRITERIA.SELECTION-IDX-T == 0)
        VHCCS6A_CRIT.COMPARE-DT-F = VHCCS06-CRITERIA.COMPARE-DT-F;
        VHCCS6A_CRIT.COMPARE-DT-T = VHCCS06-CRITERIA.COMPARE-DT-T;
    else
        VHCCS6A_CRIT.COMPARE-DT-F = VHCCS06-CRITERIA.TS-MSG-RCVD;
        VHCCS6A_CRIT.COMPARE-DT-T = VHCCS06-CRITERIA.TS-MSG-RCVD;
    end
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS6A";
    try
        call "VHCCS6A"(XDCONTROL, VHCCS6A_CRIT, VHCCS6A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCCS6A_CRIT.COUNTER = UROWCNT;
    else

       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end

   
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS6E";
    try
        call "VHCCS6E"(XDCONTROL, VHCCS6E_CRIT, VHCCS6E_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCCS6E_CRIT.COUNTER = UROWCNT;
        
  
    else
      
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    set VHCCS06I_PASSVALUE empty;
    if (VHCCS06-TRIGGER.MARIS-TRIGGER == " ")
        set VHCCS06I_MESSAGE empty;
    end
  
  
    ENABLE-CLEAR = "Y";
    DISABLE-UPDATE = "Y";
    ENABLE-ADD = "Y";
    TS-DISABLE = "N";
    CAR-NO-DISABLE = "N";
end 

Function VHCCS06IS_SELECT () 
    if (SELECTION-IDX > 0)
        set VHCCS06I_MESSAGE empty;
    end
  
    if (SELECTION-IDX > 0)
        VHCCS06I_SELECTION.DATA_ROW = VHCCS6A_DATA.DATA_ROW[SELECTION-IDX];
    end
    STOR-INDEX-O = 1;
    STOR-SELECTION-O = 0;
    if (SELECTION-IDX > 0)
        VHCCS6E_CRIT.ORIENTATION-INDEX = VHCCS06I_SELECTION.VAGen_ORIENTATION;
        while (STOR-INDEX-O <= VHCCS6E_CRIT.COUNTER)
            if (VHCCS06I_SELECTION.VAGen_ORIENTATION ==
             VHCCS6E_DATA.VAGen_ORIENTATION[STOR-INDEX-O])
                VHCCS06I_SELECTION_Level77Items.STOR-SELECTION-O = STOR-INDEX-O;
            end
            STOR-INDEX-O = STOR-INDEX-O + 1;
        end
    end
    DISABLE-ADD = "Y";
    DISABLE-KEY = "Y";
    ENABLE-UPDATE = "Y";
    
    ENABLE-CLEAR = "Y";
    TS-DISABLE = "Y";
    CAR-NO-DISABLE = "Y";
end 

Function VHCCS06IS_UPDATE ()
   
    if (VHCCS06I_PASSVALUE.DATE-INSRV-REV != " ")
        XXDATEW.DATE-MM-DD-YYYY = VHCCS06I_PASSVALUE.DATE-INSRV-REV;
        XXDATEW.VAGen_FUNCTION = "YMD";
        MRSCommonCode.XXDATES-CONVERT();
        VHCCS6A_DATA.DT-CONV-1 = XXDATEW.DATE-YYYY-MM-DD;
        VHCCS6A_DATA.DT-FILLER1-1 = "-";
        VHCCS6A_DATA.DT-FILLER2-1 = "-";
        VHCCS06I_PASSVALUE.DATE-INSRV-REV = VHCCS6A_DATA.DT-CONV-1;
        AFCXVLD_CRIT.FORM-DATE = VHCCS06I_PASSVALUE.DATE-INSRV-REV;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHCCS6IW.INVALID-TO-DATE = "Y";
            ENABLE-ADD = "N";
            VHCCS06I_MESSAGE.MESG1 = "INVALID DATE TEST FIELD";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHCCS06I_MESSAGE.MESG1 = "INVALID DATE TEST FIELD";
                ENABLE-UPDATE = "Y";
                ENABLE-CLEAR = "Y";
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    if (VHCCS06I_PASSVALUE.TS-MSG-RCVD != " " &&
     VHCCS06I_PASSVALUE.CAR-NO != " " &&
     VHCCS06I_PASSVALUE.CAR-ORDER != 0 &&
     VHCCS06I_PASSVALUE.CON-NO != " " &&
     VHCCS06I_PASSVALUE.DASH-NO != 0 &&
     VHCCS06I_PASSVALUE.DATE-INSRV-REV != " " &&
     VHCCS06I_PASSVALUE.VAGen_ORIENTATION != " ")
    
        VHCCS6C_DATA.TS-MSG-RCVD = VHCCS06I_PASSVALUE.TS-MSG-RCVD;
        VHCCS6C_CRIT.TS-MSG-RCVD = VHCCS06I_PASSVALUE.TS-MSG-RCVD;
        VHCCS6C_DATA.CAR-NO = VHCCS06I_PASSVALUE.CAR-NO;
        VHCCS6C_CRIT.CAR-NO = VHCCS06I_PASSVALUE.CAR-NO;
        VHCCS6C_DATA.CAR-ORDER = VHCCS06I_PASSVALUE.CAR-ORDER;
        VHCCS6C_DATA.CON-NO = VHCCS06I_PASSVALUE.CON-NO;
        VHCCS6C_DATA.DASH-NO = VHCCS06I_PASSVALUE.DASH-NO;
        VHCCS6C_DATA.DATE-INSRV-REV = VHCCS06I_PASSVALUE.DATE-INSRV-REV;
        VHCCS6C_DATA.VAGen_ORIENTATION = VHCCS06I_PASSVALUE.VAGen_ORIENTATION;
        VHCCS6C_DATA.ORIENTATION-DIR = VHCCS06I_PASSVALUE.ORIENTATION-DIR;
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS6C";
        try
            call "VHCCS6C"(XDCONTROL, VHCCS6C_CRIT, VHCCS6C_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCCS06-TRIGGER.MARIS-TRIGGER = "Y";
            VHCCS06I_MESSAGE.MESG1 = "UPDATE SUCCESFUL";
        else
                             
            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            VHCCS06I_MESSAGE.MESG1 = "UPDATE ERROR";
            VHCCS06-TRIGGER.MARIS-TRIGGER = "N";
        end
    else
      
        if (VHCCS06I_PASSVALUE.TS-MSG-RCVD == " ")
            VHCCS06I_MESSAGE.MESG1 = "Time stamp required ";
        end
        if (VHCCS06I_PASSVALUE.CAR-NO == " ")
            VHCCS06I_MESSAGE.MESG1 = "Car No required ";
        end
        if (VHCCS06I_PASSVALUE.CAR-ORDER == 0)
            VHCCS06I_MESSAGE.MESG1 = "Car Order required ";
        end
        if (VHCCS06I_PASSVALUE.CON-NO == " ")
            VHCCS06I_MESSAGE.MESG1 = "Con No required ";
        end
        if (VHCCS06I_PASSVALUE.DASH-NO == 0)
            VHCCS06I_MESSAGE.MESG1 = "Dash No invalid ";
        end
        if (VHCCS06I_PASSVALUE.DATE-INSRV-REV != "  ")
            VHCCS06I_MESSAGE.MESG1 = "Date Insrv Rev invalid ";
        end
        if (VHCCS06I_PASSVALUE.VAGen_ORIENTATION == " ")
            VHCCS06I_MESSAGE.MESG1 = "Orientation invalid ";
        end
   
   
    
    end
    if (VHCCS06-TRIGGER.MARIS-TRIGGER == "Y")
        ENABLE-CLEAR = "Y";
        DISABLE-UPDATE = "Y";
        ENABLE-ADD = "Y";
        TS-DISABLE = "Y";
        CAR-NO-DISABLE = "Y";
    end
end 

