

package MRSTableMaintenanceApp2;
 

Function VHCCS04I-L () 
    set VHCCS4I_PASSVALUE empty;
    set VHCCS04I_SELECTION empty;
    set VHCCS4A_DATA empty;
    VHCCS04I_MESSAGE.MESG1 = "                                                                          ";
end 

Function VHCCS04I-PRINT () 
    VHCCS4IW_CRIT.FROM-TIME-C = VHCCS4IW_CRIT.FROM-TIME;
end 

Function VHCCS04I-SCAN-ID () 
    VHCCS4IW.SCAN-CNT = 1;
    while (VHCCS4IW.SCAN-CNT <= XDCONTROL.UROWCNT)
        if (VHCCS4A_DATA.SCANNER-ID-X[SCAN-CNT] != " ")
            VHCCS4I_PASSVALUE.SCANNER-ID-SAVE = VHCCS4A_DATA.SCANNER-ID-X[SCAN-CNT];
            VHCCS04I-SCAN-ID-X();
            VHCCS4A_DATA.SCAN-ID-DIR[SCAN-CNT] = VHCCS4I_PASSVALUE.SCANNER-DIR;
        end
  
  
  
  
  
  
  
  
  
  
  
   
   
  
  
  
  
  
  
  
  
  
  
        VHCCS4IW.SCAN-CNT = VHCCS4IW.SCAN-CNT + 1;
    end
end 

Function VHCCS04I-SCAN-ID-X () 
    VHCCS4I_PASSVALUE.SCANNER-ID-SAVE-IDX = 1;
    while (VHCCS4I_PASSVALUE.SCANNER-ID-SAVE-IDX <= VHCCS4H_CRIT.COUNTER)
        if (VHCCS4H_DATA.SCANNER-ID[SCANNER-ID-SAVE-IDX] == VHCCS4I_PASSVALUE.SCANNER-ID-SAVE)
            VHCCS4I_PASSVALUE.SCANNER-DIR = VHCCS4H_DATA.SCAN-DESC[SCANNER-ID-SAVE-IDX];
        end
        VHCCS4I_PASSVALUE.SCANNER-ID-SAVE-IDX = VHCCS4I_PASSVALUE.SCANNER-ID-SAVE-IDX + 1;
    end
end 

Function VHCCS04I_ADD ()
  

  
  
  
  
  
  
   
    ADD-UPDT = "UPDATE";
    LOAD-05 = "Y";
end 

Function VHCCS04I_CLEAR () 
    VHCCS04I_SELECTION_Level77Items.SELECTION-IDX = 0;
    set VHCCS4A_DATA empty;
    set VHCCS4A_CRIT empty;
    set VHCCS04I_MESSAGE empty;
    set VHCCS4I_PASSVALUE empty;
    set VHCCS04I_SELECTION empty;
    VHCCS4IW_CRIT.FROM-DATE = "        ";
    VHCCS4IW_CRIT.FROM-TIME = "        ";
    VHCCS4IW_CRIT.TO-TIME = "        ";
    VHCCS4IW_CRIT.MSG-TRAN-CD = "  ";
    VHCCS4IW_CRIT.CON-NO = "    ";
    VHCCS4IW_CRIT.CON-CURR-YRD = "   ";
    VHCCS4IW_CRIT.CON-CURR-LOC = "    ";
    VHCCS4IW_CRIT.SCANNER-ID = " ";
    VHCCS04I_SELECTION_Level77Items.SELECTION-IDX = 0;
    VHCCS4A_CRIT.COUNTER = 0;
    VHCCS4IW.FROM-DATE = "        ";
    VHCCS4IW.FROM-TIME = "        ";
    VHCCS4IW.TO-TIME = "        ";
    VHCCS04I_MESSAGE.MESG1 = "                                                                                           ";
    ENABLE-KEY = "Y";
    ENABLE-ADD = "Y";
    ENABLE-CLEAR = "Y";
    DISABLE-UPDATE = "Y";
end 

Function VHCCS04I_DELETE ()
   
    VHCCS4B_CRIT.TS-MSG-RCVD = VHCCS4I_PASSVALUE.TS-MSG-RCVD;
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS4B";
    try
        call "VHCCS4B"(XDCONTROL, VHCCS4B_CRIT);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCCS4IW_TRIGGER.MSG-TRIGGER = "Y";
    else
                   
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
  
    if (VHCCS4I_PASSVALUE.TS-MSG-RCVD == " ")
        VHCCS04I_MESSAGE.MESG1 = "Time stamp  invalid ";
    end
end 

Function VHCCS04I_INIT () 
    set VHCCS4A_DATA empty;
    set VHCCS4I_PASSVALUE empty;

  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS4E";
    try
        call "VHCCS4E"(XDCONTROL, VHCCS4E_CRIT, VHCCS4E_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCCS4E_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end

  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS4F";
    try
        call "VHCCS4F"(XDCONTROL, VHCCS4F_CRIT, VHCCS4F_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCCS4F_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end

  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS4G";
    try
        call "VHCCS4G"(XDCONTROL, VHCCS4G_CRIT, VHCCS4G_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCCS4G_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end

  
  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS4H";
    try
        call "VHCCS4H"(XDCONTROL, VHCCS4H_CRIT, VHCCS4H_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCCS4H_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end

  
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS4I";
    try
        call "VHCCS4I"(XDCONTROL, VHCCS4I_CRIT, VHCCS4I_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCCS4I_CRIT.COUNTER = UROWCNT;
    else
       
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    VHCCS4IW_CRIT.FROM-TIME-C = VGVar.currentFormattedTime;
    if (VHCCS4IW_CRIT.FROM-HH == 00)
        VHCCS4IW_CRIT.FROM-HH = 22;
    else
        if (VHCCS4IW_CRIT.FROM-HH == 01)
            VHCCS4IW_CRIT.FROM-HH = 22;
        else
            if (VHCCS4IW_CRIT.FROM-HH == 02)
                VHCCS4IW_CRIT.FROM-HH = 23;
            else
                if (VHCCS4IW_CRIT.FROM-HH == 03)
                    VHCCS4IW_CRIT.FROM-HH = 24;
                else
                    VHCCS4IW_CRIT.FROM-HH = VHCCS4IW_CRIT.FROM-HH - 3;
                end
            end
        end
    end

  


  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
    VHCCS4IW_CRIT.FROM-TIME = VHCCS4IW_CRIT.FROM-TIME-C;
    VHCCS4IW_CRIT.TO-TIME-C = VGVar.currentFormattedTime;

  
  
  
  
  
  
    VHCCS4IW_CRIT.TO-TIME = VHCCS4IW_CRIT.TO-TIME-C;
    VHCCS4IW_CRIT.WK-DATE = VGVar.currentShortGregorianDate;
    VHCCS4IW_CRIT.FROM-DATE-FILLER1 = "-";
    VHCCS4IW_CRIT.FROM-DATE-FILLER2 = "-";
    WK-YY1 = "20";
    move WK-DATE-YR to WK-YY2 withV60Compat;
    VHCCS4IW_CRIT.FROM-DATE-MO = WK-DATE-MO;
    VHCCS4IW_CRIT.FROM-DATE-DAY = WK-DATE-DY;
    VHCCS4IW_CRIT.FROM-DATE-YEAR = WK-DATE-YR4;
end 

Function VHCCS04I_LIST () 
    VHCCS04I-L();
    SELECTION-IDX = 0;
    if (VHCCS4IW_CRIT.FROM-DATE != " ")
        AFCXVLD_CRIT.FORM-DATE = VHCCS4IW_CRIT.FROM-DATE;
        MRSCommonCode.AFCXVLD-VALIDATE();
        if (AFCXVLDW.INCORRECT-DATE == "Y")
            VHCCS4IW.INVALID-FROM-DATE = "Y";
            ENABLE-ADD = "N";
            VHCCS04I_MESSAGE.MESG1 = "INVALID FROM DATE";
            return;
        else
            if (AFCXVLDW.SQL-ERROR == "Y")
                VHCCS04I_MESSAGE.MESG1 = "INVALID FROM DATE";
                return;
            else
                if (AFCXVLDW.NO-ERROR == "Y")

                end
            end
        end
    end
    VHCCS4IW_CRIT.FROM-DATE-FILLER1 = "-";
    VHCCS4IW_CRIT.FROM-DATE-FILLER2 = "-";
    VHCCS4A_CRIT.FROM-DATE = VHCCS4IW_CRIT.FROM-DATE;
    VHCCS4IW.TO-TIME = VHCCS4IW_CRIT.TO-TIME;
    if (VHCCS4IW.TO-FIL1 == ":")
        VHCCS4IW.TO-FIL1 = ".";
    end
    if (VHCCS4IW.TO-FIL2 == ":")
        VHCCS4IW.TO-FIL2 = ".";
    end
    VHYTIME_DATA.TIME-MAINT-UPD = VHCCS4IW.TO-TIME;
    VHYTIME_DATA.MARIS-SUBSYS = "BMTIME";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYTIME";
    try
        call "MRSTableMaintenance.VHYTIME"(XDCONTROL, VHYTIME_DATA);
    
    end
  
    if (XDCONTROL.UMSGINS[1] == "      ")
        VHCCS4A_CRIT.TO-TIME = VHCCS4IW.TO-TIME;
    else
        VHCCS04I_MESSAGE.MESG1 = " INVALID TO-TIME PARAMETER    ";
    
        return;
        
         
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
    VHCCS4IW.FROM-TIME = VHCCS4IW_CRIT.FROM-TIME;
    if (VHCCS4IW.FROM-FIL1 == ":")
        VHCCS4IW.FROM-FIL1 = ".";
    end
    if (VHCCS4IW.FROM-FIL2 == ":")
        VHCCS4IW.FROM-FIL2 = ".";
    end
    VHYTIME_DATA.TIME-MAINT-UPD = VHCCS4IW.FROM-TIME;
    
 
  
    VHYTIME_DATA.MARIS-SUBSYS = "BMTIME";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHYTIME";
    try
        call "MRSTableMaintenance.VHYTIME"(XDCONTROL, VHYTIME_DATA);
    
    end
  
    if (XDCONTROL.UMSGINS[1] == "      ")
        VHCCS4A_CRIT.FROM-TIME = VHCCS4IW.FROM-TIME;
    else
        VHCCS04I_MESSAGE.MESG1 = " INVALID FROM-TIME PARAMETER    ";
    
        return;
        
         
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
  
    if (VHCCS4IW_CRIT.MSG-TRAN-CD == "  ")
        VHCCS4A_CRIT.TRAN-CD-FR = "  ";
        VHCCS4A_CRIT.TRAN-CD-TO = "99";
    else
        VHCCS4A_CRIT.TRAN-CD-FR = VHCCS4IW_CRIT.MSG-TRAN-CD;
        VHCCS4A_CRIT.TRAN-CD-TO = VHCCS4IW_CRIT.MSG-TRAN-CD;
    end
    if (VHCCS4IW_CRIT.CON-NO == "    ")
        VHCCS4A_CRIT.CON-NO-FR = "   "; 
        VHCCS4A_CRIT.CON-NO-TO = "999";
    else
        VHCCS4A_CRIT.CON-NO-FR = VHCCS4IW_CRIT.CON-NO;
        VHCCS4A_CRIT.CON-NO-TO = VHCCS4IW_CRIT.CON-NO;
    end
    if (VHCCS4IW_CRIT.CON-CURR-YRD == "    ")
        VHCCS4A_CRIT.CON-CURR-YRD-FR = "    ";
        VHCCS4A_CRIT.CON-CURR-YRD-TO = "ZZZ";
    else
        VHCCS4A_CRIT.CON-CURR-YRD-FR = VHCCS4IW_CRIT.CON-CURR-YRD;
        VHCCS4A_CRIT.CON-CURR-YRD-TO = VHCCS4IW_CRIT.CON-CURR-YRD;
    end
    if (VHCCS4IW_CRIT.SCANNER-ID == "    ")
        VHCCS4A_CRIT.SCANNER-ID-FR = " ";
        VHCCS4A_CRIT.SCANNER-ID-TO = "Z";
        if (VHCCS4IW_CRIT.SCANNER-ID == "    " && VHCCS4IW_CRIT.LOC == "ALL")
            VHCCS4A_CRIT.SCANNER-ID-FR = "A";
            VHCCS4A_CRIT.SCANNER-ID-TO = "Z";
        else

        end
    end
    if (VHCCS4IW_CRIT.SCANNER-ID != "    ")
        VHCCS4A_CRIT.SCANNER-ID-FR = VHCCS4IW_CRIT.SCANNER-ID;
        VHCCS4A_CRIT.SCANNER-ID-TO = VHCCS4IW_CRIT.SCANNER-ID;
    end
    if (VHCCS4IW_CRIT.MSG-PROCESSED-CD == " ")
        VHCCS4A_CRIT.MSG-PROCESSED-FR = " ";
        VHCCS4A_CRIT.MSG-PROCESSED-TO = "9";
    else
        VHCCS4A_CRIT.MSG-PROCESSED-FR = VHCCS4IW_CRIT.MSG-PROCESSED-CD;
        VHCCS4A_CRIT.MSG-PROCESSED-TO = VHCCS4IW_CRIT.MSG-PROCESSED-CD;
    end

  
  
  
  
  
  
  
    if (VHCCS4IW_CRIT.CON-CURR-LOC == "    ")
        VHCCS4A_CRIT.CON-CURR-LOC-FR = "   ";
        VHCCS4A_CRIT.CON-CURR-LOC-TO = "999";
    else
        VHCCS4A_CRIT.CON-CURR-LOC-FR = VHCCS4IW_CRIT.CON-CURR-LOC;
        VHCCS4A_CRIT.CON-CURR-LOC-TO = VHCCS4IW_CRIT.CON-CURR-LOC;
    end
    VHCCS4IW.TO-DATE-MO = VHCCS4IW_CRIT.FROM-DATE-MO;
    VHCCS4IW.TO-DATE-DAY = VHCCS4IW_CRIT.FROM-DATE-DAY;
    VHCCS4IW.TO-DATE-YEAR = VHCCS4IW_CRIT.FROM-DATE-YEAR;
    VHCCS4IW.TO-DATE-FILLER1 = "-";
    VHCCS4IW.TO-DATE-FILLER2 = "-";
    VHCCS4IW.T-DATE = VHCCS4IW.TO-DATE;
    VHCCS4IW.T-TIME = VHCCS4A_CRIT.TO-TIME;
    VHCCS4IW.T-FIL-DOT = ".";
    VHCCS4IW.T-FIL-DASH = "-";
    VHCCS4IW.T-FIL-ZERO = "000000";
    VHCCS4A_CRIT.COMPARE-DT-T = VHCCS4IW.T-STAMP;
    VHCCS4IW.FROM-DATE-MO = VHCCS4IW_CRIT.FROM-DATE-MO;
    VHCCS4IW.FROM-DATE-DAY = VHCCS4IW_CRIT.FROM-DATE-DAY;
    VHCCS4IW.FROM-DATE-YEAR = VHCCS4IW_CRIT.FROM-DATE-YEAR;
    VHCCS4IW.FROM-DATE-FILLER1 = "-";
    VHCCS4IW.FROM-DATE-FILLER2 = "-";
    VHCCS4IW.T-DATE = VHCCS4IW.FROM-DATE;
    VHCCS4IW.T-TIME = VHCCS4A_CRIT.FROM-TIME;
    VHCCS4IW.T-FIL-DOT = ".";
    VHCCS4IW.T-FIL-DASH = "-";
    VHCCS4IW.T-FIL-ZERO = "000000";
    VHCCS4A_CRIT.COMPARE-DT-F = VHCCS4IW.T-STAMP;
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS4A";
    try
        call "VHCCS4A"(XDCONTROL, VHCCS4A_CRIT, VHCCS4A_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCCS04I-SCAN-ID();
        if (UROWCNT < 71)
            VHCCS4A_CRIT.COUNTER = UROWCNT;
            VHCCS4IW_TRIGGER.LOAD = "Y";
            VHCCS04I_MESSAGE.MESG1 = "                                                                   ";
        else
            VHCCS4A_CRIT.COUNTER = UROWCNT;
            VHCCS4IW_TRIGGER.LOAD = "Y";
            VHCCS04I_MESSAGE.MESG1 = "MORE THAN 71 MESSAGES FOR SELECTED CRITERIA";
        end
    else
   
  
        VHCCS04I_MESSAGE.MESG1 = " NO DATA FOUND FOR SELECTED CRITERIA    ";
        ENABLE-ADD = "N";
        return;
    
        
         
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHCCS04I_SELECT () 
    VHCCS04I_MESSAGE.MESG1 = "                                                                   ";
    STOR-INDEX = 1;
    STOR-SELECTION = 0;
    SELECTION-IDX = VHCCS4I_PASSVALUE.SELECTION-INDEX;
    if (SELECTION-IDX > 0)
        VHCCS04I_SELECTION.DATA_ROW = VHCCS4A_DATA.DATA_ROW[SELECTION-IDX];
    end
    if (SELECTION-IDX > 0)
        VHCCS4E_CRIT.YRD-INDEX = VHCCS04I_SELECTION.CON-CURR-YRD;
        while (STOR-INDEX <= VHCCS4E_CRIT.COUNTER)
            if (VHCCS04I_SELECTION.CON-CURR-YRD ==
             VHCCS4E_DATA.YRD[STOR-INDEX])
                VHCCS4I_PASSVALUE.STOR-SELECTION = STOR-INDEX;
            end
            STOR-INDEX = STOR-INDEX + 1;
        end
    end

  
    STOR-INDEX-T = 1;
    STOR-SELECTION-T = 0;
    if (SELECTION-IDX > 0)
        VHCCS4F_CRIT.TRAN-INDEX = VHCCS04I_SELECTION.MSG-TRAN-CD;
        while (STOR-INDEX-T <= VHCCS4F_CRIT.COUNTER)
            if (VHCCS04I_SELECTION.MSG-TRAN-CD ==
             VHCCS4F_DATA.TRAN-CD[STOR-INDEX-T])
                VHCCS4I_PASSVALUE.STOR-SELECTION-T = STOR-INDEX-T;
            end
            STOR-INDEX-T = STOR-INDEX-T + 1;
        end
    end

  
    STOR-INDEX-L = 1;
    STOR-SELECTION-L = 0;
    if (SELECTION-IDX > 0)
        VHCCS4G_CRIT.LOC-INDEX = VHCCS04I_SELECTION.CON-CURR-LOC;
        while (STOR-INDEX-L <= VHCCS4G_CRIT.COUNTER)
            if (VHCCS04I_SELECTION.CON-CURR-LOC ==
             VHCCS4G_DATA.LOC[STOR-INDEX-L])
                VHCCS4I_PASSVALUE.STOR-SELECTION-L = STOR-INDEX-L;
            end
            STOR-INDEX-L = STOR-INDEX-L + 1;
        end
    end
    VHCCS4IW_TRIGGER.ENABLE-DELETE = "Y";
end 

Function VHCCS04I_UPD () 
    if (SELECTION-IDX == 0)
        VHCCS04I_MESSAGE.MESG1 = "PLEASE SELECT AN ROW";
    else
        VHCCS04I_ADD();
    end
end 

Function VHCCS05IS-DATE-MV () 
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCCS05A_ADDUPDT.DATE-TRANS;
    MRSCommonCode.XXDATES-CONVERT();
    VHCCS05A_ADDUPDT.DATE-TRANS = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCCS05A_ADDUPDT.DATE-CREATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHCCS05A_ADDUPDT.DATE-CREATE = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCCS05A_ADDUPDT.DATE-ICS-CREATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHCCS05A_ADDUPDT.DATE-ICS-CREATE = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCCS05A_ADDUPDT.DATE-MSG-CMPLT;
    MRSCommonCode.XXDATES-CONVERT();
    VHCCS05A_ADDUPDT.DATE-MSG-CMPLT = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCCS05A_ADDUPDT.DATE-INSRV-REV;
    MRSCommonCode.XXDATES-CONVERT();
    VHCCS05A_ADDUPDT.DATE-INSRV-REV = XXDATEW.DATE-MM-DD-YYYY;
end 

Function VHCCS05IS-DATE-UPD () 
    XXDATEW.VAGen_FUNCTION = "YMD";
    if (VHCCS05A_ADDUPDT.DATE-TRANS != " ")
        XXDATEW.DATE-MM-DD-YYYY = VHCCS05A_ADDUPDT.DATE-TRANS;
        MRSCommonCode.XXDATES-CONVERT();
        VHCCS05A_ADDUPDT.DATE-TRANS = XXDATEW.DATE-YYYY-MM-DD;
    end
    if (VHCCS05A_ADDUPDT.DATE-CREATE != " ")
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHCCS05A_ADDUPDT.DATE-CREATE;
        MRSCommonCode.XXDATES-CONVERT();
        VHCCS05A_ADDUPDT.DATE-CREATE = XXDATEW.DATE-YYYY-MM-DD;
    end
    if (VHCCS05A_ADDUPDT.DATE-MSG-CMPLT != " ")
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHCCS05A_ADDUPDT.DATE-MSG-CMPLT;
        MRSCommonCode.XXDATES-CONVERT();
        VHCCS05A_ADDUPDT.DATE-MSG-CMPLT = XXDATEW.DATE-YYYY-MM-DD;
    end
    if (VHCCS05A_ADDUPDT.DATE-ICS-CREATE != " ")
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHCCS05A_ADDUPDT.DATE-ICS-CREATE;
        MRSCommonCode.XXDATES-CONVERT();
        VHCCS05A_ADDUPDT.DATE-ICS-CREATE = XXDATEW.DATE-YYYY-MM-DD;
    end
    if (VHCCS05A_ADDUPDT.DATE-INSRV-REV != " ")
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHCCS05A_ADDUPDT.DATE-INSRV-REV;
        MRSCommonCode.XXDATES-CONVERT();
        VHCCS05A_ADDUPDT.DATE-INSRV-REV = XXDATEW.DATE-YYYY-MM-DD;
    end
end 

Function VHCCS05IS-REFRESH () 
    VHCCS05I-ADD.ADD-UPDT-1 = "REF";
    VHCCS5IS_MESSAGE.MESG1 = "                                                                   ";
    if (VHCCS05I-ADD.ADD-UPDT == "VIEW")
        VHCCS05IS_SELECT();
    else
        VHCCS05IS_SELECT_R();
    end
end 

Function VHCCS05IS_ADD_INIT () 
    VHCCS05A_SELECTION.TIME-TRANS = VGVar.currentFormattedTime;
    VHCCS05A_SELECTION.TIME-CREATE = VGVar.currentFormattedTime;
    VHCCS05A_SELECTION.TIME-ICS-CREATE = VGVar.currentFormattedTime;
    VHCCS05A_SELECTION.TIME-MSG-CMPLT = VGVar.currentFormattedTime;
    VHCCS05IW-DATE.DATE-CREATE = VGVar.currentGregorianDate;
  
  
  
  
  
    VHCCS05A_SELECTION.DATE-CREATE = VHCCS05IW-DATE.DATE-CREATE;
end 

Function VHCCS05IS_DATE () 
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCCS05A_SELECTION.DATE-TRANS;
    MRSCommonCode.XXDATES-CONVERT();
    VHCCS05IW-DATE.DATE-TRANS = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCCS05A_SELECTION.DATE-CREATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHCCS05IW-DATE.DATE-CREATE = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCCS05A_SELECTION.DATE-ICS-CREATE;
    MRSCommonCode.XXDATES-CONVERT();
    VHCCS05IW-DATE.DATE-ICS-CREATE = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCCS05A_SELECTION.DATE-MSG-CMPLT;
    MRSCommonCode.XXDATES-CONVERT();
    VHCCS05IW-DATE.DATE-MSG-CMPLT = XXDATEW.DATE-MM-DD-YYYY;
    XXDATEW.VAGen_FUNCTION = "MDY";
    XXDATEW.DATE-YYYY-MM-DD = VHCCS05A_SELECTION.DATE-INSRV-REV;
    MRSCommonCode.XXDATES-CONVERT();
    VHCCS05IW-DATE.DATE-INSRV-REV = XXDATEW.DATE-MM-DD-YYYY;
end 

Function VHCCS05IS_DT_CK () 
    VHCCS05IS-DATE-UPD();
    if (VHCCS05A_ADDUPDT.DATE-TRANS == "  ")

    else
  
        VHCCS5N_DATA.DATE-MAINT-UPD = VHCCS05A_ADDUPDT.DATE-TRANS;
        VHCCS5N_CRIT.MARIS-SUBSYS = "BMTEST1";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS5N";
        try
            call "VHCCS5N"(XDCONTROL, VHCCS5N_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            VHCCS5IS_MESSAGE.MESG1 = "DATE TRANS NOT VALID";
        end
        
  
    end
    if (VHCCS05A_ADDUPDT.DATE-CREATE != "  ")
  
        VHCCS5N_DATA.DATE-MAINT-UPD = VHCCS05A_ADDUPDT.DATE-CREATE;
        VHCCS5N_CRIT.MARIS-SUBSYS = "BMTEST1";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS5N";
