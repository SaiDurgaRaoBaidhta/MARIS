Function VHCCS07IS_ADD ()
   
    if (VHCCS07I_PASSVALUE.TS-MSG-RCVD != " " &&
     VHCCS07I_PASSVALUE.CNT-ERRS != 0 &&
     VHCCS07I_PASSVALUE.FLD-NAME != "  " &&
     VHCCS07I_PASSVALUE.MARIS-FUNC != " " &&
     VHCCS07I_PASSVALUE.MSG-ERR-DESC != " " &&
     VHCCS07I_PASSVALUE.MSG-ERR-TYPE != " ")
        VHCCS7B_DATA.TS-MSG-RCVD = VHCCS07I_PASSVALUE.TS-MSG-RCVD;
        VHCCS7B_DATA.CNT-ERRS = VHCCS07I_PASSVALUE.CNT-ERRS;
        VHCCS7B_DATA.FLD-NAME = VHCCS07I_PASSVALUE.FLD-NAME;
        VHCCS7B_DATA.MARIS-FUNC = VHCCS07I_PASSVALUE.MARIS-FUNC;
        VHCCS7B_DATA.MSG-ERR-DESC = VHCCS07I_PASSVALUE.MSG-ERR-DESC;
        VHCCS7B_DATA.MSG-ERR-TYPE = VHCCS07I_PASSVALUE.MSG-ERR-TYPE;
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCCS7B";
        try
            call "VHCCS7B"(XDCONTROL, VHCCS7B_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCCS07-TRIGGER.MARIS-TRIGGER = "Y";
        else
                             
            
            
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            VHCCS07I_MESSAGE.MESG1 = "ERROR ADDING RECORD";
            VHCCS07-TRIGGER.MARIS-TRIGGER = "N";
        end
    else
      
        if (VHCCS07I_PASSVALUE.TS-MSG-RCVD == " ")
            VHCCS07I_MESSAGE.MESG1 = "Time stamp required ";
        end
        if (VHCCS07I_PASSVALUE.FLD-NAME == " ")
            VHCCS07I_MESSAGE.MESG1 = "Field Name required ";
        end
        if (VHCCS07I_PASSVALUE.CNT-ERRS == 0)
            VHCCS07I_MESSAGE.MESG1 = "Count errors required ";
        end
        if (VHCCS07I_PASSVALUE.MARIS-FUNC == " ")
            VHCCS07I_MESSAGE.MESG1 = "Maris Function required ";
        end
        if (VHCCS07I_PASSVALUE.MSG-ERR-DESC == "           ")
            VHCCS07I_MESSAGE.MESG1 = "Message Error Description required ";
        end
        if (VHCCS07I_PASSVALUE.MSG-ERR-TYPE != "  ")
            VHCCS07I_MESSAGE.MESG1 = "Message Error Type required ";
        end
    end
    if (VHCCS07-TRIGGER.MARIS-TRIGGER == "Y")
        ENABLE-CLEAR = "Y";
        DISABLE-UPDATE = "Y";
        ENABLE-ADD = "Y";
    end
end 

