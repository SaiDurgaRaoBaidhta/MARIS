            VHCCS05A_SELECTION.DASH-NO = VHCCS5D_DATA.DASH-NO;
            VHCCS05A_SELECTION.CON-NO-TO = VHCCS5D_DATA.CON-NO-TO;
            VHCCS05A_SELECTION.DASH-NO-TO = VHCCS5D_DATA.DASH-NO-TO;
            VHCCS05A_SELECTION.ORIGIN-LOC = VHCCS5D_DATA.ORIGIN-LOC;
            VHCCS05A_SELECTION.ORIGIN-LOC-ICS = VHCCS5D_DATA.ORIGIN-LOC-ICS;
            VHCCS05A_SELECTION.ORIGIN-TRK-ID = VHCCS5D_DATA.ORIGIN-TRK-ID;
            VHCCS05A_SELECTION.DEST-LOC = VHCCS5D_DATA.DEST-LOC;
            VHCCS05A_SELECTION.DEST-LOC-ICS = VHCCS5D_DATA.DEST-LOC-ICS;
            VHCCS05A_SELECTION.DEST-TRK-ID = VHCCS5D_DATA.DEST-TRK-ID;
            VHCCS05A_SELECTION.CON-SIZE = VHCCS5D_DATA.CON-SIZE;
            VHCCS05A_SELECTION.DATE-CREATE = VHCCS5D_DATA.DATE-CREATE;
            VHCCS05A_SELECTION.TIME-CREATE = VHCCS5D_DATA.TIME-CREATE;
            VHCCS05A_SELECTION.CON-CURR-YRD = VHCCS5D_DATA.CON-CURR-YRD;
            VHCCS05A_SELECTION.CON-CURR-LOC = VHCCS5D_DATA.CON-CURR-LOC;
            VHCCS05A_SELECTION.CON-CURR-LOC-ICS = VHCCS5D_DATA.CON-CURR-LOC-ICS;
