Function VH001IS-INIT () 
    if (VHMVSIW-EXIT.TITLE-NAME == "YT")
        VHMVSIW-EXIT.TITLE = "Return";
    else
        VHMVSIW-EXIT.TITLE = "Exit";
    end
    VH001IW-PASSVALUE.EVENT-IND = "EVT";
    VH001IW-PASSVALUE.FIX-IND = "REV";
    if (VH01A01_DATA.USER-GROUP == "VEHSUPR" || VH01A01_DATA.USER-GROUP == "TEST" || VH01A01_DATA.USER-GROUP == "DBMAINT")
        VH001IW-TRIGGER.ENABLE-FORCE = "Y";
    else
        VH001IW-TRIGGER.DISABLE-FORCE = "Y";
    end
    VH001IW-PASSVALUE.WHICH-GUI = "VH001I";
  
  
  
  
  
  
  
  
  
  
  
  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VH001I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VH01A01";
    try
        call "VH01A01"(XDCONTROL, VH01A01_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VH001IS-INIT-X () 
    VH01A02_CRIT.USER-GRP = VH01A01_DATA.USER-GROUP;
    VH01A02_CRIT.GUI-NAME = "VH001I";
  
  
  
  
  
  
  
  
  
  
  
  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VH001I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VH01A02";
    try
        call "VH01A02"(XDCONTROL, VH01A02_CRIT, VH01A02_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VH001IS-INIT-Y () 
    VH01A02_CRIT.USER-GRP = VH01A01_DATA.USER-GROUP;
    VH01A02_CRIT.GUI-NAME = "VH001I";

  
  
  
  
  
  
  
  
  
  
  
  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VH001I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VH01A02";
    try
        call "VH01A02"(XDCONTROL, VH01A02_CRIT, VH01A02_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4 || XDCONTROL.URC == 100)

        else

        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
    end
end 

Function VH001IS-MESSAGE () 
    VH001IW-MESSAGE.ERROR-MESSAGE = "Function not curently available.";
end 

Function VH001IS-MISC () 
    VH001IW-PASSVALUE.EVENT-IND = "MSC";
end 

Function VH001IS-SHOP () 
