

package MRSVehicleMenu;


Function VH001IS-ACCE-CC () 
    if ("pbtChangeConsist" in VH01A02_DATA.PART-NAME)
        if (VH01A02_DATA.ACCESS-ALLOW[sysVar.arrayIndex] == "N")
            VH001IW-BUTTOM.DISABLE-CHANGE-CONSIST = "Y";
            VH001IS-MESSAGE();
        else
            VH001IW-BUTTOM.ENABLE-CHANGE-CONSIST = "Y";
            VH001IW-BUTTOM.OPEN-CHANGE-CONSIST = "Y";
        end
    else
        VH001IW-BUTTOM.ENABLE-CHANGE-CONSIST = "Y";
        VH001IW-BUTTOM.OPEN-CHANGE-CONSIST = "Y";
    end
end 

