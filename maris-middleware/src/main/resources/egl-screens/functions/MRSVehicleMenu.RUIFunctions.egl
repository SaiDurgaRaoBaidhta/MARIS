Function VHMTOIS-GRP-ACCES () 
    if ("pbt0400Car" in VH01A02_DATA.PART-NAME)
        if (VH01A02_DATA.ACCESS-ALLOW[sysVar.arrayIndex] == "N")
            VHMTOIW-BUTTOM.DISABLE-0400-CAR = "Y";
        else
            VHMTOIW-BUTTOM.ENABLE-0400-CAR = "Y";
        end
    else
        VHMTOIW-BUTTOM.ENABLE-0400-CAR = "Y";
    end
    if ("pbt0830Train" in VH01A02_DATA.PART-NAME)
        if (VH01A02_DATA.ACCESS-ALLOW[sysVar.arrayIndex] == "N")
            VHMTOIW-BUTTOM.DISABLE-0830-TRAIN = "Y";
        else
            VHMTOIW-BUTTOM.ENABLE-0830-TRAIN = "Y";
        end
    else
        VHMTOIW-BUTTOM.ENABLE-0830-TRAIN = "Y";
    end
    if ("pbt1300Car" in VH01A02_DATA.PART-NAME)
        if (VH01A02_DATA.ACCESS-ALLOW[sysVar.arrayIndex] == "N")
            VHMTOIW-BUTTOM.DISABLE-1300-CAR = "Y";
        else
            VHMTOIW-BUTTOM.ENABLE-1300-CAR = "Y";
        end
    else
        VHMTOIW-BUTTOM.ENABLE-1300-CAR = "Y";
    end
    if ("pbt1800Train" in VH01A02_DATA.PART-NAME)
        if (VH01A02_DATA.ACCESS-ALLOW[sysVar.arrayIndex] == "N")
            VHMTOIW-BUTTOM.DISABLE-1800-TRAIN = "Y";
        else
            VHMTOIW-BUTTOM.ENABLE-1800-TRAIN = "Y";
        end
    else
        VHMTOIW-BUTTOM.ENABLE-1800-TRAIN = "Y";
    end
end 

