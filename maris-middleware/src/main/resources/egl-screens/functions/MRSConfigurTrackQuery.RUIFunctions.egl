Function VHCF35IS-OLD-AXLE1 ()
  
  

  
  

   
    if (VHCF35IW-HOLD-TRCK.AXLE1 != " ")
        VHCF35IW-MSG.MSG = " ";
        VHCF35IW.FOUND-CMPNTS = "N";
        VHCF35F_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.AXLE1;
        VHCF35F_CRIT.TRUCK-SERIAL-NO = VHCF35IW.CMPNT-SERIAL-NO;
        VHCF35F_CRIT.AXLE-NEW-OLD = "OLD";
        try
            call "VHCF37F"(XDCONTROL, VHCF35F_CRIT, VHCF35F_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF35IW.AXLE-CMP-COUNT = XDCONTROL.UROWCNT;
        else
            VHCF35IW-MSG.MSG = "NO COMPONENTS ARE CURRENTLY ASSOCIATED WITH THAT AXLE SERIAL NUMBER";
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
  

  
  
        YCOUNT = 1;
        while (YCOUNT <= VHCF35IW.AXLE-CMP-COUNT)
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "WHEEL")
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "1" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "3" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "B")
                    VHCF35IW-HOLD-AXLE.WHEEL1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "2" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "4" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "N")
                    VHCF35IW-HOLD-AXLE.WHEEL2 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
            end
  
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "BEARING")
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "1" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "3" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "B")
                    VHCF35IW-HOLD-AXLE.B-BEARING1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "2" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "4" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "N")
                    VHCF35IW-HOLD-AXLE.N-BEARING1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
            end
  
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "GEAR BOX")
                VHCF35IW-HOLD-AXLE.GEAR-BOX1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
            end
  
            YCOUNT = YCOUNT + 1;
        end
    end
end 

Function VHCF35IS-OLD-AXLE2 ()
  
  

  
  

   
    if (VHCF35IW-HOLD-TRCK.AXLE2 != " ")
        set VHCF35F_CRIT empty;
        set VHCF35F_DATA empty;
        VHCF35IW-MSG.MSG = " ";
        VHCF35IW.FOUND-CMPNTS = "N";
        VHCF35F_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.AXLE2;
        VHCF35F_CRIT.TRUCK-SERIAL-NO = VHCF35IW.CMPNT-SERIAL-NO;
        VHCF35F_CRIT.AXLE-NEW-OLD = "OLD";
        try
            call "VHCF37F"(XDCONTROL, VHCF35F_CRIT, VHCF35F_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF35IW.AXLE-CMP-COUNT = XDCONTROL.UROWCNT;
        else
            VHCF35IW-MSG.MSG = "NO COMPONENTS ARE CURRENTLY ASSOCIATED WITH THAT AXLE SERIAL NUMBER";
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
  

  
  
        YCOUNT = 1;
        while (YCOUNT <= VHCF35IW.AXLE-CMP-COUNT)
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "WHEEL")
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "5" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "7" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "B")
                    VHCF35IW-HOLD-AXLE.WHEEL3 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "6" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "8" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "N")
                    VHCF35IW-HOLD-AXLE.WHEEL4 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
            end
  
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "BEARING")
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "5" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "7" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "B")
                    VHCF35IW-HOLD-AXLE.B-BEARING2 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "6" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "8" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "N")
                    VHCF35IW-HOLD-AXLE.N-BEARING2 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
            end
  
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "GEAR BOX")
                VHCF35IW-HOLD-AXLE.GEAR-BOX2 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
            end
  
            YCOUNT = YCOUNT + 1;
        end
    end
end 

Function VHCF35IS-PRE-ADD ()
  
   
    set VHCF35IW-MSG empty;
    VHCF35IW.A2COMPONENT-FLAG = "N";
    VHCF35IW.A1COMPONENT-FLAG = "N";
    VHCF35IW.TCOMPONENT-FLAG = "N";

  

  
    if (VHCF35IW-HOLD-AXLE.WHEEL1 != " " &&
     VHCF35IW-HOLD-AXLE.WHEEL2 != " " &&
     VHCF35IW-HOLD-AXLE.B-BEARING1 != " " &&
     VHCF35IW-HOLD-AXLE.N-BEARING1 != " " &&
     VHCF35IW-HOLD-AXLE.GEAR-BOX1 != " ")
        VHCF35IW.A1COMPONENT-FLAG = "Y";
    end

  
    if (VHCF35IW-HOLD-AXLE.WHEEL3 != " " &&
     VHCF35IW-HOLD-AXLE.WHEEL4 != " " &&
     VHCF35IW-HOLD-AXLE.B-BEARING2 != " " &&
     VHCF35IW-HOLD-AXLE.N-BEARING2 != " " &&
     VHCF35IW-HOLD-AXLE.GEAR-BOX2 != " ")
        VHCF35IW.A2COMPONENT-FLAG = "Y";
    end

  
    if (VHCF35IW-HOLD-TRCK.AXLE1 != " " &&
     VHCF35IW-HOLD-TRCK.AXLE2 != " " &&
     VHCF35IW-HOLD-TRCK.TM-1 != " " &&
     VHCF35IW-HOLD-TRCK.TM-2 != " " &&
     VHCF35IW-HOLD-TRCK.BRAKE-DISC-1 != " " &&
     VHCF35IW-HOLD-TRCK.BRAKE-DISC-1 != " ")
        VHCF35IW.TCOMPONENT-FLAG = "Y";
    end
    if (VHCF35IW.TCOMPONENT-FLAG == "Y" && VHCF35IW.A1COMPONENT-FLAG == "Y" && VHCF35IW.A2COMPONENT-FLAG == "Y")
        VHCF35IW.RUN-VALIDATE = "Y";
    end
    if (VHCF35IW.TCOMPONENT-FLAG == "N")
        VHCF35IW-MSG.MSG = "YOU CANNOT ADD PARTS, THE TRUCK IS MISSING COMPONENTS";
    end
    if (VHCF35IW.A1COMPONENT-FLAG == "N")
        VHCF35IW-PASSVALUE.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.AXLE1;
        VHCF35IW-MSG.MSG = "AXLE 1 IS MISSING COMPONENTS, USE THE AXLE GUI TO FIX";
    end
    if (VHCF35IW.A2COMPONENT-FLAG == "N")
        VHCF35IW-PASSVALUE.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.AXLE2;
        VHCF35IW-MSG.MSG = "AXLE 1 IS MISSING COMPONENTS, USE THE AXLE GUI TO FIX";
    end
end 

Function VHCF35IS-PRE-AXLE2 () 
    if (VHCF35IW-HOLD-TRCK.AXLE2 != VHCF35IW-SAVE.AXLE-2-SAVE)
        VHCF35IW-SAVE.AXLE-2-SAVE = VHCF35IW-HOLD-TRCK.AXLE2;
        
  
    end
    VHCF35IS-AXLE2();
end 

Function VHCF35IS-PRE-VALID () 
    if (AXLE1-COLOR == "YELLOW" ||
     AXLE2-COLOR == "YELLOW" ||
     DISC1-COLOR == "YELLOW" ||
     DISC2-COLOR == "YELLOW" ||
     TM1-COLOR == "YELLOW" ||
     TM2-COLOR == "YELLOW")
        VHCF35IS-SER-OFF();
    else
        if (VHCF35IW-HOLD-TRCK.AXLE1 == " " &&
         VHCF35IW-HOLD-TRCK.AXLE2 == " " &&
         VHCF35IW-HOLD-TRCK.TM-1 == " " &&
         VHCF35IW-HOLD-TRCK.TM-2 == " " &&
         VHCF35IW-HOLD-TRCK.BRAKE-DISC-1 == " " &&
         VHCF35IW-HOLD-TRCK.BRAKE-DISC-1 == " ")
            VHCF35IW-MSG.MSG = "Please enter serial no. on the parts";
        else
            VHCF35IS-AXLE1();
            VHCF35IS-PRE-AXLE2();
            if (VHCF35IW.VALID-SERIALS != "N")
                VHCF35IS-VALIDATE();
            end
        end
    end
end 

Function VHCF35IS-SER-OFF () 
    VHCF35H_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
    if (VHCF35IW-COLOR.AXLE1-COLOR == "YELLOW")
        VHCF35H_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.AXLE1;
        try
            call "VHCF35H"(XDCONTROL, VHCF35H_CRIT, VHCF35H_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF35IW-MSG.MSG = "THE HIGH LIGHTED SERIAL NUMBER IS SUCCESSFULLY OFF FROM TRUCK";
        end
    end
    if (VHCF35IW-COLOR.AXLE2-COLOR == "YELLOW")
        VHCF35H_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.AXLE2;
        try
            call "VHCF35H"(XDCONTROL, VHCF35H_CRIT, VHCF35H_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF35IW-MSG.MSG = "THE HIGH LIGHTED SERIAL NUMBER IS SUCCESSFULLY OFF FROM TRUCK";
        end
    end
    if (VHCF35IW-COLOR.TM1-COLOR == "YELLOW")
        VHCF35H_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.TM-1;
        try
            call "VHCF35H"(XDCONTROL, VHCF35H_CRIT, VHCF35H_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF35IW-MSG.MSG = "THE HIGH LIGHTED SERIAL NUMBER IS SUCCESSFULLY OFF FROM TRUCK";
        end
    end
    if (VHCF35IW-COLOR.TM2-COLOR == "YELLOW")
        VHCF35H_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.TM-2;
        try
            call "VHCF35H"(XDCONTROL, VHCF35H_CRIT, VHCF35H_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF35IW-MSG.MSG = "THE HIGH LIGHTED SERIAL NUMBER IS SUCCESSFULLY OFF FROM TRUCK";
        end
    end
    if (VHCF35IW-COLOR.DISC1-COLOR == "YELLOW")
        VHCF35H_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.BRAKE-DISC-1;
        try
            call "VHCF35H"(XDCONTROL, VHCF35H_CRIT, VHCF35H_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF35IW-MSG.MSG = "THE HIGH LIGHTED SERIAL NUMBER IS SUCCESSFULLY OFF FROM TRUCK";
        end
    end
    if (VHCF35IW-COLOR.DISC2-COLOR == "YELLOW")
        VHCF35H_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.BRAKE-DISC-2;
        try
            call "VHCF35H"(XDCONTROL, VHCF35H_CRIT, VHCF35H_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF35IW-MSG.MSG = "THE HIGH LIGHTED SERIAL NUMBER IS SUCCESSFULLY OFF FROM TRUCK";
        end
    end
    VHCF35IW-SAVE.RUN-RETRIEVE = "Y";
end 

Function VHCF35IS-TRK-SAVE () 

end 

Function VHCF35IS-TRUCK ()
  
  

   
    VHCF35IW-MSG.MSG = " ";
    VHCF35IW.FOUND-CMPNTS = "N";

  
  
    VHCF35IW-HOLD-TRCK.AXLE1-NEW = "Y";
    VHCF35IW-HOLD-TRCK.AXLE2-NEW = "Y";
    VHCF35IW-HOLD-TRCK.TM-1-NEW = "Y";
    VHCF35IW-HOLD-TRCK.TM-2-NEW = "Y";
    VHCF35IW-HOLD-TRCK.BRAKE-DISC-1-NEW = "Y";
    VHCF35IW-HOLD-TRCK.BRAKE-DISC-2-NEW = "Y";
    set VHCF35B_CRIT empty;
    set VHCF35B_DATA empty;
    VHCF35B_CRIT.STOCK-NO = VHCF35D_CRIT.STOCK-NO;
    VHCF35B_CRIT.CMPNT-SERIAL-NO = VHCF35D_CRIT.CMPNT-SERIAL-NO;
    try
        call "VHCF35B"(XDCONTROL, VHCF35B_CRIT, VHCF35B_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF35IW.TRUCK-CMP-COUNT = XDCONTROL.UROWCNT;
        if (XDCONTROL.UROWCNT > 1)
            VHCF35IW.FOUND-CMPNTS = "Y";
        end
    else
        VHCF35IW-MSG.MSG = "NO COMPONENTS ARE CURRENTLY ASSOCIATED WITH THAT TRUCK SERIAL NUMBER";
        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
  

  
  
    if (VHCF35IW.FOUND-CMPNTS == "Y")
        VHCF35IS-MOVE();
    end
    if (VHCF35IW.FOUND-AXLE-1 == "Y" &&
     VHCF35IW.FOUND-AXLE-2 == "Y" &&
     VHCF35IW.FOUND-TM1 == "Y" &&
     VHCF35IW.FOUND-TM2 == "Y" &&
     VHCF35IW.FOUND-DISC1 == "Y" &&
     VHCF35IW.FOUND-DISC2 == "Y")
        VHCF35IW-MSG.MSG-1A = "THIS TRUCK ALREADY BUILT ";
    end
end 

Function VHCF35IS-TRUCK-SEL () 
    if (VHCF35IW.STOCK-NO-L2 == "17-35-88520" ||
     VHCF35IW.STOCK-NO-L2 == "19-35-88603" ||
     VHCF35IW.STOCK-NO-L2 == "20-35-88610")
        VHCF35IW-PASSVALUE.AXLE-1-NAME = "AXLE1";
        VHCF35IW-PASSVALUE.AXLE-2-NAME = "AXLE2";
        VHCF35IW-PASSVALUE.TM-1-NAME = "Traction Motor 1";
        VHCF35IW-PASSVALUE.TM-2-NAME = "Traction Motor 2";
        VHCF35IW-PASSVALUE.BD-1-NAME = "Brake Disc 1";
        VHCF35IW-PASSVALUE.BD-2-NAME = "Brake Disc 2";
        VHCF35IW-PASSVALUE.WHEEL-1-NAME = "Wheel 1";
        VHCF35IW-PASSVALUE.WHEEL-2-NAME = "Wheel 2";
        VHCF35IW-PASSVALUE.WHEEL-3-NAME = "Wheel 3";
        VHCF35IW-PASSVALUE.WHEEL-4-NAME = "Wheel 4";
    else
        VHCF35IW-PASSVALUE.AXLE-1-NAME = "AXLE3";
        VHCF35IW-PASSVALUE.AXLE-2-NAME = "AXLE4";
        VHCF35IW-PASSVALUE.TM-1-NAME = "Traction Motor 3";
        VHCF35IW-PASSVALUE.TM-2-NAME = "Traction Motor 4";
        VHCF35IW-PASSVALUE.BD-1-NAME = "Brake Disc 3";
        VHCF35IW-PASSVALUE.BD-2-NAME = "Brake Disc 4";
        VHCF35IW-PASSVALUE.WHEEL-1-NAME = "Wheel 5";
        VHCF35IW-PASSVALUE.WHEEL-2-NAME = "Wheel 6";
        VHCF35IW-PASSVALUE.WHEEL-3-NAME = "Wheel 7";
        VHCF35IW-PASSVALUE.WHEEL-4-NAME = "Wheel 8";
    end
end 

Function VHCF35IS-VAL-AXLE () 
    if (VHCF35F_CRIT.AXLE-ON-CAR == "Y")
        VHCF35IW-MSG.MSG = "AXLE on Car, please use serial off to remove it";
        VHCF35IW.VALID-SERIALS = "N";
    end
    if (VHCF35F_CRIT.INVALID-AXLE == "Y")
        VHCF35IW-MSG.MSG = "invalid axle serial no";
        VHCF35IW.VALID-SERIALS = "N";
    end
end 

Function VHCF35IS-VALID-SER ()
  
  


   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCF35D";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF35D";


  
  
  
    VHCF35D_CRIT.AXLE = "Y";

    
    try
        call "VHCF35D"(XDCONTROL, VHCF35D_CRIT, VHCF35D_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF35IW-MSG.MSG-1B = " ";
        else
            VHCF35IW-MSG.MSG-1A = "THE SERIAL NUMBER  ENTERED IS NOT VALID FOR THIS COMPONENT: ";
            VHCF35IW.VALID-SERIALS = "N";
  
  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end
end 

Function VHCF35IS-VALID-TR ()
  
  
  
   
    VHCF35IW.ROW-COUNT = 0;
    VHCF35IW-MSG.MSG = " ";
    VHCF35IW.VALID-TRUCK = "N";
    set VHCF35D_CRIT empty;
    set VHCF35D_DATA empty;
    set VHCF35IW-HOLD-AXLE empty;
    set VHCF35IW-HOLD-TRCK empty;
    AXLE1-COLOR = "WHITE";
    AXLE2-COLOR = "WHITE";
    DISC1-COLOR = "WHITE";
    DISC2-COLOR = "WHITE";
    TM1-COLOR = "WHITE";
    TM2-COLOR = "WHITE";

  
  
  

  
    VHCF14IW-STOCK.WHICH = "S";
    VHCF14IW-STOCK.FULL-STOCK-NO = VHCF35IW.STOCK-NO-L2;
    VHCF14IS-STK-DASH();
    VHCF35D_CRIT.STOCK-NO = VHCF14IW-STOCK.STOCK-NO;
    VHCF35D_CRIT.CMPNT-SERIAL-NO = VHCF35IW.CMPNT-SERIAL-NO;

  
  
  
    VHCF35D_CRIT.AXLE = "N"; 
    try
        call "VHCF35D"(XDCONTROL, VHCF35D_CRIT, VHCF35D_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        if (VHCF35D_DATA.CAR-NO == " ")
            VHCF35IW.ROW-COUNT = XDCONTROL.UROWCNT;
            VHCF35IW.VALID-TRUCK = "Y";
            VHCF35IW.TRUCK-SERIAL-NO = VHCF35D_DATA.CMPNT-SERIAL-NO;
            VHCF35IW.TRUCK-STOCK-NO = VHCF35D_CRIT.STOCK-NO;
            VHCF35IW-HOLD-TRCK.COMMENTS = VHCF35D_DATA.COMMENTS;
            VHCF35IW-HOLD-TRCK.TRUCK-STAT = VHCF35D_DATA.TRUCK-STAT;
            VHCF35IW-HOLD-TRCK.LOC = VHCF35D_DATA.SHOP-LOC;
            VHCF35IW-PASSVALUE.ENABLE-UPDATE = "Y";
        else
            VHCF35IW-MSG.MSG-1A = "THE TRUCK SERIAL NUMBER YOU ENTERED IS CURRENTLY ON CAR ";
            VHCF35IW-MSG.MSG-1B = VHCF35D_DATA.CAR-NO;
            VHCF35IW-PASSVALUE.DISABLE-UPDATE = "Y";
        end
    else
        VHCF35IW-MSG.MSG = "THE TRUCK SERIAL NUMBER YOU ENTERED IS CURRENTLY ON CAR OR NOT VALID";
        VHCF35IW-PASSVALUE.DISABLE-UPDATE = "Y";
        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
  

  
  
    if (VHCF35IW.VALID-TRUCK == "Y")
        VHCF35IW-PASSVALUE.ENABLE-UPDATE = "Y";
        VHCF35IS-TRUCK();
    else
        VHCF35IW-PASSVALUE.DISABLE-UPDATE = "Y";
    end
end 

Function VHCF35IS-VALIDATE ()
  
  

   
    VHCF35IW.VALID-SERIALS = "Y ";
    if (VHCF35IW-HOLD-TRCK.AXLE1 != " ")
        if (VHCF35IW-HOLD-TRCK.AXLE1-NEW == "Y")
            set VHCF35D_DATA empty;
            set VHCF35D_CRIT empty;
            MSG-1B = "AXLE 1";
            VHCF35D_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.AXLE1;
            VHCF35D_CRIT.CMPNT-EQUIP-TYPE = "AXLE";
            VHCF35IS-VALID-SER();
            if (VHCF35IW.VALID-SERIALS == "N ")
                return;
            else
                VHCF35IW-HOLD-TRCK.AXLE1-STOCK-NO = VHCF35D_DATA.STOCK-NO;
                VHCF35IS-AXLE1(); 
            end
        end
    end
    if (VHCF35IW-HOLD-TRCK.AXLE2 != " ")
        if (VHCF35IW-HOLD-TRCK.AXLE2-NEW == "Y")
            set VHCF35D_DATA empty;
            set VHCF35D_CRIT empty;
            MSG-1B = "AXLE 2";
            VHCF35D_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.AXLE2;
            VHCF35D_CRIT.CMPNT-EQUIP-TYPE = "AXLE";
            VHCF35IS-VALID-SER();
            if (VHCF35IW.VALID-SERIALS == "N ") 
                return;
            else
                VHCF35IW-HOLD-TRCK.AXLE2-STOCK-NO = VHCF35D_DATA.STOCK-NO;
                VHCF35IS-AXLE2();
            end
        end
    end
    if (VHCF35IW-HOLD-TRCK.TM-1 != " ")
        if (VHCF35IW-HOLD-TRCK.TM-1-NEW == "Y")
            set VHCF35D_DATA empty;
            set VHCF35D_CRIT empty;
            MSG-1B = "TRACTION MOTOR 1";
            VHCF35D_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.TM-1;
            VHCF35D_CRIT.CMPNT-EQUIP-TYPE = "TRACTION MOTOR";
            if (VHCF35IW.STOCK-NO-L2 == "17-35-88515" ||
             VHCF35IW.STOCK-NO-L2 == "17-35-88520" ||
             VHCF35IW.STOCK-NO-L2 == "17-35-88525")
                VHCF35D_CRIT.STOCK-NO = "173155448";
            else
                VHCF35D_CRIT.STOCK-NO = "183155300";
            end
            VHCF35IS-VALID-SER();
            if (VHCF35IW.VALID-SERIALS == "N ")
                return;
            else
                VHCF35IW-HOLD-TRCK.TM-1-STOCK-NO = VHCF35D_DATA.STOCK-NO;
            end
        end
    end
    if (VHCF35IW-HOLD-TRCK.TM-2 != " ")
        if (VHCF35IW-HOLD-TRCK.TM-2-NEW == "Y")
            set VHCF35D_DATA empty;
            set VHCF35D_CRIT empty;
            MSG-1B = "TRACTION MOTOR 2";
            VHCF35D_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.TM-2;
            VHCF35D_CRIT.CMPNT-EQUIP-TYPE = "TRACTION MOTOR";
            if (VHCF35IW.STOCK-NO-L2 == "17-35-88515" ||
             VHCF35IW.STOCK-NO-L2 == "17-35-88520" ||
             VHCF35IW.STOCK-NO-L2 == "17-35-88525")
                VHCF35D_CRIT.STOCK-NO = "173155448";
            else
                VHCF35D_CRIT.STOCK-NO = "183155300";
            end
            VHCF35IS-VALID-SER();
            if (VHCF35IW.VALID-SERIALS == "N ")
                return;
            else
                VHCF35IW-HOLD-TRCK.TM-2-STOCK-NO = VHCF35D_DATA.STOCK-NO;
            end
        end
    end
    if (VHCF35IW-HOLD-TRCK.BRAKE-DISC-1 != " ")
        if (VHCF35IW-HOLD-TRCK.BRAKE-DISC-1-NEW == "Y")
            set VHCF35D_DATA empty;
            set VHCF35D_CRIT empty;
            MSG-1B = "BRAKE DISC 1";
            VHCF35D_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.BRAKE-DISC-1;
            VHCF35D_CRIT.CMPNT-EQUIP-TYPE = "BRAKE DISC";
            VHCF35IS-VALID-SER();
            if (VHCF35IW.VALID-SERIALS == "N ")
                return;
            else
                VHCF35IW-HOLD-TRCK.BRAKE-DISC-1-STOCK-NO = VHCF35D_DATA.STOCK-NO;
            end
        end
    end
    if (VHCF35IW-HOLD-TRCK.BRAKE-DISC-2 != " ")
        if (VHCF35IW-HOLD-TRCK.BRAKE-DISC-2-NEW == "Y")
            set VHCF35D_DATA empty;
            set VHCF35D_CRIT empty;
            MSG-1B = "BRAKE DISC 2";
            VHCF35D_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.BRAKE-DISC-2;
            VHCF35D_CRIT.CMPNT-EQUIP-TYPE = "BRAKE DISC";
            VHCF35IS-VALID-SER();
            if (VHCF35IW.VALID-SERIALS == "N ")
                return;
            else
                VHCF35IW-HOLD-TRCK.BRAKE-DISC-2-STOCK-NO = VHCF35D_DATA.STOCK-NO;
            end
        end
    end


  
  
  
  
    set VHCF35IW-MSG empty;
    VHCF35IW.A2COMPONENT-FLAG = "N";
    VHCF35IW.A1COMPONENT-FLAG = "N";
    VHCF35IW.TCOMPONENT-FLAG = "N";
    

  

  
    if (VHCF35IW-HOLD-AXLE.WHEEL1 != " " &&
     VHCF35IW-HOLD-AXLE.WHEEL2 != " " &&
     VHCF35IW-HOLD-AXLE.B-BEARING1 != " " &&
     VHCF35IW-HOLD-AXLE.N-BEARING1 != " " &&
     VHCF35IW-HOLD-AXLE.GEAR-BOX1 != " ")
        VHCF35IW.A1COMPONENT-FLAG = "Y";
    end

  
    if (VHCF35IW-HOLD-AXLE.WHEEL3 != " " &&
     VHCF35IW-HOLD-AXLE.WHEEL4 != " " &&
     VHCF35IW-HOLD-AXLE.B-BEARING2 != " " &&
     VHCF35IW-HOLD-AXLE.N-BEARING2 != " " &&
     VHCF35IW-HOLD-AXLE.GEAR-BOX2 != " ")
        VHCF35IW.A2COMPONENT-FLAG = "Y";
    end

  
    if (VHCF35IW-HOLD-TRCK.AXLE1 != " " &&
     VHCF35IW-HOLD-TRCK.AXLE2 != " " &&
     VHCF35IW-HOLD-TRCK.TM-1 != " " &&
     VHCF35IW-HOLD-TRCK.TM-2 != " " &&
     VHCF35IW-HOLD-TRCK.BRAKE-DISC-1 != " " &&
     VHCF35IW-HOLD-TRCK.BRAKE-DISC-1 != " ")
        VHCF35IW.TCOMPONENT-FLAG = "Y";
    end

  
    VHCF35IW.RUN-ADD = "Y";
end 

Function VHCF37IS-AXLE1 ()
  
  

  
  

   
    if (VHCF35IW-HOLD-TRCK.AXLE1 != " ")
        VHCF35IW-MSG.MSG = " ";
        VHCF35IW.FOUND-CMPNTS = "N";
        VHCF35F_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.AXLE1;
        VHCF35F_CRIT.AXLE-NEW-OLD = "NEW";
        try
            call "VHCF37F"(XDCONTROL, VHCF35F_CRIT, VHCF35F_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF35IS-VAL-AXLE();
            if (VHCF35F_CRIT.AXLE-ON-CAR != "Y" &&
             VHCF35F_CRIT.INVALID-AXLE != "Y")
                VHCF35IW.AXLE-CMP-COUNT = XDCONTROL.UROWCNT;
            end
        else
            VHCF35IW-MSG.MSG = "NO COMPONENTS ARE CURRENTLY ASSOCIATED WITH THAT AXLE SERIAL NUMBER";
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
  

  
  
        YCOUNT = 1;
        while (YCOUNT <= VHCF35IW.AXLE-CMP-COUNT)
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "WHEEL")
  
                if (VHCF35F_DATA.POSN-CD[YCOUNT] == "1" || VHCF35F_DATA.POSN-CD[YCOUNT] == "5" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "B")
                    VHCF35IW-HOLD-AXLE.WHEEL1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
  
                if (VHCF35F_DATA.POSN-CD[YCOUNT] == "2" || VHCF35F_DATA.POSN-CD[YCOUNT] == "6" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "N")
                    VHCF35IW-HOLD-AXLE.WHEEL2 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
            end
  
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "BEARING")
  
                if (VHCF35F_DATA.POSN-CD[YCOUNT] == "1" || VHCF35F_DATA.POSN-CD[YCOUNT] == "5" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "B")
                    VHCF35IW-HOLD-AXLE.B-BEARING1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
  
                if (VHCF35F_DATA.POSN-CD[YCOUNT] == "2" || VHCF35F_DATA.POSN-CD[YCOUNT] == "6" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "N")
                    VHCF35IW-HOLD-AXLE.N-BEARING1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
            end
  
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "GEAR BOX")
                VHCF35IW-HOLD-AXLE.GEAR-BOX1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
            end
  
            YCOUNT = YCOUNT + 1;
        end
    end
end 

