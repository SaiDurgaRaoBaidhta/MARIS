            end
        else
            VHCF35IW-MSG.MSG = "NO COMPONENTS ARE CURRENTLY ASSOCIATED WITH THAT AXLE SERIAL NUMBER";
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
  

  
  
        YCOUNT = 1;
        while (YCOUNT <= VHCF35IW.AXLE-CMP-COUNT)
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "WHEEL")
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "5" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "7" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "B")
                    VHCF35IW-HOLD-AXLE.WHEEL3 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "6" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "8" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "N")
                    VHCF35IW-HOLD-AXLE.WHEEL4 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
            end
  
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "BEARING")
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "5" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "7" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "B")
                    VHCF35IW-HOLD-AXLE.B-BEARING2 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "6" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "8" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "N")
                    VHCF35IW-HOLD-AXLE.N-BEARING2 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
            end
  
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "GEAR BOX")
                VHCF35IW-HOLD-AXLE.GEAR-BOX2 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
            end
  
            YCOUNT = YCOUNT + 1;
        end
    end
end 

Function VHCF35IS-CLEAR () 
    set VHCF35B_CRIT empty;
    set VHCF35B_DATA empty;
    set VHCF35F_CRIT empty;
    set VHCF35F_DATA empty;
    set VHCF35G_CRIT empty;
    set VHCF35G_DATA empty;
    set VHCF35IW-MSG empty;
    set VHCF35IW-HOLD-AXLE empty;
    set VHCF35IW-HOLD-TRCK empty;
    VHCF35IW.CMPNT-SERIAL-NO = " ";

  
  
  
  
  
  
    VHCF35IW-PASSVALUE.DISABLE-UPDATE = "Y";
    AXLE1-COLOR = "WHITE";
    AXLE2-COLOR = "WHITE";
    DISC1-COLOR = "WHITE";
    DISC2-COLOR = "WHITE";
    TM1-COLOR = "WHITE";
    TM2-COLOR = "WHITE";
end 

Function VHCF35IS-CLEAR-ADD () 
    set VHCF35B_CRIT empty;
    set VHCF35B_DATA empty;
    set VHCF35F_CRIT empty;
    set VHCF35F_DATA empty;
    set VHCF35G_CRIT empty;
    set VHCF35G_DATA empty;
    set VHCF35IW-HOLD-AXLE empty;
    set VHCF35IW-HOLD-TRCK empty;
    VHCF35IW.CMPNT-SERIAL-NO = " ";
    VHCF35IW-ENABLE.ENABLE-AXLE1 = "Y";
    VHCF35IW-ENABLE.ENABLE-AXLE2 = "Y";
    VHCF35IW-ENABLE.ENABLE-TM1 = "Y";
    VHCF35IW-ENABLE.ENABLE-TM2 = "Y";
    VHCF35IW-ENABLE.ENABLE-BRAKE1 = "Y";
    VHCF35IW-ENABLE.ENABLE-BRAKE2 = "Y";
end 

Function VHCF35IS-CLICK () 
    if (SER-PARM == "AXLE1" && VHCF35IW-HOLD-TRCK.AXLE1 != " ")
        if (AXLE1-CLICK == 1)
            AXLE1-CLICK = 2;
            AXLE1-COLOR = "WHITE";
        else
            AXLE1-CLICK = 1;
            AXLE1-COLOR = "YELLOW";
        end
    end
    if (SER-PARM == "AXLE2" && VHCF35IW-HOLD-TRCK.AXLE2 != " ")
        if (AXLE2-CLICK == 1)
            AXLE2-CLICK = 2;
            AXLE2-COLOR = "WHITE";
        else
            AXLE2-CLICK = 1;
            AXLE2-COLOR = "YELLOW";
        end
    end
    if (SER-PARM == "DISC1" && VHCF35IW-HOLD-TRCK.BRAKE-DISC-1 != " ")
        if (DISC1-CLICK == 1)
            DISC1-CLICK = 2;
            DISC1-COLOR = "WHITE";
        else
            DISC1-CLICK = 1;
            DISC1-COLOR = "YELLOW";
        end
    end
    if (SER-PARM == "DISC2" && VHCF35IW-HOLD-TRCK.BRAKE-DISC-2 != " ")
        if (DISC2-CLICK == 1)
            DISC2-CLICK = 2;
            DISC2-COLOR = "WHITE";
        else
            DISC2-CLICK = 1;
            DISC2-COLOR = "YELLOW";
        end
    end
    if (SER-PARM == "TM1" && VHCF35IW-HOLD-TRCK.TM-1 != " ")
        if (TM1-CLICK == 1)
            TM1-CLICK = 2;
            TM1-COLOR = "WHITE";
        else
            TM1-CLICK = 1;
            TM1-COLOR = "YELLOW";
        end
    end
    if (SER-PARM == "TM2" && VHCF35IW-HOLD-TRCK.TM-2 != " ")
        if (TM2-CLICK == 1)
            TM2-COLOR = "WHITE";
            TM2-CLICK = 2;
        else
            TM2-CLICK = 1;
            TM2-COLOR = "YELLOW";
        end
    end
end 

Function VHCF35IS-FND-TRUCK () 
    if (VHCF35D_DATA.PREV-TRK-POS-CD == " ")
        if (VHCF35IW.STOCK-NO-L2 == "17-35-88515" ||
         VHCF35IW.STOCK-NO-L2 == "17-35-88525" ||
         VHCF35IW.STOCK-NO-L2 == "19-35-88618" ||
         VHCF35IW.STOCK-NO-L2 == "20-35-88611")
            VHCF35D_DATA.PREV-TRK-POS-CD = "Y";
        else
            if (VHCF35IW.STOCK-NO-L2 == "17-35-88520" ||
             VHCF35IW.STOCK-NO-L2 == "19-35-88603" ||
             VHCF35IW.STOCK-NO-L2 == "20-35-88610")
                VHCF35D_DATA.PREV-TRK-POS-CD = "X";
            end
        end
    end
end 

Function VHCF35IS-INITIAL () 
    AXLE1-COLOR = "WHITE";
    AXLE2-COLOR = "WHITE";
    DISC1-COLOR = "WHITE";
    DISC2-COLOR = "WHITE";
    TM1-COLOR = "WHITE";
    TM2-COLOR = "WHITE";
    set VHCF35C_DATA empty;
    set VHCF35C_DATA2 empty;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCF16B";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF35C";

    
    try
        call "VHCF35C"(XDCONTROL, VHCF35C_CRIT, VHCF35C_DATA, VHCF35C_DATA2);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end
end 

Function VHCF35IS-MOVE ()
  
  

  

  
  
   
    VHCF35IW.FOUND-AXLE1 = "N";
    VHCF35IW.FOUND-AXLE2 = "N";
    VHCF35IW.FOUND-TM1 = "N";
    VHCF35IW.FOUND-TM2 = "N";
    VHCF35IW.FOUND-DISC1 = "N";
    VHCF35IW.FOUND-DISC2 = "N";
    VHCF35IW.FOUND-AXLE-1 = "N";
    VHCF35IW.FOUND-AXLE-2 = "N";
    XCOUNT = 1;
    while (XCOUNT <= VHCF35IW.TRUCK-CMP-COUNT)

  
        if (VHCF35B_DATA.CMPNT-EQUIP-TYPE[XCOUNT] == "AXLE")
  
  
  
  
            if ((VHCF35B_DATA.POSN-CD[XCOUNT] == "1" || VHCF35B_DATA.POSN-CD[XCOUNT] == "3"))
                VHCF35IW-HOLD-TRCK.AXLE1 = VHCF35B_DATA.CMPNT-SERIAL-NO[XCOUNT];
                VHCF35IW-HOLD-TRCK.AXLE1-POSN-CD = VHCF35B_DATA.POSN-CD[XCOUNT];
                VHCF35IW-HOLD-TRCK.AXLE1-STOCK-NO = VHCF35B_DATA.STOCK-NO[XCOUNT];
                VHCF35IW.FOUND-AXLE1 = "Y";
                VHCF35IW-HOLD-TRCK.AXLE1-NEW = "N";
                if (VHCF35B_DATA.POSN-CD[XCOUNT] != " ")
                    VHCF35IW.FOUND-AXLE-1 = "Y";
                end
                
  
            end
  
  
  
            if ((VHCF35B_DATA.POSN-CD[XCOUNT] == "2" || VHCF35B_DATA.POSN-CD[XCOUNT] == "4"))
                VHCF35IW-HOLD-TRCK.AXLE2 = VHCF35B_DATA.CMPNT-SERIAL-NO[XCOUNT];
                VHCF35IW-SAVE.AXLE-2-SAVE = VHCF35B_DATA.CMPNT-SERIAL-NO[XCOUNT];
                VHCF35IW-HOLD-TRCK.AXLE2-POSN-CD = VHCF35B_DATA.POSN-CD[XCOUNT];
                VHCF35IW-HOLD-TRCK.AXLE2-STOCK-NO = VHCF35B_DATA.STOCK-NO[XCOUNT];
                VHCF35IW.FOUND-AXLE2 = "Y";
                VHCF35IW-HOLD-TRCK.AXLE2-NEW = "N";
  
                if (VHCF35B_DATA.POSN-CD[XCOUNT] != " ")
                    VHCF35IW.FOUND-AXLE-2 = "Y";
                end
            end
        end
  
        if (VHCF35B_DATA.CMPNT-EQUIP-TYPE[XCOUNT] == "TRACTION MOTOR")
  
            if ((VHCF35B_DATA.POSN-CD[XCOUNT] == "1" || VHCF35B_DATA.POSN-CD[XCOUNT] == "3"))
                VHCF35IW-HOLD-TRCK.TM-1 = VHCF35B_DATA.CMPNT-SERIAL-NO[XCOUNT];
                VHCF35IW-HOLD-TRCK.TM-1-POSN-CD = VHCF35B_DATA.POSN-CD[XCOUNT];
                VHCF35IW-HOLD-TRCK.TM-1-STOCK-NO = VHCF35B_DATA.STOCK-NO[XCOUNT];
                VHCF35IW-HOLD-TRCK.TM-1-NEW = "N";
                if (VHCF35B_DATA.POSN-CD[XCOUNT] != " ")
                    VHCF35IW.FOUND-TM1 = "Y";
                end
                
   
            end
  
            if (VHCF35B_DATA.POSN-CD[XCOUNT] == "2" || VHCF35B_DATA.POSN-CD[XCOUNT] == "4")
                VHCF35IW-HOLD-TRCK.TM-2 = VHCF35B_DATA.CMPNT-SERIAL-NO[XCOUNT];
                VHCF35IW-HOLD-TRCK.TM-2-POSN-CD = VHCF35B_DATA.POSN-CD[XCOUNT];
                VHCF35IW-HOLD-TRCK.TM-2-STOCK-NO = VHCF35B_DATA.STOCK-NO[XCOUNT];
                VHCF35IW-HOLD-TRCK.TM-2-NEW = "N";
                if (VHCF35B_DATA.POSN-CD[XCOUNT] != " ")
                    VHCF35IW.FOUND-TM2 = "Y";
                end
                
  
            end
        end
  
        if (VHCF35B_DATA.CMPNT-EQUIP-TYPE[XCOUNT] == "BRAKE DISC")
  
            if (VHCF35B_DATA.POSN-CD[XCOUNT] == "1" || VHCF35B_DATA.POSN-CD[XCOUNT] == "3")
                VHCF35IW-HOLD-TRCK.BRAKE-DISC-1 = VHCF35B_DATA.CMPNT-SERIAL-NO[XCOUNT];
                VHCF35IW-HOLD-TRCK.BRAKE-DISC-1-POSN-CD = VHCF35B_DATA.POSN-CD[XCOUNT];
                VHCF35IW-HOLD-TRCK.BRAKE-DISC-1-STOCK-NO = VHCF35B_DATA.STOCK-NO[XCOUNT];
                VHCF35IW-HOLD-TRCK.BRAKE-DISC-1-NEW = "N";
  
                if (VHCF35B_DATA.POSN-CD[XCOUNT] != " ")
                    VHCF35IW.FOUND-DISC1 = "Y";
                end
            end
  
            if (VHCF35B_DATA.POSN-CD[XCOUNT] == "2" || VHCF35B_DATA.POSN-CD[XCOUNT] == "4")
                VHCF35IW-HOLD-TRCK.BRAKE-DISC-2 = VHCF35B_DATA.CMPNT-SERIAL-NO[XCOUNT];
                VHCF35IW-HOLD-TRCK.BRAKE-DISC-2-POSN-CD = VHCF35B_DATA.POSN-CD[XCOUNT];
                VHCF35IW-HOLD-TRCK.BRAKE-DISC-2-STOCK-NO = VHCF35B_DATA.STOCK-NO[XCOUNT];
                VHCF35IW-HOLD-TRCK.BRAKE-DISC-2-NEW = "N";
                if (VHCF35B_DATA.POSN-CD[XCOUNT] != " ")
                    VHCF35IW.FOUND-DISC2 = "Y";
                end
                
  
            end
        end
  
        XCOUNT = XCOUNT + 1;
    end

  
  
  
    if (VHCF35IW.FOUND-AXLE1 == "Y")
        VHCF37IS-OLD-AXLE1();
    end
    if (VHCF35IW.FOUND-AXLE2 == "Y")
        VHCF37IS-OLD-AXLE2();
    end
end 

