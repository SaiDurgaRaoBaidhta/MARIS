

package MRSConfigurTrackQuery;
 

Function VHCF16I-CLEAR () 
    set VHCF16IW-MSG empty;
    set VHCF16IW empty;
    set VHCF16A_DATA empty;
    set VHCF16A_CRIT empty;
    VHCF16IW.ROW-COUNT = 0;
    VHCF16IW-TRIGGERS.LOAD-DATA = "Y";
end 

Function VHCF16I-GET-DATA () 
    VHCF16IW.ROW-COUNT = 0;
    VHCF16IW-MSG.MSG = " ";
    set VHCF16A_DATA empty;
    set VHCF16A_CRIT empty;


  
    if (VHCF16IW.HOME-YRD == " " || (VHCF16IW.HOME-YRD != " " && VHCF16IW.STOCK-DISPLAY != " "))


  

  
        VHCF16A_CRIT.CMPNT-EQUIP-TYPE = VHCF16IW.CMPNT-EQUIP-TYPE;
        VHCF16A_CRIT.DATA-LIMIT-FLAG = "N";

  
        VHCF14IW-STOCK.WHICH = "S";
        VHCF14IW-STOCK.FULL-STOCK-NO = VHCF16IW.STOCK-NO-L2;
        VHCF14IS-STK-DASH();
        VHCF16A_CRIT.STOCK-NO = VHCF14IW-STOCK.STOCK-NO;
        VHCF16A_CRIT.CMPNT-SERIAL-NO = VHCF16IW.CMPNT-SERIAL-NO;
        VHCF16A_CRIT.SERIAL-STAT = VHCF16IW.SERIAL-STAT;
        VHCF16A_CRIT.HOME-YRD = VHCF16IW.HOME-YRD;
        if (VHCF16IW.SORT == 1)
            VHCF16A_CRIT.SORT-INDEX = "1";
        end
        if (VHCF16IW.SORT == 2)
            VHCF16A_CRIT.SORT-INDEX = "2";
        end
        try
            call "VHCF16A"(XDCONTROL, VHCF16A_CRIT, VHCF16A_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF16IW.ROW-COUNT = XDCONTROL.UROWCNT;
            VHCF16IW-TRIGGERS.LOAD-DATA = "Y";
            if (VHCF16A_CRIT.DATA-LIMIT-FLAG == "Y")
                VHCF16IW-MSG.MSG = "DATA LIMIT OF 213 ITEMS HAS BEEN REACHED, REFINE CRITERIA";
            end
        else
            VHCF16IW-MSG.MSG = "No Data Available For the Selected Criteria";
            VHCF16IW.ROW-COUNT = XDCONTROL.UROWCNT;
            VHCF16IW-TRIGGERS.LOAD-DATA = "Y"; 
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
        
  
    else
        VHCF16IW-MSG.MSG = "IF YOU ENTER A HOME YARD YOU MUST ALSO ENTER A STOCK NUMBER";
    end
end 

Function VHCF16I-PRINT ()
   
    VHCF16-25I.REPORT-NAME = "COMPONENT";
    VHCF16-25I.CMPNT-SERIAL-NO = VHCF16IW.CMPNT-SERIAL-NO;
    VHCF16-25I.HOME-YRD = VHCF16IW.HOME-YRD;
    if (VHCF16IW.SORT == 1)
        VHCF16-25I.SORT-ORDER = "1";
    end
    if (VHCF16IW.SORT == 2)
        VHCF16-25I.SORT-ORDER = "2";
    end


  
    VHCF14IW-STOCK.WHICH = "S";
    VHCF14IW-STOCK.FULL-STOCK-NO = VHCF16IW.STOCK-NO-L2;
    VHCF14IS-STK-DASH();
    VHCF16-25I.STOCK-NO = VHCF14IW-STOCK.STOCK-NO;

  
    VHCF16IW-TRIGGERS.RUN-VHCF25I = "Y";
end 

Function VHCF16IS-INITIAL () 
    set VHCF16B_DATA empty;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCF16B";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF16B";
    set VHCF16B_DATA empty;

    
    try
        call "VHCF16B"(XDCONTROL, VHCF16B_CRIT, VHCF16B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end


  
    set VHCF16C_DATA empty;
    set VHCF16C_DATA2 empty;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCF16B";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF16C";

    
    try
        call "VHCF16C"(XDCONTROL, VHCF16C_CRIT, VHCF16C_DATA, VHCF16C_DATA2);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end


  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCF16D";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF16C";

    
    try
        call "VHCF16D"(XDCONTROL, VHCF16D_CRIT, VHCF16D_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)

        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end
end 

Function VHCF21-TRACK-CD ()
   
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCF21I";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF21E";
    set VHCF21E_DATA empty;
    VHCF21E_CRIT.STOCK-NO = VHCF21D_DATA.STOCK-NO[ICT];
    VHCF21E_CRIT.CMPNT-EQUIP-TYPE = VHCF21IW.CMPNT-EQUIP-TYPE;
    
    try
        call "VHCF21E"(XDCONTROL, VHCF21E_CRIT, VHCF21E_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();
    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            if (VHCF21E_DATA.CMPNT-TRACKING-CD == "T")
                VHCF21D_DATA.CMPNT-TRACKING-CD[ICT] = "TIM";
            end
            if (VHCF21E_DATA.CMPNT-TRACKING-CD == "W")
                VHCF21D_DATA.CMPNT-TRACKING-CD[ICT] = "WAR";
                if (VHCF21E_DATA.CMPNT-TRACKING-CD == " ") 
                    VHCF21D_DATA.CMPNT-TRACKING-CD[ICT] = "TIM";
                end
            end
        else

        end 
    end
end 

Function VHCF21I-ADD () 
    if (VHCF21IW.CMPNT-EQUIP-TYPE == "BEARING")
        VHCF21IW.BAD-BEARING-YEAR = "N";
        
  
  
  
  
    end
    if (VHCF21IW.CMPNT-EQUIP-TYPE != "BEARING" || (VHCF21IW.CMPNT-EQUIP-TYPE == "BEARING" && VHCF21IW.BAD-BEARING-YEAR == "N"))

  
        set VHCF21D_CRIT empty;
        set VHCF21D_DATA empty;
        ICT = 1;
        XXDATEW.VAGen_FUNCTION = "YMD";
        XXDATEW.DATE-MM-DD-YYYY = VHCF21IW.DATE-BUY-REBUILT;
        MRSCommonCode.XXDATES-CONVERT();
        VHCF21D_DATA.DATE-BUY-REBUILT[ICT] = XXDATEW.DATE-YYYY-MM-DD;
        VHCF14IW-STOCK.WHICH = "S";
        VHCF14IW-STOCK.FULL-STOCK-NO = VHCF21IW.STOCK-NO-L;
        VHCF14IS-STK-DASH();
        VHCF21D_DATA.STOCK-NO[ICT] = VHCF14IW-STOCK.STOCK-NO;
        VHCF21D_DATA.CMPNT-STOCK-NO[ICT] = VHCF14IW-STOCK.STOCK-NO;
        VHCF21D_DATA.CMPNT-SERIAL-NO[ICT] = VHCF21IW.CMPNT-SERIAL-NO;
        VHCF21D_DATA.SERIAL-STAT = "STO";
        VHCF21D_DATA.CMPNT-EQUIP-TYPE[ICT] = VHCF21IW.CMPNT-EQUIP-TYPE;
        VHCF21D_DATA.SERIAL-CONFIGD-IND[ICT] = "N";
        VHCF21D_DATA.HIST-ACTION-CD[ICT] = "INV";
        VHCF21D_DATA.SERIAL-STAT[ICT] = "STO";
        VHCF21D_DATA.TERM-LAST-UPD[ICT] = VHCF21I-PASS-VALUE.TERM-ID;
        VHCF21D_CRIT.TERM-LAST-UPD = VHCF21I-PASS-VALUE.TERM-ID;
        

  
        VHCF21-TRACK-CD();


  
        XXEXT_CALL_Level77Items.UEXTNAM = "VHCF21D";
        XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF21D";

    
        try
            call "VHCF21D"(XDCONTROL, VHCF21D_CRIT, VHCF21D_DATA);
        
        end
        

    
        MRSCommonCode.XXA0IS-CHECK_EXT();

    
        if (XXEXT_CALL_Level77Items.URC == 0)
  
            if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
                VHCF21IW-MSG.MSG = "THE COMPONENT ACTION WAS SUCCESSFULLY PERFORMED";
            else
                VHCF21IW-MSG.MSG = "THERE WAS A PROBLEM PERFORMING THE ACTION YOU REQUESTED";
  
        
        
  
                if (XDCONTROL.URC == 100)

                else
                    XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                    XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                    XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                    XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
                end
            end 

  
        end
    end
end 

Function VHCF21I-CLEAR () 
    set VHCF21IW empty;
    set VHCF21IW-MSG empty;
    VHCF21IW.DATE-BUY-REBUILT = VGVar.currentFormattedGregorianDate;
end 

Function VHCF21I-GET-STOCK ()
   
    set VHCF21B_DATA empty;
    set VHCF21B_CRIT empty;
    VHCF21B_CRIT.CMPNT-EQUIP-TYPE = VHCF21IW.CMPNT-EQUIP-TYPE;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCF21B";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF21B";
    set VHCF21B_DATA empty;

    
    try
        call "VHCF21B"(XDCONTROL, VHCF21B_CRIT, VHCF21B_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF21IW-TRIGGERS.LOAD-STOCK = "Y";
            VHCF21IW.NUM-STOCK = XDCONTROL.UROWCNT;
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end
end 

Function VHCF21I-INITIAL ()
   
    set VHCF21A_DATA empty;

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCF21A";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF21A";
    set VHCF21A_DATA empty;

    
    try
        call "VHCF21A"(XDCONTROL, VHCF21A_CRIT, VHCF21A_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF21IW-TRIGGERS.LOAD-TYPE = "Y";
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end
    VHCF21IW.DATE-BUY-REBUILT = VGVar.currentFormattedGregorianDate;
end 

Function VHCF21I-UPDATE ()
  
   
    VHCF21IW.VAGen_EXISTS = "N";

  
    VHCF14IW-STOCK.WHICH = "S";
    VHCF14IW-STOCK.FULL-STOCK-NO = VHCF21IW.STOCK-NO-L;
    VHCF14IS-STK-DASH();
    VHCF21C_CRIT.STOCK-NO = VHCF14IW-STOCK.STOCK-NO;
    VHCF21C_CRIT.CMPNT-EQUIP-TYPE = VHCF21IW.CMPNT-EQUIP-TYPE;
    VHCF21C_CRIT.CMPNT-SERIAL-NO = VHCF21IW.CMPNT-SERIAL-NO;
  

  
    XXEXT_CALL_Level77Items.UEXTNAM = "VHCF21C";
    XXEXT_CALL_Level77Items.UAPPLNAM = "VHCF21C";
    set VHCF21C_DATA empty;

    
    try
        call "VHCF21C"(XDCONTROL, VHCF21C_CRIT, VHCF21C_DATA);
    
    end
    

    
    MRSCommonCode.XXA0IS-CHECK_EXT();

    
    if (XXEXT_CALL_Level77Items.URC == 0)
  
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF21IW.VAGen_EXISTS = "Y";
            VHCF21IW-MSG.MSG = "YOU CANNOT ADD THIS SERIAL NUMBER, IT ALREADY EXIST FOR THAT COMPONENT TYPE";
        else

  
        
        
  
            if (XDCONTROL.URC == 100)

            else
                XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
                XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
                XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
                XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
            end
        end 

  
    end
    if (VHCF21IW.VAGen_EXISTS == "N")
        VHCF21IW-TRIGGERS.RUN-ADD = "Y";
    end
end 

Function VHCF21I-VALID-DATE ()
   
    VHCF21IW.VALID-DATE = "Y";
    VHCF21IW-MSG.MSG = " ";
    VHCF20IW-DATE.CURRENT-DATE = VGVar.currentGregorianDate;
    VHCF20IW-DATE.COMPARE-YEAR = VHCF20IW-DATE.HOLD-DATE-YEAR;
    VHCF20IW-DATE.COMPARE-MONTH = VHCF20IW-DATE.HOLD-DATE-MM;
    VHCF20IW-DATE.COMPARE-DAY = VHCF20IW-DATE.HOLD-DATE-DD;
    if (VHCF20IW-DATE.COMPARE-DATE > VHCF20IW-DATE.CURRENT-DATE)
        VHCF21IW-MSG.MSG = "INVALID DATE, FUTURE DATES ARE NOT ALLOWED";
        VHCF21IW.VALID-DATE = "N";
    end
    if (VHCF20IW-DATE.COMPARE-YEAR-NUM < 1990)
        VHCF21IW-MSG.MSG = "INVALID DATE, YEAR CANNOT BE EARLIER THAN 1990";
        VHCF21IW.VALID-DATE = "N";
    end
    if (VHCF20IW-DATE.COMPARE-MONTH-NUM < 1 || VHCF20IW-DATE.COMPARE-MONTH-NUM > 12 || VHCF20IW-DATE.COMPARE-DAY-NUM < 1 || VHCF20IW-DATE.COMPARE-DAY-NUM > 31)
        VHCF21IW-MSG.MSG = "INVALID DATE";
        VHCF21IW.VALID-DATE = "N";
    end

  
    if (VHCF21IW.CMPNT-SERIAL-NO == " ")
        VHCF21IW-MSG.MSG = "MISSING DATA SERIAL NUMBER";
        VHCF21IW.VALID-DATE = "N";
    end
    if (VHCF21IW.STOCK-NO-L == " ")
        VHCF21IW-MSG.MSG = "MISSING DATA, STOCK NUMBER NOT SELECTED";
        VHCF21IW.VALID-DATE = "N";
    end
    if (VHCF21IW.CMPNT-EQUIP-TYPE == " ")
        VHCF21IW-MSG.MSG = "MISSING DATA EQUIPMENT TYPE";
        VHCF21IW.VALID-DATE = "N";
    end
    if (VHCF21IW.VALID-DATE == "Y")
        VHCF21IW-TRIGGERS.RUN-UPDATE = "Y";
    end
end 

Function VHCF21I-VBEARING ()
   
    VHCF21IW.BAD-BEARING-YEAR = "N";
    VHCF20IW-DATE.COMPARE-DATE = VGVar.currentGregorianDate;
    VHCF21IW.VALID-BEARING = VHCF21IW.CMPNT-SERIAL-NO;
    VHCF21IW.HIGH-YEAR = VHCF20IW-DATE.COMPARE-YEAR-NUM;
    VHCF21IW.LOW-YEAR = VHCF20IW-DATE.COMPARE-YEAR-NUM - 4;

  
    VHCF21IW.BEARING-YEAR-NNNN = VHCF21IW.NUM-2 + 2000;
    if (VHCF21IW.BEARING-YEAR-NNNN >= VHCF21IW.LOW-YEAR && VHCF21IW.BEARING-YEAR-NNNN <= VHCF21IW.HIGH-YEAR)
  

    else
        VHCF21IW.BAD-BEARING-YEAR = "Y";
        VHCF21IW-MSG.MSG = "THE BEARING YEAR PREFIX IS NOT VALID (CURRENT YEAR TO CURRENT YEAR - 4)";
    end
end 

Function VHCF35IS-ADD ()
  
   
    VHCF35IS-FND-TRUCK();
    set VHCF35G_CRIT empty;
    set VHCF35G_DATA empty;
    VHCF35IW-SAVE.CMPNT-SERIAL-NO = VHCF35IW.CMPNT-SERIAL-NO;

  
    VHCF35G_CRIT.PARENT-STOCK-NO = VHCF35IW.TRUCK-STOCK-NO;
    VHCF35G_CRIT.PARENT-SERIAL-NO = VHCF35IW.TRUCK-SERIAL-NO;
    VHCF35G_CRIT.PARENT-POSN-CD = " ";
    VHCF35G_CRIT.PARENT-EQUIP-TYPE = "TRUCK";
    VHCF35G_CRIT.HIST-ACTION-CD = "ADD";
    VHCF35G_CRIT.TERM-LAST-UPD = VHCF35IW-TERM-ID.TERM-ID;

  
    VHCF35IW.YCOUNT = 0;

  
    if (VHCF35IW-HOLD-TRCK.AXLE1 != " ")
        YCOUNT = YCOUNT + 1;
        VHCF35G_DATA.STOCK-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.AXLE1-STOCK-NO;
        VHCF35G_DATA.CMPNT-SERIAL-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.AXLE1;
        VHCF35G_DATA.CMPNT-EQUIP-TYPE[YCOUNT] = "AXLE";
        if (VHCF35D_DATA.PREV-TRK-POS-CD == "X")
            VHCF35G_DATA.POSN-CD[YCOUNT] = "1";
        else
            if (VHCF35D_DATA.PREV-TRK-POS-CD == "Y")
                VHCF35G_DATA.POSN-CD[YCOUNT] = "3";
            end
        end
    end

  
    if (VHCF35IW-HOLD-TRCK.AXLE2 != " ")
        YCOUNT = YCOUNT + 1;
        VHCF35G_DATA.STOCK-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.AXLE2-STOCK-NO;
        VHCF35G_DATA.CMPNT-SERIAL-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.AXLE2;
        VHCF35G_DATA.CMPNT-EQUIP-TYPE[YCOUNT] = "AXLE";
        if (VHCF35D_DATA.PREV-TRK-POS-CD == "X")
            VHCF35G_DATA.POSN-CD[YCOUNT] = "2";
        else
            if (VHCF35D_DATA.PREV-TRK-POS-CD == "Y")
                VHCF35G_DATA.POSN-CD[YCOUNT] = "4";
            end
        end
    end

  
    if (VHCF35IW-HOLD-TRCK.TM-1 != " ")
        YCOUNT = YCOUNT + 1;
        VHCF35G_DATA.STOCK-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.TM-1-STOCK-NO;
        VHCF35G_DATA.CMPNT-SERIAL-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.TM-1;
        VHCF35G_DATA.CMPNT-EQUIP-TYPE[YCOUNT] = "TRACTION MOTOR";
        if (VHCF35D_DATA.PREV-TRK-POS-CD == "X")
            VHCF35G_DATA.POSN-CD[YCOUNT] = "1";
        else
            if (VHCF35D_DATA.PREV-TRK-POS-CD == "Y")
                VHCF35G_DATA.POSN-CD[YCOUNT] = "3";
            end
        end
    end

  
    if (VHCF35IW-HOLD-TRCK.TM-2 != " ")
        YCOUNT = YCOUNT + 1;
        VHCF35G_DATA.STOCK-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.TM-2-STOCK-NO;
        VHCF35G_DATA.CMPNT-SERIAL-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.TM-2;
        VHCF35G_DATA.CMPNT-EQUIP-TYPE[YCOUNT] = "TRACTION MOTOR";
        if (VHCF35D_DATA.PREV-TRK-POS-CD == "X")
            VHCF35G_DATA.POSN-CD[YCOUNT] = "2";
        else
            if (VHCF35D_DATA.PREV-TRK-POS-CD == "Y")
                VHCF35G_DATA.POSN-CD[YCOUNT] = "4";
            end
        end
    end

  
    if (VHCF35IW-HOLD-TRCK.BRAKE-DISC-1 != " ")
        YCOUNT = YCOUNT + 1;
        VHCF35G_DATA.STOCK-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.BRAKE-DISC-1-STOCK-NO;
        VHCF35G_DATA.CMPNT-SERIAL-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.BRAKE-DISC-1;
        VHCF35G_DATA.CMPNT-EQUIP-TYPE[YCOUNT] = "BRAKE DISC";
        if (VHCF35D_DATA.PREV-TRK-POS-CD == "X")
            VHCF35G_DATA.POSN-CD[YCOUNT] = "1";
        else
            if (VHCF35D_DATA.PREV-TRK-POS-CD == "Y")
                VHCF35G_DATA.POSN-CD[YCOUNT] = "3";
            end
        end
    end

  
    if (VHCF35IW-HOLD-TRCK.BRAKE-DISC-2 != " ")
        YCOUNT = YCOUNT + 1;
        VHCF35G_DATA.STOCK-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.BRAKE-DISC-2-STOCK-NO;
        VHCF35G_DATA.CMPNT-SERIAL-NO[YCOUNT] = VHCF35IW-HOLD-TRCK.BRAKE-DISC-2;
        VHCF35G_DATA.CMPNT-EQUIP-TYPE[YCOUNT] = "BRAKE DISC";
        if (VHCF35D_DATA.PREV-TRK-POS-CD == "X")
            VHCF35G_DATA.POSN-CD[YCOUNT] = "2";
        else
            if (VHCF35D_DATA.PREV-TRK-POS-CD == "Y")
                VHCF35G_DATA.POSN-CD[YCOUNT] = "4";
            end
        end
    end
    VHCF35G_DATA.COMMENTS = VHCF35IW-HOLD-TRCK.COMMENTS;
    VHCF35G_DATA.TRUCK-STAT = VHCF35IW-HOLD-TRCK.TRUCK-STAT;
    VHCF35G_CRIT.SHOP-LOC = VHCF35IW-HOLD-TRCK.LOC;
    VHCF35G_CRIT.ITEM-COUNT = YCOUNT;
    VHCF35IW-MSG.MSG = " ";
    VHCF35G_CRIT.TERM-LAST-UPD = VH01A01_DATA.TERM-ID;
    try
        call "VHCF35G"(XDCONTROL, VHCF35G_CRIT, VHCF35G_DATA);
    
    end
    if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
        VHCF35IW-MSG.MSG = "ALL COMPONENTS WERE ADDED CORRECTLY";
        VHCF35IW-PASSVALUE.DISABLE-UPDATE = "Y";
        
  
    else
        VHCF35IW-MSG.MSG = "THERE WAS A PROBLEM ADDING COMPONENTS TO SERIAL HIST OR SERIAL NUMBER TABLES";
        
        
        XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
        XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
        XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
        XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
    end
end 

Function VHCF35IS-AXLE1 ()
  
  

  
  

   
    if (VHCF35IW-HOLD-TRCK.AXLE1 != " ")
        VHCF35IW-MSG.MSG = " ";
        VHCF35IW.FOUND-CMPNTS = "N";
        VHCF35F_CRIT.CMPNT-SERIAL-NO = VHCF35IW-HOLD-TRCK.AXLE1;
        VHCF35F_CRIT.AXLE-NEW-OLD = "NEW";
        try
            call "VHCF37F"(XDCONTROL, VHCF35F_CRIT, VHCF35F_DATA);
        
        end
        if (XDCONTROL.URC == 0 || XDCONTROL.URC == 4)
            VHCF35IS-VAL-AXLE();
            if (VHCF35F_CRIT.AXLE-ON-CAR != "Y" &&
             VHCF35F_CRIT.INVALID-AXLE != "Y")
                VHCF35IW.AXLE-CMP-COUNT = XDCONTROL.UROWCNT;
            end
        else
            VHCF35IW-MSG.MSG = "NO COMPONENTS ARE CURRENTLY ASSOCIATED WITH THAT AXLE SERIAL NUMBER";
        
        
            XXMESSAGE.UMSGCODE = XDCONTROL.UMSGCODE;
            XXMESSAGE.UMSGINS[1] = XDCONTROL.UMSGINS[1];
            XXMESSAGE.UMSGINS[2] = XDCONTROL.UMSGINS[2];
            XXMESSAGE.UMSGINS[3] = XDCONTROL.UMSGINS[3];
        end
  

  
  
        YCOUNT = 1;
        while (YCOUNT <= VHCF35IW.AXLE-CMP-COUNT)
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "WHEEL")
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "1" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "3" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "B")
                    VHCF35IW-HOLD-AXLE.WHEEL1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "2" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "4" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "N")
                    VHCF35IW-HOLD-AXLE.WHEEL2 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
            end
  
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "BEARING")
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "1" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "3" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "B")
                    VHCF35IW-HOLD-AXLE.B-BEARING1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
                if (VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "2" || VHCF35F_DATA.PREV-POSN-CD[YCOUNT] == "4" ||
                 VHCF35F_DATA.POSN-CD[YCOUNT] == "N")
                    VHCF35IW-HOLD-AXLE.N-BEARING1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
                end
            end
  
   
            if (VHCF35F_DATA.CMPNT-EQUIP-TYPE[YCOUNT] == "GEAR BOX")
                VHCF35IW-HOLD-AXLE.GEAR-BOX1 = VHCF35F_DATA.CMPNT-SERIAL-NO[YCOUNT];
            end
  
            YCOUNT = YCOUNT + 1;
        end
    end
end 

Function VHCF35IS-AXLE2 ()
  
  

  
  

   
    if (VHCF35IW-HOLD-TRCK.AXLE2 != " ")
        set VHCF35F_CRIT empty;
        set VHCF35F_DATA empty;
        VHCF35IW-MSG.MSG = " ";
